<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:p="http://primefaces.org/ui"
	xmlns:zsg="http://www.bcs.com/zsg/jsf">
	
<c:set var="contextPath" value="${request.contextPath}"/>
<c:set var="isLoggedIn" value="${not empty sessionInfoBean.userVO.loginId}"/>

<f:view contentType="text/html" locale="#{localeBean.locale}">
    <h:head>
    	<f:facet name="first">
            <meta http-equiv="X-UA-Compatible" content="EmulateIE8" />
            <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
            <title><h:outputFormat value="#{msg['common.title']}"/></title>
        </f:facet>
    
		<link type="text/css" rel="stylesheet" href="#{request.contextPath}/css/default.css" />
        <link type="text/css" rel="stylesheet" href="#{request.contextPath}/css/syntaxhighlighter.css" />
        <link type="text/css" rel="stylesheet" href="#{request.contextPath}/css/style.css" />
        <script language="javascript" src="#{request.contextPath}/js/script.js"/>
        <ui:insert name="headIncludes"/>
    </h:head>
    <h:body>
    	<p:ajaxStatus onstart="varStatusDialog.show();" onsuccess="varStatusDialog.hide();" onerror="varStatusDialog.hide(); varErrorDialog.show();"/>
              
		<p:dialog modal="true" widgetVar="varStatusDialog" header="Loading..." draggable="false" closable="false">
		    <p:graphicImage value="/img/ajaxloadingbar.gif"/>
		</p:dialog>
		
		<p:dialog modal="true" widgetVar="varErrorDialog" header="Error" draggable="false" closable="true">
			<p:hotkey bind="esc" handler="varErrorDialog.hide()"/>
			<div class="ui-messages ui-widget">
				<div class="ui-messages-fatal ui-corner-all">
					<span class="ui-messages-fatal-icon"></span>
					<ul><li><span class="ui-messages-fatal-summary"><h:outputText value="#{err['ERR_GENERAL_EXCEPTION']}"/></span></li></ul>
				</div>
			</div>
		</p:dialog>
		
		<table class="tbl_layout" cellpadding="0" cellspacing="0" style="width: 100%">
			<tr class="ui-widget ui-widget-header bterp_header">
				<td width="120">
					<p:graphicImage url="/img/BSN_1.jpg" alt="BSN" width="120" height="150"/>
				</td>
				<td style="text-align: left; padding-top: 95px; font-size: 20px;">
					<h:outputText value="#{msg['common.title']}"/>
					<!--<h2 style="text-align: left; font-size: 20px;">
						<h:outputText value="#{msg['common.title']}"/>
					</h2>-->
				</td>
				<td class="txt_right">
					<!--<a href="?locale=en">English</a>&nbsp;|&nbsp;<a href="?locale=zh">Chinese</a>-->
					&nbsp;
				</td>
				<td>&nbsp;</td>
			</tr>
			<c:if test="${not empty menuBean.breadCrumbModel}">
			<tr class="ui-widget ui-widget-header">
				<td colspan="100%">
					<p:breadCrumb model="#{menuBean.breadCrumbModel}"/>
				</td>
			</tr>
			</c:if>
		</table>
		<br/>
    	<table cellpadding="0" cellspacing="0">
    		<colgroup>
    			<col width="1%"/>
    			<col width="10%"/>
    			<col width="1%"/>
    			<col width="87%"/>
    			<col width="1%"/>
    		</colgroup>
			<tr>
				<td><p:spacer width="15"/></td>
				<c:if test="${not empty menuBean.menuModel}">
					<td class="txt_top">
						<p:tieredMenu model="#{menuBean.menuModel}" />
					</td>
					<td><p:spacer width="15"/></td>
				</c:if>
				<td class="txt_top" colspan="${not empty menuBean.menuModel ? '1' : '3'}">
					<ui:insert name="content"/>
				</td>
				<td>&nbsp;</td>
			</tr>
			<tr>
				<td>&nbsp;</td>
				<td colspan="2"><ui:insert name="footerNotes"/></td>
				<td>&nbsp;</td>
			</tr>
		</table>
        <table class="tbl_layout" cellpadding="0" cellspacing="0">
			<colgroup>
				<col width="1%"/>
				<col width="98%"/>
				<col width="1%"/>
			</colgroup>
			<tr>
				<td>&nbsp;</td>
				<td class="txt_center">
					<ui:insert name="footer">
						<c:if test="${not empty appVersion}"><br/>v${appVersion}</c:if>
						<br/><h:outputText styleClass="ui-widget" value="&copy; 2011 BCS Sdn. Bhd."/><br/><br/>
					</ui:insert>
				</td>
				<td>&nbsp;</td>
			</tr>
		</table>
        
    </h:body>
</f:view>
</html>
