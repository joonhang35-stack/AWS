<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="auto_e_invoice_config_form">
	
	<!-- backing bean, extends com.bcs.zsg.component.common.web.swf.bean.AppBackingBean -->
	<var name="configBean" class="com.bcs.zsg.maintenance.web.bean.AutoEInvoiceConfigBean"/>
	
	<view-state id="auto_e_invoice_config_form">
		<on-entry>
			<evaluate expression="configBean.init()"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>