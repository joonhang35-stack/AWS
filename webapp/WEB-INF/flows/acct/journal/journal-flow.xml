<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="journal_list">
	
	<!-- backing bean, extends com.bcs.zsg.component.common.web.swf.bean.AppBackingBean -->
	<var name="journalBean" class="com.bcs.zsg.acct.web.bean.JournalBean"/>
	<var name="acctBean" class="com.bcs.zsg.acct.web.bean.AccountBean"/>
	
	<view-state id="journal_list">
		<on-entry>
			<evaluate expression="journalBean.init()"/>
			<evaluate expression="acctBean.init(1, false)"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>