<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="sales_support_list">
	
	<var name="salesSuppBean" class="com.bcs.zsg.sales.web.bean.SalesSupportBean"/>
	<var name="salesInvBean" class="com.bcs.zsg.sales.web.bean.InvoiceBean"/>
	
	<view-state id="sales_support_list">
		<on-entry>
			<evaluate expression="salesSuppBean.init()"/>
			<evaluate expression="salesInvBean.initPopUp()"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>