<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow
                          http://www.springframework.org/schema/webflow/spring-webflow-2.0.xsd"
      start-state="invoice_item_usage_report">

	<var name="invoiceItemReportUsageBean" class="com.bcs.zsg.sales.web.bean.InvoiceItemReportUsageBean"/>

	<view-state id="invoice_item_usage_report">
		<on-entry>
			<evaluate expression="invoiceItemReportUsageBean.init()"/>
		</on-entry>
	</view-state>

</flow>
