<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="generate_entry">
	
	<!-- backing bean, extends com.bcs.zsg.component.common.web.swf.bean.AppBackingBean -->
	<var name="debtorStmtBean" class="com.bcs.zsg.sales.web.bean.DebtorStatementBean"/>
	
	<view-state id="generate_entry">
		<on-entry>
			<evaluate expression="debtorStmtBean.init()"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>