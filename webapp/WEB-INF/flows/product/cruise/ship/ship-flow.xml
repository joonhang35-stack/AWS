<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="ship_list">
	
	<!-- backing bean, extends com.bcs.zsg.component.common.web.swf.bean.AppBackingBean -->
	<var name="cruiseBean" class="com.bcs.zsg.product.web.bean.CruiseBean"/>
	
	<view-state id="ship_list">
		<on-entry>
			<evaluate expression="cruiseBean.init('C')"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>