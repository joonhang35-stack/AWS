<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="tourins_list">
	
	<!-- backing bean, extends com.bcs.zsg.component.common.web.swf.bean.AppBackingBean -->
	<var name="tourInsBean" class="com.bcs.zsg.product.web.bean.TourInsuranceBean"/>
	<var name="salesInvBean" class="com.bcs.zsg.sales.web.bean.InvoiceBean"/>
	
	<view-state id="tourins_list">
		<on-entry>
			<evaluate expression="tourInsBean.init()"/>
			<evaluate expression="salesInvBean.initPopUp()"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>