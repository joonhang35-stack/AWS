<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.bank.vo">

    <class table="bank_address" name="BankAddrVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idBank" type="long" column="id_bank"/>
        <property name="idCountry" type="long" column="id_country"/>
        <property name="typeCd" type="string" column="type_cd"/>
        <property name="addr1" type="string" column="addr_1"/>
        <property name="addr2" type="string" column="addr_2"/>
        <property name="addr3" type="string" column="addr_3"/>
        <property name="city" type="string" column="city"/>
        <property name="state" type="string" column="state"/>
        <property name="postCd" type="string" column="postcode"/>
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>