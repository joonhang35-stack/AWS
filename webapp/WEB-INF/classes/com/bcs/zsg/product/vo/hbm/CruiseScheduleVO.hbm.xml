<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="cruise_schedule" name="CruiseScheduleVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idCruise" type="long" column="id_cruise"/>
        <property name="desc" type="string" column="description"/>
        <property name="dtSchedule" type="timestamp" column="dt_schedule"/>
        <property name="tktValidity" type="integer" column="tkt_validity"/>
        <property name="amtAptAdt" type="double" column="apt_adt"/>
        <property name="amtAptChd" type="double" column="apt_chd"/>
        <property name="amtFuelAdt" type="double" column="fuel_adt"/>
        <property name="amtFuelChd" type="double" column="fuel_chd"/>
        <property name="amtTrvlIns" type="double" column="trvl_ins"/>
        <property name="amtVisa" type="double" column="visa"/>
        <property name="amtAC" type="double" column="ac"/>
        <property name="amtTipping" type="double" column="tipping"/>
        <property name="amtDeviation" type="double" column="deviation"/>
        
        <!-- BaseVO attributes -->
        <property name="remarks" type="string" column="remarks"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>