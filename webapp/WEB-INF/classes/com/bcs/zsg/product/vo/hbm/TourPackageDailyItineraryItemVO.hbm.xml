<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="tour_pkg_daily_itinerary_item" name="TourPackageDailyItineraryItemVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idTourPkgDailyItinerary" type="long" column="id_tour_pkg_daily_itinerary"/>
        <property name="title" type="string" column="title"/>
        <property name="description" type="string" column="description"/>
        <property name="seq" type="integer" column="seq"/>
        <property name="langCd" type="string" column="lang_cd"/>
        <property name="hotel" type="string" column="hotel"/>
        <property name="meals" type="string" column="meals"/>
        
        <!-- BaseVO attributes -->
        <property name="remarks" type="string" column="remarks"/>
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_update"/>
		<property name="updatedBy" type="string" column="updated_by"/>
    </class>
</hibernate-mapping>