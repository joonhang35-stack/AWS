<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="campaign" name="CampaignVO" polymorphism="explicit">
	    <id name="id" type="long" column="id">
	        <generator class="identity"></generator>
	    </id>
	    <property name="idCompany" type="long" column="id_company"/>
	    <property name="name" type="string" column="name"/>
	    <property name="campaignStatus" type="string" column="campaign_status"/>
	    <property name="startDt" type="date" column="start_dt"/>
	    <property name="endDt" type="date" column="end_dt"/>
	    <property name="startTime" type="string" column="start_time"/>
	    <property name="endTime" type="string" column="end_time"/>
	    <property name="code" type="string" column="code"/>
	    <property name="description" type="string" column="description"/>
	    <property name="tourType" type="string" column="tour_type"/>
	    <property name="remarks" type="string" column="remarks"/>
    
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>    
	</class>
</hibernate-mapping>