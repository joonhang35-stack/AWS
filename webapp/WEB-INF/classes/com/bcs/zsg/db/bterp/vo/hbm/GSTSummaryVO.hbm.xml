<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.db.bterp.vo.gst">
	<class table="gst_summary" name="GSTSummaryVO" polymorphism="explicit">
		<id name="id" type="long" column="id">
            <generator class="identity"/>
        </id>
        <property name="idCompany" type="long" column="id_company"/>
        <property name="dateFrom" type="date" column="date_from"/>
        <property name="dateTo" type="date" column="date_to"/>
        <property name="openingBalance" type="double" column="opening_balance"/>
		<property name="outputTax" type="double" column="output_tax"/>
		<property name="inputTax" type="double" column="input_tax"/>
		<property name="amountPayable" type="double" column="amount_payable"/>
		<property name="amountClaimable" type="double" column="amount_clamable"/>
		<property name="closingBalance" type="double" column="closing_balance"/>
		
		<property name="refundCarryForward" type="string" column="refund_carry_forward"/>
		<property name="processed" type="string" column="processed"/>
		
	
		<!-- BaseVO attributes -->
		
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_update"/>
		<property name="updatedBy" type="string" column="updated_by"/>
		
	</class>
</hibernate-mapping>