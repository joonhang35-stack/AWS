<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.db.bterp.vo.gst">
	<class table="tax_code" name="TaxCodeVO" polymorphism="explicit">
		<id name="id" type="long" column="id">
            <generator class="identity"/>
        </id>
        <property name="uuid" type="long" column="UUID"/>
		<property name="taxType" type="string" column="tax_type"/>
		<property name="subType" type="string" column="sub_type"/>
		<property name="code" type="string" column="code"/>
		<property name="description" type="string" column="description"/>
		<property name="rate" type="float" column="rate"/>
		
		
		<!-- VIEW USAGE -->
		<property name="totalAmount" type="double" column="amount"/>
		<property name="taxAmount" type="double" column="tax_amount"/>
		
		<!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_update"/>
		<property name="updatedBy" type="string" column="updated_by"/>
		
	</class>
</hibernate-mapping>