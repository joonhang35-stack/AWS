<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.purchase.vo">

    <class table="EX_ORDER" name="ExOrderVO" polymorphism="explicit">
        <id name="Id" type="long" column="ID">
        <generator class="identity"></generator>
        </id>
        <property name="companyId" type="long" column="ID_COMPANY"/>
        <property name="supplierId" type="long" column="ID_SUPPLIER"/>
        <property name="tourId" type="long" column="ID_TOUR"/>
        <property name="code" type="string" column="CODE"/>
        <property name="eoDt" type="timestamp" column="DT_EO"/>
        <property name="docTypeCd" type="string" column="DOC_TYPE_CD"/>
        <property name="typeCd" type="string" column="TYPE_CD"/>
        <property name="attn" type="string" column="ATTN_TO"/>
        <property name="orderedId" type="long" column="ID_ORDERER"/>
        <property name="approverId" type="long" column="ID_APPROVER"/>
        <property name="invRefId" type="long" column="ID_INV_REF"/>
        <property name="paymentTerm" type="string" column="PMNT_TYPE_CD"/>
        <property name="cnNumber" type="string" column="CN_NO"/>
        <property name="category" type="string" column="CAT_CD"/>
        <property name="idDepartment" type="string" column="ID_DPT"/>
        <property name="delivery" type="string" column="DELIVERY_CD"/>
        <property name="status" type="string" column="STATUS_CD"/>
        <property name="suppInvoiceDt" type="timestamp" column="DT_SUPP_INV"/>
        <property name="startDt" type="timestamp" column="DT_START"/>
        <property name="dueDt" type="timestamp" column="DT_DUE"/>
        <property name="tourDepDt" type="timestamp" column="DT_TOUR_DEP"/>
        <property name="reference" type="string" column="REFERENCE"/>
        <property name="eoComments" type="string" column="comments"/>
        <property name="eoInternalComments" type="string" column="internal_comments"/>
        <property name="totalAmt" type="double" column="TOT_AMT"/>
        <property name="amtDue" type="double" column="AMT_DUE"/>
        
        <!-- BaseVO attributes -->
        <property name="version" type="long" column="version"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>