<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.purchase.vo">

    <class table="EX_ORDER_BILL_PMNT" name="BillPaymentVO" polymorphism="explicit">
        <id name="Id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="eoBillId" type="long" column="ID_EO_BILL"/>
        <property name="bankId" type="long" column="ID_BANK"/>
        <property name="pymtDt" type="timestamp" column="DT_PMNT"/>
        <property name="code" type="string" column="CODE"/>
        <property name="payee" type="string" column="PAYEE"/>
        <property name="desc" type="string" column="DESCRIPTION"/>
        <property name="refNum" type="string" column="REF_NO"/>
        <property name="remarks" type="string" column="REMARKS"/>
        <property name="pmntAmount" type="double" column="pmnt_amount"/>
        <property name="chqAmount" type="double" column="chq_amount"/>
        <property name="pmntType" type="string" column="pmnt_type"/>
        
        <!-- BaseVO attributes -->
		<property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>