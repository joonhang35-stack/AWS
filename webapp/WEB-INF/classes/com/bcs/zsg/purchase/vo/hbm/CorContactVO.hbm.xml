<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.purchase.vo">

    <class table="CORPORATE_CONTACT" name="CorContactVO" polymorphism="explicit">
        <id name="Id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="corporateId" type="long" column="ID_CORPORATE"/>
        <property name="contactType" type="string" column="TYPE_CD"/>
        <property name="idCountryCd" type="long" column="ID_COUNTRY_CD"/>
        <property name="countryCd" type="string" column="COUNTRY_CD"/>
        <property name="contactNo" type="string" column="NUMBER"/>
        <property name="attention" type="string" column="ATTENTION"/>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="STATUS_CD"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>