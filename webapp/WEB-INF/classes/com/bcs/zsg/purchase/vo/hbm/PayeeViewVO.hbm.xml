<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.purchase.vo">

    <class table="VW_PAYEE" name="PayeeViewVO" polymorphism="explicit">
      	<composite-id>
	        <key-property name="payeeType" column="PAYEE_TYPE" type="string"/>
	        <key-property name="idPayee" column="ID_PAYEE" type="long"/>
	    </composite-id>
        <property name="payeeName" type="string" column="PAYEE_NAME"/>
        <property name="salutationCd" type="string" column="SALUTATION_CD"/>
        <property name="supportName" type="string" column="SUPPORT_NAME"/>
    </class>

</hibernate-mapping>