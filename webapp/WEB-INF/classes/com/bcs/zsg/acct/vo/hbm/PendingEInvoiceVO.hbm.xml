<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.acct.vo">

    <class table="PENDING_E_INVOICE" name="PendingEInvoiceVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        
        <property name="idCompany" type="long" column="id_company"/>
        <property name="dtProcess" type="timestamp" column="dt_process"/>
        
        <!-- system attributes -->
        <property name="sysDocType" type="string" column="sys_doc_type"/>
        <property name="sysPrefix" type="string" column="sys_prefix"/>
        <property name="refId" type="long" column="ref_id"/>
        <property name="refNo" type="string" column="ref_no"/>
        
        <!-- E-Invoice API attributes -->
        <property name="documentUuid" type="string" column="document_uuid"/>
        <property name="submissionUid" type="string" column="submission_uid"/>
        
        <property name="processStatus" type="string" column="process_status"/>
        <property name="submitStatus" type="string" column="submit_status"/>
        <property name="reason" type="string" column="reason"/>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>