<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.acct.vo">

    <class table="E_INVOICE_API_DAILY_SNAPSHOT" name="EInvoiceApiDailySnapshotVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        
        <!-- E-Invoice API attributes -->
        <property name="idCompany" type="long" column="id_company"/>
        <property name="dtTrans" type="timestamp" column="dt_trans"/>
        <property name="jsonResponse" type="string" column="json_response"/>
        <property name="totalCount" type="integer" column="total_count"/>
        <property name="pageSize" type="integer" column="page_size"/>
        <property name="pageNo" type="integer" column="page_no"/>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>