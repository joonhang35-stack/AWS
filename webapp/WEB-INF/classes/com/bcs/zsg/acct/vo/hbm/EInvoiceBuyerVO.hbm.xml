<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.acct.vo">

    <class table="E_INVOICE_BUYER" name="EInvoiceBuyerVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        
        <!-- E-Invoice API attributes -->
        <property name="idEInvDoc" type="long" column="id_e_inv_doc"/>
        <property name="name" type="string" column="name"/>
        <property name="tin" type="string" column="tin"/>
        <property name="identityType" type="string" column="identity_type"/>
        <property name="identityValue" type="string" column="identity_value"/>
        <property name="sstRegNo" type="string" column="sst_reg_no"/>
        <property name="addr1" type="string" column="addr_1"/>
        <property name="addr2" type="string" column="addr_2"/>
        <property name="addr3" type="string" column="addr_3"/>
        <property name="postcode" type="string" column="postcode"/>
        <property name="city" type="string" column="city"/>
        <property name="state" type="string" column="state"/>
        <property name="country" type="string" column="country"/>
        <property name="email" type="string" column="email"/>
        <property name="contactNo" type="string" column="contact_no"/>

        <!-- system attributes -->
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>