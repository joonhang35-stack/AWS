<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.cfg.sec.vo">

    <class table="EMPLOYEE" name="EmployeeVO" polymorphism="explicit">
        <id name="Id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="companyId" type="long" column="ID_COMPANY"/>
        <property name="personId" type="long" column="ID_PERSON"/>
        <property name="secUser" type="string" column="U_SEC_USER"/>
        <property name="department" type="string" column="DEPARTMENT"/>
        <property name="isDefaultComp" type="boolean" column="IS_DEFAULT_COMP"/>
        <property name="customerId" type="long" column="ID_CUSTOMER"/>
        <property name="customerName" type="string" column="CUSTOMER_NAME"/>
        <property name="roleType" type="string" column="ROLE_TYPE"/>
        
        <property name="category" type="string" column="category"/>
		<property name="fullName" type="string" column="full_name"/>
		<property name="idNo" type="string" column="id_no"/>
		<property name="taxIdNo" type="string" column="tax_id_no"/>
		<property name="nickName" type="string" column="nick_name"/>
		<property name="msicCode" type="string" column="msic_code"/>
        <property name="countryId" type="long" column="id_country" />
		<property name="addr1" type="string" column="addr_1" />
		<property name="addr2" type="string" column="addr_2" />
		<property name="addr3" type="string" column="addr_3" />
		<property name="city" type="string" column="city" />
		<property name="state" type="string" column="state" />
		<property name="postcode" type="string" column="postcode" />
		<property name="acctNo" type="string" column="acct_no" />
		<property name="bankName" type="string" column="bank_name" />
		<property name="isAccessSystem" type="boolean" column="is_access_sys" />
		<property name="isEditable" type="boolean" column="is_editable" />
        
       
        <!-- BaseVO attributes -->
		<property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>