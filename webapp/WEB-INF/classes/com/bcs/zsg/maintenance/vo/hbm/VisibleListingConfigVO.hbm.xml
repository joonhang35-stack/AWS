<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.maintenance.vo">
	<class table="visible_listing_config" name="VisibleListingConfigVO" polymorphism="explicit">
		<id name="id" type="long" column="id">
            <generator class="native"/>
        </id>
        
		<property name="catCd" type="string" column="cat_cd"/>
		<property name="listingType" type="string" column="listing_type"/>
		<property name="type" type="string" column="type"/>
		<property name="deptCode" type="string" column="dept_code"/>
		<property name="idRole" type="string" column="id_role"/>
		
		<!-- BaseVO attributes -->
		<property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
		<property name="version" type="long" column="version"/>
		
	</class>
</hibernate-mapping>