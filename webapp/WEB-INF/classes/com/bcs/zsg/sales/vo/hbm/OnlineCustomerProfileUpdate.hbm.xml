<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.sales.vo">

    <class table="online_customer_profile_update" name="OnlineCustomerProfileUpdateVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="idCustomer" type="long" column="id_customer"/>
        <property name="keycloakId" type="string" column="keycloak_id"/>

        <property name="salutationCd" type="string" column="salutation_cd"/>
        <property name="titleCd" type="string" column="title_cd"/>
        <property name="gender" type="string" column="gender"/>
        <property name="surname" type="string" column="surname"/>
        <property name="givenName" type="string" column="given_name"/>
        <property name="nickName" type="string" column="nick_name"/>
        <property name="taxIdNo" type="string" column="tax_id_no"/>

        <property name="idCountry" type="long" column="id_country"/>
        <property name="nric" type="string" column="nric"/>
        <property name="passportNo" type="string" column="passport_no"/>
        <property name="dtBirth" type="timestamp" column="dt_birth"/>

        <property name="idMobileNoCountryCd" type="long" column="id_mobile_no_country_cd"/>
        <property name="mobileNo" type="string" column="mobile_no"/>

        <property name="idOfficeNoCountryCd" type="long" column="id_office_no_country_cd"/>
        <property name="officeNo" type="string" column="office_no"/>

        <property name="email" type="string" column="email"/>

        <property name="raceCd" type="string" column="race_cd"/>

        <property name="dtPssprtExpiry" type="timestamp" column="dt_pssprt_expiry"/>
        <property name="idPssprtCountry" type="long" column="id_pssprt_country"/>

        <property name="billAddr1" type="string" column="bill_addr_1"/>
        <property name="billAddr2" type="string" column="bill_addr_2"/>
        <property name="billAddr3" type="string" column="bill_addr_3"/>
        <property name="billAddrCity" type="string" column="bill_addr_city"/>
        <property name="billAddrPostcode" type="string" column="bill_addr_postcode"/>
        <property name="billAddrState" type="string" column="bill_addr_state"/>
        <property name="idBillAddrCountry" type="long" column="id_bill_addr_country"/>

        <property name="mailAddr1" type="string" column="mail_addr_1"/>
        <property name="mailAddr2" type="string" column="mail_addr_2"/>
        <property name="mailAddr3" type="string" column="mail_addr_3"/>
        <property name="mailAddrCity" type="string" column="mail_addr_city"/>
        <property name="mailAddrPostcode" type="string" column="mail_addr_postcode"/>
        <property name="mailAddrState" type="string" column="mail_addr_state"/>
        <property name="idMailAddrCountry" type="long" column="id_mail_addr_country"/>

        <property name="ecSurname" type="string" column="ec_surname"/>
        <property name="ecGivenName" type="string" column="ec_given_name"/>
        <property name="ecIdCountryCd" type="long" column="ec_id_country_cd"/>
        <property name="ecContactNo" type="string" column="ec_contact_no"/>
        <property name="ecEmail" type="string" column="ec_email"/>
        <property name="ecRelationship" type="string" column="ec_relationship"/>

        <property name="updateStatus" type="string" column="update_status"/>
        <property name="dtReviewed" type="timestamp" column="dt_reviewed"/>
        <property name="reviewedBy" type="string" column="reviewed_by"/>
        
		<!-- BaseVO attributes -->
		<property name="remarks" type="string" column="remarks"/>
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>