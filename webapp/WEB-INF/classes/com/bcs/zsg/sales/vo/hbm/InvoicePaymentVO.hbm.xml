<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.sales.vo">

    <class table="INVOICE_PMNT" name="InvoicePaymentVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="invId" type="long" column="ID_INV"/>
        <property name="issuerId" type="long" column="ID_ISSUER"/>
        <property name="bankId" type="long" column="ID_BANK"/>
        <property name="pmntDt" type="timestamp" column="DT_PMNT"/>
        <property name="code" type="string" column="CODE"/>
        <property name="pmntTypeCd" type="string" column="PMNT_TYPE_CD"/>
        <property name="refNo" type="string" column="REF_NO"/>
        <property name="pmntFor" type="string" column="PMNT_FOR"/>
        <property name="recievedFr" type="string" column="RECEIVED_FROM"/>
        <property name="amount" type="double" column="AMOUNT"/>
        <property name="seq" type="integer" column="seq"/>
        
        <property name="invPmnt" type="string" column="id_inv_pmnt"/>
        <property name="idCashBook" type="long" column="id_cashbook"/>
        <property name="creditNoteId" type="long" column="id_credit_note"/>
        <property name="idParentPmnt" type="long" column="id_parent_pmnt"/>
        <property name="hideDeposit" type="boolean" column="hide_deposit"/>
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>