<!--Paragraph-->
<table class="row" style="width:100%; padding-left: 15px; padding-right: 30px;">
	<tbody>
	<tr>
	<td>
	
		<!--Message-->
		<table class="row" style="width:100%">
			<tbody>
				<tr>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 15px;" align="justify">
						<br/>Dear Sales,
					</td>
				</tr>
				<tr>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;width:33%" align="justify">
						Tour Code
					</td>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;" align="justify">:</td>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;font-weight: bold" align="justify">
						${tourCd}
					</td>
				</tr>
				<tr>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;width:33%" align="justify">
						Tour Package
					</td>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;" align="justify">:</td>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;" align="justify">
						${nameEn} ${nameOther}
					</td>
				</tr>
				<tr>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;width:33%" align="justify">
						Departure Date
					</td>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;" align="justify">:</td>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;font-weight: bold" align="justify">
						${departureDate}
					</td>
				</tr>
				<tr>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;width:33%" align="justify">
						Status
					</td>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;" align="justify">:</td>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;font-weight: bold;color: red" align="justify">
						${tourStatus}
					</td>
				</tr>
				<tr>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;width:33%" align="justify">
						Sender
					</td>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;" align="justify">:</td>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;" align="justify">
						${sender}
					</td>
				</tr>
				<tr>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 20px;width:33%" align="justify">
						Remarks
					</td>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 20px;" align="justify">:</td>
					<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 20px;" align="justify">
						${remarks}
					</td>
				</tr>
				<tr>
					<td colspan="3" style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;" align="center">
						*** Please take note that this invoice has been changed by certain reason. Thanks and have a great day! ***
					</td>
				</tr>
			</tbody>
		</table>
		<!--/Message-->
	
	</td>
	</tr>
	</tbody>
	</table>
	<!--/Paragraph-->
	