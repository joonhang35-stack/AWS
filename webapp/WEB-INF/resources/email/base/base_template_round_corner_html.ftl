    }

    @media screen and (max-width: 620px) {
      .email-container {
        width: 100% !important;
      }

      .outer-padding {
        padding: 20px 10px !important;
      }

      .header-padding {
        padding: 30px 24px 32px !important;
      }

      .content-padding {
