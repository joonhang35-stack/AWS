<body style="width:100%; margin:0; padding:0; background-color:#f3f3f3; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:transparent; mso-hide:all;">
    Reset or update your Apple Web System password.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f3f3f3" style="width:100%; background-color:#f3f3f3;">
    <tr>
