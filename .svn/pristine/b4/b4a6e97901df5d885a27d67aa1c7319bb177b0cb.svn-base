	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.purchase.service.PurchaseService#getSupplier()
	 */
	@Override
	public SupplierVO getSupplier(Long personId) throws BusinessException {
		PersonVO personVO = new PersonVO();
		SupplierVO supplierVO = new SupplierVO();
		AddressVO addressVO = new AddressVO();
		CorAddressVO corAddressVO = new CorAddressVO();
		CorporateVO corporateVO = new CorporateVO();
		CountryVO countryVO = new CountryVO();
		List<ContactVO> contactList = new ArrayList <ContactVO>();
		List<CorContactVO> corContactList = new ArrayList <CorContactVO>();
		
		String contactNo = null;
		personVO = purchaseDAO.getPerson(personId);
		supplierVO = purchaseEODAO.getSupplier(personId);
		
		if(supplierVO.getCode().equals("C")){
			corporateVO = purchaseDAO.getCompany(personId);
			Long corporateId = corporateVO.getId();
			corAddressVO = purchaseDAO.getCorAddress(corporateVO.getId());
			countryVO = purchaseEODAO.getCountry(corAddressVO.getCountryId());
			corContactList = purchaseDAO.getCorContactList(corporateId);
			
			supplierVO.setGivenName(personVO.getGivenName());
			supplierVO.setLastName(personVO.getLastName());
			supplierVO.setCorAddressVO(corAddressVO);
			
			supplierVO.setAdd1(corAddressVO.getAddr1());
			supplierVO.setAdd2(corAddressVO.getAddr2());
			supplierVO.setAdd3(corAddressVO.getAddr3());
			supplierVO.setCity(corAddressVO.getCity());
			supplierVO.setState(corAddressVO.getState());
			supplierVO.setPostcode(corAddressVO.getPostcode());
			
			for(int i = 0; i < corContactList.size(); i++){
				if(corContactList.get(i).getContactType().equals("Mobile")){
					contactNo = corContactList.get(i).getContactNo();
				}else if(contactNo == null){
					contactNo = corContactList.get(i).getContactNo();
				}
			}
		} else {
			addressVO = purchaseDAO.getAddress(personId);
			contactList = purchaseDAO.getContactList(personId);
			countryVO = purchaseEODAO.getCountry(addressVO.getCountryId());
			
			supplierVO.setGivenName(personVO.getGivenName());
			supplierVO.setLastName(personVO.getLastName());
			supplierVO.setAddressVO(addressVO);
			
			supplierVO.setAdd1(addressVO.getAddr1());
			supplierVO.setAdd2(addressVO.getAddr2());
			supplierVO.setAdd3(addressVO.getAddr3());
			supplierVO.setCity(addressVO.getCity());
			supplierVO.setState(addressVO.getState());
			supplierVO.setPostcode(addressVO.getPostcode());
			
			for(int i = 0; i < contactList.size(); i++){
				if(contactList.get(i).getContactType().equals("Mobile")){
					contactNo = contactList.get(i).getContactNo();
				}else if(contactNo == null){
					contactNo = contactList.get(i).getContactNo();
				}
			}
		}
		
		if (StringUtils.isBlank(supplierVO.getContactNo()))	supplierVO.setContactNo(contactNo);
		supplierVO.setContactList(contactList);
		supplierVO.setCorContactList(corContactList);
		supplierVO.setCountry(countryVO.getCountry());
		supplierVO.setCountryVO(countryVO);
		return supplierVO;
	}
	
