	@Override
	public SupplierVO getPayeeAsSupplier(Long idPayee, String payeeType, Long idCompany) throws BusinessException {
		if (StringUtils.equals(payeeType, CommonConstant.PAYEE_TYPE_EMPLOYEE)) {
			EmployeeViewVO employeeViewVO = userDAO.getEmployeeView(idPayee);
			validatePayeeAsSupplier(employeeViewVO);
			
			SupplierVO supplierVO = createSupplierFromEmployee(employeeViewVO);
			return supplierVO;
		} else if (StringUtils.equals(payeeType, CommonConstant.PAYEE_TYPE_SUPPLIER)) {
			SupplierVO supplierVO = createSupplierFromSupplier(idPayee, idCompany);
			return supplierVO;
		} else if (StringUtils.equals(payeeType, CommonConstant.PAYEE_TYPE_CUST)) {
			CustDetailsVO custDetailsVO = invoiceDAO.getCustDetails(idPayee);
//			validatePayeeAsSupplier(employeeViewVO);
			
			SupplierVO supplierVO = createSupplierFromCustDetails(custDetailsVO);
			return supplierVO;
		}
		return null;
	}
	
	private void validatePayeeAsSupplier(EmployeeViewVO employeeViewVO) throws BusinessException {
		if (StringUtils.isBlank(employeeViewVO.getIdNo())) throw new BusinessException(CommonErrConstant.ERR_SUPPLIER_PAYEE_NO_IC);
		if (StringUtils.isBlank(employeeViewVO.getAddr1())) throw new BusinessException(CommonErrConstant.ERR_SUPPLIER_PAYEE_NO_ADDR1);
		if (StringUtils.isBlank(employeeViewVO.getCity())) throw new BusinessException(CommonErrConstant.ERR_SUPPLIER_PAYEE_NO_CITY);
		if (StringUtils.isBlank(employeeViewVO.getState())) throw new BusinessException(CommonErrConstant.ERR_SUPPLIER_PAYEE_NO_STATE);
		if (employeeViewVO.getCountryId() == null) throw new BusinessException(CommonErrConstant.ERR_SUPPLIER_PAYEE_NO_COUNTRY);
		if (employeeViewVO.getUserVO() == null)	throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Employee not attached to user."));
		if (StringUtils.isBlank(employeeViewVO.getUserVO().getMobileNumber())) throw new BusinessException(CommonErrConstant.ERR_SUPPLIER_PAYEE_NO_CONTACT);
		
	}
	
	private SupplierVO createSupplierFromEmployee(EmployeeViewVO employeeViewVO) {
		SupplierVO supplierVO = new SupplierVO();
		supplierVO.setId(-1L);
		supplierVO.setFullName(employeeViewVO.getFullName());
		supplierVO.setIdType(EInvoiceConstant.E_INV_IDENTITY_TYPE_NRIC);
		supplierVO.setIdNo(employeeViewVO.getIdNo());
		supplierVO.setTaxIdNo(EInvoiceConstant.E_INV_GNRL_TIN_PUBLIC);
		if (StringUtils.isNotBlank(employeeViewVO.getMsicCode()))	supplierVO.setMsicCode(employeeViewVO.getMsicCode());
		else														supplierVO.setMsicCode(EInvoiceConstant.MSIC_CODE_NA);
		supplierVO.setAdd1(employeeViewVO.getAddr1());
		supplierVO.setAdd2(employeeViewVO.getAddr2());
		supplierVO.setAdd3(employeeViewVO.getAddr3());
		supplierVO.setCity(employeeViewVO.getCity());
		supplierVO.setPostcode(employeeViewVO.getPostcode());
		supplierVO.setState(employeeViewVO.getState());
		if (employeeViewVO.getCountryId() != null)	supplierVO.setCountryVO(purchaseEODAO.getCountry(employeeViewVO.getCountryId()));
		if (employeeViewVO.getUserVO() != null)	{
			supplierVO.setContactNo(employeeViewVO.getUserVO().getMobileNumber());
			supplierVO.setEmail(employeeViewVO.getUserVO().getEmailAddress());
		}
	    
		return supplierVO;
	}
	
	private SupplierVO createSupplierFromCustDetails(CustDetailsVO custDetailsVO) throws BusinessException {
		SupplierVO supplierVO = new SupplierVO();
		supplierVO.setId(-1L);
		
		if (!StringUtils.isBlank(custDetailsVO.getCompanyName())) {
			supplierVO.setFullName(custDetailsVO.getCompanyName());
		} else if (!StringUtils.isBlank(custDetailsVO.getContPersonName())) {
			supplierVO.setFullName(custDetailsVO.getContPersonName());
		}
		
		PartyIdentificationType partyIdentificationType = EInvoiceUtils.generatePartyIdentificationType(custDetailsVO, true);
		supplierVO.setIdNo(partyIdentificationType.getIDValue());
		supplierVO.setIdType(partyIdentificationType.getID().getSchemeID());
		
		// TIN
		// if no TIN, replace with general public TIN
		// 2025.09.17 update: TIN required in corporate profile
		if (SalesConstant.CUST_TYPE_CORPORATE.equals(custDetailsVO.getCustType()) && StringUtils.isBlank(custDetailsVO.getTaxIdNo())) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_CORP_NO_TIN);
		}
		else if (StringUtils.isBlank(custDetailsVO.getTaxIdNo())) {
			custDetailsVO.setTaxIdNo(EInvoiceConstant.E_INV_GNRL_TIN_PUBLIC);
		}
		supplierVO.setTaxIdNo(custDetailsVO.getTaxIdNo());
		
		// TODO cust as supplier MSIC code
		supplierVO.setMsicCode(EInvoiceConstant.MSIC_CODE_NA);
		
		// Address Line 1
		if (custDetailsVO.getAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getAddressVO().getAddr1())) {
			supplierVO.setAdd1(custDetailsVO.getAddressVO().getAddr1());
		} else if (custDetailsVO.getCorAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getCorAddressVO().getAddr1())) {
			supplierVO.setAdd1(custDetailsVO.getCorAddressVO().getAddr1());
		} else {
			throw new BusinessException(CommonErrConstant.ERR_CUST_NO_ADDR1);
		}
		
		// Address Line 2
		if (custDetailsVO.getAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getAddressVO().getAddr2())) {
			supplierVO.setAdd2(custDetailsVO.getAddressVO().getAddr2());
		} else if (custDetailsVO.getCorAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getCorAddressVO().getAddr2())) {
			supplierVO.setAdd2(custDetailsVO.getCorAddressVO().getAddr2());
		}
		
		// Address Line 3
		if (custDetailsVO.getAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getAddressVO().getAddr3())) {
			supplierVO.setAdd3(custDetailsVO.getAddressVO().getAddr3());
		} else if (custDetailsVO.getCorAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getCorAddressVO().getAddr3())) {
			supplierVO.setAdd3(custDetailsVO.getCorAddressVO().getAddr3());
		}
		
		// Customer City
		if (custDetailsVO.getAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getAddressVO().getCity())) {
			supplierVO.setCity(custDetailsVO.getAddressVO().getCity());
		} else if (custDetailsVO.getCorAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getCorAddressVO().getCity())) {
			supplierVO.setCity(custDetailsVO.getCorAddressVO().getCity());
		} else {
			throw new BusinessException(CommonErrConstant.ERR_CUST_NO_CITY);
		}
		
		// Customer Postcode
		if (custDetailsVO.getAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getAddressVO().getPostcode())) {
			supplierVO.setPostcode(custDetailsVO.getAddressVO().getPostcode());
		} else if (custDetailsVO.getCorAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getCorAddressVO().getPostcode())) {
			supplierVO.setPostcode(custDetailsVO.getCorAddressVO().getPostcode());
		} 
		
		// Customer State
		if (custDetailsVO.getAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getAddressVO().getState())) {
			supplierVO.setState(custDetailsVO.getAddressVO().getState());
			supplierVO.setCountryVO(purchaseEODAO.getCountry(custDetailsVO.getAddressVO().getCountryId()));
		} else if (custDetailsVO.getCorAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getCorAddressVO().getState())) {
			supplierVO.setState(custDetailsVO.getCorAddressVO().getState());
			supplierVO.setCountryVO(purchaseEODAO.getCountry(custDetailsVO.getCorAddressVO().getCountryId()));
		} 
		
		if (custDetailsVO.getCustType().equals("P")) {
			if (custDetailsVO.getContactList() != null && custDetailsVO.getContactList().size() > 0) {
				boolean found = false;
				for (PersonContactVO vo : custDetailsVO.getContactList()) {
					if(vo.getNumber().length() >= 8) {
						supplierVO.setContactNo(vo.getNumber().replaceAll("[^0-9]", ""));
						found = true;
					}
				}
				if (!found) {
					throw new BusinessException(CommonErrConstant.ERR_CUST_NO_CONTACT);
				}
				
			} else {
				throw new BusinessException(CommonErrConstant.ERR_CUST_NO_CONTACT);
			}
		} else if (custDetailsVO.getCustType().equals("C")) {
			if (custDetailsVO.getCorContactList() != null && custDetailsVO.getCorContactList().size() > 0) {
//				contactType1.setTelephone(custDetailsVO.getCorContactList().get(0).getContactNo().replaceAll("[^0-9]", ""));
				boolean found = false;
				for (CorContactVO vo : custDetailsVO.getCorContactList()) {
					if(vo.getContactNo().length() >= 8) {
						supplierVO.setContactNo(vo.getContactNo().replaceAll("[^0-9]", ""));
						found = true;
					}
				}
				if (!found) {
					throw new BusinessException(CommonErrConstant.ERR_CUST_NO_CONTACT);
				}
			} else {
				throw new BusinessException(CommonErrConstant.ERR_CUST_NO_CONTACT);
			}
		}
		
		if (!StringUtils.isBlank(custDetailsVO.getEmail())) {
			if (!FunctionUtils.isValidEmail(custDetailsVO.getEmail())) {
				throw new BusinessException(CommonErrConstant.ERR_CUST_EMAIL_INVALID);
			}
			supplierVO.setEmail(custDetailsVO.getEmail());
		}
		
		return supplierVO;
	}
	
	private SupplierVO createSupplierFromSupplier(Long idPayee, Long idCompany) throws BusinessException {
		SupplierVO supplierVO = supplierViewDAO.getSupplier(idPayee, idCompany);
		supplierVO = getSupplier(supplierVO.getPersonId());
		supplierVO.setIdType(EInvoiceConstant.E_INV_IDENTITY_TYPE_BRN);
		supplierVO.setIdNo(supplierVO.getRegNo());
		return supplierVO;
	}
}
