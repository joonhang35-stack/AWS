	public SystemNumberGenerationVO getSNGVO(String sysCd, Long companyId) throws BusinessException, QueueException {
		// example to get system next number
		SystemNumberGenerationVO vo = new SystemNumberGenerationVO();
		vo.setCode(sysCd);
		vo.setIdCompany(companyId);
		vo = SysNumGenUtil.getSysNumber(SysNumGenUtil.getIdx(vo));
		
		return vo;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.purchase.service.PurchaseEOService#update(com.bcs.zsg.purchase.vo.PurchaseVO)
	 */
	@Override
	public void updateExOrder(SupplierVO supplierVO, ExOrderVO exOrderVO, AddUpdDelVO eoDetailsAUDVO, 
			AddUpdDelVO paxNameAUDVO, AddUpdDelVO airLineAUDVO, AddUpdDelVO hotelTourAUDVO,AddUpdDelVO eoInvAUDVO) throws BusinessException {
		
		exOrderVO.setSupplierId(supplierVO.getId());
		purchaseDAO.update(exOrderVO);
		
		// insert / update eo itmes
		purchaseEODAO.terminateEOSubInfo("ex_order_item", exOrderVO.getId());
		if (CollectionUtils.isNotEmpty(exOrderVO.getEoDetailsList())) {
			for (ExOrderDetailsVO vo : exOrderVO.getEoDetailsList()) {
				vo.setStatusCode(BaseConstant.STATUS_ACTIVE);
				if (null == vo.getId()) {
					vo.setExOrderId(exOrderVO.getId());
					purchaseEODAO.insert(vo);
				} else purchaseEODAO.update(vo);
			}
		}
		// insert / update eo pax
		purchaseEODAO.terminateEOSubInfo("ex_order_pax", exOrderVO.getId());
		if (CollectionUtils.isNotEmpty(exOrderVO.getPaxNameList())) {
			for (PaxNameVO vo : exOrderVO.getPaxNameList()) {
				vo.setStatusCode(BaseConstant.STATUS_ACTIVE);
				if (null == vo.getId()) {
					vo.setExOrderId(exOrderVO.getId());
					purchaseEODAO.insert(vo);
				} else purchaseEODAO.update(vo);
			}
		}
		// insert / update eo airline
		purchaseEODAO.terminateEOSubInfo("ex_order_airline", exOrderVO.getId());
		if (CollectionUtils.isNotEmpty(exOrderVO.getAirlineList())) {
			for (AirLineDetailsVO vo : exOrderVO.getAirlineList()) {
				vo.setStatusCode(BaseConstant.STATUS_ACTIVE);
				if (null == vo.getId()) {
					vo.setExOrderId(exOrderVO.getId());
					purchaseEODAO.insert(vo);
				} else purchaseEODAO.update(vo);
			}
		}
		// insert / update eo hotel tours
		purchaseEODAO.terminateEOSubInfo("ex_order_hotel", exOrderVO.getId());
		if (CollectionUtils.isNotEmpty(exOrderVO.getHotelTourList())) {
			for (HotelTourVO vo : exOrderVO.getHotelTourList()) {
				vo.setStatusCode(BaseConstant.STATUS_ACTIVE);
				if (null == vo.getId()) {
					vo.setExOrderId(exOrderVO.getId());
					purchaseEODAO.insert(vo);
				} else purchaseEODAO.update(vo);
			}
		}
		// insert / update eo invoice
		//purchaseEODAO.terminateEOSubInfo("ex_order_inv", exOrderVO.getId());
		invoiceDAO.deleteInvoiceEOLink(null, exOrderVO.getId());
		if (CollectionUtils.isNotEmpty(exOrderVO.getEoInvList())) {
			for (EOInvoiceVO vo : exOrderVO.getEoInvList()) {
				//vo.setStatusCode(BaseConstant.STATUS_ACTIVE);
				//if (null == vo.getId()) {
					vo.setEoId(exOrderVO.getId());
					purchaseEODAO.insert(vo);
				//} else purchaseEODAO.update(vo);
			}
		}
		
		/*if (eoDetailsAUDVO.getAddList().size() > 0) {
			for (Object vo : eoDetailsAUDVO.getAddList()) {
				ExOrderDetailsVO exOrderDetailsVO = (ExOrderDetailsVO) vo;
				exOrderDetailsVO.setExOrderId(exOrderVO.getId());
				purchaseEODAO.insert(exOrderDetailsVO);
			}
		}
 
		if (eoDetailsAUDVO.getUpdList().size() > 0) {
			for (Object vo : eoDetailsAUDVO.getUpdList()) {
				ExOrderDetailsVO exOrderDetailsVO = (ExOrderDetailsVO) vo;
				purchaseEODAO.update(exOrderDetailsVO);
			}
		}
 
		if (eoDetailsAUDVO.getDelList().size() > 0) {
			for (Object vo : eoDetailsAUDVO.getDelList()) {
				ExOrderDetailsVO exOrderDetailsVO = (ExOrderDetailsVO) vo;
				purchaseEODAO.delete(exOrderDetailsVO);
			}
		}
 
		if (paxNameAUDVO.getAddList().size() > 0) {
			for (Object vo : paxNameAUDVO.getAddList()) {
				PaxNameVO paxNameVO = (PaxNameVO) vo;
				paxNameVO.setExOrderId(exOrderVO.getId());
				purchaseEODAO.insert(paxNameVO);
			}
		}

		if (paxNameAUDVO.getUpdList().size() > 0) {
			for (Object vo : paxNameAUDVO.getUpdList()) {
				PaxNameVO paxNameVO = (PaxNameVO) vo;
				purchaseEODAO.update(paxNameVO);
			}
		}


		if (paxNameAUDVO.getDelList().size() > 0) {
			for (Object vo : paxNameAUDVO.getDelList()) {
				PaxNameVO paxNameVO = (PaxNameVO) vo;
				purchaseEODAO.delete(paxNameVO);
			}
		}
 
		if (airLineAUDVO.getAddList().size() > 0) {
			for (Object vo : airLineAUDVO.getAddList()) {
