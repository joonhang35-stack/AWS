	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.purchase.service.PurchaseEOService#getExOrderList()
	 */
	@Override
	public List<ExOrderVO> getExOrderList(Long companyId) throws BusinessException {
		List<ExOrderVO> eoList = purchaseEODAO.getExOrderList(companyId);
		UserVO orderUsrVO = new UserVO();
		UserVO apprUsrVO = new UserVO();
		
		for(int i = 0; i < eoList.size(); i++) {
			//Long exOrderId = eoList.get(i).getId();
			Long supplierId = eoList.get(i).getSupplierId();
			Long ordererId = eoList.get(i).getOrderedId();
			Long approverId = eoList.get(i).getApproverId();
			
			SupplierVO supplierVO = purchaseEODAO.getEOSupplier(supplierId);
			//CompanyVO companyVO = purchaseEODAO.getCompany(companyId);
			EmployeeVO ordererVO = purchaseEODAO.getOrderer(ordererId);
			EmployeeVO approverVO = purchaseEODAO.getApprover(approverId);

			PersonVO suppPersonVO = purchaseEODAO.getPerson(supplierVO.getPersonId());
			CorporateVO corporateVO = purchaseEODAO.getCorporate(suppPersonVO.getId());
			
			orderUsrVO = purchaseEODAO.getUser(ordererVO.getSecUser());
			apprUsrVO = purchaseEODAO.getUser(approverVO.getSecUser());

			eoList.get(i).setPersonId(suppPersonVO.getId());
			eoList.get(i).setSupplierName(corporateVO.getCompanyName());
			
			eoList.get(i).setOrderBy(orderUsrVO.getName());
			eoList.get(i).setApproveBy(apprUsrVO.getName());
			
			DateFormat dtformat = new SimpleDateFormat("dd-MMM-yyyy");
			eoList.get(i).setStrEODt(dtformat.format(eoList.get(i).getEoDt()));
			eoList.get(i).setStrDueDt(dtformat.format(eoList.get(i).getEoDt()));
			eoList.get(i).setTourDepVO(tourPkgBO.getTourDepById( eoList.get(i).getTourId()));
		}
		return eoList;
	}

