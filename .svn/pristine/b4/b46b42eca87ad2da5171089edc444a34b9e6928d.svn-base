<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="user_profile_form">
	
	<!-- backing bean, extends com.bcs.zsg.component.common.web.swf.bean.AppBackingBean -->
	<var name="userBean" class="com.bcs.zsg.cfg.sec.web.bean.UserBean"/>
	
	<view-state id="user_profile_form">
		<on-entry>
			<evaluate expression="userBean.profileInit()"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>