package com.bcs.zsg.web.object;

public class objHotelStay {

	public int ID;
	public String days;
	public String hotel;
	public String website;
	public String star;
	public String remarks;
	
	public void setID(int tempStr)
	{
		ID = tempStr;
	}
	
	public int getID()
	{
		return ID;
	}

	public void setDays(String tempStr)
	{
		days = tempStr;
	}
	
	public String getDays()
	{
		return days;
	}


	public void setHotel(String tempStr)
	{
		hotel = tempStr;
	}
	
	public String getHotel()
	{
		return hotel;
	}
	

	public void setWebsite(String tempStr)
	{
		website = tempStr;
	}
	
	public String getWebsite()
	{
		return website;
	}

	public void setStar(String tempStr)
	{
		star = tempStr;
	}
	
	public String getStar()
	{
		return star;
	}
	

	public void setRemarks(String tempStr)
	{
		remarks = tempStr;
	}
	
	public String getRemarks()
	{
		return remarks;
	}
}
