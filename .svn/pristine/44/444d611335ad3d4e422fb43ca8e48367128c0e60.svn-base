<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.sales.vo">

    <class table="online_booking_payment" name="OnlineBookingPaymentVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="idBooking" type="long" column="id_booking"/>
        <property name="idIpayConfig" type="long" column="id_ipay_config"/>
        <property name="idInvoice" type="long" column="id_invoice"/>
        <property name="idInvoiceAdminCharges" type="long" column="id_invoice_admin_charges"/>
        <property name="prefixAdminCharges" type="string" column="prefix_admin_charges"/>
        <property name="prefix" type="string" column="prefix"/>
        <property name="email" type="string" column="email"/>
        <property name="paymentAmt" type="big_decimal" column="payment_amt"/>
        <property name="adminChargesPercentage" type="big_decimal" column="admin_charges_percentage"/>
        <property name="adminCharges" type="big_decimal" column="admin_charges"/>
        <property name="totalPaymentAmt" type="big_decimal" column="total_payment_amt"/>
        <property name="paymentStatus" type="string" column="payment_status"/>
        <property name="dtExpiry" type="timestamp" column="dt_expiry"/>
        <property name="transId" type="string" column="trans_id"/>
        <property name="authCode" type="string" column="auth_code"/>
        <property name="ccName" type="string" column="cc_name"/>
        <property name="ccNo" type="string" column="cc_no"/>
        <property name="sBankname" type="string" column="s_bankname"/>
        <property name="sCountry" type="string" column="s_country"/>

        <!-- BaseVO attributes -->
        <property name="remarks" type="string" column="remarks"/>
        <property name="statusCd" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>