        <function-class>com.bcs.zsg.common.helper.LookupItemUtils</function-class>
        <function-signature>List getLookupItemList(java.lang.String)</function-signature>
    </function>
    
    <function>
        <function-name>lookupItemVO</function-name>
        <function-class>com.bcs.zsg.common.helper.LookupItemUtils</function-class>
        <function-signature>LookupItemVO getLookupItemVO(java.lang.String, java.lang.String)</function-signature>
    </function>
    
    <function>
        <function-name>lookupItemDesc</function-name>
        <function-class>com.bcs.zsg.common.helper.LookupItemUtils</function-class>
        <function-signature>String getLookupItemDesc(java.lang.String, java.lang.String)</function-signature>
    </function>

	<function>
        <function-name>globalConfigList</function-name>
        <function-class>com.bcs.zsg.common.helper.LookupItemUtils</function-class>
        <function-signature>List getGlobalConfigList(java.lang.String)</function-signature>
    </function>
    
    <function>
        <function-name>globalConfigVO</function-name>
        <function-class>com.bcs.zsg.common.helper.LookupItemUtils</function-class>
        <function-signature>LookupItemVO getGlobalConfigVO(java.lang.String, java.lang.String)</function-signature>
    </function>
    
    <function>
        <function-name>globalConfigValue</function-name>
        <function-class>com.bcs.zsg.common.helper.LookupItemUtils</function-class>
        <function-signature>String getGlobalConfigValue(java.lang.String, java.lang.String)</function-signature>
    </function>
    
    <function>
