        <function-signature>FinancialPeriodLockVO getFinPeriodLockVO(java.lang.Long)</function-signature>
    </function>
    
    <function>
        <function-name>isNotificationAvailable</function-name>
        <function-class>com.bcs.zsg.common.helper.LookupItemUtils</function-class>
        <function-signature>boolean isNotificationAvailable()</function-signature>
    </function>
    
    <function>
        <function-name>sysNumGenVO</function-name>
        <function-class>com.bcs.zsg.common.helper.LookupItemUtils</function-class>
        <function-signature>SystemNumberGenerationVO getSysNumGenVO(java.lang.Long, java.lang.String)</function-signature>
