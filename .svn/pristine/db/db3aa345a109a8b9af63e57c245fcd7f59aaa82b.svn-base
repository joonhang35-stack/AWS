	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getFinPeriod1stDt(java.lang.Long)
	 */
	@Override
	public Date getFinPeriod1stDt(Long idCompany) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		/*sb.append("select dt_start from financial_period where year = ").
			append("(select year from financial_period where date(sysdate()) between date(dt_start) and date(dt_end) and id_company = :idCompany) ").
			append("and id_company = :idCompany order by dt_start");*/
		
		sb.append("select dt_start from financial_period where year = ").
			append("(select year from financial_period where status != -1 and id_company = :idCompany order by dt_start limit 1) ").
			append("and id_company = :idCompany order by dt_start");
		
		Query query = createSQLQuery(sb.toString());
		query.setLong("idCompany", idCompany);
		query.setMaxResults(1);
		Date dtStart = (Date) query.uniqueResult();
		return dtStart;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#isClosedAcct(java.lang.Long, java.lang.Long)
	 */
	@Override
	public boolean isClosedAcct(Long idCompany, Long idAcct) throws BusinessException {
		boolean rtn = false;
		Query query = createSQLQuery("select count(b.id) from account a, account_bal b where a.id = b.id_acct and a.id_company = :idCompany and a.id = :idAcct and a.status_cd = 'A' group by a.id");
		query.setLong("idCompany", idCompany);
		query.setLong("idAcct", idAcct);
		if (((BigInteger) query.uniqueResult()).intValue() > 1) rtn = true;
		
		return rtn;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#isAcctBeginBalExisted(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@Override
	public boolean isAcctBeginBalExisted(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		boolean rtn = false;
		Query query = createSQLQuery("select count(b.id) " +
				"from account a, account_bal b " +
				"where a.id = b.id_acct and id_company = :idCompany and date(dt_begin_bal) between date(:frDate) and date(:toDate)");
		query.setLong("idCompany", idCompany);
		query.setDate("frDate", searchParamVO.getFromDate());
		query.setDate("toDate", searchParamVO.getToDate());
		if (((BigInteger) query.uniqueResult()).intValue() > 0) rtn = true;
		
		return rtn;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getFinPeriodYear(java.lang.Long)
	 */
	@Override
	public String getFinPeriodYear(Long idCompany) throws BusinessException {
		Query query = createSQLQuery("select year from financial_period where id_company = :idCompany and date(sysdate()) between date(dt_start) and date(dt_end)");
		query.setLong("idCompany", idCompany);
		Object obj = query.uniqueResult();
		return obj == null ? "" : (String) obj;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getFinPeriodYearList(java.lang.Long)
	 */
	@Override
	public List<String> getFinPeriodYearList(Long idCompany) throws BusinessException {
		Query query = createSQLQuery("select year from financial_period where id_company = :idCompany group by year");
		query.setLong("idCompany", idCompany);
		return query.list();
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getBalanceSheetList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctViewVO> getBalanceSheetList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		List<AcctViewVO> list = new ArrayList<AcctViewVO>();
		Session session = this.getSessionFactory().openSession();
		
		try {
			session.getTransaction().setTimeout(240);
			session.beginTransaction();
			
			sb.append("select a.id AS 'id', a.id_company AS 'idCompany', ").
				append("a.id_acct_cat AS 'idAcctCat', c.description AS 'acctCatDesc', c.code AS 'acctCatCode', ").
				append("a.id_acct_sub_cat AS 'idAcctSubCat', sc.description AS 'acctSubCatDesc', sc.code AS 'acctSubCatCode', ").
				append("a.code AS 'code', '' AS 'subCode', a.description AS 'desc', '' AS 'subDesc', ").
				append("sum( ").
					append("round(ifnull((select (b.debit_begin_bal - b.credit_begin_bal) from account_bal b where b.id_acct = a.id and date(b.dt_begin_bal) between date(:frDateYear) and date(:toDateYear) order by id limit 1),0),2) + ").
					append("round(ifnull((select case when (sum(t.debit) - sum(t.credit)) is null then 0 else (sum(t.debit) - sum(t.credit)) end from account_trans t where t.id_company = :idCompany and t.id_acct = a.id and status_cd = 'A' and date(t.dt_trans) between date(:frDate) and date(:toDate)),0),2) ").
				append(") as 'debitCurrBal', ").
				append("sum(ifnull(ad.creditCurrBal, 0)) as 'creditCurrBal', ").
				append("sum( ").
					append("round(ifnull((select (b.debit_begin_bal - b.credit_begin_bal) from account_bal b where b.id_acct = a.id and date(b.dt_begin_bal) between date(:frDateYear) and date(:toDateYear) order by id limit 1),0),2) + ").
					append("round(ifnull((select case when (sum(t.debit) - sum(t.credit)) is null then 0 else (sum(t.debit) - sum(t.credit)) end from account_trans t where t.id_company = :idCompany and t.id_acct = a.id and status_cd = 'A' and date(t.dt_trans) between date(:frDate) and date(:toDate)),0),2) + ").
					append("ifnull(ad.creditCurrBal, 0) ").
				append(") as 'debitBeginBal', ").
				append("sc.description AS 'group', a.status_cd AS 'statusCode', a.dt_created AS 'createdDate', a.created_by AS 'createdBy' ").
				append("from account a ").
					append("left join ( ").
					append("select a.id_company, a.id_acct_fa, a.id_acct_depr, ").
					append("( ").
						append("round(ifnull((select (b.debit_begin_bal - b.credit_begin_bal) from account_bal b where b.id_acct = a.id_acct_depr and date(b.dt_begin_bal) between date(:frDateYear) and date(:toDateYear) order by id limit 1),0),2) +  ").
						append("round(ifnull((select case when (sum(t.debit) - sum(t.credit)) is null then 0 else (sum(t.debit) - sum(t.credit)) end from account_trans t where t.id_company = :idCompany and t.id_acct = a.id_acct_depr and t.status_cd = 'A' and date(t.dt_trans) between date(:frDate) and date(:toDate)),0),2) ").
					append(") AS 'creditCurrBal' ").
					append("from account_depr a ").
					append(") ad on ad.id_company = :idCompany and ad.id_acct_fa = a.id, ").
				append("account_cat c, account_sub_cat sc ").
				append("where a.id_company = :idCompany and ").
				append("a.status_cd = :statusCd and ").
				append("a.id_acct_cat = c.id and ").
				append("a.id_acct_sub_cat = sc.id and ").
				append("c.code in ('A', 'L', 'E') and ").
				append("a.id not in (select id_acct_depr from account_depr where id_company = :idCompany) ").
				append("group by a.id_acct_cat, a.id_acct_sub_cat, a.code ").
				append("order by c.seq_no, a.id_acct_cat, ").
					append("case when c.code = 'A' then FIELD(sc.code, 'FA', 'IP', 'L.INVEST', 'CA') ").
					append("else a.id_acct_sub_cat end, ").
					// Liabilities Sorting
					append("case when c.code = 'L' then FIELD(a.code, ").
						append("'2430', '2410', '2400', '2103', '2102', '2101', '2100', '2015', '2303', ").
						append("'2302', '2301', '2300', '1303', '1400', '2010', '2000') end desc, ").
				append("a.code ");
				//append("order by c.seq_no, a.id_acct_cat, a.id_acct_sub_cat, a.code");
			
			SQLQuery query = (SQLQuery) session.createSQLQuery(sb.toString());
			query.addScalar("id", LongType.INSTANCE);
			query.addScalar("idCompany", LongType.INSTANCE);
			query.addScalar("idAcctCat", LongType.INSTANCE);
			query.addScalar("acctCatDesc");
			query.addScalar("acctCatCode");
			query.addScalar("idAcctSubCat", LongType.INSTANCE);
			query.addScalar("acctSubCatDesc");
			query.addScalar("acctSubCatCode");
			query.addScalar("code");
			query.addScalar("subCode");
			query.addScalar("desc");
			query.addScalar("subDesc");
			query.addScalar("debitCurrBal");
			query.addScalar("creditCurrBal");
			query.addScalar("debitBeginBal");
			query.addScalar("group");
			query.addScalar("statusCode");
			query.addScalar("createdBy");
			query.addScalar("createdDate", DateType.INSTANCE);
			query.setParameter("frDateYear", (Date) searchParamVO.getFromDate());
			query.setParameter("toDateYear", (Date) searchParamVO.getToDate());
			query.setParameter("frDate", (Date) searchParamVO.getFromDate()); // Alway start from selected year 1st day
			query.setParameter("toDate", (Date) searchParamVO.getObj3());
			query.setParameter("idCompany", idCompany);
			query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			query.setResultTransformer(Transformers.aliasToBean(AcctViewVO.class));
			list = query.list();
			
			session.getTransaction().commit();
		} catch (Exception e) {
			session.getTransaction().rollback();
			throw e;
		} finally {
			session.close();
		}
		return list;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getBalanceSheetDetailsList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctViewVO> getBalanceSheetDetailsList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		sb.append("select distinct a.id AS 'id', a.id_company AS 'idCompany', ").
			append("a.id_acct_cat AS 'idAcctCat', c.description AS 'acctCatDesc', c.code AS 'acctCatCode', a.id_acct_sub_cat AS 'idAcctSubCat', sc.description AS 'acctSubCatDesc', ").
			append("a.code AS 'code', a.sub_code AS 'subCode', a.description AS 'desc', a.sub_description AS 'subDesc', ").
			append("( ").
				append("round(ifnull((select (b.debit_begin_bal - b.credit_begin_bal) from account_bal b where b.id_acct = a.id and b.dt_begin_bal between date(:frDateYear) and date(:toDateYear) order by id limit 1),0),2) + ").
				append("round(ifnull((select case when (sum(t.debit) - sum(t.credit)) is null then 0 else (sum(t.debit) - sum(t.credit)) end from account_trans t where t.id_company = :idCompany and t.id_acct = a.id and status_cd = 'A' and t.dt_trans between date(:frDate) and date(:toDate)),0),2) ").
			append(") AS 'debitCurrBal', ").
			append("sc.description AS 'group', a.status_cd AS 'statusCode', a.dt_created AS 'createdDate', a.created_by AS 'createdBy' ").
			append("from account a, account_cat c, account_sub_cat sc ").
			append("where a.id_company = :idCompany and ").
			append("a.status_cd = :statusCd and ").
			append("a.id_acct_cat = c.id and ").
			append("a.id_acct_sub_cat = sc.id and ").
			append("c.code in ('A', 'L', 'E') ").
			append("order by c.seq_no, a.id_acct_cat, ").
				append("case when c.code = 'A' then FIELD(sc.code, 'FA', 'L.INVEST', 'CA') ").
				append("else a.id_acct_sub_cat end, ").
				// Liabilities Sorting
				append("case when c.code = 'L' then FIELD(a.code, ").
					append("'2430', '2410', '2400', '2103', '2102', '2101', '2100', '2015', '2303', ").
					append("'2302', '2301', '2300', '1303', '1400', '2010', '2000') end desc, ").
			append("a.code, a.sub_code ");
		//append("order by c.seq_no, a.id_acct_cat, a.id_acct_sub_cat, code, subCode");
		
		SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
		query.addScalar("id", LongType.INSTANCE);
		query.addScalar("idCompany", LongType.INSTANCE);
		query.addScalar("idAcctCat", LongType.INSTANCE);
		query.addScalar("acctCatDesc");
		query.addScalar("acctCatCode");
		query.addScalar("idAcctSubCat", LongType.INSTANCE);
		query.addScalar("acctSubCatDesc");
		query.addScalar("code");
		query.addScalar("subCode");
		query.addScalar("desc");
		query.addScalar("subDesc");
		query.addScalar("debitCurrBal");
		query.addScalar("group");
		query.addScalar("statusCode");
		query.addScalar("createdBy");
		query.addScalar("createdDate", DateType.INSTANCE);
		query.setParameter("frDateYear", (Date) searchParamVO.getFromDate());
		query.setParameter("toDateYear", (Date) searchParamVO.getToDate());
		query.setParameter("frDate", (Date) searchParamVO.getFromDate()); // Alway start from selected year 1st day
		query.setParameter("toDate", (Date) searchParamVO.getObj3());
		query.setParameter("idCompany", idCompany);
		query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
		query.setResultTransformer(Transformers.aliasToBean(AcctViewVO.class));
		return query.list();
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getBeginningBalanceList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctViewVO> getBeginningBalanceList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		sb.append("select a.id as 'id',a.id_acct_cat as 'idAcctCat', ac.description as 'acctCatDesc', a.code as 'code', a.sub_code as 'subCode', a.description as 'desc', a.sub_description as 'subDesc', ").
		append("round( ").
			append("ifnull((select b.debit_begin_bal from account_bal b where b.id_acct = a.id and date(b.dt_begin_bal) between date(:frYearDate) and date(:toYearDate) order by id limit 1),0) - ").
			append("ifnull((select b.credit_begin_bal from account_bal b where b.id_acct = a.id and date(b.dt_begin_bal) between date(:frYearDate) and date(:toYearDate) order by id limit 1),0) ").
		append(",2) as 'debitCurrBal' ").
		append("from account a left join account_cat ac on a.id_acct_cat = ac.id ").
		append("where a.id_company = :idCompany and ").
		append("a.status_cd = :statusCd ").
		append("group by a.id having debitCurrBal != 0 ").
		append("order by a.code, a.sub_code ");

		SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
		query.addScalar("id", LongType.INSTANCE);
		query.addScalar("idAcctCat", LongType.INSTANCE);
		query.addScalar("acctCatDesc");
		query.addScalar("code");
		query.addScalar("subCode");
		query.addScalar("desc");
		query.addScalar("subDesc");
		query.addScalar("debitCurrBal");
		query.setParameter("frYearDate", (Date) searchParamVO.getFromDate()); // Alway start from selected year 1st day
		query.setParameter("toYearDate", (Date) searchParamVO.getToDate());
		query.setParameter("idCompany", idCompany);
		query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
		query.setResultTransformer(Transformers.aliasToBean(AcctViewVO.class));
		return query.list();
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getDebtorLedgerList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctViewVO> getDebtorLedgerList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		Session session = this.getSessionFactory().openSession();
		StringBuilder sb = new StringBuilder();
		List<AcctViewVO> acctViewList = new ArrayList<AcctViewVO>();
		
		long start = System.currentTimeMillis();
		try {
			session.getTransaction().setTimeout(360);
			session.beginTransaction();
			
			sb.append("select ").
				append("y.dtInv, y.transType, ").
				append("y.invNo as invoiceNo, ").
				append("y.invNo, ").
				append("cm.code as 'custCd', cm.pc_type_cd as 'custType', ").
				append("concat(UPPER(ps.salutation_cd), ' ', ps.last_name, ' ', ps.first_name) as 'custName', ").
				append("cm.corporate_name as 'companyName', y.ponumber as 'poNumber', ").
				append("if(y.id_customer is null, 0.0, y.amount) as 'amount', ").
				append("if(y.id_customer is null, 0.0, y.payment) as 'payment', ").
				append("if(y.id_customer is null, x.balanceDue, y.balance) as 'balance', ").
				append("if(y.id_customer is null, 0.0, ifnull(y.amount, 0.0) - ifnull(y.payment, 0.0)) as 'balanceDue', ").
				append("case ").
					append("when y.transType = 'Payment' or y.transType = 'CN-Payment' then y.invoiceNo ").
					append("when y.transType = 'Credit Note'  then y.cn_inv_no ").
					append("else '' ").
	        	append("end as invCnNo, ").
	        	append("case ").
		        	append("when y.transType = 'Sales Invoice' or y.transType = 'Payment' or y.transType = 'PS-Payment' then y.ps_no ").
		        	append("when y.transType = 'Credit Note'  then y.cn_ps_no ").
		        	append("else '' ").
			    append("end as psNo ").
			append("from ( ").
				append("select a.id, a.id_customer, a.dt_inv as 'dtInv', a.trans_type as 'transType', a.code as 'invNo', ").
					append("sum(ifnull(a.amount, 0.0)) as 'amount', sum(ifnull(a.payment, 0.0)) as 'payment', ").
					append("sum(ifnull(a.amount, 0.0)) - sum(ifnull(a.payment, 0.0)) as 'balanceDue' ").
				append("from ( ").
					append("select i.code as 'invoiceNo', i.id, i.id_customer, i.dt_inv as dt_inv, ").
					append("case when i.doc_type_cd = 'I' then 'Sales Invoice' when i.doc_type_cd = 'P' then 'Pax Statement' else 'Credit Note' end as trans_type, i.code, ").
						append("case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.amount else null end as amount, ").
						append("case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then null else i.amount end as payment ").
					append("from invoice i where i.id_company = :idCompany ").
						append("and case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.status_cd != 'VD' else i.status_cd != 'CC' and i.status_cd != 'VD' end ").
						append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('OP', 'RW'))) ").
						append("and date(i.dt_inv) <= date(:toDate) and i.id_acct = :acctId ");
					if (searchParamVO.getObj4() != null) {
						sb.append("and i.id_customer = :idCustomer ");
					}
						sb.append("union all ").
					append("select i.code as 'invoiceNo', i.id, i.id_customer, ").
						append("IF(cb.dt_trans IS NOT NULL, cb.dt_trans, ip.dt_pmnt) as dt_inv, ").
						append("case when i.doc_type_cd = 'I' then 'Payment' when i.doc_type_cd = 'P' then 'PS-Payment' else 'CN-Payment' end as trans_type, ip.code, ").
						append("case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then null else ip.amount end as amount, ").
						append("case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then ip.amount else null end as payment ").
					append("from invoice i ").
					append("INNER JOIN invoice_pmnt ip ON i.id = ip.id_inv AND ip.status_cd = 'A' ").
					append("LEFT JOIN invoice_pmnt parent ON ip.id_parent_pmnt IS NOT NULL AND ip.id_parent_pmnt = parent.id ").
					append("LEFT JOIN inv_pmnt_cashbook_link link on link.status_cd = 'A' and ").
					append("(CASE WHEN parent.id_parent_pmnt IS NOT NULL THEN parent.id_parent_pmnt WHEN ip.id_parent_pmnt IS NOT NULL THEN ip.id_parent_pmnt ELSE ip.id END) = link.id_inv_pmnt ").
					append("LEFT JOIN cash_book cb ON cb.status_cd = 'A' AND link.id_cash_book = cb.id ").
					append("where i.id_company = :idCompany ").
					append("and case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.status_cd != 'VD' else i.status_cd != 'CC' and i.status_cd != 'VD' end ").
					append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('OP', 'RW'))) ").
					append("and if(cb.dt_trans is not null, cb.dt_trans, ip.dt_pmnt) <= date(:toDate) ").
					append("and i.id_acct = :acctId ");
					if (searchParamVO.getObj4() != null) {
						sb.append("and i.id_customer = :idCustomer ");
					}
				sb.append(") a ").
				append("group by a.id_customer ").
			append(") x left join  ").
			append("( ").
				append("select a.id, a.id_customer, a.dt_inv as 'dtInv', a.trans_type as 'transType', a.invoiceNo, a.code as 'invNo', ").
					append("a.ponumber as 'poNumber', ifnull(a.amount, 0.0) as 'amount', ifnull(a.payment, 0.0) as 'payment', ").
					append("ifnull(b.balance, 0.0) as 'balance', ifnull(a.amount, 0.0) - ifnull(a.payment, 0.0) as 'balanceDue', ").
					append("a.ps_no, a.cn_inv_no, a.cn_ps_no ").
				append("from ( ").
					append("select i.code as 'invoiceNo', i.id, i.id_customer, i.dt_inv as dt_inv, ").
					append("case when i.doc_type_cd = 'I' then 'Sales Invoice' when i.doc_type_cd = 'P' then 'Pax Statement' else 'Credit Note' end as trans_type, i.code, ").
						append("'' as ponumber, ").
						append("case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.amount else null end as amount, ").
						append("case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then null else i.amount end as payment, ").
						append("i.ps_no, i.cn_inv_no, i.cn_ps_no ").
					append("from invoice i where i.id_company = :idCompany ").
						append("and case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.status_cd != 'VD' else i.status_cd != 'CC' and i.status_cd != 'VD' end ").
						append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('OP', 'RW'))) ").
						append("and date(i.dt_inv) between date(:frDate) and date(:toDate) and i.id_acct = :acctId ");
					if (searchParamVO.getObj4() != null) {
						sb.append("and i.id_customer = :idCustomer ");
					}	
					sb.append("union all ").
					append("select i.code as 'invoiceNo', i.id, i.id_customer, ").
						append("IF(cb.dt_trans IS NOT NULL, cb.dt_trans, ip.dt_pmnt) as dt_inv, ").
						append("case when i.doc_type_cd = 'I' then 'Payment' when i.doc_type_cd = 'P' then 'PS-Payment' else 'CN-Payment' end as trans_type, ip.code, ").
						append("ip.ref_no as ponumber, ").
						append("case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then null else ip.amount end as amount, ").
						append("case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then ip.amount else null end as payment, ").
						append("i.ps_no, i.cn_inv_no, i.cn_ps_no ").
					append("from invoice i ").
					append("INNER JOIN invoice_pmnt ip ON i.id = ip.id_inv AND ip.status_cd = 'A' ").
					append("LEFT JOIN invoice_pmnt parent ON ip.id_parent_pmnt IS NOT NULL AND ip.id_parent_pmnt = parent.id ").
					append("LEFT JOIN inv_pmnt_cashbook_link link on link.status_cd = 'A' and ").
					append("(CASE WHEN parent.id_parent_pmnt IS NOT NULL THEN parent.id_parent_pmnt WHEN ip.id_parent_pmnt IS NOT NULL THEN ip.id_parent_pmnt ELSE ip.id END) = link.id_inv_pmnt ").
					append("LEFT JOIN cash_book cb ON cb.status_cd = 'A' AND link.id_cash_book = cb.id ").
					append("where i.id_company = :idCompany ").
						append("and case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.status_cd != 'VD' else i.status_cd != 'CC' and i.status_cd != 'VD' end ").
						append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('OP', 'RW'))) ").
						append("and if(cb.dt_trans is not null, cb.dt_trans, ip.dt_pmnt) between date(:frDate) and date(:toDate) ").
						append("and i.id_acct = :acctId ");
					if (searchParamVO.getObj4() != null) {
						sb.append("and i.id_customer = :idCustomer ");
					}
				sb.append(") a left join ( ").
					append("select a.id, a.id_customer, ").
						append("sum(ifnull(a.amount, 0.0)) - sum(ifnull(a.payment, 0.0)) as 'balance' ").
					append("from ( ").
						append("select i.id, i.id_customer, ").
							append("case when (i.doc_type_cd = 'I' or i.doc_type_cd = 'P') then i.amount else null end as amount, ").
							append("case when (i.doc_type_cd = 'I' or i.doc_type_cd = 'P') then null else i.amount end as payment ").
						append("from invoice i where i.id_company = :idCompany ").
						append("and case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.status_cd != 'VD' else i.status_cd != 'CC' and i.status_cd != 'VD' end ").
						append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('OP', 'RW'))) ").
							append("and date(i.dt_inv) < date(:frDate) and i.id_acct = :acctId ");
						if (searchParamVO.getObj4() != null) {
							sb.append("and i.id_customer = :idCustomer ");
						}
						sb.append("union all ").
						append("select i.id, i.id_customer, ").
							append("case when (i.doc_type_cd = 'I' or i.doc_type_cd = 'P') then null else ip.amount end as amount, ").
							append("case when (i.doc_type_cd = 'I' or i.doc_type_cd = 'P') then ip.amount else null end as payment ").
						append("from invoice i ").
						append("INNER JOIN invoice_pmnt ip ON i.id = ip.id_inv AND ip.status_cd = 'A' ").
						append("LEFT JOIN invoice_pmnt parent ON ip.id_parent_pmnt IS NOT NULL AND ip.id_parent_pmnt = parent.id ").
						append("LEFT JOIN inv_pmnt_cashbook_link link on link.status_cd = 'A' and ").
						append("(CASE WHEN parent.id_parent_pmnt IS NOT NULL THEN parent.id_parent_pmnt WHEN ip.id_parent_pmnt IS NOT NULL THEN ip.id_parent_pmnt ELSE ip.id END) = link.id_inv_pmnt ").
						append("LEFT JOIN cash_book cb ON cb.status_cd = 'A' AND link.id_cash_book = cb.id ").
						append("where i.id_company = :idCompany ").
							append("and case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.status_cd != 'VD' else i.status_cd != 'CC' and i.status_cd != 'VD' end ").
							append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('OP', 'RW'))) ").
							append("and if(cb.dt_trans is not null, cb.dt_trans, ip.dt_pmnt) < date(:frDate) ").
							append("and i.id_acct = :acctId ");
						if (searchParamVO.getObj4() != null) {
							sb.append("and i.id_customer = :idCustomer ");
						}
					sb.append(") a ").
					append("group by a.id_customer ").
				append(") b on a.id_customer = b.id_customer ").
			append(") y on x.id_customer = y.id_customer ").
			append("left join customer cm on if(y.id_customer is null, x.id_customer, y.id_customer)=cm.id ").
			append("left join person ps on cm.id_pc=ps.id ").
			append("where ((CAST(x.balanceDue AS DECIMAL(10,2)) = 0.00 and y.id_customer is not null) or (CAST(x.balanceDue AS DECIMAL(10,2)) != 0.00 and y.id_customer is not null) or (CAST(x.balanceDue AS DECIMAL(10,2)) != 0.00 and y.id_customer is null)) ");
			
			if (((String) searchParamVO.getObj7()).equalsIgnoreCase("others")) {
				sb.append("order by cast(cm.code as decimal), x.id, cast(x.invNo as decimal), x.dtInv ");
			} else {
				sb.append("order by cast(cm.code as decimal), y.dtInv, y.id, field(y.transType, 'Pax Statement', 'PS-Payment', 'Sales Invoice', 'Payment', 'Credit Note', 'CN-Payment'), cast(y.invNo as decimal) ");
			}
			
			Query query = session.createSQLQuery(sb.toString());
			query.setTimeout(360);
			query.setParameter("frDate", (Date) searchParamVO.getObj2());
			query.setParameter("toDate", (Date) searchParamVO.getObj3());
			query.setParameter("idCompany", idCompany);
			query.setParameter("acctId", (Long) searchParamVO.getObj6());
			if (searchParamVO.getObj4() != null) {
				query.setParameter("idCustomer", (Long) searchParamVO.getObj4());
			}
//			query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			
			List<Object> results = query.list();
			for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				AcctViewVO vo = new AcctViewVO();
				vo.setDtInv((Date) row[0]);
				vo.setTransType((String) row[1]);
				vo.setInvoiceNo((String) row[2]);
				vo.setInvNo((String) row[3]);
				vo.setCustCd((String) row[4]);
				vo.setCustType((String) row[5]);
				vo.setCustName((String) row[6]);
				vo.setCompanyName((String) row[7]);
				vo.setPoNumber((String) row[8]);
				vo.setAmount(Double.parseDouble(row[9].toString()));
				vo.setPayment(Double.parseDouble(row[10].toString()));
				vo.setBalance(Double.parseDouble(row[11].toString()));
				vo.setBalanceDue(Double.parseDouble(row[12].toString()));
				
				vo.setInvCnNo((String) row[13]);
				vo.setPsNo((String) row[14]);
				
				acctViewList.add(vo);
			}
			
			session.getTransaction().commit();
			System.out.println("################# getDebtorLedgerList Speed: " + (System.currentTimeMillis() - start));
		
		} catch (Exception e) {
			e.printStackTrace();
			session.getTransaction().rollback();
			throw e;
			
		} finally {
			session.close();
		}
		
		return acctViewList;
	}
	
