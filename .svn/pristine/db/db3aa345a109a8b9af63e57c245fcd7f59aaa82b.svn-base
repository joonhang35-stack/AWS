			append("select b.id, b.id_supplier, bp.dt_pmnt as 'dt_bill', 'Payment' as trans_type, bp.code, bp.ref_no as ponumber, null as amount, bp.pmnt_amount as payment ").
			append("from ex_order_bill b, ex_order_bill_pmnt bp ").
