	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getBankBeginBal(java.lang.Long, java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@Override
	public double getBankBeginBal(Long idBank, Long idAcct, Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		Date beginDate = getFirtFinPeriod(idCompany, searchParamVO.getFromDate());
		System.out.println("CYY beginDate.toString(): " + beginDate.toString());
		AcctBalVO vo = getAcctBeginBalByDate(idAcct, beginDate); //(AcctBalVO) getAcctBeginBalVO(idAcct);
		
		/*StringBuilder sb = new StringBuilder();
		sb.append("SELECT (SUM(debit) - SUM(credit)) FROM cash_book c left join (").
			append("select b.id, ab.dt_begin_bal from account_bal ab, bank b where ab.id_acct = b.id_acct and b.id = :idBank and date(ab.dt_begin_bal) <= date(:toDate)").
			append(") n on n.id = c.id_bank  WHERE id_bank = :idBank AND (DATE(dt_trans) >= DATE(n.dt_begin_bal) AND DATE(dt_trans) < DATE(:toDate) AND status_cd = :statusCode");*/
		
		//Query query = createSQLQuery("SELECT (SUM(debit) - SUM(credit)) FROM account_trans WHERE id_acct = :idAcct AND dt_trans < :transDate AND status_cd = :statusCode");
		//Query query = createSQLQuery("SELECT (SUM(debit) - SUM(credit)) FROM cash_book WHERE id_bank = :idBank AND dt_trans < :transDate AND status_cd = :statusCode");
		Query query = createSQLQuery("SELECT (SUM(debit) - SUM(credit)) FROM cash_book WHERE id_bank = :idBank AND (DATE(dt_trans) >= DATE(:fromDate) AND DATE(dt_trans) < DATE(:toDate)) AND status_cd = :statusCode");
		//Query query = createSQLQuery(sb.toString());
		//query.setParameter("idAcct", idAcct);
		query.setParameter("idBank", idBank);
		//query.setParameter("transDate", searchParamVO.getFromDate());
		query.setParameter("fromDate", vo.getDtBeginBal());
		query.setParameter("toDate", searchParamVO.getFromDate());
		query.setParameter("statusCode", BaseConstant.STATUS_ACTIVE);
		Double beginBal = (Double) query.uniqueResult();
		return (beginBal != null) ? vo.getDebitBeginBal() - vo.getCreditBeginBal() + beginBal : vo.getDebitBeginBal() - vo.getCreditBeginBal();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getFirtFinPeriod(java.lang.Long, java.util.Date)
	 */
	@Override
	public Date getFirtFinPeriod(Long idCompany, Date fromDate) {
		Query query = createSQLQuery("SELECT MIN(dt_start), MAX(dt_end) FROM financial_period WHERE id_company = ?");
		query.setLong(0, idCompany);
		Object[] result = (Object[]) query.uniqueResult();
		Date minStart = (Date) result[0];
		Date maxEnd = (Date) result[1];
		Date beginDate = null;
		Calendar cal = Calendar.getInstance();
		cal.setTime(minStart);
		cal.set(Calendar.HOUR_OF_DAY, 0);
		cal.set(Calendar.MINUTE, 0);
		cal.set(Calendar.SECOND, 0);
		
		if (cal.get(Calendar.YEAR) == 2012) {
			cal.add(Calendar.YEAR, 1);
			minStart = cal.getTime();
		}
		
		/*if (fromDate.after(maxEnd)) {
			cal.setTime(fromDate);
			cal.set(Calendar.MONTH, minStart.getMonth());
			cal.set(Calendar.DATE, minStart.getDate());
			cal.set(Calendar.HOUR_OF_DAY, 0);
			cal.set(Calendar.MINUTE, 0);
			cal.set(Calendar.SECOND, 0);
			cal.add(Calendar.YEAR, -1);
			
		} else {
			cal.setTime(fromDate);
			cal.set(Calendar.MONTH, minStart.getMonth());
			cal.set(Calendar.DATE, minStart.getDate());
			cal.set(Calendar.HOUR_OF_DAY, 0);
			cal.set(Calendar.MINUTE, 0);
			cal.set(Calendar.SECOND, 0);
			
			if (fromDate.getMonth() < minStart.getMonth()) {
				cal.set(Calendar.MONTH, minStart.getMonth());
				cal.set(Calendar.DATE, minStart.getDate());
				cal.add(Calendar.YEAR, -1);
			}
		}*/
		beginDate = cal.getTime();
		return beginDate;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getAcctBeginBalByDate(java.lang.Long, java.util.Date)
	 */
	@Override
	public AcctBalVO getAcctBeginBalByDate(Long idAcct, Date beginDate) throws BusinessException {
		Criteria criteria = createCriteria(AcctBalVO.class);
		criteria.add(Restrictions.eq("idAcct", idAcct));
		criteria.add(Restrictions.ge("dtBeginBal", beginDate));
		criteria.addOrder(Order.asc("id"));
		criteria.setMaxResults(1);
		Object obj = criteria.uniqueResult();
		
		/*if (obj == null) {
			Calendar cal = Calendar.getInstance();
			cal.setTime(beginDate);
			cal.add(Calendar.YEAR, -1);
			return getAcctBeginBalByDate(idAcct, cal.getTime());
			
		}*/
		return (AcctBalVO) obj;
	}

	/* (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#updAcctTransDt(java.lang.String, java.lang.String, java.util.Date)
	 */
	@Override
	public void updAcctTransDt(String sysCd, String sysNo, Date transDt, Long companyId) throws BusinessException {
		try{
			runUpdateAcctTransDt(  sysCd,   sysNo,   transDt,   companyId);
		} catch (RuntimeException e) {
			  if (e instanceof LockAcquisitionException) {
				    try {
				        Thread.sleep(10000);
						runUpdateAcctTransDt(  sysCd,   sysNo,   transDt,   companyId);                 
				     } 
				    catch(Exception e2) {
				    	throw e;
				    }
			  }
		}
	}
	
	public void runUpdateAcctTransDt(String sysCd, String sysNo, Date transDt, Long companyId){
		Query query = createSQLQuery("UPDATE account_trans SET dt_trans = :transDt WHERE sys_cd = :sysCd AND sys_no = :sysNo AND status_cd = :statusCode AND id_company = :companyId");
		query.setDate("transDt", transDt);
		query.setString("sysCd", sysCd);
		query.setString("sysNo", sysNo);
		query.setString("statusCode", BaseConstant.STATUS_ACTIVE);
		query.setLong("companyId", companyId);
		query.executeUpdate();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#terminateAcctTrans(java.lang.String, java.lang.String, java.lang.String, java.lang.Long)
	 */
	@Override
	public void terminateAcctTrans(String sysCd, String sysNo, String statusCrDr, Long companyId) throws BusinessException {
		//try {
			StringBuilder sb = new StringBuilder();
			//sb.append("UPDATE AcctTransVO SET statusCode = :statusCode, updatedDate = NOW(), updatedBy = :updatedBy WHERE sysCode = :sysCode AND companyId = :idCompany AND sysNo = :sysNo AND statusCode = :oriStatusCode ");
			sb.append("UPDATE account_trans SET status_cd = :statusCode, dt_upd = NOW(), upd_by = :updatedBy WHERE sys_cd = :sysCode AND id_company = :idCompany AND sys_no = :sysNo AND status_cd = :oriStatusCode ");
			if (statusCrDr.equalsIgnoreCase("Debit")) sb.append("AND credit = 0 ");
			else if (statusCrDr.equalsIgnoreCase("Credit")) sb.append("AND debit = 0 ");
			else if (statusCrDr.equalsIgnoreCase("gnrl_deps")) sb.append("AND type_cd = 'gnrl_deps' ");
			else if (statusCrDr.equalsIgnoreCase("gnrl_pymt")) sb.append("AND type_cd = 'gnrl_pymt' ");
			
			// update account trans
			//Query query = createQuery(sb.toString());
			Query query = createSQLQuery(sb.toString());
			query.setString("statusCode", BaseConstant.STATUS_TERMINATED);
			query.setString("updatedBy", BaseContext.getUserFullName() == null ? BaseContext.getLoginId() : BaseContext.getUserFullName());
			query.setString("sysCode", sysCd);
			query.setLong("idCompany", companyId);
			query.setString("sysNo", sysNo);
			query.setString("oriStatusCode", BaseConstant.STATUS_ACTIVE);
			query.executeUpdate();
			
		/*} catch (RuntimeException e) {
			if (e instanceof LockAcquisitionException) {
				try {
					Thread.sleep(10000);
					terminateAcctTrans(sysCd, sysNo, statusCrDr, companyId);
					
				} catch (Exception e2) {
					throw e;
				}
			} else throw e;
		}*/
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getTrdgPftLssList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctViewVO> getTrdgPftLssList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		sb.append("select distinct a.id AS 'id', a.id_company AS 'idCompany', ").
			append("a.id_acct_cat AS 'idAcctCat', c.description AS 'acctCatDesc', c.code AS 'acctCatCode', a.id_acct_sub_cat AS 'idAcctSubCat', sc.description AS 'acctSubCatDesc', ").
			append("a.code AS 'code', a.sub_code AS 'subCode', a.description AS 'desc', a.sub_description AS 'subDesc', ").
			append("0 + round( ").
				//append("ifnull((select (b.debit_begin_bal - b.credit_begin_bal) from account_bal b where b.id_acct = a.id and date(b.dt_begin_bal) between date(:frDateYear) and date(:toDateYear) order by id limit 1),0) + ").
				append("ifnull((select case when (sum(t.debit) - sum(t.credit)) is null then 0 else (sum(t.debit) - sum(t.credit)) end from account_trans t where t.id_company = :idCompany and t.id_acct = a.id and status_cd = 'A' and t.dt_trans between date(:frDate) and date(:toDate)),0) ").
			append(",2) AS 'debitCurrBal', ").
			append("sc.description AS 'group', a.status_cd AS 'statusCode', a.dt_created AS 'createdDate', a.created_by AS 'createdBy' ").
		append("from account a, account_cat c, account_sub_cat sc ").
		append("where a.id_company = :idCompany and ").
		append("a.status_cd = :statusCd and ").
		append("a.id_acct_cat = c.id and ").
		append("a.id_acct_sub_cat = sc.id and ").
		append("c.code in ('I', 'X', 'P', 'OI') ").
		append("order by c.seq_no, a.id_acct_cat, ").
			// Sorting : EXPENSES - 9. ADMINISTRATION EXPENSES, 10. FINANCE COST, 8. MARKETING COST, 12. OTHER OPERATING EXPENSES, 64. DIVIDEND
			append("case when c.code = 'X' then FIELD(a.id_acct_sub_cat, 9, 10, 8, 12, 64) else a.id_acct_sub_cat end, ").
			append("code, subCode ");
		
		SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
		query.addScalar("id", LongType.INSTANCE);
		query.addScalar("idCompany", LongType.INSTANCE);
		query.addScalar("idAcctCat", LongType.INSTANCE);
		query.addScalar("acctCatDesc");
		query.addScalar("acctCatCode");
		query.addScalar("idAcctSubCat", LongType.INSTANCE);
		query.addScalar("acctSubCatDesc");
		query.addScalar("code");
		query.addScalar("subCode");
		query.addScalar("desc");
		query.addScalar("subDesc");
		query.addScalar("debitCurrBal");
		query.addScalar("group");
		query.addScalar("statusCode");
		query.addScalar("createdBy");
		query.addScalar("createdDate", DateType.INSTANCE);
		//query.setParameter("frDateYear", (Date) searchParamVO.getFromDate());
		//query.setParameter("toDateYear", (Date) searchParamVO.getToDate());
		query.setParameter("frDate", (Date) searchParamVO.getObj2()); // Alway start from selected year 1st day
		query.setParameter("toDate", (Date) searchParamVO.getObj3());
		query.setParameter("idCompany", idCompany);
		query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
		query.setResultTransformer(Transformers.aliasToBean(AcctViewVO.class));
		return query.list();
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getTrdgPftLssAdtList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
