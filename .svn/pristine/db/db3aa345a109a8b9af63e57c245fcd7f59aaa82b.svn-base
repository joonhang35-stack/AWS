		sb.append("select ").
			append("y.dtBill, y.transType, y.billNo, ").
			append("if(y.id_supplier is null, x.spplCd, y.spplCd) as 'spplCd', ").
			append("if(y.id_supplier is null, x.custName, y.custName) as 'custName', ").
			append("if(y.id_supplier is null, x.companyName, y.companyName) as 'companyName', y.ponumber as 'poNumber', ").
			append("if(y.id_supplier is null, 0.0, y.amount) as 'amount', ").
