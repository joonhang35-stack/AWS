	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getAcctCatList()
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctCatVO> getAcctCatList() {
		Criteria criteria = createCriteria(AcctCatVO.class);
		criteria.addOrder(Order.asc("id"));
		return criteria.list();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getAcctSubCatList(java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctSubCatVO> getAcctSubCatList(Long idAcctCat, Long idCompany) throws BusinessException {
		Criteria criteria = createCriteria(AcctSubCatVO.class);
		criteria.add(Restrictions.eq("idCompany", idCompany));
		criteria.add(Restrictions.eq("idAcctCat", idAcctCat));
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
		criteria.addOrder(Order.asc("id"));
		return criteria.list();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getAcctList(java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctVO> getAcctList(Long idCompany, Long idAcctCat) throws BusinessException {
		Criteria criteria = createCriteria(AcctVO.class);
		criteria.add(Restrictions.eq("idCompany", idCompany));
		if (idAcctCat != null) criteria.add(Restrictions.eq("idAcctCat", idAcctCat));
		//criteria.add(Restrictions.eq("subCode", ""));
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
		criteria.addOrder(Order.asc("code"));
		return criteria.list();
	}
	
	/*
	 * (non-Javadoc)
