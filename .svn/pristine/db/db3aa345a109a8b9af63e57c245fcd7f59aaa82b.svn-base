//		    System.out.println("Year is 2025 or later");
//		    // 2025 later will show pax statement only and with account 4xxx - sales
//			sb.append("select ").
//				append("a.code, a.sub_code as subCode, a.description as 'desc', a.sub_description as subDesc, i.dt_inv as dtInv, ").
//				append("case when i.doc_type_cd = 'I' then 'Sales Invoice' when i.doc_type_cd = 'P' then 'Pax Statement' else 'Credit Note' end as transType, ").
