				append("c.name as 'companyName', a.ponumber as 'poNumber', ifnull(a.amount, 0.0) as 'amount', ifnull(a.payment, 0.0) as 'payment', ").
				append("ifnull(d.balance, 0.0) as 'balance', ifnull(a.amount, 0.0) - ifnull(a.payment, 0.0) as 'balanceDue' ").
			append("from ( ").
				append("select b.id, b.id_supplier, b.dt_bill, 'Bill' as trans_type, b.code, '' as ponumber, b.bill_amt as amount, '' as payment ").
				append("from ex_order_bill b ").
				append("where b.id_company = :idCompany and b.status_cd not in ('CC', 'VD') ").
					append("and date(b.dt_bill) between date(:frDate) and date(:toDate) ");
				if (searchParamVO.getObj5() != null) {
					sb.append("and b.id_supplier = :idSupplier ");
				}
				sb.append("union all ").
				append("select b.id, b.id_supplier, bp.dt_pmnt as 'dt_bill', 'Payment' as trans_type, concat(bp.code, ' (', b.code, ')') as code, bp.ref_no as ponumber, '' as amount, bp.pmnt_amount as payment ").
				append("from ex_order_bill b, ex_order_bill_pmnt bp ").
				append("where b.id = bp.id_eo_bill and bp.status_cd = :statusCd and b.id_company = :idCompany and b.status_cd not in ('CC', 'VD') ").
					append("and date(bp.dt_pmnt) between date(:frDate) and date(:toDate) ");
				if (searchParamVO.getObj5() != null) {
					sb.append("and b.id_supplier = :idSupplier ");
				}
			sb.append(") a left join supplier s on s.id = a.id_supplier ").
			append("left join person p on p.id = s.id_person ").
			append("left join corporate c on c.id_person = p.id ").
			append("left join ( ").
				append("select a.id, a.id_supplier, ").
					append("sum(ifnull(a.amount, 0.0)) - sum(ifnull(a.payment, 0.0)) as 'balance' ").
				append("from ( ").
					append("select b.id, b.id_supplier, b.bill_amt as amount, null as payment ").
					append("from ex_order_bill b ").
					append("where b.id_company = :idCompany and b.status_cd not in ('CC', 'VD') ").
					append("and date(b.dt_bill) < date(:frDate) ");
				if (searchParamVO.getObj5() != null) {
					sb.append("and b.id_supplier = :idSupplier ");
				}
					sb.append("union all ").
					append("select b.id, b.id_supplier, null as amount, bp.pmnt_amount as payment ").
					append("from ex_order_bill b, ex_order_bill_pmnt bp ").
					append("where b.id = bp.id_eo_bill and bp.status_cd = :statusCd and b.id_company = :idCompany and b.status_cd not in ('CC', 'VD') ").
					append("and date(bp.dt_pmnt) < date(:frDate) ");
				if (searchParamVO.getObj5() != null) {
					sb.append("and b.id_supplier = :idSupplier ");
				}
				sb.append(") a ").
				append("group by a.id_supplier ").
			append(") d on a.id_supplier = d.id_supplier ");
			if (searchParamVO.getObj4() != null) {
			sb.append("where s.type_cd = :supplierType ");
			}
		sb.append(") y on x.id_supplier = y.id_supplier ").
		append("where (x.balanceDue = 0 and y.id_supplier is not null) or (x.balanceDue != 0 and y.id_supplier is not null) or (x.balanceDue != 0 and y.id_supplier is null) ");
		if (((String) searchParamVO.getObj7()).equalsIgnoreCase("others")) {
			sb.append("order by cast(x.id_supplier as decimal), x.id, x.transType, cast(x.billNo as decimal), y.dtBill ");
		} else {
			sb.append("order by cast(x.id_supplier as decimal), x.id, y.dtBill, x.transType, cast(x.billNo as decimal) ");
		}
		
		SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
		query.addScalar("dtBill", DateType.INSTANCE);
		query.addScalar("transType");
		query.addScalar("billNo");
		query.addScalar("spplCd");
		query.addScalar("custName");
		query.addScalar("companyName");
		query.addScalar("poNumber");
		query.addScalar("amount", DoubleType.INSTANCE);
		query.addScalar("payment", DoubleType.INSTANCE);
		query.addScalar("balance", DoubleType.INSTANCE);
		query.addScalar("balanceDue", DoubleType.INSTANCE);
		query.setParameter("frDate", (Date) searchParamVO.getObj2());
		query.setParameter("toDate", (Date) searchParamVO.getObj3());
		query.setParameter("idCompany", idCompany);
		if (searchParamVO.getObj4() != null) {
			query.setParameter("supplierType", (String) searchParamVO.getObj4());
		}
		if (searchParamVO.getObj5() != null) {
			query.setParameter("idSupplier", (Long) searchParamVO.getObj5());
		}
		query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
		query.setResultTransformer(Transformers.aliasToBean(AcctViewVO.class));
		return query.list();
	}
	
