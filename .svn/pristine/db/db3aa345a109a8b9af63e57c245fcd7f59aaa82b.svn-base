	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getAcctBal(java.lang.Long, java.util.Date)
	 */
	@Override
	public AcctBalVO getAcctBal(Long idAcct, Date date) throws BusinessException {
		Criteria criteria = createCriteria(AcctBalVO.class);
		criteria.add(Restrictions.eq("idAcct", idAcct));
		criteria.add(Restrictions.eq("dtBeginBal", date));
		criteria.setMaxResults(1);
		return (AcctBalVO) criteria.uniqueResult();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getAcctBalList(java.lang.Long, java.util.Date)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctBalVO> getAcctBalList(Long idAcct, Date date) throws BusinessException {
		Criteria criteria = createCriteria(AcctBalVO.class);
		criteria.add(Restrictions.eq("idAcct", idAcct));
		if (date != null) criteria.add(Restrictions.ge("dtBeginBal", date));
		else criteria.addOrder(Order.asc("id"));
		return criteria.list();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getTotAcctTransDC(int, java.lang.Long, java.lang.Long, java.util.Date, java.util.Date)
	 */
	@Override
	public double getTotAcctTransDC(int i, Long idCompany, Long idAcct, Date fromDate, Date toDate) throws BusinessException {
		Criteria criteria = createCriteria(AcctTransVO.class);
		if (i == 0) criteria.setProjection(Projections.sum("debit"));
		else criteria.setProjection(Projections.sum("credit"));
		criteria.add(Restrictions.eq("companyId", idCompany));
		criteria.add(Restrictions.eq("acctId", idAcct));
		criteria.add(Restrictions.between("transDt", fromDate, toDate));
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
		Double total = (Double) criteria.uniqueResult();
		
		return (total == null) ? 0 : total;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#isAcctUsed(java.lang.Class, java.lang.Long)
	 */
	@Override
	public boolean isAcctUsed(Class<?> class1, Long idAcct) throws BusinessException {
		Query query = createQuery("FROM " + class1.getName() + " WHERE id_acct = :idAcct");
		query.setParameter("idAcct", idAcct);
		query.setMaxResults(1);
		return (query.uniqueResult() == null) ? false : true;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#deleteAcctBal(com.bcs.zsg.acct.vo.AcctVO)
	 */
	@Override
	public void deleteAcctBal(AcctVO acctVO) throws BusinessException {
		Query query = createQuery("DELETE FROM AcctBalVO WHERE idAcct = :idAcct");
		query.setParameter("idAcct", acctVO.getId());
		query.executeUpdate();
	}

