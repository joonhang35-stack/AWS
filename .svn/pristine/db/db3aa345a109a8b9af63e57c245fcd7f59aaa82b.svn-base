//						
//						if (searchParamVO.getObj4() != null) {
//							sb.append("and iv.id_tour_dep = :idTourDep ");
//						}
//				sb.append(") i ").
//				append("left join (select p.type_cd, d.*  from tour_dep d left join tour_pkg p on d.id_tour_pkg = p.id) tdp on i.idTourDep = tdp.id, ").
//				append("customer cm, person ps, invoice_item ii left join account a on a.id = ii.id_acct and a.id_company = :idCompany ").
//			append("where i.id = ii.id_inv and ii.status_cd = :statusCd ").
//				append("and i.id_customer=cm.id and cm.id_pc=ps.id ").
//				append("and ifnull(tdp.code, '') not like 'ATK -%' ").
//				append("and ifnull(tdp.code, '') not like 'ATK-%' ").
//				append("and ifnull(a.code, '')  like '4%' ");
//		}
		
		if (searchParamVO.getObj6() != null) {
			sb.append("and ii.id_acct not in (" + searchParamVO.getObj6() + ") ");
		}
		if (searchParamVO.getObj7() != null) {
			if (((boolean)searchParamVO.getObj7()) == true) {
				sb.append("and a.id_acct_cat = 4 "); // Revenue/Sales Only
			}
		}
		//append("and tdp.type_cd != 'TICKETING' "); // Not Ticketing

		if (((String) searchParamVO.getObj5()) != null) {
			if (((String) searchParamVO.getObj5()).equals("I")) {
				sb.append("order by DATE_FORMAT(i.dt_inv,'%Y%m'), cast(a.code as decimal), cast(a.sub_code as decimal), i.dt_inv, i.doc_type_cd, cast(i.code as decimal) ");
			} else {
				sb.append("order by DATE_FORMAT(i.dtDep,'%Y%m'), cast(a.code as decimal), cast(a.sub_code as decimal), i.dtDep, i.doc_type_cd, cast(i.code as decimal) ");
			}
		}
		
		SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
		query.addScalar("code");
		query.addScalar("subCode");
		query.addScalar("desc");
		query.addScalar("subDesc");
		query.addScalar("dtInv", DateType.INSTANCE);
		query.addScalar("transType");
		query.addScalar("invoiceNo");
		query.addScalar("dtDep", DateType.INSTANCE);
		query.addScalar("tourCd");
		query.addScalar("custType");
		query.addScalar("custCd");
		query.addScalar("custName");
		query.addScalar("companyName");
		query.addScalar("invItemAmt", DoubleType.INSTANCE);
		query.addScalar("amount", DoubleType.INSTANCE);
		query.addScalar("psNo");
		query.addScalar("psDt", DateType.INSTANCE);
		//query.setParameter("frDate", (Date) searchParamVO.getObj2());
		query.setParameter("toDate", (Date) searchParamVO.getObj3());
		query.setParameter("idCompany", idCompany);
		query.setParameter("statusCdCC", CommonConstant.STATUS_CD_CANCELLED);
		query.setParameter("statusCdVD", CommonConstant.STATUS_CD_VOID);
		query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
		if (searchParamVO.getObj4() != null) query.setParameter("idTourDep", (Long) searchParamVO.getObj4());
		query.setResultTransformer(Transformers.aliasToBean(AcctViewVO.class));
		return query.list();
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getChartOfAccountList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctViewVO> getChartOfAccountList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();

		sb.append("select ").
			append("ac.description as acctCatDesc, ").
			append("sc.description as acctSubCatDesc, ").
			append("a.code as code, a.sub_code as subCode, a.description as 'desc', a.sub_description as subDesc ").
		append("from account a, account_cat ac, account_sub_cat sc ").
		append("where a.id_company = :idCompany ").
			append("and a.status_cd = :statusCd ").
			append("and a.id_acct_cat = ac.id and a.id_acct_sub_cat = sc.id ").
		append("order by cast(a.code as decimal), cast(a.sub_code as decimal) ");
		
		SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
		query.addScalar("acctCatDesc");
		query.addScalar("acctSubCatDesc");
		query.addScalar("code");
		query.addScalar("subCode");
		query.addScalar("desc");
		query.addScalar("subDesc");
		query.setParameter("idCompany", idCompany);
		query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
		query.setResultTransformer(Transformers.aliasToBean(AcctViewVO.class));
		return query.list();
	}
}
