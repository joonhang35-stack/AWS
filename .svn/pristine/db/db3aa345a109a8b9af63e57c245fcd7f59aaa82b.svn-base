	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getAcctBeginBalList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctBalVO> getAcctBeginBalList(Long idAcct, SearchParamVO searchParamVO) throws BusinessException {
		/*Criteria criteria = createCriteria(AcctBalVO.class);
		criteria.add(Restrictions.eq("idAcct", idAcct));
		criteria.add(Restrictions.or(Restrictions.eq("dtBeginBal", searchParamVO.getFromDate()), Restrictions.eq("dtBeginBal", searchParamVO.getToDate())));
		criteria.addOrder(Order.asc("id"));
		return criteria.list();*/
		
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT * FROM account_bal WHERE id_acct = :idAcct");
		if (searchParamVO.getFromDate() != null && searchParamVO.getToDate() != null) sb.append(" AND (dt_begin_bal BETWEEN :fromDate AND :toDate)");
		
		SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
		query.addEntity(AcctBalVO.class);
		query.setParameter("idAcct", idAcct);
		if (searchParamVO.getFromDate() != null && searchParamVO.getToDate() != null) {
			query.setParameter("fromDate", searchParamVO.getFromDate());
			query.setParameter("toDate", searchParamVO.getToDate());
		}
		return query.list();
	}
	
