	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctVO> getAcctListByAcctCat(Long idCompany, Long idAcctCat) throws BusinessException {
		Criteria criteria = createCriteria(AcctVO.class);
		criteria.add(Restrictions.eq("idCompany", idCompany));
		if (idAcctCat != null) criteria.add(Restrictions.eq("idAcctCat", idAcctCat));
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
		criteria.addOrder(Order.asc("code"));
		return criteria.list();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getAcctViewList(java.lang.Long, java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctViewVO> getAcctViewList(Long idCompany, Long idAcctCat, String flag, SearchParamVO searchParamVO) throws BusinessException {
		
		// For Invoice and Credit Note
		if (idAcctCat == null && flag == null) {
			/*Criteria criteria = createCriteria(AcctViewVO.class);
			criteria.add(Restrictions.eq("idCompany", idCompany));
			//if (idAcctCat != null) criteria.add(Restrictions.eq("acctCatVO.id", idAcctCat));
			criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
			criteria.addOrder(Order.asc("code"));
			criteria.addOrder(Order.asc("subCode"));
			return criteria.list();*/
			
			StringBuilder sb = new StringBuilder();
			sb.append("SELECT a.id, a.id_company, a.id_acct_cat, a.id_acct_sub_cat, ");
			sb.append("a.code, a.sub_code, a.description, a.sub_description, ");
			sb.append("a.remarks, a.type_cd, a.status_cd, a.tax_code, b.rate, a.id_parent_acct, a.is_pre_sales ");
			sb.append("FROM account a ")
				.append("LEFT JOIN (SELECT code AS 'code1', rate FROM tax_code) b ON a.tax_code = b.code1 ")
				.append("WHERE id_company=").append(idCompany).append(" ")
				.append("AND status_cd = '").append(BaseConstant.STATUS_ACTIVE).append("' ")
				.append("ORDER BY a.code, a.sub_code ");
			
			Query query = createSQLQuery(sb.toString());
			List<Object> results = query.list();
			List<AcctViewVO> acctViewList = new ArrayList<AcctViewVO>();

			for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				AcctViewVO vo = new AcctViewVO();
				vo.setId(((BigInteger) row[0]).longValue());
				vo.setIdCompany(((BigInteger) row[1]).longValue());
				vo.setIdAcctCat(((BigInteger) row[2]).longValue());
				vo.setIdAcctSubCat(((BigInteger) row[3]).longValue());
				vo.setCode((String) row[4]);
				vo.setSubCode((String) row[5]);
				vo.setDesc((String) row[6]);
				vo.setSubDesc((String) row[7]);
				vo.setRemarks((String) row[8]);
				vo.setTypeCode(String.valueOf(row[9]));
				vo.setStatusCode((String) row[10]);
				vo.setTaxCode((String) row[11]);
				vo.setTaxRate((Float) row[12]);
				if (row[13] != null)	vo.setIdParentAcct(((BigInteger) row[13]).longValue());
				vo.setIsPreSales((Boolean) row[14]);
				acctViewList.add(vo);
			}
			return acctViewList;
		
		} else { // For Chart of Account
			StringBuilder sb = new StringBuilder();
			
			// Main Display Account search by category id
			if (flag == null) {
				/*sb.append("select distinct a.id AS 'id', a.id_company AS 'idCompany', a.id_acct_cat AS 'idAcctCat', a.id_acct_sub_cat AS 'idAcctSubCat', ").
				append("a.code AS 'code', a.sub_code AS 'subCode', a.description AS 'desc', a.sub_description AS 'subDesc', a.tax_code AS 'taxCode', ").
				append("(").
					append("ifnull((select (ifnull(b.debit_begin_bal,0) - ifnull(b.credit_begin_bal,0)) from account_bal b where b.id_acct = a.id order by id desc limit 1), 0) + ").
					append("ifnull(t.acctTransTtl, 0) ").
				append(") AS 'debitCurrBal', ").
				append("sc.description AS 'group', a.status_cd AS 'statusCode', a.dt_created AS 'createdDate', a.created_by AS 'createdBy' ").
				append("from account a ").
				append("left join account_sub_cat sc on a.id_acct_sub_cat = sc.id ").
				append("left join ( ").
					append("select x.id_company, x.id_acct, ").
					append("case when (sum(debit) - sum(credit)) is null then 0 else (sum(debit) - sum(credit)) end as 'acctTransTtl' ").
					append("from account_trans x left join (").
						append("select * from (select id_acct, dt_begin_bal from account_bal order by id desc) nn group by id_acct").
					append(") n on n.id_acct = x.id_acct where status_cd = 'A' and date(dt_trans) between date(n.dt_begin_bal) and date(:toDateYear) ").
					append("group by id_company, id_acct ").
					append(") t on a.id_company = t.id_company and a.id = t.id_acct ").
				append("where a.id_company = :idCompany and a.status_cd = :statusCd ");*/
				
				sb.append("select distinct a.id AS 'id', a.id_company AS 'idCompany', a.id_acct_cat AS 'idAcctCat', a.id_acct_sub_cat AS 'idAcctSubCat', ").
				append("a.code AS 'code', a.sub_code AS 'subCode', a.description AS 'desc', a.sub_description AS 'subDesc', a.tax_code AS 'taxCode', a.type_cd as 'typeCode', ").
				append("(").
					append("ifnull((select (ifnull(b.debit_begin_bal,0) - ifnull(b.credit_begin_bal,0)) from account_bal b where b.id_acct = a.id and date(dt_begin_bal) = date(:frDateYear)), 0) + ").
					append("ifnull(t.acctTransTtl, 0) ").
				append(") AS 'debitCurrBal', ").
				append("sc.description AS 'group', a.status_cd AS 'statusCode', a.dt_created AS 'createdDate', a.created_by AS 'createdBy', a.id_parent_acct as 'idParentAcct', a.is_pre_sales as 'isPreSales' ").
				append("from account a ").
				append("left join account_sub_cat sc on a.id_acct_sub_cat = sc.id ").
				append("left join ( ").
					append("select id_acct, ").
					append("case when (sum(debit) - sum(credit)) is null then 0 else (sum(debit) - sum(credit)) end as 'acctTransTtl' ").
					append("from account_trans where id_company = :idCompany and status_cd = :statusCd and date(dt_trans) between date(:frDateYear) and date(:toDateYear) ").
					append("group by id_acct ").
					append(") t on a.id = t.id_acct ").
				append("where a.id_company = :idCompany and a.status_cd = :statusCd ");
				
				if(searchParamVO.getObj1() == null)
					sb.append(" AND a.id_acct_cat = :idAcctCat ");
				
				sb.append("order by code, subCode");
			} else { // Popup Beginning Balance
				sb.append("select * from (select a.id AS 'id', a.id_company AS 'idCompany', a.id_acct_cat AS 'idAcctCat', a.id_acct_sub_cat AS 'idAcctSubCat', ").
					append("a.code AS 'code', a.sub_code AS 'subCode', a.description AS 'desc', a.sub_description AS 'subDesc', a.tax_code AS 'taxCode', a.type_cd as 'typeCode', ").
					append("ifnull(b.debit_begin_bal, 0) AS 'debitBeginBal', ifnull(b.credit_begin_bal, 0) AS 'creditBeginBal', ").
					append("sc.description AS 'group', a.status_cd AS 'statusCode', a.dt_created AS 'createdDate', a.created_by AS 'createdBy' ").
					append("from account a ").
					append("left join account_sub_cat sc on a.id_acct_sub_cat = sc.id ").
					append("left join account_bal b on b.id_acct = a.id and date(b.dt_begin_bal) between date(:frDateYear) and date(:toDateYear) ").
					append("where a.id_company = :idCompany and a.status_cd = :statusCd ").
					append("order by b.id_acct, b.id) ss group by id order by code, subCode");
			}
			
			SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
			query.addScalar("id", LongType.INSTANCE);
			query.addScalar("idCompany", LongType.INSTANCE);
			query.addScalar("idAcctCat", LongType.INSTANCE);
			query.addScalar("idAcctSubCat", LongType.INSTANCE);
			query.addScalar("idParentAcct", LongType.INSTANCE);
			query.addScalar("code");
			query.addScalar("subCode");
			query.addScalar("desc");
			query.addScalar("subDesc");
			query.addScalar("taxCode");
			query.addScalar("typeCode", StringType.INSTANCE);
			query.addScalar("isPreSales", BooleanType.INSTANCE);
			if (flag == null) {
				query.addScalar("debitCurrBal");
				//query.addScalar("creditCurrBal");
			} else {
				query.addScalar("debitBeginBal");
				query.addScalar("creditBeginBal");
			}
			query.addScalar("group");
			query.addScalar("statusCode");
			query.addScalar("createdBy");
			query.addScalar("createdDate", DateType.INSTANCE);
			
			query.setParameter("idCompany", idCompany);
			query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			query.setParameter("frDateYear", (Date) searchParamVO.getFromDate());
			query.setParameter("toDateYear", (Date) searchParamVO.getToDate());
			if (flag == null && searchParamVO.getObj1() == null)
				query.setParameter("idAcctCat", idAcctCat);
			query.setResultTransformer(Transformers.aliasToBean(AcctViewVO.class));
			return query.list();
		}
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getAcctTotalBeginBal(java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public AcctBalViewVO getAcctTotalBeginBal(Long idCompany) throws BusinessException {
		Criteria criteria = createCriteria(AcctBalVO.class);
		criteria.add(Restrictions.eq("idCompany", idCompany));
		criteria.setProjection(Projections.sum("debitBeginBal"));
		criteria.setProjection(Projections.sum("creditBeginBal"));
		List<Object> result = criteria.list();
		
		AcctBalViewVO vo = new AcctBalViewVO();
		if (CollectionUtils.isNotEmpty(result)) {
			for (Iterator<Object> it = result.iterator() ; it.hasNext() ;) {
				Object[] obj = (Object[]) it.next();
				vo.setTotalBeginDebit((Double) obj[0]);
				vo.setTotalBeginCredit((Double) obj[1]);
			}
		} else {
			vo.setTotalBeginDebit(0.0);
			vo.setTotalBeginCredit(0.0);
		}
		return vo;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#isAcctCatValid(com.bcs.zsg.acct.vo.AccountCatVO)
	 */
	@Override
	public boolean isAcctCatValid(AcctCatVO acctCatVO) throws BusinessException {
		Criteria criteria = createCriteria(AcctCatVO.class);
		criteria.add(Restrictions.eq("code", acctCatVO.getCode()));
		return (criteria.uniqueResult() != null) ? false : true;
	}

