		criteria.add(Restrictions.eq("idAcctCat", acctSubCatVO.getIdAcctCat()));
		criteria.add(Restrictions.eq("code", acctSubCatVO.getCode()));
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
