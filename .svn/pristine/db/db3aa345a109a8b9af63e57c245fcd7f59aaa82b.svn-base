	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#isAcctSubCatInUsed(com.bcs.zsg.acct.vo.AcctSubCatVO)
	 */
	@Override
	public boolean isAcctSubCatInUsed(AcctSubCatVO acctSubCatVO) throws BusinessException {
		Criteria criteria = createCriteria(AcctVO.class);
		criteria.add(Restrictions.eq("idAcctSubCat", acctSubCatVO.getId()));
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
		criteria.setMaxResults(1);
		return (criteria.list() != null && criteria.list().size() > 0) ? true : false;
	}
	
