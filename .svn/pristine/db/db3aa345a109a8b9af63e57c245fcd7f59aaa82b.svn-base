	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getJournalList(java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<JournalVO> getJournalList(Long idCompany) throws BusinessException {
		StringBuilder sb = new StringBuilder();

		sb.append("SELECT jour.id, jour.id_company, jour.dt_journal, jour.sys_no, jour.total_amt, ")
		.append("jour.reason, jour.reference, jour.dt_created, jour.created_by, jour.dt_upd, jour.upd_by ")
		.append(" FROM journal jour ")
		.append(" WHERE jour.id_company = ").append(idCompany)
		.append(" ORDER BY jour.id");

		Query query = createSQLQuery(sb.toString());

		List<Object> queryResultList = query.list();
		List<JournalVO> returnResultList = new ArrayList<JournalVO>();

		for (Iterator<Object> it = queryResultList.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			JournalVO vo = new JournalVO();
			if (row[0] != null) vo.setId(((BigInteger) row[0]).longValue());
			if (row[1] != null) vo.setCompanyId(((BigInteger)row[1]).longValue());
			if (row[2] != null) vo.setJournalDt((Date) row[2]);
			if (row[3] != null) vo.setSysNo((String) row[3]);
			if (row[4] != null) vo.setTotalAmt(Double.parseDouble(row[4].toString()));
			if (row[5] != null) vo.setReason((String) row[5]);
			if (row[6] != null) vo.setReference((String) row[6]);
			if (row[7] != null) vo.setCreatedDate((Date) row[7]);
			if (row[8] != null) vo.setCreatedBy((String) row[8]);
			if (row[9] != null) vo.setUpdatedDate((Date) row[9]);
			if (row[10] != null) vo.setUpdatedBy((String) row[10]);

			returnResultList.add(vo);
		}

		return returnResultList;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getJournalEntryList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<JournalVO> getJournalEntryList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();

		sb.append("select j.dt_journal as 'journalDt', j.sys_no as 'sysNo', j.total_amt as 'totalAmt', ").
			append("j.reason as 'reason', j.reference as 'reference', a.* ").
		append("from journal j left join ( ").
			append("select trans.id, trans.sys_no, acct.code as 'code', acct.sub_code as 'subCode', ").
			append("acct.description as 'desc', acct.sub_description as 'subDesc', ").
			append("case when trans.debit != 0 then trans.debit + trans.tax_amount else trans.debit end as 'debit', ").
			append("case when trans.credit != 0 then trans.credit + trans.tax_amount else trans.credit end as 'credit', ").
			append("trans.tax_code as taxCode, trans.tax_rate as taxRate, trans.tax_amount as taxAmount, ").
			append("case when trans.debit != 0 then trans.debit else trans.credit end as amount ").
			append("from account_trans trans, account acct ").
			append("where trans.id_company = :idCompany and trans.status_cd = :statusCd and trans.sys_cd = 'jrnl' and trans.id_acct = acct.id ").
			append("and ifnull(trans.ref_no, '') != '' ").
		append(") a on j.sys_no = a.sys_no ").
		append("where j.id_company = :idCompany ").
		append("and date(j.dt_journal) between date(:frDate) and date(:toDate) ");
		
		if (searchParamVO.getObj4() != null) {
			sb.append("and j.sys_no = :journalNo ");
		}
		sb.append("order by cast(j.sys_no as decimal), a.id, cast(a.code as decimal), cast(a.subCode as decimal) ");
		
		SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
		query.addScalar("journalDt", DateType.INSTANCE);
		query.addScalar("sysNo");
		query.addScalar("totalAmt");
		query.addScalar("reason");
		query.addScalar("reference");
		query.addScalar("code");
		query.addScalar("subCode");
		query.addScalar("desc");
		query.addScalar("subDesc");
		query.addScalar("taxCode");
		query.addScalar("taxRate", FloatType.INSTANCE);
		query.addScalar("taxAmount", DoubleType.INSTANCE);
		query.addScalar("amount", DoubleType.INSTANCE);
		query.addScalar("debit", DoubleType.INSTANCE);
		query.addScalar("credit", DoubleType.INSTANCE);
		query.setParameter("frDate", (Date) searchParamVO.getObj2());
		query.setParameter("toDate", (Date) searchParamVO.getObj3());
		query.setParameter("idCompany", idCompany);
		if (searchParamVO.getObj4() != null) {
			query.setParameter("journalNo", (String) searchParamVO.getObj4());
		}
		query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
		query.setResultTransformer(Transformers.aliasToBean(JournalVO.class));
		return query.list();
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getSalesInAdvanceList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctViewVO> getSalesInAdvanceList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		Calendar cal = Calendar.getInstance();
		cal.setTime((Date) searchParamVO.getObj3());
		int year = cal.get(Calendar.YEAR);

//		if (year < 2025) {
//		    System.out.println("Year is before 2025");
		    sb.append("select ").
				append("a.code, a.sub_code as subCode, a.description as 'desc', a.sub_description as subDesc, i.dt_inv as dtInv, ").
				append("case when i.doc_type_cd = 'I' then 'Sales Invoice' when i.doc_type_cd = 'P' then 'Pax Statement' else 'Credit Note' end as transType, ").
				append("i.code as invoiceNo, ").
				append("i.dtDep, ").
				append("tdp.code as tourCd, ").
				append("cm.pc_type_cd as custType, cm.code as custCd, concat(UPPER(ps.salutation_cd), ' ', ps.last_name, ' ', ps.first_name) as custName, cm.corporate_name as companyName, ").
				append("case ").
					append("when i.doc_type_cd = 'I' or i.doc_type_cd = 'P' or (ii.amount + ii.tax_amount) = 0.00 then (ii.amount + ii.tax_amount) ").
					append("else -1 * (ii.amount + ii.tax_amount) ").
				append("end as invItemAmt, ").
				append("case ").
					append("when i.doc_type_cd = 'I' or i.doc_type_cd = 'P' or i.amount = 0.00 then i.amount ").
					append("else -1 * i.amount ").
				append("end as amount, ").
				append("psNo, psDt ").
			append("from ").
				append("( ").
					append("select iv.*, ").
					append("case ").
						append("when iv.doc_type_cd = 'I' or iv.doc_type_cd = 'P' then iv.id_tour_dep ").
						append("else if(cn.id_tour_dep is not null, cn.id_tour_dep, cnps.id_tour_dep) ").
					append("end as idTourDep, ").
					append("case ").
						append("when iv.doc_type_cd = 'I' or iv.doc_type_cd = 'P' then iv.dt_departure ").
						append("else if(cn.id_tour_dep is not null, cn.cnDepDt, cnps.psDepDt) ").
					append("end as dtDep, ").
					append("ivps.ps_no as psNo, ivps.dt_inv as psDt ").
					append("from invoice iv ").
						append("left join (select iv.code as inv_no, iv.id_tour_dep, iv.dt_departure as cnDepDt from invoice iv where iv.id_company = :idCompany and iv.doc_type_cd = 'I') cn on iv.cn_inv_no = cn.inv_no ").
						append("left join (select ps.code as ps_no, ps.id_tour_dep, ps.dt_departure as psDepDt from invoice ps where ps.id_company = :idCompany and ps.doc_type_cd = 'P') cnps on iv.cn_ps_no = cnps.ps_no ").
						append("left join (select ps_no, dt_inv from invoice where id_company = :idCompany and doc_type_cd = 'P') ivps on iv.ps_no is not null and iv.ps_no = ivps.ps_no ").
					append("where ").
						append("iv.id_company = :idCompany and case when (iv.doc_type_cd = 'I' or iv.doc_type_cd = 'P') then iv.status_cd != :statusCdVD else iv.status_cd != :statusCdCC and iv.status_cd != :statusCdVD end ").
						append("and date(iv.dt_inv) <= date(:toDate) ").
						append("and (case ").
							append("when iv.doc_type_cd = 'I' or iv.doc_type_cd = 'P' then iv.dt_departure ").
							append("else if(cn.id_tour_dep is not null, cn.cnDepDt, cnps.psDepDt) ").
						append("end) > date(:toDate) ").
						append("and (iv.doc_type_cd = 'I' or iv.doc_type_cd = 'C' or (iv.doc_type_cd = 'P' and ifnull(iv.doc_type_status, '') in ('OP', 'RW'))) ");
						if (searchParamVO.getObj4() != null) {
							sb.append("and iv.id_tour_dep = :idTourDep ");
						}
				sb.append(") i ").
				append("left join (select p.type_cd, d.*  from tour_dep d left join tour_pkg p on d.id_tour_pkg = p.id) tdp on i.idTourDep = tdp.id, ").
				append("customer cm, person ps, invoice_item ii left join account a on a.id = ii.id_acct and a.id_company = :idCompany ").
			append("where i.id = ii.id_inv and ii.status_cd = :statusCd ").
				append("and i.id_customer=cm.id and cm.id_pc=ps.id ").
//				append("and ifnull(tdp.code, '') not like 'ATK -%' ").
//				append("and ifnull(tdp.code, '') not like 'ATK-%' ").
				append("and ifnull(a.code, '')  like '4%' ");
