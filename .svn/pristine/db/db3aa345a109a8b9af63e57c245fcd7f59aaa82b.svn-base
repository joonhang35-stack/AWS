						append("where i.id_company = :idCompany ").
							append("and case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.status_cd != 'VD' else i.status_cd != 'CC' and i.status_cd != 'VD' end ").
							append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('OP', 'RW'))) ").
							append("and if(cb.dt_trans is not null, cb.dt_trans, ip.dt_pmnt) < date(:frDate) ").
							append("and i.id_acct = :acctId ");
						if (searchParamVO.getObj4() != null) {
							sb.append("and i.id_customer = :idCustomer ");
						}
						sb.append("union all ").
						append("select i.id, i.id_customer, 0 as amount, j.total_amt as payment ").
						append("from journal j, invoice i ").
						append("where j.id_inv = i.id and j.id_company = :idCompany and j.type_cd = 'sales' ").
						append("and date(j.dt_journal) < date(:frDate) ");
						if (searchParamVO.getObj4() != null) {
							sb.append("and i.id_customer = :idCustomer ");
						}
					sb.append(") a ").
					append("group by a.id_customer ").
				append(") b on a.id_customer = b.id_customer ").
			append(") y on x.id_customer = y.id_customer ").
			append("left join customer cm on if(y.id_customer is null, x.id_customer, y.id_customer)=cm.id ").
			append("left join person ps on cm.id_pc=ps.id ").
			append("where ((CAST(x.balanceDue AS DECIMAL(10,2)) = 0.00 and y.id_customer is not null) or (CAST(x.balanceDue AS DECIMAL(10,2)) != 0.00 and y.id_customer is not null) or (CAST(x.balanceDue AS DECIMAL(10,2)) != 0.00 and y.id_customer is null)) ");
			
			if (((String) searchParamVO.getObj7()).equalsIgnoreCase("others")) {
				sb.append("order by cast(cm.code as decimal), x.id, cast(x.invNo as decimal), x.dtInv ");
			} else {
				sb.append("order by cast(cm.code as decimal), y.dtInv, y.id, field(y.transType, 'Pax Statement', 'PS-Payment', 'Sales Invoice', 'Payment', 'Credit Note', 'CN-Payment', 'Journal'), cast(y.invNo as decimal) ");
			}
			
			Query query = session.createSQLQuery(sb.toString());
			query.setTimeout(360);
			query.setParameter("frDate", (Date) searchParamVO.getObj2());
			query.setParameter("toDate", (Date) searchParamVO.getObj3());
			query.setParameter("idCompany", idCompany);
			query.setParameter("acctId", (Long) searchParamVO.getObj6());
			if (searchParamVO.getObj4() != null) {
				query.setParameter("idCustomer", (Long) searchParamVO.getObj4());
			}
//			query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			
			List<Object> results = query.list();
			for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				AcctViewVO vo = new AcctViewVO();
				vo.setDtInv((Date) row[0]);
				vo.setTransType((String) row[1]);
				vo.setInvoiceNo((String) row[2]);
				vo.setInvNo((String) row[3]);
				vo.setCustCd((String) row[4]);
				vo.setCustType((String) row[5]);
				vo.setCustName((String) row[6]);
				vo.setCompanyName((String) row[7]);
				vo.setPoNumber((String) row[8]);
				vo.setAmount(Double.parseDouble(row[9].toString()));
				vo.setPayment(Double.parseDouble(row[10].toString()));
				vo.setBalance(Double.parseDouble(row[11].toString()));
				vo.setBalanceDue(Double.parseDouble(row[12].toString()));
				
				vo.setInvCnNo((String) row[13]);
				vo.setPsNo((String) row[14]);
				
				acctViewList.add(vo);
			}
			
			session.getTransaction().commit();
			System.out.println("################# getDebtorLedgerList2 Speed: " + (System.currentTimeMillis() - start));
		
		} catch (Exception e) {
			e.printStackTrace();
			session.getTransaction().rollback();
			throw e;
			
		} finally {
			session.close();
		}
		
		return acctViewList;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getDebtorSummaryList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctViewVO> getDebtorSummaryList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		sb.append("select ").
			append("a.cust_cd as 'custCd', a.pc_type_cd as 'custType', a.cust_name as 'custName', a.company_name as 'companyName', ").
			append("0.0 as 'balance', ").
			append("sum(ifnull(a.amount, 0.0)) - sum(ifnull(a.payment, 0.0)) as 'balanceDue' ").
		append("from ( ").
			append("select i.code as 'invoiceNo', i.id, i.id_customer, cm.pc_type_cd, i.dt_inv as dt_inv, ").
				append("case when i.doc_type_cd = 'I' then 'Sales Invoice' when i.doc_type_cd = 'P' then 'Pax Statement' else 'Credit Note' end as trans_type, i.code, ").
				append("cm.code as cust_cd, concat(UPPER(ps.salutation_cd), ' ', ps.last_name, ' ', ps.first_name) as cust_name, cm.corporate_name as company_name, '' as ponumber, ").
				append("case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.amount else null end as amount, ").
				append("case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then null else i.amount end as payment ").
			append("from invoice i, customer cm, person ps where i.id_company = :idCompany and i.id_customer=cm.id and cm.id_pc=ps.id ").
			append("and case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.status_cd != 'VD' else i.status_cd != 'CC' and i.status_cd != 'VD' end ").
			append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('OP', 'RW'))) ").
				append("and date(i.dt_inv) <= date(:toDate) and i.id_acct = :acctId ");
			if (searchParamVO.getObj4() != null) {
				sb.append("and i.id_customer = :idCustomer ");
			}
				sb.append("union all ").
			append("select i.code as 'invoiceNo', i.id, i.id_customer, cm.pc_type_cd, ").
				append("IF(cb.dt_trans IS NOT NULL, cb.dt_trans, ip.dt_pmnt) as dt_inv, ").
				append("case when i.doc_type_cd = 'I' then 'Payment' when i.doc_type_cd = 'P' then 'PS-Payment' else 'CN-Payment' end as trans_type, ip.code, ").
				append("cm.code as cust_cd, concat(UPPER(ps.salutation_cd), ' ', ps.last_name, ' ', ps.first_name) as cust_name, cm.corporate_name as company_name, ip.ref_no as ponumber, ").
				append("case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then null else ip.amount end as amount, ").
				append("case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then ip.amount else null end as payment ").
			append("from invoice i ").
			append("INNER JOIN invoice_pmnt ip ON i.id = ip.id_inv AND ip.status_cd = 'A' ").
			append("LEFT JOIN invoice_pmnt parent ON ip.id_parent_pmnt IS NOT NULL AND ip.id_parent_pmnt = parent.id ").
			append("LEFT JOIN inv_pmnt_cashbook_link link on link.status_cd = 'A' and ").
			append("(CASE WHEN parent.id_parent_pmnt IS NOT NULL THEN parent.id_parent_pmnt WHEN ip.id_parent_pmnt IS NOT NULL THEN ip.id_parent_pmnt ELSE ip.id END) = link.id_inv_pmnt ").
			append("LEFT JOIN cash_book cb ON cb.status_cd = 'A' AND link.id_cash_book = cb.id, ").
//			append("LEFT JOIN (SELECT ps_no, dt_inv FROM invoice WHERE id_company = 1 AND doc_type_cd = 'P') ivps on i.ps_no is not null and i.ps_no = ivps.ps_no, ").
				append("customer cm, person ps ").
			append("where i.id_company = :idCompany and i.id_customer=cm.id and cm.id_pc=ps.id ").
				append("and case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.status_cd != 'VD' else i.status_cd != 'CC' and i.status_cd != 'VD' end ").
				append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('OP', 'RW'))) ").
				append("and if(cb.dt_trans is not null, cb.dt_trans, ip.dt_pmnt) <= date(:toDate) ").
				append("and i.id_acct = :acctId ");
			if (searchParamVO.getObj4() != null) {
				sb.append("and i.id_customer = :idCustomer ");
			}
		sb.append(") a ").
		append("group by a.id_customer having CAST(balanceDue AS DECIMAL(10,2)) != 0 ");
		
		SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
		query.addScalar("custCd");
		query.addScalar("custType");
		query.addScalar("custName");
		query.addScalar("companyName");
		query.addScalar("balance", DoubleType.INSTANCE);
		query.addScalar("balanceDue", DoubleType.INSTANCE);
		//query.setParameter("frDate", (Date) searchParamVO.getObj2());
		query.setParameter("toDate", (Date) searchParamVO.getObj3());
		query.setParameter("idCompany", idCompany);
		query.setParameter("acctId", (Long) searchParamVO.getObj6());
		if (searchParamVO.getObj4() != null) {
			query.setParameter("idCustomer", (Long) searchParamVO.getObj4());
		}
//		query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);	
		query.setResultTransformer(Transformers.aliasToBean(AcctViewVO.class));
		return query.list();
	}
	
