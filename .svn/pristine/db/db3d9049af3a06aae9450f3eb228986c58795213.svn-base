	public void addPersonalSuppl(ActionEvent e) {
		addPersonalSuppl();
	}
	
	/**
	 * Add Personal Supplier
	 */
	public void addPersonalSuppl() {
		try {
//			checkLocalSupplierIdentity();
			
			for(SupplierVO supp : supplierList){
				if(StringUtils.equals(supplierVO.getCompanyName(), supp.getFullName())) throw new BusinessException(CommonErrConstant.ERR_SUPP_NAME_DUP);
			}
			
			SystemNumberGenerationVO vo = new SystemNumberGenerationVO();
			vo.setCode(CommonConstant.SYS_NUM_CD_SUPL);
			vo.setIdCompany(getSessionInfoBean().getCompanyVO().getId());
			vo = SysNumGenUtil.getSysNumber(SysNumGenUtil.getIdx(vo));
			// set supplier type
			for (AcctVO acctVO : liabilityList) {
				if (acctVO.getId().equals(supplierVO.getAccountId())) {
					//supplierVO.setSupplierType(acctVO.getDesc());
					if (acctVO.getDesc().startsWith("T")) supplierVO.setSupplierType(CommonConstant.DEF_ACCT_TYPE_TC);
					else supplierVO.setSupplierType(CommonConstant.DEF_ACCT_TYPE_SC);
					break;
				}
			}
			
			if (supplierVO.getCode().equals("P")) {
				payeeSupplierVO = insertPersonal(vo);
			} else if (supplierVO.getCode().equals("C")) {
				payeeSupplierVO = insertCompany(vo);
			}
			
			resetForm();
			init(2);
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Update Personal and Company Supplier
	 */
	public void updatePersonalSuppl() {
		try {
//			checkLocalSupplierIdentity();
			
			for (SupplierVO supp : supplierList) {
				if(!supplierVO.getId().equals(supp.getId()) && StringUtils.equals(supplierVO.getFullName(), supp.getFullName()))
					throw new BusinessException(CommonErrConstant.ERR_SUPP_NAME_DUP);
			}
			// set supplier type
			for (AcctVO acctVO : liabilityList) {
				if (acctVO.getId().equals(supplierVO.getAccountId())) {
					//supplierVO.setSupplierType(acctVO.getDesc());
					if (acctVO.getDesc().startsWith("T")) supplierVO.setSupplierType(CommonConstant.DEF_ACCT_TYPE_TC);
					else supplierVO.setSupplierType(CommonConstant.DEF_ACCT_TYPE_SC);
					break;
				}
			}
			
			updatePersonal(); 
			resetForm(); 
			init(2); 
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Delete Personal and Company Supplier
	 */
	public void deleteSuppl() {
		try {
			trackingLogUtils.startLogs();
			
			if( billPymtBO.getSupplierInBills(supplierVO.getId()) == 0) {
				delSuppl();
				init(2);
				successResult();
				
			} else {
				FacesMessage msg  = new FacesMessage(FacesMessage.SEVERITY_ERROR, "Delete supplier failed due to supplier is in used in bill payment", "");
				if (msg != null) FacesContext.getCurrentInstance().addMessage(null, msg);
		        RequestContext.getCurrentInstance().addCallbackParam("validateAccountCodeError", true);
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("deleteSuppl");
		}
	}
	
	private void checkLocalSupplierIdentity() throws BusinessException {
		if (supplierVO.getCorAddressVO() != null && supplierVO.getCorAddressVO().getCountryId() != null) {
			if (!supplierVO.getCorAddressVO().getCountryId().equals(CommonConstant.DEF_COUNTRY_ID) &&
					StringUtils.isEmpty(supplierVO.getPassportNo())) {
				throw new BusinessException(CommonErrConstant.ERR_CUST_NON_MALAYSIAN_PSS_PRT_REQUIRED);
			}
		}
	}
	
	/**
	 * Add Identity
	 */
	public void addIdentity() {
		try {
			// if identity list instance is null, create instance
			if(null == supplierVO.getIdentityList()) supplierVO.setIdentityList(new ArrayList<IdentityVO>());
			identityList = purchaseBO.getIdentityList();
			
			for(IdentityVO vo : identityList){
				if(identityVO.getIdType().equals(vo.getIdType())){
					if(identityVO.getIdNo().equals(vo.getIdNo())) throw new BusinessException(CommonErrConstant.ERR_EO_IDENTITY_DUPLICATED);
				}
			}
			
			if(supplierVO.getAddEdit()){
				identityVO.setPersonId(supplierVO.getPersonId());
				identityAUDVO.getAddList().add(identityVO);
			}

			supplierVO.getIdentityList().add(identityVO);
			resetIdentityForm();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Edit Identity
	 */
	public void editIdentity() {
		try {
			if(supplierVO.getAddEdit()){
				identityAUDVO.getUpdList().add(identityVO);
			}
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * 
	 *  Delete Identity
	 */
	public void delIdentityList(IdentityVO identityVO) {
		try {
			if(supplierVO.getAddEdit()){
