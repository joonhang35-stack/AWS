	/*
	 * Load corporate list
	 */
	public List<String> loadCorpList(String s) throws BusinessException{
		List<String> results = new ArrayList<String>();
		for (SupplierVO vo : supplierList) {
			//if (vo.getFullName().toLowerCase().startsWith(s.toLowerCase()) && vo.getCode().equals("C")) {
			if (vo.getFullName().toLowerCase().startsWith(s.toLowerCase())) {
				results.add(vo.getFullName());
			}
		}
		return results;
	}
	
	/*
	 * Load Payment Term list
	 */
	private void loadPymtTerm() throws BusinessException {
		pymtTermList = purchaseBO.getPymtTermList("pymt_term");
	}

	/*
	 * Insert Personal Supplier
	 */
	
	private SupplierVO insertPersonal(SystemNumberGenerationVO systemNumberGenerationVO) throws BusinessException{
		trackingLogUtils.startLogs();
		purchaseBO.insertPersonal(supplierVO, systemNumberGenerationVO);
		trackingLogUtils.endLogs("insertPersonal");
		return supplierVO;
	}
	
	/*
	 * Insert Company Supplier
	 */
	
	private SupplierVO insertCompany(SystemNumberGenerationVO systemNumberGenerationVO) throws BusinessException{
		trackingLogUtils.startLogs();
		purchaseBO.insertCompany(supplierVO, systemNumberGenerationVO);
		trackingLogUtils.endLogs("insertCompany");
		return supplierVO;
	}
	
	/*
	 * Update Personal Supplier
	 */
	
	private void updatePersonal() throws BusinessException{
		trackingLogUtils.startLogs();
		
		purchaseBO.updatePersonal(supplierVO, supplierVO.getAddressVO(), supplierVO.getPersonVO(), supplierVO.getCorporateVO(), contactAUDVO, corContactAUDVO, identityAUDVO, remarksAUDVO);
		
		//supplierVO.setFullName(supplierVO.getPersonVO().getSalutation() + " " + supplierVO.getPersonVO().getLastName() + " " + supplierVO.getPersonVO().getGivenName());
		
		if(supplierVO.getSupplierType().equals("SC")){
			supplierVO.setSupplierType("Sundry Creditors");
		}else if(supplierVO.getSupplierType().equals("TC")){
			supplierVO.setSupplierType("Trade Creditors");
		}
		
		// Update Cash book and Account Trans - [Destination] table if supplier name change
		purchaseBO.updateAcctTransDestinationSpplr(supplierVO.getCompanyId(), supplierVO.getId());
		// Update Ex Order Bill and Account Trans - [Accout Id] table if supplier type change TC/SC
		purchaseBO.updateAcctTransAcctIdSupplr(supplierVO.getCompanyId(), supplierVO.getId());
		
		trackingLogUtils.endLogs("updatePersonal");
	}
	
	/*
	 * Delete Supplier
	 */
	
	private void delSuppl() throws BusinessException{
		purchaseBO.delSuppl(supplierVO, supplierVO.getAddressVO(), supplierVO.getPersonVO(), supplierVO.getCorporateVO());
	}

