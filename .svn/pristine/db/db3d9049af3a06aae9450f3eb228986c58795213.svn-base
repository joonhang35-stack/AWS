	/**
	 * Handle country selection
	 */
	public void handleCountrySelected() {
		try {
			if (supplierVO.getCorAddressVO().getCountryId() != 129) {
				if (StringUtils.isBlank(supplierVO.getMsicCode())) {
					supplierVO.setMsicCode(EInvoiceConstant.MSIC_CODE_NA);
				}
			}
			
//			supplierVO.setBzActDesc(LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_E_INV_MSIC_CODE, supplierVO.getMsicCode()));
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void processEmailSupplierProfileUpdate() {
		try {
			List<SupplierProfileUpdateVO> supplierProfileUpdateList = new ArrayList<SupplierProfileUpdateVO>();
			
			if (StringUtils.isNotBlank(supplierVO.getPersonVO().getEmail())) {
				SupplierProfileUpdateVO supplProfileUpdateVO = new SupplierProfileUpdateVO();
				supplProfileUpdateVO.setIdSupplier(supplierVO.getId());
				supplProfileUpdateVO.setUuid(UUID.randomUUID().toString());
				supplProfileUpdateVO.setEmail(supplierVO.getPersonVO().getEmail());
				supplierProfileUpdateList.add(supplProfileUpdateVO);
				
				String sendMessage = "Email sent to " + supplierVO.getPersonVO().getEmail();
	            FacesMessage facesMessage = new FacesMessage(FacesMessage.SEVERITY_INFO, sendMessage, sendMessage);
	            FacesContext.getCurrentInstance().addMessage(null, facesMessage);
				
	            customerProfileUpdateBO.updateSupplierProfiles(supplierProfileUpdateList, getSessionInfo().getUserVO());
				
				successResult();
			} else {
				PersonVO psVO = supplierVO.getPersonVO();
				String supplName = (psVO.getSalutation() != null ? psVO.getSalutation().toUpperCase() : "") + 
						(psVO.getLastName() != null  ? " " + psVO.getLastName() : "") +
						(psVO.getGivenName() != null  ? " " + psVO.getGivenName() : "");
				List<String> unableSentEmailCustList = new ArrayList<String>();
				unableSentEmailCustList.add(supplName);
				String unableToSendMessage = "Unable to send email to the supplier " + String.join(", ", unableSentEmailCustList) + ", email can not be blank";
	            FacesMessage facesMessage = new FacesMessage(FacesMessage.SEVERITY_ERROR, unableToSendMessage, unableToSendMessage);
	            FacesContext.getCurrentInstance().addMessage(null, facesMessage);
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
		
	}

