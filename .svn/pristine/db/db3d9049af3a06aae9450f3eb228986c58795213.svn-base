			}
			
			supplierVO.getIdentityList().remove(identityVO);
			successResult();
			resetIdentityForm();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Add Contact
	 */
	public void addContact() {
		try {
			// if identity list instance is null, create instance
			if(null == supplierVO.getContactList()) supplierVO.setContactList(new ArrayList<ContactVO>());
			
			if (supplierVO.getAddEdit()){
				if(supplierVO.getCode().equals("C")){
					if (null == supplierVO.getCorContactList()) supplierVO.setCorContactList(new ArrayList<CorContactVO>());
					corContactVO.setContactType(contactVO.getContactType());
					corContactVO.setContactNo(contactVO.getContactNo());
					corContactVO.setCorporateId(supplierVO.getCorporateVO().getId());
					supplierVO.getCorContactList().add(corContactVO);
					corContactAUDVO.getAddList().add(corContactVO);
					
				} else {
					contactVO.setPersonId(supplierVO.getPersonId());
					contactAUDVO.getAddList().add(contactVO);
				}
			}
			supplierVO.getContactList().add(contactVO);
			resetContactForm();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
