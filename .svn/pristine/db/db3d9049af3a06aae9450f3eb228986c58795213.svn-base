	/**
	 * Initialized
	 * @throws BusinessException 
	 */
	public void init(int flag) throws BusinessException {
		
		trackingLogUtils = new TrackingLogUtils(this.getClass());
		trackingLogUtils.startLogs();
		
		supplierList = new ArrayList<SupplierVO>();
		pymtTermList = new ArrayList<LookupItemVO>();
		resetForm();
		resetIdentityForm();
		resetContactForm();
		resetRemarksForm();

		try {
			liabilityList = billPymtBO.getAPAccount(getSessionInfoBean().getCompanyVO().getId());
			loadPymtTerm();
			initSearchParam();
			
			/* 	Flag:
				0 = Bill Payment
				1 = Bank Payment
				2 = Supplier
			*/
			if (flag == 1) {
				supplierList = purchaseBO.getSupplierList(getSessionInfoBean().getCompanyVO().getId());
				loadSupplier();
			} else if (flag == 2) {
				loadSupplier();
			}
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("PurchaseBean.init");
		}
	}
	
