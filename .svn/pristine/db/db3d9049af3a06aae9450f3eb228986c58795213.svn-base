	/**
	 * Add Remarks Details
	 */
	public void addRemarks() {
		try {
			
			Date dtnow = new Date();
			String strdtnow = null;
			DateFormat dtformat = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss");
			strdtnow = dtformat.format(dtnow);
			dtnow = dtformat.parse(strdtnow);
			// if identity list instance is null, create instance
			if(null == supplierVO.getRemarksList()) supplierVO.setRemarksList(new ArrayList<RemarksVO>());
			remarksVO.setStrTimestamp(strdtnow);
			remarksVO.setTimestamp(dtnow);
			
			if(supplierVO.getAddEdit()){
				if(supplierVO.getCode().equals("C")){
					remarksVO.setPersonCorpId((supplierVO.getCorporateVO().getId()));	
				}else{
					remarksVO.setPersonCorpId((supplierVO.getPersonId()));
				}
				remarksAUDVO.getAddList().add(remarksVO);
			}
			
			supplierVO.getRemarksList().add(remarksVO);
			resetRemarksForm();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Edit Remarks Details
	 */
	public void editRemarks() {
		try {
			Date dtnow = new Date();
			String strdtnow = null;
			DateFormat dtformat = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss");
			strdtnow = dtformat.format(dtnow);
			dtnow = dtformat.parse(strdtnow);
			
			if (!supplierVO.getAddEdit()) remarksVO.setTimestamp(dtnow);
			else {
				if(supplierVO.getCode().equals("C")) remarksVO.setPersonCorpId(supplierVO.getCorporateVO().getId());
				else remarksVO.setPersonCorpId(supplierVO.getPersonId());
				remarksAUDVO.getUpdList().add(remarksVO);
			}
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
