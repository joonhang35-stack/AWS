	private static void validateCustomerAddress(CustomerVO customerVO) throws BusinessException {
		if (customerVO != null) {
			if ("P".equals(customerVO.getPcTypeCd()) && customerVO.getBillAddressVO() != null) {
				AddressVO addressVO = customerVO.getBillAddressVO();
				if (StringUtils.isBlank(addressVO.getAddr1())) {
					throw new BusinessException(CommonErrConstant.ERR_CUST_NO_ADDR1);
				}
				if (StringUtils.isBlank(addressVO.getCity())) {
					throw new BusinessException(CommonErrConstant.ERR_CUST_NO_CITY);
				}
			} else if ("C".equals(customerVO.getPcTypeCd()) && customerVO.getCorBillAddressVO() != null) {
				CorAddressVO addressVO = customerVO.getCorBillAddressVO();
				if (StringUtils.isBlank(addressVO.getAddr1())) {
					throw new BusinessException(CommonErrConstant.ERR_CUST_NO_ADDR1);
				}
				if (StringUtils.isBlank(addressVO.getCity())) {
					throw new BusinessException(CommonErrConstant.ERR_CUST_NO_CITY);
				}
			}
		}
		validateCustomerState(customerVO);
		validateCustomerPostcode(customerVO);
	}
	
	public static void validateCustomer(CustomerVO customerVO) throws BusinessException {
		validateCustomerAddress(customerVO);
	}
	
	public static void generateValidationQrCode(EInvoiceDocumentVO eInvoiceDocumentVO) throws WriterException, IOException {
		if (eInvoiceDocumentVO.getValidationLink() != null) {
			System.out.println("CYY eInvoiceDocumentVO.getValidationLink(): " + eInvoiceDocumentVO.getValidationLink());
			eInvoiceDocumentVO.setQrCode(QRCodeUtils.generateQRCodeBase64ByteArray(eInvoiceDocumentVO.getValidationLink(), 150, 150));
			eInvoiceDocumentVO.setQrCodeStr(new String(eInvoiceDocumentVO.getQrCode()));
		} 
	}
	
	/**
	 * @param idValue - value of identification (eg. 011014141111)
	 * @param idType - type of identification (eg. BRN/NRIC/SST etc.)
	 * @return PartyIdentificationType
	 */
	public static PartyIdentificationType generatePartyIdentificationType(String idValue, String idType) {
		PartyIdentificationType partyIdentificationType = new PartyIdentificationType();
		partyIdentificationType.setID(idValue);
		partyIdentificationType.getID().setSchemeID(idType);
		return partyIdentificationType;
	}
	
	/**
	 * generate TIN PartyIdentificationType for Self Billed Invoice
	 * @param exOrderBillVO
	 * @return
	 */
	private static PartyIdentificationType generateTINPartyIdentificationType(ExOrderBillVO exOrderBillVO) {
		return generatePartyIdentificationType(
				exOrderBillVO.getIdPayee() != null ? EInvoiceConstant.E_INV_GNRL_TIN_PUBLIC
						: EInvoiceConstant.E_INV_GNRL_TIN_F_SUPL,
				EInvoiceConstant.E_INV_IDENTITY_TYPE_TIN);
	}
	
	/**
	 * generate supplier identity PartyIdentificationType for self-billed invoice
	 * @param exOrderBillVO
	 * @param supplierVO
	 * @return
	 */
	private static PartyIdentificationType generatePartyIdentificationType(ExOrderBillVO exOrderBillVO, SupplierVO supplierVO) {
		if (exOrderBillVO.getIdPayee() != null) {
			return generatePartyIdentificationType(supplierVO.getIdNo().replaceAll("[^0-9]", "").trim(), EInvoiceConstant.E_INV_IDENTITY_TYPE_NRIC);
		} else {
			// foreign supplier, use idType=BRN & idValue=NA
			return generatePartyIdentificationType(EInvoiceConstant.NOT_APPLICABLE, EInvoiceConstant.E_INV_IDENTITY_TYPE_BRN);
		}
	}
	
	/**
	 * <pre>
	 * copy data from EInvoiceDocument to EInvoiceDocumentVO, after convert API response (JSON) to object
	 * EInvoiceDocument eInvoiceDocument = gson.fromJson(jsonResponse.toString(), EInvoiceDocument.class);
	 * </pre>
	 * @param toEInvoiceDocumentVO
	 * @param fromEInvoiceDocument
	 * @throws ParseException 
	 */
	public static void copyDetails(EInvoiceDocumentVO toEInvoiceDocumentVO, EInvoiceDocument fromEInvoiceDocument) throws ParseException {
		
		toEInvoiceDocumentVO.seteInvoiceDocument(fromEInvoiceDocument);
		
		// convert date string to date object
        if (StringUtils.isNotEmpty(fromEInvoiceDocument.getDateTimeIssued()))	toEInvoiceDocumentVO.setDtIssued(DatesUtils.iSOStringToDate(fromEInvoiceDocument.getDateTimeIssued()));
        if (StringUtils.isNotEmpty(fromEInvoiceDocument.getDateTimeReceived()))	toEInvoiceDocumentVO.setDtReceived(DatesUtils.iSOStringToDate(fromEInvoiceDocument.getDateTimeReceived()));
        if (StringUtils.isNotEmpty(fromEInvoiceDocument.getCancelDateTime()))	toEInvoiceDocumentVO.setDtCancel(DatesUtils.iSOStringToDate(fromEInvoiceDocument.getCancelDateTime()));
        if (StringUtils.isNotEmpty(fromEInvoiceDocument.getDateTimeValidated()))	toEInvoiceDocumentVO.setDtValidated(DatesUtils.iSOStringToDate(fromEInvoiceDocument.getDateTimeValidated()));
        if (StringUtils.isNotEmpty(fromEInvoiceDocument.getRejectRequestDateTime()))	toEInvoiceDocumentVO.setDtReject(DatesUtils.iSOStringToDate(fromEInvoiceDocument.getRejectRequestDateTime()));
        
		toEInvoiceDocumentVO.setLongId(fromEInvoiceDocument.getLongId());
		toEInvoiceDocumentVO.seteInvoiceInternalId(fromEInvoiceDocument.getInternalId());
		toEInvoiceDocumentVO.setIssuerName(fromEInvoiceDocument.getIssuerName());
		toEInvoiceDocumentVO.setIssuerTin(fromEInvoiceDocument.getIssuerTin());
		toEInvoiceDocumentVO.setReceiverName(fromEInvoiceDocument.getReceiverName());
		toEInvoiceDocumentVO.setReceiverId(fromEInvoiceDocument.getReceiverId());
//		toEInvoiceDocumentVO.setDtCancel(fromEInvoiceDocument.getCancelDateTimeDt());
//		toEInvoiceDocumentVO.setDtValidated(fromEInvoiceDocument.getDateTimeValidatedDt());
//		toEInvoiceDocumentVO.setDtReject(fromEInvoiceDocument.getRejectRequestDateTimeDt());
		toEInvoiceDocumentVO.setDocStatusReason(fromEInvoiceDocument.getDocumentStatusReason());
		if (fromEInvoiceDocument.getTotalDiscount() != null)		toEInvoiceDocumentVO.setTotalDiscount(Double.valueOf(fromEInvoiceDocument.getTotalDiscount()));
		if (fromEInvoiceDocument.getTotalExcludingTax() != null)	toEInvoiceDocumentVO.setTotalExcludingTax(Double.valueOf(fromEInvoiceDocument.getTotalExcludingTax()));
		if (fromEInvoiceDocument.getTotalNetAmount() != null)		toEInvoiceDocumentVO.setTotalNetAmount(Double.valueOf(fromEInvoiceDocument.getTotalNetAmount()));
		toEInvoiceDocumentVO.setTotalPayableAmount(Double.valueOf(fromEInvoiceDocument.getTotalPayableAmount()));
		toEInvoiceDocumentVO.setStatusCode(fromEInvoiceDocument.getStatus());
		toEInvoiceDocumentVO.seteInvoiceVersion(fromEInvoiceDocument.getTypeVersionName());
		toEInvoiceDocumentVO.seteInvoiceCreatedBy(fromEInvoiceDocument.getCreatedByUserId());
	}
	
	/**
	 * <pre>
	 * copy data from EInvoiceApiDailySnapshotTransVO to EInvoiceDocumentVO, after convert API response (JSON) to object
	 * </pre>
	 * @param toVO
	 * @param fromVO
	 * @throws ParseException 
	 */
	public static void copyDetails(EInvoiceDocumentVO toVO, EInvoiceApiDailySnapshotTransVO fromVO) throws ParseException {
		
       toVO.setDtIssued(fromVO.getDateTimeIssued());
       toVO.setDtReceived(fromVO.getDateTimeReceived());
       toVO.setDtCancel(fromVO.getCancelDateTime());
       toVO.setDtValidated(fromVO.getDateTimeValidated());
       toVO.setDtReject(fromVO.getRejectRequestDateTime());

		toVO.setLongId(fromVO.getLongId());
		toVO.seteInvoiceInternalId(fromVO.getInternalId());
//		toVO.setIssuerName(fromVO.getIssuerName());
		toVO.setIssuerTin(fromVO.getIssuerTIN());
		toVO.setReceiverName(fromVO.getReceiverName());
		toVO.setReceiverId(fromVO.getReceiverID());
		toVO.setDocStatusReason(fromVO.getDocumentStatusReason());
		toVO.setTotalDiscount(Double.valueOf(fromVO.getTotalDiscount()));
//		toVO.setTotalExcludingTax(Double.valueOf(fromVO.getTotalExcludingTax()));
		toVO.setTotalNetAmount(Double.valueOf(fromVO.getNetAmount()));
//		toVO.setTotalPayableAmount(Double.valueOf(fromVO.getTotalPayableAmount()));
		toVO.setStatusCode(fromVO.getStatus());
		toVO.seteInvoiceVersion(fromVO.getTypeVersionName());
		toVO.seteInvoiceCreatedBy(fromVO.getCreatedByUserId());
	}
	
	public static void printEInvoice(EInvoiceDocumentVO eInvoiceDocumentVO, Map<String, Object> map) throws BusinessException, JRException, IOException, WriterException {
		
		// set e inv qr code
		if (StringUtils.isNotBlank(eInvoiceDocumentVO.getDocumentUuid()) && eInvoiceDocumentVO.getStatusCode() != null && eInvoiceDocumentVO.getStatusCode().equals(EInvoiceConstant.E_INV_STATUS_VALID)) {
			String validLink = geteInvoiceValidationLink(eInvoiceDocumentVO);
			eInvoiceDocumentVO.setQrCodeInputStream(QRCodeUtils.generateQRCodeByteArrayInputStream(validLink, 300, 300));
		}
		
		List<EInvoiceDocumentVO> docList = new ArrayList<EInvoiceDocumentVO>();
		docList.add(eInvoiceDocumentVO);
		
//		System.out.println("CYY eInvoiceDocumentVO.getRefInvoiceVO().getCode(): " + eInvoiceDocumentVO.getRefInvoiceVO().getCode());
		
		String jasperFileName = CommonConstant.JAS_RPT_E_INV;
		String reportName = generateReportName(eInvoiceDocumentVO);
		
		JasperPrint jasperPrint1 = ReportUtils.getJasperPrint(docList, map, jasperFileName);
		ReportUtils.printReport(jasperPrint1, reportName);
	}
	
	/**
	 * <div>generate report name for E-Invoice printout</div>
	 * <div>Sales Invoice : E-Invoice_AVXXXXXXX_YYMMDD_HHMMSS</div>
	 * <div>Credit Note : E-CNXXXXX_YYMMDD_HHMMSS</div>
	 * <div>Refund Note : E-RNXXXXX_YYMMDD_HHMMSS</div>
	 * @param eInvoiceDocumentVO
	 * @return
	 */
	private static String generateReportName(EInvoiceDocumentVO eInvoiceDocumentVO) {
		String reportName = CommonConstant.PDF_RPT_E_INV;
		if (eInvoiceDocumentVO.geteInvoiceDocType().equals(EInvoiceConstant.E_INV_DOC_TYPE_CREDIT_NOTE)
				|| eInvoiceDocumentVO.geteInvoiceDocType().equals(EInvoiceConstant.E_INV_DOC_TYPE_REFUND_NOTE)) {
			reportName = CommonConstant.PDF_RPT_E_INV_CNRN;
		} else {
			reportName += "_";
		}
		
		reportName += eInvoiceDocumentVO.getSysPrefix();
		reportName += eInvoiceDocumentVO.getRefNo();
		
		reportName += "_";
		return reportName;
	}
	
	public static String geteInvoiceValidationLink(EInvoiceDocumentVO eInvoiceDocumentVO) {
		if (eInvoiceDocumentVO != null && StringUtils.isNotBlank(eInvoiceDocumentVO.getDocumentUuid()) && StringUtils.isNotBlank(eInvoiceDocumentVO.getLongId())) {
			return geteInvoiceValidationLink(eInvoiceDocumentVO.getDocumentUuid(), eInvoiceDocumentVO.getLongId());
		}
		
		return null;
	}
	
	public static String geteInvoiceValidationLink(String uuid, String longId) {
		if (StringUtils.isNotBlank(uuid) && StringUtils.isNotBlank(longId)) {
			return EInvoiceProperties.getEnvBaseUrl() + uuid + "/share/" + longId;
		}
		
		return null;
	}
	
	/**
	 * <p>
	 * Insert document, document details and history after successfully submit E-Invoice.
	 * <pre>
	 * EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.insertInvoice(documentUuid, submissionUid, CommonConstant.E_INV_STATUS_SUBMIT, invoiceVO, ProductConstant.E_INV_DOC_TYPE_INVOICE);
	 * eInvoiceBO.insertDocumentDetails(invoiceVO.getInvoiceType(), eInvoiceDocumentVO);
	 * invoiceBO.insertInvoiceHistory(invoiceVO.getId(), CommonConstant.ACTION_CD_UPD, "Submit E-Invoice");
	 * </pre></p>
	 * 
	 * @param documentUuid
	 * @param submissionUid
	 * @param invoiceVO
	 * @param eInvDocType - ProductConstant.E_INV_DOC_TYPE
	 * @throws BusinessException
	 * @throws QueueException
	 */
	private void insertInvoiceEInvoiceData(String documentUuid, String submissionUid, InvoiceVO invoiceVO, String eInvDocType) throws BusinessException, QueueException {
		EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.insertInvoice(documentUuid, submissionUid, EInvoiceConstant.E_INV_STATUS_SUBMIT, invoiceVO, EInvoiceConstant.E_INV_DOC_TYPE_INVOICE);
		eInvoiceBO.insertDocumentDetails(invoiceVO.getInvoiceType(), eInvoiceDocumentVO);
	}
	
	/**
	 * @param lineID
	 * @param desc
	 * @param amount
	 * @param quantity
	 * @param unitPrice
	 * @return
	 */
	private static InvoiceLineType generateInvoiceLineType(String lineID, String classCode, String desc, Double amount, Integer quantity, Double unitPrice) {
		
		InvoiceLineType invoiceLineType = new InvoiceLineType();
		
		invoiceLineType.setID(lineID);
		invoiceLineType.setInvoicedQuantity(BigDecimal.valueOf(quantity));
		
		invoiceLineType.setLineExtensionAmount(BigDecimal.valueOf(amount));
		invoiceLineType.getLineExtensionAmount().setCurrencyID("MYR");
		
		TaxTotalType taxTotalType = new TaxTotalType();
		taxTotalType.setTaxAmount(BigDecimal.valueOf(0));
		taxTotalType.getTaxAmount().setCurrencyID("MYR");
		
		TaxSubtotalType taxSubtotalType = new TaxSubtotalType();
		taxSubtotalType.setTaxableAmount(BigDecimal.valueOf(0));
		taxSubtotalType.getTaxableAmount().setCurrencyID("MYR");
		taxSubtotalType.setTaxAmount(BigDecimal.valueOf(0));
		taxSubtotalType.getTaxAmount().setCurrencyID("MYR");
		taxSubtotalType.setPercent(BigDecimal.valueOf(0));
		
		TaxCategoryType taxCategoryType = new TaxCategoryType();
		taxCategoryType.setID("06");
		
		TaxSchemeType taxSchemeType = new TaxSchemeType();
		taxSchemeType.setID("OTH");
		taxSchemeType.getID().setSchemeID("UN/ECE 5153");
		taxSchemeType.getID().setSchemeAgencyID("6");
		taxCategoryType.setTaxScheme(taxSchemeType);
		
		taxSubtotalType.setTaxCategory(taxCategoryType);
		taxTotalType.addTaxSubtotal(taxSubtotalType);
		invoiceLineType.addTaxTotal(taxTotalType);
		
		ItemType itemType = new ItemType();
		CommodityClassificationType commodityClassificationType = new CommodityClassificationType();
		commodityClassificationType.setItemClassificationCode(classCode);
		commodityClassificationType.getItemClassificationCode().setListID("CLASS");
		itemType.addCommodityClassification(commodityClassificationType);
		
		itemType.addDescription(new DescriptionType(desc));
		
		itemType.setOriginCountry(new CountryType());
		itemType.getOriginCountry().setIdentificationCode("MYS");
		
		invoiceLineType.setItem(itemType);
		
		invoiceLineType.setPrice(new PriceType());
		invoiceLineType.getPrice().setPriceAmount(BigDecimal.valueOf(unitPrice));
		invoiceLineType.getPrice().getPriceAmount().setCurrencyID("MYR");
		invoiceLineType.setItemPriceExtension(new PriceExtensionType());
		invoiceLineType.getItemPriceExtension().setAmount(BigDecimal.valueOf(amount));
		invoiceLineType.getItemPriceExtension().getAmount().setCurrencyID("MYR");
		
		return invoiceLineType;
	}
	
	/**
	 * @param invoiceItemVO
	 * @return
	 */
	private static InvoiceLineType generateInvoiceLineType(InvoiceItemVO invoiceItemVO) {
		InvoiceLineType invoiceLineType = generateInvoiceLineType(
				String.valueOf(invoiceItemVO.getId()), 
				invoiceItemVO.getClassificationCode(),
				invoiceItemVO.getDesc(), 
				invoiceItemVO.getAmount(), 
				invoiceItemVO.getQty(), 
				invoiceItemVO.getUnitPrice());
		return invoiceLineType;
	}
	
	/**
	 * generate consolidate self billed invoice InvoiceLineType from ExOrderBillVO
	 * @param exOrderBillVO
	 * @param prefixVal
	 * @return
	 */
	private static InvoiceLineType generateInvoiceLineType(ExOrderBillVO exOrderBillVO, String prefixVal) {		
		InvoiceLineType invoiceLineType = generateInvoiceLineType(
				String.valueOf(prefixVal + " " + exOrderBillVO.getCode()), 
				EInvoiceConstant.CLASS_CODE_CONSOL_E_INV,
				prefixVal + " " + exOrderBillVO.getCode(), 
				exOrderBillVO.getBillAmt(), 
				1, 
				exOrderBillVO.getBillAmt());
		return invoiceLineType;
	}
	
	private static TaxTotalType generateNoTaxTotalType() {
		TaxTotalType taxTotalType = new TaxTotalType();
		taxTotalType.setTaxAmount(BigDecimal.valueOf(0.0)); // Total amount of tax payable
		taxTotalType.getTaxAmount().setCurrencyID("MYR");
		
		TaxSubtotalType taxSubtotalType = new TaxSubtotalType();
		taxSubtotalType.setTaxableAmount(BigDecimal.valueOf(0));
		taxSubtotalType.getTaxableAmount().setCurrencyID("MYR");
		taxSubtotalType.setTaxAmount(BigDecimal.valueOf(0));
		taxSubtotalType.getTaxAmount().setCurrencyID("MYR");
		
		TaxCategoryType taxCategoryType = new TaxCategoryType();
		taxCategoryType.setID("06");
		
		TaxSchemeType taxSchemeType = new TaxSchemeType();
		taxSchemeType.setID("OTH");
		taxSchemeType.getID().setSchemeID("UN/ECE 5153");
		taxSchemeType.getID().setSchemeAgencyID("6");
		taxCategoryType.setTaxScheme(taxSchemeType);
		
		taxSubtotalType.setTaxCategory(taxCategoryType);
		taxTotalType.addTaxSubtotal(taxSubtotalType);
		
		return taxTotalType;
	}
	
	private static MonetaryTotalType generateMonetaryTotalType(BigDecimal amount) {
		MonetaryTotalType monetaryTotalType = new MonetaryTotalType();
		monetaryTotalType.setTaxExclusiveAmount(amount); // Y
		monetaryTotalType.getTaxExclusiveAmount().setCurrencyID("MYR");
		monetaryTotalType.setTaxInclusiveAmount(amount); // Y
		monetaryTotalType.getTaxInclusiveAmount().setCurrencyID("MYR");
		monetaryTotalType.setPayableAmount(amount); // Y
		monetaryTotalType.getPayableAmount().setCurrencyID("MYR");
		
		return monetaryTotalType;
	}
	
	private static MonetaryTotalType generateMonetaryTotalType(Double amount) {
		return generateMonetaryTotalType(BigDecimal.valueOf(amount));
	}
	
	private static BillingReferenceType generateBillingReferenceType(InvoiceVO refInvVO, String invPrefixVal) throws BusinessException {
		validateBillingReferenceInput(refInvVO, invPrefixVal);
		return generateBillingReferenceType(invPrefixVal + " " + refInvVO.getCode(), refInvVO.geteInvoiceDocumentUuid(), invPrefixVal);
	}
	
	/**
	 * @param refInternalId invPrefixVal + " " + refInvVO.getCode()
	 * @param refEInvoiceDocumentUuid refInvVO.geteInvoiceDocumentUuid()
	 * @param invPrefixVal
	 * @return
	 * @throws BusinessException
	 */
	private static BillingReferenceType generateBillingReferenceType(String refInternalId, String refEInvoiceDocumentUuid, String invPrefixVal) throws BusinessException {
		
		UUIDType uuidType = new UUIDType(refEInvoiceDocumentUuid);
		
		IDType idType = new IDType(refInternalId);
		
		DocumentReferenceType documentReferenceType = new DocumentReferenceType();
		
//		https://www.hasil.gov.my/media/0xqitc2t/lhdnm-e-invoice-general-faqs.pdf
//		#42
//		If adjustments are to be made to original invoices that were issued prior to the implementation 
//		of e-Invoice (i.e., no IRBM Unique Identifier Number has been assigned), taxpayers are then 
//		allowed to input "NA" in the 'Original e-Invoice Reference Number' data field.
		if (StringUtils.isBlank(refEInvoiceDocumentUuid))	documentReferenceType.setUUID(EInvoiceConstant.NOT_APPLICABLE);
		else												documentReferenceType.setUUID(refEInvoiceDocumentUuid);
		documentReferenceType.setID(refInternalId);
		BillingReferenceType billingReferenceType = new BillingReferenceType();
		billingReferenceType.setInvoiceDocumentReference(documentReferenceType);

		return billingReferenceType;
	}
	
	private static void validateBillingReferenceInput(InvoiceVO refInvVO, String invPrefixVal) throws BusinessException {
		if (refInvVO == null) {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("CN/RN invoice does not exist."));
		}
		
		if (StringUtils.isBlank(invPrefixVal)) {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Invoice prefix value is blank."));
		}
		
		if (StringUtils.isBlank(refInvVO.getCode())) {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("CN/RN invoice number is blank."));
		}
		
		System.out.println("CYY validateBillingReferenceInput isAfterEInvoice(refInvVO): " + isAfterEInvoice(refInvVO));
		if (isAfterEInvoice(refInvVO)) {
			if (StringUtils.isBlank(refInvVO.geteInvoiceDocumentUuid())) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("CN/RN invoice is not submitted to E-Invoice."));
			}
		}
	}
	
	/**
	 * Validates the reference invoice data before submitting CN/RN to e-Invoice.
	 * <p>
	 * This method performs the following validations:
	 * <ul>
	 *   <li>{@code amtAftRefund == 0 && refundAmt == 0}</li>
	 *   <li>{@code StringUtils.isBlank(creditNoteVO.getCnInvNo())}</li>
	 *   <li>{@code refInvVO == null}</li>
	 *   <li>{@code StringUtils.isBlank(refInvVO.getCode())}</li>
	 *   <li>{@code StringUtils.isBlank(refInvVO.geteInvoiceDocumentUuid())}</li>
	 *   <li>{@code refEInvoiceDocumentVO == null}</li>
	 * </ul>
	 * </p>
	 *
	 * <p>
	 * If all validations pass, the method sets:
	 * <ul>
	 *   <li>{@code creditNoteVO.cnInv} with the referenced invoice.</li>
	 *   <li>{@code creditNoteVO.cnInv.eInvoiceDocumentVO} with the corresponding e-Invoice document.</li>
	 * </ul>
	 * </p>
	 *
	 * @param creditNoteVO The Credit Note or Refund Note invoice to validate and populate with referenced invoice info.
	 * @return The updated {@code creditNoteVO} with reference invoice and e-Invoice document info set.
	 * @throws BusinessException If the referenced invoice is invalid, missing, or not e-invoiced when required.
	 */

	private InvoiceVO validateRefInv(InvoiceVO creditNoteVO) throws BusinessException {
		
		if (creditNoteVO.getAmtAftRefund().compareTo(0D) == 0 && creditNoteVO.getRefundAmt().compareTo(0D) == 0) {
			throw new BusinessException(CommonErrConstant.ERR_CN_RN_AMT_ZERO);
		}
		
		if (StringUtils.isBlank(creditNoteVO.getCnInvNo())) {
			throw new BusinessException(CommonErrConstant.ERR_CN_NO_INV);
		}
		
		InvoiceVO refInvVO = invoiceBO.getInvoiceByCode(creditNoteVO.getCnInvNo());
		
		if (refInvVO == null) {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("CN/RN invoice does not exist."));
		}
		
		if (StringUtils.isBlank(refInvVO.getCode())) {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("CN/RN invoice number is blank."));
		}
		
		EInvoiceDocumentVO refEInvoiceDocumentVO = eInvoiceBO.getEInvoiceByUUID(refInvVO.geteInvoiceDocumentUuid());
//		validateRefInv(creditNoteVO.getCnInvNo(), refInvVO, refEInvoiceDocumentVO);
		
		if (isAfterEInvoice(refInvVO)) {
			if (StringUtils.isBlank(refInvVO.geteInvoiceDocumentUuid())) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("CN/RN invoice is not submitted to E-Invoice."));
			}
			
			if (refEInvoiceDocumentVO == null) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Can't get CN/RN invoice"));
			}
		}
		
		creditNoteVO.setCnInv(refInvVO);
		creditNoteVO.getCnInv().seteInvoiceDocumentVO(refEInvoiceDocumentVO);
		
		return creditNoteVO;
	}
	
	/**
	 * validate reference invoice data before submitting CN/RN to e-invoice
	 * @param refNo invoiceVO.getCnInvNo
	 * @param refInvVO
	 * @param refEInvoiceDocumentVO
	 * @throws BusinessException
	 */
	@Deprecated
	private static void validateRefInv(String refNo, InvoiceVO refInvVO, EInvoiceDocumentVO refEInvoiceDocumentVO) throws BusinessException {
		if (refInvVO == null) {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("CN/RN invoice does not exist."));
		}
		
		if (StringUtils.isBlank(refInvVO.getCode())) {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("CN/RN invoice number is blank."));
		}
		
//		System.out.println("CYY refInvVO.getInvoiceDt(): " + DatesUtils.getddMMyy(refInvVO.getInvoiceDt()));
//		System.out.println("CYY refInvVO.getDepartureDt(): " + DatesUtils.getddMMyy(refInvVO.getDepartureDt()));
//		System.out.println("CYY validateRefInv isAfterEInvoice(refInvVO): " + isAfterEInvoice(refInvVO) + " (" + refInvVO.getCatCd() + ")");
		if (isAfterEInvoice(refInvVO)) {
			if (StringUtils.isBlank(refInvVO.geteInvoiceDocumentUuid())) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("CN/RN invoice is not submitted to E-Invoice."));
			}
			
			if (refEInvoiceDocumentVO == null) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Can't get CN/RN invoice"));
			}
		}
	}
	
	/**
	 * check if invoice issued after 31/12/2024
	 * @param invoiceVO
	 * @return
	 */
	private static boolean isAfterEInvoice(InvoiceVO invoiceVO) {
		String[] arrCheckDepCat = {CommonConstant.LOOKUP_ITM_INV_CAT_TOUR, CommonConstant.LOOKUP_ITM_INV_CAT_FIT, CommonConstant.LOOKUP_ITM_INV_CAT_MICE};
		
		if (ArrayUtils.contains(arrCheckDepCat, invoiceVO.getCatCd())) {
			// depends on check in date
			return invoiceVO.getDepartureDt().toInstant().atZone(ZoneOffset.UTC).toLocalDate().isAfter(LocalDate.of(2024, 12, 31));
		} else {
			// depends on invoice date
			return invoiceVO.getInvoiceDt().toInstant().atZone(ZoneOffset.UTC).toLocalDate().isAfter(LocalDate.of(2024, 12, 31));
		}
//		return invoiceVO.getInvoiceDt().toInstant().atZone(ZoneOffset.UTC).toLocalDate().isAfter(LocalDate.of(2024, 12, 31));
	}
	
	/**
	 * @param invoiceType the in-processing invoiceType
	 * @param refInvCode code of reference invoice (CN/RN invoice)
	 * @param refEInvoiceDocumentVO reference EInvoiceDocumentVO
	 * @param amount CN - getAmtAftRefund / RN - getRefundAmt
	 * @param invPrefixVal - system invoice prefix value
	 * @throws BusinessException
	 */
	private static void populateConsolRefData(InvoiceType invoiceType, String refInvCode, EInvoiceDocumentVO refEInvoiceDocumentVO, Double amount, String invPrefixVal) throws BusinessException {

		System.out.println("CYY refInvCode: " + refInvCode);
		System.out.println("CYY amount: " + amount);
		
		CustomerPartyType customerPartyType = new CustomerPartyType();
		customerPartyType.setParty(generateConsolidatePartyType());
		invoiceType.setAccountingCustomerParty(customerPartyType);
		
		invoiceType.setBillingReference(new ArrayList<BillingReferenceType>());
		if (refEInvoiceDocumentVO == null)	invoiceType.addBillingReference(generateBillingReferenceType(invPrefixVal + " " + refInvCode, null, invPrefixVal));
		else								invoiceType.addBillingReference(generateBillingReferenceType(refEInvoiceDocumentVO.getRefNo(), refEInvoiceDocumentVO.getDocumentUuid(), invPrefixVal));
		
		invoiceType.setInvoiceLine(new ArrayList<InvoiceLineType>());
		InvoiceLineType invoiceLineType = generateInvoiceLineType(invPrefixVal + " " + refInvCode, EInvoiceConstant.CLASS_CODE_CONSOL_E_INV, invPrefixVal + " " + refInvCode, amount, 1, amount);
		invoiceType.addInvoiceLine(invoiceLineType);
			
		invoiceType.setLegalMonetaryTotal(generateMonetaryTotalType(BigDecimal.valueOf(amount)));
	}
	
