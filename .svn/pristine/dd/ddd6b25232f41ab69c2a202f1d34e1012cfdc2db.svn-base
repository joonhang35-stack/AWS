	public static HttpsURLConnection sendCancelRequest(String documentUuid, String cancellationReason, String accessToken) throws JSONException, ClientProtocolException, IOException, KeyManagementException, NoSuchAlgorithmException {
		// construct url
		String url = UriComponentsBuilder.fromHttpUrl(EInvoiceProperties.getSystemApiUrl() + "/api/v1.0/documents/state/"
				+ documentUuid + "/state").build().toUriString();

		JSONObject json = new JSONObject();
		json.put("status", "cancelled");
		json.put("reason", cancellationReason);
		
		return openHttpsURLConnection(new URL(url), "PUT", accessToken, json);
	}
	
	/**
	 * <pre>
	 * check docUuid before calling
	 * 
	 * <b>Example</b>
	 * if (StringUtils.isBlank(invoiceVO.geteInvoiceDocumentUuid())) {
	 * 	throw new BusinessException(CommonErrConstant.ERR_DOC_NO_UUID);
	 * }
	 * </pre>
	 * @param cancellationReason
	 * @param eInvoiceDocumentUuid
	 * @param companyVO
	 * @return
	 * @throws Exception
	 */
	public JSONObject cancelDocument(String cancellationReason, String eInvoiceDocumentUuid, CompanyVO companyVO) throws Exception {

		// get API access token
		String accessToken = getAccessToken(companyVO, true);

		// no need TIN validation, as cancel API requires uuid only

		// open connection
		HttpsURLConnection connection = sendCancelRequest(eInvoiceDocumentUuid, cancellationReason, accessToken);
		
		// get response code
		int respCode = connection.getResponseCode();
//            System.out.println("CYY respCode: " + respCode);

		// get response message from connection
        String response = getConnectionResponse(respCode, connection); 
        
		JSONObject jsonResponse = new JSONObject(response);
		System.out.println(jsonResponse.toString(4));

		// deal with errors
		if (respCode == 400) {
			JSONObject err = jsonResponse.getJSONObject("error");
			JSONArray details = err.getJSONArray("details");

			for (int j = 0; j < details.length(); j++) {
				JSONObject innerErr = details.getJSONObject(j);
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null,
						new String[] { innerErr.getString("message") });
			}
		} else if (respCode == 403) {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null,
					new String[] { "Document not issued by Apple" });
		}
		
		return jsonResponse;
	}
	
	public void processCancelResponse(JSONObject cancelResponse) throws JSONException, BusinessException {
		String docUuid = cancelResponse.getString("uuid");
		eInvoiceBO.cancelEInvoiceDocument(docUuid);
	}
	
	public void processRefundNoteCancelResponse(JSONObject cancelResponse) throws JSONException, BusinessException {
		String docUuid = cancelResponse.getString("uuid");
		eInvoiceBO.cancelEInvoiceRefundNote(docUuid);
	}
	
	/**
	 * check submission error (if exists)
	 * 
	 * @param submitResponse
	 * @throws BusinessException
	 * @throws JSONException
	 */
	public static void checkResponseErr(JSONObject submitResponse) throws BusinessException, JSONException {
		if (submitResponse.isNull("submissionUid") && submitResponse.isNull("acceptedDocuments") && submitResponse.isNull("rejectedDocuments")) {
			if (!submitResponse.isNull("error")) {
				if (submitResponse.isNull("message")) {
					
					JSONObject err = submitResponse.getJSONObject("error");
					
					String detailsErrMsg = "";
					
					if (err.isNull("details")) {
						
						// Sample Response
//						{"error": {
//						    "code": "ValidationError",
//						    "details": null,
//						    "message": "Invalid structure",
//						    "target": "submission"
//						}}
						
						if (err.isNull("message")) {
							throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null,
									new String[] { submitResponse.getJSONObject("error").getString("code") + "."});
						} else {
							detailsErrMsg = err.getString("message");
						}
					} else {
	                	JSONArray details = err.getJSONArray("details");
	                	for (int j = 0; j < details.length(); j++) {
	                        JSONObject innerErr = details.getJSONObject(j);
	                        detailsErrMsg += innerErr.getString("message") + "\n";
	                    }	
					}
                			
					throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null,
							FunctionUtils.generateArrayFromStr(detailsErrMsg));

				} else {
					throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null,
							new String[] { submitResponse.getJSONObject("error").getString("code") + " "
									+ submitResponse.getJSONObject("error").getString("message") });
				}
				
			} else {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null,
						FunctionUtils.generateArrayFromStr("Unknown error. Please contact IT."));
			}
		}
	}
	
	/**
	 * Returns partyType for consolidate invoices
	 * 
	 * @return PartyType
	 */
	public static PartyType generateConsolidatePartyType() {
		
		PartyType partyType = new PartyType();
		partyType.setIndustryClassificationCode(EInvoiceConstant.MSIC_CODE_NA);
		partyType.getIndustryClassificationCode().setName(EInvoiceConstant.NOT_APPLICABLE);
		
//		PartyIdentificationType tin = new PartyIdentificationType();
//		tin.setID(ProductConstant.E_INV_GNRL_PUBLIC_TIN);
//		tin.getID().setSchemeID("TIN");
//		partyType.addPartyIdentification(tin);
		partyType.addPartyIdentification(generatePartyIdentificationType(EInvoiceConstant.E_INV_GNRL_TIN_PUBLIC, EInvoiceConstant.E_INV_IDENTITY_TYPE_TIN));
		
//		PartyIdentificationType brn = new PartyIdentificationType();
//		brn.setID("NA");
//		brn.getID().setSchemeID("BRN");
//		partyType.addPartyIdentification(brn);
		partyType.addPartyIdentification(generatePartyIdentificationType(EInvoiceConstant.NOT_APPLICABLE, EInvoiceConstant.E_INV_IDENTITY_TYPE_BRN));
		partyType.addPartyIdentification(generatePartyIdentificationType(EInvoiceConstant.NOT_APPLICABLE, EInvoiceConstant.E_INV_IDENTITY_TYPE_SST));
		
		AddressType addressType = new AddressType();
		addressType.setCityName(EInvoiceConstant.NOT_APPLICABLE);
		addressType.setPostalZone(EInvoiceConstant.NOT_APPLICABLE);
		addressType.setCountrySubentityCode(EInvoiceConstant.STATE_CD_NA);
		
		AddressLineType addressLineType1 = new AddressLineType();
		addressLineType1.setLine(new LineType("NA"));
		addressType.addAddressLine(addressLineType1);
		
		AddressLineType addressLineType2 = new AddressLineType();
		addressLineType2.setLine(new LineType("NA"));
		addressType.addAddressLine(addressLineType2);
		
		AddressLineType addressLineType3 = new AddressLineType();
		addressLineType3.setLine(new LineType("NA"));
		addressType.addAddressLine(addressLineType3);
		
		IdentificationCodeType identificationCodeType = new IdentificationCodeType("MYS");
		identificationCodeType.setListID("ISO3166-1");
		identificationCodeType.setListAgencyID("6");
		
		CountryType countryType = new CountryType();
		countryType.setIdentificationCode(identificationCodeType);
		addressType.setCountry(countryType);
		
		partyType.setPostalAddress(addressType);
		
		PartyLegalEntityType partyLegalEntityType = new PartyLegalEntityType();
		partyLegalEntityType.setRegistrationName("General Public");
		partyType.addPartyLegalEntity(partyLegalEntityType);
		
		ContactType contactType = new ContactType();
		contactType.setTelephone("NA");
		partyType.setContact(contactType);
		
		return partyType;
		
	}
	
