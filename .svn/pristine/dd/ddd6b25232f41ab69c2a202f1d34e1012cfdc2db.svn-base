	}
	
	public JSONObject submitCreditNote(InvoiceVO invoiceVO, CompanyVO companyVO) throws Exception, BusinessException, IOException, JSONException, NoSuchAlgorithmException {
		
//		InvoiceVO refInvVO = invoiceBO.getInvoiceByCode(invoiceVO.getCnInvNo());
//		EInvoiceDocumentVO refEInvoiceDocumentVO = eInvoiceBO.getEInvoiceByUUID(refInvVO.geteInvoiceDocumentUuid());
//		validateRefInv(invoiceVO.getCnInvNo(), refInvVO, refEInvoiceDocumentVO);
		validateRefInv(invoiceVO);
		InvoiceVO refInvVO = invoiceVO.getCnInv();
		EInvoiceDocumentVO refEInvoiceDocumentVO = refInvVO.geteInvoiceDocumentVO();
		
		InvoiceType creditNoteType = null;
		InvoiceType refundNoteType = null;
		
		if (invoiceVO.getAmtAftRefund().compareTo(0D) != 0) {
			creditNoteType = generateCreditNoteType(invoiceVO, companyVO, refInvVO);
		}
		
		if (invoiceVO.getRefundAmt().compareTo(0D) != 0) {
			refundNoteType = generateRefundNoteType(invoiceVO, companyVO, refInvVO);
		}
		
	    String accessToken = getAccessToken(companyVO, true);            	
	            
        if (isAfterEInvoice(refInvVO) && !refEInvoiceDocumentVO.getIsConsolEInv() && !EInvoiceUtils.validateTaxpayerTin(invoiceVO, accessToken)) {
        	throw new BusinessException(CommonErrConstant.ERR_TAXPAYER_TIN_VALIDATION_FAILED);
        }
		
		JSONObject eInvoiceDocuments = creditNoteType == null
				? generateEInvoiceDocuments(Arrays.asList(new InvoiceType[] { refundNoteType }))
				: (refundNoteType == null
						? generateEInvoiceDocuments(Arrays.asList(new InvoiceType[] { creditNoteType }))
						: generateEInvoiceDocuments(
								Arrays.asList(new InvoiceType[] { creditNoteType, refundNoteType })));
		
		return submitAPI(eInvoiceDocuments, accessToken);

	}
	
	public JSONObject submitCreditNotes(List<InvoiceVO> invList, CompanyVO companyVO) throws Exception, BusinessException, IOException, JSONException, NoSuchAlgorithmException {
		
		String accessToken = getAccessToken(companyVO, true);  
		
//		InvoiceType invoiceType = generateInvoiceType(invoiceVO, companyVO);
		List<InvoiceType> invoiceTypeList = new ArrayList<InvoiceType>();
		for (InvoiceVO vo : invList) {
			vo.setCreatedBy(StringUtils.isBlank(BaseContext.getUserFullName()) ? BaseContext.getLoginId() : BaseContext.getUserFullName());
			vo.setCreatedDate(new Date());
			vo.seteInvoiceDocument(new EInvoiceDocument());
			InvoiceVO invoiceVO = invoiceBO.getInvoiceById(vo.getId());
			invoiceVO = invoiceBO.getInvoiceDetails(invoiceVO);
			
	        try {
//				InvoiceVO refInvVO = invoiceBO.getInvoiceByCode(invoiceVO.getCnInvNo());
//				EInvoiceDocumentVO refEInvoiceDocumentVO = eInvoiceBO.getEInvoiceByUUID(refInvVO.geteInvoiceDocumentUuid());
//				validateRefInv(invoiceVO.getCnInvNo(), refInvVO, refEInvoiceDocumentVO);
	        	validateRefInv(invoiceVO);
				InvoiceVO refInvVO = invoiceVO.getCnInv();
				EInvoiceDocumentVO refEInvoiceDocumentVO = refInvVO.geteInvoiceDocumentVO();
//				validateRefInv(invoiceVO.getCnInvNo(), refInvVO, refEInvoiceDocumentVO);
				
	    		InvoiceType creditNoteType = null;
	    		InvoiceType refundNoteType = null;
	    		
	    		if (invoiceVO.getAmtAftRefund().compareTo(0D) != 0) {
	    			creditNoteType = generateCreditNoteType(invoiceVO, companyVO, refInvVO);
	    		}
	    		
	    		if (invoiceVO.getRefundAmt().compareTo(0D) != 0) {
	    			refundNoteType = generateRefundNoteType(invoiceVO, companyVO, refInvVO);
	    		}
	    		
	        	if (isAfterEInvoice(refInvVO) && !refEInvoiceDocumentVO.getIsConsolEInv() && !validateTaxpayerTin(invoiceVO, accessToken)) {
		        	throw new BusinessException(CommonErrConstant.ERR_TAXPAYER_TIN_VALIDATION_FAILED);
		        }
	        	
	        	if (creditNoteType != null)	invoiceTypeList.add(creditNoteType);
	        	if (refundNoteType != null)	invoiceTypeList.add(refundNoteType);
	        	
	        	if (creditNoteType != null)	vo.setInvoiceType(creditNoteType); // save generated e invoice info
	        	if (refundNoteType != null)	vo.setRnInvoiceType(refundNoteType); // save generated e invoice info
	        	vo.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);
			} catch (BusinessException b) {
				String errMsg = messageSource.getMessage(ErrorConstant.ERR_GENERAL_EXCEPTION, null, "System error", LocaleUtils.toLocale(BaseContext.getLocaleCode()));
				errMsg = messageSource.getMessage(b.getErrorCode(), b.getParameters(), errMsg, LocaleUtils.toLocale(BaseContext.getLocaleCode()));
				vo.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_INVALID);
				vo.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_INVALID);
				vo.geteInvoiceDocument().setDocumentStatusReason(errMsg);
//				System.out.println(b.getMessage());
//				System.out.println(b.getLocalizedMessage());
//				t.
			} catch (Throwable t) {
				
//				vo.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_INVALID);
//				vo.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_INVALID);
//				vo.geteInvoiceDocument().setDocumentStatusReason("Unknown error. Please contact IT.");
				for (InvoiceVO invVO : invList) {
					if(invVO.geteInvoiceDocument() == null)	vo.seteInvoiceDocument(new EInvoiceDocument());
					invVO.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_NOT_SUBMIT);
				}
				
				t.printStackTrace();
				throw t;
			}
			
//			System.out.println(vo.getCode());
		}
		
//		JSONObject eInvoiceDocuments = generateEInvoiceDocuments(byteArrayOutputStream, invPrefixVal + " " + invoiceVO.getCode());
		JSONObject eInvoiceDocuments = generateEInvoiceDocuments(invoiceTypeList);
		
		return submitAPI(eInvoiceDocuments, accessToken);
	}
	
	/**
	 * <pre>
	 * Process submission response after submit to E-Invoice API
	 * Single submission
	 * https://sdk.myinvois.hasil.gov.my/einvoicingapi/02-submit-documents/
	 * </pre>
	 * 
	 * @param submitResponse
	 * @param invoiceVO
	 * @throws JSONException
	 * @throws BusinessException
	 * @throws QueueException 
	 */
	public void processSubmitResponse(JSONObject submitResponse, InvoiceVO invoiceVO) throws JSONException, BusinessException, QueueException {
		
		checkResponseErr(submitResponse);
		
		String submissionUid = submitResponse.getString("submissionUid");
		JSONArray acceptedDocuments = submitResponse.getJSONArray("acceptedDocuments");
		JSONArray rejectedDocuments = submitResponse.getJSONArray("rejectedDocuments");

		InvoiceVO tempInvoiceVO = invoiceBO.getInvoiceById(invoiceVO.getId());
		if (StringUtils.isNotBlank(submissionUid)) {
			tempInvoiceVO.seteInvoiceSubmissionUid(submissionUid);
			invoiceVO.seteInvoiceSubmissionUid(submissionUid);
		}
		
        if (acceptedDocuments.length() > 0) {
        	String documentUuid = acceptedDocuments.getJSONObject(0).getString("uuid");
        	tempInvoiceVO.seteInvoiceDocumentUuid(documentUuid);
        	invoiceVO.seteInvoiceDocumentUuid(documentUuid);
        	
//        	if (respCode == 200) {
//        		invoiceVO.seteInvoiceStatus(CommonConstant.E_INV_STATUS_VALID);
//        		this.invoiceVO.seteInvoiceStatus(CommonConstant.E_INV_STATUS_VALID);
//        		
//        		eInvoiceVO.setStatusCode(CommonConstant.E_INV_STATUS_VALID);
//        		eInvoiceBO.insertInvoice(eInvoiceVO, invoiceVO, ProductConstant.E_INV_DOC_TYPE_INVOICE);
//        	} else if (respCode == 202) {
        	
        	// assume response code will only have 202 (submitted), won't valid on the spot
        	tempInvoiceVO.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);     
        	invoiceVO.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);
        		
        	if ("I".equals(invoiceVO.getDocTypeCd())) {
        		eInvoiceBO.insertSubmission(submissionUid, invoiceVO.getCompanyId(), 1);
        		insertInvoiceEInvoiceData(documentUuid, submissionUid, invoiceVO, EInvoiceConstant.E_INV_DOC_TYPE_INVOICE);
//        		EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.insertInvoice(documentUuid, submissionUid, CommonConstant.E_INV_STATUS_SUBMIT, invoiceVO, ProductConstant.E_INV_DOC_TYPE_INVOICE);
//        		eInvoiceBO.insertDocumentDetails(invoiceVO.getInvoiceType(), eInvoiceDocumentVO);
//        		invoiceBO.insertInvoiceHistory(invoiceVO.getId(), CommonConstant.ACTION_CD_UPD, "Submit E-Invoice");
        	} else if ("C".equals(invoiceVO.getDocTypeCd())) {
        		eInvoiceBO.insertSubmission(submissionUid, invoiceVO.getCompanyId(), 1);
        		insertInvoiceEInvoiceData(documentUuid, submissionUid, invoiceVO, EInvoiceConstant.E_INV_DOC_TYPE_CREDIT_NOTE);
//        		EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.insertInvoice(documentUuid, submissionUid, CommonConstant.E_INV_STATUS_SUBMIT, invoiceVO, ProductConstant.E_INV_DOC_TYPE_CREDIT_NOTE);
//        		eInvoiceBO.insertDocumentDetails(invoiceVO.getInvoiceType(), eInvoiceDocumentVO);
//        		invoiceBO.insertInvoiceHistory(invoiceVO.getId(), CommonConstant.ACTION_CD_UPD, "Submit E-Invoice");
        	}
        	
        	// suppose shouldn't have pax stmt, but this is for testing
        	else if ("P".equals(invoiceVO.getDocTypeCd())) {
        		eInvoiceBO.insertSubmission(submissionUid, invoiceVO.getCompanyId(), 1);
        		eInvoiceBO.insertInvoice(documentUuid, submissionUid, EInvoiceConstant.E_INV_STATUS_SUBMIT, invoiceVO, EInvoiceConstant.E_INV_DOC_TYPE_INVOICE);
        	}
        		
//        		eInvoiceDocumentVO.setStatusCode(CommonConstant.E_INV_STATUS_SUBMIT);
//        		eInvoiceBO.insertInvoice(eInvoiceDocumentVO, invoiceVO, ProductConstant.E_INV_DOC_TYPE_INVOICE);
//        	} else {
//        		// TODO: any other respCode?
//        		invoiceVO.seteInvoiceStatus(CommonConstant.E_INV_STATUS_SUBMIT);   
//        		this.invoiceVO.seteInvoiceStatus(CommonConstant.E_INV_STATUS_SUBMIT);
//        		
//        		eInvoiceVO.setStatusCode(CommonConstant.E_INV_STATUS_SUBMIT);
//        		eInvoiceBO.insertInvoice(eInvoiceVO, invoiceVO, ProductConstant.E_INV_DOC_TYPE_INVOICE);
//        	}
        	
        	chartOfAcctBO.updateVO(tempInvoiceVO);
        	invoiceBO.insertInvoiceHistory(tempInvoiceVO.getId(), CommonConstant.ACTION_CD_UPD, "Submit E-Invoice");
        } else {
        	if (rejectedDocuments.length() > 0) {
        		for (int k = 0; k < rejectedDocuments.length(); k++) {
        			JSONObject err = rejectedDocuments.getJSONObject(k).getJSONObject("error");
                	JSONArray details = err.getJSONArray("details");
                	
                	for (int j = 0; j < details.length(); j++) {
                        JSONObject innerErr = details.getJSONObject(j);
        				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {innerErr.getString("message")});
                    }
        		}
        		
        	}
        	throw new BusinessException(CommonErrConstant.ERR_E_INVOICE_API_SUBMISSION_FAILED);
        }
	}
	
	/**
	 * <pre>
	 * Process submission response after submit to E-Invoice API
	 * Single submission
	 * https://sdk.myinvois.hasil.gov.my/einvoicingapi/02-submit-documents/
	 * </pre>
	 * 
	 * @param submitResponse
	 * @param invoiceVO
	 * @throws JSONException
	 * @throws BusinessException
	 */
	public void processCreditNoteSubmitResponse(JSONObject submitResponse, InvoiceVO invoiceVO) throws JSONException, BusinessException {
		
		checkResponseErr(submitResponse);
		
		String cnPrefixVal = LookupItemUtils.getSysNumGenVO(invoiceVO.getCompanyId(), CommonConstant.SYS_NUM_CD_CRDT_NOTE).getPrefixid();
		String rnPrefixVal = LookupItemUtils.getSysNumGenVO(invoiceVO.getCompanyId(), CommonConstant.SYS_NUM_CD_RFND_NOTE).getPrefixid();

		String submissionUid = submitResponse.getString("submissionUid");
		JSONArray acceptedDocuments = submitResponse.getJSONArray("acceptedDocuments");
		JSONArray rejectedDocuments = submitResponse.getJSONArray("rejectedDocuments");
		
		eInvoiceBO.insertSubmission(submissionUid, invoiceVO.getCompanyId(), acceptedDocuments.length());

		InvoiceVO tempInvoiceVO = invoiceBO.getInvoiceById(invoiceVO.getId());
		
		for (int j = 0; j < acceptedDocuments.length(); j++) {
			String documentUuid = acceptedDocuments.getJSONObject(j).getString("uuid");
			String invoiceCodeNumber = acceptedDocuments.getJSONObject(j).getString("invoiceCodeNumber");
			
			if (invoiceCodeNumber.substring(0, 2).equals(cnPrefixVal)) { // == "CN"
				
				// set submission id
				tempInvoiceVO.seteInvoiceSubmissionUid(submissionUid);
				invoiceVO.seteInvoiceSubmissionUid(submissionUid);
				
				// set doc id
				tempInvoiceVO.seteInvoiceDocumentUuid(documentUuid);
	        	invoiceVO.seteInvoiceDocumentUuid(documentUuid);
	        	
	        	// assume response code will only have 202 (submitted), won't valid on the spot
	        	tempInvoiceVO.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);     
	        	invoiceVO.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);
	        	
//	        	EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.insertDocument(documentUuid, submissionUid, EInvoiceConstant.E_INV_STATUS_SUBMIT,
//						invoiceVO.getId(), invoiceVO.getCode(), CommonConstant.SYS_NUM_CD_CRDT_NOTE,
//						ProductConstant.E_INV_DOC_TYPE_CREDIT_NOTE, invoiceVO.getCompanyId(), 2, false);
	        	EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.insertCreditNote(documentUuid, submissionUid, EInvoiceConstant.E_INV_STATUS_SUBMIT, invoiceVO, 2);
	        	eInvoiceBO.insertDocumentDetails(invoiceVO.getInvoiceType(), eInvoiceDocumentVO);
//        		eInvoiceBO.insertInvoice(documentUuid, submissionUid, CommonConstant.E_INV_STATUS_SUBMIT, invoiceVO, ProductConstant.E_INV_DOC_TYPE_CREDIT_NOTE);
	        	
			} else if (invoiceCodeNumber.substring(0, 2).equals(rnPrefixVal)) { // == "RN"
				
				// set submission id
				tempInvoiceVO.seteInvoiceRnSubmissionUid(submissionUid);
				invoiceVO.seteInvoiceRnSubmissionUid(submissionUid);
				
				// set doc id
				tempInvoiceVO.seteInvoiceRnDocumentUuid(documentUuid);
	        	invoiceVO.seteInvoiceRnDocumentUuid(documentUuid);
	        	
	        	// assume response code will only have 202 (submitted), won't valid on the spot
	        	tempInvoiceVO.seteInvoiceRnStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);     
	        	invoiceVO.seteInvoiceRnStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);
				
//	        	EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.insertDocument(documentUuid, submissionUid, EInvoiceConstant.E_INV_STATUS_SUBMIT,
//						invoiceVO.getId(), invoiceVO.getRnNo(), CommonConstant.SYS_NUM_CD_RFND_NOTE,
//						ProductConstant.E_INV_DOC_TYPE_REFUND_NOTE, invoiceVO.getCompanyId(), 2, false);
	        	EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.insertRefundNote(documentUuid, submissionUid, EInvoiceConstant.E_INV_STATUS_SUBMIT, invoiceVO, 2);
				eInvoiceBO.insertDocumentDetails(invoiceVO.getRnInvoiceType(), eInvoiceDocumentVO);
			} else {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {"Unknown error occured."});
			}
			
			chartOfAcctBO.updateVO(tempInvoiceVO);
		}
		
    	if (rejectedDocuments.length() > 0) {
    		for (int k = 0; k < rejectedDocuments.length(); k++) {
    			JSONObject err = rejectedDocuments.getJSONObject(k).getJSONObject("error");
            	JSONArray details = err.getJSONArray("details");
            	
            	for (int j = 0; j < details.length(); j++) {
                    JSONObject innerErr = details.getJSONObject(j);
    				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {innerErr.getString("message")});
                }
    		}
    		
    		throw new BusinessException(CommonErrConstant.ERR_E_INVOICE_API_SUBMISSION_FAILED);
    	}
	}
	
	/**
	 * <pre>
	 * Process submission response after submit to E-Invoice API
	 * Single submission
	 * https://sdk.myinvois.hasil.gov.my/einvoicingapi/02-submit-documents/
	 * </pre>
	 * 
	 * @param submitResponse
	 * @param invoiceVO
	 * @throws JSONException
	 * @throws BusinessException
	 */
	public void processSubmitResponse(JSONObject submitResponse, ExOrderBillVO exOrderBillVO) throws JSONException, BusinessException {
		
		checkResponseErr(submitResponse);
		
		String submissionUid = submitResponse.getString("submissionUid");
		JSONArray acceptedDocuments = submitResponse.getJSONArray("acceptedDocuments");
		JSONArray rejectedDocuments = submitResponse.getJSONArray("rejectedDocuments");

		ExOrderBillVO tempExOrderBillVO = billPymtBO.getEOBillById(exOrderBillVO.getId());
        tempExOrderBillVO.seteInvoiceSubmissionUid(submissionUid);
        exOrderBillVO.seteInvoiceSubmissionUid(submissionUid);
        
        if (acceptedDocuments.length() > 0) {
        	String uuid = acceptedDocuments.getJSONObject(0).getString("uuid");
        	tempExOrderBillVO.seteInvoiceDocumentUuid(uuid);
        	exOrderBillVO.seteInvoiceDocumentUuid(uuid);
        	
        	// assume response code will only have 202 (submitted), won't valid on the spot
        	tempExOrderBillVO.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);     
        	exOrderBillVO.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);
        	
        	eInvoiceBO.insertSubmission(submissionUid, exOrderBillVO.getCompanyId(), 1);
        	EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.insertExOrderBill(uuid, submissionUid, EInvoiceConstant.E_INV_STATUS_SUBMIT, tempExOrderBillVO, EInvoiceConstant.E_INV_DOC_TYPE_SELF_BILLED_INVOICE);
        	eInvoiceBO.insertDocumentDetails(exOrderBillVO.getInvoiceType(), eInvoiceDocumentVO);
        	chartOfAcctBO.updateVO(exOrderBillVO);
        } else {
        	if (rejectedDocuments.length() > 0) {
        		for (int k = 0; k < rejectedDocuments.length(); k++) {
        			JSONObject err = rejectedDocuments.getJSONObject(k).getJSONObject("error");
                	JSONArray details = err.getJSONArray("details");
                	
                	for (int j = 0; j < details.length(); j++) {
                        JSONObject innerErr = details.getJSONObject(j);
        				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {innerErr.getString("message")});
                    }
        		}
        		
        	}
        	throw new BusinessException(CommonErrConstant.ERR_E_INVOICE_API_SUBMISSION_FAILED);
        }
	}
	
