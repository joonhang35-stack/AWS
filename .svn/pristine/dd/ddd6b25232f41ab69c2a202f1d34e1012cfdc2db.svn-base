	/**
	 * <pre>
	 * Process submission response after submit to E-Invoice API
	 * Multiple submission
	 * https://sdk.myinvois.hasil.gov.my/einvoicingapi/02-submit-documents/
	 * </pre>
	 * 
	 * @param submitResponse
	 * @param invoiceVO
	 * @throws JSONException
	 * @throws BusinessException
	 * @throws QueueException 
	 */
	public List<InvoiceVO> processSubmitResponseInvoices(JSONObject submitResponse, List<InvoiceVO> invoiceList, Long idCompany) throws JSONException, BusinessException, QueueException {
		
		// credit note will use another function
		String prefixVal = LookupItemUtils.getSysNumGenVO(idCompany, CommonConstant.SYS_NUM_CD_INVC).getPrefixid();

		checkResponseErr(submitResponse);
		
		String submissionUid = submitResponse.getString("submissionUid");
		JSONArray acceptedDocuments = submitResponse.getJSONArray("acceptedDocuments");
		JSONArray rejectedDocuments = submitResponse.getJSONArray("rejectedDocuments");
		
		eInvoiceBO.insertSubmission(submissionUid, idCompany, acceptedDocuments.length());
		
		for (int j = 0; j < acceptedDocuments.length(); j++) {
			String documentUuid = acceptedDocuments.getJSONObject(j).getString("uuid");
			String invoiceCodeNumber = acceptedDocuments.getJSONObject(j).getString("invoiceCodeNumber");
			
			boolean found = false;
			for (InvoiceVO invoiceVO : invoiceList) {
				if (invoiceCodeNumber.equals(prefixVal + " " + invoiceVO.getCode())) {
					found = true;
					
					InvoiceVO tempInvoiceVO = invoiceBO.getInvoiceById(invoiceVO.getId());
					tempInvoiceVO.seteInvoiceSubmissionUid(submissionUid);
					tempInvoiceVO.seteInvoiceDocumentUuid(documentUuid);
					tempInvoiceVO.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT); 
					invoiceVO.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);
					
	        		EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.insertInvoice(documentUuid, submissionUid, EInvoiceConstant.E_INV_STATUS_SUBMIT, tempInvoiceVO, EInvoiceConstant.E_INV_DOC_TYPE_INVOICE);
	        		eInvoiceBO.insertDocumentDetails(invoiceVO.getInvoiceType(), eInvoiceDocumentVO);
	        		
	        		chartOfAcctBO.updateVO(tempInvoiceVO);
	        		// insert history after submitting multiple E-Invoice
	        		invoiceBO.insertInvoiceHistory(tempInvoiceVO.getId(), CommonConstant.ACTION_CD_UPD, "Submit E-Invoice");
	        		
	        		break;
				}
			}
			
			if (!found) {
				// TODO : deal with response invoice not found
//        		eInvoiceBO.insertInvoice(documentUuid, submissionUid, CommonConstant.E_INV_STATUS_SUBMIT, null, ProductConstant.E_INV_DOC_TYPE_INVOICE);
			}
		}
		
    	if (rejectedDocuments.length() > 0) {
    		for (int k = 0; k < rejectedDocuments.length(); k++) {
    			String invoiceCodeNumber = rejectedDocuments.getJSONObject(k).getString("invoiceCodeNumber");
    			JSONObject err = rejectedDocuments.getJSONObject(k).getJSONObject("error");
            	JSONArray details = err.getJSONArray("details");
            	String reason = "";
            	
            	for (int j = 0; j < details.length(); j++) {
                    JSONObject innerErr = details.getJSONObject(j);
                    reason += innerErr.getString("message") + "\n";
//    				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {innerErr.getString("message")});
                }
            	
            	boolean found = false;
            	for (InvoiceVO invoiceVO : invoiceList) {
    				if (invoiceCodeNumber.equals(prefixVal + " " + invoiceVO.getCode())) {
    					found = true;
    					
//    					invoiceVO.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_INVALID);
    					invoiceVO.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_REJECTED);
    					invoiceVO.geteInvoiceDocument().setDocumentStatusReason(reason);
    				}
    			}
    			
    			if (!found) {
    				// TODO : deal with response invoice not found
//            		eInvoiceBO.insertInvoice(documentUuid, submissionUid, CommonConstant.E_INV_STATUS_SUBMIT, null, ProductConstant.E_INV_DOC_TYPE_INVOICE);
    			}
    		}
    		
    	}
    	
    	return invoiceList;
	}
	
	public List<InvoiceVO> processSubmitResponseCNs(JSONObject submitResponse, List<InvoiceVO> invoiceList, Long idCompany) throws JSONException, BusinessException {
		
		// credit note will use another function
		String cnPrefixVal = LookupItemUtils.getSysNumGenVO(idCompany, CommonConstant.SYS_NUM_CD_CRDT_NOTE).getPrefixid();
		String rnPrefixVal = LookupItemUtils.getSysNumGenVO(idCompany, CommonConstant.SYS_NUM_CD_RFND_NOTE).getPrefixid();

		checkResponseErr(submitResponse);
		
		String submissionUid = submitResponse.getString("submissionUid");
		JSONArray acceptedDocuments = submitResponse.getJSONArray("acceptedDocuments");
		JSONArray rejectedDocuments = submitResponse.getJSONArray("rejectedDocuments");
		
		eInvoiceBO.insertSubmission(submissionUid, idCompany, acceptedDocuments.length());
		
		for (int j = 0; j < acceptedDocuments.length(); j++) {
			String documentUuid = acceptedDocuments.getJSONObject(j).getString("uuid");
			String invoiceCodeNumber = acceptedDocuments.getJSONObject(j).getString("invoiceCodeNumber");
			
			boolean found = false;
			for (InvoiceVO invoiceVO : invoiceList) {
				
				// TODO CN & RN
				
				// to be enhanced on processCreditNoteSubmitResponse
				// read prefix value, code and docTypeCd into tempVO according to type (CN/RN)
				InvoiceVO tempVO = generatePrefixAndCode(invoiceCodeNumber, cnPrefixVal, rnPrefixVal, invoiceVO);
				
				if (invoiceCodeNumber.equals(tempVO.getPrefix() + " " + tempVO.getCode())) {
					found = true;
					
					InvoiceVO tempInvoiceVO = invoiceBO.getInvoiceById(invoiceVO.getId());
					setSuccessCNRNEInv(tempInvoiceVO, tempVO.getDocTypeCd(), submissionUid, documentUuid, invoiceVO);
					
//		        	EInvoiceDocumentVO eInvoiceDocumentVO =  eInvoiceBO.insertDocument(documentUuid, submissionUid, EInvoiceConstant.E_INV_STATUS_SUBMIT,
//							invoiceVO.getId(), tempVO.getCode(), tempVO.getDocTypeCd(),
//							tempVO.geteInvoiceDocumentVO().geteInvoiceDocType(), idCompany,
//							acceptedDocuments.length(), false);
		        	
		        	if (tempVO.getDocTypeCd().equals(CommonConstant.SYS_NUM_CD_CRDT_NOTE)) {
		        		EInvoiceDocumentVO eInvoiceDocumentVO =  eInvoiceBO.insertCreditNote(documentUuid, submissionUid, EInvoiceConstant.E_INV_STATUS_SUBMIT, tempInvoiceVO, acceptedDocuments.length());
		        		eInvoiceBO.insertDocumentDetails(invoiceVO.getInvoiceType(), eInvoiceDocumentVO);
		        	} else {
		        		EInvoiceDocumentVO eInvoiceDocumentVO =  eInvoiceBO.insertRefundNote(documentUuid, submissionUid, EInvoiceConstant.E_INV_STATUS_SUBMIT, tempInvoiceVO, acceptedDocuments.length());
		        		eInvoiceBO.insertDocumentDetails(invoiceVO.getRnInvoiceType(), eInvoiceDocumentVO);
		        	}
		        	
				
	        		chartOfAcctBO.updateVO(tempInvoiceVO);
	        		
	        		break;
				}
				
			}
			
			if (!found) {
				// TODO : deal with response invoice not found
//        		eInvoiceBO.insertInvoice(documentUuid, submissionUid, CommonConstant.E_INV_STATUS_SUBMIT, null, ProductConstant.E_INV_DOC_TYPE_INVOICE);
			}
		}
		
    	if (rejectedDocuments.length() > 0) {
    		for (int k = 0; k < rejectedDocuments.length(); k++) {
    			String invoiceCodeNumber = rejectedDocuments.getJSONObject(k).getString("invoiceCodeNumber");
    			JSONObject err = rejectedDocuments.getJSONObject(k).getJSONObject("error");
            	JSONArray details = err.getJSONArray("details");
            	String reason = "";
            	
            	for (int j = 0; j < details.length(); j++) {
                    JSONObject innerErr = details.getJSONObject(j);
                    reason += innerErr.getString("message") + "\n";
//    				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {innerErr.getString("message")});
                }
            	
            	boolean found = false;
            	for (InvoiceVO invoiceVO : invoiceList) {
            		// to be enhanced on processCreditNoteSubmitResponse
    				// read prefix value, code and docTypeCd into tempVO according to type (CN/RN)
    				InvoiceVO tempVO = generatePrefixAndCode(invoiceCodeNumber, cnPrefixVal, rnPrefixVal, invoiceVO);
    				
    				if (invoiceCodeNumber.equals(tempVO.getPrefix() + " " + tempVO.getCode())) {
    					found = true;
    					setRejectedCNRNEInv(invoiceVO, tempVO.getDocTypeCd(), reason);
    				}
    			}
    			
    			if (!found) {
    				// TODO : deal with response invoice not found
//            		eInvoiceBO.insertInvoice(documentUuid, submissionUid, CommonConstant.E_INV_STATUS_SUBMIT, null, ProductConstant.E_INV_DOC_TYPE_INVOICE);
    			}
    		}
    		
    	}
    	
    	return invoiceList;
	}
	
	/**
	 * <pre>
	 * Process submission response after submit to E-Invoice API
	 * Multiple submission
	 * https://sdk.myinvois.hasil.gov.my/einvoicingapi/02-submit-documents/
	 * </pre>
	 * 
	 * @param submitResponse
	 * @param billList
	 * @throws JSONException
	 * @throws BusinessException
	 */
	public List<ExOrderBillVO> processSubmitResponseSelfBilledInvoices(JSONObject submitResponse, List<ExOrderBillVO> billList, Long idCompany) throws JSONException, BusinessException {
		
		// credit note will use another function
		String prefixVal = LookupItemUtils.getSysNumGenVO(idCompany, CommonConstant.SYS_NUM_CD_PURC_BILL).getPrefixid();

		checkResponseErr(submitResponse);
		
		String submissionUid = submitResponse.getString("submissionUid");
		JSONArray acceptedDocuments = submitResponse.getJSONArray("acceptedDocuments");
		JSONArray rejectedDocuments = submitResponse.getJSONArray("rejectedDocuments");
		
		eInvoiceBO.insertSubmission(submissionUid, idCompany, acceptedDocuments.length());
		
		for (int j = 0; j < acceptedDocuments.length(); j++) {
			String documentUuid = acceptedDocuments.getJSONObject(j).getString("uuid");
			String invoiceCodeNumber = acceptedDocuments.getJSONObject(j).getString("invoiceCodeNumber");
			
			boolean found = false;
			for (ExOrderBillVO billVO : billList) {
				if (invoiceCodeNumber.equals(prefixVal + " " + billVO.getCode())) {
					found = true;
					
					ExOrderBillVO tempBillVO = billPymtBO.getEOBillById(billVO.getId());
					tempBillVO.seteInvoiceSubmissionUid(submissionUid);
					tempBillVO.seteInvoiceDocumentUuid(documentUuid);
					tempBillVO.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT); 
					billVO.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);
					
	        		EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.insertExOrderBill(documentUuid, submissionUid, EInvoiceConstant.E_INV_STATUS_SUBMIT, tempBillVO, EInvoiceConstant.E_INV_DOC_TYPE_SELF_BILLED_INVOICE);
	        		eInvoiceBO.insertDocumentDetails(billVO.getInvoiceType(), eInvoiceDocumentVO);
	        		
	        		chartOfAcctBO.updateVO(tempBillVO);
	        		
	        		break;
				}
			}
			
			if (!found) {
				// TODO : deal with response invoice not found
//        		eInvoiceBO.insertInvoice(documentUuid, submissionUid, CommonConstant.E_INV_STATUS_SUBMIT, null, ProductConstant.E_INV_DOC_TYPE_INVOICE);
			}
		}
		
    	if (rejectedDocuments.length() > 0) {
    		for (int k = 0; k < rejectedDocuments.length(); k++) {
    			String invoiceCodeNumber = rejectedDocuments.getJSONObject(k).getString("invoiceCodeNumber");
    			JSONObject err = rejectedDocuments.getJSONObject(k).getJSONObject("error");
            	JSONArray details = err.getJSONArray("details");
            	String reason = "";
            	
            	for (int j = 0; j < details.length(); j++) {
                    JSONObject innerErr = details.getJSONObject(j);
                    reason += innerErr.getString("message") + "\n";
//    				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {innerErr.getString("message")});
                }
            	
            	boolean found = false;
            	for (ExOrderBillVO billVO : billList) {
    				if (invoiceCodeNumber.equals(prefixVal + " " + billVO.getCode())) {
    					found = true;
    					
    					billVO.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_INVALID);
    					billVO.geteInvoiceDocument().setDocumentStatusReason(reason);
    				}
    			}
    			
    			if (!found) {
    				// TODO : deal with response invoice not found
//            		eInvoiceBO.insertInvoice(documentUuid, submissionUid, CommonConstant.E_INV_STATUS_SUBMIT, null, ProductConstant.E_INV_DOC_TYPE_INVOICE);
    			}
    		}
    		
    	}
    	
    	return billList;
	}
	
