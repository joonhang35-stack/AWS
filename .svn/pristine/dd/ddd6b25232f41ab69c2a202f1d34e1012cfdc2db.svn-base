	static TrustManager[] trustAllCerts = new TrustManager[] {
			new X509TrustManager() {
				public java.security.cert.X509Certificate[] getAcceptedIssuers() {
					return null;
				}

				public void checkClientTrusted(
						java.security.cert.X509Certificate[] certs, String authType) {}

				public void checkServerTrusted(
						java.security.cert.X509Certificate[] certs, String authType) {}
			}
	};
	
	private static SSLContext getSslContext() throws NoSuchAlgorithmException, KeyManagementException {
		SSLContext sc = SSLContext.getInstance("TLSv1.2");
		sc.init(null, trustAllCerts, new java.security.SecureRandom());
		return sc;
	}
	
	private static HttpsURLConnection openHttpsURLConnection(URL url, String requestMethod, String accessToken) throws IOException, KeyManagementException, NoSuchAlgorithmException {
        return openHttpsURLConnection(url, requestMethod, accessToken, "");
	}
	
	private static HttpsURLConnection openHttpsURLConnection(URL url, String requestMethod, String accessToken, JSONObject requestBody) throws IOException, KeyManagementException, NoSuchAlgorithmException {
        return openHttpsURLConnection(url, requestMethod, accessToken, requestBody.toString());
	}
	
	private static HttpsURLConnection openHttpsURLConnection(URL url, String requestMethod, String accessToken, String requestBody) throws IOException, KeyManagementException, NoSuchAlgorithmException {
		// open connection
        HttpsURLConnection connection = (HttpsURLConnection) url.openConnection();
        connection.setSSLSocketFactory(getSslContext().getSocketFactory());
        connection.setRequestMethod(requestMethod);
        
        // set headers
        connection.setRequestProperty("Accept", "application/json");
        connection.setRequestProperty("Accept-Language", "en");
        connection.setRequestProperty("Content-Type", "application/json");
        connection.setRequestProperty("Authorization", "Bearer " + accessToken);
        
        // java.net.ProtocolException: cannot write to a URLConnection if doOutput=false - call setDoOutput(true)
        connection.setDoOutput(true);
        
        // set request body
		if (StringUtils.isNotBlank(requestBody)) {
			try (OutputStream os = connection.getOutputStream()) {
				byte[] input = requestBody.getBytes("utf-8");
				os.write(input, 0, input.length);
			}
		}
        
        return connection;
	}
	
	public static HttpsURLConnection openAuthAccessTokenHttpsURLConnection(URL url, String requestMethod, boolean isOnBehalf, CompanyVO companyVO)
			throws IOException, KeyManagementException, NoSuchAlgorithmException, BusinessException {
		HttpsURLConnection connection = (HttpsURLConnection) url.openConnection();
		connection.setSSLSocketFactory(getSslContext().getSocketFactory());
		connection.setRequestMethod("POST");
		connection.setRequestProperty("Content-Type", "application/x-www-form-urlencoded");
		if (isOnBehalf)	connection.setRequestProperty("onbehalfof", companyVO.getTaxIdNo());
		connection.setDoOutput(true);

		// set request body client_id, client_secret, grant_type, scope
		try (OutputStream os = connection.getOutputStream()) {
			byte[] input = getLoginRequestBody(companyVO).getBytes("utf-8");
			os.write(input, 0, input.length);
		}

		return connection;
	}
	
	private static String getLoginRequestBody(CompanyVO companyVO) throws BusinessException {
		String client_id = companyVO.getMyInvoisClientId();
        String client_secret = companyVO.getMyInvoisClientSecret();
//        String client_secret = "";
//        if (isClientSecret1) {
//        	client_secret = companyVO.getMyInvoisClientSecret1();
//        } else if (isClientSecret2) {
//        	client_secret = companyVO.getMyInvoisClientSecret2();
//        }
        String grant_type = "client_credentials";
        String scope = "InvoicingAPI";
        
//        System.out.println("CYY client_id: " + client_id);
//        System.out.println("CYY client_secret: " + client_secret);
        
        String requestBody = String.format(
            "client_id=%s&client_secret=%s&grant_type=%s&scope=%s",
            client_id, client_secret, grant_type, scope
        );
        
        return requestBody;
	}
	
	public static String getConnectionResponse(int status, HttpsURLConnection connection) throws UnsupportedEncodingException, IOException {
		BufferedReader reader = new BufferedReader(new InputStreamReader(
				status > 299 ? connection.getErrorStream() : connection.getInputStream(), "utf-8"));
		StringBuilder response = new StringBuilder();
		String line;
		while ((line = reader.readLine()) != null) {
			response.append(line.trim());
		}
		reader.close();
		
		return response.toString();
	}
	
	public static EInvoiceAccessTokenVO generateEInvoiceAccessTokenVO(Long idCompany, JSONObject jsonResponse) throws JSONException {
		EInvoiceAccessTokenVO eInvoiceAccessTokenVO = new EInvoiceAccessTokenVO();
        eInvoiceAccessTokenVO.setIdCompany(idCompany);
        eInvoiceAccessTokenVO.setAccessToken(jsonResponse.getString("access_token"));
        eInvoiceAccessTokenVO.setExpiresIn(jsonResponse.getInt("expires_in"));
        eInvoiceAccessTokenVO.setScope(jsonResponse.getString("scope"));
        eInvoiceAccessTokenVO.setTokenType(jsonResponse.getString("token_type"));
        if (eInvoiceAccessTokenVO.getExpiresIn() != null) {
	        Calendar calendar = Calendar.getInstance();
	        calendar.setTime(new Date());
	        calendar.add(Calendar.SECOND, eInvoiceAccessTokenVO.getExpiresIn());
	        eInvoiceAccessTokenVO.setDateValid(calendar.getTime());
        } else {
        	 eInvoiceAccessTokenVO.setDateValid(new Date());
        }
        return eInvoiceAccessTokenVO;
	}
	
	public static void validateMyInvoisCredentials(CompanyVO companyVO) throws BusinessException {
		boolean isClientID = !StringUtils.isBlank(companyVO.getMyInvoisClientId());
		boolean isClientSecret1 = !StringUtils.isBlank(companyVO.getMyInvoisClientSecret1());
		boolean isClientSecret2 = !StringUtils.isBlank(companyVO.getMyInvoisClientSecret2());
		boolean isTIN = !StringUtils.isBlank(companyVO.getTaxIdNo());
		
		if (!isTIN) throw new BusinessException(CommonErrConstant.ERR_COMPANY_NO_TIN);
		if (!isClientID) {
			throw new BusinessException(CommonErrConstant.ERR_E_INVOICE_API_NO_CLIENT_ID);
		}
		if (!(isClientSecret1 || isClientSecret2)) {
			throw new BusinessException(CommonErrConstant.ERR_E_INVOICE_API_NO_CLIENT_SECRET);
		}
	}
	
	/**
	 * <pre>
	 * generate prefix and code from document returned from E-Invoice API after submitting credit note
	 * prefixVal - .getPrefix()
	 * code - .getCode()
	 * docTypeCd - .getDocTypeCd()
	 * </pre>
	 * 
	 * @param invoiceCodeNumber - invoiceCodeNumber returned from E-Invoice API
	 * @param cnPrefixVal - credit note prefix value
	 * @param rnPrefixVal - return note prefix value
	 * @param invoiceVO
	 * @return
	 * @throws BusinessException
	 */
	private static InvoiceVO generatePrefixAndCode(String invoiceCodeNumber, String cnPrefixVal, String rnPrefixVal, InvoiceVO invoiceVO) throws BusinessException {
		InvoiceVO rtnVO = new InvoiceVO();
		rtnVO.seteInvoiceDocumentVO(new EInvoiceDocumentVO());
		System.out.println("CYY cnPrefixVal: " + cnPrefixVal);
		System.out.println("CYY rnPrefixVal: " + rnPrefixVal);
		System.out.println("CYY generatePrefixAndCode: " + invoiceCodeNumber + ", " + invoiceVO.getCode() + ", " + invoiceVO.getRnNo());
		if (invoiceCodeNumber.substring(0, 2).equals(cnPrefixVal)) { // == "CN"
			rtnVO.setPrefix(cnPrefixVal);
			rtnVO.setCode(invoiceVO.getCode());
			rtnVO.setDocTypeCd(CommonConstant.SYS_NUM_CD_CRDT_NOTE);
			rtnVO.geteInvoiceDocumentVO().seteInvoiceDocType(EInvoiceConstant.E_INV_DOC_TYPE_CREDIT_NOTE);
		} else if (invoiceCodeNumber.substring(0, 2).equals(rnPrefixVal)) { // == "RN"
			rtnVO.setPrefix(rnPrefixVal);
			rtnVO.setCode(invoiceVO.getRnNo());
			rtnVO.setDocTypeCd(CommonConstant.SYS_NUM_CD_RFND_NOTE);
			rtnVO.geteInvoiceDocumentVO().seteInvoiceDocType(EInvoiceConstant.E_INV_DOC_TYPE_REFUND_NOTE);
		}
		checkInfoProcessed(rtnVO.getPrefix(), rtnVO.getCode(), rtnVO.getDocTypeCd(), rtnVO.geteInvoiceDocumentVO().geteInvoiceDocType());
		return rtnVO;
	}
	
	/**
	 * check if either prefix/code/docTypeCd/eInvoiceDocType generated from generatePrefixAndCode is blank
	 * 
	 * @param prefixVal
	 * @param code
	 * @throws BusinessException
	 */
	private static void checkInfoProcessed(String prefixVal, String code, String docTypeCd, String eInvoiceDocType) throws BusinessException {
		if (StringUtils.isBlank(prefixVal)) {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Unable to determine document prefix value (CN/RN)."));
//		} else if (StringUtils.isBlank(code)) {
//			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Unable to determine the document code in use (CN/RN)."));
		} else if (StringUtils.isBlank(docTypeCd)) {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Unable to determine the document type in use (CN/RN)."));
		} else if (StringUtils.isBlank(eInvoiceDocType)) {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Unable to determine the E-Invoice document type in use (CN/RN)."));
		}
	}
	
	/**
	 * @param tempInvoiceVO - temporary variable to be updated to database
	 * @param docTypeCd
	 * @param submissionUid
	 * @param documentUuid
	 * @param invoiceVO - surface variable to present info to user
	 * @throws BusinessException
	 */
	private static void setSuccessCNRNEInv(InvoiceVO tempInvoiceVO, String docTypeCd, String submissionUid, String documentUuid, InvoiceVO invoiceVO) throws BusinessException {
		if (docTypeCd.equals(CommonConstant.SYS_NUM_CD_CRDT_NOTE)) {
			tempInvoiceVO.seteInvoiceSubmissionUid(submissionUid);
			tempInvoiceVO.seteInvoiceDocumentUuid(documentUuid);
			tempInvoiceVO.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT); 
			invoiceVO.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);
		} else if (docTypeCd.equals(CommonConstant.SYS_NUM_CD_RFND_NOTE)) {
			tempInvoiceVO.seteInvoiceRnSubmissionUid(submissionUid);
			tempInvoiceVO.seteInvoiceRnDocumentUuid(documentUuid);
			tempInvoiceVO.seteInvoiceRnStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT); 
			invoiceVO.seteInvoiceRnStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);
		} else {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("EInvoiceUtils.setSuccessCNRNEInv docTypeCd is blank."));
		}
	}
	
	private static void setRejectedCNRNEInv(InvoiceVO invoiceVO, String docTypeCd, String reason) throws BusinessException {
		if (docTypeCd.equals(CommonConstant.SYS_NUM_CD_CRDT_NOTE)) {
			if (invoiceVO.geteInvoiceDocument() == null)	invoiceVO.seteInvoiceDocument(new EInvoiceDocument());
			invoiceVO.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_INVALID);
			invoiceVO.geteInvoiceDocument().setDocumentStatusReason(reason);
		} else if (docTypeCd.equals(CommonConstant.SYS_NUM_CD_RFND_NOTE)) {
			if (invoiceVO.geteInvoiceRnDocument() == null)	invoiceVO.seteInvoiceRnDocument(new EInvoiceDocument());
			invoiceVO.geteInvoiceRnDocument().setStatus(EInvoiceConstant.E_INV_STATUS_INVALID);
			invoiceVO.geteInvoiceRnDocument().setDocumentStatusReason(reason);
		} else {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("EInvoiceUtils.setRejectedCNRNEInv docTypeCd is blank."));
		}
		
	}
	
	/**
	 * check if TIN & identity contain whitespace
	 * 
	 * @param tin
	 * @param idValue
	 * @throws BusinessException 
	 */
	private static void checkWhitespace(String tin, String idValue) throws BusinessException {
		// check if TIN contains whitespaces
		if (tin.contains(" ")) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_TIN_CONTAIN_SPACES);
		}

		// check if identity value contains whitespaces
		if (idValue.contains(" ")) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_IDENTITY_CONTAIN_SPACES);
		}
	}
	
	/**
	 * check Malaysian address, has to have state
	 * @param customerVO
	 * @throws BusinessException
	 */
	private static void validateCustomerState(CustomerVO customerVO) throws BusinessException {
		if (customerVO != null) {
			if ("P".equals(customerVO.getPcTypeCd())) {
				if (customerVO.getBillAddressVO() != null && customerVO.getBillAddressVO().getCountryId() == 129) {
					if (StringUtils.isBlank(customerVO.getBillAddressVO().getState())) {
						throw new BusinessException(CommonErrConstant.ERR_CUST_NO_STATE);
					}
				}
			} else if ("C".equals(customerVO.getPcTypeCd())) {
				if (customerVO.getCorBillAddressVO() != null
						&& customerVO.getCorBillAddressVO().getCountryId() == 129) {
					if (StringUtils.isBlank(customerVO.getCorBillAddressVO().getState())) {
						throw new BusinessException(CommonErrConstant.ERR_CUST_NO_STATE);
					}
				}
			}
		}
	}
	
	/**
	 * check Malaysian address postcode exceed length limit of five
	 * @param customerVO
	 * @throws BusinessException
	 */
	private static void validateCustomerPostcode(CustomerVO customerVO) throws BusinessException {
		if (customerVO != null) {
			if ("P".equals(customerVO.getPcTypeCd())) {
				if (customerVO.getBillAddressVO() != null && customerVO.getBillAddressVO().getCountryId() == 129) {
					if (StringUtils.isNotBlank(customerVO.getBillAddressVO().getPostcode())
							&& customerVO.getBillAddressVO().getPostcode().length() > 5) {
						throw new BusinessException(CommonErrConstant.ERR_CUST_MYS_POSTCODE_MAX5);
					}
				}
			} else if ("C".equals(customerVO.getPcTypeCd())) {
				if (customerVO.getCorBillAddressVO() != null
						&& customerVO.getCorBillAddressVO().getCountryId() == 129) {
					if (StringUtils.isNotBlank(customerVO.getCorBillAddressVO().getPostcode())
							&& customerVO.getCorBillAddressVO().getPostcode().length() > 5) {
						throw new BusinessException(CommonErrConstant.ERR_CUST_MYS_POSTCODE_MAX5);
					}
				}
			}
		}
	}
	
	public static void checkMalaysianPostcode(InvoicePaxVO invoicePaxVO) throws BusinessException {
		if (invoicePaxVO != null && invoicePaxVO.getCustDetailsVO() != null
				&& invoicePaxVO.getCustDetailsVO().getAddressVO() != null) {
			AddressVO addressVO = invoicePaxVO.getCustDetailsVO().getAddressVO();
			if (addressVO.getCountryId() == 129 && StringUtils.isNotBlank(addressVO.getPostcode())
					&& addressVO.getPostcode().length() > 5) {
				throw new BusinessException(CommonErrConstant.ERR_CUST_MYS_POSTCODE_MAX5);
			}
		}
	}
	
	public static void checkMalaysianPostcode(CustDetailsVO custDetailsVO) throws BusinessException {
		if (custDetailsVO.getCustType().equals("P")) {
			AddressVO addressVO = custDetailsVO.getAddressVO();
			if (addressVO.getCountryId() == 129) {
				if (addressVO != null && StringUtils.isNotBlank(addressVO.getPostcode()) && addressVO.getPostcode().length() > 5) {
					throw new BusinessException(CommonErrConstant.ERR_CUST_MYS_POSTCODE_MAX5);
				}
			}
		} else if (custDetailsVO.getCustType().equals("C")) {
			CorAddressVO addressVO = custDetailsVO.getCorAddressVO();
			if (addressVO.getCountryId() == 129) {
				if (addressVO != null && StringUtils.isNotBlank(addressVO.getPostcode()) && addressVO.getPostcode().length() > 5) {
					throw new BusinessException(CommonErrConstant.ERR_CUST_MYS_POSTCODE_MAX5);
				}
			}
		}
	}
	
