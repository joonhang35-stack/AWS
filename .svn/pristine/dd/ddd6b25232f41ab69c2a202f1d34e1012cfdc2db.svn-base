	/**
	 * @param year
	 * @param month
	 * @param sysCd - system document type - invc, purc_bill etc,
	 * @param idCompany
	 * @param eInvoiceBO
	 * @return
	 */
	public static String generateConsolidateDocumentCode(Integer year, Integer month, String sysCd, Long idCompany, EInvoiceBO eInvoiceBO) {
		
		EInvoiceConsolidateNumGenVO eInvoiceConsolidateNumGenVO = eInvoiceBO.getEInvoiceConsolidateNumGenVO(year, month, sysCd, idCompany);
		
		if (eInvoiceConsolidateNumGenVO == null) {
			eInvoiceConsolidateNumGenVO = new EInvoiceConsolidateNumGenVO();
			eInvoiceConsolidateNumGenVO.setIdCompany(idCompany);
			eInvoiceConsolidateNumGenVO.setCode(sysCd);
			eInvoiceConsolidateNumGenVO.setYear(year);
			eInvoiceConsolidateNumGenVO.setMonth(month);
			eInvoiceConsolidateNumGenVO.setNextNo(1L);
			
			eInvoiceBO.insertVO(eInvoiceConsolidateNumGenVO);
		}
		
		String code = "";
		code = String.valueOf(year) + String.format("%02d", month) + "-" + String.format("%04d", eInvoiceConsolidateNumGenVO.getNextNo());
		
		eInvoiceConsolidateNumGenVO.setNextNo(eInvoiceConsolidateNumGenVO.getNextNo() + 1);
		eInvoiceBO.updateVO(eInvoiceConsolidateNumGenVO); // need to update only after e inv submitted
		
		return code;
	}
	
	public static void calcEInvItemList(InvoiceVO invoiceVO) {
//		System.out.println("EInvoiceUtils.calcEInvItemList()");
		invoiceVO.setTourFareAmt(0.0);
		invoiceVO.setAirTicketAmt(0.0);
		invoiceVO.setVoucherAmt(0.0);
		for (InvoiceItemVO invoiceItemVO : invoiceVO.getInvoiceItemList()) {
			// new calculation with referencing item type & airfare amount
			if (StringUtils.isNotBlank(invoiceItemVO.getTypeCd())) {
				if (invoiceItemVO.getTypeCd().equals(ProductConstant.INV_ITM_TYPE_AIRLINE)) {
//					System.out.println("CYY " + LINE_ITM_DESC_AIR_TKT + " " + invoiceItemVO.getDesc() + " - " + invoiceItemVO.getAmount() + " - ");
					BigDecimal ttlAmt = new BigDecimal(invoiceVO.getAirTicketAmt()).add(new BigDecimal(invoiceItemVO.getAmount()));
					invoiceVO.setAirTicketAmt(ttlAmt.doubleValue());
				} else if (invoiceItemVO.getTypeCd().equals(ProductConstant.INV_ITM_TYPE_VOUCHER)) {
//					System.out.println("CYY " + LINE_ITM_DESC_VOUCHER + " " + invoiceItemVO.getDesc() + " - " + invoiceItemVO.getAmount() + " - ");
					BigDecimal ttlAmt = new BigDecimal(invoiceVO.getVoucherAmt()).add(new BigDecimal(invoiceItemVO.getAmount()));
					invoiceVO.setVoucherAmt(ttlAmt.doubleValue());
				} else if (invoiceItemVO.getTypeCd().equals(ProductConstant.INV_ITM_TYPE_TOUR)) {
					invoiceVO.setAirTicketAmt(
							new BigDecimal(invoiceVO.getAirTicketAmt())
							.add(new BigDecimal(invoiceItemVO.getAirfare()).multiply(new BigDecimal(invoiceItemVO.getQty())))
							.doubleValue()
							);
					invoiceVO.setTourFareAmt(
							new BigDecimal(invoiceVO.getTourFareAmt())
							.add(new BigDecimal(invoiceItemVO.getAmount()))
							.subtract(new BigDecimal(invoiceItemVO.getAirfare()).multiply(new BigDecimal(invoiceItemVO.getQty())))
							.doubleValue()
							);
				} else {
//					System.out.println("CYY " + LINE_ITM_DESC_TOUR_FARE + " " + invoiceItemVO.getDesc() + " - " + invoiceItemVO.getAmount() + " - ");
					BigDecimal ttlAmt = new BigDecimal(invoiceVO.getTourFareAmt()).add(new BigDecimal(invoiceItemVO.getAmount()));
					invoiceVO.setTourFareAmt(ttlAmt.doubleValue());
				}
			} else {
				System.out.println("CYY NO_CAT: " + invoiceItemVO.getDesc() + " id=" + invoiceItemVO.getId());
				BigDecimal ttlAmt = new BigDecimal(invoiceVO.getTourFareAmt()).add(new BigDecimal(invoiceItemVO.getAmount()));
				invoiceVO.setTourFareAmt(ttlAmt.doubleValue());
			}
		}
	}
	
	private static PartyType generatePartyType(CustDetailsVO custDetailsVO, CountryVO countryVO, List<MalaysiaStateVO> malaysiaStateList) throws BusinessException {
		
		PartyType partyType = new PartyType();
		
		PartyIdentificationType tin = new PartyIdentificationType();
		if (custDetailsVO == null) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_DETAILS_MISSING);
		} 
		// if no TIN, replace with general public TIN
		// 2025.09.17 update: TIN required in corporate profile
		else if (SalesConstant.CUST_TYPE_CORPORATE.equals(custDetailsVO.getCustType()) && StringUtils.isBlank(custDetailsVO.getTaxIdNo())) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_CORP_NO_TIN);
//			throw new BusinessException(CommonErrConstant.ERR_CUST_NO_TIN);
		}
		else if (StringUtils.isBlank(custDetailsVO.getTaxIdNo())) {
			custDetailsVO.setTaxIdNo(EInvoiceConstant.E_INV_GNRL_TIN_PUBLIC);
		}
		tin.setID(custDetailsVO.getTaxIdNo());
//		System.out.println("invoiceVO.getCustDetailsVO().getTaxIdNo(): " + invoiceVO.getCustDetailsVO().getTaxIdNo());
//		tin1.setID("IG50676466040");
		tin.getID().setSchemeID(EInvoiceConstant.E_INV_IDENTITY_TYPE_TIN);
		partyType.addPartyIdentification(tin);
		
		PartyIdentificationType identity = generatePartyIdentificationType(custDetailsVO, true);
		// For non-Malaysian individuals
		// i. Option 1: TIN only  
		// ii. Option 2: Both TIN and passport number / MyPR / MyKAS identification number 
		if (identity.getID().getSchemeID().equals(EInvoiceConstant.E_INV_IDENTITY_TYPE_PASSPORT)) {
			if (tin.getIDValue().equals(EInvoiceConstant.E_INV_GNRL_TIN_PUBLIC)) {
				throw new BusinessException(CommonErrConstant.ERR_CUST_PSSPRT_NO_TIN);
			}
		}
		// XXX use my ic to test submission
//		tin.setID("IG50676466040");
		partyType.addPartyIdentification(identity);
		if (StringUtils.isNotBlank(custDetailsVO.getSstRegNo()))	partyType.addPartyIdentification(generatePartyIdentificationType(custDetailsVO.getSstRegNo(), EInvoiceConstant.E_INV_IDENTITY_TYPE_SST));
		
		AddressType addressType1 = new AddressType();
		
		// Customer City
		if (custDetailsVO.getAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getAddressVO().getCity())) {
			addressType1.setCityName(custDetailsVO.getAddressVO().getCity());
		} else if (custDetailsVO.getCorAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getCorAddressVO().getCity())) {
			addressType1.setCityName(custDetailsVO.getCorAddressVO().getCity());
		} else {
			throw new BusinessException(CommonErrConstant.ERR_CUST_NO_CITY);
		}
		
		// Customer Postcode
		checkMalaysianPostcode(custDetailsVO);
		if (custDetailsVO.getAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getAddressVO().getPostcode())) {
			addressType1.setPostalZone(custDetailsVO.getAddressVO().getPostcode());
		} else if (custDetailsVO.getCorAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getCorAddressVO().getPostcode())) {
			addressType1.setPostalZone(custDetailsVO.getCorAddressVO().getPostcode());
		} 
//		addressType1.setCountrySubentityCode("10");
		
		// Address Line 1
		AddressLineType addressLineType11 = new AddressLineType();
		if (custDetailsVO.getAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getAddressVO().getAddr1())) {
			addressLineType11.setLine(new LineType(custDetailsVO.getAddressVO().getAddr1()));
		} else if (custDetailsVO.getCorAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getCorAddressVO().getAddr1())) {
			addressLineType11.setLine(new LineType(custDetailsVO.getCorAddressVO().getAddr1()));
		} else {
			throw new BusinessException(CommonErrConstant.ERR_CUST_NO_ADDR1);
		}
		addressType1.addAddressLine(addressLineType11);
		
		// Address Line 2
//		addressLineType12.setLine(new LineType("Bangunan Merdeka"));
		if (custDetailsVO.getAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getAddressVO().getAddr2())) {
			AddressLineType addressLineType12 = new AddressLineType();
			addressLineType12.setLine(new LineType(custDetailsVO.getAddressVO().getAddr2()));
			addressType1.addAddressLine(addressLineType12);
		} else if (custDetailsVO.getCorAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getCorAddressVO().getAddr2())) {
			AddressLineType addressLineType12 = new AddressLineType();
			addressLineType12.setLine(new LineType(custDetailsVO.getCorAddressVO().getAddr2()));
			addressType1.addAddressLine(addressLineType12);
		}
		
		// Address Line 3
//		addressLineType13.setLine(new LineType("Persiaran Jaya"));
		if (custDetailsVO.getAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getAddressVO().getAddr3())) {
			AddressLineType addressLineType13 = new AddressLineType();
			addressLineType13.setLine(new LineType(custDetailsVO.getAddressVO().getAddr3()));
			addressType1.addAddressLine(addressLineType13);
		} else if (custDetailsVO.getCorAddressVO() != null && !StringUtils.isBlank(custDetailsVO.getCorAddressVO().getAddr3())) {
			AddressLineType addressLineType13 = new AddressLineType();
			addressLineType13.setLine(new LineType(custDetailsVO.getCorAddressVO().getAddr3()));
			addressType1.addAddressLine(addressLineType13);
		}
		
		// Country & State
//		CountryVO countryVO = null;
//		if (custDetailsVO.getCustType().equals("P")) {
//			countryVO = regionBO.getCountryById(custDetailsVO.getAddressVO().getCountryId());
//		} else if (custDetailsVO.getCustType().equals("C")) {
//			countryVO = regionBO.getCountryById(custDetailsVO.getCorAddressVO().getCountryId());
//		}
		if (countryVO == null) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_NO_COUNTRY);
		} else {
//			System.out.println("CYY countryVO.getThreeLetterCode(): " + countryVO.getThreeLetterCode());
			if (StringUtils.isBlank(countryVO.getThreeLetterCode())) {
				throw new BusinessException(CommonErrConstant.ERR_CUST_COUNTRY_NO_ALPHA3_CODE);
			}
			IdentificationCodeType identificationCodeType1 = new IdentificationCodeType(countryVO.getThreeLetterCode());
			identificationCodeType1.setListID("ISO3166-1");
			identificationCodeType1.setListAgencyID("6");
			
			CountryType countryType1 = new CountryType();
			countryType1.setIdentificationCode(identificationCodeType1);
			addressType1.setCountry(countryType1);
			
			if (countryVO.getThreeLetterCode().equals("MYS")) {
				boolean found = false;
				for(MalaysiaStateVO stateVO : malaysiaStateList) {
					if (custDetailsVO.getCustType().equals("P")) {
						if (stateVO.getName().toLowerCase().equals(custDetailsVO.getAddressVO().getState().toLowerCase())) {
							found = true;
							addressType1.setCountrySubentityCode(stateVO.geteInvoiceStateCode());
						}
					} else if (custDetailsVO.getCustType().equals("C")) {
						if (stateVO.getName().toLowerCase().equals(custDetailsVO.getCorAddressVO().getState().toLowerCase())) {
							found = true;
							addressType1.setCountrySubentityCode(stateVO.geteInvoiceStateCode());
						}
					}
				}
				
				if (!found) {
					throw new BusinessException(CommonErrConstant.ERR_CUST_NO_STATE);
				}
			} else {
				// not Malaysia state, not applicable
				addressType1.setCountrySubentityCode(EInvoiceConstant.STATE_CD_NA); 
			}
			
		}
		
		partyType.setPostalAddress(addressType1);
		
		PartyLegalEntityType partyLegalEntityType1 = new PartyLegalEntityType();
//		partyLegalEntityType1.setRegistrationName("Buyer's Name");
		if (!StringUtils.isBlank(custDetailsVO.getCompanyName())) {
			partyLegalEntityType1.setRegistrationName(custDetailsVO.getCompanyName());
		} else if (!StringUtils.isBlank(custDetailsVO.getContPersonName())) {
			partyLegalEntityType1.setRegistrationName(custDetailsVO.getContPersonName());
		}
		partyType.addPartyLegalEntity(partyLegalEntityType1);
		
		ContactType contactType1 = new ContactType();
		if (custDetailsVO.getCustType().equals("P")) {
			if (custDetailsVO.getContactList() != null && custDetailsVO.getContactList().size() > 0) {
				boolean found = false;
				for (PersonContactVO vo : custDetailsVO.getContactList()) {
					if(vo.getNumber().length() >= 8) {
						contactType1.setTelephone(vo.getNumber().replaceAll("[^0-9]", ""));
						found = true;
					}
				}
				if (!found) {
					throw new BusinessException(CommonErrConstant.ERR_CUST_NO_CONTACT);
				}
				
			} else {
				throw new BusinessException(CommonErrConstant.ERR_CUST_NO_CONTACT);
			}
		} else if (custDetailsVO.getCustType().equals("C")) {
			if (custDetailsVO.getCorContactList() != null && custDetailsVO.getCorContactList().size() > 0) {
//				contactType1.setTelephone(custDetailsVO.getCorContactList().get(0).getContactNo().replaceAll("[^0-9]", ""));
				boolean found = false;
				for (CorContactVO vo : custDetailsVO.getCorContactList()) {
					if(vo.getContactNo().length() >= 8) {
						contactType1.setTelephone(vo.getContactNo().replaceAll("[^0-9]", ""));
						found = true;
					}
				}
				if (!found) {
					throw new BusinessException(CommonErrConstant.ERR_CUST_NO_CONTACT);
				}
			} else {
				throw new BusinessException(CommonErrConstant.ERR_CUST_NO_CONTACT);
			}
		}
		
		if (!StringUtils.isBlank(custDetailsVO.getEmail())) {
			if (!FunctionUtils.isValidEmail(custDetailsVO.getEmail())) {
				throw new BusinessException(CommonErrConstant.ERR_CUST_EMAIL_INVALID);
			}
			contactType1.setElectronicMail(custDetailsVO.getEmail());
		}
		
//		contactType1.setElectronicMail("buyer@email.com");
		partyType.setContact(contactType1);
		
		return partyType;
	}
	
	private static PartyType generateCompanyPartyType(CompanyVO companyVO, List<MalaysiaStateVO> malaysiaStateList, CountryVO countryVO) throws BusinessException {
		
		PartyType partyType = new PartyType();
		partyType.setIndustryClassificationCode(EInvoiceConstant.MSIC_CODE_TRVL_AGEN);
		partyType.getIndustryClassificationCode().setName(EInvoiceConstant.MSIC_CODE_TRVL_AGEN_DESC);
		
		if (StringUtils.isBlank(companyVO.getCompanyAddressVO().getAddress1())) {
			throw new BusinessException(CommonErrConstant.ERR_COMPANY_NO_ADDR1);
		}
		if (StringUtils.isBlank(companyVO.getCompanyAddressVO().getCity())) {
			throw new BusinessException(CommonErrConstant.ERR_COMPANY_NO_CITY);
		}
		if (StringUtils.isBlank(companyVO.getTaxIdNo())) {
			throw new BusinessException(CommonErrConstant.ERR_COMPANY_NO_TIN);
		}
		
		PartyIdentificationType tin = new PartyIdentificationType();
		tin.setID(companyVO.getTaxIdNo());
		tin.getID().setSchemeID(EInvoiceConstant.E_INV_IDENTITY_TYPE_TIN);
		partyType.addPartyIdentification(tin);
		
		PartyIdentificationType brn = new PartyIdentificationType();
		brn.setID(companyVO.getConumber());
		brn.getID().setSchemeID(EInvoiceConstant.E_INV_IDENTITY_TYPE_BRN);
		partyType.addPartyIdentification(brn);
		
		AddressType addressType = new AddressType();
		addressType.setCityName(companyVO.getCompanyAddressVO().getCity());
		addressType.setPostalZone(companyVO.getCompanyAddressVO().getPostcode());
		
		if (StringUtils.isBlank(companyVO.getCompanyAddressVO().getState())) {
			addressType.setCountrySubentityCode(EInvoiceConstant.STATE_CD_NA); // https://sdk.myinvois.hasil.gov.my/codes/state-codes/
		} else {
			boolean found = false;
			for (MalaysiaStateVO stateVO : malaysiaStateList) {
				if (stateVO.getName().toLowerCase().equals(companyVO.getCompanyAddressVO().getState().toLowerCase())) {
					addressType.setCountrySubentityCode(stateVO.geteInvoiceStateCode());
					found = true;
				}
			}
			if (!found) {
				addressType.setCountrySubentityCode(EInvoiceConstant.STATE_CD_NA);
			}
		}
		
		AddressLineType addressLineType1 = new AddressLineType();
		addressLineType1.setLine(new LineType(companyVO.getCompanyAddressVO().getAddress1()));
		addressType.addAddressLine(addressLineType1);
		
		AddressLineType addressLineType2 = new AddressLineType();
		addressLineType2.setLine(new LineType(companyVO.getCompanyAddressVO().getAddress2()));
		addressType.addAddressLine(addressLineType2);
		
		AddressLineType addressLineType3 = new AddressLineType();
		addressLineType3.setLine(new LineType(companyVO.getCompanyAddressVO().getAddress3()));
		addressType.addAddressLine(addressLineType3);
		
		// Country & State
		if (countryVO == null) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_NO_COUNTRY);
		} else {
			if (StringUtils.isBlank(countryVO.getThreeLetterCode())) {
				throw new BusinessException(CommonErrConstant.ERR_CUST_COUNTRY_NO_ALPHA3_CODE);
			}
			IdentificationCodeType identificationCodeType1 = new IdentificationCodeType(countryVO.getThreeLetterCode());
			identificationCodeType1.setListID("ISO3166-1");
			identificationCodeType1.setListAgencyID("6");
			
			CountryType countryType1 = new CountryType();
			countryType1.setIdentificationCode(identificationCodeType1);
			addressType.setCountry(countryType1);
		}
		
		partyType.setPostalAddress(addressType);
		
		PartyLegalEntityType partyLegalEntityType = new PartyLegalEntityType();
		partyLegalEntityType.setRegistrationName(companyVO.getName());
		partyType.addPartyLegalEntity(partyLegalEntityType);
		
		ContactType contactType = new ContactType();
		
		if (companyVO.getCompanyContactList().size() <= 0) {
			throw new BusinessException(CommonErrConstant.ERR_COMPANY_NO_CONTACT);
		}
		contactType.setTelephone(companyVO.getCompanyContactList().get(0).getNumber().replaceAll("[^0-9]", ""));
		
		if (StringUtils.isNotBlank(companyVO.getEmail())) {
			if (!FunctionUtils.isValidEmail(companyVO.getEmail())) {
				throw new BusinessException(CommonErrConstant.ERR_COMPANY_EMAIL_INVALID);
			}
		}
		contactType.setElectronicMail(companyVO.getEmail());
		partyType.setContact(contactType);
		
		return partyType;
	}

