	/**
	 * @param tin - company TIN
	 * @param isOnBehalf
	 * @param companyVO - to get myInvoisClientId, myInvoisClientSecret1, myInvoisClientSecret2
	 * @return
	 * @throws IOException
	 * @throws JSONException
	 * @throws BusinessException
	 * @throws KeyManagementException 
	 * @throws NoSuchAlgorithmException 
	 */
	public String getAuthAccessToken(CompanyVO companyVO, Boolean isOnBehalf) throws IOException, JSONException, BusinessException, KeyManagementException, NoSuchAlgorithmException {
		
		System.out.println("CYY isOnBehalf: " + isOnBehalf);
		// check client id, client secret, tax no. is blank
		validateMyInvoisCredentials(companyVO);
		
		String url = EInvoiceProperties.getSystemApiUrl() + EInvoiceProperties.API_LOGIN;
		System.out.println("CYY url: " + url);
		
		// open connection
		HttpsURLConnection connection = openAuthAccessTokenHttpsURLConnection(new URL(url), "POST", isOnBehalf, companyVO);

        // get response code
        int status = connection.getResponseCode();
        System.out.println("CYY response code: " + status);
        
        if (status == HttpConstant.STATUS_CD_GATEWAY_TIMEOUT) {
        	throw new BusinessException(CommonErrConstant.ERR_GATEWAY_TIMEOUT);
        }
        
        // get response message from connection
        String response = getConnectionResponse(status, connection);
        System.out.println("CYY response: " + response);
        
        // convert to JSON format
        JSONObject jsonResponse = new JSONObject(response);
        System.out.println(jsonResponse.toString(4));
        logger.info("[EInvoiceUtils - getAuthAccessToken][jsonResponse]: " + response);
        
        // check if access token exists, if no, throw err
        if (jsonResponse.isNull("access_token") || StringUtils.isBlank(jsonResponse.getString("access_token")) || jsonResponse.getString("access_token") == null) {
        	throw new BusinessException(CommonErrConstant.ERR_E_INVOICE_API_LOGIN_FAILED);
        } 
        
        // insert access token
        EInvoiceAccessTokenVO eInvoiceAccessTokenVO = generateEInvoiceAccessTokenVO(companyVO.getId(), jsonResponse);
        eInvoiceBO.insertAccessToken(eInvoiceAccessTokenVO);
        
        return eInvoiceAccessTokenVO.getAccessToken();
	}
	
	public String getAccessToken(InvoiceVO invoiceVO, Boolean isOnBehalf, CompanyVO companyVO) throws BusinessException, IOException, JSONException, KeyManagementException, NoSuchAlgorithmException {
		
		if (invoiceVO.getCustDetailsVO() == null) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_DETAILS_MISSING);
		} else if (StringUtils.isBlank(invoiceVO.getCustDetailsVO().getTaxIdNo())) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_NO_TIN);
		} else if (CollectionUtils.isEmpty(invoiceVO.getCustDetailsVO().getIdentityList())) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_IDENTITY_MISSING);
		}
		
		return getAuthAccessToken(companyVO, isOnBehalf);
	}
	
	public String getAccessToken(SupplierVO supplierVO, Boolean isOnBehalf, CompanyVO companyVO) throws BusinessException, IOException, JSONException, KeyManagementException, NoSuchAlgorithmException {
		
		if (StringUtils.isBlank(supplierVO.getTaxIdNo())) {
			throw new BusinessException(CommonErrConstant.ERR_COMPANY_NO_TIN);
		}
		
		return getAuthAccessToken(companyVO, isOnBehalf);
	}
	
	public String getAccessToken(CompanyVO companyVO, Boolean isOnBehalf) throws BusinessException, IOException, JSONException, KeyManagementException, NoSuchAlgorithmException {
		EInvoiceAccessTokenVO eInvoiceAccessTokenVO = eInvoiceBO.getValidAccessToken(companyVO.getId());
		
		if (eInvoiceAccessTokenVO != null && StringUtils.isNotEmpty(eInvoiceAccessTokenVO.getAccessToken())) {
			return eInvoiceAccessTokenVO.getAccessToken();
		} else {
			return getAuthAccessToken(companyVO, isOnBehalf);
		}
	}
	
	/**
	 * <p>
	 * generate PartyIdentificationType from CustDetailsVO
	 * </p>
	 * <p>
	 * set identity (idType & idValue)
	 * </p>
	 * 
	 * @param custDetailsVO
	 * @param isIdentityRequired - if true, will throw BusinessException when identity not exists
	 * @throws BusinessException 
	 */
	public static PartyIdentificationType generatePartyIdentificationType(CustDetailsVO custDetailsVO, Boolean isIdentityRequired) throws BusinessException {
		PartyIdentificationType partyIdentificationType = new PartyIdentificationType();
		String idType = ""; 
		String idValue = "";
		
		if (custDetailsVO == null) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_DETAILS_MISSING);
		}
		
		if (StringUtils.isBlank(custDetailsVO.getCustType())) {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null,
					FunctionUtils.generateArrayFromStr("Customer type missing."));
		}
		
		if (custDetailsVO.getCustType().equals(SalesConstant.CUST_TYPE_PERSON)) {
			
			if (custDetailsVO.getCountryId() == null) {
				throw new BusinessException(CommonErrConstant.ERR_CUST_NO_NATIONALITY);
			}
			
			if (custDetailsVO.getCountryId() == 129) {
				for (IdentityVO identityVO : custDetailsVO.getIdentityList()) {
					if (identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_NRIC)) {
						idType = EInvoiceConstant.E_INV_IDENTITY_TYPE_NRIC;
						idValue = identityVO.getIdNo();
						idValue = idValue.replaceAll("[^0-9]", ""); // to eliminate possible "-" and other characters
						break;
					}
				}
				
				// if didn't get IC
				if (idType.equals("")) {
					for (IdentityVO identityVO : custDetailsVO.getIdentityList()) {
						if (identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_PASSPRT)) {
							idType = EInvoiceConstant.E_INV_IDENTITY_TYPE_PASSPORT;
							idValue = identityVO.getIdNo();
							break;
						}
					}
				}
			} else {
				for (IdentityVO identityVO : custDetailsVO.getIdentityList()) {
					if (identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_PASSPRT)) {
						idType = EInvoiceConstant.E_INV_IDENTITY_TYPE_PASSPORT;
						idValue = identityVO.getIdNo();
						break;
					}
				}
				
				// if didn't get IC
				if (idType.equals("")) {
					for (IdentityVO identityVO : custDetailsVO.getIdentityList()) {
						if (identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_NRIC)) {
							idType = EInvoiceConstant.E_INV_IDENTITY_TYPE_NRIC;
							idValue = identityVO.getIdNo();
							idValue = idValue.replaceAll("[^0-9]", ""); // to eliminate possible "-" and other characters
							break;
						}
					}
				}
			}
		} else if (custDetailsVO.getCustType().equals(SalesConstant.CUST_TYPE_CORPORATE)) {
			idType = EInvoiceConstant.E_INV_IDENTITY_TYPE_BRN;
			idValue = custDetailsVO.getRegNo();
		} else {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Customer type missing."));
		}
		
//		System.out.println("CYY idType: " + idType);
//		System.out.println("CYY idValue: " + idValue);
		
		partyIdentificationType.setID(idValue);
		partyIdentificationType.getID().setSchemeID(idType);
		
		// XXX use my ic to test submission
		if (StringUtils.equalsIgnoreCase(EInvoiceProperties.TESTING, "true")) {
			partyIdentificationType.setID("011014140877");
		}
//		partyIdentificationType.setID("011014140877");
		
		if (isIdentityRequired) {
			if (StringUtils.isBlank(idValue) || StringUtils.isBlank(idType)) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {"Please provide at least one customer identity."});
			}
		}
		
		return partyIdentificationType;
	}
	
	public static Boolean validateTaxpayerTin(String tin, String idType, String idValue, String accessToken) throws Exception {
		
		checkWhitespace(tin, idValue);
		
		tin = URLEncoder.encode(tin, StandardCharsets.UTF_8.toString());
		idValue = URLEncoder.encode(idValue, StandardCharsets.UTF_8.toString());
		
		// if is General TIN, no need validate
		if (tin.equals(EInvoiceConstant.E_INV_GNRL_TIN_PUBLIC) || tin.equals(EInvoiceConstant.E_INV_GNRL_TIN_F_BUYER) || tin.equals(EInvoiceConstant.E_INV_GNRL_TIN_GOV)) {
			return true;
		}
		
		/*
		HttpClient client = new DefaultHttpClient();
    	HttpGet request = new HttpGet(EInvoiceProperties.getSystemApiUrl() + EInvoiceProperties.API_VALIDATE + "/" + tin +"?idType=" + idType + "&idValue=" + idValue);

//    	System.out.println("request.getURI().toString(): " + request.getURI().toString());
    	
        // Set headers
        request.addHeader("Accept", "application/json");
        request.addHeader("Accept-Language", "en");
        request.addHeader("Content-Type", "application/json");
        request.addHeader("Authorization", "Bearer " + accessToken);

        // Execute request and get the response
        HttpResponse response = client.execute(request);
        
//        System.out.println("CYY response.getStatusLine().getStatusCode(): " + response.getStatusLine().getStatusCode());
        if (response.getStatusLine().getStatusCode() == 200) {
        	return true;
        } else if (response.getStatusLine().getStatusCode() == 404) {
        	return false;
        }
        
        InputStream inputStream = response.getEntity().getContent();
        
        StringBuilder result = new StringBuilder();
        try (BufferedReader reader = new BufferedReader(new InputStreamReader(inputStream, StandardCharsets.UTF_8))) {
            String line;
            while ((line = reader.readLine()) != null) {
                result.append(line).append("\n");
            }
        }*/
		
		String urlString = EInvoiceProperties.getSystemApiUrl() 
                + EInvoiceProperties.API_VALIDATE 
                + "/" + tin + "?idType=" + idType + "&idValue=" + idValue;
        
        // open connection
        HttpsURLConnection connection = openHttpsURLConnection(new URL(urlString), "GET", accessToken);
        
        // get response code
        int responseCode = connection.getResponseCode();
        
        // get response message from connection
        String response = getConnectionResponse(responseCode, connection);
        System.out.println("CYY response: " + response.toString());
        
        if (responseCode == HttpConstant.STATUS_CD_OK) {
            return true;
        } else if (responseCode == HttpConstant.STATUS_CD_NOT_FOUND) {
            return false;
        } else if (responseCode == HttpConstant.STATUS_CD_UNAUTHORIZED) {
            return false;
        }

//        System.out.println("CYY result: " + result);
        throw new Exception(response.toString());
	}
	
