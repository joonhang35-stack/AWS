			invoiceLineType.setID(String.valueOf(invoiceItemVO.getId()));
			invoiceLineType.setInvoicedQuantity(BigDecimal.valueOf(invoiceItemVO.getQty()));
//			invoiceLineType.getCreditedQuantity().setUnitCode("C62"); // Optional
			
			invoiceLineType.setLineExtensionAmount(BigDecimal.valueOf(invoiceItemVO.getAmount()));
			invoiceLineType.getLineExtensionAmount().setCurrencyID("MYR");
			
			TaxTotalType taxTotalType2 = new TaxTotalType();
			taxTotalType2.setTaxAmount(BigDecimal.valueOf(0));
			taxTotalType2.getTaxAmount().setCurrencyID("MYR");
			
			TaxSubtotalType taxSubtotalType2 = new TaxSubtotalType();
			taxSubtotalType2.setTaxableAmount(BigDecimal.valueOf(0));
			taxSubtotalType2.getTaxableAmount().setCurrencyID("MYR");
			taxSubtotalType2.setTaxAmount(BigDecimal.valueOf(0));
			taxSubtotalType2.getTaxAmount().setCurrencyID("MYR");
			taxSubtotalType2.setPercent(BigDecimal.valueOf(0));
			
			TaxCategoryType taxCategoryType2 = new TaxCategoryType();
			taxCategoryType2.setID("06");
			
			TaxSchemeType taxSchemeType2 = new TaxSchemeType();
			taxSchemeType2.setID("OTH");
			taxSchemeType2.getID().setSchemeID("UN/ECE 5153");
			taxSchemeType2.getID().setSchemeAgencyID("6");
			taxCategoryType2.setTaxScheme(taxSchemeType2);
			
			taxSubtotalType2.setTaxCategory(taxCategoryType2);
			taxTotalType2.addTaxSubtotal(taxSubtotalType2);
			invoiceLineType.addTaxTotal(taxTotalType2);
			
			ItemType itemType = new ItemType();
			CommodityClassificationType commodityClassificationType = new CommodityClassificationType();
			commodityClassificationType.setItemClassificationCode(invoiceItemVO.getClassificationCode());
			commodityClassificationType.getItemClassificationCode().setListID("CLASS");
			itemType.addCommodityClassification(commodityClassificationType);
			
			itemType.addDescription(new DescriptionType(invoiceItemVO.getDesc()));
			
			itemType.setOriginCountry(new CountryType());
			itemType.getOriginCountry().setIdentificationCode("MYS");
			
			invoiceLineType.setItem(itemType);
			
			invoiceLineType.setPrice(new PriceType());
			invoiceLineType.getPrice().setPriceAmount(BigDecimal.valueOf(invoiceItemVO.getUnitPrice()));
			invoiceLineType.getPrice().getPriceAmount().setCurrencyID("MYR");
			invoiceLineType.setItemPriceExtension(new PriceExtensionType());
			invoiceLineType.getItemPriceExtension().setAmount(BigDecimal.valueOf(invoiceItemVO.getAmount()));
			invoiceLineType.getItemPriceExtension().getAmount().setCurrencyID("MYR");
			
			invoiceType.addInvoiceLine(invoiceLineType);
		}
		
		// RN to consol inv (2025.06.10)
		if (eInvoiceDocumentVO == null || eInvoiceDocumentVO.getIsConsolEInv()) {
			/********* Code Refactoring - Start *********/
			// 2025.06.11 1.42am
			// (remove code above if new code stable)
			populateConsolRefData(invoiceType, rnInvoiceVO.getCode(), eInvoiceDocumentVO, invoiceVO.getRefundAmt(), invPrefixVal);
			/********* Code Refactoring - End *********/
		}
		
		invoiceVO.setRnInvoiceType(invoiceType);
		return invoiceType;
	}
	
	public static EInvoiceDocument generateEInvoiceDocument(InvoiceType docType) throws NoSuchAlgorithmException {
		
		ByteArrayOutputStream byteArrayOutputStream = new ByteArrayOutputStream(); 
		UBL21Writer.invoice().write(docType, byteArrayOutputStream);
		
		// add a 'Z' to issueTime to align with myInvois requirement
        String addZ = byteArrayOutputStream.toString();
        addZ = addZ.replace("</cbc:IssueTime>", "Z</cbc:IssueTime>");
        
		System.out.println(addZ);
        
        byte[] xmlBytes = addZ.getBytes(java.nio.charset.StandardCharsets.UTF_8);
		String base64 = Base64.getEncoder().encodeToString(xmlBytes); 
        String hash = FunctionUtils.hashBase64String(xmlBytes); 
        	        
        // Generate e-invoice object
        EInvoiceDocument eInvoiceDocument = new EInvoiceDocument();
        eInvoiceDocument.setFormat("XML");
        eInvoiceDocument.setDocument(base64);
        eInvoiceDocument.setDocumentHash(hash);
        eInvoiceDocument.setCodeNumber(docType.getIDValue());
        
        return eInvoiceDocument;
        
	}
	
	/**
	 * @param byteArrayOutputStream
	 * @param codeNumber
	 * @return an org.primefaces.json.JSONObject E-Invoice Document array 
	 * @throws NoSuchAlgorithmException
	 * @throws JSONException
	 */
	public static JSONObject generateEInvoiceDocuments(ByteArrayOutputStream byteArrayOutputStream, String codeNumber) throws NoSuchAlgorithmException, JSONException {
		
		// add a 'Z' to issueTime to align with myInvois requirement
        String addZ = byteArrayOutputStream.toString();
        addZ = addZ.replace("</cbc:IssueTime>", "Z</cbc:IssueTime>");
        
//		        System.out.println(addZ);
        
        byte[] xmlBytes = addZ.getBytes(java.nio.charset.StandardCharsets.UTF_8);
		String base64 = Base64.getEncoder().encodeToString(xmlBytes); 
        String hash = FunctionUtils.hashBase64String(xmlBytes); 
        	        
        // Generate e-invoice object
        EInvoiceDocument eInvoiceDocument = new EInvoiceDocument();
        eInvoiceDocument.setFormat("XML");
        eInvoiceDocument.setDocument(base64);
        eInvoiceDocument.setDocumentHash(hash);
        eInvoiceDocument.setCodeNumber(codeNumber);
        
        // Put e-invoice json object into json array
        JSONObject jsonObject = new JSONObject();
        jsonObject.put("documents", new JSONArray());
        jsonObject.getJSONArray("documents").put(FunctionUtils.removeNull(eInvoiceDocument));
        
        return jsonObject;
	}
	
	/**
	 * @param docType
	 * @return an org.primefaces.json.JSONObject E-Invoice Document array 
	 * @throws NoSuchAlgorithmException
	 * @throws JSONException
	 */
	public static JSONObject generateEInvoiceDocuments(InvoiceType docType) throws NoSuchAlgorithmException, JSONException {
		return generateEInvoiceDocuments(new ArrayList<InvoiceType>(Arrays.asList(new InvoiceType[] { docType })));
	}
	
