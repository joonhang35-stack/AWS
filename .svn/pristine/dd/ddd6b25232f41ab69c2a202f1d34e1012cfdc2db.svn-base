     	UBL21Writer.invoice().write(consolidateInvoiceType, byteArrayOutputStream);
     		
     	JSONObject eInvoiceDocuments = generateEInvoiceDocuments(byteArrayOutputStream, consolidateInvoiceType.getIDValue());
     		
