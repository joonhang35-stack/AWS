	/**
	 * <pre>
	 * Submit Invoice as Invoice to E-Invoice API
	 * Multiple submission
	 * https://sdk.myinvois.hasil.gov.my/einvoicingapi/02-submit-documents/
	 * </pre>
	 * 
	 * @param invList
	 * @param companyVO
	 * @return
	 * @throws Exception
	 * @throws BusinessException
	 * @throws IOException
	 * @throws JSONException
	 * @throws NoSuchAlgorithmException
	 */
	public JSONObject submitInvoices(List<InvoiceVO> invList, Long idCompany) throws Exception, BusinessException, IOException, JSONException, NoSuchAlgorithmException {
		
		CompanyVO companyVO = corporateProfileBO.getCompanyDetails(idCompany);
		String accessToken = getAccessToken(companyVO, true);  
		
//		InvoiceType invoiceType = generateInvoiceType(invoiceVO, companyVO);
		List<InvoiceType> invoiceTypeList = new ArrayList<InvoiceType>();
		for (InvoiceVO vo : invList) {
			vo.setCreatedBy(StringUtils.isBlank(BaseContext.getUserFullName()) ? BaseContext.getLoginId() : BaseContext.getUserFullName());
			vo.setCreatedDate(new Date());
			vo.seteInvoiceDocument(new EInvoiceDocument());
			InvoiceVO invoiceVO = invoiceBO.getInvoiceById(vo.getId());
			invoiceVO = invoiceBO.getInvoiceDetails(invoiceVO);
			
	        try {
	        	if (StringUtils.equals(CommonConstant.STATUS_CD_VOID, invoiceVO.getStatusCd()))	throw new BusinessException(CommonErrConstant.ERR_E_INVOICE_VOIDED_DOC);
				if (StringUtils.equals(EInvoiceConstant.E_INV_STATUS_VALID, invoiceVO.geteInvoiceStatus())
						|| StringUtils.equals(EInvoiceConstant.E_INV_STATUS_SUBMIT, invoiceVO.geteInvoiceStatus()))
					throw new BusinessException(CommonErrConstant.ERR_E_INVOICE_DOC_SUBMITTED);
	        	
	        	InvoiceType invoiceType = generateInvoiceType(invoiceVO, companyVO);
	        	if (!validateTaxpayerTin(invoiceVO, accessToken)) {
		        	throw new BusinessException(CommonErrConstant.ERR_TAXPAYER_TIN_VALIDATION_FAILED);
		        }
	        	invoiceTypeList.add(invoiceType);
	        	
	        	vo.setInvoiceType(invoiceType); // save generated e invoice info
	        	vo.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_SUBMIT);
			} catch (BusinessException b) {
				String errMsg = messageSource.getMessage(ErrorConstant.ERR_GENERAL_EXCEPTION, null, "System error", LocaleUtils.toLocale(BaseContext.getLocaleCode()));
				errMsg = messageSource.getMessage(b.getErrorCode(), b.getParameters(), errMsg, LocaleUtils.toLocale(BaseContext.getLocaleCode()));
				vo.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_INVALID);
				vo.geteInvoiceDocument().setDocumentStatusReason(errMsg);
//				System.out.println(b.getMessage());
//				System.out.println(b.getLocalizedMessage());
//				t.
			} catch (Throwable t) {
				throw t;
			}
			
//			System.out.println(vo.getCode());
		}
		
//		JSONObject eInvoiceDocuments = generateEInvoiceDocuments(byteArrayOutputStream, invPrefixVal + " " + invoiceVO.getCode());
		JSONObject eInvoiceDocuments = generateEInvoiceDocuments(invoiceTypeList);
		
		return submitAPI(eInvoiceDocuments, accessToken);
	}
	
	public JSONObject submitSelfBilledInvoice(ExOrderBillVO exOrderBillVO, SupplierVO supplierVO, List<SupplierVO> supplierList, AcctTransVO acctTransVO, CompanyVO companyVO) throws Exception {
		
		InvoiceType selfBilledInvoiceType = generateSelfBilledInvoiceType(exOrderBillVO, supplierVO, supplierList, acctTransVO);
		
		String accessToken = getAccessToken(companyVO, true);   
		
		// Generate document base64 and hash
		ByteArrayOutputStream byteArrayOutputStream = new ByteArrayOutputStream(); 
		UBL21Writer.invoice().write(selfBilledInvoiceType, byteArrayOutputStream);
		
		JSONObject eInvoiceDocuments = generateEInvoiceDocuments(byteArrayOutputStream, exOrderBillVO.getCode());
		
		return submitAPI(eInvoiceDocuments, accessToken);
        
		// TODO - validate TIN
