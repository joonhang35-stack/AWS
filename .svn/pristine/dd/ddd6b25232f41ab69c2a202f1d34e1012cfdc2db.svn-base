	/** 
	 * <pre>
	 * Submit to E-Invoice API.
	 * Established connection to E-Invoice API and returns a response.
	 * 
	 * Example code
	 * 
	 * // Generate document base64 and hash
	 * ByteArrayOutputStream byteArrayOutputStream = new ByteArrayOutputStream(); 
	 * UBL21Writer.invoice().write(invoiceType, byteArrayOutputStream); 
	 * JSONObject eInvoiceDocuments = generateEInvoiceDocuments(byteArrayOutputStream, invPrefixVal + " " + invoiceVO.getCode());
	 * submitAPI(byteArrayOutputStream, invPrefixVal + " " + invoiceVO.getCode(), accessToken);
	 * </pre>
	 * 
	 * @param eInvoiceDocuments - formatted JSONObject, contains a single documents value that contains one or more Document objects
	 * @param accessToken
	 * @return API response
	 * @throws NoSuchAlgorithmException 
	 * @throws JSONException 
	 * @throws IOException 
	 * @throws ClientProtocolException 
	 * @throws BusinessException 
	 * @throws KeyManagementException 
	 */
	public static JSONObject submitAPI(JSONObject eInvoiceDocuments, String accessToken) throws NoSuchAlgorithmException, JSONException, ClientProtocolException, IOException, BusinessException, KeyManagementException {
        			
		// construct url
		String url = EInvoiceProperties.getSystemApiUrl() + EInvoiceProperties.API_SUBMIT;
		
		// open connection
		HttpsURLConnection connection = openHttpsURLConnection(new URL(url), "POST", accessToken, eInvoiceDocuments.toString());
		
		// get response code
		int respCode = connection.getResponseCode();
		System.out.println("CYY respCode: " + respCode);
		
		// get response message from connection
        String response = getConnectionResponse(respCode, connection); 
        
        JSONObject submitResponse = new JSONObject(response);
        System.out.println("CYY submitResponse");
        System.out.println(submitResponse.toString(4));
        
        if (respCode == 422) {
        	// 422 DuplicateSubmission
        	throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {submitResponse.getString("error")});
        } else if (respCode == 411) {
        	// 411 LengthRequired
        	throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {"Empty submission."});
        }
        
        return submitResponse;
	}
	
