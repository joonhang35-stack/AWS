	/**
	 * TIN validation check when saving cust details
	 * 
	 * @param customerVO
	 * @param accessToken
	 * @return
	 * @throws Exception
	 */
	public static Boolean validateTaxpayerTin(CustomerVO customerVO, String accessToken) throws Exception  {
		
		String idType = ""; 
		String idValue = "";
		String tin = "";
		
		if (customerVO.getPcTypeCd().equals("C")) {
			if (StringUtils.isNotBlank(customerVO.getCorporateVO().getTaxIdNo())) {
				tin = customerVO.getCorporateVO().getTaxIdNo();
				if (StringUtils.isNotBlank(customerVO.getCorporateVO().getRegNo())) {
					idType = EInvoiceConstant.E_INV_IDENTITY_TYPE_BRN;
					idValue = customerVO.getCorporateVO().getRegNo();
					
					System.out.println("CYY tin: " + tin + " - " + idType + " - " + idValue);
					
					return validateTaxpayerTin(customerVO.getCorporateVO().getTaxIdNo(), idType, idValue, accessToken);
				}
			}
		} else if (customerVO.getPcTypeCd().equals("P")) {
			if (StringUtils.isNotBlank(customerVO.getPersonVO().getTaxIdNo())) {
				tin = customerVO.getPersonVO().getTaxIdNo();
			}
		}
		
		for(IdentityVO identityVO : customerVO.getIdentityList()) {
			if (identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_NRIC)) {
				idType = EInvoiceConstant.E_INV_IDENTITY_TYPE_NRIC;
				idValue = identityVO.getIdNo();
				idValue = idValue.replaceAll("[^0-9]", ""); // to eliminate possible "-" and other characters
				break;
			}
		}
		
		// if didn't get IC
		if (idType.equals("")) {
			for(IdentityVO identityVO : customerVO.getIdentityList()) {
				if (identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_PASSPRT)) {
					idType = EInvoiceConstant.E_INV_IDENTITY_TYPE_PASSPORT;
					idValue = identityVO.getIdNo();
					break;
				}
			}
		}
		
		if (StringUtils.isBlank(idValue) && StringUtils.isNotBlank(tin)) {
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {"Please provide at least one customer identity to validate TIN."});
		}
		
		if (StringUtils.isNotBlank(tin)) {
			return validateTaxpayerTin(tin, idType, idValue, accessToken);
		}
		
		return true;
	}
	
	public static void addEInvoiceHeaderParam(HttpUriRequest request, String accessToken) {
		request.addHeader("Accept", "application/json");
        request.addHeader("Accept-Language", "en");
        request.addHeader("Content-Type", "application/json");
        request.addHeader("Authorization", "Bearer " + accessToken);
	}
	
