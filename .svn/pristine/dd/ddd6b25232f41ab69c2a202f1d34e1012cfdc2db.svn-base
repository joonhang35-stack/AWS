		eInvoiceBO.updEInvoiceDocumentVO(eInvoiceDocumentVO, eInvoiceDocument);
		
//		searchDocuments(docUuid, accessToken);
		
		return eInvoiceDocumentVO;
	}
	
	public JSONObject searchDocuments(String docUuid, String accessToken) throws JSONException, ClientProtocolException, IOException, BusinessException, KeyManagementException, NoSuchAlgorithmException, ParseException {

		SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'");
        sdf.setTimeZone(TimeZone.getTimeZone("UTC"));
        
		Calendar calendar = Calendar.getInstance();
		Date toDate = new Date();
		Date fromDate = calendar.getTime();
		calendar.add(Calendar.MONTH, -1);
		fromDate = calendar.getTime();
		
//		System.out.println("CYY sdf.format(fromDate): " + sdf.format(fromDate));
//		System.out.println("CYY sdf.format(toDate): " + sdf.format(toDate));
		
		String url = UriComponentsBuilder.fromHttpUrl(EInvoiceProperties.getSystemApiUrl() + "api/v1.0/documents/search")
                .queryParam("uuid", docUuid)
                .queryParam("submissionDateFrom", sdf.format(fromDate))
                .queryParam("submissionDateTo", sdf.format(toDate))
//                .queryParam("pageNo", pageNo)
                .build()
                .toUriString();
		
		// open connection
		HttpsURLConnection connection = openHttpsURLConnection(new URL(url), "GET", accessToken);
		
		// get response code
		int respCode = connection.getResponseCode();
		System.out.println("CYY respCode: " + respCode);
        
		// get response message from connection
        String response = getConnectionResponse(respCode, connection); 
        
        JSONObject jsonResponse = new JSONObject(response);
		
		System.out.println(jsonResponse.toString(4));
		
		return jsonResponse;
	}
	
	/**
	 * <p>E-Invoice API - Get Recent Documents</p>
	 * <p>https://sdk.myinvois.hasil.gov.my/einvoicingapi/05-get-recent-documents/</p>
	 * @param accessToken
	 * @param d - the date for which to retrieve all e-invoice submissions
	 * @param pageSize - default to {@code EInvoiceConstant.MAX_PAGE_SIZE = 100}
	 * @param pageNo - default to {@code -1}
	 * @return
	 * @throws JSONException
	 * @throws ClientProtocolException
	 * @throws IOException
	 * @throws BusinessException
	 * @throws KeyManagementException
	 * @throws NoSuchAlgorithmException
	 * @throws ParseException
	 */
	public static ApiDocumentQueryResponseVO getRecentDocuments(String accessToken, Date d) throws KeyManagementException, ClientProtocolException, BusinessException, NoSuchAlgorithmException, JSONException, IOException, ParseException {
		return getRecentDocuments(accessToken, d, EInvoiceConstant.MAX_PAGE_SIZE, -1);
	}
	
	/**
	 * <p>E-Invoice API - Get Recent Documents</p>
	 * <p>https://sdk.myinvois.hasil.gov.my/einvoicingapi/05-get-recent-documents/</p>
	 * @param accessToken
	 * @param d - the date for which to retrieve all e-invoice submissions
	 * @param pageSize - pass {@code -1} if is not used
	 * @param pageNo - pass {@code -1} if is not used
	 * @return
	 * @throws JSONException
	 * @throws ClientProtocolException
	 * @throws IOException
	 * @throws BusinessException
	 * @throws KeyManagementException
	 * @throws NoSuchAlgorithmException
	 * @throws ParseException
	 */
	public static ApiDocumentQueryResponseVO getRecentDocuments(String accessToken, Date d, int pageSize, int pageNo) throws JSONException, ClientProtocolException, IOException, BusinessException, KeyManagementException, NoSuchAlgorithmException, ParseException {

		SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'");
        sdf.setTimeZone(TimeZone.getTimeZone("UTC"));
		
//		System.out.println("CYY sdf.format(d): " + sdf.format(d));
//		System.out.println("CYY sdf.format(toDate): " + sdf.format(toDate));
		
		UriComponentsBuilder builder = UriComponentsBuilder.fromHttpUrl(EInvoiceProperties.getSystemApiUrl() + "api/v1.0/documents/recent")
                .queryParam("submissionDateFrom", sdf.format(DatesUtils.getDayTimeStart(d).getTime()))
                .queryParam("submissionDateTo", sdf.format(DatesUtils.getDayTimeEnd(d).getTime()));
		
		if (pageSize > 0)	builder.queryParam("pageSize", pageSize);
		if (pageNo > 0)		builder.queryParam("pageNo", pageNo);
                
        String url = builder.build().toUriString();
		
		// open connection
		HttpsURLConnection connection = openHttpsURLConnection(new URL(url), "GET", accessToken);
		
		// get response code
		int respCode = connection.getResponseCode();
		System.out.println("CYY respCode: " + respCode);
        
		// get response message from connection
        String response = getConnectionResponse(respCode, connection); 
        
        System.out.println("CYY response: " + response);
        
        JSONObject jsonResponse = new JSONObject(response);
		
//		System.out.println(jsonResponse.toString(4));
		
        Gson gson = FunctionUtils.getGsonDateConverter();
        
		ApiDocumentQueryResponseVO responseVO = gson.fromJson(jsonResponse.toString(), ApiDocumentQueryResponseVO.class);
		responseVO.setPageNo(pageNo < 0 ? 1 : pageNo);
		responseVO.setJsonResponse(jsonResponse.toString(4));
		
		return responseVO;
	}
	
	public static Boolean isConsolEInv(InvoiceVO invoiceVO, InvoiceAndExchangeOrderBO invoiceAndExchangeOrderBO) {
		Boolean isConsolEInv = true;
		for (InvoiceItemVO itemVO : invoiceVO.getInvoiceItemList()) {
			InvoiceAndExchangeOrderVO invoiceAndExchangeOrderVO = null;
			if (itemVO.getInvEOItemId() != null) {
				invoiceAndExchangeOrderVO = invoiceAndExchangeOrderBO.getInvoiceAndExchangeOrderVO(itemVO.getInvEOItemId());
			} else if (StringUtils.isNotBlank(itemVO.getCode())) {
				invoiceAndExchangeOrderVO = invoiceAndExchangeOrderBO.getInvoiceAndExchangeOrderVO(itemVO.getCode());
			}
			
			if (invoiceAndExchangeOrderVO != null && invoiceAndExchangeOrderVO.getTypeCd() != null) {
				if (invoiceAndExchangeOrderVO.getTypeCd().equals(ProductConstant.INV_ITM_TYPE_AIRLINE)) {
					isConsolEInv = false;
//					System.out.println("CYY itemVO.getDesc(): " + itemVO.getDesc());
				} else if (invoiceAndExchangeOrderVO.getTypeCd().equals(ProductConstant.INV_ITM_TYPE_TOUR)) {
					if (itemVO.getAirfare() > 0) {
						isConsolEInv = false;
//						System.out.println("CYY itemVO.getDesc(): " + itemVO.getDesc());
					}
				}
			} else {
				isConsolEInv = false;
//				System.out.println("CYY itemVO.getDesc(): " + itemVO.getDesc());
			}
		}
		
		return isConsolEInv;
	}
	
	/**
	 * generate invoiceType from sales invoice
	 * call corporateProfileBO.getCompanyDetails(idCompany) to ensure all company details existed
	 * 
	 * @param invoiceVO
	 * @param companyVO
	 * @return
	 * @throws BusinessException
	 */
	public InvoiceType generateInvoiceType(InvoiceVO invoiceVO, CompanyVO companyVO) throws BusinessException {
		
		String invPrefixVal = LookupItemUtils.getSysNumGenVO(companyVO.getId(), CommonConstant.SYS_NUM_CD_INVC).getPrefixid();
		
		InvoiceType invoiceType = new InvoiceType();
		
		invoiceType.setID(invPrefixVal + " " + invoiceVO.getCode());
//		invoiceType.setID("INV000020");

		// E-Invoice issue date based on submission date, instead of inv date
		Date d = new Date();
		invoiceType.setIssueDate(d.toInstant().atZone(ZoneOffset.UTC).toLocalDate());
		invoiceType.setIssueTime(d.toInstant().atZone(ZoneOffset.UTC).toLocalTime().withSecond(0).withNano(0));

		invoiceType.setInvoiceTypeCode(EInvoiceConstant.E_INV_TYPE_INVOICE);
		invoiceType.getInvoiceTypeCode().setListVersionID("1.0");
		
		invoiceType.setDocumentCurrencyCode("MYR");
		invoiceType.setTaxCurrencyCode("MYR");
		
		SupplierPartyType supplierPartyType = new SupplierPartyType();
		invoiceVO.setCompanyVO(companyVO);
		
		supplierPartyType.setParty(generateCompanyPartyType(companyVO, malaysiaStateBO.getStateList(),
				regionBO.getCountryById(invoiceVO.getCompanyVO().getCompanyAddressVO().getCountryid())));
		invoiceType.setAccountingSupplierParty(supplierPartyType);
		
		CustomerPartyType customerPartyType = new CustomerPartyType();
		CountryVO countryVO = null;
		if (invoiceVO.getCustDetailsVO().getCustType().equals("P")) {
			countryVO = regionBO.getCountryById(invoiceVO.getCustDetailsVO().getAddressVO().getCountryId());
		} else if (invoiceVO.getCustDetailsVO().getCustType().equals("C")) {
			countryVO = regionBO.getCountryById(invoiceVO.getCustDetailsVO().getCorAddressVO().getCountryId());
		}
		customerPartyType.setParty(generatePartyType(invoiceVO.getCustDetailsVO(), countryVO, malaysiaStateBO.getStateList()));
		invoiceType.setAccountingCustomerParty(customerPartyType);
		
		// No tax for now
		invoiceType.addTaxTotal(generateNoTaxTotalType());
		
		invoiceType.setLegalMonetaryTotal(generateMonetaryTotalType(invoiceVO.getAmount()));
		
		calcEInvItemList(invoiceVO);
		
		List<InvoiceItemVO> apiItemList = new ArrayList<InvoiceItemVO>();
		/********* Code Refactoring - Start *********/
		// (remove code below if new code stable 2025.07.09)
		InvoiceItemVO tourFareItemVO = generateInvoiceItemVO(EInvoiceConstant.LINE_ITM_DESC_TOUR_FARE, invoiceVO.getTourFareAmt(), invoiceVO.getTourFareAmt(), 1, EInvoiceConstant.CLASS_CODE_OTHERS);
		InvoiceItemVO airTicketItemVO = generateInvoiceItemVO(EInvoiceConstant.LINE_ITM_DESC_AIR_TKT, invoiceVO.getAirTicketAmt(), invoiceVO.getAirTicketAmt(), 1, EInvoiceConstant.CLASS_CODE_OTHERS);
		InvoiceItemVO voucherItemVO = generateInvoiceItemVO(EInvoiceConstant.LINE_ITM_DESC_VOUCHER, invoiceVO.getVoucherAmt(), invoiceVO.getVoucherAmt(), 1, EInvoiceConstant.CLASS_CODE_VOUCHER);
		/********* Code Refactoring - End *********/
		
//		InvoiceItemVO tourFareItemVO = new InvoiceItemVO();
//		InvoiceItemVO airTicketItemVO = new InvoiceItemVO();
//		InvoiceItemVO voucherItemVO = new InvoiceItemVO();
		
//		tourFareItemVO.setDesc(EInvoiceConstant.LINE_ITM_DESC_TOUR_FARE);
//		airTicketItemVO.setDesc(EInvoiceConstant.LINE_ITM_DESC_AIR_TKT);
//		voucherItemVO.setDesc(EInvoiceConstant.LINE_ITM_DESC_VOUCHER);
		
//		tourFareItemVO.setAmount(invoiceVO.getTourFareAmt());
//		airTicketItemVO.setAmount(invoiceVO.getAirTicketAmt());
//		voucherItemVO.setAmount(invoiceVO.getVoucherAmt());
		
//		tourFareItemVO.setUnitPrice(tourFareItemVO.getAmount()); 
//		tourFareItemVO.setQty(1);
//		tourFareItemVO.setClassificationCode(EInvoiceConstant.CLASS_CODE_OTHERS);
//		airTicketItemVO.setUnitPrice(airTicketItemVO.getAmount()); 
//		airTicketItemVO.setQty(1);
//		airTicketItemVO.setClassificationCode(EInvoiceConstant.CLASS_CODE_OTHERS);
//		voucherItemVO.setUnitPrice(voucherItemVO.getAmount()); 
//		voucherItemVO.setQty(1);
//		voucherItemVO.setClassificationCode(EInvoiceConstant.CLASS_CODE_VOUCHER);
		
		apiItemList.add(tourFareItemVO);
		apiItemList.add(airTicketItemVO);
		apiItemList.add(voucherItemVO);
		
		for (InvoiceItemVO invoiceItemVO : apiItemList) {
			InvoiceLineType invoiceLineType = generateInvoiceLineType(invoiceItemVO);
			invoiceType.addInvoiceLine(invoiceLineType);
		}
		
		invoiceVO.setInvoiceType(invoiceType);
		
		return invoiceType;
	}
	
	public InvoiceType generateSelfBilledInvoiceType(ExOrderBillVO exOrderBillVO, SupplierVO supplierVO, List<SupplierVO> supplierList, AcctTransVO acctTransVO) throws BusinessException {
		
		String bpPrefixVal = LookupItemUtils.getSysNumGenVO(exOrderBillVO.getCompanyId(), CommonConstant.SYS_NUM_CD_PURC_BILL).getPrefixid();

		InvoiceType invoiceType = new InvoiceType();
		
		invoiceType.setID(String.valueOf(exOrderBillVO.getId()));
		invoiceType.setID(bpPrefixVal + " " + exOrderBillVO.getCode());
//		invoiceType.setID("00001");
//		invoiceType.setIssueDate(exOrderBillVO.getBillDt().toInstant().atZone(ZoneOffset.UTC).toLocalDate());
//		invoiceType.setIssueTime(exOrderBillVO.getBillDt().toInstant().atZone(ZoneOffset.UTC).toLocalTime());
		Date d = new Date();
		invoiceType.setIssueDate(d.toInstant().atZone(ZoneOffset.UTC).toLocalDate());
		invoiceType.setIssueTime(d.toInstant().atZone(ZoneOffset.UTC).toLocalTime().withSecond(0).withNano(0));

		invoiceType.setInvoiceTypeCode(EInvoiceConstant.E_INV_TYPE_S_B_INVOICE);
		invoiceType.getInvoiceTypeCode().setListVersionID("1.0");
		
		invoiceType.setDocumentCurrencyCode("MYR");
		invoiceType.setTaxCurrencyCode("MYR");
		
		supplierVO = purchaseEOBO.getSupplier(supplierVO.getPersonId());
		if (exOrderBillVO.getIdPayee() != null) {
			supplierVO = purchaseEOBO.getPayeeAsSupplier(exOrderBillVO.getIdPayee());
		}
		
		if (StringUtils.isBlank(supplierVO.getMsicCode())) {
			throw new BusinessException(CommonErrConstant.ERR_SUPPLIER_NO_MSIC);
		}
		
		SupplierPartyType supplierPartyType = new SupplierPartyType();
		
		PartyType partyType = new PartyType();
		partyType.setIndustryClassificationCode(supplierVO.getMsicCode());
		partyType.getIndustryClassificationCode().setName(LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_E_INV_MSIC_CODE, supplierVO.getMsicCode()));
		
		if (StringUtils.isBlank(supplierVO.getAdd1())) {
			throw new BusinessException(CommonErrConstant.ERR_SUPPLIER_NO_ADDR1);
		}
		if (StringUtils.isBlank(supplierVO.getCity())) {
			throw new BusinessException(CommonErrConstant.ERR_SUPPLIER_NO_CITY);
		}
		
		partyType.addPartyIdentification(generateTINPartyIdentificationType(exOrderBillVO));
		partyType.addPartyIdentification(generatePartyIdentificationType(exOrderBillVO, supplierVO));
		
		AddressType addressType = new AddressType();
		addressType.setCityName(supplierVO.getCity());
		addressType.setPostalZone(supplierVO.getPostcode());
		
		if (StringUtils.isBlank(supplierVO.getState())) {
			addressType.setCountrySubentityCode(EInvoiceConstant.STATE_CD_NA); // https://sdk.myinvois.hasil.gov.my/codes/state-codes/
		} else {
			boolean found = false;
			for (MalaysiaStateVO stateVO : malaysiaStateBO.getStateList()) {
				if (stateVO.getName().toLowerCase().equals(supplierVO.getState().toLowerCase())) {
					addressType.setCountrySubentityCode(stateVO.geteInvoiceStateCode());
					found = true;
				}
			}
			if (!found) {
				addressType.setCountrySubentityCode(EInvoiceConstant.STATE_CD_NA);
			}
		}
		
		AddressLineType addressLineType1 = new AddressLineType();
		addressLineType1.setLine(new LineType(supplierVO.getAdd1()));
		addressType.addAddressLine(addressLineType1);
		
		AddressLineType addressLineType2 = new AddressLineType();
		addressLineType2.setLine(new LineType(supplierVO.getAdd2()));
		addressType.addAddressLine(addressLineType2);
		
		AddressLineType addressLineType3 = new AddressLineType();
		addressLineType3.setLine(new LineType(supplierVO.getAdd3()));
		addressType.addAddressLine(addressLineType3);
		
		// Country & State
		CountryVO countryVO = supplierVO.getCountryVO();
		if (countryVO == null) {
			throw new BusinessException(CommonErrConstant.ERR_SUPPLIER_NO_COUNTRY);
		} else {
			if (StringUtils.isBlank(countryVO.getThreeLetterCode())) {
				throw new BusinessException(CommonErrConstant.ERR_SUPPLIER_COUNTRY_NO_ALPHA3_CODE);
			}
			IdentificationCodeType identificationCodeType1 = new IdentificationCodeType(countryVO.getThreeLetterCode());
			identificationCodeType1.setListID("ISO3166-1");
			identificationCodeType1.setListAgencyID("6");
			
			CountryType countryType1 = new CountryType();
			countryType1.setIdentificationCode(identificationCodeType1);
			addressType.setCountry(countryType1);
		}
		
		partyType.setPostalAddress(addressType);
		
		String supplierName = supplierVO.getFullName(); // if is attached user, then won't match any supplier
														// user already set full name into supplier
		for (SupplierVO vo : supplierList) {
			if (vo.getId().equals(supplierVO.getId())) {
				supplierName = vo.getFullName();
			}
		}
		
//		System.out.println("CYY supplierName: " + supplierName);
		
		PartyLegalEntityType partyLegalEntityType = new PartyLegalEntityType();
		partyLegalEntityType.setRegistrationName(supplierName);
		partyType.addPartyLegalEntity(partyLegalEntityType);
		
		ContactType contactType = new ContactType();
//		contactType.setTelephone("+60-123456789");
		
		if (StringUtils.isBlank(supplierVO.getContactNo())) {
			throw new BusinessException(CommonErrConstant.ERR_SUPPLIER_NO_CONTACT);
		}
		contactType.setTelephone(supplierVO.getContactNo().replaceAll("[^0-9]", ""));
		
		if (StringUtils.isNotBlank(supplierVO.getEmail())) {
			if (!FunctionUtils.isValidEmail(supplierVO.getEmail())) {
				throw new BusinessException(CommonErrConstant.ERR_SUPPLIER_EMAIL_INVALID);
			}
		}
		contactType.setElectronicMail(supplierVO.getEmail());
		partyType.setContact(contactType);
		
		supplierPartyType.setParty(partyType);
		invoiceType.setAccountingSupplierParty(supplierPartyType);
		
		CompanyVO companyVO = corporateProfileBO.getCompanyDetails(exOrderBillVO.getCompanyId());
		
		CustomerPartyType customerPartyType = new CustomerPartyType();
		customerPartyType.setParty(generateCompanyPartyType(companyVO, malaysiaStateBO.getStateList(), regionBO.getCountryById(companyVO.getCompanyAddressVO().getCountryid())));
		invoiceType.setAccountingCustomerParty(customerPartyType);
		
		// No tax for now
		invoiceType.addTaxTotal(generateNoTaxTotalType());
		
		invoiceType.setLegalMonetaryTotal(generateMonetaryTotalType(exOrderBillVO.getBillAmt()));
		
		for (AcctTransVO acctTransVO1: acctTransVO.getAcctTransList()) {
			
			if (StringUtils.isBlank(acctTransVO1.geteInvoiceClassCode())) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {"Classification code missing for General Ledger Account."});
			}
			
			InvoiceLineType invoiceLineType = generateInvoiceLineType(
					String.valueOf(acctTransVO1.getId()), 
					acctTransVO1.geteInvoiceClassCode(), 
					acctTransVO1.getDesc(), 
					acctTransVO1.getDebit().equals(0D) ? acctTransVO1.getCredit() * -1 : acctTransVO1.getDebit(), 
					1, 
					acctTransVO1.getDebit().equals(0D) ? acctTransVO1.getCredit() * -1 : acctTransVO1.getDebit());
			
			invoiceType.addInvoiceLine(invoiceLineType);
		}
		
		exOrderBillVO.setInvoiceType(invoiceType);
		
		return invoiceType;
	}
	
	/**
	 * call corporateProfileBO.getCompanyDetails(idCompany) to ensure all company details existed
	 * 
	 * @param consolidateInvoiceList
	 * @param companyVO
	 * @return
	 * @throws BusinessException 
	 */
	public InvoiceType generateConsolidateInvoiceType(List<InvoiceVO> consolidateInvoiceList, CompanyVO companyVO) throws BusinessException {
		
//		System.out.println("EInvoiceUtils.generateConsolidateInvoiceType()");
//		for (InvoiceVO vo : consolidateInvoiceList) {
//			System.out.println(vo.getCode());
//		}
		
		InvoiceType invoiceType = new InvoiceType();
		
		String invPrefixVal = LookupItemUtils.getSysNumGenVO(companyVO.getId(), CommonConstant.SYS_NUM_CD_INVC).getPrefixid();

		invoiceType.setID(invPrefixVal + " " + genConsolInvCdForInv(consolidateInvoiceList, eInvoiceBO, companyVO.getId()));
		
		invoiceType.setIssueDate(new Date().toInstant().atZone(ZoneOffset.UTC).toLocalDate());
		invoiceType.setIssueTime(new Date().toInstant().atZone(ZoneOffset.UTC).toLocalTime().truncatedTo(java.time.temporal.ChronoUnit.SECONDS).minusSeconds(5));

		invoiceType.setInvoiceTypeCode(EInvoiceConstant.E_INV_TYPE_INVOICE);
		invoiceType.getInvoiceTypeCode().setListVersionID("1.0");
		
		invoiceType.setDocumentCurrencyCode("MYR");
		invoiceType.setTaxCurrencyCode("MYR");
		
		SupplierPartyType supplierPartyType = new SupplierPartyType();
		
		supplierPartyType.setParty(generateCompanyPartyType(companyVO, malaysiaStateBO.getStateList(),
				regionBO.getCountryById(companyVO.getCompanyAddressVO().getCountryid())));
		invoiceType.setAccountingSupplierParty(supplierPartyType);
		
		CustomerPartyType customerPartyType = new CustomerPartyType();
		customerPartyType.setParty(generateConsolidatePartyType());
		invoiceType.setAccountingCustomerParty(customerPartyType);
		
		BigDecimal total = BigDecimal.valueOf(0);
		
		for (InvoiceVO invoiceVO : consolidateInvoiceList) {			
			InvoiceLineType invoiceLineType = generateInvoiceLineType(invPrefixVal + " " + invoiceVO.getCode(), EInvoiceConstant.CLASS_CODE_CONSOL_E_INV, invPrefixVal + " " + invoiceVO.getCode(), invoiceVO.getAmount(), 1, invoiceVO.getAmount());
			invoiceType.addInvoiceLine(invoiceLineType);
			
			total = total.add(BigDecimal.valueOf(invoiceVO.getAmount()));
		}
		
		// No tax for now
		invoiceType.addTaxTotal(generateNoTaxTotalType());
		
		invoiceType.setLegalMonetaryTotal(generateMonetaryTotalType(total));
		
		return invoiceType;
	}
	
	/**
	 * call corporateProfileBO.getCompanyDetails(idCompany) to ensure all company details existed
	 * 
	 * @param consolidateInvoiceList
	 * @param companyVO
	 * @return
	 * @throws BusinessException 
	 */
	public InvoiceType generateConsolidateSelfBilledInvoiceType(List<ExOrderBillVO> consolidateBillList, CompanyVO companyVO) throws BusinessException {
		
		InvoiceType invoiceType = new InvoiceType();
		
		String prefixValue = LookupItemUtils.getSysNumGenVO(companyVO.getId(), CommonConstant.SYS_NUM_CD_PURC_BILL).getPrefixid();

		invoiceType.setID(prefixValue + " " + genConsolInvCdForBill(consolidateBillList, eInvoiceBO, companyVO.getId()));
		
		invoiceType.setIssueDate(new Date().toInstant().atZone(ZoneOffset.UTC).toLocalDate());
		invoiceType.setIssueTime(new Date().toInstant().atZone(ZoneOffset.UTC).toLocalTime().truncatedTo(java.time.temporal.ChronoUnit.SECONDS));

		invoiceType.setInvoiceTypeCode(EInvoiceConstant.E_INV_TYPE_S_B_INVOICE);
		invoiceType.getInvoiceTypeCode().setListVersionID("1.0");
		
		invoiceType.setDocumentCurrencyCode("MYR");
		invoiceType.setTaxCurrencyCode("MYR");
		
		// supplier
		SupplierPartyType supplierPartyType = new SupplierPartyType();		
		supplierPartyType.setParty(generateConsolidatePartyType());
		invoiceType.setAccountingSupplierParty(supplierPartyType);
		
		// buyer
		CustomerPartyType customerPartyType = new CustomerPartyType();
		customerPartyType.setParty(generateCompanyPartyType(companyVO, malaysiaStateBO.getStateList(),
				regionBO.getCountryById(companyVO.getCompanyAddressVO().getCountryid())));
		invoiceType.setAccountingCustomerParty(customerPartyType);
		
		BigDecimal total = BigDecimal.valueOf(0);
		
		for (ExOrderBillVO exOrderBillVO : consolidateBillList) {
			InvoiceLineType invoiceLineType = generateInvoiceLineType(exOrderBillVO, prefixValue);
			invoiceType.addInvoiceLine(invoiceLineType);
						
			total = total.add(BigDecimal.valueOf(exOrderBillVO.getBillAmt()));
		}
		
		// No tax for now
		invoiceType.addTaxTotal(generateNoTaxTotalType());
		
		invoiceType.setLegalMonetaryTotal(generateMonetaryTotalType(total));
		
		return invoiceType;
	}
	
	public InvoiceType generateCreditNoteType(InvoiceVO invoiceVO, CompanyVO companyVO, InvoiceVO cnInvoiceVO) throws BusinessException {
		
		String cnPrefixVal = LookupItemUtils.getSysNumGenVO(companyVO.getId(), CommonConstant.SYS_NUM_CD_CRDT_NOTE).getPrefixid();
		String invPrefixVal = LookupItemUtils.getSysNumGenVO(companyVO.getId(), CommonConstant.SYS_NUM_CD_INVC).getPrefixid();		
		InvoiceType invoiceType = new InvoiceType();
		
		invoiceType.setID(cnPrefixVal + " " + invoiceVO.getCode());
		
		// E-Invoice issue date based on submission date, instead of inv date
		Date d = new Date();
		invoiceType.setIssueDate(d.toInstant().atZone(ZoneOffset.UTC).toLocalDate());
		invoiceType.setIssueTime(d.toInstant().atZone(ZoneOffset.UTC).toLocalTime().withNano(0).minusMinutes(1));

		invoiceType.setInvoiceTypeCode(EInvoiceConstant.E_INV_TYPE_CREDIT_NOTE);
		invoiceType.getInvoiceTypeCode().setListVersionID("1.0");
		
		invoiceType.setDocumentCurrencyCode("MYR");
		invoiceType.setTaxCurrencyCode("MYR");
		
		// CN refering Invoice No - Start
		invoiceType.addBillingReference(generateBillingReferenceType(cnInvoiceVO, invPrefixVal));
		// CN refering Invoice No - End
		
		invoiceVO.setCompanyVO(companyVO);
		
		SupplierPartyType supplierPartyType = new SupplierPartyType();
		supplierPartyType.setParty(generateCompanyPartyType(companyVO, malaysiaStateBO.getStateList(),
				regionBO.getCountryById(invoiceVO.getCompanyVO().getCompanyAddressVO().getCountryid())));
		invoiceType.setAccountingSupplierParty(supplierPartyType);
		
		CustomerPartyType customerPartyType = new CustomerPartyType();
		
		/********* Code Refactoring - Start *********/
		// (remove code above if new code stable)
		// add condition: when is individual e-invoice, then only check customer details (2025.06.10)
		// add condition: when ref inv before 2025, treat as individual CN (2025.06.11 2.48pm)
		EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.getEInvoiceByUUID(cnInvoiceVO.geteInvoiceDocumentUuid());
		if (eInvoiceDocumentVO != null && !eInvoiceDocumentVO.getIsConsolEInv()) {
			CountryVO countryVO2 = null;
			if (invoiceVO.getCustDetailsVO().getCustType().equals("P")) {
				countryVO2 = regionBO.getCountryById(invoiceVO.getCustDetailsVO().getAddressVO().getCountryId());
			} else if (invoiceVO.getCustDetailsVO().getCustType().equals("C")) {
				countryVO2 = regionBO.getCountryById(invoiceVO.getCustDetailsVO().getCorAddressVO().getCountryId());
			}
			customerPartyType.setParty(generatePartyType(invoiceVO.getCustDetailsVO(), countryVO2, malaysiaStateBO.getStateList()));
		}
		/********* Code Refactoring - End *********/
		invoiceType.setAccountingCustomerParty(customerPartyType);
		
		// No tax for now
		invoiceType.addTaxTotal(generateNoTaxTotalType());
//		TaxTotalType taxTotalType = new TaxTotalType();
//		taxTotalType.setTaxAmount(BigDecimal.valueOf(0.0)); // Total amount of tax payable
//		taxTotalType.getTaxAmount().setCurrencyID("MYR");
//		
//		TaxSubtotalType taxSubtotalType = new TaxSubtotalType();
//		taxSubtotalType.setTaxableAmount(BigDecimal.valueOf(0));
//		taxSubtotalType.getTaxableAmount().setCurrencyID("MYR");
//		taxSubtotalType.setTaxAmount(BigDecimal.valueOf(0));
//		taxSubtotalType.getTaxAmount().setCurrencyID("MYR");
//		
//		TaxCategoryType taxCategoryType = new TaxCategoryType();
//		taxCategoryType.setID("06");
//		
//		TaxSchemeType taxSchemeType = new TaxSchemeType();
//		taxSchemeType.setID("OTH");
//		taxSchemeType.getID().setSchemeID("UN/ECE 5153");
//		taxSchemeType.getID().setSchemeAgencyID("6");
//		taxCategoryType.setTaxScheme(taxSchemeType);
//		
//		taxSubtotalType.setTaxCategory(taxCategoryType);
//		taxTotalType.addTaxSubtotal(taxSubtotalType);
//		invoiceType.addTaxTotal(taxTotalType);
		
		invoiceType.setLegalMonetaryTotal(generateMonetaryTotalType(invoiceVO.getAmount() - invoiceVO.getRefundAmt()));
//		MonetaryTotalType monetaryTotalType = new MonetaryTotalType();
//		monetaryTotalType.setTaxExclusiveAmount(BigDecimal.valueOf(invoiceVO.getAmount() - invoiceVO.getRefundAmt())); // Y
//		monetaryTotalType.getTaxExclusiveAmount().setCurrencyID("MYR");
//		monetaryTotalType.setTaxInclusiveAmount(BigDecimal.valueOf(invoiceVO.getAmount() - invoiceVO.getRefundAmt())); // Y
//		monetaryTotalType.getTaxInclusiveAmount().setCurrencyID("MYR");
//		monetaryTotalType.setPayableAmount(BigDecimal.valueOf(invoiceVO.getAmount() - invoiceVO.getRefundAmt())); // Y
//		monetaryTotalType.getPayableAmount().setCurrencyID("MYR");
//		
//		invoiceType.setLegalMonetaryTotal(monetaryTotalType);
		
		List<InvoiceItemVO> apiItemList = new ArrayList<InvoiceItemVO>();
		InvoiceItemVO tourFareItemVO = new InvoiceItemVO();
		InvoiceItemVO airTicketItemVO = new InvoiceItemVO();
		InvoiceItemVO voucherItemVO = new InvoiceItemVO();
		
		tourFareItemVO.setDesc(EInvoiceConstant.LINE_ITM_DESC_TOUR_FARE);
		airTicketItemVO.setDesc(EInvoiceConstant.LINE_ITM_DESC_AIR_TKT);
		voucherItemVO.setDesc(EInvoiceConstant.LINE_ITM_DESC_VOUCHER);
		
		tourFareItemVO.setAmount(0.0);
		airTicketItemVO.setAmount(0.0);
		voucherItemVO.setAmount(0.0);
		
		for (InvoiceItemVO invoiceItemVO : invoiceVO.getInvoiceItemList()) {
			InvoiceAndExchangeOrderVO invoiceAndExchangeOrderVO = null;
			if (invoiceItemVO.getInvEOItemId() != null) {
				invoiceAndExchangeOrderVO = invoiceAndExchangeOrderBO.getInvoiceAndExchangeOrderVO(invoiceItemVO.getInvEOItemId());
			} else if (StringUtils.isNotBlank(invoiceItemVO.getCode())) {
				invoiceAndExchangeOrderVO = invoiceAndExchangeOrderBO.getInvoiceAndExchangeOrderVO(invoiceItemVO.getCode());
			}
			
			BigDecimal ttlAftRfndAmt = new BigDecimal(invoiceItemVO.getAmount()).subtract(new BigDecimal(invoiceItemVO.getRefundAmt()));
			if (invoiceAndExchangeOrderVO != null) {
				if (invoiceAndExchangeOrderVO.getTypeCd().equals(ProductConstant.INV_ITM_TYPE_AIRLINE)
						|| invoiceAndExchangeOrderVO.getCatCd().equals(ProductConstant.INV_ITM_CAT_AIRLINE)) {
//					System.out.println("CYY " + EInvoiceConstant.LINE_ITM_DESC_AIR_TKT + " " + invoiceItemVO.getDesc() + " - " + invoiceItemVO.getAmount() + " - ");
					BigDecimal ttlAmt = new BigDecimal(airTicketItemVO.getAmount()).add(ttlAftRfndAmt);
					airTicketItemVO.setAmount(ttlAmt.doubleValue());
				} else if (invoiceAndExchangeOrderVO.getCatCd().equals(ProductConstant.INV_ITM_CAT_VOUCHER)) {
//					System.out.println("CYY " + EInvoiceConstant.LINE_ITM_DESC_VOUCHER + " " + invoiceItemVO.getDesc() + " - " + invoiceItemVO.getAmount() + " - ");
					BigDecimal ttlAmt = new BigDecimal(voucherItemVO.getAmount()).add(ttlAftRfndAmt);
					voucherItemVO.setAmount(ttlAmt.doubleValue());
				} else {
//					System.out.println("CYY " + EInvoiceConstant.LINE_ITM_DESC_TOUR_FARE + " " + invoiceItemVO.getDesc() + " - " + invoiceItemVO.getAmount() + " - ");
					BigDecimal ttlAmt = new BigDecimal(tourFareItemVO.getAmount()).add(ttlAftRfndAmt);
					tourFareItemVO.setAmount(ttlAmt.doubleValue());
				}
			} else {
				System.out.println("CYY NO_CAT: " + invoiceItemVO.getDesc());
				BigDecimal ttlAmt = new BigDecimal(tourFareItemVO.getAmount()).add(ttlAftRfndAmt);
				tourFareItemVO.setAmount(ttlAmt.doubleValue());
			}
		}
		
		tourFareItemVO.setUnitPrice(tourFareItemVO.getAmount()); 
		tourFareItemVO.setQty(1);
		tourFareItemVO.setClassificationCode(EInvoiceConstant.CLASS_CODE_OTHERS);
		airTicketItemVO.setUnitPrice(airTicketItemVO.getAmount()); 
		airTicketItemVO.setQty(1);
		airTicketItemVO.setClassificationCode(EInvoiceConstant.CLASS_CODE_OTHERS);
		voucherItemVO.setUnitPrice(voucherItemVO.getAmount()); 
		voucherItemVO.setQty(1);
		voucherItemVO.setClassificationCode(EInvoiceConstant.CLASS_CODE_VOUCHER);
		
		apiItemList.add(tourFareItemVO);
		apiItemList.add(airTicketItemVO);
		apiItemList.add(voucherItemVO);
		
		for (InvoiceItemVO invoiceItemVO : apiItemList) {
			InvoiceLineType invoiceLineType = new InvoiceLineType();
			
			invoiceLineType.setID(String.valueOf(invoiceItemVO.getId()));
			invoiceLineType.setInvoicedQuantity(BigDecimal.valueOf(invoiceItemVO.getQty()));
//			invoiceLineType.getCreditedQuantity().setUnitCode("C62"); // Optional
			
			invoiceLineType.setLineExtensionAmount(BigDecimal.valueOf(invoiceItemVO.getAmount()));
			invoiceLineType.getLineExtensionAmount().setCurrencyID("MYR");
			
			TaxTotalType taxTotalType2 = new TaxTotalType();
			taxTotalType2.setTaxAmount(BigDecimal.valueOf(0));
			taxTotalType2.getTaxAmount().setCurrencyID("MYR");
			
			TaxSubtotalType taxSubtotalType2 = new TaxSubtotalType();
			taxSubtotalType2.setTaxableAmount(BigDecimal.valueOf(0));
			taxSubtotalType2.getTaxableAmount().setCurrencyID("MYR");
			taxSubtotalType2.setTaxAmount(BigDecimal.valueOf(0));
			taxSubtotalType2.getTaxAmount().setCurrencyID("MYR");
			taxSubtotalType2.setPercent(BigDecimal.valueOf(0));
			
			TaxCategoryType taxCategoryType2 = new TaxCategoryType();
			taxCategoryType2.setID("06");
			
			TaxSchemeType taxSchemeType2 = new TaxSchemeType();
			taxSchemeType2.setID("OTH");
			taxSchemeType2.getID().setSchemeID("UN/ECE 5153");
			taxSchemeType2.getID().setSchemeAgencyID("6");
			taxCategoryType2.setTaxScheme(taxSchemeType2);
			
			taxSubtotalType2.setTaxCategory(taxCategoryType2);
			taxTotalType2.addTaxSubtotal(taxSubtotalType2);
			invoiceLineType.addTaxTotal(taxTotalType2);
			
			ItemType itemType = new ItemType();
			CommodityClassificationType commodityClassificationType = new CommodityClassificationType();
			commodityClassificationType.setItemClassificationCode(invoiceItemVO.getClassificationCode());
			commodityClassificationType.getItemClassificationCode().setListID("CLASS");
			itemType.addCommodityClassification(commodityClassificationType);
			
			itemType.addDescription(new DescriptionType(invoiceItemVO.getDesc()));
			
			itemType.setOriginCountry(new CountryType());
			itemType.getOriginCountry().setIdentificationCode("MYS");
			
			invoiceLineType.setItem(itemType);
			
			invoiceLineType.setPrice(new PriceType());
			invoiceLineType.getPrice().setPriceAmount(BigDecimal.valueOf(invoiceItemVO.getUnitPrice()));
			invoiceLineType.getPrice().getPriceAmount().setCurrencyID("MYR");
			invoiceLineType.setItemPriceExtension(new PriceExtensionType());
			invoiceLineType.getItemPriceExtension().setAmount(BigDecimal.valueOf(invoiceItemVO.getAmount()));
			invoiceLineType.getItemPriceExtension().getAmount().setCurrencyID("MYR");
			
			invoiceType.addInvoiceLine(invoiceLineType);
		}
		
		// CN to consol inv (2025.06.09)
//		EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.getEInvoiceByUUID(cnInvoiceVO.geteInvoiceDocumentUuid());
		if (eInvoiceDocumentVO == null || eInvoiceDocumentVO.getIsConsolEInv()) {
			/********* Code Refactoring - Start *********/
			// 2025.06.11 1.42am
			// (remove code above if new code stable)
			populateConsolRefData(invoiceType, cnInvoiceVO.getCode(), eInvoiceDocumentVO, invoiceVO.getAmtAftRefund(), invPrefixVal);
			/********* Code Refactoring - End *********/
		}
		
		invoiceVO.setInvoiceType(invoiceType);
		return invoiceType;
	}
	
	public InvoiceType generateRefundNoteType(InvoiceVO invoiceVO, CompanyVO companyVO, InvoiceVO rnInvoiceVO) throws BusinessException {
		
