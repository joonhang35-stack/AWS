	public void processConsolSubmitResponse(JSONObject submitResponse, List<InvoiceVO> consolidateInvoiceList, String refNo, CompanyVO companyVO, InvoiceType consolidateInvoiceType) throws JSONException, BusinessException {
		
		checkResponseErr(submitResponse);		
		
		String submissionUid = submitResponse.getString("submissionUid");
        JSONArray acceptedDocuments = submitResponse.getJSONArray("acceptedDocuments");
        JSONArray rejectedDocuments = submitResponse.getJSONArray("rejectedDocuments");
       
        if (acceptedDocuments.length() > 0) {
      
        	String documentUuid = acceptedDocuments.getJSONObject(0).getString("uuid");
        	
        	EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.insertConsolidateInvoice(documentUuid, submissionUid, EInvoiceConstant.E_INV_STATUS_SUBMIT, consolidateInvoiceList, EInvoiceConstant.E_INV_DOC_TYPE_INVOICE, CommonConstant.SYS_NUM_CD_INVC, refNo, companyVO.getId());
        	eInvoiceBO.insertDocumentDetails(consolidateInvoiceType, eInvoiceDocumentVO);
        } else {
        	if (rejectedDocuments.length() > 0) {
        		for (int k = 0; k < rejectedDocuments.length(); k++) {
        			JSONObject err = rejectedDocuments.getJSONObject(k).getJSONObject("error");
                	JSONArray details = err.getJSONArray("details");
                	
                	for (int j = 0; j < details.length(); j++) {
                        JSONObject innerErr = details.getJSONObject(j);
        				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {innerErr.getString("message")});
                    }
        		}
        		
        	}
        	throw new BusinessException(CommonErrConstant.ERR_E_INVOICE_API_SUBMISSION_FAILED);
        }
	}
	
