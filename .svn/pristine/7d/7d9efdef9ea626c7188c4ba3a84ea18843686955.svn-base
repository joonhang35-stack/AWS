	public static ApiResponseVO<CRMClaimVoucherResponseVO> claimVoucher(Long idCustomer, List<String> redemptionCodes, int pointsToUse) throws BusinessException { 
		try { 
			URI uri = new URI(SystemProperty.getSystemApiUrl() + SystemProperty.API_CRM_REDEEM_CLAIM); 
			
			JSONObject json = new JSONObject();

			json.put("customerId", Long.toString(idCustomer));
			json.put("redemptionCodes", redemptionCodes);
			if (pointsToUse > 0)	json.put("points", pointsToUse);

			String requestJson = json.toString(); 
			
			System.out.println("############# REQUEST: " + new JSONObject(requestJson).toString(4)); 
			System.out.println("############# uri.toURL(): " + uri.toURL()); 
			
			ApiResponseVO<CRMClaimVoucherResponseVO> response = HttpUtils.openAPIConnection(uri.toURL(), HttpMethod.POST, requestJson, CRMClaimVoucherResponseVO.class); 
			return response;
		} catch (Exception e) { 
			e.printStackTrace(); 
			return null; 
		} 
	}
	
