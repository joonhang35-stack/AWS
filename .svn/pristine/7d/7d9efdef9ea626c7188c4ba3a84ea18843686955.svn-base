	public static List<InvoiceVoucherVO> getEveryoneCanClaimVoucher() throws BusinessException {
		
		List<InvoiceVoucherVO> vList = new ArrayList<InvoiceVoucherVO>();
		
		ApiResponseVO<CRMRedeemCatalogVO> responseVO = CRMUtils.getRedemptionCatalog();
		for (CRMVoucherVO vo : responseVO.getData().getFlatTypes()) {
			if (vo.getEffectiveFrom() == null || vo.getEffectiveUntil() == null || vo.getMinPoints() == null || vo.getMaxPoints() == null)	continue;
			if (DatesUtils.isDateBetween(new Date(), vo.getEffectiveFrom(), vo.getEffectiveUntil())) {
				if (vo.getMinPoints().equals(BigDecimal.ZERO) && vo.getMaxPoints().equals(BigDecimal.ZERO)) {
					vList.add(vo.convertVoucherCatalogToInvoiceVoucherVO());
				}
			}
		}
		
		return vList;
		
	}
	
	private static String generateJson(Gson gson, Object requestVO) throws UnsupportedEncodingException {
		if (gson == null) gson = new GsonBuilder().serializeNulls().setPrettyPrinting().create();
		return gson.toJson(requestVO);
	}
	
	protected static String generateJsonWithAnnotationOnly(Object requestVO) throws UnsupportedEncodingException {
		Gson gson = new GsonBuilder().setDateFormat("yyyy-MM-dd HH:mm:ss").serializeNulls().excludeFieldsWithoutExposeAnnotation().create();
		return generateJson(gson, requestVO);
	}
}
