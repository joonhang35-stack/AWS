<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="ROOMING_LIST_LAND_OPERATOR_CONT" name="RoomingListLandOperatorContVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"></generator>
        </id>
        <property name="idLandOperator" type="long" column="ID_LAND_OPERATOR"/>
        <property name="contactType" type="string" column="CONTACT_TYPE"/>
        <property name="contactNo" type="string" column="CONTACT_NO"/>
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPDATE"/>
		<property name="updatedBy" type="string" column="UPDATED_BY"/>
    </class>

</hibernate-mapping>