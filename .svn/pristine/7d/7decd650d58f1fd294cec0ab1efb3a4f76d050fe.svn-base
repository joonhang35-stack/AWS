package com.bcs.zsg.einvoice.vo;

import java.util.List;

public class ApiGetSubmissionErrorVO {
	
	private String code;
	private String message;
	private String target;
	private List<ApiGetSubmissionErrorVO> details;
	
	public String getCode() {
		return code;
	}
	public void setCode(String code) {
		this.code = code;
	}
	public String getMessage() {
		return message;
	}
	public void setMessage(String message) {
		this.message = message;
	}
	public String getTarget() {
		return target;
	}
	public void setTarget(String target) {
		this.target = target;
	}
	public List<ApiGetSubmissionErrorVO> getDetails() {
		return details;
	}
	public void setDetails(List<ApiGetSubmissionErrorVO> details) {
		this.details = details;
	}
}
