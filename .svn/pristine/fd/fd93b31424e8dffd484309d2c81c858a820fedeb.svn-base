	/**
	 * @param userVO
	 * @param companyVO
	 * @return userId
	 * @throws KeyManagementException
	 * @throws NoSuchAlgorithmException
	 * @throws MalformedURLException
	 * @throws IOException
	 * @throws URISyntaxException
	 * @throws JSONException
	 */
	public static String addKeycloakUser(KeycloakUserVO userVO, CompanyVO companyVO) throws KeyManagementException, NoSuchAlgorithmException, MalformedURLException, IOException, URISyntaxException, JSONException {
		
		// --- create user ---
		
		Gson gson = new Gson();
	    String jsonString = gson.toJson(userVO);
	    System.out.println(jsonString);System.out.println(userVO.getUsername());
	    JSONObject userRepresentation = new JSONObject(jsonString);
	    
	    System.out.println(userRepresentation.toString(4));	// if (!"123".isEmpty()) return new ArrayList<KeycloakUserVO>();

		// --- get access token ---
		KeycloakAccessTokenVO tokenVO = getAccessToken(companyVO);
				
		// URI uri = new URI("http://localhost:8090/realms/myrealm/protocol/openid-connect/token");
		URI uri = new URI(KeycloakProperties.ENV_BASE_URL_SANDBOX +  KeycloakProperties.getAdminUsersApi());
		System.out.println("CYY uri.getPath(): " + uri.getPath());
		System.out.println("CYY uri.getPath(): " + KeycloakProperties.ENV_BASE_URL_SANDBOX);

		// open connection
		HttpURLConnection connection = HttpUtils.openHttpURLConnection(uri.toURL(), HttpUtils.HTTP_POST, tokenVO.getAccessToken(), userRepresentation);
        
		// get response code
		int respCode = connection.getResponseCode();
		System.out.println("CYY respCode: " + respCode);
		
		if (respCode == 201) {
			// success, return userId
			// "Location":["https://uat.applevacations.my:8443/admin/realms/myrealm/users/37696d6f-311e-44a4-96bd-ea74f157ccda"]
			String location = connection.getHeaderField("Location");
	        return location.substring(location.lastIndexOf("/") + 1);
		}

		// get response message from connection
		String response = HttpUtils.getConnectionResponse(connection);

		System.out.println(response);
		System.out.println(new JSONArray(response).toString(4));
		
		return "";
	}
	
	public static KeycloakAccessTokenVO login(String username, String password, String redirectUri, String codeVerifier, CompanyVO companyVO) throws URISyntaxException, KeyManagementException, NoSuchAlgorithmException, MalformedURLException, IOException, JSONException {
		
		System.out.println("KeycloakUtils.login()");
		
		URI uri = new URI(KeycloakProperties.ENV_BASE_URL_SANDBOX + KeycloakProperties.API_LOGIN);
		System.out.println("CYY uri.getPath(): " + uri.getPath());
		System.out.println("CYY uri.getPath(): " + KeycloakProperties.ENV_BASE_URL_SANDBOX);
		
		HttpURLConnection connection = HttpUtils.openAuthAccessTokenHttpsURLConnection(uri.toURL(), HttpUtils.HTTP_POST, buildAuthBody(companyVO, GrantType.PASSWORD, username, password, redirectUri));
		
		int respCode = connection.getResponseCode();
		System.out.println("CYY respCode: " + respCode);
		
		String response = HttpUtils.getConnectionResponse(connection);
		System.out.println("CYY response: " + response);
		
		if (respCode == 200) {
			JSONObject jsonResponse = new JSONObject(response);
			System.out.println(new JSONObject(response).toString(4));
			KeycloakAccessTokenVO tokenVO = gson.fromJson(jsonResponse.toString(), KeycloakAccessTokenVO.class);
			return tokenVO;
		} else {
			return new KeycloakAccessTokenVO();
		}
	}
	
	public static void forgetPassword(String userId, CompanyVO companyVO) throws KeyManagementException, NoSuchAlgorithmException, MalformedURLException, URISyntaxException, IOException, JSONException {
		executeActionsEmail(userId, companyVO, FunctionUtils.toJsonStr(ExecuteActionsEmailType.UPDATE_PASSWORD.getValue()));
	}
	
	public static void sendVerifyEmail(String userId, CompanyVO companyVO) throws KeyManagementException, NoSuchAlgorithmException, MalformedURLException, URISyntaxException, IOException, JSONException {
		executeActionsEmail(userId, companyVO, FunctionUtils.toJsonStr(ExecuteActionsEmailType.VERIFY_EMAIL.getValue()));
	}
	
	public static void executeActionsEmail(String userId, CompanyVO companyVO, String actions) throws KeyManagementException, NoSuchAlgorithmException, MalformedURLException, URISyntaxException, IOException, JSONException {
		
		System.out.println("KeycloakUtils.executeActionsEmail()");
		
		// --- get access token ---
		KeycloakAccessTokenVO tokenVO = getAccessToken(companyVO);
		
		URI uri = new URI(KeycloakProperties.ENV_BASE_URL_SANDBOX + KeycloakProperties.getAdminUsersExecActionsEmailApi(userId));
		System.out.println("CYY uri.getPath(): " + uri.getPath());
		
		HttpURLConnection connection = HttpUtils.openHttpURLConnection(uri.toURL(), HttpUtils.HTTP_PUT, tokenVO.getAccessToken(), actions);
		
		int respCode = connection.getResponseCode();
		System.out.println("CYY respCode: " + respCode);
		
		String response = HttpUtils.getConnectionResponse(connection);
		System.out.println("CYY response: " + response);
		
		if (respCode == 200) {
			JSONObject jsonResponse = new JSONObject(response);
			System.out.println(new JSONObject(response).toString(4));
//			KeycloakAccessTokenVO tokenVO = gson.fromJson(jsonResponse.toString(), KeycloakAccessTokenVO.class);
			return;
		} else {
			return;
		}
	}
	
	public static KeycloakAccessTokenVO exchangeAuthCode(String code, String redirectUri, String codeVerifier, CompanyVO companyVO) throws URISyntaxException, KeyManagementException, NoSuchAlgorithmException, MalformedURLException, IOException, JSONException {
		
		System.out.println("KeycloakUtils.exchangeAuthCode()");
		
		URI uri = new URI(KeycloakProperties.ENV_BASE_URL_SANDBOX + KeycloakProperties.API_LOGIN);
		System.out.println("CYY uri.getPath(): " + uri.getPath());
		System.out.println("CYY uri.getPath(): " + KeycloakProperties.ENV_BASE_URL_SANDBOX);
		
		HttpURLConnection connection = HttpUtils.openAuthAccessTokenHttpsURLConnection(uri.toURL(), HttpUtils.HTTP_POST, buildAuthBody(companyVO, GrantType.AUTH_CODE, code, redirectUri));
		
		int respCode = connection.getResponseCode();
		System.out.println("CYY respCode: " + respCode);
		
		String response = HttpUtils.getConnectionResponse(connection);
		System.out.println("CYY response: " + response);
		
		if (respCode == 200) {
			JSONObject jsonResponse = new JSONObject(response);
			System.out.println(new JSONObject(response).toString(4));
			KeycloakAccessTokenVO tokenVO = gson.fromJson(jsonResponse.toString(), KeycloakAccessTokenVO.class);
			return tokenVO;
		} else {
			return new KeycloakAccessTokenVO();
		}
	}
	
	public static void updateUser(String userId, JSONObject jsonRepresentation, CompanyVO companyVO) throws UnsupportedEncodingException, IOException, JSONException, KeyManagementException, NoSuchAlgorithmException, URISyntaxException {
		
		// get access token
		KeycloakAccessTokenVO tokenVO = getAccessToken(companyVO);
				
		URI uri = new URI(KeycloakProperties.ENV_BASE_URL_SANDBOX +  KeycloakProperties.getAdminUsersApi(userId));
		System.out.println("CYY uri.getPath(): " + uri.getPath());
		System.out.println("CYY uri.getPath(): " + KeycloakProperties.ENV_BASE_URL_SANDBOX);

		// open connection
		HttpURLConnection connection = HttpUtils.openHttpsURLConnection(uri.toURL(), HttpUtils.HTTP_PUT, tokenVO.getAccessToken(), jsonRepresentation);
        
		// get response code
		int respCode = connection.getResponseCode();
		System.out.println("CYY respCode: " + respCode);
		
		if (respCode == 204) {
			// success
			return;
		}

		// get response message from connection
		String response = HttpUtils.getConnectionResponse(connection);

		System.out.println(response);
		System.out.println(new JSONArray(response).toString(4));
		
		return;
	}
	
