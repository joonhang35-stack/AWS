		System.out.println(response);
		System.out.println(new JSONArray(response).toString(4));
		
		return;
	}
	
	public static void manualVerifyEmail(String userId, CompanyVO companyVO) throws UnsupportedEncodingException, IOException, JSONException, KeyManagementException, NoSuchAlgorithmException, URISyntaxException {
		JSONObject jsonObject = new JSONObject();
		jsonObject.put("emailVerified", true);
		updateUser(userId, jsonObject, companyVO);
	}
	
	public static void resetPassword(String userId, String password, CompanyVO companyVO) throws UnsupportedEncodingException, IOException, JSONException, KeyManagementException, NoSuchAlgorithmException, URISyntaxException {
		
		// create CredentialRepresentation object
		KeycloakCredentialRepresentationVO credVO = new KeycloakCredentialRepresentationVO();
		credVO.setType("password");
		credVO.setValue(password);
		credVO.setTemporary(false);
		
		// --- create user ---
		
		Gson gson = new Gson();
	    String jsonString = gson.toJson(credVO);
	    System.out.println(jsonString);
	    JSONObject credentialRepresentation = new JSONObject(jsonString);
	    
	    System.out.println(credentialRepresentation.toString(4));	// if (!"123".isEmpty()) return new ArrayList<KeycloakUserVO>();

		// --- get access token ---
		KeycloakAccessTokenVO tokenVO = getAccessToken(companyVO);
				
		URI uri = new URI(KeycloakProperties.ENV_BASE_URL_SANDBOX +  KeycloakProperties.getAdminUsersResetPasswordApi(userId));
		System.out.println("CYY uri.getPath(): " + uri.getPath());
		System.out.println("CYY uri.getPath(): " + KeycloakProperties.ENV_BASE_URL_SANDBOX);

		// open connection
		HttpURLConnection connection = HttpUtils.openHttpsURLConnection(uri.toURL(), HttpUtils.HTTP_PUT, tokenVO.getAccessToken(), credentialRepresentation);
        
		// get response code
		int respCode = connection.getResponseCode();
		System.out.println("CYY respCode: " + respCode);
		
		if (respCode == 204) {
			// success
			return;
		}

		// get response message from connection
		String response = HttpUtils.getConnectionResponse(connection);

		System.out.println(response);
		System.out.println(new JSONArray(response).toString(4));
		
		return;
	}
	
	/**
	 * http://localhost:8082/bterp/app/maintenance/keycloakCallback
	 * @return
	 */
	public static String getCallbackUrl() {
		StringBuilder sb = new StringBuilder();
		
		sb.append(HttpUtils.getAppBaseUrl())
			.append(KeycloakProperties.CALLBACK);
		
		return sb.toString();
	}
	
	public static void validateKeycloakCredentials(CompanyVO companyVO) throws BusinessException {
		boolean isClientID = !StringUtils.isBlank(companyVO.getKeycloakClientId());
		boolean isClientSecret = !StringUtils.isBlank(companyVO.getKeycloakClientSecret());
		if (!isClientID) {
			throw new BusinessException(CommonErrConstant.ERR_E_INVOICE_API_NO_CLIENT_ID);
		}
		if (!(isClientSecret)) {
			throw new BusinessException(CommonErrConstant.ERR_E_INVOICE_API_NO_CLIENT_SECRET);
		}
	}
	
	public static String buildAuthBody(CompanyVO companyVO, GrantType grantType, String code, String redirectUri) {

	    StringBuilder body = new StringBuilder();

	    body.append("grant_type=").append(grantType.getValue())
	        .append("&client_id=").append(companyVO.getKeycloakClientId())
	        .append("&client_secret=").append(companyVO.getKeycloakClientSecret());

	    if (grantType == GrantType.AUTH_CODE) {
	        body.append("&code=").append(code)
	            .append("&redirect_uri=").append(redirectUri);
	    }

	    return body.toString();
	}
	
	public static String buildAuthBody(CompanyVO companyVO, GrantType grantType, String username, String password, String redirectUri) {

	    StringBuilder body = new StringBuilder();

	    body.append("grant_type=").append(grantType.getValue())
	        .append("&client_id=").append(companyVO.getKeycloakClientId())
	        .append("&client_secret=").append(companyVO.getKeycloakClientSecret());

	    if (grantType == GrantType.AUTH_CODE) {
//	        body.append("&code=").append(code)
//	            .append("&redirect_uri=").append(redirectUri);
	    } else if (grantType == GrantType.PASSWORD) {
	    	body.append("&username=").append(username)
	    		.append("&password=").append(password);
	    }

	    return body.toString();
	}
}
