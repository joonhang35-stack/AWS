	private static Gson DEFAULT_GSON = new Gson();
	private static Gson gson = new GsonBuilder()
            .setFieldNamingPolicy(FieldNamingPolicy.LOWER_CASE_WITH_UNDERSCORES)
            .create();
	
	public static KeycloakAccessTokenVO getAccessToken(CompanyVO companyVO) throws URISyntaxException, KeyManagementException, NoSuchAlgorithmException, MalformedURLException, IOException, JSONException {
		
		// --- get access token ---
		
//		URI uri = new URI("http://localhost:8090/realms/myrealm/protocol/openid-connect/token");
		URI uri = new URI(KeycloakProperties.ENV_BASE_URL_SANDBOX +  KeycloakProperties.API_LOGIN);
		System.out.println("CYY uri.getPath(): " + uri.getPath());
		System.out.println("CYY uri.getPath(): " + KeycloakProperties.ENV_BASE_URL_SANDBOX);
		
		// open connection
		HttpURLConnection connection = HttpUtils.openAuthAccessTokenHttpsURLConnection(uri.toURL(), HttpUtils.HTTP_POST, buildAuthBody(companyVO, GrantType.CLIENT_CREDENTIALS, null, null));
	
		// get response code
		int respCode = connection.getResponseCode();
		System.out.println("CYY respCode: " + respCode);
		
		if (respCode == 200) {
			// get response message from connection
			String response = HttpUtils.getConnectionResponse(connection);
			System.out.println("CYY response: " + response);
		
			JSONObject jsonResponse = new JSONObject(response);
		    System.out.println(jsonResponse.toString(4));
		    
		    KeycloakAccessTokenVO tokenVO = gson.fromJson(response, KeycloakAccessTokenVO.class);
		    
		    return tokenVO;
		} else {
			return new KeycloakAccessTokenVO();
		}
	}
	
	public static KeycloakUserVO getUser(String keycloakUserId, CompanyVO companyVO) throws URISyntaxException, KeyManagementException, NoSuchAlgorithmException, BusinessException, MalformedURLException, IOException, JSONException {
		
		// --- get access token ---
		KeycloakAccessTokenVO tokenVO = getAccessToken(companyVO);
		
//		URI uri = new URI("http://localhost:8090/realms/myrealm/protocol/openid-connect/token");
		URI uri = new URI(KeycloakProperties.ENV_BASE_URL_SANDBOX + KeycloakProperties.getAdminUsersApi(keycloakUserId));
		
		// open connection
		HttpURLConnection connection = HttpUtils.openHttpURLConnection(uri.toURL(), HttpUtils.HTTP_GET, tokenVO.getAccessToken());
	
		// get response code
		int respCode = connection.getResponseCode();
		System.out.println("CYY respCode: " + respCode);
		
		if (respCode == 200) {
			// get response message from connection
			String response = HttpUtils.getConnectionResponse(connection);
			System.out.println("CYY response: " + response);
			System.out.println("CYY response: " + new JSONObject(response).toString(4));
		
			KeycloakUserVO keycloakUserVO = gson.fromJson(response, KeycloakUserVO.class);
			
			return keycloakUserVO;
		} else {
			return new KeycloakUserVO();
		}
	}
	
	public static List<KeycloakUserVO> getUsersByParam(KeycloakUserVO searchParamVO, CompanyVO companyVO) throws URISyntaxException, KeyManagementException, NoSuchAlgorithmException, BusinessException, MalformedURLException, IOException, JSONException {
		
		// --- get access token ---
		KeycloakAccessTokenVO tokenVO = getAccessToken(companyVO);
		
		String url = KeycloakProperties.ENV_BASE_URL_SANDBOX + KeycloakProperties.getAdminUsersApi() + "?";
		if (searchParamVO != null) {
			if (StringUtils.isNotBlank(searchParamVO.getUsername()))	url += "username=" + searchParamVO.getUsername();
			if (StringUtils.isNotBlank(searchParamVO.getEmail()))		url += "email=" + searchParamVO.getEmail();
		}
		
		URI uri = new URI(url);
		
		// open connection
		HttpURLConnection connection = HttpUtils.openHttpURLConnection(uri.toURL(), HttpUtils.HTTP_GET, tokenVO.getAccessToken());
	
		// get response code
		int respCode = connection.getResponseCode();
		System.out.println("CYY respCode: " + respCode);
		
		if (respCode == 200) {
			// get response message from connection
			String response = HttpUtils.getConnectionResponse(connection);
			System.out.println("CYY response: " + response);
			System.out.println("CYY response: " + new JSONArray(response).toString(4));
		
			Type listType = new TypeToken<List<KeycloakUserVO>>() {}.getType();
			List<KeycloakUserVO> userList = DEFAULT_GSON.fromJson(response, listType);
			
			return userList;
		} else {
			return new ArrayList<KeycloakUserVO>();
		}
	}
	
	public static List<KeycloakUserVO> getUsersList(CompanyVO companyVO) throws URISyntaxException, KeyManagementException, NoSuchAlgorithmException, BusinessException, MalformedURLException, IOException, JSONException {
		return getUsersByParam(null, companyVO);
	}
	
