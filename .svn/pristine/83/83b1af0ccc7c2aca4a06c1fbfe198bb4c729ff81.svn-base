<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.purchase.vo">

    <class table="PERSON" name="PersonVO" polymorphism="explicit">
        <id name="Id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="personType" type="string" column="TYPE_CD"/>
        <property name="designation" type="string" column="DESIGNATION"/>
        <property name="salutation" type="string" column="SALUTATION_CD"/>
        <property name="title" type="string" column="title"/>
        <property name="givenName" type="string" column="FIRST_NAME"/>
        <property name="middleName" type="string" column="MIDDLE_NAME"/>
        <property name="lastName" type="string" column="LAST_NAME"/>
        <property name="nickName" type="string" column="NICK_NAME"/>
        <property name="taxIdNo" type="string" column="TAX_ID_NO"/>
        <property name="countryId" type="long" column="ID_COUNTRY"/>
        <property name="sex" type="string" column="SEX_CD"/>
        <property name="race" type="string" column="RACE"/>
        <property name="marriage" type="string" column="MARRIAGE_CD"/>
        <property name="personClass" type="string" column="CLASS_CD"/>
        <property name="insurance" type="string" column="IS_INS_BOUGHT"/>
        <property name="uPoint" type="integer" column="upoint"/>
        <property name="applePoint" type="integer" column="apple_voucher_point"/>
        <property name="email" type="string" column="EMAIL"/>
        <property name="dob" type="timestamp" column="DT_BIRTH"/>
        <property name="age" type="integer" column="AGE"/>
        
        <property name="ecSurname" type="string" column="EC_SURNAME"/>
        <property name="ecGivenName" type="string" column="EC_GIVEN_NAME"/>
        <property name="ecCountry" type="string" column="EC_COUNTRY"/>
        <property name="ecContacts" type="string" column="EC_CONTACT_NO"/>
        <property name="ecEmail" type="string" column="EC_EMAIL"/>
        <property name="ecRelationship" type="string" column="EC_RELATIONSHIP"/>
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>