<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui"
	xmlns:pe="http://primefaces.org/ui/extensions"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	template="/WEB-INF/views/layouts/main.xhtml">

	<ui:define name="content">
	
		<p:panel id="idPanel" header="Update Profile" toggleable="true" toggleSpeed="100">
			<p:messages id="idMsg" autoUpdate="true"/>
		
			<h:form id="idForm">
				<table>
					<tr>
						<td width="300">Member Name:</td>
						<td>#{profileBean.profileVO.userVO.name}</td>
					</tr>
					<tr>
						<td>Card No.:</td>
						<td>#{profileBean.profileVO.cardNo}</td>
					</tr>
					<tr>
						<td>Address 1:</td>
						<td><p:inputText id="idAddr1" value="#{profileBean.profileVO.addr1}" style="width:250px;"/></td>
					</tr>
					<tr>
						<td>Address 2:</td>
						<td><p:inputText id="idAddr2" value="#{profileBean.profileVO.addr2}" style="width:250px;"/></td>
					</tr>
					<tr>
						<td>Postcode:</td>
						<td><p:inputText id="idPostcode" value="#{profileBean.profileVO.postcode}" style="width:250px;"/></td>
					</tr>
					<tr>
						<td>City:</td>
						<td><p:inputText id="idCity" value="#{profileBean.profileVO.city}" style="width:250px;"/></td>
					</tr>
					<tr>
						<td>State:</td>
						<td><p:inputText id="idState" value="#{profileBean.profileVO.state}" style="width:250px;"/></td>
					</tr>
					<tr>
						<td>Mobile No.:</td>
						<td><p:inputText id="idContactM" value="#{profileBean.profileVO.userVO.mobileNumber}" style="width:250px;"/></td>
					</tr>
					<tr>
						<td>Home No.:</td>
						<td><p:inputText id="idContactH" value="#{profileBean.profileVO.telHome}" style="width:250px;"/></td>
					</tr>
					<tr>
						<td>Office No.:</td>
						<td><p:inputText id="idContactO" value="#{profileBean.profileVO.telOffice}" style="width:250px;"/></td>
					</tr>
					<tr>
						<td>BSN Loyalty Newsletter Subscription</td>
						<td><p:selectBooleanCheckbox id="idNewsletter" value="#{profileBean.profileVO.newsletter}"/></td>
					</tr>
				</table>
				<p:commandButton actionListener="#{profileBean.update}" value="Save" update="@form"/>
			</h:form>
		</p:panel>
	</ui:define>
</ui:composition>