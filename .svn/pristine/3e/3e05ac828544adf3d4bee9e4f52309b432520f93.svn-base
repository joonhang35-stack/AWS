package com.bcs.zsg.sales.vo;

import java.util.Date;

import com.bcs.zsg.common.helper.CalcUtils;
import com.bcs.zsg.core.exception.BusinessException;
import com.bcs.zsg.core.vo.BaseVO;

public class InvoiceVoucherVO extends BaseVO {
	private static final long serialVersionUID = 1L;

	private Long idInv;
	private Long idCust;
	
	// Voucher Data (From CRM)
	/**
	 * Claimed Voucher ID
	 */
	private String voucherId;
	private String voucherCode;
	/**
	 * Voucher Description (From CRM/InnoQB)
	 */
	private String voucherDesc;
	private String refVoucherId;
	private String category;
	
	private Date dtRedeem;
	private Integer pointsUsed;
	
	// Self Input Data
	/**
	 * User Self-Input Description
	 */
	private String desc;
	private Integer qty;
	private Double unitPrice;
	private Double amount;
	private Integer seq;
	
	public Double calcAmount() throws BusinessException {
		setAmount(CalcUtils.multiply(qty, unitPrice).doubleValue());
		return amount;
	}
	
	public Long getIdInv() {
		return idInv;
	}
	public void setIdInv(Long idInv) {
		this.idInv = idInv;
	}
	public Long getIdCust() {
		return idCust;
	}
	public void setIdCust(Long idCust) {
		this.idCust = idCust;
	}
	/**
	 * @return Claimed Voucher ID
	 */
	public String getVoucherId() {
		return voucherId;
	}
	/**
	 * @param voucherId Claimed Voucher ID
	 */
	public void setVoucherId(String voucherId) {
		this.voucherId = voucherId;
	}
	public String getVoucherCode() {
		return voucherCode;
	}
	public void setVoucherCode(String voucherCode) {
		this.voucherCode = voucherCode;
	}
	/**
	 * @return Voucher Description (From CRM/InnoQB)
	 */
	public String getVoucherDesc() {
		return voucherDesc;
	}
	/**
	 * @param voucherDesc Voucher Description (From CRM/InnoQB)
	 */
	public void setVoucherDesc(String voucherDesc) {
		this.voucherDesc = voucherDesc;
	}
	public String getRefVoucherId() {
		return refVoucherId;
	}
	public void setRefVoucherId(String refVoucherId) {
		this.refVoucherId = refVoucherId;
	}
	public String getCategory() {
		return category;
	}
	public void setCategory(String category) {
		this.category = category;
	}
	public Date getDtRedeem() {
		return dtRedeem;
	}
	public void setDtRedeem(Date dtRedeem) {
		this.dtRedeem = dtRedeem;
	}
	public Integer getPointsUsed() {
		return pointsUsed;
	}
	public void setPointsUsed(Integer pointsUsed) {
		this.pointsUsed = pointsUsed;
	}
	/**
	 * @return User Self-Input Description
	 */
	public String getDesc() {
		return desc;
	}
	/**
	 * @param desc User Self-Input Description
	 */
	public void setDesc(String desc) {
		this.desc = desc;
	}
	public Integer getQty() {
		return qty;
	}
	public void setQty(Integer qty) {
		this.qty = qty;
	}
	public Double getUnitPrice() {
		return unitPrice;
	}
	public void setUnitPrice(Double unitPrice) {
		this.unitPrice = unitPrice;
	}
	public Double getAmount() {
		return amount;
	}
	public void setAmount(Double amount) {
		this.amount = amount;
	}
	public Integer getSeq() {
		return seq;
	}
	public void setSeq(Integer seq) {
		this.seq = seq;
	}
}
