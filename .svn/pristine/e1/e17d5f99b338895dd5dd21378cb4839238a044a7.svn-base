<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">
	<class table="inv_eo_item" name="InvoiceAndExchangeOrderVO" polymorphism="explicit">
		<id name="id" type="long" column="id">
            <generator class="identity"/>
        </id>
        <property name="companyId" type="long" column="ID_COMPANY"/>
        <property name="catCd" type="string" column="cat_cd"/>
		<property name="typeCd" type="string" column="type_cd"/>
        <property name="code" type="string" column="code"/>
		<property name="description" type="string" column="description"/>
		<property name="acctId" type="long" column="id_acct"/>
		<property name="amount" type="double" column="amount"/>
		<property name="acctMgrUse" type="boolean" column="acct_mgr_use"/>
		<property name="isEditable" type="boolean" column="is_editable"/>
		<property name="isDefAcct" type="boolean" column="is_def_acct"/>
		<property name="invCat" type="string" column="inv_cat"/>
		<property name="taxCode" type="string" column="tax_cd"/>
		<property name="taxRate" type="float" column="tax_rate"/>
		
		<!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
		
	</class>
</hibernate-mapping>