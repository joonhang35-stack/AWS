DELIMITER $$
DROP PROCEDURE IF EXISTS db_upd_3017 $$
CREATE PROCEDURE db_upd_3017()
BEGIN

	DROP TABLE IF EXISTS `tour_pkg_attribute_log`;
	CREATE TABLE IF NOT EXISTS `tour_pkg_attribute_log` AS SELECT * FROM tour_pkg_attribute;
	ALTER TABLE `tour_pkg_attribute_log` ADD ACTION VARCHAR(1) NOT NULL;

END $$

CALL db_upd_3017() $$

DROP PROCEDURE IF EXISTS db_upd_3017 $$
DELIMITER ;

DELIMITER $$
DROP TRIGGER IF EXISTS tour_pkg_attribute_AFTER_INSERT$$
CREATE TRIGGER `tour_pkg_attribute_AFTER_INSERT`
AFTER INSERT ON `tour_pkg_attribute`
FOR EACH ROW
	BEGIN
		INSERT INTO tour_pkg_attribute_log (`id`, `id_tour_pkg`, `tag_type`, `code`, `description`,
			`dt_created`, `created_by`, `dt_update`, `updated_by`, ACTION)
		VALUES (NEW.`id`, NEW.`id_tour_pkg`, NEW.`tag_type`, NEW.`code`, NEW.`description`,
			NEW.`dt_created`, NEW.`created_by`, NEW.`dt_update`, NEW.`updated_by`, 'A');
	END
$$

DELIMITER $$
DROP TRIGGER IF EXISTS tour_pkg_attribute_AFTER_UPDATE$$
CREATE TRIGGER `tour_pkg_attribute_AFTER_UPDATE`
AFTER UPDATE ON `tour_pkg_attribute`
FOR EACH ROW
	BEGIN
		INSERT INTO tour_pkg_attribute_log (`id`, `id_tour_pkg`, `tag_type`, `code`, `description`,
			`dt_created`, `created_by`, `dt_update`, `updated_by`, ACTION)
		VALUES (NEW.`id`, NEW.`id_tour_pkg`, NEW.`tag_type`, NEW.`code`, NEW.`description`,
			NEW.`dt_created`, NEW.`created_by`, NEW.`dt_update`,
			NEW.`updated_by`, 'U');
	END
$$

DELIMITER $$
DROP TRIGGER IF EXISTS tour_pkg_attribute_AFTER_DELETE$$
CREATE TRIGGER `tour_pkg_attribute_AFTER_DELETE`
AFTER DELETE ON `tour_pkg_attribute`
FOR EACH ROW
	BEGIN
		INSERT INTO tour_pkg_attribute_log (`id`, `id_tour_pkg`, `tag_type`, `code`, `description`,
			`dt_created`, `created_by`, `dt_update`, `updated_by`, ACTION)
		VALUES (OLD.`id`, OLD.`id_tour_pkg`, OLD.`tag_type`, OLD.`code`, OLD.`description`,
			OLD.`dt_created`, OLD.`created_by`, OLD.`dt_update`, OLD.`updated_by`, 'D');
	END
$$
DELIMITER ;

