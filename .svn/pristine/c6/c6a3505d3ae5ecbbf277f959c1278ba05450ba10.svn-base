CREATE TABLE feedback_question (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    seq_no INT NOT NULL,
    section_type VARCHAR(100) NOT NULL,
    question_code VARCHAR(100) UNIQUE,

    question_text_en VARCHAR(500),

    question_text_zh VARCHAR(500)
        CHARACTER SET utf8mb4,

    answer_type VARCHAR(50) NOT NULL,
    is_required BOOLEAN DEFAULT FALSE,
    has_remark BOOLEAN DEFAULT FALSE,

    placeholder_en VARCHAR(255),

    placeholder_zh VARCHAR(255)
        CHARACTER SET utf8mb4,

    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
)
DEFAULT CHARSET=latin1;

CREATE TABLE feedback_answer (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    id_feedback_question BIGINT NOT NULL,

    answer_label_en VARCHAR(255)
        CHARACTER SET utf8mb4,

    answer_label_zh VARCHAR(255)
        CHARACTER SET utf8mb4,

    score_value INT,
    seq_no INT NOT NULL,
    is_active BOOLEAN DEFAULT TRUE
)
DEFAULT CHARSET=latin1;

CREATE TABLE feedback (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    id_tour_pkg BIGINT NOT NULL,
    id_tour_dep BIGINT NOT NULL,
    id_invoice BIGINT NOT NULL,
    id_customer BIGINT NOT NULL,
    token_uuid VARCHAR(255) NOT NULL UNIQUE,
    status VARCHAR(50) DEFAULT 'PENDING',
    comments TEXT,
    attachment VARCHAR(500),
    submitted_at TIMESTAMP NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
)
DEFAULT CHARSET=latin1;

CREATE TABLE feedback_cust_answer (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    id_feedback BIGINT NOT NULL,
    id_feedback_question BIGINT NOT NULL,
    id_feedback_answer BIGINT NULL,

    answer_text TEXT
        CHARACTER SET utf8mb4,

    remarks TEXT
        CHARACTER SET utf8mb4,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
)
DEFAULT CHARSET=latin1;


