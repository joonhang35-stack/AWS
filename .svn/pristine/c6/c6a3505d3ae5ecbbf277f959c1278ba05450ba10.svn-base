INSERT INTO invoice_pax_ref_no (
    id_inv_pax,
    ref_type,
    ref_no,
    status_cd,
    dt_created,
    created_by,
    dt_upd,
    upd_by
)
SELECT
    id AS id_inv_pax,          -- invoice_pax.id
    'TK' AS ref_type,          -- Fixed value 'TK'
    ticket_no AS ref_no,       -- invoice_pax.ticket_no
    'A' AS status_cd,          -- Fixed value 'A'
    NOW() AS dt_created,       -- Current timestamp
    'SYSTEM' AS created_by,    -- Fixed value 'SYSTEM'
    NOW() AS dt_upd,           -- Current timestamp
    'SYSTEM' AS upd_by         -- Fixed value 'SYSTEM'
FROM
    invoice_pax
WHERE
    ticket_no IS NOT NULL AND ticket_no != '';     -- Only include rows with a ticket_no

