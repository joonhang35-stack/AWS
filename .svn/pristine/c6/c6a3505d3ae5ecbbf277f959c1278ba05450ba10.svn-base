CREATE TABLE `cruise` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `code` varchar(50) NOT NULL,
  `description` varchar(255) DEFAULT NULL,
  `description_zh` varchar(255) CHARACTER SET utf8 COLLATE utf8_unicode_ci DEFAULT NULL,
  `type_cd` varchar(5) DEFAULT 'A',
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `code_UNIQUE` (`code`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1 COMMENT='Cruise info';

CREATE TABLE `cruise_schedule` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_cruise` bigint NOT NULL,
  `description` varchar(100) NOT NULL COMMENT 'schedule name',
  `remarks` varchar(255) DEFAULT NULL,
  `dt_schedule` datetime DEFAULT NULL COMMENT 'schedule date',
  `tkt_validity` smallint NOT NULL DEFAULT '0',
  `tipping` float(10,2) NOT NULL DEFAULT '0.00',
  `ac` double(10,2) NOT NULL DEFAULT '0.00',
  `visa` double(10,2) NOT NULL DEFAULT '0.00',
  `trvl_ins` double(10,2) NOT NULL DEFAULT '0.00',
  `deviation` double(10,2) NOT NULL DEFAULT '0.00' COMMENT 'deviation charges',
  `fuel_chd` double(10,2) NOT NULL DEFAULT '0.00',
  `fuel_adt` double(10,2) NOT NULL DEFAULT '0.00',
  `apt_chd` double(10,2) NOT NULL DEFAULT '0.00',
  `apt_adt` double(10,2) NOT NULL DEFAULT '0.00',
  `status` tinyint NOT NULL DEFAULT '0' COMMENT '0 = inactive / 1 = active',
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `fk_cruise_schedule_id_cruise` (`id_cruise`),
  CONSTRAINT `fk_cruise_schedule_id_cruise` FOREIGN KEY (`id_cruise`) REFERENCES `cruise` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1 COMMENT='Schedule theme for specified cruise (e.g. schedule 1, schedule 2 and etc.)';

CREATE TABLE `cruise_schedule_charge` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_cruise_schedule` bigint NOT NULL,
  `type_cd` varchar(50) DEFAULT NULL,
  `type_desc` varchar(255) DEFAULT NULL,
  `amount` double(10,2) NOT NULL DEFAULT '0.00',
  `is_misc` tinyint(1) DEFAULT '0',
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `fk_cruise_schedule_charge_id_cruise_schedule` (`id_cruise_schedule`),
  CONSTRAINT `fk_cruise_schedule_charge_id_cruise_schedule` FOREIGN KEY (`id_cruise_schedule`) REFERENCES `cruise_schedule` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1 COMMENT='Cruise schedule charges';

CREATE TABLE `cruise_schedule_item` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_cruise_schedule` bigint NOT NULL,
  `type_cd` varchar(50) NOT NULL COMMENT '**DEP/TRAN/DOM/RTN',
  `from_airport_cd` varchar(50) NOT NULL COMMENT '**KUL/TWN/etc.',
  `to_airport_cd` varchar(50) NOT NULL,
  `flight_cd` varchar(50) NOT NULL,
  `dt_dep` datetime DEFAULT NULL COMMENT 'Departure Date',
  `dt_arr` datetime DEFAULT NULL COMMENT 'Arrival Date',
  `etd` varchar(4) NOT NULL COMMENT 'Estimated time departure - HHmm',
  `eta` varchar(6) NOT NULL COMMENT 'Estimated time arrival - HHmm',
  `is_next_day` tinyint(1) DEFAULT '0' COMMENT 'next day arrival',
  `remarks` varchar(255) DEFAULT NULL,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `fk_cruise_schedule_item_id_cruise_schedule` (`id_cruise_schedule`),
  CONSTRAINT `fk_cruise_schedule_item_id_cruise_schedule` FOREIGN KEY (`id_cruise_schedule`) REFERENCES `cruise_schedule` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1 COMMENT='Multiple details for specified cruise schedule';

CREATE TABLE `cruise_schedule_item_charge` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_cruise_schedule_item` bigint NOT NULL,
  `type_cd` varchar(50) DEFAULT NULL,
  `type_desc` varchar(255) DEFAULT NULL,
  `amount` double(10,2) NOT NULL DEFAULT '0.00',
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `fk_cruise_schedule_item_charge_id_cruise_schedule_item` (`id_cruise_schedule_item`),
  CONSTRAINT `fk_cruise_schedule_item_charge_id_cruise_schedule_item` FOREIGN KEY (`id_cruise_schedule_item`) REFERENCES `cruise_schedule_item` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1 COMMENT='Cruise schedule item charges';

