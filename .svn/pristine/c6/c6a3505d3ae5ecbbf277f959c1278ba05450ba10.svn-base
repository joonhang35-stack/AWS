alter table ex_order_bill add column payee_type varchar(10) after id_payee;
alter table ex_order_bill_log add column id_payee bigint after id_supplier;
alter table ex_order_bill_log add column id_journal bigint after id_tour_dep;
alter table ex_order_bill_log add column payee_type varchar(10) after id_payee;
alter table ex_order_bill_log add column is_e_invoice tinyint(1) default 1 after tax_code_group;
alter table ex_order_bill_log add column e_invoice_submission_uid varchar(50) after is_e_invoice;
alter table ex_order_bill_log add column e_invoice_document_uuid varchar(50) after e_invoice_submission_uid;
alter table ex_order_bill_log add column e_invoice_status varchar(20) default 'Not Submitted' after e_invoice_document_uuid;
alter table ex_order_bill add index idx_id_payee (id_payee);
alter table ex_order_bill add index idx_payee_type (payee_type);

CREATE or replace VIEW vw_payee AS
SELECT 'E' AS payee_type, e.id as id_payee, if(TRIM(COALESCE(e.full_name, '')) = '', u.USER_NAME, e.full_name) AS payee_name, '' as salutation_cd, if(TRIM(COALESCE(e.full_name, '')) = '', '', u.USER_NAME) as support_name
from employee e left join sec_user u on e.u_sec_user = u.UUID
where e.u_sec_user != 'superman'
UNION ALL
SELECT 'S' AS payee_type, s.id as id_payee, case when c.name <> '' then c.name else concat_ws(' ', p.last_name, p.first_name) end as payee_name, '' as salutation_cd, null as support_name
FROM supplier s left join person p on s.id_person = p.id left join corporate c on c.id_person = p.id
UNION ALL
SELECT 'C' AS payee_type, c.id as id_payee, if(TRIM(COALESCE(c.corporate_name, '')) = '', CONCAT_WS(' ', p.last_name, p.first_name), c.corporate_name) as payee_name, if(c.pc_type_cd = 'P', p.salutation_cd, '') as salutation_cd, null as support_name
FROM customer c left join person p on c.id_pc = p.id left join corporate o on c.pc_type_cd = 'C' AND c.id_corporate = o.id;

DELIMITER $$
DROP TRIGGER IF EXISTS ex_order_bill_AFTER_INSERT$$
CREATE TRIGGER `ex_order_bill_AFTER_INSERT`
AFTER INSERT ON `ex_order_bill`
FOR EACH ROW
	BEGIN

		INSERT INTO ex_order_bill_log (id, id_company, id_eo, id_supplier, id_payee, payee_type, id_acct, id_tour_dep, id_journal, dt_bill, dt_due, code, cn_no, dt_inv, 

			dt_dep, description, status_cd, bill_amt, amt_paid, payment_term, comments, ex_reason, tax_code_group, is_e_invoice, e_invoice_submission_uid, e_invoice_document_uuid, e_invoice_status, dt_created, created_by, 

			dt_upd, upd_by, action) 

		VALUES (NEW.id, NEW.id_company, NEW.id_eo, NEW.id_supplier, NEW.id_payee, NEW.payee_type, NEW.id_acct, NEW.id_tour_dep, NEW.id_journal, NEW.dt_bill, NEW.dt_due, NEW.code, 

			NEW.cn_no, NEW.dt_inv, NEW.dt_dep, NEW.description, NEW.status_cd, NEW.bill_amt, NEW.amt_paid, NEW.payment_term, NEW.comments, 

			NEW.ex_reason, NEW.tax_code_group, NEW.is_e_invoice, NEW.e_invoice_submission_uid, NEW.e_invoice_document_uuid, NEW.e_invoice_status, NEW.dt_created, NEW.created_by, NEW.dt_upd, NEW.upd_by, 'A');

	END
$$

DELIMITER $$
DROP TRIGGER IF EXISTS ex_order_bill_AFTER_UPDATE$$
CREATE TRIGGER `ex_order_bill_AFTER_UPDATE`
AFTER UPDATE ON `ex_order_bill`
FOR EACH ROW
	BEGIN

		INSERT INTO ex_order_bill_log (id, id_company, id_eo, id_supplier, id_payee, payee_type, id_acct, id_tour_dep, id_journal, dt_bill, dt_due, code, cn_no, dt_inv, 

			dt_dep, description, status_cd, bill_amt, amt_paid, payment_term, comments, ex_reason, tax_code_group, is_e_invoice, e_invoice_submission_uid, e_invoice_document_uuid, e_invoice_status, dt_created, created_by, 

			dt_upd, upd_by, action) 

		VALUES (NEW.id, NEW.id_company, NEW.id_eo, NEW.id_supplier, NEW.id_payee, NEW.payee_type, NEW.id_acct, NEW.id_tour_dep, NEW.id_journal, NEW.dt_bill, NEW.dt_due, NEW.code, 

			NEW.cn_no, NEW.dt_inv, NEW.dt_dep, NEW.description, NEW.status_cd, NEW.bill_amt, NEW.amt_paid, NEW.payment_term, NEW.comments, 

			NEW.ex_reason, NEW.tax_code_group, NEW.is_e_invoice, NEW.e_invoice_submission_uid, NEW.e_invoice_document_uuid, NEW.e_invoice_status, NEW.dt_created, NEW.created_by, NEW.dt_upd, NEW.upd_by, 'U');

	END
$$ DELIMITER ;

