	`id`, `id_company`, `id_customer`, `id_acct`, `id_tour_booking`, `dt_inv`, `code`, `doc_type_cd`, `type_cd`, `attn_to`, `cn_inv_no`, `pmnt_type_cd`, `id_saler`,
	`id_tour_dep`, `dt_departure`, `id_issuer`, `id_eo_ref`, `cat_cd`, `order_cd`, `id_saler_tfair`, `is_lock_sp`,  `delivery_cd`, `inv_due`, `gds_booking_ref`, `amount`, `balance`, p_reason, p_action,
	`status_cd`, `is_inv_paid`, `subj_line`, `remarks`,  `internal_remarks`, `note_items`, `note_items_other`, `transferred_date`, `transferred_by`, `original_tc`, `dt_created`, `created_by`, `dt_upd`, `upd_by`, `travel_warrant_chk`,
