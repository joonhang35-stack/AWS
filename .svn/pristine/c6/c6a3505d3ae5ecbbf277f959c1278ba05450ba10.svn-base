ALTER TABLE `supplier` ADD COLUMN `reg_no_old` varchar(20) DEFAULT NULL AFTER `reg_no`;
ALTER TABLE `supplier` ADD COLUMN `sst_reg_no` varchar(20) DEFAULT NULL AFTER `gst_reg_no`;
ALTER TABLE `supplier` ADD COLUMN `msic_code` varchar(20) DEFAULT NULL AFTER `sst_reg_no`;
ALTER TABLE `supplier` ADD COLUMN `contact_no` varchar(20) DEFAULT NULL AFTER `msic_code`;
ALTER TABLE `supplier` ADD COLUMN `email` varchar(20) DEFAULT NULL AFTER `contact_no`;
ALTER TABLE `supplier` ADD COLUMN `passport_no` varchar(50) DEFAULT NULL AFTER `email`;

