  `long_id` varchar(100) DEFAULT NULL,
  `net_amount` double(10,2) DEFAULT NULL,
  `receiver_id` varchar(30) DEFAULT NULL,
  `receiver_id_type` varchar(10) DEFAULT NULL,
  `receiver_name` varchar(100) DEFAULT NULL,
  `receiver_tin` varchar(30) DEFAULT NULL,
  `reject_request_dt` timestamp NULL,
