ALTER TABLE `feedback`
  MODIFY COLUMN `dt_created`  DATETIME DEFAULT NULL            AFTER `status_cd`,
  MODIFY COLUMN `created_by`  VARCHAR(50) DEFAULT 'SYSTEM'     AFTER `dt_created`,
  MODIFY COLUMN `dt_upd`      DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP AFTER `created_by`,
  MODIFY COLUMN `upd_by`      VARCHAR(50) DEFAULT 'SYSTEM'     AFTER `dt_upd`,
  MODIFY COLUMN `dt_submitted`      DATETIME 					AFTER `comments_hos`;
  
ALTER TABLE `feedback`
  MODIFY COLUMN `status` VARCHAR(50) DEFAULT 'PENDING' COMMENT 'P=Pending, E=Emailed, C=Completed';
  
-- FEEDBACK_QUESTION
ALTER TABLE `feedback_question`
  ADD COLUMN `status_cd` VARCHAR(50) DEFAULT 'A' AFTER `is_active`;

ALTER TABLE `feedback_question`
  MODIFY COLUMN `dt_created`  DATETIME DEFAULT NULL                                         AFTER `status_cd`,
  MODIFY COLUMN `created_by`  VARCHAR(50) DEFAULT 'SYSTEM'                                  AFTER `dt_created`,
  MODIFY COLUMN `dt_upd`      DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP AFTER `created_by`,
  MODIFY COLUMN `upd_by`      VARCHAR(50) DEFAULT 'SYSTEM'                                  AFTER `dt_upd`;
  
  -- FEEDBACK ANSWER
ALTER TABLE `feedback_answer`
  ADD COLUMN `status_cd` VARCHAR(50) DEFAULT 'A' AFTER `is_active`;

ALTER TABLE `feedback_answer`
  MODIFY COLUMN `dt_created`  DATETIME DEFAULT CURRENT_TIMESTAMP                             AFTER `status_cd`,
  MODIFY COLUMN `created_by`  VARCHAR(50) DEFAULT 'SYSTEM'                                   AFTER `dt_created`,
  MODIFY COLUMN `dt_upd`      DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP AFTER `created_by`,
  MODIFY COLUMN `upd_by`      VARCHAR(50) DEFAULT 'SYSTEM'                                   AFTER `dt_upd`;
  
  -- FEEBACK SUT ANSWER
  ALTER TABLE `feedback_cust_answer`
  ADD COLUMN `status_cd` VARCHAR(50) DEFAULT 'A' AFTER `remarks`;
  
  -- FEEDBACK ATTACHMENT
ALTER TABLE `feedback_attachment`
  ADD COLUMN `status_cd`   VARCHAR(50)  DEFAULT 'A'                                          AFTER `type`,
  ADD COLUMN `dt_created`  DATETIME     DEFAULT CURRENT_TIMESTAMP                             AFTER `status_cd`,
  ADD COLUMN `created_by`  VARCHAR(50)  DEFAULT 'SYSTEM'                                      AFTER `dt_created`,
  ADD COLUMN `dt_upd`      DATETIME     DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP AFTER `created_by`,
  ADD COLUMN `upd_by`      VARCHAR(50)  DEFAULT 'SYSTEM'                                      AFTER `dt_upd`;
  
ALTER TABLE `feedback_attachment`
  MODIFY COLUMN `type` VARCHAR(50) NOT NULL COMMENT 'hos=Attach by HOS, cust=Attach by Customer';
  
