INSERT INTO `com_ref_data` (`UUID`, `APP_ID`, `CAT_CD`, `REF_CD`, `REF_VALUE`, `REF_DESC`, `SEQ_NO`, `STATUS_CD`, `IS_DEFAULT`, `IS_DISPLAY`, `DT_CREATED`, `CREATED_BY`, `DT_UPD`, `UPD_BY`, `VERSION`)
VALUES
	('U_TOUR_TRVL_INS_MSIG_005', '*', 'TOUR_DEP_ITM_CD', 'TRVL_INS_MSIG_005', 'TRAVEL INSURANCE (MSIG) Exclude Covid-19 Coverage', 'TRAVEL INSURANCE (MSIG) Exclude Covid-19 Coverage', '14', 'A', 'N', 'Y', NOW(), 'SYSTEM', NOW(), 'SYSTEM', '1'),
	('U_TOUR_TRVL_INS_MSIG_006', '*', 'TOUR_DEP_ITM_CD', 'TRVL_INS_MSIG_006', 'TRAVEL INSURANCE (MSIG) Exclude Covid-19 Coverage - Age above 70 years', 'TRAVEL INSURANCE (MSIG) Exclude Covid-19 Coverage - Age above 70 years', '15', 'A', 'N', 'Y', NOW(), 'SYSTEM', NOW(), 'SYSTEM', '1');

update tour_dep_account_code_config set is_editable = 1 where ifnull(code, '') = '';

update tour_dep_account_code_config c
left join inv_eo_item i on i.description = c.description
set c.code = i.code
where c.type_cd = 'TOUR' and c.code is null;

/* end 3.0.202 */

/**
 * 3.0.203
 * Cliff
 * fixed Cruise Pay to Pax Statement didn't collect cruise items
 * fixed edit booked cruise didn't load the discount correctly
 * fixed missing PORT_CHARGES in com_ref_data
 * removed group misc charges in cruise set up
 */

UPDATE `db_tracking` SET version = '3.0.203', dt_upd = NOW() WHERE version LIKE '3.%';

alter table tour_booking_charge_item
	modify column `amount_3` double(10,2) default 0.0;
alter table tour_booking_charge_item
	modify column `amount_4` double(10,2) default 0.0;
alter table tour_booking_charge_item
	modify column `amount_sgl` double(10,2) default 0.0;
alter table tour_booking_charge_item
	modify column `amount_inf` double(10,2) default 0.0;

INSERT INTO `com_ref_data` (`UUID`, `APP_ID`, `CAT_CD`, `REF_CD`, `REF_VALUE`, `REF_DESC`, `SEQ_NO`, `STATUS_CD`, `IS_DEFAULT`, `IS_DISPLAY`, `DT_CREATED`, `CREATED_BY`, `DT_UPD`, `UPD_BY`, `VERSION`)
VALUES
	('U_CRUISE_ITM_CD_PORT_CHARGES', '*', 'CRUISE_ITM_CD', 'PORT_CHARGES', 'PORT CHARGES', '', '9', 'A', 'N', 'Y', NOW(), 'SYSTEM', NOW(), 'SYSTEM', '1');

/* end 3.0.203 */

/**
 * 3.0.204
 * Wey Tsong
 * AWS 158
 * 1. Added a new field at the Edit Tour Departure page called airfare.
 * 2. Added auto calculation where full tour - airfare = ground fare.
 * 3. Added a check button beside Ground only called "Non applicable". When is checked, the whole Ground amount are all grey out
 * and become zero
 * 4. Sales comm temporary hide in the Edit Tour Departure page.
 * 5. In Sales Invoice, added row toggle and row expansion to show tour fare and airfare for the full twn, full sgl, full ctw, full ceb and full cnb.
 */

UPDATE `db_tracking` SET version = '3.0.204', dt_upd = NOW() WHERE version LIKE '3.%';

ALTER TABLE tour_dep
ADD COLUMN `airfare_twn` DOUBLE(10,2) NOT NULL DEFAULT '0.00' AFTER `grnd_cnb`,
ADD COLUMN `airfare_sgl` DOUBLE(10,2) NOT NULL DEFAULT '0.00' AFTER `airfare_twn`,
ADD COLUMN `airfare_ctw` DOUBLE(10,2) NOT NULL DEFAULT '0.00' AFTER `airfare_sgl`,
ADD COLUMN `airfare_ceb` DOUBLE(10,2) NOT NULL DEFAULT '0.00' AFTER `airfare_ctw`,
ADD COLUMN `airfare_cnb` DOUBLE(10,2) NOT NULL DEFAULT '0.00' AFTER `airfare_ceb`,
ADD COLUMN `is_ground_not_applicable` TINYINT(1) NOT NULL DEFAULT '0' COMMENT '0 = No / 1 = Yes' AFTER `airfare_cnb`;

ALTER TABLE tour_dep_item
ADD COLUMN `airfare` DOUBLE(10,2) NOT NULL DEFAULT '0.00' AFTER `amount`;

ALTER TABLE tour_booking_charge_item
ADD COLUMN `airfare` DOUBLE(10,2) NOT NULL DEFAULT '0.00' AFTER `amount`;

ALTER TABLE invoice_item
ADD COLUMN `airfare` DOUBLE(10,2) NOT NULL DEFAULT '0.00' AFTER `amount`;

/* end 3.0.204 */

/**
 * 3.0.205
 * Cliff
 * fixed booking list should not be included cruise list
 * fixed cruise booking list click customer name to show booking
 * fixed port charges label is wrong
 * fixed cruise departure cannot be deleted
 */

UPDATE `db_tracking` SET version = '3.0.205', dt_upd = NOW() WHERE version LIKE '3.%';

/* end 3.0.205 */

/**
 * 3.0.206
 * You Yuan
 * handle invoice to submit to E-Invoice API following new invoice item categorization
 * moved E-Invoice API link to properties file
 * added E-Invoice API submission status to invoice listing
 */

UPDATE `db_tracking` SET version = '3.0.206', dt_upd = NOW() WHERE version LIKE '3.%';

/* end 3.0.206 */

/**
 * 3.0.207
 * Cliff
 * added 3rd/4th child pax for cruise - in progress
 */

UPDATE `db_tracking` SET version = '3.0.207', dt_upd = NOW() WHERE version LIKE '3.%';

