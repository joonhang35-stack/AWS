DROP PROCEDURE IF EXISTS prc_invoice;
DELIMITER $$

CREATE DEFINER=`root`@`localhost` PROCEDURE `prc_invoice`(
    IN `p_id` BIGINT(20),
    IN `p_action` VARCHAR(50),
    IN `p_reason` TEXT
)
BEGIN

  DECLARE v_inv_id bigint(20);
  DECLARE v_inv_item_id bigint(20);
  DECLARE v_inv_pax_id bigint(20);
  DECLARE v_inv_pmnt_id bigint(20);

  INSERT INTO invoice_history (`id_hist`, `id_company`, `id_customer`, `id_acct`, `id_tour_booking`, `dt_inv`, `code`, `doc_type_cd`, `type_cd`, `attn_to`, `cn_inv_no`,
	`pmnt_type_cd`, `id_saler`, `id_tour_dep`, `dt_departure`, `id_issuer`, `id_eo_ref`, `cat_cd`, `order_cd`, `id_saler_tfair`, `is_lock_sp`, `delivery_cd`, `inv_due`, `gds_booking_ref`,
	`amount`, `balance`, `reason`, `action_cd`, `status_cd`, `is_inv_paid`, `subj_line`, `remarks`, `internal_remarks`, `note_items`, `note_items_other`, `transferred_date`, `transferred_by`, `original_tc`, `dt_created`, `created_by`, `dt_upd`, `upd_by`, `travel_warrant_chk`,
    `id_parent_inv`, `id_parent_inv_tour_booking`, `doc_type_status`, `ps_no`, `rn_no`, `refund_amt`, `amt_aft_refund`, `cn_ps_no`, 
    `e_invoice_submission_uid`, `e_invoice_document_uuid`, `e_invoice_status`, `is_consol_e_invoice`, `e_invoice_rn_submission_uid`, `e_invoice_rn_document_uuid`, `e_invoice_rn_status`,
    `sub_ps_running_number`, `version`)
  (SELECT
	`id`, `id_company`, `id_customer`, `id_acct`, `id_tour_booking`, `dt_inv`, `code`, `doc_type_cd`, `type_cd`, `attn_to`, `cn_inv_no`, `pmnt_type_cd`, `id_saler`,
	`id_tour_dep`, `dt_departure`, `id_issuer`, `id_eo_ref`, `cat_cd`, `order_cd`, `id_saler_tfair`, `is_lock_sp`,  `delivery_cd`, `inv_due`, `gds_booking_ref`, `amount`, `balance`, p_reason, p_action,
	`status_cd`, `is_inv_paid`, `subj_line`, `remarks`,  `internal_remarks`, `note_items`, `note_items_other`, `transferred_date`, `transferred_by`, `original_tc`, `dt_created`, `created_by`, `dt_upd`, `upd_by`, `travel_warrant_chk`,
    `id_parent_inv`, `id_parent_inv_tour_booking`, `doc_type_status`, `ps_no`, `rn_no`, `refund_amt`, `amt_aft_refund`, `cn_ps_no`, 
    `e_invoice_submission_uid`, `e_invoice_document_uuid`, `e_invoice_status`, `is_consol_e_invoice`, `e_invoice_rn_submission_uid`, `e_invoice_rn_document_uuid`, `e_invoice_rn_status`,
    `sub_ps_running_number`, `version`
  FROM invoice
  WHERE id = p_id);
  SET v_inv_id := LAST_INSERT_ID();

  
  INSERT INTO invoice_item_history (`id_ref`, `id_hist`, `id_inv`, `id_acct`, `id_inv_eo_item`, `code`, `description`, `id_airline`, `net_price`, `quantity`, `unit_price`, `amount`,
	`status_cd`, `dt_created`, `created_by`, `dt_upd`, `upd_by`, `tax_code`, `tax_rate`, `tax_amount`, `seq`, `is_lock`, `id_acct_ps`, `sub_description`, `airfare`, `refund_amt`)
  (SELECT
	v_inv_id, `id`, `id_inv`, `id_acct`, `id_inv_eo_item`, `code`, `description`, `id_airline`, `net_price`, `quantity`, `unit_price`, `amount`, `status_cd`, `dt_created`, `created_by`,
	`dt_upd`, `upd_by`, `tax_code`, `tax_rate`, `tax_amount`, `seq`, `is_lock`, `id_acct_ps`, `sub_description`, `airfare`, `refund_amt`
  FROM invoice_item
  WHERE id_inv = p_id);
  SET v_inv_item_id := LAST_INSERT_ID();
	
  
  INSERT INTO invoice_pax_history (`id_ref`, `id_hist`, `id_inv`, `id_cust`, `room_type_cd`, `room_pairing_no`, `item_code`, `travel_ins_type`, `travel_ins_policy`, `ticket_no`, `special_request`,
	`lang_cd`, `act_room_type_cd`, `act_room_pairing_no`, `act_room_indicator`, `act_room_remarks`, `act_room_remarks_f`, `status_cd`, `seq`)
  (SELECT
	v_inv_id, `id`, `id_inv`, `id_cust`, `room_type_cd`, `room_pairing_no`, `item_code`, `travel_ins_type`, `travel_ins_policy`, `ticket_no`, `special_request`, `lang_cd`, `act_room_type_cd`,
	`act_room_pairing_no`, `act_room_indicator`, `act_room_remarks`, `act_room_remarks_f`, `status_cd`, `seq`
  FROM invoice_pax
  WHERE id_inv = p_id);
  SET v_inv_pax_id := LAST_INSERT_ID();

  
  INSERT INTO invoice_pmnt_history (`id_ref`, `id_hist`, `id_inv`, `id_issuer`, `id_bank`, `dt_pmnt`, `code`, `pmnt_type_cd`, `ref_no`, `received_from`, `amount`,
	`remarks`, `status_cd`, `dt_created`, `created_by`, `dt_upd`, `upd_by`, `id_inv_pmnt`, `id_cashbook`, `id_credit_note`, `id_parent_pmnt`, `hide_deposit`, `seq`)
  (SELECT
	v_inv_id, `id`, `id_inv`, `id_issuer`, `id_bank`, `dt_pmnt`, `code`, `pmnt_type_cd`, `ref_no`, `received_from`, `amount`, `remarks`, `status_cd`, `dt_created`,
	`created_by`, `dt_upd`, `upd_by`, `id_inv_pmnt`, `id_cashbook`, `id_credit_note`, `id_parent_pmnt`, `hide_deposit`, `seq`
  FROM invoice_pmnt
  WHERE id_inv = p_id);
  SET v_inv_pmnt_id := LAST_INSERT_ID();
select v_inv_id,v_inv_item_id, v_inv_pax_id, v_inv_pmnt_id, LAST_INSERT_ID();
END
$$ DELIMITER ;
