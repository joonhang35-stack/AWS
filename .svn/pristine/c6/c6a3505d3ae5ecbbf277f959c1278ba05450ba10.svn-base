 * - unable apply voucher validation when voucher applied
 * 
 * - pending CRM InnoQB multiple voucher redemption
 */

UPDATE `db_tracking` SET version = '3.0.911', dt_upd = NOW() WHERE version LIKE '3.%';

CREATE TABLE `invoice_voucher` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_inv` bigint COMMENT 'serves as both PS/INV ID',
  `id_cust` bigint NOT NULL,
  `voucher_id` varchar(80) NOT NULL COMMENT 'Claimed Voucher ID',
  `voucher_code` varchar(80) NOT NULL COMMENT 'Voucher Code',
  `voucher_description` varchar(255) COMMENT 'Voucher Description (From CRM/InnoQB)',
  `ref_voucher_id` varchar(80) NOT NULL COMMENT 'Voucher ID',
  `category` varchar(80) NOT NULL COMMENT 'Voucher Category',
  `dt_redeem` datetime NOT NULL,
  `points_used` int not null,
  `description` varchar(255) COMMENT 'User Self-Input Description',
  `quantity` smallint NOT NULL DEFAULT '0',
  `unit_price` double(10,2) NOT NULL DEFAULT '0.00' COMMENT 'Input 1 if N/A',
  `amount` double(10,2) NOT NULL DEFAULT '0.00' COMMENT 'Input 0 if N/A',
  `status_cd` varchar(50) NOT NULL DEFAULT 'A',
  `seq` smallint DEFAULT '0',
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `fk_inv_voucher_id_inv` (`id_inv`),
  KEY `fk_inv_voucher_id_cust` (`id_cust`),
  CONSTRAINT `fk_inv_voucher_id_cust` FOREIGN KEY (`id_cust`) REFERENCES `customer` (`id`),
  CONSTRAINT `fk_inv_voucher_id_inv` FOREIGN KEY (`id_inv`) REFERENCES `invoice` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=latin1;

/* end 3.0.911 */

