/**
 * 3.0.59
 * Sarah
 * online booking customer / passenger tables
 */

-- update db_tracking version
UPDATE `db_tracking` SET version = '3.0.59', dt_upd = NOW();

DELIMITER $$
DROP PROCEDURE IF EXISTS db_upd_3059 $$
CREATE PROCEDURE db_upd_3059()
BEGIN

	CREATE TABLE IF NOT EXISTS `online_booking_customer` (
		`id` INT NOT NULL AUTO_INCREMENT,
		`id_booking` varchar(10) DEFAULT NULL,
		`salutation_cd` varchar(50) DEFAULT NULL COMMENT 'MR/MRS/MS/etc.',
		`surname` varchar(50) NOT NULL,
		`given_name` varchar(50) NOT NULL,
		`nick_name` varchar(50) DEFAULT NULL,
		`sex_cd` varchar(50) DEFAULT NULL COMMENT 'M = Male / F = Female',
		`contact_no` varchar(50) DEFAULT NULL,
		`email` varchar(255) DEFAULT NULL,
		`id_country` bigint(20) DEFAULT NULL,
		`address_line_1` varchar(255) DEFAULT NULL,
		`address_line_2` varchar(255) DEFAULT NULL,
		`postcode` varchar(10) DEFAULT NULL,
		`state` varchar(255) DEFAULT NULL,
		`dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
		`created_by` varchar(50) NOT NULL,
		`dt_upd` datetime NOT NULL,
		`upd_by` varchar(50) NOT NULL,
	  PRIMARY KEY (`id`)
	) ENGINE=InnoDB DEFAULT CHARSET=latin1;

	CREATE TABLE IF NOT EXISTS `online_booking_passenger` (
		`id` INT NOT NULL AUTO_INCREMENT,
		`id_booking` varchar(10) DEFAULT NULL,
		`room_no` smallint(5) DEFAULT NULL,
		`salutation_cd` varchar(50) DEFAULT NULL COMMENT 'MR/MRS/MS/etc.',
		`surname` varchar(50) NOT NULL,
		`given_name` varchar(50) NOT NULL,
		`nick_name` varchar(50) DEFAULT NULL,
		`sex_cd` varchar(50) DEFAULT NULL COMMENT 'M = Male / F = Female',
		`ic_no` varchar(50) DEFAULT NULL,
		`dob` date DEFAULT NULL COMMENT 'date of birth',
		`passport_no` varchar(50) DEFAULT NULL,
		`dt_expiry` date DEFAULT NULL,
		`id_country` bigint(20) DEFAULT NULL,
		`remarks` varchar(255) DEFAULT NULL,
		`dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
		`created_by` varchar(50) NOT NULL,
		`dt_upd` datetime NOT NULL,
		`upd_by` varchar(50) NOT NULL,
        PRIMARY KEY (`id`)
	) ENGINE=InnoDB DEFAULT CHARSET=latin1;

END $$

CALL db_upd_3059() $$

DROP PROCEDURE IF EXISTS db_upd_3059 $$
DELIMITER ;

