DELIMITER $$
CREATE TRIGGER `ex_order_AFTER_INSERT` AFTER INSERT ON `ex_order` FOR EACH ROW
BEGIN
	INSERT INTO `ex_order_log` values (NEW.`id`, NEW.`id_company`, NEW.`id_supplier`, NEW.`id_tour`, NEW.`code`, NEW.`dt_eo`, NEW.`doc_type_cd`, NEW.`type_cd`, NEW.`attn_to`, NEW.`id_orderer`, NEW.`id_approver`, NEW.`id_inv_ref`, NEW.`pmnt_type_cd`, NEW.`cn_no`, NEW.`cat_cd`, NEW.`id_dpt`, NEW.`delivery_cd`, NEW.`dt_supp_inv`, NEW.`status_cd`, NEW.`dt_start`, NEW.`dt_due`, NEW.`dt_tour_dep`, NEW.`reference`, NEW.`amt_due`, NEW.`tot_amt`, NEW.`comments`, NEW.`internal_comments`, NEW.`dt_created`, NEW.`created_by`, NEW.`dt_upd`, NEW.`upd_by`, "ADD");
END$$
DELIMITER ;

DELIMITER $$
CREATE TRIGGER `ex_order_AFTER_UPDATE` AFTER UPDATE ON `ex_order` FOR EACH ROW
BEGIN
	INSERT INTO `ex_order_log` values (NEW.`id`, NEW.`id_company`, NEW.`id_supplier`, NEW.`id_tour`, NEW.`code`, NEW.`dt_eo`, NEW.`doc_type_cd`, NEW.`type_cd`, NEW.`attn_to`, NEW.`id_orderer`, NEW.`id_approver`, NEW.`id_inv_ref`, NEW.`pmnt_type_cd`, NEW.`cn_no`, NEW.`cat_cd`, NEW.`id_dpt`, NEW.`delivery_cd`, NEW.`dt_supp_inv`, NEW.`status_cd`, NEW.`dt_start`, NEW.`dt_due`, NEW.`dt_tour_dep`, NEW.`reference`, NEW.`amt_due`, NEW.`tot_amt`, NEW.`comments`, NEW.`internal_comments`, NEW.`dt_created`, NEW.`created_by`, NEW.`dt_upd`, NEW.`upd_by`, "UPD");
END$$
DELIMITER ;
