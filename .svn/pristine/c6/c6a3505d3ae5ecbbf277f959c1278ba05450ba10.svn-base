CREATE TABLE `tour_cruise_cabin` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_tour_dep` bigint NOT NULL,
  `id_company` bigint NOT NULL DEFAULT '1',
  `id_acct` bigint DEFAULT NULL,
  `cruise_cabin_cd` varchar(10) NOT NULL,
  `cabin_allotment` int NOT NULL DEFAULT '0',
  `pax_per_cabin` int NOT NULL DEFAULT '0',
  `price_twn` double(10,2) NOT NULL DEFAULT '0.00',
  `price_3` double(10,2) NOT NULL DEFAULT '0.00',
  `price_4` double(10,2) NOT NULL DEFAULT '0.00',
  `price_sgl` double(10,2) NOT NULL DEFAULT '0.00',
  `price_inf` double(10,2) NOT NULL DEFAULT '0.00',
  `tour_status_cd` varchar(2) NOT NULL,
  `status_cd` varchar(2) NOT NULL DEFAULT 'A',
  `dt_created` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_id_tour_dep` (`id_tour_dep`),
  KEY `idx_cruise_cabin_cd` (`cruise_cabin_cd`),
  KEY `idx_tour_status_cd` (`tour_status_cd`),
  KEY `idx_status_cd` (`status_cd`),
  KEY `idx_id_acct` (`id_acct`),
  KEY `idx_id_company` (`id_company`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

CREATE TABLE `tour_cruise_cabin_discount` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_cruise_cabin` bigint NOT NULL,
  `discount_amt` double(10,2) NOT NULL DEFAULT '0.00',
  `discount_pax` int NOT NULL DEFAULT '0',
  `dt_created` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_id_cruise_cabin` (`id_cruise_cabin`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

