DELIMITER $$
DROP PROCEDURE IF EXISTS prc_tour_pkg $$
CREATE PROCEDURE `prc_tour_pkg`(IN p_id bigint(20), IN p_action varchar(50), IN p_reason text)
BEGIN

		DECLARE v_tour_pkg_id bigint(20);

		INSERT INTO tour_pkg_history (`id_hist`,`id_tour_theme`,`id_parent`,`type_cd`,`code`,`num_days`,`num_nights`,`name_en`,`name_zh`,
			`name_other`,`is_muslim_pkg`,`is_theme_tour`,`is_top_pkg`,`is_optional`,`is_new`,`is_promo`,`season_cd`,`year`,`deposit`,`bag_deduction`,
			`tfair_discount`,`price_diff_sgl`,`price_diff_ctw`,`price_diff_cwb`,`price_diff_cnb`,`grnd_sgl`,`grnd_ctw`,`grnd_cwb`,`grnd_cnb`,`cna_adt`,`cpa_adt`,
			`csi_adt`,`price_from`,`high_light`,`dt_book_start`,`dt_book_end`,`dt_travel_start`,`dt_travel_end`,`reserved_1`,`reserved_2`,`reserved_3`,`seq`,
			`full_remarks`,`grnd_remarks`, `reason`,`action_cd`,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`)
		(SELECT
			`id`,`id_tour_theme`,`id_parent`,`type_cd`,`code`,`num_days`,`num_nights`,`name_en`,`name_zh`,
			`name_other`,`is_muslim_pkg`,`is_theme_tour`,`is_top_pkg`,`is_optional`,`is_new`,`is_promo`,`season_cd`,`year`,`deposit`,`bag_deduction`,
			`tfair_discount`,`price_diff_sgl`,`price_diff_ctw`,`price_diff_cwb`,`price_diff_cnb`,`grnd_sgl`,`grnd_ctw`,`grnd_cwb`,`grnd_cnb`,`cna_adt`,`cpa_adt`,
			`csi_adt`,`price_from`,`high_light`,`dt_book_start`,`dt_book_end`,`dt_travel_start`,`dt_travel_end`,`reserved_1`,`reserved_2`,`reserved_3`,`seq`,
			`full_remarks`,`grnd_remarks`, p_reason,p_action,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`
		FROM tour_pkg
		WHERE id = p_id);
		SET v_tour_pkg_id := LAST_INSERT_ID();

		INSERT INTO tour_pkg_daily_itinerary_history (`id_ref`, `id_hist`,  `id_tour_pkg`, `code`, `title`, `title_zh`, `highlight`, `highlight_zh`, `gen_remarks`, `gen_remarks_zh`, `seq`,
			`remarks`, `status_cd`, `dt_created`, `created_by`, `dt_update`,  `updated_by`)
		(SELECT v_tour_pkg_id, `id`, `id_tour_pkg`, `code`, `title`, `title_zh`, `highlight`, `highlight_zh`, `gen_remarks`, `gen_remarks_zh`, `seq`,
			`remarks`, `status_cd`, `dt_created`, `created_by`, `dt_update`,  `updated_by`
		FROM tour_pkg_daily_itinerary WHERE `id_tour_pkg` = p_id AND status_cd = 'A');

	    INSERT INTO tour_pkg_daily_itinerary_item_history (`id_ref`, `id_hist`,  `id_tour_pkg_daily_itinerary`, `title`, `description`, `seq`,
			`lang_cd`, `remarks`, `status_cd`, `dt_created`, `created_by`, `dt_update`,  `updated_by`)
		(SELECT v_tour_pkg_id, di.`id`, di.`id_tour_pkg_daily_itinerary`, di.`title`, di.`description`, di.`seq`,
			di.`lang_cd`, di.`remarks`, di.`status_cd`, di.`dt_created`, di.`created_by`, di.`dt_update`,  di.`updated_by`
		FROM tour_pkg_daily_itinerary_item di
	    INNER JOIN tour_pkg_daily_itinerary d ON d.id = di.id_tour_pkg_daily_itinerary
	    WHERE d.id_tour_pkg = p_id AND di.status_cd = 'A');

		select v_tour_pkg_id, LAST_INSERT_ID();
	END$$
DELIMITER ;


ALTER TABLE `tour_pkg_daily_itinerary_history` ADD COLUMN `title_zh` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci DEFAULT NULL AFTER `title`;
ALTER TABLE `tour_pkg_daily_itinerary_history` ADD COLUMN `highlight_zh` text CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci AFTER `highlight`;
ALTER TABLE `tour_pkg_daily_itinerary_history` ADD COLUMN `gen_remarks` text CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci AFTER `highlight_zh`;
ALTER TABLE `tour_pkg_daily_itinerary_history` ADD COLUMN `gen_remarks_zh` text CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci AFTER `gen_remarks`;

