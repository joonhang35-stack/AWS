DELIMITER $$
DROP PROCEDURE IF EXISTS db_upd_3060 $$
CREATE PROCEDURE db_upd_3060()
BEGIN

CREATE TABLE IF NOT EXISTS `online_booking_payment` (
	`id` INT NOT NULL AUTO_INCREMENT,
	`id_booking` bigint(20) NOT NULL,
	`id_ipay_config` bigint(20) NOT NULL,
	`id_invoice` bigint(20) DEFAULT NULL,
	`id_invoice_admin_charges` bigint(20) DEFAULT NULL,
	`prefix_admin_charges` varchar(20) DEFAULT NULL,
	`prefix` varchar(20) DEFAULT NULL,
	`email` varchar(50) NOT NULL,
	`payment_amt` decimal(12,2) DEFAULT '0.00',
	`admin_charges_percentage` decimal(12,2) DEFAULT '0.00',
	`admin_charges` decimal(12,2) DEFAULT '0.00',
	`total_payment_amt` decimal(12,2) DEFAULT '0.00',
	`payment_status` varchar(50) NOT NULL,
	`dt_expiry` datetime DEFAULT NULL,
	`trans_id` varchar(30) DEFAULT NULL,
	`auth_code` varchar(20) DEFAULT NULL,
	`cc_name` varchar(200) DEFAULT NULL,
	`cc_no` varchar(16) DEFAULT NULL,
	`s_bankname` varchar(100) DEFAULT NULL,
	`s_country` varchar(100) DEFAULT NULL,
	`status_cd` varchar(1) NOT NULL,
	`dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
	`created_by` varchar(50) NOT NULL,
	`dt_upd` datetime NOT NULL,
	`upd_by` varchar(50) NOT NULL,
	PRIMARY KEY (`id`),
	KEY `idx_id_invoice` (`id_invoice`),
	KEY `idx_id_invoice_admin_charges` (`id_invoice_admin_charges`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

END $$

