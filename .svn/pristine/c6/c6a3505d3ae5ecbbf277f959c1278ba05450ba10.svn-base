DROP PROCEDURE IF EXISTS prc_tour_dep;
DELIMITER $$

CREATE DEFINER=`root`@`localhost` PROCEDURE prc_tour_dep (
    IN p_id BIGINT(20),
    IN p_action VARCHAR(50),
    IN p_reason TEXT
)
BEGIN
    INSERT INTO tour_dep_history (
        id_hist,id_tour_pkg,seq_no,id_airline,id_airline_schedule,id_tour_operator,id_dpt,num_days,num_nights,dt_dep,code,description,description_zh,lang_cd,
        full_twn,full_sgl,full_ctw,full_ceb,full_cnb,
        grnd_twn,grnd_sgl,grnd_ctw,grnd_ceb,grnd_cnb,
        airfare_twn,airfare_sgl,airfare_ctw,airfare_ceb,airfare_cnb,
        is_ground_not_applicable,
        tour_mgr_cost,tfair_discount,
        cna_adt,cpa_adt,csi_adt,
        misc_adt,misc_chd,
        full_remarks,grnd_remarks,prn,seat_allotment,reserved_seat,reserved_seat_reason,tour_mgr_pax,
        travel_ins_policy_s,travel_ins_policy_f,deadline,
        is_show_airline,is_issued_s,is_issued_f,is_remain_tc,is_deposit_paid,is_push,is_hot_deal,is_push_to_online,is_visa_required,
        is_lock,is_private_tour,inv_remarks,insurance_remarks,
        op_pic,private_pic,
        airline_schedule_items,tour_status_cd,tour_status_reason,tour_pkg_daily_cms,id_pic_user,
        id_cruise,id_cruise_schedule,is_show_cruise,cruise_schedule_items,
        cruise_schdl_itms_w_seq,cruise_schdl_itms_w_etd,cruise_schdl_itms_w_eta,cruise_schdl_itms_w_depDt,cruise_schdl_itms_w_arrDt,cruise_schdl_itms_w_remarks,
        status_cd,dt_created,created_by,dt_upd,upd_by,version,
        airline_schdl_itms_w_seq,airline_schdl_itms_w_etd,airline_schdl_itms_w_eta,airline_schdl_itms_w_depDt,airline_schdl_itms_w_arrDt,airline_schdl_itms_w_remarks,
        reason,action_cd
    )
    SELECT
        p_id,id_tour_pkg,seq_no,id_airline,id_airline_schedule,id_tour_operator,id_dpt,num_days,num_nights,dt_dep,code,description,description_zh,lang_cd,
        full_twn,full_sgl,full_ctw,full_ceb,full_cnb,
        grnd_twn,grnd_sgl,grnd_ctw,grnd_ceb,grnd_cnb,
        airfare_twn,airfare_sgl,airfare_ctw,airfare_ceb,airfare_cnb,
        is_ground_not_applicable,
        tour_mgr_cost,tfair_discount,
        cna_adt,cpa_adt,csi_adt,
        misc_adt,misc_chd,
        full_remarks,grnd_remarks,prn,seat_allotment,reserved_seat,reserved_seat_reason,tour_mgr_pax,
        travel_ins_policy_s,travel_ins_policy_f,deadline,
        is_show_airline,is_issued_s,is_issued_f,is_remain_tc,is_deposit_paid,is_push,is_hot_deal,is_push_to_online,is_visa_required,
        is_lock,is_private_tour,inv_remarks,insurance_remarks,
        op_pic,private_pic,
        airline_schedule_items,tour_status_cd,tour_status_reason,tour_pkg_daily_cms,id_pic_user,
        id_cruise,id_cruise_schedule,is_show_cruise,cruise_schedule_items,
        cruise_schdl_itms_w_seq,cruise_schdl_itms_w_etd,cruise_schdl_itms_w_eta,cruise_schdl_itms_w_depDt,cruise_schdl_itms_w_arrDt,cruise_schdl_itms_w_remarks,
        status_cd,dt_created,created_by,dt_upd,upd_by,version,
        airline_schdl_itms_w_seq,airline_schdl_itms_w_etd,airline_schdl_itms_w_eta,airline_schdl_itms_w_depDt,airline_schdl_itms_w_arrDt,airline_schdl_itms_w_remarks,
        p_reason,p_action
    FROM tour_dep
    WHERE id = p_id;
END$$

