 * Wey Tsong
 * AWS-102
 * 1. Change such that do not make all the checkbox in the Remain T/C as checked to prevent grabbing unnecessary tour code.
 * 2. Change such that if the "Guaranteed Departure" is chosen for the depart date badge, auto set true for the remain t/c checkbox when save or update the tour departure.
 * 3. Change such that if the "Chartered Flight" is chosen for the tour badge, auto set true for the remain t/c checkbox in the tourDepList when update the tour packages.
 * 4. Writing script to set remain t/c to true if the "Chartered Flight" is chosen for the tour badge or "Guaranteed Departure" is chosen for the depart date badge.
 *
 * AWS-104
 * 1. Change [Policy] to Policy (F) and change [Issued] to Issued (F) for filtering according to F insurance.
 * 2. Added Policy (S) and Issued (S) for filtering according to S insurance
 */

UPDATE `db_tracking` SET version = '3.0.123', dt_upd = NOW() WHERE version LIKE '3.%';

ALTER TABLE `tour_dep`
DROP COLUMN `is_remain_tc`;

ALTER TABLE `tour_dep`
ADD COLUMN `is_remain_tc` TINYINT(1) NOT NULL DEFAULT '0' COMMENT '0 = No / 1 = Yes' AFTER `is_issued_f`;

UPDATE tour_dep
SET is_remain_tc = 1
WHERE id_tour_pkg IN (
    SELECT id_tour_pkg
    FROM tour_pkg_attribute
    WHERE tag_type = 'tour_badge' AND code = 'char_flight'
);

UPDATE tour_dep
SET is_remain_tc = 1
WHERE id IN (
    SELECT id_tour_dep
    FROM tour_dep_attribute
    WHERE tag_type = 'depart_date_badge' AND code = 'CFM'
);

