CREATE TABLE `supplier_history` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_hist` bigint NOT NULL,
  `id_person` bigint NOT NULL,
  `id_company` bigint NOT NULL DEFAULT '1',
  `id_acct` bigint DEFAULT NULL,
  `sys_no` varchar(45) NOT NULL,
  `code` varchar(50) DEFAULT NULL COMMENT '**P = Personal / C = Corporate',
  `status_cd` varchar(50) DEFAULT NULL COMMENT '**A = Active / I = Inactive',
  `type_cd` varchar(50) DEFAULT NULL COMMENT '**SUNDRY/TRADE',
  `cat_cd` varchar(45) NOT NULL,
  `pmnt_type_cd` varchar(50) DEFAULT NULL COMMENT '**CHQ/CASH/etc.',
  `acct_ref` varchar(255) DEFAULT NULL COMMENT 'e.g. bank account reference',
  `credit_limit` float(10,2) NOT NULL DEFAULT '0.00',
  `bank_name` varchar(100) DEFAULT NULL,
  `bank_no` varchar(45) DEFAULT NULL,
  `beneficiary_name` varchar(255) DEFAULT NULL,
  `tourism_tax_reg_no` varchar(20) DEFAULT NULL,
  `tax_id_no` varchar(20) DEFAULT NULL,
  `reg_no` varchar(20) DEFAULT NULL,
  `reg_no_old` varchar(20) DEFAULT NULL,
  `gst_reg_no` varchar(20) DEFAULT NULL,
  `sst_reg_no` varchar(20) DEFAULT NULL,
  `msic_code` varchar(20) DEFAULT NULL,
  `contact_no` varchar(20) DEFAULT NULL,
  `email` varchar(50) DEFAULT NULL,
  `passport_no` varchar(50) DEFAULT NULL,
  `group_cd` varchar(50) DEFAULT NULL,
  `reason` text NOT NULL,
  `action_cd` varchar(50) NOT NULL,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_id_hist` (`id_hist`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

CREATE TABLE `supplier_remarks_history` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_ref` bigint NOT NULL,
  `id_hist` bigint NOT NULL,
  `id_person_corp` bigint NOT NULL,
  `remarks` text,
  `time_stamp` datetime NOT NULL,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL DEFAULT '0000-00-00 00:00:00',
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_id_ref` (`id_ref`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

CREATE TABLE `corporate_history` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_ref` bigint NOT NULL,
  `id_hist` bigint NOT NULL,
  `id_person` bigint NOT NULL,
  `name` varchar(255) NOT NULL,
  `reg_no` varchar(20) DEFAULT NULL,
  `reg_no_old` varchar(20) DEFAULT NULL,
  `gst_reg_no` varchar(20) DEFAULT NULL,
  `tax_id_no` varchar(20) DEFAULT NULL,
  `sst_reg_no` varchar(20) DEFAULT NULL,
  `description` varchar(255) DEFAULT NULL,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_id_ref` (`id_ref`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

CREATE TABLE `supplier_pic_history` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_ref` bigint NOT NULL,
  `id_hist` bigint NOT NULL,
  `id_supplier` bigint NOT NULL,
  `salutation_cd` varchar(50) NOT NULL COMMENT '**MR/MRS/MS/etc.',
  `title` varchar(50) DEFAULT NULL,
  `first_name` varchar(50) NOT NULL,
  `middle_name` varchar(50) DEFAULT NULL,
  `last_name` varchar(50) NOT NULL,
  `nick_name` varchar(50) DEFAULT NULL,
  `sex_cd` varchar(50) DEFAULT NULL COMMENT '**M = Male / F = Female',
  `email` varchar(255) DEFAULT NULL,
  `ec_surname` varchar(50) DEFAULT NULL,
  `office_no` varchar(50) DEFAULT NULL,
  `office_ext` varchar(50) DEFAULT NULL,
  `mobile_no` varchar(255) DEFAULT NULL,
  `status_cd` varchar(50) NOT NULL DEFAULT 'A',
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_id_ref` (`id_ref`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;


DELIMITER $$
CREATE DEFINER=`root`@`localhost` PROCEDURE `prc_supplier`(
    IN `p_id` BIGINT(20),
    IN `p_action` VARCHAR(50),
    IN `p_reason` TEXT,
    OUT `r_status_code` INT
)
BEGIN

  DECLARE v_suppl_hist_id BIGINT(20);
  DECLARE v_person_hist_id BIGINT(20);
  DECLARE v_corporate_hist_id BIGINT(20);
  DECLARE v_corporate_contact_hist_id BIGINT(20);
  DECLARE v_corporate_address_hist_id BIGINT(20);
  DECLARE v_supplier_remarks_hist_id BIGINT(20);
  DECLARE v_supplier_pic_hist_id BIGINT(20);

  DECLARE v_person_id BIGINT(20);
  DECLARE v_corporate_id BIGINT(20);

   -- Error handler: if any SQL error occurs, rollback and set status = 0
  DECLARE EXIT HANDLER FOR SQLEXCEPTION
  BEGIN
    ROLLBACK;
    SET r_status_code = 0; -- failure
  END;

  START TRANSACTION;

  SELECT id_person INTO v_person_id
  FROM supplier
  WHERE id = p_id;

  SELECT id INTO v_corporate_id
  FROM corporate
  WHERE id_person = v_person_id;

  INSERT INTO supplier_history (`id_hist`, `id_person`, `id_company`, `id_acct`, `sys_no`, `code`, `status_cd`, `type_cd`, `cat_cd`, `pmnt_type_cd`, `acct_ref`, `credit_limit`, `bank_name`, `bank_no`, `beneficiary_name`, `tourism_tax_reg_no`, `tax_id_no`, `reg_no`, `reg_no_old`, `gst_reg_no`, `sst_reg_no`, `msic_code`, `contact_no`, `email`, `passport_no`, `group_cd`, `reason`,`action_cd`, `dt_created`, `created_by`, `dt_upd`, `upd_by`)
  (SELECT
  `id`, `id_person`, `id_company`, `id_acct`, `sys_no`, `code`, `status_cd`, `type_cd`, `cat_cd`, `pmnt_type_cd`, `acct_ref`, `credit_limit`, `bank_name`, `bank_no`, `beneficiary_name`, `tourism_tax_reg_no`, `tax_id_no`, `reg_no`, `reg_no_old`, `gst_reg_no`, `sst_reg_no`, `msic_code`, `contact_no`, `email`, `passport_no`, `group_cd`, p_reason, p_action, `dt_created`, `created_by`, `dt_upd`, `upd_by`
  FROM supplier
    WHERE id = p_id);
  SET v_suppl_hist_id := LAST_INSERT_ID();

  INSERT INTO person_history (`id_ref`, `id_hist`, `type_cd`, `designation`, `salutation_cd`, `title`, `first_name`, `middle_name`, `last_name`, `nick_name`, `tax_id_no`, `id_country`, `sex_cd`, `race`, `marriage_cd`, `class_cd`, `dt_birth`, `age`, `is_ins_bought`, `upoint`, `apple_voucher_point`, `email`, `ec_surname`, `ec_given_name`, `ec_contact_no`, `ec_email`, `ec_relationship`, `dt_created`, `created_by`, `dt_upd`, `upd_by`)
  (SELECT
  v_suppl_hist_id, `id`, `type_cd`, `designation`, `salutation_cd`, `title`, `first_name`, `middle_name`, `last_name`, `nick_name`, `tax_id_no`, `id_country`, `sex_cd`, `race`, `marriage_cd`, `class_cd`, `dt_birth`, `age`, `is_ins_bought`, `upoint`, `apple_voucher_point`, `email`, `ec_surname`, `ec_given_name`, `ec_contact_no`, `ec_email`, `ec_relationship`, `dt_created`, `created_by`, `dt_upd`, `upd_by`
  FROM person
    WHERE id = v_person_id);
  SET v_person_hist_id := LAST_INSERT_ID();

  INSERT INTO corporate_history (`id_ref`, `id_hist`, `id_person`, `name`, `reg_no`, `reg_no_old`, `gst_reg_no`, `tax_id_no`, `sst_reg_no`, `description`, `dt_created`, `created_by`, `dt_upd`, `upd_by`)
  (SELECT
  v_suppl_hist_id, `id`, `id_person`, `name`, `reg_no`, `reg_no_old`, `gst_reg_no`, `tax_id_no`, `sst_reg_no`, `description`, `dt_created`, `created_by`, `dt_upd`, `upd_by`
  FROM corporate
    WHERE id_person = v_person_id);
  SET v_corporate_hist_id := LAST_INSERT_ID();

  INSERT INTO corporate_address_history (`id_ref`, `id_hist`, `id_corporate`, `id_country`, `type_cd`, `addr_1`, `addr_2`, `addr_3`, `city`, `state`, `postcode`, `dt_created`, `created_by`, `dt_upd`, `upd_by`)
  (SELECT
  v_suppl_hist_id, `id`, `id_corporate`, `id_country`, `type_cd`, `addr_1`, `addr_2`, `addr_3`, `city`, `state`, `postcode`, `dt_created`, `created_by`, `dt_upd`, `upd_by`
  FROM corporate_address
    WHERE id_corporate = v_corporate_id);
  SET v_corporate_address_hist_id := LAST_INSERT_ID();

  INSERT INTO corporate_contact_history (`id_ref`,`id_hist`, `id_corporate`,`type_cd`,`number`,`attention`,`contact_person`,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`)
  (SELECT
  v_suppl_hist_id, `id`, `id_corporate`,`type_cd`,`number`,`attention`,`contact_person`,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`
  FROM corporate_contact
    WHERE id_corporate = v_corporate_id);
  SET v_corporate_contact_hist_id := LAST_INSERT_ID();

  INSERT INTO supplier_remarks_history (`id_ref`, `id_hist`, `id_person_corp`, `remarks`, `time_stamp`, `dt_created`, `created_by`, `dt_upd`, `upd_by`)
  (SELECT
  v_suppl_hist_id, `id`, `id_person_corp`, `remarks`, `time_stamp`, `dt_created`, `created_by`, `dt_upd`, `upd_by`
  FROM supplier_remarks
    WHERE id_person_corp = v_corporate_id);
  SET v_supplier_remarks_hist_id := LAST_INSERT_ID();

  INSERT INTO supplier_pic_history (`id_ref`,`id_hist`, `id_supplier`, `salutation_cd`, `title`, `first_name`, `middle_name`, `last_name`, `nick_name`, `sex_cd`, `email`, `ec_surname`, `office_no`, `office_ext`, `mobile_no`, `status_cd`, `dt_created`, `created_by`, `dt_upd`, `upd_by`)
  (SELECT
  v_suppl_hist_id, `id`, `id_supplier`, `salutation_cd`, `title`, `first_name`, `middle_name`, `last_name`, `nick_name`, `sex_cd`, `email`, `ec_surname`, `office_no`, `office_ext`, `mobile_no`, `status_cd`, `dt_created`, `created_by`, `dt_upd`, `upd_by`
  FROM supplier_pic
    WHERE id_supplier = v_person_id);
  SET v_supplier_pic_hist_id := LAST_INSERT_ID();

  SELECT v_person_id, v_corporate_id, v_suppl_hist_id, v_person_hist_id, v_corporate_hist_id, v_corporate_address_hist_id, v_corporate_contact_hist_id,
    v_supplier_remarks_hist_id, v_supplier_pic_hist_id, LAST_INSERT_ID();

  COMMIT;
  -- Return a status code (e.g., 1 for success, 0 for failure)
  SET r_status_code = 1; -- Success
END$$
DELIMITER ;

