CREATE TABLE invoice_pax_ref_no (
    id BIGINT(19) NOT NULL AUTO_INCREMENT,
    id_inv_pax BIGINT(19) NULL DEFAULT NULL,
    ref_type VARCHAR(50) NOT NULL,
    ref_no VARCHAR(255) NULL DEFAULT NULL,
    status_cd varchar(1) NOT NULL,
    dt_created TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_by VARCHAR(50) NOT NULL,
    dt_upd DATETIME NOT NULL,
    upd_by VARCHAR(50) NOT NULL,
    PRIMARY KEY (id),
    INDEX idx_id_inv_pax (id_inv_pax)
);

INSERT INTO `lookup_cat` (`code`, `description`, `remarks`, `dt_created`, `created_by`, `dt_upd`, `upd_by`)
VALUES ('inv_ref_no', 'Invoice Reference No', 'Invoice Reference No', NOW(), 'SYSTEM', NOW(), 'SYSTEM');

