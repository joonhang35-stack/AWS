/**
 * 3.0.226
 * You Yuan
 * E-Invoice - consolidate invoice
 * restructed e inv tables
 * 	added e_invoice_submission - store e inv submissions
 * 	added e_invoice_consolidate - store consolidated inv, to map with e inv submission and doc
 * 	added e_invoice_consolidate_num_conf - to gen running num for consol e inv
 * moved submit invoice to E-Invoice API code into EInvoiceUtils
 */

UPDATE `db_tracking` SET version = '3.0.226', dt_upd = NOW() WHERE version LIKE '3.%';

alter table e_invoice add column `is_consol_e_inv` tinyint(1) default 0 COMMENT 'Is consolidate E-Invoice?' after `ref_no`;

CREATE TABLE `e_invoice_consolidate` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `ref_id` bigint COMMENT 'ref id to system data (eg. invoice.id)',
  `ref_no` varchar(50) COMMENT 'ref no to system data (eg. invoice.code)',
  `document_uuid` varchar(50) COMMENT 'e invoice document uuid',
  `submission_uid` varchar(50) COMMENT 'e invoice api submission uid',
  `long_id` varchar(70) COMMENT 'e invoice long id (to generate link)',
  `e_invoice_doc_type` varchar(50) COMMENT 'e invoice doc type (eg. Invoice, Self-Billed Invoice)',
  `sys_doc_type` varchar(50) COMMENT 'system doc type (eg. Invoice, Credit Note)',
  `sys_prefix` varchar(10) COMMENT 'system doc prefix (eg. IN, CN, HJ, AV)',
  `status_cd` varchar(50) DEFAULT NULL COMMENT 'Submitted / Valid / Invalid / Cancelled',
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_document_uuid` (`document_uuid`),
  KEY `idx_ref_id` (`ref_id`),
  KEY `idx_sys_doc_type` (`sys_doc_type`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

ALTER TABLE `e_invoice`
RENAME TO `e_invoice_document`;

CREATE TABLE `e_invoice_submission` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_company` bigint NOT NULL,
  `submission_uid` varchar(50) COMMENT 'e invoice api submission uid',
  `doc_cnt` int,
  `status_cd` varchar(50) DEFAULT NULL COMMENT 'Submitted / Valid / Invalid / Cancelled',
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_submission_uid` (`submission_uid`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

CREATE TABLE `e_invoice_consolidate_num_conf` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_company` bigint NOT NULL DEFAULT '1',
  `year` int not null,
  `month` int not null,
  `next_no` bigint default 1 COMMENT 'next running number for the month' not null,
  `status_cd` varchar(50) DEFAULT NULL COMMENT 'Submitted / Valid / Invalid / Cancelled',
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_year` (`year`),
  KEY `idx_month` (`month`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1 COMMENT='Consolidate E-Invoice running number (for each month)';

