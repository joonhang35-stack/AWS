CREATE TABLE `supplier_pic` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_supplier` bigint NOT NULL,
  `salutation_cd` varchar(50) NOT NULL COMMENT '**MR/MRS/MS/etc.',
  `title` varchar(50) DEFAULT NULL,
  `first_name` varchar(50) NOT NULL,
  `middle_name` varchar(50) DEFAULT NULL,
  `last_name` varchar(50) NOT NULL,
  `nick_name` varchar(50) DEFAULT NULL,
  `sex_cd` varchar(50) DEFAULT NULL COMMENT '**M = Male / F = Female',
  `email` varchar(255) DEFAULT NULL,
  `ec_surname` varchar(50) DEFAULT NULL,
  `office_no` varchar(50) DEFAULT NULL,
  `office_ext` varchar(50) DEFAULT NULL,
  `mobile_no` varchar(255) DEFAULT NULL,
  `status_cd` varchar(50) NOT NULL DEFAULT 'A',
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

