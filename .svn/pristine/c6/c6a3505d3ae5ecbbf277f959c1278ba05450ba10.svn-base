/**
 * 3.0.924
 * Xia Jing
 * patch and change feedback table structure
 */

-- 1. Update Feedback Table
ALTER TABLE feedback 
    ADD COLUMN email VARCHAR(255) AFTER id_customer,
    ADD COLUMN dt_upd DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP AFTER attachment,    
    CHANGE COLUMN submitted_at dt_submitted DATETIME, 
    CHANGE COLUMN created_at dt_created DATETIME;

-- Bulk update status codes
UPDATE feedback 
SET status = CASE 
    WHEN status = 'PENDING' THEN 'P' 
    WHEN status = 'SENT' THEN 'S' 
    ELSE status 
END
WHERE status IN ('PENDING', 'SENT');


-- 2. Update Feedback Question Table
ALTER TABLE feedback_question
    ADD COLUMN dt_upd DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP AFTER is_active,    
    CHANGE COLUMN created_at dt_created DATETIME;


-- 3. Update Feedback Answer Table
ALTER TABLE feedback_answer
    ADD COLUMN dt_upd DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP AFTER is_active,
    ADD COLUMN dt_created DATETIME DEFAULT CURRENT_TIMESTAMP;


-- 4. Update Feedback Customer Answer Table
ALTER TABLE feedback_cust_answer
    CHANGE COLUMN created_at dt_created DATETIME,
    ADD COLUMN dt_upd DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP;

UPDATE `db_tracking` SET version = '3.0.924', dt_upd = NOW() WHERE version LIKE '3.%';

/* end 3.0.924 */


