DELIMITER $$
DROP PROCEDURE IF EXISTS db_upd_3046 $$
CREATE PROCEDURE db_upd_3046()
BEGIN

	CREATE TABLE IF NOT EXISTS ipay_config (
	  `id` BIGINT(20) NOT NULL AUTO_INCREMENT,
	  `merchant_code` VARCHAR(50) NULL,
      `merchant_key` VARCHAR(50) NULL,
      `comment` VARCHAR(255)  NULL,
      `remarks` VARCHAR(255)  NULL,
      `status_cd` VARCHAR(1)  NOT NULL,
	  `dt_created` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
	  `created_by` VARCHAR(50) NOT NULL,
	  `dt_update` DATETIME NOT NULL,
	  `updated_by` VARCHAR(50) NOT NULL,
	  PRIMARY KEY (`id`))
	ENGINE = InnoDB;

    CREATE TABLE IF NOT EXISTS invoice_email_payment (
	  `id` BIGINT(20) NOT NULL AUTO_INCREMENT,
	  `id_ipay_config` BIGINT(20) NOT NULL,
      `id_invoice` BIGINT(20) NOT NULL,
      `id_invoice_admin_charges` BIGINT(20) NULL,
      `prefix_admin_charges` VARCHAR(20) NULL,
	  `prefix` VARCHAR(20) NULL,
      `email` VARCHAR(50) NOT NULL,
      `payment_amt` DECIMAL(12, 2)  NULL DEFAULT 0.00,
      `admin_charges_percentage` DECIMAL(12, 2)  NULL DEFAULT 0.00,
      `admin_charges` DECIMAL(12, 2)  NULL DEFAULT 0.00,
      `total_payment_amt` DECIMAL(12, 2)  NULL DEFAULT 0.00,
      `payment_status` VARCHAR(50)  NOT NULL,
      `trans_id` VARCHAR(30)  NULL,
      `auth_code` VARCHAR(20)  NULL,
      `cc_name` VARCHAR(200)  NULL,
      `cc_no` VARCHAR(16)  NULL,
      `s_bankname` VARCHAR(100)  NULL,
      `s_country` VARCHAR(100)  NULL,
      `status_cd` VARCHAR(1)  NOT NULL,
	  `dt_created` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
	  `created_by` VARCHAR(50) NOT NULL,
	  `dt_update` DATETIME NOT NULL,
	  `updated_by` VARCHAR(50) NOT NULL,
	  PRIMARY KEY (`id`))
	ENGINE = InnoDB;

    ALTER TABLE `invoice_email_payment`
    DROP INDEX `idx_id_invoice` ,
    DROP INDEX `idx_id_invoice_admin_charges` ,
	ADD INDEX `idx_id_invoice` (`id_invoice` ASC),
	ADD INDEX `idx_id_invoice_admin_charges` (`id_invoice_admin_charges` ASC);

    IF NOT EXISTS (SELECT 1 FROM sec_func WHERE uuid = 'U_MAINT_IPAY_CONFIG') THEN
		INSERT INTO sec_func(`UUID`, `APP_ID`, `FUNC_CD`, `FUNC_NAME`, `TYPE_CD`, `URI_ENTRY`, `IS_SECURE`,
		`LEVEL_NO`, `SEQ_NO`, `U_PARENT_FUNC`, `STATUS_CD`, `REMARKS`,`DT_CREATED`, `CREATED_BY`, `DT_UPD`, `UPD_BY`, `VERSION`)
		VALUES ('U_MAINT_IPAY_CONFIG', '*', 'MAINT_IPAY_CONFIG', 'Ipay Config', 'L',
		'/app/maintenance/ipayConfig', '1', '2', '11', 'U_MAINTENANCE', 'A','', NOW(), 'SYSTEM', NOW(), 'SYSTEM', '1')
		ON DUPLICATE KEY UPDATE FUNC_CD=FUNC_CD;
	END IF;

    IF NOT EXISTS (SELECT 1 FROM sec_func WHERE uuid = 'U_SALES_INV_EMAIL_PAYMENT') THEN
		INSERT INTO sec_func(`UUID`, `APP_ID`, `FUNC_CD`, `FUNC_NAME`, `TYPE_CD`, `URI_ENTRY`, `IS_SECURE`,
		`LEVEL_NO`, `SEQ_NO`, `U_PARENT_FUNC`, `STATUS_CD`, `REMARKS`,`DT_CREATED`, `CREATED_BY`, `DT_UPD`, `UPD_BY`, `VERSION`)
		VALUES ('U_SALES_INV_EMAIL_PAYMENT', '*', 'SALES_INV_EMAIL_PAYMENT', 'Invoice Email Payment', 'L',
		'/app/sales/invEmailPayment', '1', '2', '80', 'U_SALES', 'A','', NOW(), 'SYSTEM', NOW(), 'SYSTEM', '1')
		ON DUPLICATE KEY UPDATE FUNC_CD=FUNC_CD;
	END IF;

END $$

