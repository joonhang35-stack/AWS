CREATE TABLE `online_customer_profile_update` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_customer` bigint NOT NULL,
  `keycloak_id` varchar(80),
  
  `salutation_cd` varchar(50) DEFAULT NULL COMMENT 'MR/MRS/MS etc.', --
  `title_cd` varchar(50) DEFAULT NULL, --
  `gender` varchar(50) DEFAULT NULL COMMENT '**M = Male / F = Female', --
  `surname` varchar(50) NOT NULL,  --
  `given_name` varchar(50) NOT NULL, --
  `nick_name` varchar(50) DEFAULT NULL, --
  `tax_id_no` varchar(20) DEFAULT NULL, --
  
  `id_country` bigint DEFAULT NULL, --
  `nric` varchar(20) DEFAULT NULL, --
  `passport_no` varchar(20) DEFAULT NULL, --
  `dt_birth` datetime DEFAULT NULL, --

  `id_mobile_no_country_cd` bigint DEFAULT NULL, --
  `mobile_no` varchar(50) DEFAULT NULL, --
  
  `id_office_no_country_cd` bigint DEFAULT NULL, --
  `office_no` varchar(50) DEFAULT NULL, --
  
  `email` varchar(255) DEFAULT NULL, --
  
  `race_cd` varchar(20) DEFAULT NULL, --
  
  `dt_pssprt_expiry` datetime DEFAULT NULL, --
  `id_pssprt_country` bigint DEFAULT NULL, --
  
  `bill_addr_1` varchar(255) DEFAULT NULL,
  `bill_addr_2` varchar(255) DEFAULT NULL,
  `bill_addr_3` varchar(255) DEFAULT NULL,
  `bill_addr_city` varchar(255) DEFAULT NULL,
  `bill_addr_postcode` varchar(10) DEFAULT NULL,
  `bill_addr_state` varchar(255) DEFAULT NULL,
  `id_bill_addr_country` bigint DEFAULT NULL, 
  
  `mail_addr_1` varchar(255) DEFAULT NULL,
  `mail_addr_2` varchar(255) DEFAULT NULL,
  `mail_addr_3` varchar(255) DEFAULT NULL,
  `mail_addr_city` varchar(255) DEFAULT NULL,
  `mail_addr_postcode` varchar(10) DEFAULT NULL,
  `mail_addr_state` varchar(255) DEFAULT NULL,
  `id_mail_addr_country` bigint DEFAULT NULL, 
  
  `ec_surname` varchar(50) DEFAULT NULL,
  `ec_given_name` varchar(50) DEFAULT NULL,
  `ec_id_country_cd` bigint DEFAULT NULL,
  `ec_contact_no` varchar(50) DEFAULT NULL,
  `ec_email` varchar(255) DEFAULT NULL,
  `ec_relationship` varchar(50) DEFAULT NULL COMMENT '**FAM = Family / FRD = Friend',
  
  `update_status` varchar(1) NOT NULL,
  `dt_reviewed` datetime DEFAULT NULL COMMENT 'approve/reject datetime',
  `reviewed_by` varchar(50) DEFAULT NULL COMMENT 'approve/reject by',
  `remarks` text COMMENT 'approve/reject notes',
  
  `status_cd` varchar(1) NOT NULL,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_id_customer` (`id_customer`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

CREATE TABLE `online_customer_upd_lang` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_online_cust_profile_upd` bigint NOT NULL,
  `lang_cd` varchar(50) NOT NULL COMMENT '**EN/MY/mdn/canto etc.',
  `status_cd` varchar(1) NOT NULL,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `fk_lang_id_online_cust_profile_upd` (`id_online_cust_profile_upd`),
  CONSTRAINT `fk_lang_id_online_cust_profile_upd` FOREIGN KEY (`id_online_cust_profile_upd`) REFERENCES `online_customer_profile_update` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1 COMMENT='Multiple languages for online customer profile update';

CREATE TABLE `online_customer_upd_complication` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_online_cust_profile_upd` bigint NOT NULL,
  `complication_cd` varchar(50) NOT NULL COMMENT '**hdc/bbt/hbp etc.',
  `remarks` text,
  `status_cd` varchar(1) NOT NULL,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `fk_complication_id_online_cust_profile_upd` (`id_online_cust_profile_upd`),
  CONSTRAINT `fk_complication_id_online_cust_profile_upd` FOREIGN KEY (`id_online_cust_profile_upd`) REFERENCES `online_customer_profile_update` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1 COMMENT='Multiple illnesses for online customer profile update';

CREATE TABLE `online_customer_upd_meal` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_online_cust_profile_upd` bigint NOT NULL,
  `meal_cd` varchar(50) NOT NULL COMMENT '**MOML/SPML/MUSLIM/VEGE etc.',
  `remarks` text,
  `status_cd` varchar(1) NOT NULL,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `fk_meal_id_online_cust_profile_upd` (`id_online_cust_profile_upd`),
  CONSTRAINT `fk_meal_id_online_cust_profile_upd` FOREIGN KEY (`id_online_cust_profile_upd`) REFERENCES `online_customer_profile_update` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1 COMMENT='Multiple meal preferences for online customer profile update';

