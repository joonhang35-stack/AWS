alter table e_invoice_document add column `e_invoice_created_by` varchar(100);
alter table e_invoice_document add column `dt_issued` datetime after `is_consol_e_inv`;
alter table e_invoice_document add column `dt_received` datetime after `dt_issued`;
alter table e_invoice_document add column `issuer_name` varchar(100) after `doc_status_reason`;
alter table e_invoice_document add column `issuer_tin` varchar(20) after `issuer_name`;
alter table e_invoice_document add column `receiver_name` varchar(100) after `issuer_tin`;
alter table e_invoice_document add column `receiver_id` varchar(20) after `receiver_name`;
alter table e_invoice_document add column `e_invoice_version` varchar(20) after `total_payable_amount`;
alter table e_invoice_document add column `e_invoice_internal_id` varchar(20) after `dt_reject`;
alter table e_invoice_document add column `id_supplier` bigint comment 'not null when doc is self-billed invoice, null when doc is invoice' after `id_company` ;
alter table e_invoice_document add column `id_cust` bigint comment 'not null when doc is invoice, null when doc is self-billed invoice' after `id_company` ;

CREATE TABLE `e_invoice_document_item` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_e_inv_doc` bigint NOT NULL,
  `doc_uuid` varchar(50) COMMENT 'e invoice document uuid, might be null if e invoice fail to submit',
  `class_code` varchar(10) not null comment 'classification code',
  `description` varchar(255) not null,
  `quantity` smallint not null,
  `unit_price` double(10,2) NOT NULL,
  `amount` double(10,2) NOT NULL,
  `status_cd` varchar(50) DEFAULT NULL COMMENT 'A/D',
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_doc_uuid` (`doc_uuid`),
  KEY `idx_id_e_inv_doc` (`id_e_inv_doc`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

CREATE TABLE `e_invoice_buyer` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_e_inv_doc` bigint NOT NULL,
  -- `doc_uuid` varchar(50) COMMENT 'e invoice document uuid, might be null if e invoice fail to submit',
  -- `type_cd` varchar(10) not null comment 'party type (buyer [B]/supplier [S])',
  `name` varchar(150) not null comment 'full name',
  `tin` varchar(20) not null,
  `identity_type` varchar(15) not null comment 'NRIC/BRN/PASSPORT',
  `identity_value` varchar(30) not null,
  `sst_reg_no` varchar(20),
  -- `tourism_tax_reg_no` varchar(20),
  `addr_1` varchar(255) NOT NULL,
  `addr_2` varchar(255),
  `addr_3` varchar(255),
  `postcode` varchar(10),
  `city` varchar(255) not null,
  `state` varchar(255) not null comment 'Country Subentity Code',
  `country` varchar(255) not null comment 'ISO3166-1 Three Letter Country Code',
  `email` varchar(150),
  `contact_no` varchar(20),
  -- `msic_code` varchar(20),
  -- `business_desc` varchar(255) comment 'Business Activity Description',
  `status_cd` varchar(50) DEFAULT NULL COMMENT 'A/D',
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  -- KEY `idx_doc_uuid` (`doc_uuid`),
  KEY `idx_id_e_inv_doc` (`id_e_inv_doc`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

CREATE TABLE `e_invoice_supplier` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_e_inv_doc` bigint NOT NULL,
  -- `doc_uuid` varchar(50) COMMENT 'e invoice document uuid, might be null if e invoice fail to submit',
  -- `type_cd` varchar(10) not null comment 'party type (buyer [B]/supplier [S])',
  `name` varchar(150) not null comment 'full name',
  `tin` varchar(20) not null,
  `identity_type` varchar(15) not null comment 'NRIC/BRN/PASSPORT',
  `identity_value` varchar(30) not null,
  `sst_reg_no` varchar(20),
  `tourism_tax_reg_no` varchar(20),
  `addr_1` varchar(255) NOT NULL,
  `addr_2` varchar(255),
  `addr_3` varchar(255),
  `postcode` varchar(10),
  `city` varchar(255) not null,
  `state` varchar(255) not null comment 'Country Subentity Code',
  `country` varchar(255) not null comment 'ISO3166-1 Three Letter Country Code',
  `email` varchar(150),
  `contact_no` varchar(20),
  `msic_code` varchar(20),
  `business_desc` varchar(255) comment 'Business Activity Description',
  `status_cd` varchar(50) DEFAULT NULL COMMENT 'A/D',
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  -- KEY `idx_doc_uuid` (`doc_uuid`),
  KEY `idx_id_e_inv_doc` (`id_e_inv_doc`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

