CREATE TABLE `campaign` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_company` bigint not null,
  `name` varchar(30) not NULL,
  `campaign_status` varchar(20) DEFAULT NULL,
  `start_dt` date DEFAULT NULL,
  `end_dt` date DEFAULT NULL,
  `start_time` varchar(4) DEFAULT NULL,
  `end_time` varchar(4) DEFAULT NULL,
  `code` varchar(20) DEFAULT NULL,
  `description` varchar(150) DEFAULT NULL,
  `tour_type` varchar(50) DEFAULT NULL,
  `status_cd` varchar(50) DEFAULT NULL,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_id_company` (`id_company`),
  KEY `idx_status_cd` (`status_cd`),
  KEY `idx_code` (`code`)
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=latin1;

CREATE TABLE `campaign_country` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_campaign` bigint not null,
  `name` varchar(30) not NULL,
  `seq` int,
  `status_cd` varchar(50) DEFAULT NULL,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_id_campaign` (`id_campaign`),
  KEY `idx_status_cd` (`status_cd`)
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=latin1;

CREATE TABLE `campaign_country_pkg` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_campaign_country` bigint not null,
  `id_tour_pkg` bigint not null,
  `status_cd` varchar(50) DEFAULT NULL,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_status_cd` (`status_cd`),
  KEY `idx_id_campaign_country` (`id_campaign_country`),
  KEY `idx_id_tour_pkg` (`id_tour_pkg`)
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=latin1;

