DELIMITER $$
DROP PROCEDURE IF EXISTS db_upd_3031 $$
CREATE PROCEDURE db_upd_3031()
BEGIN

    IF NOT EXISTS (SELECT 1 FROM sec_func WHERE uuid = 'U_PRODUCT_REPORT') THEN
		INSERT INTO sec_func(`UUID`, `APP_ID`, `FUNC_CD`, `FUNC_NAME`, `TYPE_CD`, `URI_ENTRY`, `IS_SECURE`,
		`LEVEL_NO`, `SEQ_NO`, `U_PARENT_FUNC`, `STATUS_CD`, `REMARKS`,`DT_CREATED`, `CREATED_BY`, `DT_UPD`, `UPD_BY`, `VERSION`)
		VALUES ('U_PRODUCT_REPORT', '*', 'PRODUCT_REPORT', 'Report', 'L',
		'#', '1', '2', '90', 'U_PRODUCT', 'A','', NOW(), 'SYSTEM', NOW(), 'SYSTEM', '1')
		ON DUPLICATE KEY UPDATE FUNC_CD=FUNC_CD;
	END IF;

    IF NOT EXISTS (SELECT 1 FROM sec_func WHERE uuid = 'U_PRODUCT_REPORT_REPORTING') THEN
		INSERT INTO sec_func(`UUID`, `APP_ID`, `FUNC_CD`, `FUNC_NAME`, `TYPE_CD`, `URI_ENTRY`,  `URI_PROCESS`, `IS_SECURE`,
		`LEVEL_NO`, `SEQ_NO`, `U_PARENT_FUNC`, `STATUS_CD`, `REMARKS`,`DT_CREATED`, `CREATED_BY`, `DT_UPD`, `UPD_BY`, `VERSION`)
		VALUES ('U_PRODUCT_REPORT_REPORTING', '*', 'PRODUCT_REPORT_REPORTING', 'Product Report', 'L',
		'/app/product/report/productreport', '', '1', '3', '1', 'U_PRODUCT_REPORT', 'A','', NOW(), 'SYSTEM', NOW(), 'SYSTEM', '1')
		ON DUPLICATE KEY UPDATE FUNC_CD=FUNC_CD;
	END IF;

END $$

