CREATE TABLE `invoice_pos_sales` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_company` bigint NOT NULL,
  `id_invoice` bigint NOT NULL,
  `id_customer` bigint NOT NULL,
  `id_tour_booking` bigint DEFAULT NULL,
  `dt_inv` date DEFAULT NULL,
  `inv_no` varchar(20) DEFAULT NULL,
  `ps_no` varchar(20) DEFAULT NULL,
  `doc_type_cd` varchar(50) NOT NULL,
  `dt_departure` date DEFAULT NULL,
  `cat_cd` varchar(50) DEFAULT NULL,
  `order_cd` varchar(50) DEFAULT NULL,
  `is_1utama` tinyint(1) NOT NULL DEFAULT '1' COMMENT '0 = No / 1 = Yes',
  `amount` double(10,2) NOT NULL DEFAULT '0.00',
  `posting_status` varchar(50) DEFAULT NULL,
  `payment_status` varchar(50) DEFAULT NULL,
  `status_cd` varchar(50) NOT NULL DEFAULT 'AC',
  `remarks` text CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

CREATE TABLE `invoice_pos_sales_item` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_pos_sales` bigint NOT NULL,
  `id_customer` bigint NOT NULL,
  `code` varchar(50) DEFAULT NULL,
  `description` varchar(255) NOT NULL,
  `sub_description` varchar(255) DEFAULT NULL,
  `amount` double(10,2) NOT NULL DEFAULT '0.00',
  `status_cd` varchar(50) NOT NULL DEFAULT 'A',
  `dt_upd` datetime NOT NULL,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `upd_by` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

