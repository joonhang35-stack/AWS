ALTER TABLE `employee` ADD COLUMN `category` VARCHAR(50) DEFAULT NULL AFTER `role_type`;
ALTER TABLE `employee` ADD COLUMN `full_name` VARCHAR(255) DEFAULT NULL AFTER `category`;
ALTER TABLE `employee` ADD COLUMN `id_no` VARCHAR(50) DEFAULT NULL AFTER `full_name`;
ALTER TABLE `employee` ADD COLUMN `tax_id_no` varchar(20) DEFAULT NULL AFTER `id_no`;
ALTER TABLE `employee` ADD COLUMN `nick_name` varchar(50) DEFAULT NULL AFTER `tax_id_no`;
ALTER TABLE `employee` ADD COLUMN `msic_code` varchar(20) DEFAULT NULL AFTER `nick_name`;
ALTER TABLE `employee` ADD COLUMN `id_country` bigint DEFAULT NULL AFTER `msic_code`;
ALTER TABLE `employee` ADD COLUMN `addr_1` varchar(255) DEFAULT NULL AFTER `id_country`;
ALTER TABLE `employee` ADD COLUMN `addr_2` varchar(255) DEFAULT NULL AFTER `addr_1`;
ALTER TABLE `employee` ADD COLUMN `addr_3` varchar(255) DEFAULT NULL AFTER `addr_2`;
ALTER TABLE `employee` ADD COLUMN `city` varchar(255) DEFAULT NULL AFTER `addr_3`;
ALTER TABLE `employee` ADD COLUMN `state` varchar(255) DEFAULT NULL AFTER `city`;
ALTER TABLE `employee` ADD COLUMN `postcode` varchar(10) DEFAULT NULL AFTER `state`;
ALTER TABLE `employee` ADD COLUMN `acct_no` varchar(20) DEFAULT NULL AFTER `postcode`;
ALTER TABLE `employee` ADD COLUMN `bank_name` varchar(255) DEFAULT NULL AFTER `acct_no`;
