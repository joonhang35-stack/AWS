/* =========================================================
   INSERT RATING ANSWERS
   ========================================================= */

INSERT INTO feedback_answer
(
    id_feedback_question,
    answer_label_en,
    answer_label_zh,
    score_value,
    seq_no,
    is_active
)
SELECT
    q.id,
    a.answer_label_en,
    a.answer_label_zh,
    a.score_value,
    a.seq_no,
    1
FROM feedback_question q
JOIN
(
    SELECT '😍Excellent' AS answer_label_en,
           '😍非常满意' AS answer_label_zh,
           5 AS score_value,
           1 AS seq_no

    UNION ALL

    SELECT '🙂Good',
           '🙂满意',
           4,
           2

    UNION ALL

    SELECT '😐Average',
           '😐普通',
           3,
           3

    UNION ALL

    SELECT '😞Poor',
           '😞不满意',
           2,
           4

) a
WHERE q.answer_type = 'RATING'
ORDER BY q.id, a.seq_no;


