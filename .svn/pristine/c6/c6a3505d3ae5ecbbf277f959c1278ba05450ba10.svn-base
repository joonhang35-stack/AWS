DROP PROCEDURE IF EXISTS prc_customer;
DELIMITER $$
CREATE DEFINER=`root`@`localhost` PROCEDURE `prc_customer`(
    IN `p_id` BIGINT(20),
    IN `p_action` VARCHAR(50),
    IN `p_reason` TEXT,
    OUT `r_status_code` INT
)
BEGIN

  DECLARE v_cust_hist_id BIGINT(20);
  DECLARE v_person_hist_id BIGINT(20);
  DECLARE v_person_identity_hist_id BIGINT(20);
  DECLARE v_person_identity_detail_hist_id BIGINT(20);
  DECLARE v_person_contact_hist_id BIGINT(20);
  DECLARE v_person_email_hist_id BIGINT(20);
  DECLARE v_person_address_hist_id BIGINT(20);
  DECLARE v_corporate_contact_hist_id BIGINT(20);
  DECLARE v_corporate_address_hist_id BIGINT(20);
  DECLARE v_person_lang_hist_id BIGINT(20);
  DECLARE v_person_meal_hist_id BIGINT(20);
  DECLARE v_person_class_hist_id BIGINT(20);
  DECLARE v_person_complication_hist_id BIGINT(20);
  DECLARE v_corporate_pic_hist_id BIGINT(20);

  DECLARE v_cust_type VARCHAR(10);
  DECLARE v_person_id BIGINT(20);
  DECLARE v_corporate_id BIGINT(20);

  SELECT id_pc, id_corporate, pc_type_cd INTO v_person_id, v_corporate_id, v_cust_type
  FROM customer
  WHERE id = p_id;

  INSERT INTO customer_history (`id_hist`,`id_pc`,`id_corporate`,`corporate_name`,`code`,`pc_type_cd`,`is_lock`,`status_cd`,`id_company`,`remarks`,`reason`,`action_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`)
  (SELECT
  `id`,`id_pc`,`id_corporate`,`corporate_name`,`code`,`pc_type_cd`,`is_lock`,`status_cd`,`id_company`,`remarks`,p_reason, p_action,`dt_created`,`created_by`,`dt_upd`,`upd_by`
  FROM customer
    WHERE id = p_id);
  SET v_cust_hist_id := LAST_INSERT_ID();

  INSERT INTO person_history (`id_ref`,`id_hist`,`type_cd`,`designation`,`salutation_cd`,`title`,`first_name`,`middle_name`,`last_name`,`nick_name`,`tax_id_no`,`id_country`,`sex_cd`,`race`,`marriage_cd`,`class_cd`,`dt_birth`,`age`,`is_ins_bought`,`upoint`,`apple_voucher_point`,`email`,`ec_surname`,`ec_given_name`,`ec_id_country_cd`,`ec_country_cd`,`ec_contact_no`,`ec_email`,`ec_relationship`,`dt_created`,`created_by`,`dt_upd`,`upd_by`)
  (SELECT
  v_cust_hist_id,`id`,`type_cd`,`designation`,`salutation_cd`,`title`,`first_name`,`middle_name`,`last_name`,`nick_name`,`tax_id_no`,`id_country`,`sex_cd`,`race`,`marriage_cd`,`class_cd`,`dt_birth`,`age`,`is_ins_bought`,`upoint`,`apple_voucher_point`,`email`,`ec_surname`,`ec_given_name`,`ec_id_country_cd`,`ec_country_cd`,`ec_contact_no`,`ec_email`,`ec_relationship`,`dt_created`,`created_by`,`dt_upd`,`upd_by`
  FROM person
    WHERE id = v_person_id);
  SET v_person_hist_id := LAST_INSERT_ID();

  INSERT INTO person_identity_history (`id_ref`,`id_hist`,`id_person`,`type_cd`,`number`,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`)
  (SELECT
  v_cust_hist_id,`id`,`id_person`,`type_cd`,`number`,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`
  FROM person_identity
    WHERE id_person = v_person_id);
  SET v_person_identity_hist_id := LAST_INSERT_ID();

  INSERT INTO person_identity_detail_history (`id_ref`,`id_hist`,`id_person_identity`,`id_country`,`type_cd`,`entry_cd`,`dt_issued`,`dt_expired`,`scanned_path`,`file_path`,`dt_created`,`created_by`,`dt_upd`,`upd_by`)
  (SELECT
  v_cust_hist_id,`id`,`id_person_identity`,`id_country`,`type_cd`,`entry_cd`,`dt_issued`,`dt_expired`,`scanned_path`,`file_path`,`dt_created`,`created_by`,`dt_upd`,`upd_by`
  FROM person_identity_detail
    WHERE id_person_identity in (SELECT id FROM person_identity where id_person = v_person_id));
  SET v_person_identity_detail_hist_id := LAST_INSERT_ID();

  INSERT INTO person_email_history (`id_ref`,`id_hist`,`id_person`,`email`,`is_primary`,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`)
  (SELECT
  v_cust_hist_id,`id`,`id_person`,`email`,`is_primary`,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`
  FROM person_email
    WHERE id_person = v_person_id);
  SET v_person_email_hist_id := LAST_INSERT_ID();

  INSERT INTO person_lang_history (`id_ref`,`id_hist`,`id_person`,`lang_cd`)
  (SELECT
  v_cust_hist_id,`id`,`id_person`,`lang_cd`
  FROM person_lang
    WHERE id_person = v_person_id);
  SET v_person_lang_hist_id := LAST_INSERT_ID();

  INSERT INTO person_meal_history (`id_ref`,`id_hist`,`id_person`,`meal_cd`,`remarks`)
  (SELECT
  v_cust_hist_id,`id`,`id_person`,`meal_cd`,`remarks`
  FROM person_meal
    WHERE id_person = v_person_id);
  SET v_person_meal_hist_id := LAST_INSERT_ID();

  INSERT INTO person_class_history (`id_ref`,`id_hist`,`id_person`,`class_cd`,`remarks`)
  (SELECT
  v_cust_hist_id,`id`,`id_person`,`class_cd`,`remarks`
  FROM person_class
    WHERE id_person = v_person_id);
  SET v_person_class_hist_id := LAST_INSERT_ID();

  INSERT INTO person_complication_history (`id_ref`,`id_hist`,`id_person`,`complication_cd`,`remarks`)
  (SELECT
  v_cust_hist_id,`id`,`id_person`,`complication_cd`,`remarks`
  FROM person_complication
    WHERE id_person = v_person_id);
  SET v_person_complication_hist_id := LAST_INSERT_ID();

  IF v_cust_type = 'P' THEN
    INSERT INTO person_contact_history (`id_ref`,`id_hist`,`id_person`,`type_cd`,`id_country_cd`,`country_cd`,`number`,`attention`,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`)
    (SELECT
    v_cust_hist_id,`id`,`id_person`,`type_cd`,`id_country_cd`,`country_cd`,`number`,`attention`,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`
    FROM person_contact
      WHERE id_person = v_person_id);
    SET v_person_contact_hist_id := LAST_INSERT_ID();

    INSERT INTO person_address_history (`id_ref`,`id_hist`,`id_person`,`id_country`,`type_cd`,`company_name`,`addr_1`,`addr_2`,`addr_3`,`city`,`state`,`postcode`,`dt_created`,`created_by`,`dt_upd`,`upd_by`)
    (SELECT
    v_cust_hist_id,`id`,`id_person`,`id_country`,`type_cd`,`company_name`,`addr_1`,`addr_2`,`addr_3`,`city`,`state`,`postcode`,`dt_created`,`created_by`,`dt_upd`,`upd_by`
    FROM person_address
      WHERE id_person = v_person_id);
    SET v_person_address_hist_id := LAST_INSERT_ID();
  ELSE
    INSERT INTO corporate_contact_history (`id_ref`,`id_hist`,`id_corporate`,`type_cd`,`id_country_cd`,`country_cd`,`number`,`attention`,`contact_person`,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`)
    (SELECT
    v_cust_hist_id,`id`,`id_corporate`,`id_country_cd`,`country_cd`,`type_cd`,`number`,`attention`,`contact_person`,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`
    FROM corporate_contact
      WHERE id_corporate = v_corporate_id);
    SET v_corporate_contact_hist_id := LAST_INSERT_ID();

    INSERT INTO corporate_address_history (`id_ref`,`id_hist`,`id_corporate`,`id_country`,`type_cd`,`addr_1`,`addr_2`,`addr_3`,`city`,`state`,`postcode`,`dt_created`,`created_by`,`dt_upd`,`upd_by`)
    (SELECT
    v_cust_hist_id,`id`,`id_corporate`,`id_country`,`type_cd`,`addr_1`,`addr_2`,`addr_3`,`city`,`state`,`postcode`,`dt_created`,`created_by`,`dt_upd`,`upd_by`
    FROM corporate_address
      WHERE id_corporate = v_corporate_id);
    SET v_corporate_address_hist_id := LAST_INSERT_ID();

    INSERT INTO corporate_pic_history (`id_ref`,`id_hist`,`id_corporate`,`salutation_cd`,`title`,`first_name`,`middle_name`,`last_name`,`nick_name`,`sex_cd`,`email`,`office_no`,`office_ext`,`mobile_no`,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`)
    (SELECT
    v_cust_hist_id,`id`,`id_corporate`,`salutation_cd`,`title`,`first_name`,`middle_name`,`last_name`,`nick_name`,`sex_cd`,`email`,`office_no`,`office_ext`,`mobile_no`,`status_cd`,`dt_created`,`created_by`,`dt_upd`,`upd_by`
    FROM corporate_pic
      WHERE id_corporate = v_corporate_id);
    SET v_corporate_pic_hist_id := LAST_INSERT_ID();
  END IF;

SELECT v_cust_hist_id, v_person_hist_id, v_person_identity_hist_id, v_person_identity_detail_hist_id, v_person_contact_hist_id,
v_person_email_hist_id, v_person_address_hist_id, v_corporate_contact_hist_id, v_corporate_address_hist_id,
v_person_lang_hist_id, v_person_meal_hist_id, v_person_class_hist_id, v_person_complication_hist_id, v_corporate_pic_hist_id, LAST_INSERT_ID();

-- Return a status code (e.g., 1 for success, 0 for failure)
SET r_status_code = 1; -- Success
END
$$ DELIMITER ;

