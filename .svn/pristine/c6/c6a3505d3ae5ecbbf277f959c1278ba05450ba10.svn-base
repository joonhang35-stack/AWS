CREATE TABLE `crm_membership` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_company` bigint NOT NULL,
  `id_customer` bigint,
  `keycloak_id` varchar(80) NOT NULL,
  `keycloak_username` varchar(255) NOT NULL,
  `email` varchar(100),
  `contact_country_code` varchar(50) NOT NULL,
  `contact` varchar(50) NOT NULL,
  `member_status_cd` ENUM('P', 'C', 'D') comment "Pending/Completed/Deleted",
  
  `status_cd` varchar(50),
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) NOT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY uk_keycloak_id (`keycloak_id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

