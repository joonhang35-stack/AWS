CREATE TABLE `pending_e_invoice` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `id_company` bigint NOT NULL,
  
  `dt_process` date not null COMMENT 'Date scheduled for E-Invoice processing',

  `sys_doc_type` varchar(50) DEFAULT NULL COMMENT 'system doc type (eg. Invoice, Credit Note)',
  `sys_prefix` varchar(10) DEFAULT NULL COMMENT 'system doc prefix (eg. IN, CN, HJ, AV)',
  `ref_id` bigint DEFAULT NULL COMMENT 'ref id to system data (eg. invoice.id)',
  `ref_no` varchar(50) DEFAULT NULL COMMENT 'ref no to system data (eg. invoice.code)',

  `document_uuid` varchar(50) DEFAULT NULL COMMENT 'e invoice document uuid',
  `submission_uid` varchar(50) DEFAULT NULL COMMENT 'e invoice api submission uid',

  `process_status` varchar(20) DEFAULT NULL COMMENT 'Processing status before submission: P = Pending, S = Successfully validated and submitted to E-Invoice, F = Failed validation or submission process',
  `submit_status` varchar(20) DEFAULT NULL COMMENT 'Submission result status: P = Pending, S = Successfully accepted by E-Invoice (Accepted documents), F = Failed submission (Rejected documents)',
  `reason` varchar(200) COMMENT 'validation failure reason / rejected reason etc.',
  
  `status_cd` varchar(10) DEFAULT NULL,
  `dt_created` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` varchar(50) NOT NULL,
  `dt_upd` datetime NOT NULL,
  `upd_by` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=1822 DEFAULT CHARSET=latin1;

