DELIMITER $$
DROP PROCEDURE IF EXISTS db_upd_3002 $$
CREATE PROCEDURE db_upd_3002()
BEGIN

	CREATE TABLE IF NOT EXISTS invoice_attachment (
	  `id` INT NOT NULL AUTO_INCREMENT,
	  `id_inv` BIGINT(20) NOT NULL,
      `name` VARCHAR(255) NULL,
	  `scanned_path` VARCHAR(255) NOT NULL,
      `file_path` VARCHAR(255) NOT NULL,
      `type_cd` VARCHAR(50) NOT NULL,
	  `dt_created` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
	  `created_by` VARCHAR(50) NOT NULL,
	  `dt_update` DATETIME NOT NULL,
	  `updated_by` VARCHAR(50) NOT NULL,
	  PRIMARY KEY (`id`))
	ENGINE = InnoDB;

 	IF NOT EXISTS (SELECT 1 FROM `lookup_cat` WHERE `code` = 'attachment_type' ) THEN
		INSERT INTO `lookup_cat` (`code`, `description`, `remarks`, `dt_created`, `created_by`, `dt_upd`, `upd_by`)
		VALUES ('attachment_type', 'Attachment Type', 'Attachment Type', NOW(), 'SYSTEM',NOW(), 'SYSTEM');
	END IF;

	IF NOT EXISTS (SELECT 1 FROM `lookup_item` WHERE `code` = 'passport_copy' ) THEN
		INSERT INTO `lookup_item` (`lookup_cat_cd`, `code`, `description`, `remarks`, `is_editable`, `seq_no`, `dt_created`, `created_by`, `dt_upd`, `upd_by`)
		VALUES ('attachment_type', 'passport_copy', 'Passport Copy', 'Passport Copy', '0', '1', NOW(), 'SYSTEM', NOW(), 'SYSTEM');
	END IF;

	IF NOT EXISTS (SELECT 1 FROM `lookup_item` WHERE `code` = 'visa_copy' ) THEN
		INSERT INTO `lookup_item` (`lookup_cat_cd`, `code`, `description`, `remarks`, `is_editable`, `seq_no`, `dt_created`, `created_by`, `dt_upd`, `upd_by`)
		VALUES ('attachment_type', 'visa_copy', 'Visa Copy', 'Visa Copy', '0', '2', NOW(), 'SYSTEM', NOW(), 'SYSTEM');
	END IF;

	IF NOT EXISTS (SELECT 1 FROM `lookup_item` WHERE `code` = 'insurance_form' ) THEN
		INSERT INTO `lookup_item` (`lookup_cat_cd`, `code`, `description`, `remarks`, `is_editable`, `seq_no`, `dt_created`, `created_by`, `dt_upd`, `upd_by`)
		VALUES ('attachment_type', 'insurance_form', 'Insurance Form', 'Insurance Form', '0', '3', NOW(), 'SYSTEM', NOW(), 'SYSTEM');
	END IF;

	IF NOT EXISTS (SELECT 1 FROM `lookup_item` WHERE `code` = 'flight_ticket' ) THEN
		INSERT INTO `lookup_item` (`lookup_cat_cd`, `code`, `description`, `remarks`, `is_editable`, `seq_no`, `dt_created`, `created_by`, `dt_upd`, `upd_by`)
		VALUES ('attachment_type', 'flight_ticket', 'Flight Ticket', 'Flight Ticket', '0', '4', NOW(), 'SYSTEM', NOW(), 'SYSTEM');
    END IF;

	IF NOT EXISTS (SELECT 1 FROM `lookup_item` WHERE `code` = 'bank_in_slip' ) THEN
		INSERT INTO `lookup_item` (`lookup_cat_cd`, `code`, `description`, `remarks`, `is_editable`, `seq_no`, `dt_created`, `created_by`, `dt_upd`, `upd_by`)
		VALUES ('attachment_type', 'bank_in_slip', 'Bank In Slip', 'Bank In Slip', '0', '5', NOW(), 'SYSTEM', NOW(), 'SYSTEM');
    END IF;

    INSERT INTO `global_config` (`code`, `description`, `value`, `seq`, `dt_created`, `created_by`, `dt_upd`, `upd_by`, `version`)
	VALUES ('PATH_INV_ATTACHMENT', 'Invoice Attachment', '/upload/invoice/attachment', '8', NOW(), 'SYSTEM', NOW(), 'SYSTEM', '1');

END $$

CALL db_upd_3002() $$

