package com.bcs.zsg.bank.vo;

import com.bcs.zsg.core.vo.BaseVO;

public class InvPmntCBLinkVO extends BaseVO {
	private static final long serialVersionUID = 1L;

	private Long idCompany;
	private Long idInvoice;
	private String invoiceNo;
	private Long idInvPmnt;
	private Long idCashBook;
	
	/**
	 * @return the idCompany
	 */
	public Long getIdCompany() {
		return idCompany;
	}
	/**
	 * @param idCompany the idCompany to set
	 */
	public void setIdCompany(Long idCompany) {
		this.idCompany = idCompany;
	}
	/**
	 * @return the idInvoice
	 */
	public Long getIdInvoice() {
		return idInvoice;
	}
	/**
	 * @param idInvoice the idInvoice to set
	 */
	public void setIdInvoice(Long idInvoice) {
		this.idInvoice = idInvoice;
	}
	/**
	 * @return the invoiceNo
	 */
	public String getInvoiceNo() {
		return invoiceNo;
	}
	/**
	 * @param invoiceNo the invoiceNo to set
	 */
	public void setInvoiceNo(String invoiceNo) {
		this.invoiceNo = invoiceNo;
	}
	/**
	 * @return the idInvPmnt
	 */
	public Long getIdInvPmnt() {
		return idInvPmnt;
	}
	/**
	 * @param idInvPmnt the idInvPmnt to set
	 */
	public void setIdInvPmnt(Long idInvPmnt) {
		this.idInvPmnt = idInvPmnt;
	}
	/**
	 * @return the idCashBook
	 */
	public Long getIdCashBook() {
		return idCashBook;
	}
	/**
	 * @param idCashBook the idCashBook to set
	 */
	public void setIdCashBook(Long idCashBook) {
		this.idCashBook = idCashBook;
	}
}
