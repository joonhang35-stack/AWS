<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf">

<style>
	.disabled {
		background : grey !important;
		color : white;
		cursor : auto;
		pointer-events : none;
	}
</style>
<p:panelGrid id="idSearchTypeA" style="width:550px;">
	<p:row rendered="#{invoiceReportBean.reportType == 'A' || invoiceReportBean.reportType == 'B' || invoiceReportBean.reportType == 'C'}">
		<p:column style="width:100px;">
			<h:outputLabel>Invoice Date</h:outputLabel>
		</p:column>
		<p:column style="width:10px;">
			<p:separator style="width:2px;height:20px"/>
		</p:column>
		<p:column style="width:80px;">
		 	<p:calendar id="idInvoiceDateFr" label="Invoice Date From" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{invoiceReportBean.searchParamVO.obj1}"/>
			<p:watermark for="idInvoiceDateFr" value="Invoice Date From" />
		</p:column>
		<p:column style="width:80px;">
			<p:calendar id="idInvoiceDateTo" label="Invoice Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{invoiceReportBean.searchParamVO.obj2}"/>
			<p:watermark for="idInvoiceDateTo" value="Invoice Date To" />
		</p:column>
	</p:row>
	<p:row rendered="#{invoiceReportBean.reportType == 'A' || invoiceReportBean.reportType == 'C'}">
		<p:column>
			<h:outputLabel>Departure Date</h:outputLabel>
		</p:column>
		<p:column>
			<p:separator style="width:2px;height:20px"/>
		</p:column>
		<p:column>
		 	<p:calendar id="idDepartureDateFr" label="Departure Date From" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{invoiceReportBean.searchParamVO.obj3}"/>
			<p:watermark for="idDepartureDateFr" value="Departure Date From" />
		</p:column>
		<p:column>
			<p:calendar id="idDepartureDateTo" label="Departure Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{invoiceReportBean.searchParamVO.obj4}"/>
			<p:watermark for="idDepartureDateTo" value="Departure Date To" />
		</p:column>
	</p:row>
	<p:row rendered="#{invoiceReportBean.reportType == 'A'}">
		<p:column>
			<h:outputLabel>Sales Person</h:outputLabel>
		</p:column>
		<p:column>
			<p:separator style="width:2px;height:20px"/>
		</p:column>
		<p:column>
		 	<h:selectOneMenu id="idSalesPerson" label="Sales Person" value="#{invoiceReportBean.searchParamVO.obj5}" effect="fade" >
				<f:selectItem itemLabel="All" itemValue=""/>
				<f:selectItems value="#{invoiceReportBean.employeeList}" var="vo" itemValue="#{vo.id}" itemLabel="#{vo.userVO.name}"/>
			</h:selectOneMenu>
		</p:column>
	</p:row>
	<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
		<p:column>
			<h:outputLabel>Sales Person</h:outputLabel>
		</p:column>
		<p:column>
			<p:separator style="width:2px;height:20px"/>
		</p:column>
		<p:column>
		 	<h:selectOneMenu id="idSalesListingPerson" label="Sales Person" value="#{invoiceReportBean.searchParamVO.obj5}" effect="fade" >
				<f:selectItem itemLabel="All" itemValue=""/>
				<f:selectItems value="#{invoiceReportBean.employeeList}" var="vo" itemValue="#{vo.id}" itemLabel="#{vo.userVO.name}"/>
			</h:selectOneMenu>
		</p:column>
	</p:row>
	<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
		<p:column>
			<h:outputLabel>Invoice Category</h:outputLabel>
		</p:column>
		<p:column>
			<p:separator style="width:2px;height:20px"/>
		</p:column>
		<p:column>
			<p:selectCheckboxMenu id="idSalesListingInvCat" value="#{invoiceReportBean.idInvCatList}"
				label="Invoice Category" filter="true" filterMatchMode="startsWith">
		        <f:selectItems value="#{bterp:lookupItemList('inv_cat')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
		    </p:selectCheckboxMenu>
		</p:column>
	</p:row>
	<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
		<p:column>
			<h:outputLabel>Department</h:outputLabel>
		</p:column>
		<p:column>
			<p:separator style="width:2px;height:20px"/>
		</p:column>
		<p:column>
			<p:selectCheckboxMenu id="idSalesListingDepartment" value="#{invoiceReportBean.idDepartmentList}"
				label="Department" filter="true" filterMatchMode="startsWith">
		        <f:selectItems value="#{bterp:lookupItemList('dept_type')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
		    </p:selectCheckboxMenu>
		</p:column>
	</p:row>
	<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
		<p:column>
			<h:outputLabel>Order Source</h:outputLabel>
		</p:column>
		<p:column>
			<p:separator style="width:2px;height:20px"/>
		</p:column>
		<p:column>
			<p:selectCheckboxMenu id="idSalesListingOS" value="#{invoiceReportBean.idOrderSourceList}"
				label="Order Source" filter="true" filterMatchMode="startsWith">
		        <f:selectItems value="#{bterp:lookupItemList('ordr_sorc')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
		    </p:selectCheckboxMenu>
		</p:column>
	</p:row>
	<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
		<p:column>
			<h:outputLabel>Tour Code</h:outputLabel>
		</p:column>
		<p:column>
			<p:separator style="width:2px;height:20px"/>
		</p:column>
		<p:column colspan="2">
			<p:column style="width:150px;" colspan="2">
				<p:panel id="idTourCd">
					<p:inputText id="idSalesListingTC" label="Tour Code" value="#{invoiceReportBean.tourDepVO.code}" onkeydown="preventBackspace()" style="background:#ccc;" size="30" maxlength="0"/>
					&nbsp;
			        <p:commandButton icon="ui-icon-search" actionListener="#{invoiceReportBean.loadTour}" update=":idTourCodeList" oncomplete="varTourCodeList.show()" process="@this" rendered="#{empty invoiceReportBean.tourDepVO.id}"/>
					<p:commandButton icon="ui-icon-close" actionListener="#{invoiceReportBean.clearTourCode}" update=":idFormInvoiceReport:idTourCd" process="@this" rendered="#{not empty invoiceReportBean.tourDepVO.id}"/>
				</p:panel>
			</p:column>
		</p:column>
	</p:row>
	<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
		<p:column style="width:110px;">
			<p:outputLabel value="Region" />
		</p:column>
		<p:column style="width:10px;">
			<p:separator style="width:2px;height:20px"/>
		</p:column>
		<p:column>
			<p:selectCheckboxMenu id="idRegion" value="#{invoiceReportBean.idRegionList}"
				label="Region List" filter="true" filterMatchMode="startsWith">
		        <f:selectItems value="#{invoiceReportBean.tourCatViewVOList}" var="vo" itemValue="#{vo.id}" itemLabel="#{vo.desc}"/>
		    </p:selectCheckboxMenu>
		</p:column>
	</p:row>
	<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
		<p:column style="width:110px;">
			<p:outputLabel value="Country" />
		</p:column>
		<p:column style="width:10px;">
			<p:separator style="width:2px;height:20px"/>
		</p:column>
		<p:column>
			<p:selectCheckboxMenu id="idCountry" value="#{invoiceReportBean.idCountryList}"
				label="Country List" filter="true" filterMatchMode="startsWith" onHide="executeOnOnhide();">
		        <f:selectItems value="#{invoiceReportBean.tourCountryVOList}" var="vo" itemValue="#{vo.id}" itemLabel="#{vo.desc}"/>
		    </p:selectCheckboxMenu>
		    
		     <p:remoteCommand name="executeOnOnhide" actionListener="#{invoiceReportBean.handleCountryChange}"
		        update=":idFormInvoiceReport:idProduct" process="@this, :idFormInvoiceReport:idCountry" global="false"/>  
		</p:column>
	</p:row>
	<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
		<p:column>
			<p:outputLabel value="Product" />
		</p:column>
		<p:column>
			<p:separator style="width:2px;height:20px"/>
		</p:column>
		<p:column>
			<p:selectCheckboxMenu id="idProduct" value="#{invoiceReportBean.idProductList}"
				label="Product List" filter="true" filterMatchMode="startsWith">
		        <f:selectItems value="#{invoiceReportBean.tourThemeVOList}" var="vo" itemValue="#{vo.id}" itemLabel="#{vo.desc}"/>
		    </p:selectCheckboxMenu>
		</p:column>
	</p:row>
	
</p:panelGrid>

	<h:panelGrid columns="1">
		<p:commandButton value="#{msg['common.button.label.cancel']}" oncomplete="varCustListDialog.hide();"/>
	</h:panelGrid>
</ui:composition>