<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui"
	xmlns:pe="http://primefaces.org/ui/extensions"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	template="/WEB-INF/views/layouts/main.xhtml"
	xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

	<ui:define name="content">

		<style>
			.invoiceRefDialog {
				height: 100% !important;
				overflow: auto;
			}
			.badge-transferred {
    			background-color: #ffa500; /* Orange color similar to the screenshot */
			    color: white;
			    padding: 1px 4px; /* Adjusted padding to make the badge smaller */
			    margin-left: 5px;
			    border-radius: 3px;
			    font-size: 0.75em; /* Adjusted font size to make the badge text smaller */
			}
			#idAddInvoicePaxDialog.ui-dialog .ui-dialog-content {
				overflow: visible !important;
			}
		</style>

		<script type="text/javascript">
		    function fncLoad() {
		        document.getElementById('idInvListForm:idAddBtn').onclick();
		    }
		    
		    function onValidationReason(xhr, status, args) {
				if (args.validationFailed) {
					varReasonDialog.show();
				} else {
					varReasonDialog.hide();
					//varAddInvoiceDialog.hide();
					//varInvoiceListTable.clearFilters();
				}
			}
		    
		    function onTransferValidation(xhr, status, args) {
				if (!args.validationFailed) {
					varAvailableTourDepListDialog.hide();
					varTransferConfirmationDialog.hide();
				}
			}
		    
		    document.addEventListener('DOMContentLoaded', function() {
		        var filters = document.querySelectorAll('input.ui-column-filter');
		        filters.forEach(function(filter) {
		            filter.setAttribute('enterkeyhint', 'enter');
		        });
		    });
		</script>
		
		<p:panel header="Pax Statement Issuance" toggleable="true" toggleSpeed="500">
			<h:body onload="#{salesBean.strOnLoad}">
				<link rel="stylesheet"
					href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
					<h:form id="idInvListForm">
						<p:tabView id="idTabView">
							<p:tab title="Pax Statement List">
								<p:panelGrid style="margin-top:5px;">
									<p:row>
										<p:column style="width: 50px;">
											<p:commandButton id="idAddBtn" value="Add"
												actionListener="#{salesBean.initAddInvoice}"
												oncomplete="varAddInvoiceDialog.show()" process="@this"
												update=":idAddInvoiceDialog">
			 									<pe:resetEditableValues for="idAddInvoiceForm" />
											</p:commandButton>
										</p:column>
										<p:column style="width: 10px;">
											<p:separator style="width:2px;height:20px" />
										</p:column>
										<p:column style="width: 80px;">
											<p:commandButton id="toggler" value="Columns" style="float:left"
												icon="ui-icon-calculator"
												actionListener="#{salesBean.handleChangeColumnsViewClick}"
												oncomplete="varListingTableViewDialog.show();" process="@this"
												update=":idListingTableViewDialog" />
										</p:column>
										<p:column style="width: 10px;">
											<p:separator style="width:2px;height:20px" />
										</p:column>
										<p:column style="width: 80px;">
											<h:outputText value="Order Source" />
										</p:column>
										<p:column style="width: 100px;">
											<h:selectOneMenu id="idSelOrderSource" label="Order Source"
												value="#{salesBean.orderSourceCode}" effect="fade">
												<f:selectItem itemLabel="All" itemValue="" />
												<f:selectItems value="#{bterp:lookupItemList('ordr_sorc')}"
													var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
												<p:ajax event="change"
													listener="#{salesBean.handleOrderSourceSelect}"
													oncomplete="varInvoiceListTable.clearFilters()" update="@form" />
											</h:selectOneMenu>
										</p:column>
										<p:column style="width: 120px;">
											<h:outputText value="Statement Category" />
										</p:column>
										<p:column style="width: 120px;">
											<h:selectOneMenu id="idSelInvoiceCategory" label="Statement Category"
												value="#{salesBean.invoiceCategoryCode}" effect="fade">
												<f:selectItem itemLabel="All" itemValue="" />
												<f:selectItems value="#{bterp:lookupItemList('inv_cat')}"
													var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
												<p:ajax event="change"
													listener="#{salesBean.handleInvoiceCategorySelect}"
													oncomplete="varInvoiceListTable.clearFilters()" update="@form" />
											</h:selectOneMenu>
										</p:column>
										<p:column>
											<p:commandButton id="idSendReviewBtn" value="Send To Review 2"
												actionListener="#{salesBean.onSendToReview}"
												oncomplete="varSendReviewDialog.show()" process="@this"
												update=":idSendReviewDialog">
											</p:commandButton>
										</p:column>
									</p:row>
								</p:panelGrid>
								<p:panelGrid id="idSearchPanel" style="display: none;">
									<p:row>
										<p:column style="width: 66px;">
											<p:outputLabel for="idValidFrom" value="Date From" />
										</p:column>
										<p:column style="width: 80px;">
											<p:calendar id="idValidFrom" size="12" navigator="true" showButtonPanel="true"
												pattern="dd-MMM-yyyy" value="#{salesBean.fromDate}">
											</p:calendar>
			
										</p:column>
										<p:column style="width: 52px;">
											<p:outputLabel value="Date To" for="idValidTo" />
										</p:column>
										<p:column style="width: 66px;">
											<p:calendar id="idValidTo" size="12" navigator="true" showButtonPanel="true"
												pattern="dd-MMM-yyyy" value="#{salesBean.toDate}">
											</p:calendar>
										</p:column>
										<p:column style="width: 10px;">
											<p:separator style="width:2px;height:20px" />
										</p:column>
										<p:column style="width: 94px;">
											<p:outputLabel value="Invoice From"
												for="idInvoiceFrom" />
										</p:column>
										<p:column style="width: 180px;">
											<h:outputText value="#{salesBean.prefixValue}"/>&nbsp;
											<p:inputText id="idInvoiceFrom" maxlength="8" value="#{salesBean.invFrom}" />
											<pe:keyFilter for="idInvoiceFrom" mask="num" /> 
										</p:column>
										<p:column style="width: 70px;">
											<p:outputLabel value="Invoice To"
												for="idInvoiceTo" />
										</p:column>
										<p:column style="width: 180px;">
											<h:outputText value="#{salesBean.prefixValue}"/>&nbsp;
											<p:inputText id="idInvoiceTo" maxlength="8" value="#{salesBean.invTo}" />
											<pe:keyFilter for="idInvoiceTo" mask="num" /> 
										</p:column>
										<p:column style="width: 10px;">
											<p:separator style="width:2px;height:20px" />
										</p:column>
										<p:column>
											<p:commandButton value="Search" actionListener="#{salesBean.handleFilterSource}" id="invSearch" oncomplete="varInvoiceListTable.clearFilters()" update="@form">
												</p:commandButton>
											<p:defaultCommand target="invSearch" scope="idSearchPanel" />
										</p:column>
									</p:row>
								</p:panelGrid>
			
								<p:dataTable id="idInvListTable" widgetVar="varInvoiceListTable"
									value="#{salesBean.lazyDataModel}" var="vo" paginator="true"
									rows="20" rowIndexVar="rowIndex"
									paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
									rowsPerPageTemplate="3, 20, 30, 50"
									filteredValue="#{salesBean.filteredObjList}" lazy="true"
									selection="#{salesBean.selectedInvoiceList}"
									filterEvent="enter" rowKey="#{vo.id}">
									<p:ajax event="rowSelectCheckbox"/>
									<p:ajax event="toggleSelect"/>
									<p:column selectionMode="multiple" style="width:16px;text-align:center" />
									<p:column headerText="Edit" width="40" style="text-align:center;"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(1)}">
										<p:commandButton icon="ui-icon-pencil"
											actionListener="#{salesBean.onInvoiceSelected(vo)}"
											oncomplete="varAddInvoiceDialog.show()"
											update=":idAddInvoiceDialog" process="@this" />
									</p:column>
			
									<p:column headerText="Cancel" width="40"
										style="text-align:center;"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(2)}">
										<p:commandButton icon="ui-icon-close"
											actionListener="#{salesBean.onInvoiceSelected(vo)}"
											oncomplete="varDelInvDialog.show()"
											rendered="#{(vo.statusCd eq 'IN' and salesBean.invPmntAuthVO.invVoidInvoiced) or ((vo.statusCd eq 'DP' or vo.statusCd eq 'FP') and salesBean.invPmntAuthVO.invCancelFPorDP)}" process="@this" />
									</p:column>
			
									<p:column id="invoiceNo" width="128" headerText="Pax Statement No." sortBy="#{vo.psNo}"
										filterBy="#{vo.psNo}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(3)}">
			        					<h:outputText value="#{salesBean.prefixValue} #{vo.psNo}" />
			            				<h:outputText value="Transferred" styleClass="badge-transferred" rendered="#{not empty vo.transferredDate}" />
									</p:column>
			
									<p:column headerText="Statement Date" sortBy="#{vo.invoiceDt}"
										filterBy="#{vo.invoiceDt}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(4)}">
										<h:outputText value="#{vo.invoiceDt}">
											<f:convertDateTime pattern="dd-MMM-yyyy" />
										</h:outputText>
									</p:column>
			
									<p:column headerText="Departure Date" sortBy="#{vo.departureDt}"
										filterBy="#{vo.departureDt}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(5)}">
										<h:outputText value="#{vo.departureDt}">
											<f:convertDateTime pattern="dd-MMM-yyyy" />
										</h:outputText>
									</p:column>
			
									<p:column headerText="Sales person" sortBy="#{vo.salerName}"
										filterBy="#{vo.salerName}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(6)}">
										<h:outputText value="#{vo.salerName}" />
									</p:column>
									<p:column headerText="Customer No." sortBy="#{vo.custCd}"
										filterBy="#{vo.custCd}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(7)}">
										<h:outputText value="#{vo.custCd}" />
									</p:column>
			
									<p:column headerText="Customer Name" sortBy="#{vo.custName}"
										filterBy="#{vo.custName}" filterMatchMode="contains"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(8)}">
										<h:outputText
											value="#{bterp:lookupItemDesc('salutatn', vo.custSalutation)} #{vo.custName}"
											style="text-transform:uppercase;" />
									</p:column>
			
									<p:column headerText="Company Name" sortBy="#{vo.coName}"
										filterBy="#{vo.coName}" filterMatchMode="contains"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(9)}">
										<h:outputText value="#{vo.coName}" />
									</p:column>
			
									<p:column headerText="Tour Code" sortBy="#{vo.tourCd}"
										filterBy="#{vo.tourCd}" filterMatchMode="contains"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(10)}">
										<h:outputText value="#{vo.tourCd}" />
									</p:column>
			
									<p:column headerText="Booking No" sortBy="#{vo.bookingId}"
										filterBy="#{vo.bookingId}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(11)}">
										<h:outputText value="#{vo.bookingId}" />
									</p:column>
			
									<p:column headerText="Order Source" sortBy="#{vo.orderCd}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(12)}">
										<h:outputText value="#{bterp:lookupItemDesc('ordr_sorc', vo.orderCd)}" />
									</p:column>
									
									<p:column headerText="Statement Category" sortBy="#{vo.catCd}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(13)}">
										<h:outputText value="#{bterp:lookupItemDesc('inv_cat', vo.catCd)}" />
									</p:column>
			
									<p:column headerText="Ticket No(s)" sortBy="#{vo.tickets}"
										filterBy="#{vo.tickets}" width="200"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(14)}">
										<h:outputText value="#{vo.tickets}" />
									</p:column>
			
									<p:column headerText="Total Amt" sortBy="#{vo.amount}"
										filterBy="#{vo.amount}" styleClass="txt_center"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(15)}">
										<h:outputText value="#{vo.amount}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText>
									</p:column>
			
									<p:column headerText="Amt Due" sortBy="#{vo.balance}"
										filterBy="#{vo.balance}" styleClass="txt_center"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(16)}">
										<h:outputText value="#{vo.balance}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText>
									</p:column>
			
									<p:column headerText="Statement Due" sortBy="#{vo.invoiceDue}"
										filterBy="#{vo.invoiceDue}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(17)}">
										<h:outputText value="#{vo.invoiceDue}">
											<f:convertDateTime pattern="dd-MMM-yyyy" />
										</h:outputText>
									</p:column>
									
									<p:column headerText="Pax Statement Status" sortBy="#{vo.docTypeStatus}"
										style="width: 80px;" styleClass="txt_center"
										filterBy="#{vo.docTypeStatus}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(18)}">
										<h:outputText
											value="#{vo.docTypeStatus}" />
									</p:column>
			
									<p:column headerText="Payment Status" sortBy="#{vo.statusCd}"
										style="width: 80px;" styleClass="txt_center"
										filterBy="#{vo.statusCd}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(18)}">
										<h:outputText
											value="#{zsg:referenceDataValue('INV_STATUS', vo.statusCd)}" />
									</p:column>
			
									<p:column headerText="Booking Status"
										sortBy="#{vo.bookingStatusCd}" style="width: 80px;"
										styleClass="txt_center" filterBy="#{vo.bookingStatusCd}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(19)}">
										<h:outputText
											value="#{zsg:referenceDataValue('BOOK_STATUS', vo.bookingStatusCd)}" />
									</p:column>
			
									<p:column headerText="Internal Remarks" style="width: 80px;"
										styleClass="txt_center" filterBy="#{vo.internalRemarks}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(20)}">
										<p:outputLabel id="idInternalRemarks" value="View"
											rendered="#{vo.internalRemarks ne null and vo.internalRemarks ne ''}">
											<i class="fa fa-info-circle" aria-hidden="true" />
										</p:outputLabel>
			
										<!-- <p:tooltip id="idToolTipInternalRemarks" for="idInternalRemarks"
											showEffect="fade" hideEffect="fade" position="bottom"
											style="width:600px;">
											<h:outputText escape="true" value="#{vo.internalRemarks}"
												style="white-space: pre-wrap" />
										</p:tooltip> -->
										<pe:tooltip for="idInternalRemarks" shared="true" showDelay="300" targetPosition="top left" position="bottom right"
											rendered="#{not empty vo.internalRemarks}">
											<h:outputText value="#{vo.internalRemarks}" escape="true" style="white-space: pre-wrap"/>
										</pe:tooltip>
									</p:column>
			
									<p:column headerText="Updated By" sortBy="#{vo.updatedBy}"
										style="width: 80px;" styleClass="txt_center"
										filterBy="#{vo.updatedBy}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(21)}">
										<h:outputText value="#{vo.updatedBy}" />
									</p:column>
			
									<p:column headerText="Updated Date" sortBy="#{vo.updatedDate}"
										filterBy="#{vo.updatedDate}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(22)}">
										<h:outputText value="#{vo.updatedDate}">
											<f:convertDateTime pattern="dd-MMM-yyyy HH:mm:ss" />
										</h:outputText>
									</p:column>
								</p:dataTable>
			
								<p:panelGrid style="margin-top:5px; width:1px">
									<p:row>
										<p:column>
											<p:commandButton value="Add"
												actionListener="#{salesBean.initAddInvoice}"
												oncomplete="varAddInvoiceDialog.show()" process="@this"
												update=":idAddInvoiceDialog">
												<pe:resetEditableValues for="idAddInvoiceForm" />
											</p:commandButton>
										</p:column>
									</p:row>
								</p:panelGrid>
				
							</p:tab>
							<p:tab title="In-Review Statements">
								<p:panelGrid style="margin-top:5px;">
									<p:row>
										<p:column>
											<p:commandButton id="idConvertBtn" value="Convert To Invoice"
												actionListener="#{salesBean.onConvert}">
<!-- 												oncomplete="varSendReviewDialog.show()" process="@this"
												update=":idSendReviewDialog"> -->
											</p:commandButton>
										</p:column>
									</p:row>
								</p:panelGrid>
								
								<p:dataTable id="idPaxStmtReviewListTable" widgetVar="varPaxStmtReviewListTable"
									value="#{salesBean.lazyReviewingPaxStmtDataModel}" var="vo" paginator="true"
									rows="20" rowIndexVar="rowIndex"
									paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
									rowsPerPageTemplate="3, 20, 30, 50"
									filteredValue="#{salesBean.filteredObjList}" lazy="true"
									selection="#{salesBean.selectedInvoiceList}"
									filterEvent="enter" rowKey="#{vo.id}">
									<p:ajax event="rowSelectCheckbox"/>
									<p:ajax event="rowUnselectCheckbox"/>
									<p:ajax event="toggleSelect"/>
									<p:column selectionMode="multiple" style="width:16px;text-align:center" />
									<p:column headerText="Edit" width="40" style="text-align:center;"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(1)}">
										<p:commandButton icon="ui-icon-pencil"
											actionListener="#{salesBean.onInvoiceSelected(vo)}"
											oncomplete="varAddInvoiceDialog.show()"
											update=":idAddInvoiceDialog" process="@this" />
									</p:column>
			
									<p:column headerText="Cancel" width="40"
										style="text-align:center;"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(2)}">
										<p:commandButton icon="ui-icon-close"
											actionListener="#{salesBean.onInvoiceSelected(vo)}"
											oncomplete="varDelInvDialog.show()"
											rendered="#{(vo.statusCd eq 'IN' and salesBean.invPmntAuthVO.invVoidInvoiced) or ((vo.statusCd eq 'DP' or vo.statusCd eq 'FP') and salesBean.invPmntAuthVO.invCancelFPorDP)}" process="@this" />
									</p:column>
			
									<p:column id="invoiceNo" width="128" headerText="Pax Statement No." sortBy="#{vo.psNo}"
										filterBy="#{vo.psNo}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(3)}">
			        					<h:outputText value="#{salesBean.prefixValue} #{vo.psNo}" />
			            				<h:outputText value="Transferred" styleClass="badge-transferred" rendered="#{not empty vo.transferredDate}" />
									</p:column>
			
									<p:column headerText="Statement Date" sortBy="#{vo.invoiceDt}"
										filterBy="#{vo.invoiceDt}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(4)}">
										<h:outputText value="#{vo.invoiceDt}">
											<f:convertDateTime pattern="dd-MMM-yyyy" />
										</h:outputText>
									</p:column>
			
									<p:column headerText="Departure Date" sortBy="#{vo.departureDt}"
										filterBy="#{vo.departureDt}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(5)}">
										<h:outputText value="#{vo.departureDt}">
											<f:convertDateTime pattern="dd-MMM-yyyy" />
										</h:outputText>
									</p:column>
			
									<p:column headerText="Sales person" sortBy="#{vo.salerName}"
										filterBy="#{vo.salerName}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(6)}">
										<h:outputText value="#{vo.salerName}" />
									</p:column>
									<p:column headerText="Customer No." sortBy="#{vo.custCd}"
										filterBy="#{vo.custCd}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(7)}">
										<h:outputText value="#{vo.custCd}" />
									</p:column>
			
									<p:column headerText="Customer Name" sortBy="#{vo.custName}"
										filterBy="#{vo.custName}" filterMatchMode="contains"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(8)}">
										<h:outputText
											value="#{bterp:lookupItemDesc('salutatn', vo.custSalutation)} #{vo.custName}"
											style="text-transform:uppercase;" />
									</p:column>
			
									<p:column headerText="Company Name" sortBy="#{vo.coName}"
										filterBy="#{vo.coName}" filterMatchMode="contains"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(9)}">
										<h:outputText value="#{vo.coName}" />
									</p:column>
			
									<p:column headerText="Tour Code" sortBy="#{vo.tourCd}"
										filterBy="#{vo.tourCd}" filterMatchMode="contains"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(10)}">
										<h:outputText value="#{vo.tourCd}" />
									</p:column>
			
									<p:column headerText="Booking No" sortBy="#{vo.bookingId}"
										filterBy="#{vo.bookingId}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(11)}">
										<h:outputText value="#{vo.bookingId}" />
									</p:column>
			
									<p:column headerText="Order Source" sortBy="#{vo.orderCd}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(12)}">
										<h:outputText value="#{bterp:lookupItemDesc('ordr_sorc', vo.orderCd)}" />
									</p:column>
									
									<p:column headerText="Statement Category" sortBy="#{vo.catCd}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(13)}">
										<h:outputText value="#{bterp:lookupItemDesc('inv_cat', vo.catCd)}" />
									</p:column>
			
									<p:column headerText="Ticket No(s)" sortBy="#{vo.tickets}"
										filterBy="#{vo.tickets}" width="200"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(14)}">
										<h:outputText value="#{vo.tickets}" />
									</p:column>
			
									<p:column headerText="Total Amt" sortBy="#{vo.amount}"
										filterBy="#{vo.amount}" styleClass="txt_center"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(15)}">
										<h:outputText value="#{vo.amount}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText>
									</p:column>
			
									<p:column headerText="Amt Due" sortBy="#{vo.balance}"
										filterBy="#{vo.balance}" styleClass="txt_center"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(16)}">
										<h:outputText value="#{vo.balance}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText>
									</p:column>
			
									<p:column headerText="Statement Due" sortBy="#{vo.invoiceDue}"
										filterBy="#{vo.invoiceDue}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(17)}">
										<h:outputText value="#{vo.invoiceDue}">
											<f:convertDateTime pattern="dd-MMM-yyyy" />
										</h:outputText>
									</p:column>
									
									<p:column headerText="Pax Statement Status" sortBy="#{vo.docTypeStatus}"
										style="width: 80px;" styleClass="txt_center"
										filterBy="#{vo.docTypeStatus}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(18)}">
										<h:outputText
											value="#{vo.docTypeStatus}" />
									</p:column>
			
									<p:column headerText="Payment Status" sortBy="#{vo.statusCd}"
										style="width: 80px;" styleClass="txt_center"
										filterBy="#{vo.statusCd}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(18)}">
										<h:outputText
											value="#{zsg:referenceDataValue('INV_STATUS', vo.statusCd)}" />
									</p:column>
			
									<p:column headerText="Booking Status"
										sortBy="#{vo.bookingStatusCd}" style="width: 80px;"
										styleClass="txt_center" filterBy="#{vo.bookingStatusCd}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(19)}">
										<h:outputText
											value="#{zsg:referenceDataValue('BOOK_STATUS', vo.bookingStatusCd)}" />
									</p:column>
			
									<p:column headerText="Internal Remarks" style="width: 80px;"
										styleClass="txt_center" filterBy="#{vo.internalRemarks}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(20)}">
										<p:outputLabel id="idInternalRemarks" value="View"
											rendered="#{vo.internalRemarks ne null and vo.internalRemarks ne ''}">
											<i class="fa fa-info-circle" aria-hidden="true" />
										</p:outputLabel>
			
										<!-- <p:tooltip id="idToolTipInternalRemarks" for="idInternalRemarks"
											showEffect="fade" hideEffect="fade" position="bottom"
											style="width:600px;">
											<h:outputText escape="true" value="#{vo.internalRemarks}"
												style="white-space: pre-wrap" />
										</p:tooltip> -->
										<pe:tooltip for="idInternalRemarks" shared="true" showDelay="300" targetPosition="top left" position="bottom right"
											rendered="#{not empty vo.internalRemarks}">
											<h:outputText value="#{vo.internalRemarks}" escape="true" style="white-space: pre-wrap"/>
										</pe:tooltip>
									</p:column>
			
									<p:column headerText="Updated By" sortBy="#{vo.updatedBy}"
										style="width: 80px;" styleClass="txt_center"
										filterBy="#{vo.updatedBy}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(21)}">
										<h:outputText value="#{vo.updatedBy}" />
									</p:column>
			
									<p:column headerText="Updated Date" sortBy="#{vo.updatedDate}"
										filterBy="#{vo.updatedDate}"
										rendered="#{salesBean.listingTableViewVO.verifyVisibility(22)}">
										<h:outputText value="#{vo.updatedDate}">
											<f:convertDateTime pattern="dd-MMM-yyyy HH:mm:ss" />
										</h:outputText>
									</p:column>
								</p:dataTable>
			
							</p:tab>
						</p:tabView>
					</h:form>
			</h:body>
		</p:panel>

		<p:dialog id="idAddInvoiceDialog" header="Pax Statement"
