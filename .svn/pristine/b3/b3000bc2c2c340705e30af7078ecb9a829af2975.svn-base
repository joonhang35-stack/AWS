<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf">
<p:growl id="msg"/>
<script type="text/javascript">
	function onValidation(xhr, status, args) {
		if (args.validationFailed) {
			varMultiPmntDialog.show();
		} else {
			varMultiPmntDialog.hide();
		}
	}
	</script>
	<p:panelGrid>
							
		<p:row>
			<p:column><h:outputLabel for="idAddBankName">Bank Name </h:outputLabel></p:column>
			<p:column>
				<p:inputText id="idAddBankName" label="Bank Name" value="#{billPymtBean.cashBookVO.temp}" onclick="varBankAcctListDialog.show()"/>
			</p:column>
			<p:column><h:outputLabel for="idAddBankAcc">Bank Account </h:outputLabel></p:column>
			<p:column>
				<p:inputText id="idAddBankAcc" label="Bank Account" value="#{billPymtBean.cashBookVO.bankAcc}" onclick="varBankAcctListDialog.show()"/>
			</p:column>
		</p:row>
		
		<p:row>
			<p:column><h:outputLabel for="idAddDate">Date </h:outputLabel></p:column>
			<p:column><p:calendar pattern="dd-MM-yyyy" id="idAddDate" label="Date" value="#{billPymtBean.cashBookVO.dtTrans}" navigator="true" showButtonPanel="true" /></p:column>
			<p:column><h:outputLabel>Cheque No </h:outputLabel></p:column>
			<p:column><p:inputText label="Cheque No" value="#{billPymtBean.cashBookVO.refNo}" /></p:column>
		</p:row>
		
		<p:row>
			<p:column><h:outputLabel for="idAddPayTo">Pay to </h:outputLabel></p:column>
			<p:column>
				<p:inputText id="idAddPayTo" label="Pay to" value="#{billPymtBean.cashBookVO.payee}" />  
			</p:column>
		</p:row>
		
		<p:row>
			<p:column><h:outputLabel>Amount Paid </h:outputLabel></p:column>
			<p:column>
				<p:inputText label="Amount Paid" value="#{billPymtBean.cashBookVO.credit}">
					<f:convertNumber pattern="#,##0.00"/>
				</p:inputText>
			</p:column>
			<p:column><h:outputLabel>Memo Text Box </h:outputLabel></p:column>
			<p:column><p:inputTextarea label="Memo Text Box" value="#{billPymtBean.cashBookVO.remarks}" /></p:column>
		</p:row>
	</p:panelGrid>
	
	<p:panelGrid columns="3" style="width: 1px;">
		<p:commandButton value="Save" actionListener="#{billPymtBean.onMultiBillSelected}" update="@form,:idBillListForm" process="@form" oncomplete="varMultiPmntDialog.hide()"/>
		<p:commandButton value="Cancel" actionListener="#{billPymtBean.resetMultiBillsForm}" oncomplete="varMultiPmntDialog.hide()" update="@form,:idBillListForm:idPurBillPmntTable" process="@this" />
	</p:panelGrid>
</ui:composition>