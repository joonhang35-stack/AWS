									<p:column>
										<p:calendar id="idDepDateToC" label="Departure Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.depDateTo}"/>
										<p:watermark for="idDepDateToC" value="Departure Date To" />
