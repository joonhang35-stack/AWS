								</p:column> -->
		
								<!-- Pax Stmt. No. column -->
								<!-- id not changed due to not sure usage of id -->
								<p:column id="invoiceNo" width="128" headerText="#{salesBean.docTypeDesc} No." sortBy="#{vo.psNo}"
									filterBy="#{vo.psNo}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(3)}">
									<f:facet name="header">
										<h:outputText value="#{salesBean.docTypeDesc} No." />
									</f:facet>
									<h:outputText value="#{salesBean.prefixValue} #{vo.psNo}" />
<!-- 		        					<h:outputText value="#{salesBean.prefixValue} #{salesBean.docTypeCd == 'P' ? vo.psNo : vo.code}" /> -->
		            				<h:outputText value="T" styleClass="badge-transferred" rendered="#{not empty vo.transferredDate}" />
								</p:column>
								
								<p:column id="actualInvoiceNo" width="128" headerText="Invoice No." sortBy="#{vo.code}"
									filterBy="#{vo.code}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(3)}">
									<f:facet name="header">
										<h:outputText value="Invoice No." />
									</f:facet>
		        					<!-- <h:outputText value="#{salesBean.prefixValue} #{vo.code}" /> -->
		        					<p:commandLink 
		        						id="idInvNo" 
		        						style="color: #db3333; text-decoration: underline;" 
		        						rendered="#{vo.code ne null}" 
		        						actionListener="#{salesBean.showDocument(vo,'I')}"
		        						oncomplete="varAddInvoiceDialog.show()"
										update=":idAddInvoiceDialog" 
										process="@this">
										<h:outputText value="#{salesBean.invPrefixVal} #{vo.code}"/>
									</p:commandLink>
									<pe:tooltip for="idInvNo" shared="true" showDelay="3000"  position="top right">
										<h:outputText value="#{salesBean.invPrefixVal} #{vo.code}" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
								</p:column>
		
								<p:column headerText="#{salesBean.docTypeDesc} Date" sortBy="#{vo.invoiceDt}"
									filterBy="#{vo.invoiceDt}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(4)}">
									<f:facet name="header">
