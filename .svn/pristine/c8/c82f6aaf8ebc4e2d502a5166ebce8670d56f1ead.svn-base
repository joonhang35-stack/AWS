							<br/><br/>
							<h:commandLink>
					            <p:graphicImage value="/img/excel.png" />
					            <p:dataExporter type="csv" target="idPaxStmtConvertListTable" fileName="#{salesBean.generateReportFileName('Pax_Statement_Convert_List')}"/>
					        </h:commandLink>
						</p:tab>
						<p:tab title="Split (Parent) Statements" rendered="#{salesBean.docTypeCd == 'P'}">
							<p:panelGrid style="margin-top:5px; width: 1px;">
								<p:row>
									<p:column>
										<p:commandButton value="Search" actionListener="#{salesBean.loadSplitStmtList}" update=":idInvListForm:idTabView:idPaxStmtSplitListTable" />
									</p:column>
									<p:column>
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column>
									 	<p:calendar id="idInvoiceDateFrS" label="Invoice Date From" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.fromDate}"/>
										<p:watermark for="idInvoiceDateFrS" value="Invoice Date From" />
									</p:column>
									<p:column>
										<p:calendar id="idInvoiceDateToS" label="Invoice Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.toDate}"/>
										<p:watermark for="idInvoiceDateToS" value="Invoice Date To" />
									</p:column>
									<p:column>
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column>
									 	<p:calendar id="idDepDateFrS" label="Departure Date From" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.depDateFrom}"/>
										<p:watermark for="idDepDateFrS" value="Departure Date From" />
									</p:column>
									<p:column>
										<p:calendar id="idDepDateToS" label="Departure Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.depDateTo}"/>
										<p:watermark for="idDepDateToS" value="Departure Date To" />
									</p:column>
									<p:column>
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column styleClass="nowrap">
										<h:outputText value="Order Source" />
									</p:column>
									<p:column>
										<h:selectOneMenu id="idSelOrderSourceS" label="Order Source"
											value="#{salesBean.orderSourceCode}" effect="fade">
											<f:selectItem itemLabel="All" itemValue="" />
											<f:selectItems value="#{bterp:lookupItemList('ordr_sorc')}"
												var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
											<p:ajax event="change"
												listener="#{salesBean.handleOrderSourceSelect}"
												oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idTabView:idPaxStmtSplitListTable" />
										</h:selectOneMenu>
									</p:column>
									<p:column styleClass="nowrap">
										<h:outputText value="#{salesBean.docTypeDesc} Category" />
									</p:column>
									<p:column>
										<h:selectOneMenu id="idSelInvoiceCategoryS" label="#{salesBean.docTypeDesc} Category"
											value="#{salesBean.invoiceCategoryCode}" effect="fade">
											<f:selectItem itemLabel="All" itemValue="" />
											<f:selectItems value="#{bterp:lookupItemList('inv_cat')}"
												var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
											<p:ajax event="change"
												listener="#{salesBean.handleInvoiceCategorySelect}"
												oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idTabView:idPaxStmtSplitListTable" />
										</h:selectOneMenu>
									</p:column>
								</p:row>
							</p:panelGrid>
							<p:dataTable id="idPaxStmtSplitListTable" widgetVar="varPaxStmtSplitListTable"
								value="#{salesBean.lazySplitPaxStmtDataModel}" var="vo" paginator="true"
								rows="20" rowIndexVar="rowIndex"
								paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
								rowsPerPageTemplate="20, 30, 50, 100, 300, 500"
								filteredValue="#{salesBean.filteredObjList}" lazy="true" filterEvent="enter" rowKey="#{vo.id}">
								
								<!-- <p:ajax event="rowSelectCheckbox" listener="#{salesBean.onSelect}"/>
								<p:ajax event="rowUnselectCheckbox" listener="#{salesBean.onUnselect}"/>
								<p:ajax event="toggleSelect" listener="#{salesBean.onToggle}" oncomplete="teste()"/>
								<p:ajax event="page" listener="#{salesBean.onPagination}" />
								<p:column selectionMode="multiple" style="width:16px;text-align:center" rendered="#{salesBean.docTypeCd == 'P'}"/>
								 -->	
								 
								<p:column headerText="View" width="40" style="text-align:center;"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(1)}" exportable="false">
									<p:commandButton icon="ui-icon-search"
										actionListener="#{salesBean.onInvoiceSelected(vo)}"
										oncomplete="varAddInvoiceDialog.show()"
										update=":idAddInvoiceDialog" process="@this" />
								</p:column>
								
								<p:column headerText="Undo Split" width="60" style="text-align:center;"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(1)}" exportable="false">
									<p:commandButton icon="ui-icon-arrowreturnthick-1-w"
										actionListener="#{salesBean.onUndoSplit(vo)}"
										oncomplete="if (args &amp;&amp; !args.validationFailed) varUndoSplitDialog.show()"
										update=":idUndoSplitDialog" process="@this" />
								</p:column>
		
								<!-- <p:column headerText="Cancel" width="40"
									style="text-align:center;"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(2)}">
									<p:commandButton icon="ui-icon-close"
										actionListener="#{salesBean.onInvoiceSelected(vo)}"
										oncomplete="varDelInvDialog.show()"
										rendered="#{(vo.statusCd eq 'IN' and salesBean.invPmntAuthVO.invVoidInvoiced) or ((vo.statusCd eq 'DP' or vo.statusCd eq 'FP') and salesBean.invPmntAuthVO.invCancelFPorDP)}" process="@this" />
								</p:column> -->
		
								<p:column id="invoiceNo" width="128" headerText="#{salesBean.docTypeDesc} No." sortBy="#{vo.code}"
