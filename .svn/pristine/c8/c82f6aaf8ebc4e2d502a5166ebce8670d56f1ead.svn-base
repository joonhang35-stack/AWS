		<p:dialog widgetVar="varAddPassIDScannedCopyDialog" modal="true"
			resizable="false" dynamic="true" draggable="true" closable="false">
			<f:facet name="header">
				<h:outputFormat value="Scanned Copy" />
			</f:facet>

			<h:form if="idAddPassIDScannedCopyForm">
				<p:growl id="msg" />
				<p:panelGrid style="width:400px;">
					<p:row>
						<p:column>
							<p:fileUpload id="idScannedCopy"
								fileUploadListener="#{salesBean.handleFileUpload}"
								mode="advanced" auto="true" sizeLimit="10000000"
								allowTypes="/(\.|\/)(pdf|jpg|jpeg|png)$/" description="*.pdf;*.jpg;*.jpeg;*.png"
								update="msg,:idPassIDForm:idPassportScannedCopyPanel,:idPassIDForm:idVisaScannedCopyPanel"
								oncomplete="varAddPassIDScannedCopyDialog.hide()" />
						</p:column>
					</p:row>
				</p:panelGrid>

				<h:panelGrid columns="2" style="width:1px;">
					<p:commandButton value="#{msg['common.button.label.cancel']}"
						oncomplete="varAddPassIDScannedCopyDialog.hide()" process="@this"
						update="@form">
						<pe:resetEditableValues for="idAddPassIDScannedCopyForm" />
					</p:commandButton>
				</h:panelGrid>
			</h:form>
		</p:dialog>

		<p:confirmDialog widgetVar="varDelPassScannedCopyDialog"
			message="Are you sure want to delete this scanned copy?">
			<h:form>
				<p:growl id="msg" />
				<p:commandButton value="Yes"
					actionListener="#{salesBean.delScannedCopy}"
					update="@form,:idPassIDForm:idPassportScannedCopyPanel,:idPassIDForm:idVisaScannedCopyPanel"
					oncomplete="varDelPassScannedCopyDialog.hide()" />
				<p:commandButton value="Cancel"
					onclick="varDelPassScannedCopyDialog.hide()" />
			</h:form>
		</p:confirmDialog>

		<p:dialog id="idTourListDialog" header="Tour List"
			widgetVar="varTourListDialog" modal="true" resizable="false"
			dynamic="true" draggable="true" closable="false">
			<h:form id="idTourListForm">
				<p:dataTable id="idTourListTable" widgetVar="varTourListTable"
					value="#{salesBean.lazyDataModelTourDep}" var="vo" paginator="true" lazy="true" 
					rows="10"
					paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
					rowsPerPageTemplate="10, 20, 30" rowKey="#{vo.id}"
					selectionMode="single" filterEvent="enter">
					<p:ajax event="rowSelect"
						listener="#{salesBean.handleTourDepSelect}"
						update=":idAddInvoiceForm:idSubjLine,:idAddInvoiceForm:idTour,:idAddInvoiceForm:idDepartureDt"
						oncomplete="varTourListTable.clearFilters();varTourListDialog.hide();PrimeFaces.focus('idAddInvoiceForm:idDepartureDt_input');"
						process="@this" />

					<p:column headerText="Tour Code" sortBy="#{vo.code}" filterBy="#{vo.code}" filterMatchMode="contains">
						<h:outputText value="#{vo.code}" />
					</p:column>
					<p:column headerText="Departure Date" sortBy="#{vo.dtDep}" filterBy="#{vo.dtDep}" filterMatchMode="contains" style="text-align:center;">
						<h:outputText value="#{vo.dtDep}">
							<f:convertDateTime pattern="dd-MMM-yyyy" />
						</h:outputText>
					</p:column>
					<p:column headerText="Description" sortBy="#{vo.packageDesc}" filterBy="#{vo.packageDesc}" filterMatchMode="contains"
						style="font-size:10px; width:650px;">
						<h:outputText value="#{vo.numDays}Days "
							rendered="#{vo.numDays != 0}" />
						<h:outputText value="#{vo.numNights}Nights "
							rendered="#{vo.numNights != 0}" />
						<h:outputText
							value="#{vo.nameEn} #{vo.nameOther} #{vo.nameZh}" />
						<h:outputText value=" [#{vo.desc}]" style="color:#FF0000;"
							rendered="#{not empty vo.desc}" />
					</p:column>
				</p:dataTable>
				<h:panelGrid columns="2" style="width: 1px;">
					<p:commandButton value="#{msg['common.button.label.cancel']}" onclick="varTourListDialog.hide();"/><!-- varTourListTable.clearFilters(); -->
					<p:selectBooleanCheckbox
						value="#{salesBean.tourDepListInactiveRecords}" itemLabel="Inactive Records"
						style="width:150px; margin-left:10px;"
						rendered="#{salesBean.invPmntAuthVO.operationsRoles or salesBean.invPmntAuthVO.salesManager or salesBean.invPmntAuthVO.asstSalesManager or salesBean.invPmntAuthVO.sale}">
						<p:ajax event="change" listener="#{salesBean.loadTourDepartureList}" update=":idTourListForm:idTourListTable" process="@this"/>	
					</p:selectBooleanCheckbox>
				</h:panelGrid>
			</h:form>
		</p:dialog>
		
		<p:dialog id="idEmployeeListDialog" header="Employee List"
			widgetVar="varEmployeeListDialog" modal="true" resizable="false"
			dynamic="true" draggable="true" closable="false">
			<h:form id="idEmployeeListForm">
				<p:dataTable widgetVar="varEmployeeListTable"
					value="#{salesBean.employeeList}" var="vo" paginator="true"
					rows="10"
					paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
					rowsPerPageTemplate="10, 20, 30" rowKey="#{vo.id}"
					selectionMode="single" filterEvent="enter">
					<p:ajax event="rowSelect"
						listener="#{salesBean.handleEmployeeSelect}"
						update=":idAddInvoiceForm:idSalesPerson"
						oncomplete="varEmployeeListTable.clearFilters();varEmployeeListDialog.hide();"
						process="@this" />

					<p:column headerText="Employee Id" sortBy="#{vo.id}"
						filterBy="#{vo.id}" filterMatchMode="contains">
						<h:outputText value="#{vo.id}" />
					</p:column>
					<p:column headerText="Name" sortBy="#{vo.userVO.name}"
						filterBy="#{vo.userVO.name}" filterMatchMode="contains"
						style="font-size:10px; width:650px;">
						<h:outputText value="#{vo.userVO.name}" />
					</p:column>
				</p:dataTable>
				<h:panelGrid columns="1">
					<p:commandButton value="#{msg['common.button.label.cancel']}"
						onclick="varEmployeeListDialog.hide();varEmployeeListTable.clearFilters();" />
				</h:panelGrid>
			</h:form>
		</p:dialog>
		
		<p:dialog id="idTFairSalerListDialog" header="Refferal SP"
			widgetVar="varTFairSalerListDialog" modal="true" resizable="false"
			dynamic="true" draggable="true" closable="false">
			<h:form id="idTFairSalerListForm">
				<p:dataTable widgetVar="varTFairSalerListTable"
					value="#{salesBean.employeeList}" var="vo" paginator="true"
					rows="10"
					paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
					rowsPerPageTemplate="10, 20, 30" rowKey="#{vo.id}"
					selectionMode="single" filterEvent="enter">
					<p:ajax event="rowSelect"
						listener="#{salesBean.handleTFairSalerSelect}"
						update=":idAddInvoiceForm:idTFairSalesPerson"
