								<p:row>
									<p:column styleClass="nowrap">
										<h:outputText value="Order Source" />
									</p:column>
									<p:column style="width:10px;">
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column>
										<h:selectOneMenu id="idSelOrderSourceCC" label="Order Source"
											value="#{salesBean.orderSourceCode}" effect="fade">
											<f:selectItem itemLabel="All" itemValue="" />
											<f:selectItems value="#{bterp:lookupItemList('ordr_sorc')}"
												var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
											
										</h:selectOneMenu>
									</p:column>
									<p:column></p:column>
								</p:row>
								<p:row>
									<p:column styleClass="nowrap">
										<h:outputText value="#{salesBean.docTypeDesc} Category" />
									</p:column>
									<p:column style="width:10px;">
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column>
										<h:selectOneMenu id="idSelInvoiceCategoryCC" label="#{salesBean.docTypeDesc} Category"
											value="#{salesBean.invoiceCategoryCode}" effect="fade">
											<f:selectItem itemLabel="All" itemValue="" />
											<f:selectItems value="#{bterp:lookupItemList('inv_cat')}"
												var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
											
										</h:selectOneMenu>
									</p:column>
									<p:column></p:column>
								</p:row>
								<p:row>
									<p:column styleClass="nowrap" rendered="#{salesBean.docTypeCd eq 'I'}">
										<h:outputText value="E-Invoice Status" />
									</p:column>
									<p:column style="width:10px;">
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column rendered="#{salesBean.docTypeCd eq 'I'}">
										<h:selectOneMenu id="idEInvStatusCC" label="E-Invoice Status" value="#{salesBean.eInvoiceStatus}">
											<f:selectItem itemLabel="All" itemValue="" />
											<f:selectItems value="#{bterp:lookupItemList('e_inv_status')}"
												var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
											
										</h:selectOneMenu>
									</p:column>
									<p:column></p:column>
								</p:row>
								<!-- <p:row>
									<p:column styleClass="nowrap">
										<h:outputText value="Payment Status" />
									</p:column>
									<p:column style="width:10px;">
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column>
										<h:selectOneMenu label="Payment Status" value="#{salesBean.pmntStatus}">
											<f:selectItem itemLabel="All" itemValue="" />
											<f:selectItem itemLabel="Payment required" itemValue="RQ" />
											<f:selectItem itemLabel="Refund and cancelled" itemValue="RFCC" />
											<f:selectItem itemLabel="Payment failed" itemValue="F" />
