								</p:row>
							</p:panelGrid>
							<p:dataTable id="idPaxStmtConvertListTable" widgetVar="varPaxStmtConvertListTable"
								value="#{salesBean.lazyConvertedPaxStmtDataModel}" var="vo" paginator="true"
								rows="20" rowIndexVar="rowIndex"
								paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
								rowsPerPageTemplate="20, 30, 50, 100, 300, 500"
								filteredValue="#{salesBean.filteredObjList}" lazy="true"
								filterEvent="enter" rowKey="#{vo.id}">
								
								<!-- <p:ajax event="rowSelectCheckbox" listener="#{salesBean.onSelect}"/>
								<p:ajax event="rowUnselectCheckbox" listener="#{salesBean.onUnselect}"/>
								<p:ajax event="toggleSelect" listener="#{salesBean.onToggle}" oncomplete="teste()"/>
								<p:ajax event="page" listener="#{salesBean.onPagination}" />
								<p:column selectionMode="multiple" style="width:16px;text-align:center" rendered="#{salesBean.docTypeCd == 'P'}"/>
								 -->	
								<p:column headerText="View" width="40" style="text-align:center;"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(1)}" exportable="false">
									<p:commandButton icon="ui-icon-search"
										actionListener="#{salesBean.onInvoiceSelected(vo)}"
										oncomplete="varAddInvoiceDialog.show()"
										update=":idAddInvoiceDialog" process="@this" />
