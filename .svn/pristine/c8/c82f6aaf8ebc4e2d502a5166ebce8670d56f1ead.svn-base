									<h:outputText value="#{vo.custCd}" />
								</p:column>
		
								<p:column headerText="Customer Name" sortBy="#{vo.custName}"
									filterBy="#{vo.custName}" filterMatchMode="contains"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(8)}">
									<h:outputText
										value="#{bterp:lookupItemDesc('salutatn', vo.custSalutation)} #{vo.custName}"
										style="text-transform:uppercase;" />
