<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui"
	xmlns:pe="http://primefaces.org/ui/extensions"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	template="/WEB-INF/views/layouts/main.xhtml"
	xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

	<ui:define name="content">

		<style>
			.invoiceRefDialog {
				height: 100% !important;
				overflow: auto;
			}
			.badge-transferred {
    			background-color: #ffa500; /* Orange color similar to the screenshot */
			}
			.badge-payment-req {
    			background-color: red; 
			}
			.badge-payment-fail {
				background-color: grey;
			}
			.badge-cancelled {
				background-color: grey;
			}
			.badge-doc-type-status {
				background-color: purple;
			}
			.badge-trvl-ins {
				background-color: #a9cced;
			}
			.badge-payment-fail,
			.badge-payment-req,
			.badge-transferred,
			.badge-cancelled,
			.badge-trvl-ins,
			.badge-doc-type-status {
				color: white;
			    padding: 1px 4px; /* Adjusted padding to make the badge smaller */
			    margin-left: 5px;
			    border-radius: 50%;
			    font-size: 0.75em; /* Adjusted font size to make the badge text smaller */
			    font-weight: bold;
			}
			#idAddInvoicePaxDialog.ui-dialog .ui-dialog-content {
				overflow: visible !important;
			}
			.hidden-column {
			    display: none;
			}
		</style>

		<script type="text/javascript">
		    function fncLoad() {
		    	if (document.getElementById('idInvListForm:idAddBtn') != null) {
		    		document.getElementById('idInvListForm:idAddBtn').onclick();
		    	} else if (document.getElementById('idInvListForm:idTabView:idAddBtn') != null) {
		    		document.getElementById('idInvListForm:idTabView:idAddBtn').onclick();
		    	}
		        
		    }
		    
		    function onValidationReason(xhr, status, args) {
				if (args.validationFailed) {
					varReasonDialog.show();
				} else {
					varReasonDialog.hide();
					//varAddInvoiceDialog.hide();
					//varInvoiceListTable.clearFilters();
				}
			}
		    
		    function onValidationUpdPmntReason(xhr, status, args) {
				if (args.validationFailed) {
					varUpdPmntReasonDialog.show();
				} else {
					varUpdPmntReasonDialog.hide();
					//varAddInvoiceDialog.hide();
					//varInvoiceListTable.clearFilters();
				}
			}
		    
		    function onValidationUpdInternalRemarkReason(xhr, status, args) {
				if (args.validationFailed) {
					varUpdInternalRemarkReasonDialog.show();
				} else {
					varUpdInternalRemarkReasonDialog.hide();
					//varAddInvoiceDialog.hide();
					//varInvoiceListTable.clearFilters();
				}
			}
		    
		    function onValidationUpdAccReason(xhr, status, args) {
				if (args.validationFailed) {
					varUpdAccReasonDialog.show();
				} else {
					varUpdAccReasonDialog.hide();
					//varAddInvoiceDialog.hide();
					//varInvoiceListTable.clearFilters();
				}
			}
		    
		    function onTransferValidation(xhr, status, args) {
				if (!args.validationFailed) {
					varAvailableTourDepListDialog.hide();
					varTransferConfirmationDialog.hide();
				}
			}
		    
		    function onCruiseTransferValidation(xhr, status, args) {
				if (!args.validationFailed) {
					varAvailableCruiseDepListDialog.hide();
					varCruiseTransferConfirmationDialog.hide();
				}
			}
		    
		    document.addEventListener('DOMContentLoaded', function() {
		        var filters = document.querySelectorAll('input.ui-column-filter');
		        filters.forEach(function(filter) {
		            filter.setAttribute('enterkeyhint', 'enter');
		        });
		    });
		    
			function teste(){
				
				console.log(varInvoiceListTable)
				// varInvoiceListTable.selectAllRows(); 
				
//					var checked = $(document).find(":checkbox")["0"].checked; ///Find checkbox header and verify if checkbox is checked
//					if(checked == true){
//						PF('varInvoiceListTable').selectAllRows(); // if true, selectAllRows from datatable
//					} else {
//						PF('varInvoiceListTable').unselectAllRows(); //
//					}		
			}
		</script>

		<p:panel header="#{salesBean.docTypeDesc} Issuance" toggleable="true" toggleSpeed="500">
			<h:body onload="#{salesBean.strOnLoad}">
				<link rel="stylesheet"
					href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
				<h:form id="idInvListForm">
				
					<p:growl id="msg" />
				
					<p:tabView id="idTabView" activeIndex="#{salesBean.activeListingTab}" dynamic="true">
					
						<p:ajax event="tabChange" listener="#{salesBean.onTabChange}"/>
					
						<p:tab title="#{salesBean.docTypeDesc} List">
							<p:panelGrid style="margin-top:5px; width: 1px;">
								<p:row>
									<p:column style="#{(salesBean.docTypeCd eq 'I' and not salesBean.invAdd) ? 'width: 1px;' : 'width: 50px;'}">
										<p:commandButton id="idAddBtn" value="Add"
											actionListener="#{salesBean.initAddInvoice}"
											oncomplete="varAddInvoiceDialog.show()" process="@this"
											update=":idAddInvoiceDialog" style="#{(salesBean.docTypeCd eq 'I'and not salesBean.invAdd) ? 'display: none;' : ''}">
		 									<pe:resetEditableValues for="idAddInvoiceForm" />
										</p:commandButton>
									</p:column>
									<p:column rendered="#{salesBean.docTypeCd eq 'P' or salesBean.invAdd}">
										<p:separator style="width:2px;height:20px" />
									</p:column>
									<p:column>
										<p:commandButton id="toggler" value="Columns" style="float:left"
											icon="ui-icon-calculator"
											actionListener="#{salesBean.handleChangeColumnsViewClick}"
											oncomplete="varListingTableViewDialog.show();" process="@this"
											update=":idListingTableViewDialog" />
									</p:column>
									<p:column>
										<p:separator style="width:2px;height:20px" />
									</p:column>
									<p:column rendered="#{salesBean.docTypeCd eq 'I'}" styleClass="nowrap">
										<p:commandButton value="#{salesBean.isEInvSubm ? 'Submit' : 'E-Invoice Submission'}" 
											actionListener="#{salesBean.submitMultipleEInvoice}"
											update=":idInvListForm:idTabView :idInvListForm:msg :idMultipleEInvSubmitRespDialog"
											oncomplete="if (#{salesBean.isEInvSubm}) varMultipleEInvSubmitRespDialog.show()"
											rendered="#{salesBean.invPmntAuthVO.eInvoice}">
										</p:commandButton>
										<p:commandButton id="idExitBtn" icon="ui-icon-close" rendered="#{salesBean.isEInvSubm}"
											actionListener="#{salesBean.setIsEInvSubm(not salesBean.isEInvSubm)}"
											update=":idInvListForm:idTabView">
										</p:commandButton>
									</p:column>
									<p:column rendered="#{salesBean.docTypeCd eq 'P'}" styleClass="nowrap">
										<p:commandButton id="idSendReviewBtn" value="Send To Review"
											actionListener="#{salesBean.onSendToReview}" 
											oncomplete="varSendReviewDialog.show()" process="@this"
											update=":idSendReviewDialog">
										</p:commandButton>
									</p:column>
									<p:column>
										<p:separator style="width:2px;height:20px" />
									</p:column>
									<p:column>
										<p:commandButton value="Search" actionListener="#{salesBean.loadDocumentList}" update=":idInvListForm:idTabView:idInvListTable" />
									</p:column>
									<p:column>
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column>
									 	<p:calendar id="idInvoiceDateFrL" label="Invoice Date From" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.fromDate}">
									 		<p:ajax event="dateSelect"/>
									 	</p:calendar>
										<p:watermark for="idInvoiceDateFrL" value="Invoice Date From" />
									</p:column>
									<p:column>
										<p:calendar id="idInvoiceDateToL" label="Invoice Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.toDate}">
									 		<p:ajax event="dateSelect"/>
									 	</p:calendar>
										<p:watermark for="idInvoiceDateToL" value="Invoice Date To" />
									</p:column>
									<p:column>
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column>
									 	<p:calendar id="idDepDateFrL" label="Departure Date From" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.depDateFrom}">
									 		<p:ajax event="dateSelect"/>
									 	</p:calendar>
										<p:watermark for="idDepDateFrL" value="Departure Date From" />
									</p:column>
									<p:column>
										<p:calendar id="idDepDateToL" label="Departure Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.depDateTo}">
									 		<p:ajax event="dateSelect"/>
									 	</p:calendar>
										<p:watermark for="idDepDateToL" value="Departure Date To" />
									</p:column>
									<p:column>
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column styleClass="nowrap">
										<h:outputText value="Order Source" />
									</p:column>
									<p:column>
										<h:selectOneMenu id="idSelOrderSource" label="Order Source"
											value="#{salesBean.orderSourceCode}" effect="fade">
											<f:selectItem itemLabel="All" itemValue="" />
											<f:selectItems value="#{bterp:lookupItemList('ordr_sorc')}"
												var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
											<p:ajax event="change"
												listener="#{salesBean.handleOrderSourceSelect}"
												oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idTabView:idInvListTable" />
										</h:selectOneMenu>
									</p:column>
									<p:column styleClass="nowrap">
										<h:outputText value="#{salesBean.docTypeDesc} Category" />
									</p:column>
									<p:column>
										<h:selectOneMenu id="idSelInvoiceCategory" label="#{salesBean.docTypeDesc} Category"
											value="#{salesBean.invoiceCategoryCode}" effect="fade">
											<f:selectItem itemLabel="All" itemValue="" />
											<f:selectItems value="#{bterp:lookupItemList('inv_cat')}"
												var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
											<p:ajax event="change"
												listener="#{salesBean.handleInvoiceCategorySelect}"
												oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idTabView:idInvListTable" />
										</h:selectOneMenu>
									</p:column>
									<!-- <p:column rendered="#{salesBean.docTypeCd == 'P' and false}">
										<p:commandButton id="idReportBtn" value="Report"
											rendered="#{salesBean.docTypeCd == 'P' and false}"
											oncomplete="varReportDialog.show()" process="@this"
											update=":idReportDialog">
										</p:commandButton>
									</p:column> -->
									<p:column styleClass="nowrap" rendered="#{salesBean.docTypeCd eq 'I'}">
										<h:outputText value="E-Invoice Status" />
									</p:column>
									<p:column rendered="#{salesBean.docTypeCd eq 'I'}">
										<h:selectOneMenu id="idEInvStatus" label="E-Invoice Status" value="#{salesBean.eInvoiceStatus}">
											<f:selectItem itemLabel="All" itemValue="" />
											<f:selectItems value="#{bterp:lookupItemList('e_inv_status')}"
												var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
											<p:ajax event="change"
												listener="#{salesBean.handleEInvStatusSelect}"
												oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idTabView:idInvListTable" />
										</h:selectOneMenu>
									</p:column>
									<p:column styleClass="nowrap">
										<h:outputText value="Payment Status" />
									</p:column>
									<p:column>
										<h:selectOneMenu id="idPmntStatus" label="Payment Status" value="#{salesBean.pmntStatus}">
											<f:selectItem itemLabel="All" itemValue="" />
											<f:selectItem itemLabel="Payment required" itemValue="RQ" />
											<f:selectItem itemLabel="Refund and cancelled" itemValue="RFCC" />
											<f:selectItem itemLabel="Payment failed" itemValue="F" />
											<p:ajax event="change"
												listener="#{salesBean.handlePmntStatusSelect}"
												oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idTabView:idInvListTable" />
										</h:selectOneMenu>
									</p:column>
									<p:column styleClass="nowrap">
										<h:outputText value="Insurance Issued" />
									</p:column>
									<p:column styleClass="nowrap">
									    <p:selectOneButton id="idInsIssued" value="#{salesBean.insIssued}">
									    	<f:selectItem itemLabel="All" itemValue="" noSelectionOption="true"/>
									        <f:selectItem itemLabel="Yes" itemValue="Y"/>
									        <f:selectItem itemLabel="No" itemValue="N"/>
									        <p:ajax event="change"
												listener="#{salesBean.handleInsIssuedSelect}"
												oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idTabView:idInvListTable" />
									    </p:selectOneButton>
									</p:column>
								</p:row>
							</p:panelGrid>
							<!-- <p:panelGrid id="idSearchPanel" style="display: none;">
								<p:row>
									<p:column style="width: 66px;">
										<p:outputLabel for="idValidFrom" value="Date From" />
									</p:column>
									<p:column style="width: 80px;">
										<p:calendar id="idValidFrom" size="12" navigator="true" showButtonPanel="true"
											pattern="dd-MMM-yyyy" value="#{salesBean.fromDate}">
										</p:calendar>
		
									</p:column>
									<p:column style="width: 52px;">
										<p:outputLabel value="Date To" for="idValidTo" />
									</p:column>
									<p:column style="width: 66px;">
										<p:calendar id="idValidTo" size="12" navigator="true" showButtonPanel="true"
											pattern="dd-MMM-yyyy" value="#{salesBean.toDate}">
										</p:calendar>
									</p:column>
									<p:column style="width: 10px;">
										<p:separator style="width:2px;height:20px" />
									</p:column>
									<p:column style="width: 94px;">
										<p:outputLabel value="#{salesBean.docTypeDesc} From"
											for="idInvoiceFrom" />
									</p:column>
									<p:column style="width: 180px;">
										<h:outputText value="#{salesBean.prefixValue}"/>&nbsp;
										<p:inputText id="idInvoiceFrom" maxlength="8" value="#{salesBean.invFrom}" />
										<pe:keyFilter for="idInvoiceFrom" mask="num" /> 
									</p:column>
									<p:column style="width: 70px;">
										<p:outputLabel value="#{salesBean.docTypeDesc} To"
											for="idInvoiceTo" />
									</p:column>
									<p:column style="width: 180px;">
										<h:outputText value="#{salesBean.prefixValue}"/>&nbsp;
										<p:inputText id="idInvoiceTo" maxlength="8" value="#{salesBean.invTo}" />
										<pe:keyFilter for="idInvoiceTo" mask="num" /> 
									</p:column>
									<p:column style="width: 10px;">
										<p:separator style="width:2px;height:20px" />
									</p:column>
									<p:column>
										<p:commandButton value="Search" actionListener="#{salesBean.handleFilterSource}" id="invSearch" oncomplete="varInvoiceListTable.clearFilters()" update="@form">
											</p:commandButton>
										<p:defaultCommand target="invSearch" scope="idSearchPanel" />
									</p:column>
								</p:row>
							</p:panelGrid> -->
		
							<p:dataTable id="idInvListTable" widgetVar="varInvoiceListTable"
								value="#{salesBean.lazyDataModel}" var="vo" paginator="true"
								rows="20" rowIndexVar="rowIndex"
								paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
								rowsPerPageTemplate="20, 30, 50, 100, 300, 500"
								filteredValue="#{salesBean.filteredObjList}" lazy="true"
								selection="#{salesBean.selectedInvoiceList}"
								filterEvent="enter" rowKey="#{vo.id}">
								
								<p:ajax event="rowSelectCheckbox" update="idInvListTable"/>
								<p:ajax event="rowUnselectCheckbox" update="idInvListTable"/>
								<p:ajax event="toggleSelect" update="idInvListTable"/>
								
								<!-- <p:ajax event="rowSelectCheckbox" listener="#{salesBean.onSelect}"/>
								<p:ajax event="rowUnselectCheckbox" listener="#{salesBean.onUnselect}"/>
								<p:ajax event="toggleSelect" listener="#{salesBean.onToggle}" oncomplete="teste()"/> -->
								<!-- <p:ajax event="page" listener="#{salesBean.onPagination}" /> -->
								
								<p:column selectionMode="multiple" style="width:16px;text-align:center" rendered="#{salesBean.docTypeCd == 'P'}" disabledSelection="#{vo.statusCd eq 'CC' or vo.statusCd eq 'VD' or vo.docTypeStatus ne 'OP'}" exportable="false"
									headerText="">
									<f:facet name="header">
								        <h:outputText value="" />
								    </f:facet>
								</p:column>
								<p:column selectionMode="multiple" style="width:16px;text-align:center" rendered="#{salesBean.docTypeCd == 'I' and salesBean.isEInvSubm}" exportable="false" 
									headerText="">
									<f:facet name="header">
								        <h:outputText value="" />
								    </f:facet>
								</p:column>
									
								<p:column headerText="Edit" width="40" style="text-align:center;"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(1)}" exportable="false">
									<p:commandButton icon="ui-icon-pencil"
										actionListener="#{salesBean.onInvoiceSelected(vo)}"
										oncomplete="varAddInvoiceDialog.show()"
										update=":idAddInvoiceDialog" process="@this" 
										rendered="#{salesBean.docTypeCd ne 'P' or vo.statusCd ne 'CC' and vo.statusCd ne 'VD'}" />
								</p:column>
		
								<p:column headerText="Cancel" width="40"
									style="text-align:center;"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(2)}" exportable="false">
									<p:commandButton icon="ui-icon-close"
										actionListener="#{salesBean.onInvoiceSelected(vo)}"
										oncomplete="varDelInvDialog.show()"
										rendered="#{vo.docTypeCd eq 'I' and ((vo.statusCd eq 'IN' and salesBean.invPmntAuthVO.invVoidInvoiced) or ((vo.statusCd eq 'DP' or vo.statusCd eq 'FP') and salesBean.invPmntAuthVO.invCancelFPorDP))}" process="@this" />
									<p:commandButton icon="ui-icon-close"
										actionListener="#{salesBean.onInvoiceSelected(vo)}"
										oncomplete="varDelInvDialog.show()"
										rendered="#{
											vo.docTypeCd eq 'P' and 
											(
												(vo.statusCd eq 'IN' and salesBean.invPmntAuthVO.invVoidInvoiced) or 
												((vo.statusCd eq 'DP' or vo.statusCd eq 'FP') and salesBean.invPmntAuthVO.invCancelFPorDP)
											) and 
											vo.docTypeStatus eq 'OP'
										}" process="@this" />
								</p:column>
		
								<p:column id="invoiceNo" width="128" headerText="#{salesBean.docTypeDesc} No." sortBy="#{vo.code}"
									filterBy="#{vo.code}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(3)}" exportable="false">
		        					<h:outputText value="#{salesBean.prefixValue} #{salesBean.docTypeCd == 'P' ? vo.psNo : vo.code}" rendered="#{salesBean.docTypeCd ne 'P' or vo.statusCd ne 'CC' and vo.statusCd ne 'VD'}" />
									<p:commandLink
										style="color: #db3333; text-decoration: underline;"
										actionListener="#{salesBean.showDocument(vo,'P')}"
										oncomplete="varAddInvoiceDialog.show()"
										update=":idAddInvoiceDialog" process="@this"
										rendered="#{salesBean.docTypeCd eq 'P' and (vo.statusCd eq 'CC' or vo.statusCd eq 'VD')}">
										<h:outputText
											value="#{salesBean.prefixValue} #{salesBean.docTypeCd == 'P' ? vo.psNo : vo.code}" />
									</p:commandLink>
									<h:outputText id="idPaymentReq" value="$" styleClass="badge-payment-req" rendered="#{vo.amtPaid == 0 and (vo.statusCd ne 'VD' and vo.statusCd ne 'CC') and not vo.hasRefund}" />
		        					<h:outputText id="idPaymentFail" value="$" styleClass="badge-payment-fail" rendered="#{vo.amtPaid == 0 and vo.statusCd eq 'VD'}" />
		            				<h:outputText id="idTransferred" value="T" styleClass="badge-transferred" rendered="#{not empty vo.transferredDate}" />
		            				<h:outputText id="idCancelled" value="C" styleClass="badge-cancelled" rendered="#{vo.hasRefund}"/>
		            				<h:outputText id="idTrvlIns" value="I" styleClass="badge-trvl-ins" rendered="#{vo.showTrvlInsBadge}"/>
		            				<h:outputText id="idDocTypeStatusRV" value="RV" styleClass="badge-doc-type-status" rendered="#{vo.docTypeCd eq 'P' and vo.docTypeStatus eq 'RW'}"/>
		            				<h:outputText id="idDocTypeStatusCV" value="CV" styleClass="badge-doc-type-status" rendered="#{vo.docTypeCd eq 'P' and vo.docTypeStatus eq 'CV'}"/>
		            				<h:outputText id="idDocTypeStatusST" value="ST" styleClass="badge-doc-type-status" rendered="#{vo.docTypeCd eq 'P' and vo.docTypeStatus eq 'SP'}"/>
		            				
		            				<pe:tooltip for="idPaymentReq" shared="true" showDelay="3000" position="top right"
										rendered="#{vo.amtPaid == 0 and vo.statusCd ne 'VD'}">
										<h:outputText value="Payment Required" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
									<pe:tooltip for="idPaymentFail" shared="true" showDelay="3000" position="top right"
										rendered="#{vo.amtPaid == 0 and vo.statusCd eq 'VD'}">
										<h:outputText value="Payment Failed" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
									<pe:tooltip for="idTransferred" shared="true" showDelay="3000" position="top right"
										rendered="#{not empty vo.transferredDate}">
										<h:outputText value="Transferred" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
									<pe:tooltip for="idCancelled" shared="true" showDelay="3000" position="top right"
										rendered="#{vo.hasRefund}">
										<h:outputText value="Refund and cancelled" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
									<pe:tooltip for="idTrvlIns" shared="true" showDelay="3000" position="top right"
										rendered="#{vo.showTrvlInsBadge}">
										<h:outputText value="Sgl Ins Issued" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
									<pe:tooltip for="idDocTypeStatusRV" shared="true" showDelay="3000" position="top right"><h:outputText value="In-Review" escape="true" style="white-space: pre-wrap"/></pe:tooltip>
									<pe:tooltip for="idDocTypeStatusCV" shared="true" showDelay="3000" position="top right"><h:outputText value="Converted" escape="true" style="white-space: pre-wrap"/></pe:tooltip>
									<pe:tooltip for="idDocTypeStatusST" shared="true" showDelay="3000" position="top right"><h:outputText value="Split" escape="true" style="white-space: pre-wrap"/></pe:tooltip>
								</p:column>
								
								<p:column styleClass="hidden-column">
									<f:facet name="header">
									    <h:outputText value="#{salesBean.docTypeDesc} No." />  
									</f:facet>
									<h:outputText value="#{salesBean.prefixValue} #{salesBean.docTypeCd == 'P' ? vo.psNo : vo.code}" rendered="#{salesBean.docTypeCd ne 'P' or vo.statusCd ne 'CC' and vo.statusCd ne 'VD'}" />
								</p:column>
								
								<p:column id="paxStmtNo" width="128" headerText="Pax Stmt. No." sortBy="#{vo.psNo}"
									filterBy="#{vo.psNo}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(4) and salesBean.docTypeCd == 'I'}">
		        					<!-- <h:outputText value="#{salesBean.prefixValue} #{vo.psNo}" /> -->
		        					<f:facet name="header">
									    <h:outputText value="Pax Stmt. No." />  
									</f:facet>
		        					<!-- <p:commandLink 
		        						id="idPsNo" 
		        						style="color: #db3333; text-decoration: underline;" 
		        						rendered="#{vo.psNo ne null}" 
		        						actionListener="#{salesBean.showDocument(vo,'P')}"
		        						oncomplete="varAddInvoiceDialog.show()"
										update=":idAddInvoiceDialog" 
										process="@this">
										<h:outputText value="#{salesBean.psPrefixVal} #{vo.psNo}"/>
									</p:commandLink> -->
									<p:commandLink 
										id="idPsNo" 
										rendered="#{vo.psNo ne null and vo.psNo ne ''}"
										actionListener="#{salesInvBean.handleInvRefNoClick(vo.psNo, 'P')}" style="color:#0040FF;"
										update=":idSmallAddInvoiceRefDialog" oncomplete="varSmallAddInvoiceRefDialog.show()" >
										<h:outputText value="#{salesBean.psPrefixVal} #{vo.psNo}"/>									
									</p:commandLink>
									<pe:tooltip for="idPsNo" shared="true" showDelay="3000"  position="top right">
										<h:outputText value="#{salesBean.psPrefixVal} #{vo.psNo}" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
								</p:column>
								
								<p:column id="parentPaxStmtNo" width="128" headerText="Parent No." sortBy="#{vo.parentPsNo}"
									filterBy="#{vo.parentPsNo}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(5) and salesBean.docTypeCd == 'P'}">
									<f:facet name="header">
									    <h:outputText value="Parent No." />  
									</f:facet>
		        					<!-- <h:outputText value="#{salesBean.prefixValue} #{vo.psNo}" /> -->
		        					<p:commandLink 
		        						id="idParentPaxStmtNo" 
		        						style="color: #db3333; text-decoration: underline;" 
		        						rendered="#{vo.parentPsNo ne null}" 
		        						actionListener="#{salesBean.showDocument(vo.parentPsNo,'P')}"
		        						oncomplete="varAddInvoiceDialog.show()"
										update=":idAddInvoiceDialog" 
										process="@this">
										<h:outputText value="#{salesBean.psPrefixVal} #{vo.parentPsNo}"/>
									</p:commandLink>
									<pe:tooltip for="idPsNo" shared="true" showDelay="3000"  position="top right">
										<h:outputText value="#{salesBean.psPrefixVal} #{vo.parentPsNo}" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
								</p:column>
		
								<p:column headerText="#{salesBean.docTypeDesc} Date" sortBy="#{vo.invoiceDt}"
									filterBy="#{vo.invoiceDt}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(6)}">
									<f:facet name="header">
									    <h:outputText value="#{salesBean.docTypeDesc} Date" />  
									</f:facet>
									<h:outputText value="#{vo.invoiceDt}">
										<f:convertDateTime pattern="dd-MMM-yyyy" />
									</h:outputText>
								</p:column>
		
								<p:column headerText="Departure Date" sortBy="#{vo.departureDt}"
									filterBy="#{vo.departureDt}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(7)}">
									<f:facet name="header">
									    <h:outputText value="Departure Date" />  
									</f:facet>
									<h:outputText value="#{vo.departureDt}">
										<f:convertDateTime pattern="dd-MMM-yyyy" />
									</h:outputText>
								</p:column>
		
								<p:column headerText="Sales Person" sortBy="#{vo.salerName}"
									filterBy="#{vo.salerName}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(8)}">
									<f:facet name="header">
									    <h:outputText value="Sales person" />  
									</f:facet>
									<h:outputText value="#{vo.salerName}" />
								</p:column>
								<p:column headerText="Customer No." sortBy="#{vo.custCd}"
									filterBy="#{vo.custCd}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(9)}">
									<f:facet name="header">
									    <h:outputText value="Customer No." />  
									</f:facet>
									<h:outputText value="#{vo.custCd}" />
								</p:column>
		
								<p:column headerText="Customer Name" sortBy="#{vo.custName}"
									filterBy="#{vo.custName}" filterMatchMode="contains"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(10)}">
									<f:facet name="header">
									    <h:outputText value="Customer Name" />  
									</f:facet>
									<h:outputText
										value="#{bterp:lookupItemDesc('salutatn', vo.custSalutation)} #{vo.custName}"
										style="text-transform:uppercase;" />
								</p:column>
		
								<p:column headerText="Company Name" sortBy="#{vo.coName}"
									filterBy="#{vo.coName}" filterMatchMode="contains"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(11)}">
									<f:facet name="header">
									    <h:outputText value="Company Name" />  
									</f:facet>
									<h:outputText value="#{vo.coName}" />
								</p:column>
		
								<p:column headerText="Tour Code" sortBy="#{vo.tourCd}"
									filterBy="#{vo.tourCd}" filterMatchMode="contains"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(12)}">
									<f:facet name="header">
									    <h:outputText value="Tour code" />  
									</f:facet>
									<h:outputText value="#{vo.tourCd}" />
								</p:column>
		
								<p:column headerText="Booking No" sortBy="#{vo.bookingId}"
									filterBy="#{vo.bookingId}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(13)}">
									<f:facet name="header">
									    <h:outputText value="Booking No" />  
									</f:facet>
									<h:outputText value="#{vo.bookingId}" />
								</p:column>
		
								<p:column headerText="Order Source" sortBy="#{vo.orderCd}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(14)}">
									<f:facet name="header">
									    <h:outputText value="Order Source" />  
									</f:facet>
									<h:outputText value="#{bterp:lookupItemDesc('ordr_sorc', vo.orderCd)}" />
								</p:column>
								
								<p:column headerText="#{salesBean.docTypeDesc} Category" sortBy="#{vo.catCd}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(15)}">
									<f:facet name="header">
									    <h:outputText value="#{salesBean.docTypeDesc} Category" />  
									</f:facet>
									<h:outputText value="#{bterp:lookupItemDesc('inv_cat', vo.catCd)}" />
								</p:column>
		
								<!-- <p:column headerText="Ticket No(s)" sortBy="#{vo.tickets}"
									filterBy="#{vo.tickets}" width="200"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(14)}">
									<h:outputText value="#{vo.tickets}" />
								</p:column> -->
								
								<p:column headerText="Reference No(s)" sortBy="#{vo.referenceNoList}"
									filterBy="#{vo.referenceNoList}" width="200"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(16)}">
									<f:facet name="header">
									    <h:outputText value="Reference No(s)" />  
									</f:facet>
									<h:outputText id="idReferenceNo" value="#{vo.referenceNoListPrev}" escape="false"/>
									<pe:tooltip for="idReferenceNo" shared="true" showDelay="3000"  position="top right"
										rendered="#{vo.referenceNoListPrev.contains('......')}">
										<h:outputText value="#{vo.referenceNoList}" escape="false" style="white-space: pre-wrap"/>
									</pe:tooltip>
								</p:column>
		
								<p:column headerText="Total Amt" sortBy="#{vo.amount}"
									filterBy="#{vo.amount}" styleClass="txt_center"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(17)}">
									<f:facet name="header">
									    <h:outputText value="Total Amt" />  
									</f:facet>
									<h:outputText value="#{vo.amount}">
										<f:convertNumber pattern="#,##0.00" />
									</h:outputText>
								</p:column>
		
								<p:column headerText="Amt Due" sortBy="#{vo.balance}"
									filterBy="#{vo.balance}" styleClass="txt_center"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(18)}">
									<f:facet name="header">
									    <h:outputText value="Amt Due" />  
									</f:facet>
									<!-- 'Joon Hang - hide payment status for split statement' -->
									<h:outputText value="N/A" rendered="#{vo.docTypeStatus eq 'SP'}"/>
									<h:outputText value="#{vo.balance}" rendered="#{vo.docTypeStatus ne 'SP'}">
										<f:convertNumber pattern="#,##0.00" />
									</h:outputText>
								</p:column>
								
								<p:column headerText="#{salesBean.docTypeDesc} Due" sortBy="#{vo.invoiceDue}"
									filterBy="#{vo.invoiceDue}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(19)}">
									<f:facet name="header">
									    <h:outputText value="#{salesBean.docTypeDesc} Due" />  
									</f:facet>
									<h:outputText value="#{vo.invoiceDue}">
										<f:convertDateTime pattern="dd-MMM-yyyy" />
									</h:outputText>
								</p:column>
								
								<p:column headerText="Pax Statement Status" sortBy="#{vo.docTypeStatus}"
									style="width: 80px;" styleClass="txt_center"
									filterBy="#{vo.docTypeStatus}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(20) and salesBean.docTypeCd == 'P'}">
									<f:facet name="header">
									    <h:outputText value="Pax Statement Status" />  
									</f:facet>
									<h:outputText
										value="#{zsg:referenceDataValue('PS_STATUS', vo.docTypeStatus)}" />
<!-- 									<h:outputText
										value="#{vo.docTypeStatus}" /> -->
								</p:column>
								
								<!-- 'Joon Hang - hide payment status for split statement' -->
								<p:column headerText="Payment Status" sortBy="#{vo.statusCd}"
									style="width: 80px;" styleClass="txt_center"
									filterBy="#{vo.statusCd}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(21)}">
									<f:facet name="header">
									    <h:outputText value="Payment Status" />  
									</f:facet>
									<h:outputText 
										value="N/A" rendered="#{vo.docTypeStatus eq 'SP'}"/>
									<h:outputText
										value="#{zsg:referenceDataValue('INV_STATUS', vo.statusCd)}" rendered="#{vo.docTypeStatus ne 'SP'}"/>
								</p:column>
		
								<p:column headerText="Booking Status"
									sortBy="#{vo.bookingStatusCd}" style="width: 80px;"
									styleClass="txt_center" filterBy="#{vo.bookingStatusCd}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(22)}">
									<f:facet name="header">
									    <h:outputText value="Booking Status" />  
									</f:facet>
									<h:outputText
										value="#{zsg:referenceDataValue('BOOK_STATUS', vo.bookingStatusCd)}" />
								</p:column>
								
								<p:column headerText="E-Invoice Submission Status"
									sortBy="#{vo.eInvoiceStatus}" style="width: 80px;"
									styleClass="txt_center" filterBy="#{vo.eInvoiceStatus}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(23) and salesBean.docTypeCd == 'I'}">
									<f:facet name="header">
									    <h:outputText value="E-Invoice Submission Status" />  
									</f:facet>
									<h:outputText value="#{vo.eInvoiceStatus}" />
									<p:graphicImage id="idInfo" rendered="#{vo.eInvoiceStatus eq 'Invalid' or vo.eInvoiceStatus eq 'Cancelled'}" value="/img/more.png"/>
									<pe:tooltip for="idInfo">
										<h:outputText value="#{vo.eInvoiceErr}" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
								</p:column>
		
								<p:column headerText="Internal Remarks" style="width: 80px;"
									styleClass="txt_center" filterBy="#{vo.internalRemarks}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(24)}" exportable="false">
									<f:facet name="header">
									    <h:outputText value="Internal Remarks" />  
									</f:facet>
									<p:outputLabel id="idInternalRemarks" value="View"
										rendered="#{vo.internalRemarks ne null and vo.internalRemarks ne ''}">
										<i class="fa fa-info-circle" aria-hidden="true" />
									</p:outputLabel>
		
									<!-- <p:tooltip id="idToolTipInternalRemarks" for="idInternalRemarks"
										showEffect="fade" hideEffect="fade" position="bottom"
										style="width:600px;">
										<h:outputText escape="true" value="#{vo.internalRemarks}"
											style="white-space: pre-wrap" />
									</p:tooltip> -->
									<pe:tooltip for="idInternalRemarks" shared="true" showDelay="300" targetPosition="top left" position="bottom right"
										rendered="#{not empty vo.internalRemarks}">
										<h:outputText value="#{vo.internalRemarks}" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
								</p:column>
		
								<p:column headerText="Updated By" sortBy="#{vo.updatedBy}"
									style="width: 80px;" styleClass="txt_center"
									filterBy="#{vo.updatedBy}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(25)}">
									<f:facet name="header">
									    <h:outputText value="Updated By" />  
									</f:facet>
									<h:outputText value="#{vo.updatedBy}" />
								</p:column>
		
								<p:column headerText="Updated Date" sortBy="#{vo.updatedDate}"
									filterBy="#{vo.updatedDate}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(26)}">
									<f:facet name="header">
									    <h:outputText value="Updated Date" />  
									</f:facet>
									<h:outputText value="#{vo.updatedDate}">
										<f:convertDateTime pattern="dd-MMM-yyyy HH:mm:ss" />
									</h:outputText>
								</p:column>
							</p:dataTable>
				
							<br/>
							<h:commandLink rendered="#{salesBean.docTypeCd eq 'P'}">
					            <p:graphicImage value="/img/excel.png" />
					            <p:dataExporter type="csv" target="idInvListTable" fileName="#{salesBean.generateReportFileName('Pax_Statement_List')}"/>
					        </h:commandLink>
						</p:tab>
						<p:tab title="In-Review Statements" rendered="#{salesBean.docTypeCd == 'P'}">
							<p:panelGrid style="margin-top:5px; width: 1px;">
								<p:row>
									<p:column style="width:200px;">
										<h:outputLabel>Invoice Date</h:outputLabel>
									</p:column>
									<p:column style="width:10px;">
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column style="width:80px;">
									 	<p:calendar id="idInvoiceDateFr1" label="Invoice Date From" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.fromDate}"/>
										<p:watermark for="idInvoiceDateFr1" value="Invoice Date From" />
									</p:column>
									<p:column style="width:80px;">
										<p:calendar id="idInvoiceDateTo1" label="Invoice Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.toDate}"/>
										<p:watermark for="idInvoiceDateTo1" value="Invoice Date To" />
									</p:column>
								</p:row>
								<p:row>
									<p:column style="width:200px;">
										<h:outputLabel>Departure Date</h:outputLabel>
									</p:column>
									<p:column style="width:10px;">
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column style="width:80px;">
									 	<p:calendar id="idDepDateFr1" label="Departure Date From" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.depDateFrom}"/>
										<p:watermark for="idDepDateFr1" value="Departure Date From" />
									</p:column>
									<p:column style="width:80px;">
										<p:calendar id="idDepDateTo1" label="Departure Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.depDateTo}"/>
										<p:watermark for="idDepDateTo1" value="Departure Date To" />
									</p:column>
								</p:row>
								<p:row>
									<p:column styleClass="nowrap">
										<h:outputText value="Order Source" />
									</p:column>
									<p:column style="width:10px;">
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column>
										<h:selectOneMenu id="idSelOrderSourceRW" label="Order Source"
											value="#{salesBean.orderSourceCode}" effect="fade">
											<f:selectItem itemLabel="All" itemValue="" />
											<f:selectItems value="#{bterp:lookupItemList('ordr_sorc')}"
												var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
											
										</h:selectOneMenu>
									</p:column>
									<p:column></p:column>
								</p:row>
								<p:row>
									<p:column styleClass="nowrap">
										<h:outputText value="#{salesBean.docTypeDesc} Category" />
									</p:column>
									<p:column style="width:10px;">
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column>
										<h:selectOneMenu id="idSelInvoiceCategoryRW" label="#{salesBean.docTypeDesc} Category"
											value="#{salesBean.invoiceCategoryCode}" effect="fade">
											<f:selectItem itemLabel="All" itemValue="" />
											<f:selectItems value="#{bterp:lookupItemList('inv_cat')}"
												var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
											
										</h:selectOneMenu>
									</p:column>
									<p:column></p:column>
								</p:row>
								<p:row>
									<p:column styleClass="nowrap">
										<h:outputText value="Payment Status" />
									</p:column>
									<p:column style="width:10px;">
										<p:separator style="width:2px;height:20px"/>
									</p:column>
									<p:column>
										<h:selectOneMenu id="idPmntStatusRW" label="Payment Status" value="#{salesBean.pmntStatus}">
											<f:selectItem itemLabel="All" itemValue="" />
											<f:selectItem itemLabel="Payment required" itemValue="RQ" />
											<f:selectItem itemLabel="Refund and cancelled" itemValue="RFCC" />
											<f:selectItem itemLabel="Payment failed" itemValue="F" />
											<!-- <p:ajax event="change"
												listener="#{salesBean.handlePmntStatusSelect}"
												oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idTabView:idInvListTable" /> -->
										</h:selectOneMenu>
									</p:column>
								</p:row>
								
								<p:row>
									<p:column>
										<p:commandButton value="Search" actionListener="#{salesBean.loadInReviewPaxStmtList}" update=":idInvListForm:idTabView:idPaxStmtReviewListTable" />
									</p:column>
									<p:column>
									</p:column>
								</p:row>
								<p:row>
									<p:column>
										<p:commandButton id="idConvertBtn" value="Convert To Invoice"
											actionListener="#{salesBean.onConvertToInvoice}"
												oncomplete="varConvertToInvoiceDialog.show()" process="@this"
												style="white-space: nowrap;"
												update=":idConvertToInvoiceDialog"
												rendered="#{salesBean.invPmntAuthVO.inReviewStmt}">
										</p:commandButton>
									</p:column>
									<p:column>
										<p:commandButton id="idRevertBtn" value="Revert"
											actionListener="#{salesBean.onRevertPaxStatement}"
												oncomplete="varRevertPaxStmtDialog.show()" process="@this"
												update=":idRevertPaxStmtDialog"
												rendered="#{salesBean.invPmntAuthVO.inReviewStmt}">
										</p:commandButton>
									</p:column>
								</p:row>
							</p:panelGrid>
							
							<p:dataTable id="idPaxStmtReviewListTable" widgetVar="varPaxStmtReviewListTable"
								value="#{salesBean.lazyReviewingPaxStmtDataModel}" var="vo" paginator="true"
								rows="20" rowIndexVar="rowIndex"
								paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
								rowsPerPageTemplate="20, 30, 50, 100, 300, 500"
								filteredValue="#{salesBean.filteredObjList}" lazy="true"
								selection="#{salesBean.selectedInReviewInvList}"
								filterEvent="enter" rowKey="#{vo.id}">
								
								<p:ajax event="rowSelectCheckbox" update="idPaxStmtReviewListTable"/>
								<p:ajax event="rowUnselectCheckbox" update="idPaxStmtReviewListTable"/>
								<p:ajax event="toggleSelect" update="idPaxStmtReviewListTable"/>
								
								<p:column selectionMode="multiple" style="width:16px;text-align:center" exportable="false"/>
								
								<p:column headerText="View" width="40" style="text-align:center;"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(1)}" exportable="false">
									<p:commandButton icon="ui-icon-search"
										actionListener="#{salesBean.onInvoiceSelected(vo)}"
										oncomplete="varAddInvoiceDialog.show()"
										update=":idAddInvoiceDialog" process="@this" />
								</p:column>
		
								<p:column headerText="Cancel" width="40"
									style="text-align:center;"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(2) and false}" exportable="false">
									<p:commandButton icon="ui-icon-close"
										actionListener="#{salesBean.onInvoiceSelected(vo)}"
										oncomplete="varDelInvDialog.show()"
										rendered="#{(vo.statusCd eq 'IN' and salesBean.invPmntAuthVO.invVoidInvoiced) or ((vo.statusCd eq 'DP' or vo.statusCd eq 'FP') and salesBean.invPmntAuthVO.invCancelFPorDP)}" process="@this" />
								</p:column>
		
								<p:column id="invoiceNo" width="128" headerText="Pax Statement No." sortBy="#{vo.psNo}"
									filterBy="#{vo.psNo}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(3)}" exportable="false">
		        					<h:outputText value="#{salesBean.prefixValue} #{vo.psNo}" />
		            				<h:outputText id="idPaymentReq" value="$" styleClass="badge-payment-req" rendered="#{vo.amtPaid == 0 and (vo.statusCd ne 'VD' and vo.statusCd ne 'CC') and not vo.hasRefund}" />
		        					<h:outputText id="idPaymentFail" value="$" styleClass="badge-payment-fail" rendered="#{vo.amtPaid == 0 and vo.statusCd eq 'VD'}" />
		            				<h:outputText id="idTransferred" value="T" styleClass="badge-transferred" rendered="#{not empty vo.transferredDate}" />
		            				<h:outputText id="idCancelled" value="C" styleClass="badge-cancelled" rendered="#{vo.hasRefund}"/>
		            				<h:outputText id="idTrvlIns" value="I" styleClass="badge-trvl-ins" rendered="#{vo.showTrvlInsBadge}"/>
		            				<h:outputText id="idDocTypeStatusRV" value="RV" styleClass="badge-doc-type-status" rendered="#{vo.docTypeCd eq 'P' and vo.docTypeStatus eq 'RW'}"/>
		            				<h:outputText id="idDocTypeStatusCV" value="CV" styleClass="badge-doc-type-status" rendered="#{vo.docTypeCd eq 'P' and vo.docTypeStatus eq 'CV'}"/>
		            				<h:outputText id="idDocTypeStatusST" value="ST" styleClass="badge-doc-type-status" rendered="#{vo.docTypeCd eq 'P' and vo.docTypeStatus eq 'SP'}"/>
		            				
		            				<pe:tooltip for="idPaymentReq" shared="true" showDelay="3000" position="top right"
										rendered="#{vo.amtPaid == 0 and vo.statusCd ne 'VD'}">
										<h:outputText value="Payment Required" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
									<pe:tooltip for="idPaymentFail" shared="true" showDelay="3000" position="top right"
										rendered="#{vo.amtPaid == 0 and vo.statusCd eq 'VD'}">
										<h:outputText value="Payment Failed" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
									<pe:tooltip for="idTransferred" shared="true" showDelay="3000" position="top right"
										rendered="#{not empty vo.transferredDate}">
										<h:outputText value="Transferred" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
									<pe:tooltip for="idCancelled" shared="true" showDelay="3000" position="top right"
										rendered="#{vo.hasRefund}">
										<h:outputText value="Refund and cancelled" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
									<pe:tooltip for="idTrvlIns" shared="true" showDelay="3000" position="top right"
										rendered="#{vo.showTrvlInsBadge}">
										<h:outputText value="Sgl Ins Issued" escape="true" style="white-space: pre-wrap"/>
									</pe:tooltip>
									<pe:tooltip for="idDocTypeStatusRV" shared="true" showDelay="3000" position="top right"><h:outputText value="In-Review" escape="true" style="white-space: pre-wrap"/></pe:tooltip>
									<pe:tooltip for="idDocTypeStatusCV" shared="true" showDelay="3000" position="top right"><h:outputText value="Converted" escape="true" style="white-space: pre-wrap"/></pe:tooltip>
									<pe:tooltip for="idDocTypeStatusST" shared="true" showDelay="3000" position="top right"><h:outputText value="Split" escape="true" style="white-space: pre-wrap"/></pe:tooltip>
								</p:column>
								
								<p:column styleClass="hidden-column">
									<f:facet name="header">
									    <h:outputText value="Pax Statement No." />  
									</f:facet>
		        					<h:outputText value="#{salesBean.prefixValue} #{vo.psNo}" />
								</p:column>
								
								<p:column headerText="Statement Date" sortBy="#{vo.invoiceDt}"
									filterBy="#{vo.invoiceDt}"
									rendered="#{salesBean.listingTableViewVO.verifyVisibility(4)}">
