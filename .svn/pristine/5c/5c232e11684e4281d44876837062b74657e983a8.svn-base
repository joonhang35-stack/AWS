							append("and ifnull(t.tourCode, 'ATK - ') like 'ATK - %') ").
							append("or ").
							append("(date(t.departureDt)>=date(date_add(LAST_DAY(date_add(:toDate, interval -5 MONTH)), interval 1 DAY)) ").
							append("and date(t.departureDt)<=date(LAST_DAY(date_add(:toDate, interval -4 MONTH))) ").
							append("and ifnull(t.tourCode, '') not like 'ATK - %') ").
						append(") ").
						append("and (sum(t.balanceDue) >= 0) ").
					append(") then ").
						append("sum(t.balanceDue) ").
					append("else ").
						append("0.00 ").
				append("end) as days121150Amt, ").
				// 150 Days After
				append("(case ").
					append("when ( ").
						append("((date(t.billDt)<=date(LAST_DAY(date_add(:toDate, interval -5 MONTH))) ").
							append("and ifnull(t.tourCode, 'ATK - ') like 'ATK - %') ").
							append("or ").
							append("(date(t.departureDt)<=date(LAST_DAY(date_add(:toDate, interval -5 MONTH))) ").
							append("and ifnull(t.tourCode, '') not like 'ATK - %') ").
						append(") ").
						append("and (sum(t.balanceDue) >= 0) ").
					append(") then ").
						append("sum(t.balanceDue) ").
					append("else ").
						append("0.00 ").
				append("end) as days150AftAmt, ").
				// Advance Paid
				append("(case ").
					append("when (sum(t.balanceDue) < 0) then ").
						append("sum(t.balanceDue)  ").
					append("else ").
						append("0.00 ").
				append("end) as advPaidAmt ").
			append("from ( ").
				append("select a.id, a.dt_bill as billDt, a.code, ifnull(a.amount, 0.0) as 'amount', ifnull(a.payment, 0.0) as 'payment', ").
					append("ifnull(a.amount, 0.0) - ifnull(a.payment, 0.0) as 'balanceDue', a.id_tour_dep,	a.trans_type as transType, ").
					append("d.code as tourCode, d.dt_dep as departureDt, s.id as supplierId, s.sys_no as eoCode, c.name as supplierName ").
				append("from ( ").
					append("select b.id, b.id_supplier, b.dt_bill, 'Bill' as trans_type, b.code, b.bill_amt as amount, null as payment, b.id_tour_dep ").
					append("from ex_order_bill b ").
					append("where b.id_company = :idCompany and b.status_cd not in (:statusCdCC, :statusCdVD) ").
						append("and date(b.dt_bill) <= date(:toDate) ");
						if (searchParamVO.getObj4() != null) sb.append("AND b.id_supplier = " + ((Long) searchParamVO.getObj4()) + " ");
					sb.append("union all ").
					append("select b.id, b.id_supplier, bp.dt_pmnt as 'dt_bill', 'Payment' as trans_type, b.code, null as amount, bp.pmnt_amount as payment, b.id_tour_dep ").
					append("from ex_order_bill b, ex_order_bill_pmnt bp ").
					append("where b.id = bp.id_eo_bill and bp.status_cd = :statusCd and b.id_company = :idCompany and b.status_cd not in (:statusCdCC, :statusCdVD) ").
						append("and date(bp.dt_pmnt) <= date(:toDate) ");
						if (searchParamVO.getObj4() != null) sb.append("AND b.id_supplier = " + ((Long) searchParamVO.getObj4()) + " ");
				sb.append(") a ").
					append("left join supplier s on s.id = a.id_supplier ").
					append("left join person p on p.id = s.id_person ").
					append("left join corporate c on c.id_person = p.id ").
					append("left join tour_dep d on d.id = a.id_tour_dep ");
				if (searchParamVO.getObj5() != null) sb.append("where s.type_cd = '" + ((String) searchParamVO.getObj5()) + "' ");
				sb.append("order by cast(s.sys_no as decimal), cast(a.code as decimal), field(a.trans_type,  'Bill', 'Payment') ").
			append(") t ").
			append("group by t.eoCode, t.code having curBal != 0 ").
			append("order by cast(t.eoCode as decimal), date(t.billDt), cast(t.eoCode as decimal), cast(t.code as decimal) ");
			
			SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
			query.addScalar("billDt", DateType.INSTANCE);
			query.addScalar("code");
			query.addScalar("billAmt", DoubleType.INSTANCE);
			query.addScalar("amtPaid", DoubleType.INSTANCE);
			query.addScalar("curBal", DoubleType.INSTANCE);
			query.addScalar("tourCode");
			query.addScalar("depDt", DateType.INSTANCE);
			query.addScalar("supplierId", LongType.INSTANCE);
			query.addScalar("eoCode");
			query.addScalar("supplierName");
			query.addScalar("currentAmt", DoubleType.INSTANCE);
			query.addScalar("days130Amt", DoubleType.INSTANCE);
			query.addScalar("days3160Amt", DoubleType.INSTANCE);
			query.addScalar("days6190Amt", DoubleType.INSTANCE);
			query.addScalar("days91120Amt", DoubleType.INSTANCE);
			query.addScalar("days121150Amt", DoubleType.INSTANCE);
			query.addScalar("days150AftAmt", DoubleType.INSTANCE);
			query.addScalar("advPaidAmt", DoubleType.INSTANCE);
			
			query.setParameter("idCompany", idCompany);
			query.setParameter("toDate", (Date) searchParamVO.getObj3());
			query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			query.setParameter("statusCdCC", CommonConstant.STATUS_CD_CANCELLED);
			query.setParameter("statusCdVD", CommonConstant.STATUS_CD_VOID);
			query.setResultTransformer(Transformers.aliasToBean(ExOrderBillVO.class));
			list = query.list();
			
		} catch (Exception e) {
			throw e;
		}
		return list;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acctreport.dao.AccountReportDAO#getPurchasesInAdvance(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<ExOrderBillVO> getPurchasesInAdvance(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		List<ExOrderBillVO> list = new ArrayList<ExOrderBillVO>();
		
		try {
			sb.append("SELECT ").
				append("t.code as acctCd, t.subCode as acctSubCd, t.desc as acctDesc, t.subDesc as acctSubDesc, b.dt_bill as billDt, ").
				append("b.code as code, ifnull(d.code, '') as tourCode, c.name as supplierName, t.amount as itemAmt, b.bill_amt as billAmt ").
			append("FROM ex_order_bill b ").
				append("LEFT JOIN supplier s on s.id = b.id_supplier ").
				append("LEFT JOIN person p on p.id = s.id_person ").
				append("LEFT JOIN corporate c on c.id_person = p.id ").
				append("LEFT JOIN tour_dep d on d.id = b.id_tour_dep, ").
				append("(select ").
					append("t.sys_no, a.code, a.sub_code as subCode, a.description as 'desc', a.sub_description as subDesc, ").
					append("case when t.debit = 0.00 then -(t.credit + tax_amount) else t.debit + tax_amount end as amount ").
				append("from account_trans t left join account a on a.id_company = :idCompany and t.id_acct = a.id ").
				append("where t.id_company = :idCompany and t.sys_cd = :sysCd and t.id_ref is not null and t.status_cd = :statusCd ").
				append(") t ").
			append("WHERE ").
				append("b.id_company = :idCompany and b.code = t.sys_no ").
				append("and b.status_cd not in (:statusCdCC, :statusCdVD) ").
				append("and date(b.dt_bill) between date(:frDate) and date(:toDate) ").
				append("and s.type_cd != 'SC' ");
			if (searchParamVO.getObj4() != null) {
				sb.append("and b.id_tour_dep = :idTourDep ");
			}
			sb.append("ORDER BY ").
				append("DATE_FORMAT(b.dt_bill,'%Y%m'), cast(t.code as decimal), cast(t.subCode as decimal), b.dt_bill, cast(b.code as decimal) ");
			
			SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
			query.addScalar("acctCd");
			query.addScalar("acctSubCd");
			query.addScalar("acctDesc");
			query.addScalar("acctSubDesc");
			query.addScalar("billDt", DateType.INSTANCE);
			query.addScalar("code");
			query.addScalar("tourCode");
			query.addScalar("supplierName");
			query.addScalar("itemAmt", DoubleType.INSTANCE);
			query.addScalar("billAmt", DoubleType.INSTANCE);
			
			query.setParameter("idCompany", idCompany);
			query.setParameter("frDate", (Date) searchParamVO.getObj2());
			query.setParameter("toDate", (Date) searchParamVO.getObj3());
			query.setParameter("sysCd", CommonConstant.SYS_NUM_CD_PURC_BILL);
			query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			query.setParameter("statusCdCC", CommonConstant.STATUS_CD_CANCELLED);
			query.setParameter("statusCdVD", CommonConstant.STATUS_CD_VOID);
			if (searchParamVO.getObj4() != null) query.setParameter("idTourDep", (Long) searchParamVO.getObj4());
			query.setResultTransformer(Transformers.aliasToBean(ExOrderBillVO.class));
			list = query.list();
			
		} catch (Exception e) {
			throw e;
		}
		return list;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acctreport.dao.AccountReportDAO#getARDetailAgingByCustomer(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<InvoiceVO> getARDetailAgingByCustomer(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		List<InvoiceVO> list = new ArrayList<InvoiceVO>();
		Session session = this.getSessionFactory().openSession();
		
		String invPrefix = LookupItemUtils.getInvPrefix(idCompany);
		String psPrefix = LookupItemUtils.getPsPrefix(idCompany);
		String cnPrefix = LookupItemUtils.getCnPrefix(idCompany);
		String jrnlPrefix = LookupItemUtils.getJrnlPrefix(idCompany);
		
		try {
			session.getTransaction().setTimeout(240);
			session.beginTransaction();
			
			sb.append("select ").
				append("t.doc_type_cd as docTypeCd, ").
//				append("case ").
//					append("when t.doc_type_cd = 'C' then concat('CN-', t.invoiceNo) ").
//					append("when t.doc_type_cd = 'P' then concat('PS-', t.invoiceNo) ").
//					append("else t.invoiceNo ").
//				append("end as code, ").
				append("t.invoiceNo as code, ").
				append("t.groupDocNo, "). // This use for grouping sum total JE will be inside the PS-Payment
				append("t.invoiceDt, t.departureDt, t.transType, tdp.code as tourCd, ").
				append("t.custCd, t.custType, ").
				append("if (t.custType = 'C', t.companyName, t.custName) as custName, ").
				append("sum(t.amount) as amount, sum(t.payment) as amtPaid, sum(t.balanceDue) as balance, ").
				// Current Day
				append("(case ").
					append("when (date(t.departureDt)>date(:toDate) and ifnull(tdp.code, '') not like 'ATK - %' and (sum(t.balanceDue) >= 0)) then ").
						append("sum(t.balanceDue) ").
					append("else ").
						append("0.00 ").
				append("end) as currentAmt, ").
				// 1-30 Days
				append("(case ").
					append("when ( ").
						append("((date(t.invoiceDt)>=date(date_add(LAST_DAY(date_add(:toDate, interval -1 MONTH)), interval 1 DAY)) ").
							append("and date(t.invoiceDt)<=date(:toDate) ").
							append("and ifnull(tdp.code, '') like 'ATK - %') ").
							append("or ").
							append("(date(t.departureDt)>=date(date_add(LAST_DAY(date_add(:toDate, interval -1 MONTH)), interval 1 DAY)) ").
							append("and date(t.departureDt)<=date(:toDate) ").
							append("and ifnull(tdp.code, '') not like 'ATK - %') ").
						append(") ").
						append("and (sum(t.balanceDue) >= 0) ").
					append(") then ").
						append("sum(t.balanceDue) ").
					append("else ").
						append("0.00 ").
				append("end) as days130Amt, ").
				// 31-60 Days
				append("(case ").
					append("when ( ").
						append("((date(t.invoiceDt)>=date(date_add(LAST_DAY(date_add(:toDate, interval -2 MONTH)), interval 1 DAY)) ").
							append("and date(t.invoiceDt)<=date(LAST_DAY(date_add(:toDate, interval -1 MONTH))) ").
							append("and ifnull(tdp.code, '') like 'ATK - %') ").
							append("or ").
							append("(date(t.departureDt)>=date(date_add(LAST_DAY(date_add(:toDate, interval -2 MONTH)), interval 1 DAY)) ").
							append("and date(t.departureDt)<=date(LAST_DAY(date_add(:toDate, interval -1 MONTH))) ").
							append("and ifnull(tdp.code, '') not like 'ATK - %') ").
						append(") ").
						append("and (sum(t.balanceDue) >= 0) ").
					append(") then ").
						append("sum(t.balanceDue) ").
					append("else ").
						append("0.00 ").
				append("end) as days3160Amt, ").
				// 61-90 Days
				append("(case ").
					append("when ( ").
						append("((date(t.invoiceDt)>=date(date_add(LAST_DAY(date_add(:toDate, interval -3 MONTH)), interval 1 DAY)) ").
							append("and date(t.invoiceDt)<=date(LAST_DAY(date_add(:toDate, interval -2 MONTH))) ").
							append("and ifnull(tdp.code, '') like 'ATK - %') ").
							append("or ").
							append("(date(t.departureDt)>=date(date_add(LAST_DAY(date_add(:toDate, interval -3 MONTH)), interval 1 DAY)) ").
							append("and date(t.departureDt)<=date(LAST_DAY(date_add(:toDate, interval -2 MONTH))) ").
							append("and ifnull(tdp.code, '') not like 'ATK - %') ").
						append(") ").
						append("and (sum(t.balanceDue) >= 0) ").
					append(") then ").
						append("sum(t.balanceDue) ").
					append("else ").
						append("0.00 ").
				append("end) as days6190Amt, ").
				// 91-120 Days
				append("(case ").
					append("when ( ").
						append("((date(t.invoiceDt)>=date(date_add(LAST_DAY(date_add(:toDate, interval -4 MONTH)), interval 1 DAY)) ").
							append("and date(t.invoiceDt)<=date(LAST_DAY(date_add(:toDate, interval -3 MONTH))) ").
							append("and ifnull(tdp.code, '') like 'ATK - %') ").
							append("or ").
							append("(date(t.departureDt)>=date(date_add(LAST_DAY(date_add(:toDate, interval -4 MONTH)), interval 1 DAY)) ").
							append("and date(t.departureDt)<=date(LAST_DAY(date_add(:toDate, interval -3 MONTH))) ").
							append("and ifnull(tdp.code, '') not like 'ATK - %') ").
						append(") ").
						append("and (sum(t.balanceDue) >= 0) ").
					append(") then ").
						append("sum(t.balanceDue) ").
					append("else ").
						append("0.00 ").
				append("end) as days91120Amt, ").
				// 121-150 Days
				append("(case ").
					append("when ( ").
						append("((date(t.invoiceDt)>=date(date_add(LAST_DAY(date_add(:toDate, interval -5 MONTH)), interval 1 DAY)) ").
							append("and date(t.invoiceDt)<=date(LAST_DAY(date_add(:toDate, interval -4 MONTH))) ").
							append("and ifnull(tdp.code, '') like 'ATK - %') ").
							append("or ").
							append("(date(t.departureDt)>=date(date_add(LAST_DAY(date_add(:toDate, interval -5 MONTH)), interval 1 DAY)) ").
							append("and date(t.departureDt)<=date(LAST_DAY(date_add(:toDate, interval -4 MONTH))) ").
							append("and ifnull(tdp.code, '') not like 'ATK - %') ").
						append(") ").
						append("and (sum(t.balanceDue) >= 0) ").
					append(") then ").
						append("sum(t.balanceDue) ").
					append("else ").
						append("0.00 ").
				append("end) as days121150Amt, ").
				// 150 Days After
				append("(case ").
					append("when ( ").
						append("((date(t.invoiceDt)<=date(LAST_DAY(date_add(:toDate, interval -5 MONTH))) ").
							append("and ifnull(tdp.code, '') like 'ATK - %') ").
							append("or ").
							append("(date(t.departureDt)<=date(LAST_DAY(date_add(:toDate, interval -5 MONTH))) ").
							append("and ifnull(tdp.code, '') not like 'ATK - %') ").
						append(") ").
						append("and (sum(t.balanceDue) >= 0) ").
					append(") then ").
						append("sum(t.balanceDue) ").
					append("else ").
						append("0.00 ").
				append("end) as days150AftAmt, ").
				// Advance Paid
				append("(case ").
					append("when (sum(t.balanceDue) < 0) then ").
						append("sum(t.balanceDue)  ").
					append("else ").
						append("0.00 ").
				append("end) as advPaidAmt ").
			append("from ( ").
				append("select a.id, a.id_customer, a.dt_inv as 'invoiceDt', a.trans_type as 'transType', a.invoiceNo, a.groupDocNo, a.code as 'invNo', ").
					append("a.ponumber as 'poNumber', ifnull(a.amount, 0.0) as 'amount', ifnull(a.payment, 0.0) as 'payment', ").
					append("ifnull(a.amount, 0.0) - ifnull(a.payment, 0.0) as 'balanceDue', ").
					append("case ").
						append("when a.doc_type_cd = 'I'or a.doc_type_cd = 'P' then a.id_tour_dep ").
						append("else if(cn.id_tour_dep is not null, cn.id_tour_dep, cnps.id_tour_dep) ").
					append("end as idTourDep, ").
					append("case ").
						append("when a.doc_type_cd = 'I' or a.doc_type_cd = 'P' then a.dt_departure ").
						append("else if(cn.id_tour_dep is not null, cn.cnDepDt, cnps.psDepDt) ").
					append("end as departureDt, ").
					append("cm.code as 'custCd', ").
					append("cm.pc_type_cd as 'custType', ").
					append("concat(UPPER(ps.salutation_cd), ' ', ps.last_name, ' ', ps.first_name) as 'custName', ").
					append("cm.corporate_name as 'companyName', ").
					append("a.doc_type_cd ").
				append("from ( ").
//					append("select i.code as 'invoiceNo', i.id, i.id_customer, i.dt_inv as dt_inv, i.dt_departure, ").
				append("select ").
						append("case when i.doc_type_cd = 'I' then concat('" + invPrefix + " ', i.code) when i.doc_type_cd = 'P' then concat('" + psPrefix + " ', i.ps_no) else concat('" + cnPrefix + " ', i.code) end as 'invoiceNo', ").
						append("case when i.doc_type_cd = 'P' then i.ps_no else i.code end as groupDocNo, ").
						append("i.id, i.id_customer, i.dt_inv as dt_inv, i.dt_departure, ").
						append("case when i.doc_type_cd = 'I' then 'Sales Invoice' when i.doc_type_cd = 'P' then 'Pax Statement' else 'Credit Note' end as trans_type, i.code, ").
						append("'' as ponumber, ").
						append("case when i.doc_type_cd = 'I' or i.doc_type_cd = 'P' then i.amount else null end as amount, ").
						append("case when i.doc_type_cd = 'I' or i.doc_type_cd = 'P' then null else i.amount end as payment, ").
						append("i.cn_inv_no, i.cn_ps_no, i.doc_type_cd, i.id_tour_dep ").
					append("from invoice i ").
					append("where i.id_company = :idCompany ").
						append("and case when (i.doc_type_cd = 'I' or i.doc_type_cd = 'P') then i.status_cd != :statusCdVD else i.status_cd != :statusCdCC and i.status_cd != :statusCdVD end ").
						append("and date(i.dt_inv) <= date(:toDate) ").
//						append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') not in ('CV','SP','CL'))) ");
						append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('OP', 'RW', 'CV'))) ");
						if (searchParamVO.getObj4() != null) {
							sb.append("and i.id_customer = :idCustomer ");
						}
					sb.append("union all ").
//					append("select i.code as 'invoiceNo', i.id, i.id_customer, ").
					append("select ").
						append("case when i.doc_type_cd = 'I' then concat('" + invPrefix + " ', i.code) when i.doc_type_cd = 'P' then concat('" + psPrefix + " ', i.ps_no) else concat('" + cnPrefix + " ', i.code) end as 'invoiceNo', ").
						append("case when i.doc_type_cd = 'P' then i.ps_no else i.code end as groupDocNo, ").
						append("i.id, i.id_customer, ").
						append("case when (i.doc_type_cd = 'I' or i.doc_type_cd = 'P') and cb.dt_trans is not null then cb.dt_trans else ip.dt_pmnt end as dt_inv, i.dt_departure, ").
						append("case when i.doc_type_cd = 'I' then 'Payment' when i.doc_type_cd = 'P' then 'PS-Payment' else 'CN-Payment' end as trans_type, ip.code, ").
						append("ip.ref_no as ponumber, ").
						append("case when i.doc_type_cd = 'I' or i.doc_type_cd = 'P' then null else ip.amount end as amount, ").
						append("case when i.doc_type_cd = 'I' or i.doc_type_cd = 'P' then ip.amount else null end as payment, ").
						append("i.cn_inv_no, i.cn_ps_no, i.doc_type_cd, i.id_tour_dep ").
//					append("from invoice i, invoice_pmnt ip left join (select id_inv_pmnt, dt_trans from inv_pmnt_cashbook_link cbl, cash_book cash where cbl.id_cash_book = cash.id and cbl.status_cd = :statusCd) cb on ip.id = cb.id_inv_pmnt ").
//						append("from invoice i left join invoice psInv on i.id_company = psInv.id_company and i.doc_type_cd = 'P' and psInv.doc_type_cd = 'I' and psInv.ps_no = i.ps_no and date(psinv.dt_inv) <= date(:toDate), ").
						append("from invoice i, ").
					append("invoice_pmnt ip ").
					append("left join invoice_pmnt parent on ip.id_parent_pmnt is not null and ip.id_parent_pmnt = parent.id ").
					append("left join inv_pmnt_cashbook_link link on link.status_cd = :statusCd and  ").
					append("(case when parent.id_parent_pmnt is not null then parent.id_parent_pmnt when ip.id_parent_pmnt is not null then ip.id_parent_pmnt else ip.id end) = link.id_inv_pmnt ").
					append("left join cash_book cb on cb.status_cd = :statusCd and link.id_cash_book = cb.id ").
					append("where i.id=ip.id_inv and ip.status_cd = :statusCd and i.id_company = :idCompany ").
						append("and case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.status_cd != :statusCdVD else i.status_cd != :statusCdCC and i.status_cd != :statusCdVD end ").
						append("and ").
//						append("case when (i.doc_type_cd = 'I' or i.doc_type_cd = 'P') and cb.id_inv_pmnt is not null then date(cb.dt_trans) <= date(:toDate) ").
//						append("else date(ip.dt_pmnt) <= date(:toDate) end ").
						append("if(cb.dt_trans is not null, cb.dt_trans, ip.dt_pmnt) <= date(:toDate) ").
//						append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') not in ('CV','SP','CL'))) ");
						append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('OP', 'RW'))) ");
//						append("and ((i.doc_type_cd = 'I' and date(i.dt_inv) <= date(:toDate)) or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and (ifnull(i.doc_type_status, '') in ('OP', 'RW') or (ifnull(i.doc_type_status, '') in ('CV') and psInv.id is null)))) ");
						
						if (searchParamVO.getObj4() != null) {
							sb.append("and i.id_customer = :idCustomer ");
						}
					sb.append("union all ").
					append("select ").
						append("concat('" + jrnlPrefix + " ', j.sys_no) as 'invoiceNo', i.ps_no as groupDocNo, i.id, i.id_customer, j.dt_journal as dt_inv, i.dt_departure, 'Journal' as trans_type, '' as code, ").
						append("'' as ponumber, 0 as amount, j.total_amt as payment, '' as cn_inv_no, '' as cn_ps_no, i.doc_type_cd, i.id_tour_dep ").
					append("from journal j, invoice i ").
					append("where j.id_ps = i.id and j.id_company = :idCompany and j.type_cd = 'sales' ").
					append("and j.dt_journal <= date(:toDate) ");
					if (searchParamVO.getObj4() != null) {
						sb.append("and i.id_customer = :idCustomer ");
					}
				sb.append(") a ").
				append("left join (select iv.code as inv_no, iv.id_tour_dep, iv.dt_departure as cnDepDt from invoice iv where iv.id_company = :idCompany and iv.doc_type_cd = 'I') cn on a.cn_inv_no = cn.inv_no ").
				append("left join (select ps.code as ps_no, ps.id_tour_dep, ps.dt_departure as psDepDt from invoice ps where ps.id_company = :idCompany and ps.doc_type_cd = 'P') cnps on a.cn_ps_no = cnps.ps_no, ").
				append("customer cm, person ps ").
				append("where a.id_customer = cm.id and cm.id_pc = ps.id ").
			append(") t left join tour_dep tdp on t.idTourDep = tdp.id ").
			append("group by t.custCd, t.doc_type_cd, t.groupDocNo having balance != 0 ").
			append("order by cast(t.custCd as decimal), date(t.invoiceDt), cast(t.custCd as decimal), t.doc_type_cd, cast(t.invoiceNo as decimal) ");
			
			SQLQuery query = (SQLQuery) session.createSQLQuery(sb.toString());
			query.addScalar("invoiceDt", DateType.INSTANCE);
			query.addScalar("docTypeCd");
			query.addScalar("code");
			query.addScalar("tourCd");
			query.addScalar("departureDt", DateType.INSTANCE);
			query.addScalar("custCd");
			query.addScalar("custName");
			query.addScalar("amount", DoubleType.INSTANCE);
			query.addScalar("amtPaid", DoubleType.INSTANCE);
			query.addScalar("balance", DoubleType.INSTANCE);
			query.addScalar("currentAmt", DoubleType.INSTANCE);
			query.addScalar("days130Amt", DoubleType.INSTANCE);
			query.addScalar("days3160Amt", DoubleType.INSTANCE);
			query.addScalar("days6190Amt", DoubleType.INSTANCE);
			query.addScalar("days91120Amt", DoubleType.INSTANCE);
			query.addScalar("days121150Amt", DoubleType.INSTANCE);
			query.addScalar("days150AftAmt", DoubleType.INSTANCE);
			query.addScalar("advPaidAmt", DoubleType.INSTANCE);
			
			query.setParameter("idCompany", idCompany);
			query.setParameter("toDate", (Date) searchParamVO.getObj3());
			query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			query.setParameter("statusCdCC", CommonConstant.STATUS_CD_CANCELLED);
			query.setParameter("statusCdVD", CommonConstant.STATUS_CD_VOID);
			if (searchParamVO.getObj4() != null) {
				query.setParameter("idCustomer", (Long) searchParamVO.getObj4());
			}
			
			query.setResultTransformer(Transformers.aliasToBean(InvoiceVO.class));
			list = query.list();
			
			session.getTransaction().commit();
		} catch (Exception e) {
			session.getTransaction().rollback();
			throw e;
		} finally {
			session.close();
		}
		return list;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acct.dao.ChartOfAcctDAO#getSalesInAdvanceList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctViewVO> getDepositReceived(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
		StringBuilder sb = new StringBuilder();
		
		String invPrefix = LookupItemUtils.getInvPrefix(idCompany);
		String psPrefix = LookupItemUtils.getPsPrefix(idCompany);
		String cnPrefix = LookupItemUtils.getCnPrefix(idCompany);
		String jrnlPrefix = LookupItemUtils.getJrnlPrefix(idCompany);
		
		sb.append("select ").
			append("t.dtInv, t.dtDep, t.transType, t.invoiceNo, t.groupDocNo, t.invNo, tdp.code as tourCd, ").
			append("t.custCd, t.custType, t.custName, t.companyName, t.poNumber, ").
			append("case ").
				append("when t.doc_type_cd = 'I' or t.doc_type_cd = 'P' or sum(t.amount) = 0.00 then sum(t.amount) ").
				append("else -1 * sum(t.amount) ").
			append("end as amount, ").
			append("case ").
				append("when t.doc_type_cd = 'I' or t.doc_type_cd = 'P' or sum(t.payment) = 0.00 then sum(t.payment) ").
				append("else -1 * sum(t.payment) ").
			append("end as payment, ").
			append("case ").
				append("when t.doc_type_cd = 'I' or t.doc_type_cd = 'P' or sum(t.balanceDue) = 0.00 then sum(t.balanceDue) ").
				append("else -1 * sum(t.balanceDue) ").
			append("end as balanceDue, ").
			append("psNo, psDt ").
		append("from ( ").
			append("select a.id, a.id_customer, a.dt_inv as 'dtInv', a.trans_type as 'transType', a.invoiceNo, a.groupDocNo, a.code as 'invNo', ").
				append("concat('" + psPrefix + " ', ivps.ps_no) as psNo, ivps.dt_inv as psDt, ").
				append("a.ponumber as 'poNumber', ifnull(a.amount, 0.0) as 'amount', ifnull(a.payment, 0.0) as 'payment', ").
				append("ifnull(a.amount, 0.0) - ifnull(a.payment, 0.0) as 'balanceDue', ").
				append("case ").
					append("when a.doc_type_cd = 'I' or a.doc_type_cd = 'P' then a.id_tour_dep ").
					append("else if(cn.id_tour_dep is not null, cn.id_tour_dep, cnps.id_tour_dep) ").
				append("end as idTourDep, ").
				append("case ").
					append("when a.doc_type_cd = 'I' or a.doc_type_cd = 'P' then a.dt_departure ").
					append("else if(cn.id_tour_dep is not null, cn.cnDepDt, cnps.psDepDt) ").
				append("end as dtDep, ").
				append("cm.code as 'custCd', ").
				append("cm.pc_type_cd as 'custType', ").
				append("concat(UPPER(p.salutation_cd), ' ', p.last_name, ' ', p.first_name) as 'custName', ").
				append("cm.corporate_name as 'companyName', ").
				append("a.doc_type_cd ").
			append("from ( ").
//				append("select i.code as 'invoiceNo', i.ps_no, i.id, i.id_customer, i.dt_inv as dt_inv, i.dt_departure, ").
				append("select ").
					append("case when i.doc_type_cd = 'I' then concat('" + invPrefix + " ', i.code) when i.doc_type_cd = 'P' then concat('" + psPrefix + " ', i.ps_no) else concat('" + cnPrefix + " ', i.code) end as 'invoiceNo', ").
					append("case when i.doc_type_cd = 'P' then i.ps_no else i.code end as groupDocNo, ").
					append("i.ps_no, i.id, i.id_customer, i.dt_inv as dt_inv, i.dt_departure, ").
					append("case when i.doc_type_cd = 'I' then 'Sales Invoice' when i.doc_type_cd = 'P' then 'Pax Statement' else 'Credit Note' end as trans_type, i.code, ").
					append("'' as ponumber, ").
					append("case when i.doc_type_cd = 'I' or i.doc_type_cd = 'P' then i.amount else null end as amount, ").
					append("case when i.doc_type_cd = 'I' or i.doc_type_cd = 'P' then null else i.amount end as payment, ").
					append("i.cn_inv_no, i.cn_ps_no, i.doc_type_cd, i.id_tour_dep ").
				append("from invoice i ").
				append("where i.id_company = :idCompany ").
					append("and case when (i.doc_type_cd = 'I' or i.doc_type_cd = 'P') then i.status_cd != :statusCdVD else i.status_cd != :statusCdCC and i.status_cd != :statusCdVD end ").
					append("and date(i.dt_inv) <= date(:toDate) ").
//					append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') not in ('CV','SP'))) ");
					append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('OP', 'RW', 'CV'))) ");
//					append("and ((i.doc_type_cd = 'I'  and date(i.dt_inv) <= date(:toDate)) or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and (ifnull(i.doc_type_status, '') in ('OP', 'RW') or (ifnull(i.doc_type_status, '') in ('CV') and psInv.id is null)))) ");
					if (searchParamVO.getObj6() != null) {
						sb.append("and i.id_customer = :idCustomer ");
					}
				sb.append("union all ").
//				append("select i.code as 'invoiceNo', i.ps_no, i.id, i.id_customer, ").
				append("select ").
					append("case when i.doc_type_cd = 'I' then concat('" + invPrefix + " ', i.code) when i.doc_type_cd = 'P' then concat('" + psPrefix + " ', i.ps_no) else concat('" + cnPrefix + " ', i.code) end as 'invoiceNo', ").
					append("case when i.doc_type_cd = 'P' then i.ps_no else i.code end as groupDocNo, ").
					append("i.ps_no, i.id, i.id_customer, ").
					append("case when (i.doc_type_cd = 'I' or i.doc_type_cd = 'P') and cb.dt_trans is not null then cb.dt_trans else ip.dt_pmnt end as dt_inv, i.dt_departure, ").
					append("case when i.doc_type_cd = 'I' then 'Payment' when i.doc_type_cd = 'P' then 'PS-Payment' else 'CN-Payment' end as trans_type, ip.code, ").
					append("ip.ref_no as ponumber, ").
					append("case when i.doc_type_cd = 'I' or i.doc_type_cd = 'P' then null else ip.amount end as amount, ").
					append("case when i.doc_type_cd = 'I' or i.doc_type_cd = 'P' then ip.amount else null end as payment, ").
					append("i.cn_inv_no, i.cn_ps_no, i.doc_type_cd, i.id_tour_dep ").
				append("from invoice i, ").
					append("invoice_pmnt ip ").
					append("left join invoice_pmnt parent on ip.id_parent_pmnt is not null and ip.id_parent_pmnt = parent.id ").
					append("left join inv_pmnt_cashbook_link link on link.status_cd = :statusCd and  ").
					append("(case when parent.id_parent_pmnt is not null then parent.id_parent_pmnt when ip.id_parent_pmnt is not null then ip.id_parent_pmnt else ip.id end) = link.id_inv_pmnt ").
					append("left join cash_book cb on cb.status_cd = :statusCd and link.id_cash_book = cb.id ").
				append("where i.id=ip.id_inv and ip.status_cd = :statusCd and i.id_company = :idCompany ").
					append("and case when (i.doc_type_cd = 'I' OR i.doc_type_cd = 'P') then i.status_cd != :statusCdVD else i.status_cd != :statusCdCC and i.status_cd != :statusCdVD end ").
					append("and ").
//					append("case when (i.doc_type_cd = 'I' or i.doc_type_cd = 'P') and cb.id_inv_pmnt is not null then date(cb.dt_trans) <= date(:toDate) ").
//					append("else date(ip.dt_pmnt) <= date(:toDate) end ").
					append("if(cb.dt_trans is not null, cb.dt_trans, ip.dt_pmnt) <= date(:toDate) ").
//					append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') not in ('CV','SP'))) ");
					append("and (i.doc_type_cd = 'I' or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('OP', 'RW'))) ");
//					append("and ((i.doc_type_cd = 'I'  and date(i.dt_inv) <= date(:toDate)) or i.doc_type_cd = 'C' or (i.doc_type_cd = 'P' and (ifnull(i.doc_type_status, '') in ('OP', 'RW') or (ifnull(i.doc_type_status, '') in ('CV') and psInv.id is null)))) ");
					if (searchParamVO.getObj6() != null) {
						sb.append("and i.id_customer = :idCustomer ");
					}
				sb.append("union all ").
				append("select ").
					append("concat('" + jrnlPrefix + " ', j.sys_no) as 'invoiceNo', i.ps_no as groupDocNo, i.ps_no, i.id, i.id_customer, j.dt_journal as dt_inv, i.dt_departure, 'Journal' as trans_type, '' as code, ").
					append("'' as ponumber, 0 as amount, j.total_amt as payment, '' as cn_inv_no, '' as cn_ps_no, i.doc_type_cd, i.id_tour_dep ").
				append("from journal j, invoice i ").
				append("where j.id_ps = i.id and j.id_company = :idCompany and j.type_cd = 'sales' ").
				append("and j.dt_journal <= date(:toDate) ");
//				append("and (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') in ('CV') and psInv.id is null) ");
					if (searchParamVO.getObj6() != null) {
						sb.append("and i.id_customer = :idCustomer ");
					}
			sb.append(") a ").
			append("left join (select iv.code as inv_no, iv.id_tour_dep, iv.dt_departure as cnDepDt from invoice iv where iv.id_company = :idCompany and iv.doc_type_cd = 'I') cn on a.cn_inv_no = cn.inv_no ").
			append("left join (select ps.code as ps_no, ps.id_tour_dep, ps.dt_departure as psDepDt from invoice ps where ps.id_company = :idCompany and ps.doc_type_cd = 'P') cnps on a.cn_ps_no = cnps.ps_no ").
			append("left join (select ps_no, dt_inv from invoice where id_company = :idCompany and doc_type_cd = 'P') ivps on a.ps_no is not null and a.ps_no = ivps.ps_no, ").
			append("customer cm, person p ").
			append("where a.id_customer = cm.id and cm.id_pc = p.id ").
			append("order by cast(cm.code as decimal), cast(a.invoiceNo as decimal), field(a.trans_type,  'Sales Invoice', 'Payment', 'Pax Statement', 'PS-Payment', 'Journal', 'Credit Note', 'CN-Payment') ").
		append(") t left join tour_dep tdp on t.idTourDep = tdp.id ");
//		append("where date(t.dtDep) > date(:toDate) ").
//		append("and ifnull(tdp.code, '') not like 'ATK -%' ");
//		sb.append("where ifnull(tdp.code, '') not like 'ATK -%' and ifnull(tdp.code, '') not like 'ATK-%' ");
		if (searchParamVO.getObj4() != null) sb.append("and date(t.dtDep) >= date('" + sdf.format((Date)searchParamVO.getObj4()) + "') ");
		if (searchParamVO.getObj5() != null) sb.append("and date(t.dtDep) <= date('" + sdf.format((Date)searchParamVO.getObj5()) + "') ");
		sb.append("group by t.custCd, t.doc_type_cd, t.groupDocNo ").
		append("order by cast(t.custCd as decimal), t.dtInv, cast(t.invNo as decimal), t.dtDep ");
		
		SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
		query.addScalar("dtInv", DateType.INSTANCE);
		query.addScalar("dtDep", DateType.INSTANCE);
		query.addScalar("transType");
		query.addScalar("invoiceNo");
		query.addScalar("tourCd");
		query.addScalar("custCd");
		query.addScalar("custType");
		query.addScalar("custName");
		query.addScalar("companyName");
		query.addScalar("poNumber");
		query.addScalar("amount", DoubleType.INSTANCE);
		query.addScalar("payment", DoubleType.INSTANCE);
		//query.addScalar("balance", DoubleType.INSTANCE);
		query.addScalar("balanceDue", DoubleType.INSTANCE);
		query.addScalar("psNo");
		query.addScalar("psDt", DateType.INSTANCE);
		//query.setParameter("frDate", (Date) searchParamVO.getObj2());
		query.setParameter("toDate", (Date) searchParamVO.getObj3());
		query.setParameter("idCompany", idCompany);
		if (searchParamVO.getObj6() != null) {
			query.setParameter("idCustomer", (Long) searchParamVO.getObj6());
		}
		query.setParameter("statusCdCC", CommonConstant.STATUS_CD_CANCELLED);
		query.setParameter("statusCdVD", CommonConstant.STATUS_CD_VOID);
		query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
		query.setResultTransformer(Transformers.aliasToBean(AcctViewVO.class));
		return query.list();
	}
}
