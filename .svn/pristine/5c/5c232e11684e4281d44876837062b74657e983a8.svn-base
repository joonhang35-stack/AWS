	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acctreport.dao.AccountReportDAO#getTourThemeList()
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<TourThemeVO> getTourThemeList() throws BusinessException {
		StringBuilder sb = new StringBuilder();
		List<TourThemeVO> list = new ArrayList<TourThemeVO>();
		
		try {
			
			sb.append("select t.id, c.description as tourCatDesc, t.description as 'desc' ").
			append("from tour_theme t, tour_cat c ").
			append("where t.id_Parent is null and t.status_cd = :statusCd and c.status_cd = :statusCd ").
				append("and t.id_tour_cat = c.id ").
			append("order by c.id, t.seq, t.description ");
			
			SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
			query.addScalar("id", LongType.INSTANCE);
			query.addScalar("tourCatDesc");
			query.addScalar("desc");
			query.setParameter("statusCd", CommonConstant.STATUS_CD_ACTIVE);
			query.setResultTransformer(Transformers.aliasToBean(TourThemeVO.class));
			list = query.list();
			
		} catch (Exception e) {
			throw e;
		}
		return list;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acctreport.dao.AccountReportDAO#getCustomerListing(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<CustomerVO> getCustomerListing(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		List<CustomerVO> list = new ArrayList<CustomerVO>();
		
		try {
			sb.append("SELECT ").
				append("custId, personId, salutation_cd, firstname, lastname, email, corporate, id_pc, pc_type_cd, ").
				append("(SELECT GROUP_CONCAT(CONCAT(type_cd, ': ', number) separator ', ') FROM person_contact WHERE id_person = A.personId AND status_cd = 'A') AS 'perContacts', ").
				append("(SELECT GROUP_CONCAT(CONCAT(type_cd, ': ', number) separator ', ') FROM corporate_contact WHERE id_corporate = A.id_corporate AND status_cd = 'A') AS 'corContacts', ").
				append("if(A.pc_type_cd = 'P', ").
				append("(SELECT CONCAT_WS(' ', ").
				append("if(addr_1 = '', null, addr_1), if(addr_2 = '', null, addr_2), if(addr_3 = '', null, addr_3), ").
				append("if(city = '', null, city), if(state = '', null, state), if(postcode = '', null, postcode), ").
				append("if(c.name = '', null, c.name)) FROM person_address pa left join country c on c.id = pa.id_country WHERE id_person = A.personId AND pa.type_cd = 'bill') ").
				append(", '') AS 'perAddress', ").
				append("(SELECT CONCAT_WS(' ', ").
				append("if(addr_1 = '', null, addr_1), if(addr_2 = '', null, addr_2), if(addr_3 = '', null, addr_3), ").
				append("if(city = '', null, city), if(state = '', null, state), if(postcode = '', null, postcode), ").
				append("if(c.name = '', null, c.name)) FROM corporate_address pa left join country c on c.id = pa.id_country WHERE id_corporate = A.id_corporate AND pa.type_cd = 'bill') AS 'corAddress', ").
				append("corName, code, nickName ").
				append("FROM (SELECT ").
				append("c.id_corporate, c.status_cd, c.id AS 'custId', p.id  as personId, p.salutation_cd as salutation_cd, IFNULL(p.first_name, '') as firstname, IFNULL(p.last_name, '') as lastname, ").
				append("p.nick_name as nickName, p.email as email, o.name AS 'corporate', c.id_pc, c.pc_type_cd, c.corporate_name AS 'corName', c.code AS 'code' ").
				append("FROM customer c ").
				append("left join person p on c.id_pc = p.id ").
				append("left join corporate o on (c.pc_type_cd = 'C' AND c.id_corporate = o.id ) ").
				append("WHERE id_company = :idCompany and status_cd = :statusCd ");
				if (searchParamVO.getObj4() != null) {
					sb.append("AND c.id = :idCustomer ");
				}
			sb.append(") A order by ");
			if (StringUtils.isNotEmpty(searchParamVO.getObj7().toString())) {
				if (searchParamVO.getObj7().toString().equals("CoN")) {
					sb.append("corName ");
				} else if (searchParamVO.getObj7().toString().equals("CuN")) {
					sb.append("concat(lastname, ' ', firstname) ");
				} else {
					sb.append("cast(code as decimal) ");
				}
			} else {
				sb.append("cast(code as decimal) ");
			}
			sb.append("asc ");
			
			Query query = createSQLQuery(sb.toString());
			query.setParameter("idCompany", idCompany);
			if (searchParamVO.getObj4() != null) {
				query.setParameter("idCustomer", (Long) searchParamVO.getObj4());
			}
			query.setParameter("statusCd", CommonConstant.STATUS_CD_ACTIVE);
			List<Object> objList = query.list();
			
			if (CollectionUtils.isNotEmpty(objList)) {
				for (Iterator<Object> it = objList.iterator() ; it.hasNext() ;) {
					Object[] row = (Object[]) it.next();
					CustomerVO vo = new CustomerVO();
					vo.setId(((BigInteger) row[0]).longValue()); 
					vo.setPersonId(((BigInteger) row[1]).longValue());
					vo.setSalutationCd((String) row[2]);
					vo.setFirstName((String) row[3]);
					vo.setLastName((String) row[4]);
					vo.setCustName(vo.getSalutationCd().toUpperCase() + " " + vo.getLastName() + " " + vo.getFirstName());
					vo.setEmail((String) row[5]);
					vo.setCorporate((String) row[6]);
					vo.setPersCorpId(((BigInteger) row[7]).longValue());
					vo.setPcTypeCd((String) row[8]);
					vo.setPerContacts((String) row[9]);
					vo.setCorContacts((String) row[10]);
					if (vo.getPerContacts() == null && vo.getCorContacts() != null) vo.setPerContacts(vo.getCorContacts());
					else if (vo.getPerContacts() != null && vo.getCorContacts() != null) vo.setPerContacts(vo.getPerContacts() + "," + vo.getCorContacts());
					if (vo.getPerContacts() != null) {
						vo.setPerContacts(vo.getPerContacts().replace("mobile", LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "mobile"))
							.replace("office",  LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "office"))
							.replace("home",  LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "home"))
							.replace("fax",  LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "fax")));
					}
					if (StringUtils.isEmpty(vo.getEmail())) {
						vo.setEmail(vo.getPerContacts());
					} else if (StringUtils.isEmpty(vo.getPerContacts())) {
						
					} else {
						vo.setEmail(vo.getEmail() + ", " + vo.getPerContacts());
					}
					vo.setPerAddress((String) row[11]);
					vo.setCorAddress((String) row[12]);
					if(vo.getPcTypeCd().equals("C")) {
						vo.setPerAddress(vo.getCorAddress());
					}
					vo.setCorporateName((String) row[13]);
					vo.setCode((String) row[14]);
					vo.setNickName((String) row[15]);
					list.add(vo);
				}
			}
		} catch (Exception e) {
			throw e;
		}
		
		return list;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acctreport.dao.AccountReportDAO#getCustomerPaymentHistory(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<InvoiceVO> getCustomerPaymentHistory(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
		List<InvoiceVO> list = new ArrayList<InvoiceVO>();
		
		try {
//			sb.append("select ").
//				append("iv.doc_type_cd as docTypeCd, c.code as custCd, ").
//				append("if (c.pc_type_cd = 'C', c.corporate_name, concat(UPPER(c.salutation_cd), ' ', c.last_name, ' ', c.first_name)) as custName, ").
//				append("concat(if(iv.doc_type_cd = 'C', 'CN', ''), iv.code) as code, ").
//				append("if (iv.doc_type_cd = 'C', ifnull(cn.cnTourCd, ''), ifnull(tdp.code, '')) as tourCd, ").
//				append("iv.dt_inv as invoiceDt, ").
//				append("case when iv.doc_type_cd in ('I','P') and iv.doc_type_status not in ('CV','SP') and cb.id_inv_pmnt is not null then cb.dt_trans else ip.dt_pmnt end as departureDt, ").
//				append("ip.code as orderCd, ").
//				append("ip.ref_no as reason, ").
//				append("if(iv.doc_type_cd = 'C', -1 * ip.amount, ip.amount) as amount ").
//			append("from invoice iv left join tour_dep tdp on iv.id_tour_dep=tdp.id ").
//				append("left join (select i.code as inv_no, t.code as cnTourCd from invoice i left join tour_dep t on i.id_tour_dep = t.id where i.id_company = :idCompany and i.doc_type_cd in ('I','P') and i.doc_type_status not in ('CV','SP')) cn on iv.cn_inv_no = cn.inv_no, ").
//				append("(select cm.id, cm.code, cm.pc_type_cd, cm.corporate_name, ps.salutation_cd, ps.last_name, ps.first_name from customer cm, person ps where cm.id_pc=ps.id) c, ").
//				append("invoice_pmnt ip left join (select id_inv_pmnt, dt_trans from inv_pmnt_cashbook_link cbl, cash_book cash where cbl.id_cash_book = cash.id and cbl.status_cd = :statusCd) cb on ip.id = cb.id_inv_pmnt ").
//			append("where iv.id_company = :idCompany and iv.id_customer = c.id and iv.id = ip.id_inv and ip.status_cd = :statusCd and ").
//				append("iv.status_cd != :statusCdCC and iv.status_cd != :statusCdVD ");
//				if (searchParamVO.getObj2() != null) sb.append("and date(iv.dt_inv) >= date('" + sdf.format((Date)searchParamVO.getObj2()) + "') ");
//				if (searchParamVO.getObj3() != null) sb.append("and date(iv.dt_inv) <= date('" + sdf.format((Date)searchParamVO.getObj3()) + "') ");
//				if (searchParamVO.getObj4() != null) sb.append("and case when iv.doc_type_cd = 'C' then 1=1 else date(iv.dt_departure) >= date('" + sdf.format((Date)searchParamVO.getObj4()) + "') end ");
//				if (searchParamVO.getObj5() != null) sb.append("and case when iv.doc_type_cd = 'C' then 1=1 else date(iv.dt_departure) <= date('" + sdf.format((Date)searchParamVO.getObj5()) + "') end ");
//				//if (searchParamVO.getObj4() != null) sb.append("and date(iv.dt_departure) >= date('" + sdf.format((Date)searchParamVO.getObj4()) + "') ");
//				//if (searchParamVO.getObj5() != null) sb.append("and date(iv.dt_departure) <= date('" + sdf.format((Date)searchParamVO.getObj5()) + "') ");
//				if (searchParamVO.getObj6() != null) sb.append("and iv.id_customer = " + (Long) searchParamVO.getObj6() + " ");
//			sb.append("order by cast(c.code as decimal) ");
			
			sb.append("select ").
				append("iv.doc_type_cd as docTypeCd, c.code as custCd, ").
				append("if (c.pc_type_cd = 'C', c.corporate_name, concat(UPPER(c.salutation_cd), ' ', c.last_name, ' ', c.first_name)) as custName, ").
				append("case when iv.doc_type_cd = 'C' then concat('CN', iv.code) when iv.doc_type_cd = 'P' then concat('PS', iv.ps_no) else iv.code end as code, ").
				append("case when iv.doc_type_cd = 'C' then if (ifnull(cn_iv.tourCd, '') != '', ifnull(cn_iv.tourCd, ''), cn_ps.tourCd) else ifnull(tdp.code, '') end as tourCd, ").
				append("iv.dt_inv as invoiceDt, ").
				append("if (cb.dt_trans is not null, cb.dt_trans, ip.dt_pmnt) as departureDt, ").
				append("ip.code as orderCd, ").
				append("ip.ref_no as reason, ").
				append("if(iv.doc_type_cd = 'C', -1 * ip.amount, ip.amount) as amount, ").
				append("if(ip.amount != final.amount, final.docNo, '') as refNo, ").
				append("if(ip.amount != final.amount, final.amount, null) as amtPaid ").
			append("from invoice iv left join tour_dep tdp on iv.id_tour_dep=tdp.id ").
				append("left join ( "). // CN refer Invoice
					append("select i.code as invNo, t.code as tourCd, i.ps_no as psNo ").
					append("from invoice i left join tour_dep t on i.id_tour_dep = t.id ").
					append("where i.id_company = :idCompany and i.doc_type_cd = 'I' ").
				append(") cn_iv on iv.doc_type_cd = 'C' and iv.cn_inv_no = cn_iv.invNo ").
				append("left join ( "). // CN refer PS
					append("select i.code as invNo, t.code as tourCd, ps_no as psNo ").
					append("from invoice i left join tour_dep t on i.id_tour_dep = t.id ").
					append("where i.id_company = :idCompany and (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') not in ('CV','SP','CL')) ").
				append(") cn_ps on iv.doc_type_cd = 'C' and iv.cn_ps_no = cn_ps.psNo, ").
				append("(select cm.id, cm.code, cm.pc_type_cd, cm.corporate_name, ps.salutation_cd, ps.last_name, ps.first_name from customer cm, person ps where cm.id_pc=ps.id) c, ").
				append("invoice_pmnt ip ").
				append("left join invoice_pmnt parent on ip.id_parent_pmnt is not null and ip.id_parent_pmnt = parent.id ").
				append("left join inv_pmnt_cashbook_link link on link.status_cd = :statusCd and  ").
					append("(case when parent.id_parent_pmnt is not null then parent.id_parent_pmnt when ip.id_parent_pmnt is not null then ip.id_parent_pmnt else ip.id end) = link.id_inv_pmnt ").
				append("left join cash_book cb on cb.status_cd = :statusCd and link.id_cash_book = cb.id ").
				append("left join ( ").
						append("select ip.id, if(i.doc_type_cd = 'P', concat('PS', i.ps_no), i.code) as docNo, ip.amount from invoice i, invoice_pmnt ip where i.id = ip.id_inv and i.doc_type_cd in ('I', 'P') ").
				append(") final on (case when parent.id_parent_pmnt is not null then parent.id_parent_pmnt when ip.id_parent_pmnt is not null then ip.id_parent_pmnt else ip.id end) = final.id ").
			append("where iv.id_company = :idCompany and iv.id_customer = c.id and iv.id = ip.id_inv and ip.status_cd = :statusCd and ").
				append("iv.status_cd != :statusCdCC and iv.status_cd != :statusCdVD ").
				append("and (iv.doc_type_cd = 'I' OR iv.doc_type_cd = 'C' or (iv.doc_type_cd = 'P' and ifnull(iv.doc_type_status, '') not in ('CV','SP','CL'))) ");
				if (searchParamVO.getObj2() != null) sb.append("and date(iv.dt_inv) >= date('" + sdf.format((Date)searchParamVO.getObj2()) + "') ");
				if (searchParamVO.getObj3() != null) sb.append("and date(iv.dt_inv) <= date('" + sdf.format((Date)searchParamVO.getObj3()) + "') ");
				if (searchParamVO.getObj4() != null) sb.append("and case when iv.doc_type_cd = 'C' then 1=1 else date(iv.dt_departure) >= date('" + sdf.format((Date)searchParamVO.getObj4()) + "') end ");
				if (searchParamVO.getObj5() != null) sb.append("and case when iv.doc_type_cd = 'C' then 1=1 else date(iv.dt_departure) <= date('" + sdf.format((Date)searchParamVO.getObj5()) + "') end ");
				//if (searchParamVO.getObj4() != null) sb.append("and date(iv.dt_departure) >= date('" + sdf.format((Date)searchParamVO.getObj4()) + "') ");
				//if (searchParamVO.getObj5() != null) sb.append("and date(iv.dt_departure) <= date('" + sdf.format((Date)searchParamVO.getObj5()) + "') ");
				if (searchParamVO.getObj6() != null) sb.append("and iv.id_customer = " + (Long) searchParamVO.getObj6() + " ");
			sb.append("order by cast(c.code as decimal) ");
			
			SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
			query.addScalar("custCd");
			query.addScalar("docTypeCd");
			query.addScalar("custName");
			query.addScalar("code");
			query.addScalar("tourCd");
			query.addScalar("invoiceDt", DateType.INSTANCE);
			query.addScalar("departureDt", DateType.INSTANCE);
			query.addScalar("orderCd");
			query.addScalar("reason");
			query.addScalar("amount", DoubleType.INSTANCE);
			query.addScalar("refNo");
			query.addScalar("amtPaid", DoubleType.INSTANCE);
			query.setParameter("idCompany", idCompany);
			query.setParameter("statusCdCC", CommonConstant.STATUS_CD_CANCELLED);
			query.setParameter("statusCdVD", CommonConstant.STATUS_CD_VOID);
			query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			query.setResultTransformer(Transformers.aliasToBean(InvoiceVO.class));
			list = query.list();
			
		} catch (Exception e) {
			throw e;
		}
		return list;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acctreport.dao.AccountReportDAO#getInvSalesPersonByMonth(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<InvoiceVO> getInvSalesPersonByMonth(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
		List<InvoiceVO> list = new ArrayList<InvoiceVO>();
		
		AppSettingVO appSettingVO = appSettingBO.getAppSettingByCode(ConstantAppSetting.MAINT_POS_CONFIG_GL_ACCT_TO_EXCLUDE);
		
		try {
			sb.append("SELECT a.salerId, a.salerName, a.invoiceDt, a.code, a.tourCd, a.departureDt, ");
			sb.append("IF(doc_type_cd = 'C', IF(id_tour_booking IS NOT NULL, numOfPax, IF(raw_reference_iv_amt != raw_iv_amt, 0, -1) * numOfPax), numOfPax) AS numOfPax, ");
			if (appSettingVO != null && StringUtils.isNotBlank(appSettingVO.getValue())) {
				sb.append("IF(count_acct_not_exclude > 0, a.amount - amt_dep, 0.00) * IF(a.doc_type_cd = 'C', -1, 1) AS amount, ");
				sb.append("IF(count_acct_not_exclude > 0, a.amtPaid - amt_dep, 0.00) * IF(a.doc_type_cd = 'C', -1, 1) AS amtPaid, ");
				sb.append("IF(count_acct_not_exclude > 0, balance, 0.00) AS balance ");
			} else {
				sb.append("a.amount * IF(a.doc_type_cd = 'C', -1, 1) AS amount, a.amtPaid * IF(a.doc_type_cd = 'C', -1, 1) AS amtPaid, ");
				sb.append("balance ");
			}
			sb.append("FROM ( ");
				sb.append("select ").
					append("iv.id_saler as salerId, ").
					append("usr.user_name as salerName, ").
					append("iv.dt_inv as invoiceDt, ").
					append("concat(if(iv.doc_type_cd = 'C', 'CN', ''), iv.code) as code, ").
					append("ifnull(tdp.code, '') as tourCd, ").
					append("iv.dt_departure as departureDt, ").
					append("cn_iv.id_tour_booking, ").
					append("IF(iv.doc_type_cd = 'C', IFNULL((SELECT SUM(amount + tax_amount) AS amount FROM invoice_item inv_item WHERE inv_item.amount >= 0 AND inv_item.status_cd = 'A' AND inv_item.id_inv = cn_iv.id), 0), 0) AS raw_reference_iv_amt, ").
					append("IF(iv.doc_type_cd = 'C', IFNULL((SELECT SUM(amount + tax_amount) AS amount FROM invoice_item inv_item WHERE inv_item.amount >= 0 AND inv_item.status_cd = 'A' AND inv_item.id_inv = iv.id), 0), 0) AS raw_iv_amt, ").
					append("IF(iv.doc_type_cd = 'C', (IFNULL(pa.numPax, 0) * ").
						append("IF((SELECT id_credit_note FROM invoice_pmnt pmnt WHERE pmnt.id_inv = cn_iv.id AND pmnt.status_cd = 'A' AND pmnt_type_cd = 'credit_note' ORDER BY id DESC LIMIT 1) = iv.id, ").
						append("IF(tb.status_cd = 'CC' || tb.status_cd = 'VD', -1, 0), 0) ").
					append("), IFNULL(pa.numPax, 0)) AS numOfPax, ").
					append("iv.amount as amount, ").
					append("SUM(ifnull(p.amount, 0)) as amtPaid, ").
					append("ifnull(cn_p.amount, 0) as refInvAmtPaid, ").
					append("iv.balance as balance ");
					if (appSettingVO != null && StringUtils.isNotBlank(appSettingVO.getValue())) {
						sb.append(", iv.doc_type_cd AS doc_type_cd ");
						sb.append(", IFNULL((SELECT SUM(amount + tax_amount) AS amount FROM invoice_item inv_item WHERE inv_item.id_acct IN :excludeAcct AND inv_item.status_cd = 'A' AND inv_item.id_inv = iv.id), 0) AS amt_dep ");
						sb.append(", (SELECT COUNT(id) FROM invoice_item inv_item WHERE inv_item.id_acct NOT IN :excludeAcct AND inv_item.status_cd = 'A' AND inv_item.id_inv = iv.id) AS count_acct_not_exclude ");
					}
				sb.append("from invoice iv ").
					append("left join invoice cn_iv on cn_iv.code = iv.cn_inv_no ").
					append("left join tour_booking tb ON tb.id = cn_iv.id_tour_booking ").
					append("left join tour_dep tdp on IFNULL(iv.id_tour_dep, cn_iv.id_tour_dep)=tdp.id ").
					append("left join (select pax.id_inv, count(*) as numPax from invoice_pax pax where pax.status_cd = :statusCd group by pax.id_inv) pa on IF(iv.doc_type_cd = 'C',  cn_iv.id, iv.id)= pa.id_inv AND IF(iv.cat_cd = 'to', (CASE WHEN iv.id_tour_booking IS NOT NULL THEN true ELSE false END), true) ").
					append("left join invoice_pmnt p ON iv.id = p.id_inv AND p.status_cd = :statusCd ").
					append("left join (select pmnt.id_inv, sum(pmnt.amount) as amount from invoice_pmnt pmnt where pmnt.status_cd = :statusCd group by pmnt.id_inv) cn_p ON cn_iv.id = cn_p.id_inv AND cn_iv.id IS NOT NULL, ").
					append("employee ep, sec_user usr ").
				append("where iv.id_company = :idCompany and ").
					append("iv.status_cd != :statusCdCC and iv.status_cd != :statusCdVD and iv.id_saler=ep.id and ").
					append("ep.u_sec_user=usr.uuid ");
					if (searchParamVO.getObj2() != null) sb.append("and date(iv.dt_inv) >= date('" + sdf.format((Date)searchParamVO.getObj2()) + "') ");
					if (searchParamVO.getObj3() != null) sb.append("and date(iv.dt_inv) <= date('" + sdf.format((Date)searchParamVO.getObj3()) + "') ");
					if (searchParamVO.getObj6() != null) sb.append("and tdp.id = " + searchParamVO.getObj6() + " ");
					if (searchParamVO.getObj7() != null) sb.append("and iv.id_saler = " + searchParamVO.getObj7() + " ");
			sb.append(" GROUP BY iv.id ) a ");
			sb.append("order by a.invoiceDt, a.code ");
			
			SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
			query.addScalar("salerId", LongType.INSTANCE);
			query.addScalar("salerName");
			query.addScalar("invoiceDt", DateType.INSTANCE);
			query.addScalar("code");
			query.addScalar("tourCd");
			query.addScalar("departureDt", DateType.INSTANCE);
			query.addScalar("numOfPax", IntegerType.INSTANCE);
			query.addScalar("amount", DoubleType.INSTANCE);
			query.addScalar("amtPaid", DoubleType.INSTANCE);
			query.addScalar("balance", DoubleType.INSTANCE);
			query.setParameter("idCompany", idCompany);
			query.setParameter("statusCdCC", CommonConstant.STATUS_CD_CANCELLED);
			query.setParameter("statusCdVD", CommonConstant.STATUS_CD_VOID);
			query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			if (appSettingVO != null && StringUtils.isNotBlank(appSettingVO.getValue())) {
				List<String> excludeAcctList = Arrays.asList(appSettingVO.getValue().split(","));
				query.setParameterList("excludeAcct", excludeAcctList);
			}
			query.setResultTransformer(Transformers.aliasToBean(InvoiceVO.class));
			list = query.list();
			
		} catch (Exception e) {
			throw e;
		}
		return list;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acctreport.dao.AccountReportDAO#getInvCountryByMonth(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<InvoiceVO> getInvCountryByMonth(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
		List<InvoiceVO> list = new ArrayList<InvoiceVO>();
		
		AppSettingVO appSettingVO = appSettingBO.getAppSettingByCode(ConstantAppSetting.MAINT_POS_CONFIG_GL_ACCT_TO_EXCLUDE);
		
		try {
			sb.append("SELECT a.region, a.salerId, a.salerName, a.invoiceDt, a.doc_type_cd, a.code, a.tourCd, a.departureDt, ");
			sb.append("IF(doc_type_cd = 'C', IF(id_tour_booking IS NOT NULL, numOfPax, IF(raw_reference_iv_amt != raw_iv_amt, 0, -1) * numOfPax), numOfPax) AS numOfPax, ");
			if (appSettingVO != null && StringUtils.isNotBlank(appSettingVO.getValue())) {
				sb.append("IF(count_acct_not_exclude > 0, a.amount - amt_dep, 0.00) * IF(a.doc_type_cd = 'C', -1, 1) AS amount, ");
				sb.append("IF(count_acct_not_exclude > 0, a.amtPaid - amt_dep, 0.00) * IF(a.doc_type_cd = 'C', -1, 1) AS amtPaid, ");
				sb.append("IF(count_acct_not_exclude > 0, balance, 0.00) AS balance ");
			} else {
				sb.append("a.amount * IF(a.doc_type_cd = 'C', -1, 1) AS amount, a.amtPaid * IF(a.doc_type_cd = 'C', -1, 1) AS amtPaid, ");
				sb.append("balance ");
			}
			sb.append("FROM ( ");
				sb.append("select ").
					append("tdp.region, ").
					append("iv.id_saler as salerId, ").
					append("usr.user_name as salerName, ").
					append("iv.dt_inv as invoiceDt, ").
					append("concat(if(iv.doc_type_cd = 'C', 'CN', ''), iv.code) as code, ").
					append("ifnull(tdp.code, '') as tourCd, ").
					append("iv.dt_departure as departureDt, ").
					append("cn_iv.id_tour_booking, ").
					append("IF(iv.doc_type_cd = 'C', IFNULL((SELECT SUM(amount + tax_amount) AS amount FROM invoice_item inv_item WHERE inv_item.amount >= 0 AND inv_item.status_cd = 'A' AND inv_item.id_inv = cn_iv.id), 0), 0) AS raw_reference_iv_amt, ").
					append("IF(iv.doc_type_cd = 'C', IFNULL((SELECT SUM(amount + tax_amount) AS amount FROM invoice_item inv_item WHERE inv_item.amount >= 0 AND inv_item.status_cd = 'A' AND inv_item.id_inv = iv.id), 0), 0) AS raw_iv_amt, ").
					append("IF(iv.doc_type_cd = 'C', (IFNULL(pa.numPax, 0) * ").
						append("IF((SELECT id_credit_note FROM invoice_pmnt pmnt WHERE pmnt.id_inv = cn_iv.id AND pmnt.status_cd = 'A' AND pmnt_type_cd = 'credit_note' ORDER BY id DESC LIMIT 1) = iv.id, ").
						append("IF(tb.status_cd = 'CC' || tb.status_cd = 'VD', -1, 0), 0) ").
					append("), IFNULL(pa.numPax, 0)) AS numOfPax, ").
					append("iv.amount, ").
					append("SUM(ifnull(p.amount, 0)) as amtPaid, ").
					append("iv.balance as balance ");
					if (appSettingVO != null && StringUtils.isNotBlank(appSettingVO.getValue())) {
						sb.append(", iv.doc_type_cd AS doc_type_cd ");
						sb.append(", IFNULL((SELECT SUM(amount + tax_amount) AS amount FROM invoice_item inv_item WHERE inv_item.id_acct IN :excludeAcct AND inv_item.status_cd = 'A' AND inv_item.id_inv = iv.id), 0) AS amt_dep ");
						sb.append(", (SELECT COUNT(id) FROM invoice_item inv_item WHERE inv_item.id_acct NOT IN :excludeAcct AND inv_item.status_cd = 'A' AND inv_item.id_inv = iv.id) AS count_acct_not_exclude ");
					}
				sb.append("from invoice iv ").
					append("left join invoice cn_iv on cn_iv.code = iv.cn_inv_no ").
					append("left join tour_booking tb ON tb.id = cn_iv.id_tour_booking ").
					append("left join (select pax.id_inv, count(*) as numPax from invoice_pax pax where pax.status_cd = :statusCd group by pax.id_inv) pa on IF(iv.doc_type_cd = 'C',  cn_iv.id, iv.id)= pa.id_inv AND IF(iv.cat_cd = 'to', (CASE WHEN iv.id_tour_booking IS NOT NULL THEN true ELSE false END), true) ").
					append("left join invoice_pmnt p ON iv.id = p.id_inv AND p.status_cd = :statusCd ").
					append("left join (select pmnt.id_inv, sum(pmnt.amount) as amount from invoice_pmnt pmnt where pmnt.status_cd = :statusCd group by pmnt.id_inv) cn_p ON cn_iv.id = cn_p.id_inv AND cn_iv.id IS NOT NULL, ").
					append("employee ep, sec_user usr, ").
					append("( ").
						append("select d.id, d.code, concat(c.description, ' - ', t.description) as 'region' ").
						append("from tour_theme t, tour_cat c, tour_pkg p, tour_dep d ").
						append("where t.id_parent is not null and p.type_cd = 'TOUR' ").
							append("and t.id_tour_cat = c.id ").
							append("and p.id_tour_theme = t.id ").
							append("and d.id_tour_pkg = p.id ");
							if (searchParamVO.getObj6() != null) sb.append("and tdp.id_parent in (" + searchParamVO.getObj6() + ") ");
					sb.append(") tdp ").
				append("where iv.id_company = :idCompany and ").
					append("iv.status_cd != :statusCdCC and iv.status_cd != :statusCdVD and iv.id_saler = ep.id and ").
					append("ep.u_sec_user = usr.uuid and IFNULL(iv.id_tour_dep, cn_iv.id_tour_dep) = tdp.id ");
					if (searchParamVO.getObj2() != null) sb.append("and date(iv.dt_inv) >= date('" + sdf.format((Date)searchParamVO.getObj2()) + "') ");
					if (searchParamVO.getObj3() != null) sb.append("and date(iv.dt_inv) <= date('" + sdf.format((Date)searchParamVO.getObj3()) + "') ");
			sb.append(" GROUP BY iv.id ) a ");
			sb.append("order by a.region, a.invoiceDt, a.code ");
			
			SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
			query.addScalar("region");
			query.addScalar("salerId", LongType.INSTANCE);
			query.addScalar("salerName");
			query.addScalar("invoiceDt", DateType.INSTANCE);
			query.addScalar("code");
			query.addScalar("tourCd");
			query.addScalar("departureDt", DateType.INSTANCE);
			query.addScalar("numOfPax", IntegerType.INSTANCE);
			query.addScalar("amount", DoubleType.INSTANCE);
			query.addScalar("amtPaid", DoubleType.INSTANCE);
			query.addScalar("balance", DoubleType.INSTANCE);
			query.setParameter("idCompany", idCompany);
			query.setParameter("statusCdCC", CommonConstant.STATUS_CD_CANCELLED);
			query.setParameter("statusCdVD", CommonConstant.STATUS_CD_VOID);
			query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			if (appSettingVO != null && StringUtils.isNotBlank(appSettingVO.getValue())) {
				List<String> excludeAcctList = Arrays.asList(appSettingVO.getValue().split(","));
				query.setParameterList("excludeAcct", excludeAcctList);
			}
			query.setResultTransformer(Transformers.aliasToBean(InvoiceVO.class));
			list = query.list();
			
		} catch (Exception e) {
			throw e;
		}
		return list;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acctreport.dao.AccountReportDAO#getCreditNoteList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<InvoiceVO> getCreditNoteList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
		List<InvoiceVO> list = new ArrayList<InvoiceVO>();
		
		try {
			sb.append("select ").
				append("c.code as custCd, ").
				append("if (c.pc_type_cd = 'C', c.corporate_name, concat(UPPER(c.salutation_cd), ' ', c.last_name, ' ', c.first_name)) as custName, ").
				append("iv.code as code, ").
//				append("ifnull(cn.cnTourCd, '') as tourCd, ").
//				append("cn.inv_no as cnInvNo, ").
//				append("if (ifnull(cn_iv.tourCd, '') != '', ifnull(cn_iv.tourCd, ''), cn_ps.tourCd) as tourCd, ").
				append("ifnull(td.code, '') AS tourCd, ").
				append("CONCAT_WS(' / ', concat(iv.cn_inv_no), concat('PS', iv.cn_ps_no)) AS cnInvNo, ").
				append("iv.dt_inv as invoiceDt, ").
				append("iv.amount ").
			append("from invoice iv ").
//				append("left join (select i.code as inv_no, t.code as cnTourCd from invoice i left join tour_dep t on i.id_tour_dep = t.id where i.id_company = :idCompany and i.doc_type_cd in ('I','P') and i.doc_type_status not in ('CV','SP')) cn on iv.cn_inv_no = cn.inv_no, ").
//				append("left join ( "). // Invoice
//					append("select i.code as invNo, t.code as tourCd, i.ps_no as psNo ").
//					append("from invoice i left join tour_dep t on i.id_tour_dep = t.id ").
//					append("where i.id_company = :idCompany and i.doc_type_cd = 'I' ").
//				append(") cn_iv on iv.doc_type_cd = 'C' and iv.cn_inv_no = cn_iv.invNo ").
//				append("left join ( "). // PS
//					append("select i.code as invNo, t.code as tourCd, ps_no as psNo ").
//					append("from invoice i left join tour_dep t on i.id_tour_dep = t.id ").
//					append("where i.id_company = :idCompany and (i.doc_type_cd = 'P' and ifnull(i.doc_type_status, '') not in ('CV','SP', 'CL')) ").
//				append(") cn_ps on iv.doc_type_cd = 'C' and iv.cn_ps_no = cn_ps.psNo, ").
			append("LEFT JOIN invoice cn_iv ").
				append("ON iv.id_company = cn_iv.id_company AND iv.doc_type_cd = 'C' AND iv.cn_inv_no IS NOT NULL AND cn_iv.code = iv.cn_inv_no AND cn_iv.doc_type_cd = 'I' ").
			append("LEFT JOIN invoice cn_ps ");
				sb.append("ON iv.id_company = cn_ps.id_company AND iv.doc_type_cd = 'C' AND iv.cn_ps_no IS NOT NULL AND cn_ps.ps_no = iv.cn_ps_no AND cn_ps.doc_type_cd = 'P' ").
			append("LEFT JOIN tour_dep td ON td.id = ifnull(cn_iv.id_tour_dep, cn_ps.id_tour_dep), ").
				append("(select cm.id, cm.code, cm.pc_type_cd, cm.corporate_name, ps.salutation_cd, ps.last_name, ps.first_name from customer cm, person ps where cm.id_pc=ps.id) c ").
			append("where iv.id_company = :idCompany and iv.id_customer = c.id and iv.doc_type_cd = 'C' and ").
				append("iv.status_cd != :statusCdCC and iv.status_cd != :statusCdVD ");
			if (searchParamVO.getObj2() != null) sb.append("and date(iv.dt_inv) >= date('" + sdf.format((Date)searchParamVO.getObj2()) + "') ");
			if (searchParamVO.getObj3() != null) sb.append("and date(iv.dt_inv) <= date('" + sdf.format((Date)searchParamVO.getObj3()) + "') ");
			sb.append("order by cast(iv.code as decimal) ");
			
			SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
			query.addScalar("custCd");
			query.addScalar("custName");
			query.addScalar("code");
			query.addScalar("tourCd");
			query.addScalar("cnInvNo");
			query.addScalar("invoiceDt", DateType.INSTANCE);
			query.addScalar("amount", DoubleType.INSTANCE);
			query.setParameter("idCompany", idCompany);
			query.setParameter("statusCdCC", CommonConstant.STATUS_CD_CANCELLED);
			query.setParameter("statusCdVD", CommonConstant.STATUS_CD_VOID);
			query.setResultTransformer(Transformers.aliasToBean(InvoiceVO.class));
			list = query.list();
			
		} catch (Exception e) {
			throw e;
		}
		return list;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acctreport.dao.AccountReportDAO#getCustomerPaymentHistory(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<ExOrderBillVO> getBillDetailBySupplier(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
		List<ExOrderBillVO> list = new ArrayList<ExOrderBillVO>();
		
		// Obj7 is condition to show GL Code in report
		try {
			sb.append("SELECT b.dt_bill as billDt, b.code as code, b.cn_no as cnNumber, b.bill_amt as billAmt, b.amt_paid as amtPaid, ").
				append("b.ex_reason as exReason, d.code as tourCode, d.dt_dep as depDt, s.id as supplierId, s.sys_no as eoCode, c.name as supplierName ");
			if (searchParamVO.getObj7() != null) sb.append(", gl_code as chequeNo ");
			sb.append("FROM ex_order_bill b ").
				append("LEFT JOIN supplier s on s.id = b.id_supplier ").
				append("LEFT JOIN person p on p.id = s.id_person ").
				append("LEFT JOIN corporate c on c.id_person = p.id ").
				append("LEFT JOIN tour_dep d on d.id = b.id_tour_dep ");
			if (searchParamVO.getObj7() != null) {
				sb.append("LEFT JOIN ( ").
					append("SELECT t.sys_no, GROUP_CONCAT(DISTINCT if(a.sub_code != '', CONCAT(a.code, '-', a.sub_code), a.code) SEPARATOR ', ') as gl_code ").
					append("from account_trans t left join account a on a.id = t.id_acct ").
					append("where t.id_company = :idCompany and t.sys_cd = 'purc_bill' and t.status_cd = 'A' and t.id_ref is not null ").
					append("group by t.sys_cd, t.sys_no ").
				append(") a on a.sys_no = b.code ");
			}
			sb.append("WHERE ").
				append("b.id_company = :idCompany ");
			if (searchParamVO.getObj2() != null) sb.append("and date(b.dt_bill) >= date('" + sdf.format((Date)searchParamVO.getObj2()) + "') ");
			if (searchParamVO.getObj3() != null) sb.append("and date(b.dt_bill) <= date('" + sdf.format((Date)searchParamVO.getObj3()) + "') ");
			if (searchParamVO.getObj4() != null) sb.append("and date(d.dt_dep) >= date('" + sdf.format((Date)searchParamVO.getObj4()) + "') ");
			if (searchParamVO.getObj5() != null) sb.append("and date(d.dt_dep) <= date('" + sdf.format((Date)searchParamVO.getObj5()) + "') ");
			if (searchParamVO.getObj6() != null) sb.append("and b.id_supplier = :supplierId ");
				sb.append("and b.status_cd not in (:statusCdCC, :statusCdVD) ").
			append("order by cast(s.sys_no as decimal), cast(b.code as decimal)");
				
			System.out.println(sb.toString());
			
			SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
			query.addScalar("billDt", DateType.INSTANCE);
			query.addScalar("code");
			query.addScalar("cnNumber");
			query.addScalar("billAmt", DoubleType.INSTANCE);
			query.addScalar("amtPaid", DoubleType.INSTANCE);
			query.addScalar("exReason");
			query.addScalar("tourCode");
			query.addScalar("depDt", DateType.INSTANCE);
			query.addScalar("supplierId", LongType.INSTANCE);
			query.addScalar("eoCode");
			query.addScalar("supplierName");
			if (searchParamVO.getObj7() != null) query.addScalar("chequeNo");
			query.setParameter("idCompany", idCompany);
			query.setParameter("statusCdCC", CommonConstant.STATUS_CD_CANCELLED);
			query.setParameter("statusCdVD", CommonConstant.STATUS_CD_VOID);
			if (searchParamVO.getObj6() != null) {
				query.setParameter("supplierId", (Long) searchParamVO.getObj6());
			}
			query.setResultTransformer(Transformers.aliasToBean(ExOrderBillVO.class));
			list = query.list();
			
		} catch (Exception e) {
			throw e;
		}
		return list;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acctreport.dao.AccountReportDAO#getCustomerPaymentHistory(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<ExOrderBillVO> getBillUnpaidDetailBySupplier(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
		List<ExOrderBillVO> list = new ArrayList<ExOrderBillVO>();
		
		// Obj7 is condition to show GL Code in report
		try {
			sb.append("SELECT b.dt_bill as billDt, b.code as code, b.cn_no as cnNumber, b.bill_amt as billAmt, b.amt_paid as amtPaid, b.bill_amt - b.amt_paid as curBal, ").
				append("b.ex_reason as exReason, d.code as tourCode, d.dt_dep as depDt, s.id as supplierId, s.sys_no as eoCode, c.name as supplierName ");
			if (searchParamVO.getObj7() != null) sb.append(", gl_code as chequeNo ");
			sb.append("FROM ex_order_bill b ").
				append("LEFT JOIN supplier s on s.id = b.id_supplier ").
				append("LEFT JOIN person p on p.id = s.id_person ").
				append("LEFT JOIN corporate c on c.id_person = p.id ").
				append("LEFT JOIN tour_dep d on d.id = b.id_tour_dep ");
			if (searchParamVO.getObj7() != null) {
				sb.append("LEFT JOIN ( ").
					append("SELECT t.sys_no, GROUP_CONCAT(DISTINCT if(a.sub_code != '', CONCAT(a.code, '-', a.sub_code), a.code) SEPARATOR ', ') as gl_code ").
					append("from account_trans t left join account a on a.id = t.id_acct ").
					append("where t.id_company = :idCompany and t.sys_cd = 'purc_bill' and t.status_cd = 'A' and t.id_ref is not null ").
					append("group by t.sys_cd, t.sys_no ").
				append(") a on a.sys_no = b.code ");
			}
			sb.append("WHERE ").
				append("b.id_company = :idCompany ");
			if (searchParamVO.getObj2() != null) sb.append("and date(b.dt_bill) >= date('" + sdf.format((Date)searchParamVO.getObj2()) + "') ");
			if (searchParamVO.getObj3() != null) sb.append("and date(b.dt_bill) <= date('" + sdf.format((Date)searchParamVO.getObj3()) + "') ");
			if (searchParamVO.getObj4() != null) sb.append("and date(d.dt_dep) >= date('" + sdf.format((Date)searchParamVO.getObj4()) + "') ");
			if (searchParamVO.getObj5() != null) sb.append("and date(d.dt_dep) <= date('" + sdf.format((Date)searchParamVO.getObj5()) + "') ");
			if (searchParamVO.getObj6() != null) sb.append("and b.id_supplier = :supplierId ");
				sb.append("and b.status_cd not in (:statusCdCC, :statusCdVD) ").
			append("order by cast(s.sys_no as decimal), cast(b.code as decimal)");
			
			SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
			query.addScalar("billDt", DateType.INSTANCE);
			query.addScalar("code");
			query.addScalar("cnNumber");
			query.addScalar("billAmt", DoubleType.INSTANCE);
			query.addScalar("amtPaid", DoubleType.INSTANCE);
			query.addScalar("curBal", DoubleType.INSTANCE);
			query.addScalar("exReason");
			query.addScalar("tourCode");
			query.addScalar("depDt", DateType.INSTANCE);
			query.addScalar("supplierId", LongType.INSTANCE);
			query.addScalar("eoCode");
			query.addScalar("supplierName");
			if (searchParamVO.getObj7() != null) query.addScalar("chequeNo");
			query.setParameter("idCompany", idCompany);
			query.setParameter("statusCdCC", CommonConstant.STATUS_CD_CANCELLED);
			query.setParameter("statusCdVD", CommonConstant.STATUS_CD_VOID);
			if (searchParamVO.getObj6() != null) {
				query.setParameter("supplierId", (Long) searchParamVO.getObj6());
			}
			query.setResultTransformer(Transformers.aliasToBean(ExOrderBillVO.class));
			list = query.list();
			
		} catch (Exception e) {
			throw e;
		}
		return list;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.acctreport.dao.AccountReportDAO#getSupplierList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<SupplierVO> getSupplierList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		List<SupplierVO> list = new ArrayList<SupplierVO>();
		
		try {
			sb.append("SELECT ").
				append("sys_no, salutation_cd, firstname, lastname, email, corporate, ").
				append("(SELECT GROUP_CONCAT(CONCAT(type_cd, ': ', number) separator ', ') FROM corporate_contact WHERE id_corporate = A.id_corporate AND status_cd = :statusCd) AS 'corContacts', ").
				append("(SELECT CONCAT_WS(' ', ").
				append("if(addr_1 = '', null, addr_1), if(addr_2 = '', null, addr_2), if(addr_3 = '', null, addr_3), ").
				append("if(city = '', null, city), if(state = '', null, state), if(postcode = '', null, postcode), ").
				append("if(c.name = '', null, c.name)) FROM corporate_address pa left join country c on c.id = pa.id_country WHERE id_corporate = A.id_corporate) AS 'corAddress' ").
			append("FROM (SELECT ").
				append("o.id as id_corporate, s.sys_no, ").
				append("p.salutation_cd as salutation_cd, IFNULL(p.first_name, '') as firstname, IFNULL(p.last_name, '') as lastname, ").
				append("p.email as email, o.name AS 'corporate' ").
				append("FROM supplier s ").
				append("left join person p on s.id_person = p.id ").
				append("left join corporate o on o.id_person = p.id ").
				append("WHERE s.id_company = :idCompany and s.status_cd = :statusCd ");
			if (searchParamVO.getObj4() != null) {
				sb.append("AND s.type_cd = '" + ((String) searchParamVO.getObj4()) + "' ");
			}
			sb.append(") A order by ");
			if (StringUtils.isNotEmpty(searchParamVO.getObj7().toString())) {
				if (searchParamVO.getObj7().toString().equals("SuN")) {
					sb.append("corporate ");
				} else {
					sb.append("cast(sys_no as decimal) ");
				}
			} else {
				sb.append("cast(sys_no as decimal) ");
			}
			sb.append("asc ");
			
			Query query = createSQLQuery(sb.toString());
			query.setParameter("idCompany", idCompany);
			query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			List<Object> objList = query.list();
			
			if (CollectionUtils.isNotEmpty(objList)) {
				for (Iterator<Object> it = objList.iterator() ; it.hasNext() ;) {
					Object[] row = (Object[]) it.next();
					SupplierVO vo = new SupplierVO();
					vo.setSupplierNo((String) row[0]);
					vo.setSalutation((String) row[1]);
					vo.setGivenName((String) row[2]);
					vo.setLastName((String) row[3]);
					vo.setFullName(vo.getSalutation().toUpperCase() + " " + vo.getLastName() + " " + vo.getGivenName());
					vo.setEmail((String) row[4]);
					vo.setCompanyName((String) row[5]);
					vo.setContactNo((String) row[6]);
					vo.setAdd1((String) row[7]);
					if (vo.getContactNo() != null) {
						vo.setContactNo(vo.getContactNo()
							.replace("mobile", LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "mobile"))
							.replace("office",  LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "office"))
							.replace("home",  LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "home"))
							.replace("fax",  LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "fax")));
					}
					if (StringUtils.isEmpty(vo.getEmail())) {
						vo.setEmail(vo.getContactNo());
					} else if (StringUtils.isEmpty(vo.getContactNo())) {
						
					} else {
						vo.setEmail(vo.getEmail() + ", " + vo.getContactNo());
					}
					list.add(vo);
				}
			}
		} catch (Exception e) {
			throw e;
		}
		
		return list;
	}

	@SuppressWarnings("unchecked")
	@Override
	public List<CashBookVO> getBankPaymentByPayeeList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
		List<CashBookVO> list = new ArrayList<CashBookVO>();
		
		try {
			sb.append("SELECT b.id as idBank, b.name as bankName, c.id_supplier as idSupplier, c.payee, ").
				append("c.dt_trans as dtTrans, c.sys_no as sysNo, c.credit, c.ref_no as refNo, c.remarks ").
			append("FROM cash_book c ").
				append("LEFT JOIN bank b ON b.id = c.id_bank ").
				append("LEFT JOIN supplier s ON s.id = c.id_supplier ").
			append("WHERE c.sys_cd = :sysCode AND c.status_cd = :statusCd AND b.id_company = :idCompany ");
			if (searchParamVO.getObj2() != null) sb.append("and date(c.dt_trans) >= date('" + sdf.format((Date)searchParamVO.getObj2()) + "') ");
			if (searchParamVO.getObj3() != null) sb.append("and date(c.dt_trans) <= date('" + sdf.format((Date)searchParamVO.getObj3()) + "') ");
			if (searchParamVO.getObj4() != null) sb.append("AND c.id_supplier = " + ((Long) searchParamVO.getObj4()) + " ");
			if (searchParamVO.getObj5() != null) sb.append("AND s.type_cd = '" + ((String) searchParamVO.getObj5()) + "' ");
			if (searchParamVO.getObj6() != null) sb.append("AND c.id_bank = ").append((Long) searchParamVO.getObj6()).append(" ");
			sb.append("ORDER BY b.id, b.name, c.id_supplier, c.payee, c.dt_trans desc ");
			
			SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
			query.addScalar("idBank", LongType.INSTANCE);
			query.addScalar("bankName");
			query.addScalar("idSupplier", LongType.INSTANCE);
			query.addScalar("payee");
			query.addScalar("dtTrans", DateType.INSTANCE);
			query.addScalar("sysNo");
			query.addScalar("credit", DoubleType.INSTANCE);
			query.addScalar("refNo");
			query.addScalar("remarks");
			query.setParameter("idCompany", idCompany);
			query.setParameter("sysCode", CommonConstant.SYS_NUM_CD_BANK_PMNT);
			query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			
			query.setResultTransformer(Transformers.aliasToBean(CashBookVO.class));
			list = query.list();
			
		} catch (Exception e) {
			throw e;
		}
		return list;
	}
	
