	@Override
	public void updInvoicePax(AddUpdDelVO invoicePaxAUDVO) throws BusinessException {
		// update tour dep item
		if (CollectionUtils.isNotEmpty(invoicePaxAUDVO.getUpdList())) {
			for (Object obj : invoicePaxAUDVO.getUpdList()) invoiceService.updateVO((InvoicePaxVO) obj);
		} 
	}

