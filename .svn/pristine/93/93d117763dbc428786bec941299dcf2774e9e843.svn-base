package com.bcs.zsg.cfg.sec.helper;

import java.util.Comparator;

import com.bcs.zsg.cfg.sec.vo.EmployeeViewVO;

public class EmployeeNameComparator implements Comparator<EmployeeViewVO> {
    @Override
    public int compare(EmployeeViewVO o1, EmployeeViewVO o2) {
        return o1.getUserVO().getName().compareTo(o2.getUserVO().getName());
    }
}

