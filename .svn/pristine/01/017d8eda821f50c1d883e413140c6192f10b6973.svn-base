<p:dataTable widgetVar="varCustListTable" value="#{custBean.lazyCustDataModel}" var="vo" paginator="true" rows="10" 
	paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
	filterEvent="enter" lazy="true" rowKey="#{vo.id}" selectionMode="single" rowStyleClass="#{(vo.classes.contains('BLACKLISTED') and !tourPkgBean.enableBlackListed) ? 'disabled' : ''}">
	<p:ajax event="rowSelect" listener="#{tourPkgBean.handleCustSelect}" update=":idAddInvoiceForm:idCustDetails" oncomplete="varCustListDialog.hide();" process="@this"/>
	
	<p:column headerText="Customer&lt;br/&gt;Type" sortBy="#{vo.pcTypeDesc}" filterBy="#{vo.pcTypeDesc}" filterStyle="width: 90%" width="80">
		<h:outputText value="#{vo.pcTypeDesc}" />
	</p:column>
	
	<p:column headerText="Customer No" sortBy="#{vo.code}" filterBy="#{vo.code}">
		<h:outputText value="#{vo.code}" />
	</p:column>
	
	<p:column headerText="Customer Name" sortBy="#{vo.custName}" filterBy="#{vo.custName}" filterMatchMode="contains">
		<h:outputText value="#{bterp:lookupItemDesc('salutatn', vo.salutationCd)} #{vo.custName}" style="#{vo.classes.contains('BLACKLISTED')? 'color:red;font-weight:bold;': ''}"/>
		<p:outputLabel id="idRemarks" rendered="#{not empty vo.classes or not empty vo.remarks}">
			<i class="fa fa-info-circle" />
		</p:outputLabel>
		<pe:tooltip for="idRemarks">
		    <h:panelGrid>
		        <h:outputText value="Class: #{vo.classes}" />
		        <h:outputText value="Note: #{vo.remarks}" escape="false" style="white-space: pre-wrap;"/>
		    </h:panelGrid>
		</pe:tooltip>
	</p:column>
	
	<p:column headerText="NickName" sortBy="#{vo.nickName}" filterBy="#{vo.nickName}" filterMatchMode="contains">
		<h:outputText value="#{vo.nickName}" />
	</p:column>
	
	<p:column headerText="Company Name" sortBy="#{vo.corporateName}" filterBy="#{vo.corporateName}" filterMatchMode="contains">
		<h:outputText value="#{vo.corporateName}"/>
	</p:column>
	
	<p:column headerText="Contact" sortBy="#{vo.fullPhoneNo}" filterBy="#{vo.fullPhoneNo}">
        <ui:repeat value="#{vo.fullPhoneNo.split(',')}" var="cntc" rendered="#{not empty vo.fullPhoneNo}">
            <h:outputText value="#{custBean.getContactStr(cntc)}"/><br/>
        </ui:repeat>
	</p:column>
	
	<p:column headerText="Identity" sortBy="#{vo.identities}" filterBy="#{vo.identities}" filterMatchMode="contains">
        <ui:repeat value="#{vo.identities.split(',')}" var="identity" rendered="#{not empty vo.identities}">
            <h:outputText value="#{custBean.getIdentityStr(identity)}"/><br/>
        </ui:repeat>
	</p:column>
</p:dataTable>

<h:panelGrid columns="2" style="width:1px;">
	<p:commandButton value="#{msg['common.button.label.cancel']}" onclick="varCustListDialog.hide()"/>
	<p:selectBooleanCheckbox itemLabel="Enable Blacklisted Customer" value="#{tourPkgBean.enableBlackListed}" rendered="#{salesInvBean.docTypeCd ne 'C'}" style="width:400px; margin-left:10px; margin-top:5px; display: flex; align-items: center; font-weight: bold;">
   		<p:ajax event="change" update="idCustListForm"/>	
	</p:selectBooleanCheckbox>
</h:panelGrid>
</ui:composition>