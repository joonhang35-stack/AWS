#################
# Schedule Time #	
#################
# Enable or disable scheduler
# Default = 'true' for enable, 'false' to close
# To control the on and off of scheduler
sys.schedule.pos.enable=false

# To control the on and off of email payment expiry scheduler checking
sys.schedule.emailpayment.expiry.enable=false

#Default scheduled 30 min  0 0/30 * * * ?, 10 second 0/10 * * * * ?
#If want to change the execution time, please go to http://www.cronmaker.com/ for the cron setting
sys.schedule.ScheduleManager.timeMinute=0 0/30 * * * ?
sys.schedule.ScheduleManager.dailyTime=0 0 0 1/1 * ?
sys.schedule.ScheduleManager.monthlyTime=0 0 0 1 1/1 ?
sys.schedule.ScheduleManager.yearlyTime=0 0 1 1 1 ?


