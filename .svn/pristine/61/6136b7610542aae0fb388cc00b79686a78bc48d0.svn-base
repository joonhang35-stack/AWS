<!-- Password Reset Title Banner Section (Connects directly under top logo) -->
<table class="row" style="width:100%; border-collapse:collapse; border-spacing:0; background-color: #7c51a1; background: linear-gradient(135deg, #7c51a1 0%, #5e3c7d 100%); text-align: center; margin:0; padding:0;">
  <tbody>
    <tr>
      <td style="padding: 0px 30px 35px 30px; text-align: center;">
        <table role="presentation" align="center" cellpadding="0" cellspacing="0" style="margin: 0 auto;">
          <tr>
            <td style="background-color: rgba(255, 255, 255, 0.2); border-radius: 50%; width: 44px; height: 44px; text-align: center; vertical-align: middle;">
              <span style="font-size: 22px; line-height: 44px;">&#128273;</span>
            </td>
            <td style="padding-left: 14px; font-size: 26px; font-weight: 700; color: #ffffff; font-family: Arial, Helvetica, sans-serif; letter-spacing: 0.5px; vertical-align: middle;">
              Password Reset
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </tbody>
</table>

<!-- Main Content Area -->
<table class="row" style="width:100%; border-collapse:collapse; border-spacing:0; background-color: #ffffff; font-family: Arial, Helvetica, sans-serif; margin:0; padding:0;">
  <tbody>
    <tr>
      <td style="padding: 40px 40px 32px 40px;">
        
        <!-- Greeting Paragraph -->
        <p style="margin: 0 0 8px 0; font-size: 16px; color: #222222; line-height: 1.5; font-family: Arial, Helvetica, sans-serif;">
          Dear <strong>${(userName)!''}</strong> (${(userId)!''}),
        </p>

        <!-- Body Text Paragraph -->
        <p style="margin: 0; font-size: 15px; color: #444444; line-height: 1.6; font-family: Arial, Helvetica, sans-serif;">
          A request was made to reset/update the password on your ERP/AWS account. Please click the button below to proceed.
        </p>

        <!-- Reset Password Pill Button -->
        <table role="presentation" align="center" cellpadding="0" cellspacing="0" style="margin: 32px auto 36px auto;">
          <tr>
            <td align="center">
              <a href="${(url)!''}" target="_blank" style="display: inline-block; background-color: #7c51a1; color: #ffffff; font-size: 15px; font-weight: 600; font-family: Arial, Helvetica, sans-serif; text-decoration: none; padding: 14px 36px; border-radius: 50px; box-shadow: 0 4px 12px rgba(124, 81, 161, 0.35); letter-spacing: 0.5px;">
                RESET PASSWORD
              </a>
            </td>
          </tr>
        </table>

        <!-- Important Notice (White Background, Full Width of Content Area) -->
        <div style="background-color: #ffffff; margin-top: 25px; margin-bottom: 10px;">
          <p style="margin: 0; font-size: 14px; color: #888888; font-family: Helvetica, Arial, sans-serif; line-height: 1.6;">
            <span style="background-color: #fff9C4; color: #888888; padding: 2px 6px; border-radius: 3px; font-size: 13.5px;">Important: This link will expire in 24 hours.</span>
            If you did not request a password reset, no action is needed &mdash; your account remains secure.
          </p>
        </div>

      </td>
    </tr>
  </tbody>
</table>

<!-- Full Width Bottom Footer -->
<table class="row" style="width:100%; border-collapse:collapse; border-spacing:0; background-color: #f8fafc; font-family: Arial, Helvetica, sans-serif; margin:0; padding:0; border-top: 1px solid #e2e8f0;">
  <tbody>
    <tr>
      <td style="padding: 24px 40px; text-align: center;">
        <p style="margin: 0 0 4px 0; font-size: 13px; color: #888888; line-height: 1.5; font-family: Arial, Helvetica, sans-serif;">
          This is an automated message &mdash; please do not reply.
        </p>
        <p style="margin: 0; font-size: 13px; color: #888888; line-height: 1.5; font-family: Arial, Helvetica, sans-serif;">
          Need help? Please contact IT Support
        </p>
      </td>
    </tr>
  </tbody>
</table>
