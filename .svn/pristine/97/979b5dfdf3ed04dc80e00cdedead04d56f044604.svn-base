package com.bcs.zsg.sales.vo;

import com.bcs.zsg.core.vo.BaseVO;

public class InvoiceReferenceVO extends BaseVO {
	private static final long serialVersionUID = 1L;
	
	private Long invId;
	private Long invRefId;
	private String invRefCode;
	private String docTypeCd;
	
	public String getDocTypeCd() {
		return docTypeCd;
	}

	public void setDocTypeCd(String docTypeCd) {
		this.docTypeCd = docTypeCd;
	}

	public Long getInvId() {
		return invId;
	}
	
	public void setInvId(Long invId) {
		this.invId = invId;
	}
	
	public Long getInvRefId() {
		return invRefId;
	}
	
	public void setInvRefId(Long invRefId) {
		this.invRefId = invRefId;
	}
	
	public String getInvRefCode() {
		return invRefCode;
	}
	
	public void setInvRefCode(String invRefCode) {
		this.invRefCode = invRefCode;
	}
}
