<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.bank.vo">

    <class table="cash_book" name="CashBookVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idBank" type="long" column="id_bank"/>
        <property name="idSupplier" type="long" column="id_supplier"/>
        <property name="idCustomer" type="long" column="id_customer"/>
        <property name="tourDepId" type="long" column="id_tour_dep"/>
        <property name="dtTrans" type="timestamp" column="dt_trans"/>
        <property name="sysCode" type="string" column="sys_cd"/>
        <property name="sysPrefix" type="string" column="sys_prefix"/>
        <property name="sysNo" type="string" column="sys_no"/>
        <property name="refNo" type="string" column="ref_no"/>
        <property name="transTypeCd" type="string" column="trans_type_cd"/>
        <property name="payee" type="string" column="payee"/>
        <property name="debit" type="double" column="debit"/>
        <property name="credit" type="double" column="credit"/>
        <property name="isClear" type="boolean" column="is_clear"/>
        <property name="isMark" type="boolean" column="is_mark"/>
        <property name="dtClear" type="timestamp" column="dt_clear"/>
        <property name="dtMark" type="timestamp" column="dt_mark"/>
        <property name="typeCd" type="string" column="type_cd"/>
        <property name="groupNo" type="string" column="group_no"/>
        <property name="taxCodeGroup" type="string" column="tax_code_group"/>
        <property name="invoices" type="string" column="invoices"/>
        
        <!-- BaseVO attributes -->
        <property name="remarks" type="string" column="remarks"/>
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>