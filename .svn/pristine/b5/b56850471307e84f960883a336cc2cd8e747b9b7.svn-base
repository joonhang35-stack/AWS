<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="bankadjustment_form">
	
	<!-- backing bean, extends com.bcs.zsg.component.common.web.swf.bean.AppBackingBean -->
	<var name="bankAdjustmentBean" class="com.bcs.zsg.bank.web.bean.BankAdjustmentBean"/>
	<var name="acctBean" class="com.bcs.zsg.acct.web.bean.AccountBean"/>
	
	<view-state id="bankadjustment_form">
		<on-entry>
			<evaluate expression="bankAdjustmentBean.init()"/>
			<evaluate expression="acctBean.init(0, false)"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>