<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.db.bterp.vo.gst">
	<class table="gst_summary_tax" name="GSTSummaryTaxVO" polymorphism="explicit">
		<id name="id" type="long" column="id">
            <generator class="identity"/>
        </id>
        <property name="idGSTSummary" type="long" column="id_gst_summary"/>
        <property name="taxCode" type="string" column="tax_code"/>
		<property name="amount" type="double" column="amount"/>
		<property name="rate" type="double" column="rate"/>
		<property name="taxAmount" type="double" column="tax_amount"/>
		
		<!-- BaseVO attributes -->
		
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_update"/>
		<property name="updatedBy" type="string" column="updated_by"/>
		
	</class>
</hibernate-mapping>