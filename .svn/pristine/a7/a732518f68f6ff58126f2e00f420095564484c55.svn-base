	/**
	 * On selected invoice for credit note
	 */
	public void handleCNInvoiveSelect(SelectEvent event) throws BusinessException{
		try {
			InvoiceVO vo = (InvoiceVO) event.getObject(); 
			invoiceVO.setCnInv(vo);
//			System.out.println("CYY vo.getDocTypeCd():" + vo.getDocTypeCd());
//			System.out.println("CYY vo.getPsNo():" + vo.getPsNo());
//			System.out.println("CYY vo.getCode():" + vo.getCode());
			if (StringUtils.isNotBlank(vo.getDocTypeCd())) {
				if (vo.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_PAX_STMT)) {
					invoiceVO.setCnPsNo(vo.getPsNo());
					invoiceVO.setCnInvNo(null); // when ps selected, clear cn_inv to clear previous selected value
					invoiceVO.setCnDocNoForDisplay(vo.getPsNo());				
				} else if (vo.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_INVC)) {
					if (StringUtils.isNotBlank(vo.getPsNo())) {
						invoiceVO.setCnPsNo(vo.getPsNo());
					} else {
						invoiceVO.setCnPsNo(null); // when inv selected, clear cn_ps to clear previous selected value
					}
					invoiceVO.setCnInvNo(vo.getCode());
					invoiceVO.setCnDocNoForDisplay(vo.getCode());	
				} else {
					throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null,
							FunctionUtils.generateArrayFromStr("Invalid doc type code \"" + vo.getDocTypeCd() + "\""));
				}
			} else {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Document does not have a doc type code."));
			}
			
			invoiceVO.setSalerId(vo.getSalerId());
			invoiceVO.setSalerName(getUserName(vo.getSalerId()));
			invoiceVO.setInvPmntId(vo.getInvPmntId());
			
			List<InvoiceItemVO> invItemList = invoiceBO.getInvItemList(vo);
			
			invoiceVO.setInvoiceItemList(new ArrayList<InvoiceItemVO>());
			for (InvoiceItemVO itemVO : invItemList) {
				itemVO.setId(null);
				if (!addEdit) {
					itemVO.setInvId(invoiceVO.getId());
				}
				itemVO.setCreatedBy(null);
				itemVO.setCreatedDate(null);
				itemVO.setUpdatedBy(null);
				itemVO.setUpdatedDate(null);
				
				if (!GSTPeriod) {
					itemVO.setTaxCode(null);
					itemVO.setTaxRate(null);
					if (itemVO.getAmount() != null && itemVO.getTaxAmount() != null) {
						BigDecimal taxInclAmt = (new BigDecimal(String.valueOf(itemVO.getAmount()))).add(new BigDecimal(String.valueOf(itemVO.getTaxAmount())));
						itemVO.setAmount(taxInclAmt.doubleValue());
					}
					
					itemVO.setTaxAmount(0.00);
				}
				
				invoiceVO.getInvoiceItemList().add(itemVO);
			}
			
			List<InvoicePaymentVO> invPmntList = invoiceBO.getInvPmntList(vo);
			
			invoiceVO.setInvoicePaymentList(new ArrayList<InvoicePaymentVO>());
			for (InvoicePaymentVO pmntVO : invPmntList) {
				if (vo.getInvPmntId().equals(pmntVO.getId())) {
					pmntVO.setId(null);
					pmntVO.setCode(null);
					pmntVO.setPmntDt(invoiceVO.getInvoiceDt());
					pmntVO.setPmntFor(null);
					pmntVO.setIssuerId(invoiceVO.getIssuerId());
					pmntVO.setAmount(pmntVO.getAmount());
					if (custDetailsVO.getCustType() != null) {
						if (custDetailsVO.getCustType().equals("P")) {
							pmntVO.setRecievedFr(custDetailsVO.getContPersonName());
						} else if (custDetailsVO.getCustType().equals("C")) {
							pmntVO.setRecievedFr(custDetailsVO.getCompanyName());
						}
					}
					if (!addEdit) pmntVO.setInvId(invoiceVO.getId());
					invoiceVO.getInvoicePaymentList().add(pmntVO);
				}
			}
			
			//calTtlAmt();
			calTtlAmt(null, false);
			
			// Set Customer Info
			CustDetailsVO custVO = invoiceBO.getCustDetails(vo.getCustomerId());
			invoiceVO.setCustomerId(custVO.getCustId());
			setCustDetailsVO(custVO);
			invoiceVO.setCustDetailsVO(custVO);
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
