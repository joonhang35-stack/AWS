	private void loadAuthority() throws BusinessException {
		List<UserRoleViewVO> userRoleList = securityBO.getUserRoleListByUser(this.getSessionInfoBean().getUserVO().getUuid());
		EmployeeVO employeeVO = getSessionInfoBean().getEmployeeVO();
		String department = employeeVO.getDepartment();
		
		invPmntAuthVO = new InvPmntAuthVO();
		if (CollectionUtils.isNotEmpty(userRoleList)) {
			for (UserRoleViewVO userRoleVO : userRoleList) {
				if (userRoleVO.getRoleCode().equals(SalesConstant.INVOICE_PMNT_ROLE_ADD)) {
					invPmntAuthVO.setPmntAdd(true);
				} else if (userRoleVO.getRoleCode().equals(SalesConstant.INVOICE_PMNT_ROLE_UPD)) {
					invPmntAuthVO.setPmntUpd(true);
				} else if (userRoleVO.getRoleCode().equals(SalesConstant.INVOICE_PMNT_ROLE_DEL)) {
					invPmntAuthVO.setPmntDel(true);
				} else if (userRoleVO.getRoleCode().equals(SalesConstant.USE_TRVL_WRRNT_ROLE)) {
					invPmntAuthVO.setUseTrvlWrrnt(true);
				} else if (userRoleVO.getRoleCode().equals(SalesConstant.INV_SALES_PERSON_ROLE)) {
					invPmntAuthVO.setSalesPerson(true);
				} else if (userRoleVO.getRoleCode().equalsIgnoreCase(SalesConstant.ACCT_MANAGER_ROLE)) {
					invPmntAuthVO.setAccountManager(true);
					invPmntAuthVO.setAccountRole(true);
				} else if (StringUtils.equalsIgnoreCase(userRoleVO.getRoleCode(), SalesConstant.ACCT_EXEC_ROLE) || 
						StringUtils.equalsIgnoreCase(userRoleVO.getRoleCode(), SalesConstant.ACCT_ASST_ROLE)) {
					invPmntAuthVO.setAccountRole(true);
				} else if (StringUtils.equalsIgnoreCase(userRoleVO.getRoleCode(), SalesConstant.SUPER_USER_ROLE) 
						|| StringUtils.equalsIgnoreCase(userRoleVO.getRoleCode(), SalesConstant.E_INV_SUBMIT)) {
					invPmntAuthVO.seteInvoice(true);
				}
			}
		}
		
		if (StringUtils.equals(department, MaintConstant.DEPT_TYPE_FINANCE)) {
			invPmntAuthVO.setInReviewStmt(true);
		}
		if (StringUtils.equals(department, MaintConstant.DEPT_TYPE_ACCT) || StringUtils.equals(department, MaintConstant.DEPT_TYPE_FINANCE)) {
			invPmntAuthVO.seteInvoice(true);
		}
	}
	
	/**
	 * Verify if the document is already attached to another CN to prevent multiple CNs from referencing the same document.
	 * 
	 * @param action - CommonConstant.ACTION_CD_ADD / CommonConstant.ACTION_CD_UPD
	 * @param oriVO - null if action = CommonConstant.ACTION_CD_ADD
	 * @param currentVO
	 * @throws BusinessException
	 */
	private void checkDocAttachedCN(String action, InvoiceVO oriVO, InvoiceVO currentVO) throws BusinessException {
		if (CommonConstant.ACTION_CD_ADD.equals(action)) {
			InvoicePaymentVO paymentVO = invoiceBO.getInvPaymentById(invoiceVO.getInvPmntId());
			if (paymentVO.getCreditNoteId() != null) {
				throw new BusinessException(CommonErrConstant.ERR_CN_ATTACHED_DOC);
			}
		} else if (CommonConstant.ACTION_CD_UPD.equals(action)) {
			if (invoiceVO.getInvPmntId().equals(oriVO.getInvPmntId())) {
				// if equals, mean didn't change
				// didn't change = no need check?
			} else {
				// if not equals, mean user changed attached doc
				InvoicePaymentVO paymentVO = invoiceBO.getInvPaymentById(invoiceVO.getInvPmntId());
				if (paymentVO.getCreditNoteId() != null) {
					throw new BusinessException(CommonErrConstant.ERR_CN_ATTACHED_DOC);
				}
			}
		}
	}

	/**
	 * Add invoice
	 */
	public void addInvoice() {
		try {
			
			// check financial closed / GST submitted
			checkFinGSTClosed(CommonConstant.ACTION_CD_ADD, null, invoiceVO.getInvoiceDt(), invPmntAuthVO.isAccountManager());
			// check if document already attached to another CN
			checkDocAttachedCN(CommonConstant.ACTION_CD_ADD, null, invoiceVO);
			
			if (invoiceVO.getBookingId() != null && invoiceVO.getBookingId() == 0) invoiceVO.setBookingId(null);
			
			if (custDetailsVO.getContPersonName() == null) {
				throw new BusinessException(CommonErrConstant.ERR_INV_CUST_REQUIRED);
			} else if (invoiceVO.getInvoiceItemList().size() == 0) {
				throw new BusinessException(CommonErrConstant.ERR_INV_ITEM_REQUIRED, null, new String[]{docTypeDesc});
			} else if (invoiceVO.getBalance() != 0) {
				throw new BusinessException(CommonErrConstant.ERR_CN_AMT_DUE_ZERO);
			} else {
				// if there is credit note
				// set credit note default value
				setCreditNote(); 
				
				calTtlAmt();
				invoiceBO.insertInvoice(invoiceVO, invoiceVO.getTourDepId());
				try {
					invoiceBO.updInvCd(invoiceVO);
				} catch (Exception e) {
					errorResult(e);
					e.printStackTrace();
				}
				
				try {
//					if (StringUtils.isEmpty(invoiceVO.getRnNo())) invoiceBO.updRfndNoteCd(invoiceVO);
//					if (StringUtils.isEmpty(invoiceVO.getRnNo()) && invoiceVO.getRefundAmt() != null && invoiceVO.getRefundAmt() != 0.0) invoiceBO.updRfndNoteCd(invoiceVO);

				} catch (Exception e) {
					errorResult(e);
					e.printStackTrace();
				}
				
				onInvoiceSelected(invoiceVO);
				
				successResult();
			}
			
			//if (msg != null) FacesContext.getCurrentInstance().addMessage(null, msg);
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	/**
	 * Edit invoice
	 */
	public void updateInvoice() {
		TrackingLogUtils trackingLogUtils = new TrackingLogUtils(getClass());
		try {
			InvoiceVO oriVO = (InvoiceVO) getOriObj();
			
			// check financial closed / GST submitted
			checkFinGSTClosed(CommonConstant.ACTION_CD_UPD, oriVO.getInvoiceDt(), invoiceVO.getInvoiceDt(), invPmntAuthVO.isAccountManager());
			// check if document already attached to another CN
			checkDocAttachedCN(CommonConstant.ACTION_CD_UPD, oriVO, invoiceVO);
			
			if (invoiceVO.getBookingId() != null && invoiceVO.getBookingId() == 0) invoiceVO.setBookingId(null);
			
			if (invoiceVO.getStatusCd().equals(CommonConstant.STATUS_CD_VOID) || invoiceVO.getStatusCd().equals(CommonConstant.STATUS_CD_CANCELLED)) {
				throw new BusinessException(CommonErrConstant.ERR_INV_VOIDED);
			} else if (custDetailsVO.getContPersonName() == null) {
				throw new BusinessException(CommonErrConstant.ERR_INV_CUST_REQUIRED);
			} else if (invoiceVO.getInvoiceItemList().size() == 0) {
				throw new BusinessException(CommonErrConstant.ERR_INV_ITEM_REQUIRED, null, new String[]{docTypeDesc});
			} else if (invoiceVO.getBalance() != 0) {
				throw new BusinessException(CommonErrConstant.ERR_CN_AMT_DUE_ZERO);
			} else {
				InvoiceVO currentInvVO = invoiceBO.getInvoiceById(invoiceVO.getId());
				if (currentInvVO.getVersion() > invoiceVO.getVersion()) throw new BusinessException(CommonErrConstant.ERR_INV_NOT_LATEST_VERSION);
				
				calTtlAmt();
				trackingLogUtils.startLogs();
				invoiceBO.updateInvoice(invoiceVO, invoiceVO.getTourDepId());
				trackingLogUtils.endLogs("invoiceBO.updateInvoice");
				trackingLogUtils.startLogs();
				
				try {
//					if (StringUtils.isEmpty(invoiceVO.getRnNo())) invoiceBO.updRfndNoteCd(invoiceVO);
					if (StringUtils.isEmpty(invoiceVO.getRnNo()) && invoiceVO.getRefundAmt() != null && invoiceVO.getRefundAmt() != 0.0) invoiceBO.updRfndNoteCd(invoiceVO);

				} catch (Exception e) {
					errorResult(e);
					e.printStackTrace();
				}
				
				// for audit trial history purpose
				invoiceBO.insertInvoiceHistory(invoiceVO.getId(), CommonConstant.ACTION_CD_UPD, invoiceVO.getReason());
				onInvoiceSelected(invoiceVO);
				successResult();
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
		trackingLogUtils.endLogs("updateInvoice");
	}
	
	public void validatePostedInvoiceAmount() {
		boolean isPass = true;
		if (lockAmountChanges && posTotalAmountLocked != invoiceVO.getAmount()) {
			FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_ERROR, "Unable to save due to total amount does not match with posted amount (RM " + new BigDecimal(posTotalAmountLocked).setScale(2) + ")", "");
			FacesContext.getCurrentInstance().addMessage(null, msg);
			isPass = false;
		}
		RequestContext.getCurrentInstance().addCallbackParam("isPass", isPass);
	}
	
	/**
	 * Reinsert multiple list item
	 */
	public void rewriteMultipleList() {
		invoiceItemVOList.setAddList(new ArrayList<Object>());
		invoicePaxVOList.setAddList(new ArrayList<Object>());
		invoicePaymentVOList.setAddList(new ArrayList<Object>());
		eoInvVOList.setAddList(new ArrayList<Object>());
		
		for (InvoiceItemVO vo : invoiceVO.getInvoiceItemList()) {
			if (vo.getId() == null) {
				invoiceItemVOList.getAddList().add(vo);
			}
		}
		
		for (InvoicePaxVO vo : invoiceVO.getInvoicePaxList()) {
			if (vo.getId() == null) {
				invoicePaxVOList.getAddList().add(vo);
			}
		}
		
		for (InvoicePaymentVO vo : invoiceVO.getInvoicePaymentList()) {
			if (vo.getId() == null) {
				invoicePaymentVOList.getAddList().add(vo);
			}
		}
		
		for (EOInvoiceVO vo : invoiceVO.getEoInvList()) {
			if (vo.getId() == null) {
				eoInvVOList.getAddList().add(vo);
			}
		}
	}
	
	/**
	 * Delete Invoice
	 */
	public void deleteInvoice() {
		try {
			// Unable to delete this record due to financial period closed.
			if (invoiceVO.isDateInFinPeriodClosed()) throw new BusinessException(CommonErrConstant.ERR_ACCT_FIN_PERIOD_CLOSED_CANNOT_DEL);
			
			invoiceBO.deleteInvoice(invoiceVO);
			invoiceBO.insertInvoiceHistory(invoiceVO.getId(), CommonConstant.ACTION_CD_DEL, "");
			loadCreditNoteDisplay();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
