	public void printInvoiceWithLetterHead(String printType) {
		isPrintLetterHead = true;
		printInvoice(printType);
		isPrintLetterHead = false;
	}
	/**
	 * Print Invoice
	 */
	public void printInvoice(String printType) {
		try {
			InvoiceVO tempVO = SerializationUtils.clone(invoiceVO);
			InvoiceVO invVO = invoiceBO.getInvoiceDetails(tempVO);
			List <InvoiceVO> invList = new ArrayList<InvoiceVO>();
			CompanyVO companyVO = corporateProfileBO.getCompanyDetails(invVO.getCompanyId());
			
			if (printType.equalsIgnoreCase("Invoice")) {
				calTtlAmt(invVO, true);
				
				HashMap<String, Object> map = new HashMap<String, Object>();
				map.put("invPrefixVal", invPrefixVal);
				
				CompanyTaxVO companyTaxVO = corporateProfileBO.getCompanyTax(getSessionInfoBean().getCompanyVO().getId());
				companyTaxVO.setTaxNumber((companyTaxVO.getTaxNumber().isEmpty()) ? "" : companyTaxVO.getTaxNumber());
				map.put("companyCode", companyVO != null ? companyVO.getCode() : "");
				map.put("docTypeCd", invVO.getDocTypeCd());
				
				if (isPrintLetterHead) {
					map.put("letterHeadUrl", "../img/letter-head-header.png");
					if (companyVO != null) {
						validateEffectiveCompanyName(companyVO, invVO.getInvoiceDt());
						map.put("letterHeadUrl", companyVO.getLetterHeadUrl());
					}
				}
				map.put("taxNumber", companyTaxVO.getTaxNumber());
				map.put("GSTPeriod", GSTPeriod);
				
				if (invVO.getCustDetailsVO().getCustType().equals("C")) {
					if (invVO.getCustDetailsVO().getCorAddressVO() != null) {
						invVO.getCustDetailsVO().getCorAddressVO().setCountryName(getCountryName(invVO.getCustDetailsVO().getCorAddressVO().getCountryId()));
					}
				} else {
					if (invVO.getCustDetailsVO().getAddressVO() != null) {
						invVO.getCustDetailsVO().getAddressVO().setCountryName(getCountryName(invVO.getCustDetailsVO().getAddressVO().getCountryId()));
					}
				}
				
				invVO.setSalerName(getUserName(invVO.getSalerId()));
				invVO.setBalanceWord(EnglishNumberToWords.withCents(invVO.getBalance().doubleValue()));
				if (invVO.getTourDepId() != null) {
					TourDepartureVO tourDpVO = tourPackageBO.getTourDepById(invoiceVO.getTourDepId());
					invVO.setTourDpInvRmk(tourDpVO.getInvRemarks());
				}
				
				// Set contact
				String contact = "";
				if (invVO.getCustDetailsVO().getCustType().equals("P")) {
					if (CollectionUtils.isNotEmpty(invVO.getCustDetailsVO().getContactList())) {
						for (PersonContactVO vo : invVO.getCustDetailsVO().getContactList()) {
							contact += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, vo.getTypeCd()) + ": " + vo.getNumber() + "\n";
						}
						invVO.getCustDetailsVO().setContact(contact);
					}
				} else {
					if (CollectionUtils.isNotEmpty(invVO.getCustDetailsVO().getCorContactList())) {
						for (CorContactVO vo : invVO.getCustDetailsVO().getCorContactList()) {
							contact += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, vo.getContactType()) + ": " + vo.getContactNo() + "\n";
						}
						invVO.getCustDetailsVO().setContact(contact);
					}
				}
				
				// Sorting Tax Code
				invVO.setInvoiceItemTaxList(new ArrayList<InvoiceItemVO>());
				for (InvoiceItemVO vo : invVO.getInvoiceItemList()) {
					if (vo.getTaxCode() == null) {
						vo.setTaxCode("");
					}
					invVO.getInvoiceItemTaxList().add(vo);
					
					// Condition for show invoice item desc
//					vo.setDesc(vo.getDesc() + " - " + vo.getSubDesc());
					if (StringUtils.isNotEmpty(vo.getSubDesc()))
						vo.setDesc(vo.getSubDesc());
					else
						vo.setDesc(vo.getDesc());
				}
				
				if (invVO.getInvoiceItemTaxList().size() > 0) {
					Collections.sort(invVO.getInvoiceItemTaxList(), new Comparator<InvoiceItemVO>() {
						@Override
						public int compare(final InvoiceItemVO obj1, final InvoiceItemVO obj2) {
							return obj1.getTaxCode().compareTo(obj2.getTaxCode());
						}
					});
				}
				
				/***
				 * Exclude the deposit account amount -START-
				 */
				List<String> acctList = new ArrayList<>();
				AppSettingVO appSettingVO = appSettingBO.getAppSettingByCode(ConstantAppSetting.MAINT_POS_CONFIG_GL_ACCT_TO_EXCLUDE);
				
				if (StringUtils.isNotBlank(appSettingVO.getValue())) {
					List<String> strAcctList = Arrays.asList(appSettingVO.getValue().split(","));
					
					for (String acctExclude : strAcctList)
						acctList.add(acctExclude);
					
					List<InvoiceItemVO> tempItemVOList = new ArrayList<>();
					List<InvoiceItemVO> tempExcludeItemVOList = new ArrayList<>();
					for (InvoiceItemVO vo : invVO.getInvoiceItemList()) {
						// Check Account was deposit payment
						boolean accountToExcludeMatch = false;
						
						for (String idAcct : acctList) {
							if (vo.getAcctId().equals(Long.valueOf(idAcct))) {
								accountToExcludeMatch = true;
								break;
							}
						}
						
						if (!accountToExcludeMatch) tempItemVOList.add(vo);
						else tempExcludeItemVOList.add(vo);
					}
					
					// Calculate again the total amount
					if (CollectionUtils.isNotEmpty(tempExcludeItemVOList)) {
						invVO.setInvoiceItemList(tempItemVOList);
						invVO.setInvoiceItemExcludeList(tempExcludeItemVOList);
						
						BigDecimal totalAmtExclude = BigDecimal.ZERO;
						if (CollectionUtils.isNotEmpty(tempExcludeItemVOList)) {
							AmountCalcViewVO amtExcludeCalcViewVO = AccountHelper.computeAmountTotalBasedItem(new AmountCalcViewVO(), false, tempExcludeItemVOList, null, false);
							if (amtExcludeCalcViewVO != null)
								totalAmtExclude = amtExcludeCalcViewVO.getTotalAmountAfterRounding();
						}
						
						AmountCalcViewVO amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(new AmountCalcViewVO(), false, tempItemVOList, invVO.getInvoicePaymentList(), false);
						invVO.setAmount(amtCalcViewVO.getTotalAmountAfterRounding().doubleValue());
						invVO.setBalance(amtCalcViewVO.getTotalAmountAfterRounding()
								.add(totalAmtExclude)
								.subtract(amtCalcViewVO.getTotalAmountPaid()).doubleValue());
					}
				}
				/***
				 * Exclude the deposit account amount -END-
				 */
				
				for (InvoicePaxVO vo : invVO.getInvoicePaxList()) {
					vo.setRoomTypeDesc(LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_ROOM_TYPE, vo.getRoomTypeCd()));
					vo.setLangDesc("");
					String languages = "";
					if (vo.getCustDetailsVO() != null) {
						if (CollectionUtils.isNotEmpty(vo.getCustDetailsVO().getLangList())) {
							for (int i=0; i<vo.getCustDetailsVO().getLangList().size(); i++) {
								PersonLangVO langVO = vo.getCustDetailsVO().getLangList().get(i);
								if (i==0) {
									languages += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_LANG_DILC, langVO.getLangCd());
								} else {
									languages += ", " + LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_LANG_DILC, langVO.getLangCd());
								}
							}
						}
					}
					vo.setLangDesc(languages);
				}
				for (InvoicePaymentVO vo : invVO.getInvoicePaymentList()) {
					vo.setPmntIssuedBy(getUserName(vo.getIssuerId()));
					vo.setPmntTypeName(LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_PYMT_TYPE, vo.getPmntTypeCd()));
				}
				invList.add(invVO);
				
				// set e inv qr code
				if (StringUtils.isNotBlank(invVO.geteInvoiceDocumentUuid()) && invVO.geteInvoiceStatus() != null && invVO.geteInvoiceStatus().equals(EInvoiceConstant.E_INV_STATUS_VALID)) {
					String validLink = invVO.geteInvoiceValidationLink();
					invVO.setQrCode(QRCodeUtils.generateQRCodeByteArrayInputStream(validLink, 300, 300));
				}
				
				if (StringUtils.isNotBlank(invVO.geteInvoiceRnDocumentUuid()) && invVO.geteInvoiceRnStatus() != null && invVO.geteInvoiceRnStatus().equals(EInvoiceConstant.E_INV_STATUS_VALID)) {
					String validLink = invVO.geteInvoiceRnValidationLink();
					invVO.setRnQrCode(QRCodeUtils.generateQRCodeByteArrayInputStream(validLink, 300, 300));
				}
				
				if (CollectionUtils.isEmpty(invList)) throw new BusinessException("No result.");
				
				String jasperFileName = CommonConstant.JAS_RPT_INV;
				String reportName = CommonConstant.PDF_RPT_INV;
				if (docTypeCd.equals("C")) {
					jasperFileName = isPrintLetterHead ? CommonConstant.JAS_RPT_CN_WITH_LETTER_HEAD : CommonConstant.JAS_RPT_CN;
					reportName = CommonConstant.PDF_RPT_CN;
				}

				JasperPrint jasperPrint1 = ReportUtils.getJasperPrint(invList, map, jasperFileName);
				ReportUtils.printReport(jasperPrint1, reportName);
				
			} else if (printType.equalsIgnoreCase("Receipt")) {
				invVO.setCompanyVO(companyVO);
				Map<String, Object> map = new HashMap<>();
				map.put("companyName", invVO.getCompanyVO().getName());
				map.put("slogan", invVO.getCompanyVO().getSlogan());
				map.put("address1", invVO.getCompanyVO().getCompanyAddressVO().getAddress1());
				map.put("address2", invVO.getCompanyVO().getCompanyAddressVO().getAddress2());
				map.put("address3", invVO.getCompanyVO().getCompanyAddressVO().getAddress3());
				map.put("city", invVO.getCompanyVO().getCompanyAddressVO().getCity());
				map.put("state", invVO.getCompanyVO().getCompanyAddressVO().getState());
				map.put("postcode", invVO.getCompanyVO().getCompanyAddressVO().getPostcode());
				map.put("countryName", getCountryName(invVO.getCompanyVO().getCompanyAddressVO().getCountryid()));
				
				String contact = "";
				for (CompanyContactVO vo : invVO.getCompanyVO().getCompanyContactList()) {
					contact += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, vo.getTypecodecontact()) + ": " + vo.getNumber() + "  ";
				}
				map.put("contact", contact);
				map.put("prefix", prefixValue);
				map.put("invNo", invVO.getCode());
				map.put("tourCd", invVO.getTourCd());
				map.put("custId", invVO.getCustDetailsVO().getCustId());
				map.put("custType", invVO.getCustDetailsVO().getCustType());
				map.put("contPersonName", invVO.getCustDetailsVO().getContPersonName());
				map.put("custCompanyName", invVO.getCustDetailsVO().getCompanyName());
				map.put("subjLine", invVO.getSubjLine());
				map.put("letterHeadUrl", "../img/letter-head-header.png");
				if (companyVO != null) {
					validateEffectiveCompanyName(companyVO, invVO.getInvoiceDt());
					map.put("letterHeadUrl", companyVO.getLetterHeadUrl());
				}
				for (InvoicePaymentVO invPymt : invVO.getInvoicePaymentList()) {
					invPymt.setPmntTypeName(LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_PYMT_TYPE, invPymt.getPmntTypeCd()));
					invPymt.setAmountWord(EnglishNumberToWords.withCents(invPymt.getAmount().doubleValue()));
					invPymt.setPmntIssuedBy(getUserName(invPymt.getIssuerId()));
					validateEffectiveCompanyName(companyVO, invPymt.getPmntDt());
					invPymt.setCompanyName(companyVO.getName());
					invPymt.setCompanyShortName(companyVO.getShortName());
				}
				
				String jasperFileName = CommonConstant.JAS_RPT_INV_RCPT;
				String reportName = CommonConstant.PDF_RPT_RCPT;
				if (docTypeCd.equals("C")) {
					jasperFileName = CommonConstant.JAS_RPT_CN_RCPT;
				}
				
				JasperPrint jasperPrint2 = ReportUtils.getJasperPrint(invVO.getInvoicePaymentList(), map, jasperFileName);
				ReportUtils.printReport(jasperPrint2, reportName);
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
