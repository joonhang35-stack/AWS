	/**
	 * Single submission
	 */
	public void submitEInvoice() {
		try {
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO, invoiceBO, invoiceAndExchangeOrderBO, regionBO, malaysiaStateBO, chartOfAcctBO);
			CompanyVO companyVO = corporateProfileBO.getCompanyDetails(invoiceVO.getCompanyId());
			JSONObject submitResponse = eInvoiceUtils.submitCreditNote(invoiceVO, companyVO);
			eInvoiceUtils.processCreditNoteSubmitResponse(submitResponse, invoiceVO);
			
			successResult();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void onEInvoice() {
		try {
//			System.out.println("CYY EInvoiceProperties.ENV_BASE_URL_SANDBOX: " + EInvoiceProperties.ENV_BASE_URL_SANDBOX);
			System.out.println("CYY EInvoiceProperties.SYSTEM_API: " + EInvoiceProperties.getSystemApiUrl());
			
			if (StringUtils.isBlank(invoiceVO.geteInvoiceDocumentUuid()) && StringUtils.isBlank(invoiceVO.geteInvoiceRnDocumentUuid())) {
				// if no uuid, means didn't submit before, no need call API
				return;
			}
			
//			String accessToken = eInvoiceUtils.getAccessToken(getSessionInfoBean().getCompanyVO(), true);            	
			String accessToken = eInvoiceBO.getAccessToken(getSessionInfoBean().getCompanyVO(), true);            	
	        
//	        if (!EInvoiceUtils.validateTaxpayerTin(invoiceVO, accessToken)) {
//	        	throw new BusinessException(CommonErrConstant.ERR_TAXPAYER_TIN_VALIDATION_FAILED);
//	        }
	        
	        if (StringUtils.isNotBlank(invoiceVO.geteInvoiceDocumentUuid())) {
	        	EInvoiceDocument eInvoiceDocument = EInvoiceUtils.getDocumentDetails(invoiceVO.geteInvoiceDocumentUuid(), accessToken);
		        invoiceVO.seteInvoiceDocument(eInvoiceDocument);
	        }
	        
	        if (StringUtils.isNotBlank(invoiceVO.geteInvoiceRnDocumentUuid())) {
	        	EInvoiceDocument eInvoiceDocument = EInvoiceUtils.getDocumentDetails(invoiceVO.geteInvoiceRnDocumentUuid(), accessToken);
		        invoiceVO.seteInvoiceRnDocument(eInvoiceDocument);
	        }
	        
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void onCancelEInvoiceAPI() {
		
	}
	
	public void cancelEInvoiceAPI(String cancellationReason) {
		try {
			
			if (StringUtils.isBlank(invoiceVO.geteInvoiceDocumentUuid()) && StringUtils.isBlank(invoiceVO.geteInvoiceRnDocumentUuid())) {
				throw new BusinessException(CommonErrConstant.ERR_DOC_NO_UUID);
			}
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO);
			CompanyVO companyVO = corporateProfileBO.getCompanyDetails(invoiceVO.getCompanyId());
			JSONObject cancelResponse = eInvoiceUtils.cancelDocument(cancellationReason, invoiceVO.geteInvoiceDocumentUuid(), companyVO);
			eInvoiceUtils.processCancelResponse(cancelResponse);
			
			// update sys doc e inv status
			invoiceVO.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_CANCELLED);
			
			if (StringUtils.isNotBlank(invoiceVO.geteInvoiceRnDocumentUuid())) {
				// process refund note cancel
				eInvoiceUtils.processRefundNoteCancelResponse(
						eInvoiceUtils.cancelDocument(cancellationReason, invoiceVO.geteInvoiceRnDocumentUuid(), companyVO));
				
				// update sys doc e inv status
				invoiceVO.seteInvoiceRnStatus(EInvoiceConstant.E_INV_STATUS_CANCELLED);
			}
			
            successResult();
            
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void getEInvoiceDocStatus() {
		try {
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO, invoiceBO, invoiceAndExchangeOrderBO, regionBO, malaysiaStateBO, chartOfAcctBO);
			
			if (StringUtils.isBlank(invoiceVO.geteInvoiceDocumentUuid()) && StringUtils.isBlank(invoiceVO.geteInvoiceRnDocumentUuid())) {
				throw new BusinessException(CommonErrConstant.ERR_DOC_NO_UUID);
			}
			
//			String accessToken = eInvoiceUtils.getAccessToken(getSessionInfoBean().getCompanyVO(), true);   
			String accessToken = eInvoiceBO.getAccessToken(getSessionInfoBean().getCompanyVO(), true);   
			
			if (StringUtils.isNotBlank(invoiceVO.geteInvoiceDocumentUuid())) {
				EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceUtils.updDocumentDetails(invoiceVO.geteInvoiceDocumentUuid(), accessToken);
				invoiceVO.seteInvoiceStatus(eInvoiceDocumentVO.getStatusCode()); // update existing invoiceVO to show result
				invoiceVO.seteInvoiceDocumentVO(eInvoiceDocumentVO);
			}
			
			if (StringUtils.isNotBlank(invoiceVO.geteInvoiceRnDocumentUuid())) {
				EInvoiceDocumentVO eInvoiceRnDocumentVO = eInvoiceUtils.updDocumentDetails(invoiceVO.geteInvoiceRnDocumentUuid(), accessToken);
				invoiceVO.seteInvoiceRnStatus(eInvoiceRnDocumentVO.getStatusCode()); // update existing invoiceVO to show result
				invoiceVO.seteInvoiceRnDocumentVO(eInvoiceRnDocumentVO);
			}
			
			successResult();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
