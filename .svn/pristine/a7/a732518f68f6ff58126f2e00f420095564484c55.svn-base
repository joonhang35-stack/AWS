	public void onSubmitMultipleEInvoice() {
		
	}
	
	public void submitMultipleEInvoice() {
		TrackingLogUtils trackingLogUtils = new TrackingLogUtils(getClass());
		trackingLogUtils.startLogs();
		try {
			
			if (savedSelectedInvoiceList.size() > CommonConstant.E_INV_MAX_DOC_CNT) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null,
						new String[] { "Maximum document count in a submission is 15."
								+ savedSelectedInvoiceList.size() + " is selected." });
			}
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO, invoiceBO, invoiceAndExchangeOrderBO, regionBO, malaysiaStateBO, chartOfAcctBO, corporateProfileBO);
			eInvoiceUtils.setMessageSource(messageSource);
			CompanyVO companyVO = corporateProfileBO.getCompanyDetails(getSessionInfoBean().getCompanyVO().getId());
			if (isEInvSubm) {
				JSONObject submitResponse = eInvoiceUtils.submitCreditNotes(savedSelectedInvoiceList, companyVO);
				eInvoiceUtils.processSubmitResponseCNs(submitResponse, savedSelectedInvoiceList, companyVO.getId());
			}
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
		
		isEInvSubm = !isEInvSubm;
		
		try {
			mulpInvSubmRespList = generateCNRNMulpInvSubmRespList(savedSelectedInvoiceList, getSessionInfoBean().getCompanyVO().getId());
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
		
		resetSelection();
		
		trackingLogUtils.endLogs("submitMultipleEInvoice");
	}
	
	private List<InvoiceVO> generateCNRNMulpInvSubmRespList(List<InvoiceVO> savedSelectedInvoiceList, Long idCompany) throws BusinessException {
		List<InvoiceVO> mulpInvSubmRespList = new ArrayList<InvoiceVO>();
		for (InvoiceVO vo : savedSelectedInvoiceList) {
			if (StringUtils.isNotBlank(vo.geteInvoiceStatus()) && !vo.geteInvoiceStatus().equals(EInvoiceConstant.E_INV_STATUS_NOT_SUBMIT)) {
				vo.setPrefix(LookupItemUtils.getSysNumGenVO(idCompany, CommonConstant.SYS_NUM_CD_CRDT_NOTE).getPrefixid());
				
				InvoiceVO tempVO = invoiceBO.getInvoiceById(vo.getId());
				vo.setAmount(tempVO.getAmtAftRefund());
				
				if (tempVO.getAmtAftRefund().compareTo(0D) != 0) {
					mulpInvSubmRespList.add(vo);
				}
			}
			
			if (StringUtils.isNotBlank(vo.geteInvoiceRnStatus()) && !vo.geteInvoiceRnStatus().equals(EInvoiceConstant.E_INV_STATUS_NOT_SUBMIT)) {
				InvoiceVO clonedVO = SerializationUtils.clone(vo);
				clonedVO.setPrefix(LookupItemUtils.getSysNumGenVO(idCompany, CommonConstant.SYS_NUM_CD_RFND_NOTE).getPrefixid());
				clonedVO.setCode(vo.getRnNo());
				
				InvoiceVO tempVO = invoiceBO.getInvoiceById(vo.getId());
				clonedVO.setAmount(tempVO.getRefundAmt());
				
				if (clonedVO.getRefundAmt().compareTo(0D) != 0) {
					mulpInvSubmRespList.add(clonedVO);
				}
			}
		}
		
		return mulpInvSubmRespList;
	}
	
