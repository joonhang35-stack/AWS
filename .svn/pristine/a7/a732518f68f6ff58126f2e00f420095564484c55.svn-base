	/**
	 * load CN invoice info & tour code
	 * @param invoiceVO
	 * @throws BusinessException
	 */
	public void loadCnInv(InvoiceVO invoiceVO) throws BusinessException {
		if (StringUtils.isNotBlank(invoiceVO.getCnInvNo())) {
			invoiceVO.setCnInv(invoiceBO.getInvoiceByCode(invoiceVO.getCnInvNo(), SalesConstant.DOC_TYPE_CD_INVC));
			invoiceVO.setCnDocNoForDisplay(invoiceVO.getCnInvNo());			
		} else if (StringUtils.isNotBlank(invoiceVO.getCnPsNo())) {
			invoiceVO.setCnInv(invoiceBO.getInvoiceByCode(invoiceVO.getCnPsNo(), SalesConstant.DOC_TYPE_CD_PAX_STMT));
			invoiceVO.setCnDocNoForDisplay(invoiceVO.getCnPsNo());		
		}
		
		if (invoiceVO.getCnInv() != null && invoiceVO.getCnInv().getTourDepId() != null) {
			TourDepartureVO tourDepVO = tourPackageBO.getTourDepById(invoiceVO.getCnInv().getTourDepId());
			invoiceVO.getCnInv().setTourCd(tourDepVO.getCode());
		}
	}
	
