	public InvoiceVO[] getSelectedInvoiceList() {
		return selectedInvoiceList;
	}

	public void setSelectedInvoiceList(InvoiceVO[] selectedInvoiceList) {
		if (savedSelectedInvoiceList == null) savedSelectedInvoiceList = new ArrayList<InvoiceVO>();
    	if (selectedInvoiceList != null) {
    		boolean existed = false;
    		for (Object obj : selectedInvoiceList) {
    			InvoiceVO custVO = (InvoiceVO) obj;
        		existed = false;
        		for (InvoiceVO selectedVO : savedSelectedInvoiceList) {
        			if (selectedVO.getId().equals(custVO.getId())) {
        				existed = true;
        				break;
        			}
        		}
        		if (!existed) savedSelectedInvoiceList.add(custVO);
        	}
    	}
    	
    	List<InvoiceVO> dataList = (List<InvoiceVO>) lazyDataModel.getWrappedData();
    	if (dataList != null && dataList.size() > 0 && selectedInvoiceList != null) {
    		List<InvoiceVO> removeList = new ArrayList<InvoiceVO>();
    		for (InvoiceVO data : dataList) {
    			for (Object obj : selectedInvoiceList) {
    				InvoiceVO custVO = (InvoiceVO) obj;
    	    		if (data.getId().equals(custVO.getId())) {
    	    			removeList.add(data);
    	    			break;
    	    		}
    	    	}
    		}
    		if(removeList.size() > 0) dataList.removeAll(removeList);
    		removeList = new ArrayList<InvoiceVO>();
    		for (InvoiceVO data : dataList) {
    			for (InvoiceVO selectedVO : savedSelectedInvoiceList) {
    	    		if (data.getId().equals(selectedVO.getId())) {
    	    			removeList.add(selectedVO);
    	    			break;
    	    		}
    	    	}
    		}
    		if(removeList.size() > 0) savedSelectedInvoiceList.removeAll(removeList);
    	}
    	this.selectedInvoiceList = savedSelectedInvoiceList.toArray(new InvoiceVO[savedSelectedInvoiceList.size()]);
	}

	public List<InvoiceVO> getSavedSelectedInvoiceList() {
		return savedSelectedInvoiceList;
	}

	public void setSavedSelectedInvoiceList(List<InvoiceVO> savedSelectedInvoiceList) {
		this.savedSelectedInvoiceList = savedSelectedInvoiceList;
	}

