<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf">

	<p:scrollPanel style="width:1000px; height:500px" scrollMode="native"> 
		<p:panelGrid>
			<p:row>
				<p:column>
					<h:outputLabel>Supplier Number : 00001 </h:outputLabel>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel>Supplier Address </h:outputLabel>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel>Contact Number </h:outputLabel>
				</p:column>
			</p:row>
		</p:panelGrid>
		<p:panelGrid>
			<p:row>
				<p:column>
					<h:outputLabel>Payment Type </h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu value="">  
			            <f:selectItem itemLabel="Select One" itemValue="1" /> 
			            <f:selectItem itemLabel="Cheque" itemValue="2" /> 
		        	</h:selectOneMenu>
		        </p:column>
				<p:column>
					<h:outputLabel for="idRQPax4">Date Paid </h:outputLabel>
				</p:column>
				<p:column>
					<p:inputText id="idLabel1" label="Date Paid" value=""/>
				</p:column>
				<p:column>
					<h:outputLabel for="idRQPax4">Cheque No </h:outputLabel>
				</p:column>
				<p:column>
					<p:inputText id="idLabel2" label="Cheque No" value=""/>
				</p:column>
				<p:column>
					<h:outputLabel for="idRQPax4">Amt Paid </h:outputLabel>
				</p:column>
				<p:column>
					<p:inputText id="idLabel3" label="Amt Paid" value=""/>
				</p:column>
				<p:column>
					<h:outputLabel for="idRQPax4">Company Code </h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu value="">  
			            <f:selectItem itemLabel="Select One" itemValue="" /> 
			        </h:selectOneMenu>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idRQPax4">Project Code </h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu value="">  
			            <f:selectItem itemLabel="Select One" itemValue="" /> 
		        	</h:selectOneMenu>
				</p:column>
				<p:column>
					<h:outputLabel for="idRQPax4">Pay from Account </h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu value="">  
			            <f:selectItem itemLabel="Select One" itemValue="" /> 
		        	</h:selectOneMenu>
				</p:column>
			</p:row>
		</p:panelGrid>
				<p:dataTable id="idPurBillPmntTable1" widgetVar="purBillPmntTable1" value="" var="purBillPmnt" paginator="true" rows="20" 
						paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
						rowsPerPageTemplate="20, 30, 50" emptyMessage="#{msg['cust.tbl.empty.message']}">

				<p:column headerText="Due Date" style="width: 5px;" styleClass="txt_center">
						<h:outputText label="Supplier Number" value=""/>
				</p:column>
				<p:column headerText="Inv Date" style="width: 5px;" styleClass="txt_center">
						<h:outputText label="Supplier Number" value=""/>
				</p:column>
				<p:column headerText="Inv Number" style="width: 5px;" styleClass="txt_center">
						<h:outputText label="Supplier Number" value=""/>
				</p:column>
				<p:column headerText="XO No" style="width: 5px;" styleClass="txt_center">
						<h:outputText label="Supplier Number" value=""/>
				</p:column>
				<p:column headerText="CN No" style="width: 5px;" styleClass="txt_center">
						<h:outputText label="Supplier Number" value=""/>
				</p:column>
				<p:column headerText="Total Amt" style="width: 5px;" styleClass="txt_center">
						<h:outputText label="Supplier Number" value=""/>
				</p:column>
				<p:column headerText="Discount" style="width: 5px;" styleClass="txt_center">
						<h:outputText label="Supplier Number" value=""/>
				</p:column>
				<p:column headerText="Total Paid" style="width: 5px;" styleClass="txt_center">
						<h:outputText label="Supplier Number" value=""/>
				</p:column>
				<p:column headerText="Cur Bal" style="width: 5px;" styleClass="txt_center">
						<h:outputText label="Supplier Number" value=""/>
				</p:column>
				<p:column headerText="Amt to Alloc" style="width: 5px;" styleClass="txt_center">
						<p:inputText label="Supplier Number" value=""/>
				</p:column>
				<p:column headerText="Overdue Status" style="width: 5px;" styleClass="txt_center">
						<h:outputText label="Supplier Number" value=""/>
				</p:column>
				<p:column headerText="Bill" style="width: 5px;" styleClass="txt_center">
						<p:commandButton value="Bill"/>
				</p:column>
				<p:column headerText="Pay" style="width: 5px;" styleClass="txt_center">
						<p:commandButton value="Payment"/>
				</p:column>
				<p:columnGroup type="footer">  
			            <p:row>  
			            	<p:column footerText="" colspan="4"/> 
			                <p:column footerText="Totals:"  style="text-align:right"  />  
			  
			                <p:column footerText="$1,000,000" />  
			                
			                <p:column footerText="" />
			  
			                <p:column footerText="$2,000,000" />  
			                
			                <p:column footerText="$3,000,000" />  
			                
			                <p:column footerText="" colspan="4"/>
			            </p:row>  
			    </p:columnGroup> 
			</p:dataTable>
	</p:scrollPanel>
				
	<h:panelGrid columns="6" style="width:1px">
		<p:commandButton value="Payment"/>
		<p:commandButton value="Auto Allocate"/>
		<p:commandButton value="Print" onclick="varPrintDialog.show()" immediate="true"/>
		<p:commandButton value="Cancel" onclick="varMultiBillsPayDialog.hide(), varSupplSelectDialog.hide()" process="@this" />
	</h:panelGrid>
							
</ui:composition>