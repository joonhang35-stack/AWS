package com.bcs.zsg.common.helper;

import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.util.Calendar;
import java.util.Date;
import java.util.TimeZone;

public class DatesUtils {
	
	public static boolean validateTime(Date time, int h1, int m1, int h2, int m2) {
	    if (time == null) return false;

	    Calendar cal = Calendar.getInstance();
	    cal.setTime(time);

	    int hour = cal.get(Calendar.HOUR_OF_DAY);
	    int min  = cal.get(Calendar.MINUTE);

	    // Convert all times into total minutes from midnight for easy comparison
	    int t  = hour * 60 + min;
	    int s1 = h1 * 60 + m1;
	    int s2 = h2 * 60 + m2;

	    // Validate inclusive range: s1 <= t <= s2
	    return t >= s1 && t <= s2;
	}
	
	public static Calendar getDayTimeStart(Date dtTime) {
		
		Calendar cal = Calendar.getInstance();
		if(dtTime == null)
			dtTime = new Date();
		cal.setTime(dtTime);
		cal.set(Calendar.HOUR_OF_DAY, 0);
		cal.set(Calendar.MINUTE, 0);
		cal.set(Calendar.SECOND, 0);
		cal.set(Calendar.MILLISECOND, 0);
		
		return cal;
	}
	
	public static Calendar getDayTimeEnd(Date dtTime) {

		Calendar cal = Calendar.getInstance();
		if(dtTime == null)
			dtTime = new Date();
		cal.setTime(dtTime);
		cal.set(Calendar.HOUR_OF_DAY, 23);
		cal.set(Calendar.MINUTE, 59);
		cal.set(Calendar.SECOND, 59);
		cal.set(Calendar.MILLISECOND, 999);
		
		return cal;
	}
	
	public static Calendar getMidDay(Date dtTime) {

		Calendar cal = Calendar.getInstance();
		if(dtTime == null)
			dtTime = new Date();
		cal.setTime(dtTime);
		cal.set(Calendar.HOUR_OF_DAY, 12);
		cal.set(Calendar.MINUTE, 0);
		cal.set(Calendar.SECOND, 0);
		cal.set(Calendar.MILLISECOND, 000);
		
		return cal;
	}
	
	public static final boolean isSameMonthYear(Date date1, Date date2) {
		Calendar cal1 = Calendar.getInstance();
		Calendar cal2 = Calendar.getInstance();
		
		cal1.setTime(date1);
		cal2.setTime(date2);
		
	    boolean sameMonth = (cal1.get(Calendar.MONTH) == cal2.get(Calendar.MONTH)) ;
	    boolean sameYear = (cal1.get(Calendar.YEAR) == cal2.get(Calendar.YEAR)) ;
	    
	    return (sameMonth && sameYear);
	}
	
	public static final boolean isDateMonthYearGreaterOrEqual(Date date1, Date date2) {
		if(date1 == null || date2 == null)
			return false;
		
        if(getDayTimeStart(date1).getTime().after(getDayTimeStart(date2).getTime()) 
        		|| getDayTimeStart(date1).getTime().equals(getDayTimeStart(date2).getTime())){
            return true;
        } else
        	return false;
	}
	
	public static final boolean isDateGreaterOrEqual(Date date1, Date date2) {
		if(date1 == null || date2 == null)
			return false;
		
        if(getDayTimeStart(date1).getTime().after(getDayTimeStart(date2).getTime()) 
        		|| getDayTimeStart(date1).getTime().equals(getDayTimeStart(date2).getTime())){
            return true;
        } else
        	return false;
	}
	
	public static final boolean isDateLessOrEqual(Date date1, Date date2) {
		if (date1 == null || date2 == null)
			return false;
		
        if (getDayTimeStart(date1).getTime().before(getDayTimeStart(date2).getTime()) 
        		|| getDayTimeStart(date1).getTime().equals(getDayTimeStart(date2).getTime())) {
            return true;
        } else
        	return false;
	}
	
	public static final boolean isDateGreater(Date date1, Date date2) {
		if (date1 == null || date2 == null)
			return false;
		
        if (getDayTimeStart(date1).getTime().after(getDayTimeStart(date2).getTime())) {
            return true;
        } else
        	return false;
	}
	
	public static final boolean isDateEqual(Date date1, Date date2) {
		if(date1 == null || date2 == null)
			return false;
		
        if (getDayTimeStart(date1).getTime().equals(getDayTimeStart(date2).getTime())) {
            return true;
        } else
        	return false;
	}
	
	public static Calendar getPreviousDay(Date dtTime) {
		Calendar cal = Calendar.getInstance();
		if(dtTime == null) {
			return null;
		}
		
		cal = getDayTimeStart(dtTime);
		cal.add(Calendar.DATE, -1);
		
		return cal;
	}
	
	public static Calendar getPreviousDate(Date dtTime, int day) {
		Calendar cal = Calendar.getInstance();
		if(dtTime == null) {
			return null;
		}
		
		cal = getDayTimeStart(dtTime);
		cal.add(Calendar.DATE, -day);
		
		return cal;
	}
	
	/**
	 * convert ISO 8601 date string with format yyyy-MM-dd'T'HH:mm:ss'Z' to Date object
	 * @param iSOString - ISO 8601 date string with format yyyy-MM-dd'T'HH:mm:ss'Z'
	 * @return Date
	 * @throws ParseException 
	 */
	public static Date iSOStringToDate(String iSOString) throws ParseException {
		SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'");
        sdf.setTimeZone(TimeZone.getTimeZone("UTC")); // Set timezone to UTC
        Date date = sdf.parse(iSOString);
        return date;
	}
	
	public static String getddMMyy(Date d) {
		SimpleDateFormat sdf = new SimpleDateFormat("dd-MM-yy");
		return sdf.format(d);
	}
	
	// Get now and before 100 year (E.g 1925-2025)
	public static String getYearRange() {
	    return getYearRange(null);
	}
	
	public static String getYearRange(Integer yearDiff) {
		int beforeYear = 100;
		if (yearDiff == null) {
			yearDiff = beforeYear;
		}
	    int currentYear = java.time.Year.now().getValue();
	    return (currentYear - yearDiff) + ":" + currentYear;
	}

}
