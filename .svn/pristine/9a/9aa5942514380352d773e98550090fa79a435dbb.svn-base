<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Query DAO -->
	<bean id="airlineDAO" class="com.bcs.zsg.db.bterp.dao.airline.AirlineDAOImpl" parent="baseHibernateDAO"/>
	<bean id="monthlyTicketingDAO" class="com.bcs.zsg.db.bterp.dao.view.monthlyticketing.MonthlyTicketingDAOImpl" parent="baseHibernateDAO"/>
	<bean id="tourDepDAO" class="com.bcs.zsg.db.bterp.dao.tourdep.TourDepDAOImpl" parent="baseHibernateDAO"/>
   	<bean id="acctDAO" class="com.bcs.zsg.db.bterp.dao.acct.AccountDAOImpl" parent="baseHibernateDAO"/>
	<bean id="acctTransDAO" class="com.bcs.zsg.db.bterp.dao.accttrans.AccountTransDAOImpl" parent="baseHibernateDAO"/>
	<bean id="acctTransViewDAO" class="com.bcs.zsg.db.bterp.dao.view.accttransview.AccountTransViewDAOImpl" parent="baseHibernateDAO"/>
	<bean id="journalDAO" class="com.bcs.zsg.db.bterp.dao.journal.JournalDAOImpl" parent="baseHibernateDAO"/>
	<bean id="supplierDAO" class="com.bcs.zsg.db.bterp.dao.view.supplier.SupplierViewDAOImpl" parent="baseHibernateDAO"/>
</beans>