	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.BookingService#addBooking(com.bcs.zsg.sales.vo.BookingVO, java.util.List)
	 */
	@Override
	public synchronized void addBooking(BookingVO bookingVO, TourDepartureVO tourDepVO) throws BusinessException {
		int limitedSeatAllotment = Integer.parseInt(LookupItemUtils.getGlobalConfigValue(MaintConstant.GLOBAL_CD_GLOBAL, MaintConstant.GLOBAL_CD_SEAT_ALLOTMENT_LIMITED_STATUS));
		int balance = 0;

		if (tourDepVO.getSeatAllot().intValue() > 0) {
			int totalBook = bookingDAO.getTotalBookByTourDep(tourDepVO.getId(), null);
			balance = tourDepVO.getSeatAllot() - tourDepVO.getReservedSeat() - tourDepVO.getTourManagerPax() - totalBook - bookingVO.getPaxFullCeb() -
					bookingVO.getPaxFullCnb() - bookingVO.getPaxFullCtw() - bookingVO.getPaxFullSgl() - bookingVO.getPaxFullTwn();
			if (balance < 0) throw new BusinessException(CommonErrConstant.ERR_BOOKING_OVER_SEAT_BALANCE);
		}
		// set booking pax quantity
		bookingVO.setQuantity(bookingVO.getPaxFullCeb() + bookingVO.getPaxFullCnb() + bookingVO.getPaxFullCtw() + bookingVO.getPaxFullInft() + bookingVO.getPaxFullSgl() + bookingVO.getPaxFullTwn() +
				bookingVO.getPaxGrndCeb() + bookingVO.getPaxGrndCnb() + bookingVO.getPaxGrndCtw() + bookingVO.getPaxGrndInft() + bookingVO.getPaxGrndSgl() + bookingVO.getPaxGrndTwn());

		if (bookingVO.getQuantity() == 0) throw new BusinessException(CommonErrConstant.ERR_BOOKING_PAX_EMPTY);

		// add booking
		bookingVO.setPmntStatusCd(SalesConstant.BOOKING_PMNT_STATUS_KIV);
		bookingVO.setStatusCode(CommonConstant.STATUS_CD_BOOKED);

		/*boolean isNotTfairSp = true;
		for (String orderType : SalesConstant.BOOKING_ORDER_TYPE_TFAIR_SP) {
			if (bookingVO.getOrderTypeCd().startsWith(orderType)) {
				isNotTfairSp = false;
				break;
			}
		}
		if (isNotTfairSp) bookingVO.setIdSalerTfair(null);*/
		insertVO(bookingVO);

		// Add booking survey
		if(CollectionUtils.isNotEmpty(bookingVO.getIdSurveyList())) {
			for(String code : bookingVO.getIdSurveyList()) {
				SurveyVO vo = new SurveyVO();
				vo.setBookingId(bookingVO.getId());
				vo.setCode(code);
				insertVO(vo);
			}
		}

		// add booking charge item
		addBookingChargeItemList(bookingVO, tourDepVO);

		// add booking sales commission
		addBookingSalesComm(bookingVO, tourDepVO);

		if (balance > 0 && limitedSeatAllotment > 0 && balance <= limitedSeatAllotment)
			tourPkgDAO.updateTourStatus(ProductConstant.TOUR_STATUS_CD_LIMITED, tourDepVO.getId());
		else tourPkgDAO.updateTourStatus(ProductConstant.TOUR_STATUS_CD_FULL, tourDepVO.getId());
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.BookingService#updBooking(com.bcs.zsg.sales.vo.BookingVO, com.bcs.zsg.common.vo.AddUpdDelVO)
	 */
	@Override
	public synchronized void updBooking(BookingVO bookingVO, AddUpdDelVO bookItemAUDVO, TourDepartureVO tourDepVO) throws BusinessException {
		int limitedSeatAllotment = Integer.parseInt(LookupItemUtils.getGlobalConfigValue(MaintConstant.GLOBAL_CD_GLOBAL, MaintConstant.GLOBAL_CD_SEAT_ALLOTMENT_LIMITED_STATUS));
		int balance = 0;

		if (tourDepVO.getSeatAllot().intValue() > 0) {
			int totalBook = bookingDAO.getTotalBookByTourDep(tourDepVO.getId(), bookingVO.getId());
			balance = tourDepVO.getSeatAllot() - tourDepVO.getReservedSeat() - tourDepVO.getTourManagerPax() - totalBook - bookingVO.getPaxFullCeb() -
					bookingVO.getPaxFullCnb() - bookingVO.getPaxFullCtw() - bookingVO.getPaxFullSgl() - bookingVO.getPaxFullTwn();
			if (balance < 0) throw new BusinessException(CommonErrConstant.ERR_BOOKING_OVER_SEAT_BALANCE);
			//if (balance == 0) flag = 1;
			//else if (balance > 0) flag = 2;
		}
		// set booking pax quantity
		bookingVO.setQuantity(bookingVO.getPaxFullCeb() + bookingVO.getPaxFullCnb() + bookingVO.getPaxFullCtw() + bookingVO.getPaxFullInft() + bookingVO.getPaxFullSgl() + bookingVO.getPaxFullTwn() +
				bookingVO.getPaxGrndCeb() + bookingVO.getPaxGrndCnb() + bookingVO.getPaxGrndCtw() + bookingVO.getPaxGrndInft() + bookingVO.getPaxGrndSgl() + bookingVO.getPaxGrndTwn());

		if (bookingVO.getQuantity() == 0) throw new BusinessException(CommonErrConstant.ERR_BOOKING_PAX_EMPTY);
		/*boolean isNotTfairSp = true;
		for (String orderType : SalesConstant.BOOKING_ORDER_TYPE_TFAIR_SP) {
			if (bookingVO.getOrderTypeCd().startsWith(orderType)) {
				isNotTfairSp = false;
				break;
			}
		}
		if (isNotTfairSp) bookingVO.setIdSalerTfair(null);*/

		// update booking
		updateVO(bookingVO);
		// update booking charge items
		updBookingChargeItemList(bookingVO);
		// update status to full status

		if (tourDepVO.getSeatAllot().intValue() > 0) {
			if (balance > 0) {
				if (limitedSeatAllotment > 0 && balance <= limitedSeatAllotment) {
					if (ProductConstant.TOUR_STATUS_CD_FULL.equals(tourDepVO.getTourStatusCd())) {
						tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_LIMITED);
						updateVO(tourDepVO);
					}
				} else {
					if (ProductConstant.TOUR_STATUS_CD_FULL.equals(tourDepVO.getTourStatusCd())) {
						tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
						updateVO(tourDepVO);
					}
				}
			} else {
				if (ProductConstant.TOUR_STATUS_CD_AVAILABLE.equals(tourDepVO.getTourStatusCd()) ||
						ProductConstant.TOUR_STATUS_CD_LIMITED.equals(tourDepVO.getTourStatusCd())) {
					tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_FULL);
					updateVO(tourDepVO);
				}
			}
		}

		// Add booking survey
		if(CollectionUtils.isNotEmpty(bookingVO.getIdSurveyList())) {
			bookingDAO.deleteSurveyList(bookingVO.getId());

			for(String code : bookingVO.getIdSurveyList()) {
				SurveyVO vo = new SurveyVO();
				vo.setBookingId(bookingVO.getId());
				vo.setCode(code);
				insertVO(vo);
			}
		}

		// Update booking sync the order type code (Order source) on invoice
		if (bookingVO.getId() != null && StringUtils.isNotBlank(bookingVO.getOrderTypeCd()))
			bookingDAO.updateInvoiceOrderSource(bookingVO.getId(), bookingVO.getOrderTypeCd());
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.BookingService#cancelBooking(com.bcs.zsg.sales.vo.BookingVO, com.bcs.zsg.product.vo.TourDepartureVO)
	 */
	@Override
	public void cancelBooking(BookingVO bookingVO, TourDepartureVO tourDepVO) throws BusinessException {
		if (CommonConstant.STATUS_CD_CONFIRMED.equals(bookingVO.getStatusCode())) bookingVO.setStatusCode(CommonConstant.STATUS_CD_CANCELLED); //throw new BusinessException(CommonErrConstant.ERR_BOOKING_ISSUED_INV);
		else if (CommonConstant.STATUS_CD_BOOKED.equals(bookingVO.getStatusCode())) {
			//if (tourPkgService.isInvEOIssued(null, bookingVO)) throw new BusinessException(CommonErrConstant.ERR_BOOKING_ISSUED_INV);
			if (SalesConstant.BOOKING_PMNT_STATUS_KIV.equals(bookingVO.getPmntStatusCd())) bookingVO.setStatusCode(CommonConstant.STATUS_CD_VOID);
			else bookingVO.setStatusCode(CommonConstant.STATUS_CD_CANCELLED);
		}
		if(bookingVO.getLockStatus()) {
			bookingVO.setLockStatus(false);
			bookingDAO.updateIndividualBookingLockStatus(bookingVO.getId(), false);
		}
		updateVO(bookingVO);

		if (tourDepVO.getSeatAllot().intValue() > 0) {
			int totalBook = bookingDAO.getTotalBookByTourDep(tourDepVO.getId(), bookingVO.getId());
			int balance = tourDepVO.getSeatAllot() - tourDepVO.getReservedSeat() - tourDepVO.getTourManagerPax() - totalBook;
			if (balance > 0) {
				if (ProductConstant.TOUR_STATUS_CD_FULL.equals(tourDepVO.getTourStatusCd())) {
					tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
					updateVO(tourDepVO);
				}
			}
		}
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.BookingService#getBookingList(java.lang.Long)
	 */
	@Override
	public List<BookingVO> getBookingList(TourDepartureVO tourDepVO) throws BusinessException {
		List<BookingVO> bookingList = bookingDAO.getBookingList(tourDepVO.getId());

		if (CollectionUtils.isNotEmpty(bookingList)) {
			int totPaxFullSgl = 0;
			int totPaxFullTwn = 0;
			int totPaxFullCtw = 0;
			int totPaxFullCwb = 0;
			int totPaxFullCnb = 0;
			int totPaxFullInft = 0;
			int totPaxGrndSgl = 0;
			int totPaxGrndTwn = 0;
			int totPaxGrndCtw = 0;
			int totPaxGrndCwb = 0;
			int totPaxGrndCnb = 0;
			int totPaxGrndInft = 0;
			String feedbackStatus = "";
			
			for (BookingVO bookingVO : bookingList) {
				feedbackStatus = bookingDAO.getFeedbackStatus(bookingVO.getId());
				bookingVO.setFeedbackStatus(feedbackStatus);
				
				bookingVO.setEmployeeViewVO(userService.getEmployeeView(bookingVO.getIdEmployee()));
				bookingVO.setBookingChargeItemList(new ArrayList<BookingChargeItemVO>(bookingVO.getBookingChargeItemSet()));
				bookingVO.setBookingChargeItemSet(null);
				bookingVO.setCustomerVO(custService.getCustomerSimpleDetail(bookingVO.getIdCust()));
				bookingVO.setCustName(bookingVO.getCustomerVO().getCustName());
				InvoiceVO invVO = bookingDAO.getInvoiceInfo(bookingVO.getId());
				bookingVO.setInvId(invVO.getId());
				bookingVO.setInvCode(invVO.getCode());
				bookingVO.setPsNo(invVO.getPsNo());
				bookingVO.setInternalRemarks(invVO.getInternalRemarks());
				bookingVO.setValidPassportStatus(invVO.getValidPassportStatus());
				bookingVO.setVisaCopiesStatus(invVO.getVisaCopiesStatus());
				bookingVO.setTransferredDate(invVO.getTransferredDate()); // for transferred badge use
				bookingVO.setAmtPaid(invVO.getAmtPaid()); // for payment badge use
				bookingVO.setInvPmntStatusCd(invVO.getStatusCd()); // for payment badge use

				bookingVO.setInvList(bookingDAO.getSubDocInfo(bookingVO.getId()));
				if (bookingVO.getInvList() == null)	bookingVO.setInvList(new ArrayList<InvoiceVO>());
				bookingVO.setPaxStmtList(new ArrayList<InvoiceVO>());
				Iterator<InvoiceVO> iterator = bookingVO.getInvList().iterator();
				// take out pax stmt from inv list and insert into pax stmt list
		        while (iterator.hasNext()) {
		        	InvoiceVO invoiceVO = iterator.next();
		            if (invoiceVO.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_PAX_STMT)) {
		            	// won't show converted stmt
		            	// 2/4/2025 Booking Made Page - Display PS No. although already converted to INV (You Yuan)
//		            	if (!invoiceVO.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_CONVERTED)) {
		            		bookingVO.getPaxStmtList().add(invoiceVO);
//		            	}
		            	iterator.remove();
		            }
		        }

		        if (invVO != null) {
		        	if (invVO.getDocTypeCd() != null) {
		        		if (invVO.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_INVC)) {
		        			// if is invc, is old record before pax stmt, no need check doc type status
		        			bookingVO.getInvList().add(invVO);
		        		} else {
		        			// if is not invc, then is pax stmt, will carry doc type status
//		        			if (!invVO.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_CONVERTED)
//		        					&& !invVO.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_SPLIT)) {
//				        		bookingVO.getPaxStmtList().add(invVO);
//				        	}

		        			if (!invVO.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_SPLIT)) {
				        		bookingVO.getPaxStmtList().add(invVO);
				        	}
		        		}

		        	} else {
		        		if (invVO.getId() != null) {
		        			System.out.println("BookingServiceImpl.getBookingList() " + bookingVO.getId());
			        		System.out.println("invVO.getId(): " + invVO.getId());
			        		System.out.println("CYY invVO.getDocTypeCd() IS NULL !!!");
		        		}
		        	}

		        }

//				for (InvoiceVO vo : bookingVO.getInvList()) {
//					System.out.println("CYY bookingVO.getInvList(): " + vo.getId() + " " + vo.getCode() + " " + vo.getPsNo());
//				}

				for (BookingChargeItemVO itemVO : bookingVO.getBookingChargeItemList()) {
					if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(itemVO.getCode())) {
						totPaxFullSgl += itemVO.getQuantity();
						bookingVO.setPaxFullSgl(itemVO.getQuantity());

					} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(itemVO.getCode())) {
						totPaxFullTwn += itemVO.getQuantity();
						bookingVO.setPaxFullTwn(itemVO.getQuantity());

					} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CTW.equals(itemVO.getCode())) {
						totPaxFullCtw += itemVO.getQuantity();
						bookingVO.setPaxFullCtw(itemVO.getQuantity());

					} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CWB.equals(itemVO.getCode())) {
						totPaxFullCwb += itemVO.getQuantity();
						bookingVO.setPaxFullCeb(itemVO.getQuantity());

					} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CNB.equals(itemVO.getCode())) {
						totPaxFullCnb += itemVO.getQuantity();
						bookingVO.setPaxFullCnb(itemVO.getQuantity());

					} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_INFT.equals(itemVO.getCode())) {
						totPaxFullInft += itemVO.getQuantity();
						bookingVO.setPaxFullInft(itemVO.getQuantity());

					} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_SGL.equals(itemVO.getCode())) {
						totPaxGrndSgl += itemVO.getQuantity();
						bookingVO.setPaxGrndSgl(itemVO.getQuantity());

					} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_TWN.equals(itemVO.getCode())) {
						totPaxGrndTwn += itemVO.getQuantity();
						bookingVO.setPaxGrndTwn(itemVO.getQuantity());

					} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CTW.equals(itemVO.getCode())) {
						totPaxGrndCtw += itemVO.getQuantity();
						bookingVO.setPaxGrndCtw(itemVO.getQuantity());

					} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CWB.equals(itemVO.getCode())) {
						totPaxGrndCwb += itemVO.getQuantity();
						bookingVO.setPaxGrndCeb(itemVO.getQuantity());

					} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CNB.equals(itemVO.getCode())) {
						totPaxGrndCnb += itemVO.getQuantity();
						bookingVO.setPaxGrndCnb(itemVO.getQuantity());

					} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_INFT.equals(itemVO.getCode())) {
						totPaxGrndInft += itemVO.getQuantity();
						bookingVO.setPaxGrndInft(itemVO.getQuantity());
					}
				}
			}
			bookingList.get(0).setTotPaxFullSgl(totPaxFullSgl);
			bookingList.get(0).setTotPaxFullTwn(totPaxFullTwn);
			bookingList.get(0).setTotPaxFullCtw(totPaxFullCtw);
			bookingList.get(0).setTotPaxFullCeb(totPaxFullCwb);
			bookingList.get(0).setTotPaxFullCnb(totPaxFullCnb);
			bookingList.get(0).setTotPaxFullInft(totPaxFullInft);
			bookingList.get(0).setTotPaxGrndSgl(totPaxGrndSgl);
			bookingList.get(0).setTotPaxGrndTwn(totPaxGrndTwn);
			bookingList.get(0).setTotPaxGrndCtw(totPaxGrndCtw);
			bookingList.get(0).setTotPaxGrndCeb(totPaxGrndCwb);
			bookingList.get(0).setTotPaxGrndCnb(totPaxGrndCnb);
			bookingList.get(0).setTotPaxGrndInft(totPaxGrndInft);
		}
		return bookingList;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.BookingService#getBookingViewList(com.bcs.zsg.common.vo.SearchParamVO, java.lang.String, java.lang.String, java.lang.Boolean)
	 */
	@Override
	public List<BookingViewVO> getBookingViewList(SearchParamVO searchParamVO, String searchBookingName, String searchBookingNumber, Boolean isPersonal, UserVO userVO) throws BusinessException {
		Boolean noValue = false;

		List<BookingViewVO> bookingViewList = bookingDAO.getBookingViewList(searchParamVO, searchBookingNumber);
		List<BookingViewVO> bookingViewListBySearch = new ArrayList<BookingViewVO>();
		List<BookingViewVO> bookingViewListClone = new ArrayList<BookingViewVO>();
		if (CollectionUtils.isNotEmpty(bookingViewList)) {
			bookingViewListClone.addAll(bookingViewList);
			EmployeeVO employee = homeDAO.getEmployeeInfo(userVO.getUuid(), null);
			if (isPersonal) {
				for (BookingViewVO vo : bookingViewList) {
					if(!vo.getEmployeeViewVO().getUserVO().getLoginId().equals(userVO.getLoginId())) {
						bookingViewListClone.remove(vo);
					}
				}
			} else {
				for (BookingViewVO vo : bookingViewList) {
					if(!vo.getEmployeeViewVO().getDepartment().equals(employee.getDepartment()) && employee.getDepartment().toLowerCase().startsWith("sale")) {
						bookingViewListClone.remove(vo);
					}
				}
			}

			if (CollectionUtils.isNotEmpty(bookingViewListClone)) {
				for (BookingViewVO bookingViewVO : bookingViewListClone) {
					bookingViewVO.setCustomerVO(custService.getCustomerInfo(bookingViewVO.getIdCust()));
					bookingViewVO.setCustName(bookingViewVO.getCustomerVO().getPersonVO().getLastName() + " " + bookingViewVO.getCustomerVO().getPersonVO().getGivenName());
				}
			}
		}
		return (bookingViewListBySearch.size() > 0 || noValue) ? bookingViewListBySearch : bookingViewListClone;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.BookingService#getBookingViewList(com.bcs.zsg.common.vo.SearchParamVO, java.lang.String, java.lang.Boolean, com.bcs.zsg.cfg.sec.vo.EmployeeVO)
	 */
	@Override
