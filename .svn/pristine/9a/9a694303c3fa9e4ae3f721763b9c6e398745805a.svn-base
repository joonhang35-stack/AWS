							System.out.println("CYY tourDepVO.getId(): " + tourDepVO.getId());
							System.out.println("CYY itemVO.getCode(): " + itemVO.getCode());
							System.out.println("CYY tourDepVO.getCompanyVO(): " + tourDepVO.getCompanyVO());
							System.out.println("CYY tourDepVO.getCompanyVO(): " + tourDepVO.getCompanyVO().getId());
							// this is cruise extra charges item
//							 invItemVO.setShowInInv(
//									 tourPkgDAO.getTourDepItem(
//											 tourDepVO.getId(),
//											 itemVO.getCode(),
//											 purchaseEODAO.getCompany(tourDepVO.getIdCompany()))
//									 .isShowInInv());
						}

						invVO.getInvoiceItemList().add(invItemVO);
					} else if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0
							&& ProductConstant.TOUR_DEP_ITM_TYPE_TOTAL_MISC_CHARGE.equals(itemVO.getTypeCd())) {
						System.out.println("itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0 && ProductConstant.TOUR_DEP_ITM_TYPE_TOTAL_MISC_CHARGE.equals(itemVO.getTypeCd())");
						System.out.println("invItemVO.isShowInInv(): " + invItemVO.isShowInInv());
						CruiseScheduleVO vvvo = cruiseDAO.getCruiseSchedule(tourDepVO.getIdCruiseSchedule());
