						cabinItemVO.setShowInInv(true);
						invVO.getInvoiceItemList().add(cabinItemVO);
					}
					if (itemVO.getQuantity4() > 0) {
						cabinItemVO = (InvoiceItemVO) invItemVO.clone();
						cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_4TH);
