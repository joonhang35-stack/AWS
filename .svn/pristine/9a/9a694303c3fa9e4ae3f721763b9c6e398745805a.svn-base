						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_VISA))		invItemVO.setShowInInv(!vvvo.isSumAmtVisa());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_AC))			invItemVO.setShowInInv(!vvvo.isSumAmtAC());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_TIPPING))	invItemVO.setShowInInv(!vvvo.isSumAmtTipping());
