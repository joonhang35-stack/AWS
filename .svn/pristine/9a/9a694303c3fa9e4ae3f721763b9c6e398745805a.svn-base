	public synchronized InvoiceVO transferCruiseBooking(Long idBooking, Long idTourDep, Date invDate,
			TourDepartureVO tourDepVO, boolean isReturnValue, boolean keepInvItem) throws BusinessException {
		if (idTourDep.equals(tourDepVO.getId()))
			throw new BusinessException(CommonErrConstant.ERR_BOOKING_TRANSFER_SAME_TOUR_DEP);

		tourDepVO = tourPkgService.getTourDepById(tourDepVO.getId());

		BookingViewVO bookingViewVO = bookingDAO.getBookingView(idBooking);
		BookingVO theBookingVO = new BookingVO();
		BeanUtils.copyProperties(bookingViewVO, theBookingVO);

		calculateCabin(theBookingVO, tourDepVO);

		theBookingVO
				.setBookingChargeItemList(getBookingChargeItemList(theBookingVO.getId()));

		BookingVO bookingVO = new BookingVO();
		bookingVO.setIdCompany(theBookingVO.getIdCompany());
		bookingVO.setIdTourDep(tourDepVO.getId());
		bookingVO.setIdEmployee(theBookingVO.getEmployeeViewVO().getId());
		bookingVO.setIdCust(theBookingVO.getIdCust());
		bookingVO.setIdSalerTfair(theBookingVO.getIdSalerTfair());
		bookingVO.setOrderTypeCd(theBookingVO.getOrderTypeCd());
		bookingVO.setTypeCd(theBookingVO.getTypeCd());
		bookingVO.setQuantity(theBookingVO.getQuantity());
		bookingVO.setCabinQty(theBookingVO.getCabinQty());
		bookingVO.setOrderTypeCd(theBookingVO.getOrderTypeCd());
		bookingVO.setLockStatus(theBookingVO.getLockStatus());
		bookingVO.setPmntStatusCd(theBookingVO.getPmntStatusCd());
		bookingVO.setStatusCode(theBookingVO.getStatusCode());
		bookingVO.setTourCruiseCabinList(tourCruiseCabinService.getTourCruiseCabinList(tourDepVO.getId(),theBookingVO.getIdCompany()));
		bookingVO.setDtExp(theBookingVO.getDtExp());

		bookingVO.setTotalAmount(theBookingVO.getTotalAmount());
		bookingVO.setDiscountAmount(theBookingVO.getDiscountAmount());
		bookingVO.setDepositAmount(theBookingVO.getDepositAmount());
		bookingVO.setAmountPayable(theBookingVO.getAmountPayable());
		bookingVO.setTotalCabin(theBookingVO.getTotalCabin());
		bookingVO.setTotalHeadCount(theBookingVO.getTotalHeadCount());
		bookingVO.setBookingChargeItemList(theBookingVO.getBookingChargeItemList());
		bookingVO.setBookingChargeItemSet(theBookingVO.getBookingChargeItemSet());

		tourDepVO.setTourDepItemList(tourPkgService.getTourDepItemList(tourDepVO.getId(), bookingVO.getIdCompany()));

		addNewCruiseBooking(bookingVO, tourDepVO);

		if(!keepInvItem) {
			// add new booking item
			cancelCruiseBooking(bookingViewVO, tourDepVO);
		}

		// update current booking to cancel
		if (!CommonConstant.STATUS_CD_CANCELLED.equals(bookingViewVO.getStatusCode())
				&& !CommonConstant.STATUS_CD_VOID.equals(bookingViewVO.getStatusCode())) {
			bookingViewVO.setStatusCode(CommonConstant.STATUS_CD_CANCELLED);
			updateVO(bookingViewVO);
		}

		// add new booking item
//		tourDepVO.setTourDepItemList(tourPkgService.getTourDepItemList(tourDepVO.getId(), bookingVO.getIdCompany()));
//		addCruiseBookingChargeItemList(vo, tourDepVO);

		// update previous tour dep status
		TourDepartureVO prevTourDepVO = tourPkgService.getTourDepById(bookingVO.getIdTourDep());
		if (prevTourDepVO.getSeatAllot().intValue() > 0) {
			if (ProductConstant.TOUR_STATUS_CD_FULL.equals(prevTourDepVO.getTourStatusCd())) {
				prevTourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
				updateVO(prevTourDepVO);

				/*
				 * totalBook = bookingDAO.getTotalBookByTourDep(prevTourDepVO.getId(), null);
				 * balance = prevTourDepVO.getSeatAllot() - prevTourDepVO.getTourManagerPax() -
				 * prevTourDepVO.getReservedSeat() - totalBook; if (balance > 0) {
				 * prevTourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
				 * updateVO(prevTourDepVO); }
				 */
			}
		}

		// return invoice object
		if (isReturnValue) {
			boolean isGSTPeriod = gstService.isGSTPeriod(bookingVO.getIdCompany(), invDate);
			List<TourDepItemVO> tourDepItemVOList = null;
			if (isGSTPeriod) {
				tourDepItemVOList = tourPkgService.getTourDepItemList(tourDepVO.getId(), bookingVO.getIdCompany());
			}

			TourPackageVO tourPkgVO = tourPkgService.getTourPackageById(tourDepVO.getIdTourPkg());
			InvoiceVO invVO = new InvoiceVO();
			invVO.setInvoiceDt(invDate);
			invVO.setCustomerId(bookingVO.getIdCust());
			invVO.setBookingId(bookingVO.getId());
			invVO.setTourCd(tourDepVO.getCode());
			invVO.setTourDepId(tourDepVO.getId());
			invVO.setSubjLine(tourDepVO.getDesc());
			invVO.setDepartureDt(tourDepVO.getDtDep());
			invVO.setOrderCd(bookingVO.getOrderTypeCd());
			invVO.setCatCd(CommonConstant.LOOKUP_ITM_INV_CAT_CRUISE);
			StringBuilder sb = new StringBuilder();
			sb.append(tourDepVO.getNumDays() + "Days " + tourDepVO.getNumNights() + "Nights ");
			if (!StringUtils.isEmpty(tourPkgVO.getNameEn()))
				sb.append(tourPkgVO.getNameEn());
			if (!StringUtils.isEmpty(tourPkgVO.getNameZh()))
				sb.append(" " + tourPkgVO.getNameZh());
			if (!StringUtils.isEmpty(tourPkgVO.getNameOther()))
				sb.append(" " + tourPkgVO.getNameOther());
			invVO.setSubjLine(sb.toString());

			invVO.setInvoiceItemList(new ArrayList<InvoiceItemVO>());
			for (BookingChargeItemVO itemVO : bookingVO.getBookingChargeItemList()) {
				if (ProductConstant.TYPE_CRUISE.equals(bookingVO.getTypeCd())) {
					InvoiceItemVO invItemVO = new InvoiceItemVO();
					invItemVO.setAcctId(itemVO.getIdAcct());
					invItemVO.setInvEOItemId(itemVO.getIdInvEoItem());
					invItemVO.setInvItemCd(itemVO.getCode());
					invItemVO.setDesc(itemVO.getDesc());
					invItemVO.setQty(itemVO.getQuantity());
					invItemVO.setUnitPrice(itemVO.getAmount());
					invItemVO.setAmount((new BigDecimal(String.valueOf(itemVO.getAmount())))
							.multiply(new BigDecimal(String.valueOf(itemVO.getQuantity()))).doubleValue());
					invItemVO.setTaxAmount(0.00);
					if (isGSTPeriod) {
						for (TourDepItemVO tourDepItemVO : tourDepItemVOList) {
							if (tourDepItemVO.getCode().equals(itemVO.getCode())) {
								invItemVO.setTaxCode(tourDepItemVO.getTaxCode());
								invItemVO.setTaxRate(tourDepItemVO.getTaxRate());
								tourDepItemVOList.remove(tourDepItemVO);
								break;
							}
						}
					} else {
						invItemVO.setTaxCode(null);
						invItemVO.setTaxRate(null);
					}

					if (itemVO.getCabinQty() > 0 && ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(itemVO.getTypeCd())) {
						InvoiceItemVO cabinItemVO = new InvoiceItemVO();
						if (itemVO.getQuantity() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_TWN);
							cabinItemVO.setQty(itemVO.getQuantity());
							cabinItemVO.setUnitPrice(itemVO.getAmount());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity3() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_3RD);
							cabinItemVO.setQty(itemVO.getQuantity3());
							cabinItemVO.setUnitPrice(itemVO.getAmount3());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity4() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_4TH);
							cabinItemVO.setQty(itemVO.getQuantity4());
							cabinItemVO.setUnitPrice(itemVO.getAmount4());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantitySgl() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_SGL);
							cabinItemVO.setQty(itemVO.getQuantitySgl());
							cabinItemVO.setUnitPrice(itemVO.getAmountSgl());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity3Chd() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_3RD_CHD);
							cabinItemVO.setQty(itemVO.getQuantity3Chd());
							cabinItemVO.setUnitPrice(itemVO.getAmount3Chd());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity4Chd() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_4TH_CHD);
							cabinItemVO.setQty(itemVO.getQuantity4Chd());
							cabinItemVO.setUnitPrice(itemVO.getAmount4Chd());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantityInf() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_INFT);
							cabinItemVO.setQty(itemVO.getQuantityInf());
							cabinItemVO.setUnitPrice(itemVO.getAmountInf());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
					} else if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0
							&& ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE.equals(itemVO.getTypeCd())) {

						CruiseScheduleVO vvvo = cruiseDAO.getCruiseSchedule(tourDepVO.getIdCruiseSchedule());
						if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_PORT_CHARGES))	invItemVO.setShowInInv(!vvvo.isSumAmtApt());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_APT_ADT))	invItemVO.setShowInInv(!vvvo.isSumAmtApt());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_APT_CHD))	invItemVO.setShowInInv(!vvvo.isSumAmtApt());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_FUEL_ADT))	invItemVO.setShowInInv(!vvvo.isSumAmtFuel());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_FUEL_CHD))	invItemVO.setShowInInv(!vvvo.isSumAmtFuel());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_DEVIATION))	invItemVO.setShowInInv(!vvvo.isSumAmtDeviation());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_TRVL_INS))	invItemVO.setShowInInv(!vvvo.isSumAmtTrvlIns());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_VISA))		invItemVO.setShowInInv(!vvvo.isSumAmtVisa());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_AC))			invItemVO.setShowInInv(!vvvo.isSumAmtAC());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_TIPPING))	invItemVO.setShowInInv(!vvvo.isSumAmtTipping());
						else {
							System.out.println("CYY tourDepVO.getId(): " + tourDepVO.getId());
							System.out.println("CYY itemVO.getCode(): " + itemVO.getCode());
							System.out.println("CYY tourDepVO.getCompanyVO(): " + tourDepVO.getCompanyVO());
							System.out.println("CYY tourDepVO.getCompanyVO(): " + tourDepVO.getCompanyVO().getId());
							// this is cruise extra charges item
//							 invItemVO.setShowInInv(
//									 tourPkgDAO.getTourDepItem(
//											 tourDepVO.getId(),
//											 itemVO.getCode(),
//											 purchaseEODAO.getCompany(tourDepVO.getIdCompany()))
//									 .isShowInInv());
						}

						invVO.getInvoiceItemList().add(invItemVO);
					} else if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0
							&& ProductConstant.TOUR_DEP_ITM_TYPE_TOTAL_MISC_CHARGE.equals(itemVO.getTypeCd())) {
						System.out.println("itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0 && ProductConstant.TOUR_DEP_ITM_TYPE_TOTAL_MISC_CHARGE.equals(itemVO.getTypeCd())");
						System.out.println("invItemVO.isShowInInv(): " + invItemVO.isShowInInv());
						CruiseScheduleVO vvvo = cruiseDAO.getCruiseSchedule(tourDepVO.getIdCruiseSchedule());
						invItemVO.setDesc(vvvo.getGroupingChargeLabel());
						invItemVO.setShowInInv(true);
						invVO.getInvoiceItemList().add(invItemVO);
					}
				} else {
					if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0) {
						InvoiceItemVO invItemVO = new InvoiceItemVO();
						invItemVO.setAcctId(itemVO.getIdAcct());
						invItemVO.setInvEOItemId(itemVO.getIdInvEoItem());
						invItemVO.setInvItemCd(itemVO.getCode());
						invItemVO.setDesc(itemVO.getDesc());
						invItemVO.setQty(itemVO.getQuantity());
						invItemVO.setUnitPrice(itemVO.getAmount());
						// invItemVO.setAmount(itemVO.getAmount() * itemVO.getQuantity());
						invItemVO.setAmount((new BigDecimal(String.valueOf(itemVO.getAmount())))
								.multiply(new BigDecimal(String.valueOf(itemVO.getQuantity()))).doubleValue());
						invItemVO.setTaxAmount(0.00);
						if (isGSTPeriod) {
							for (TourDepItemVO tourDepItemVO : tourDepItemVOList) {
								if (tourDepItemVO.getCode().equals(itemVO.getCode())) {
									invItemVO.setTaxCode(tourDepItemVO.getTaxCode());
									invItemVO.setTaxRate(tourDepItemVO.getTaxRate());
									tourDepItemVOList.remove(tourDepItemVO);
									break;
								}
							}
						} else {
							invItemVO.setTaxCode(null);
							invItemVO.setTaxRate(null);
						}
						invVO.getInvoiceItemList().add(invItemVO);
					}
				}
			}

			return invVO;
		}
		return null;
	}

	public synchronized InvoiceVO transferCruiseBookingOld(Long idBooking, Long idTourDep, Date invDate,
			TourDepartureVO tourDepVO, boolean isReturnValue, boolean keepInvItem) throws BusinessException {
		if (idTourDep.equals(tourDepVO.getId()))
			throw new BusinessException(CommonErrConstant.ERR_BOOKING_TRANSFER_SAME_TOUR_DEP);

		tourDepVO = tourPkgService.getTourDepById(tourDepVO.getId());

		BookingViewVO bookingViewVO = bookingDAO.getBookingView(idBooking);
		bookingViewVO
				.setBookingChargeItemList(new ArrayList<BookingChargeItemVO>(bookingViewVO.getBookingChargeItemSet()));
		BookingVO tmpBookingVO = bookingDAO.getBooking(idBooking);

		System.out.println();
		System.out.println("--bookingViewVO.getBookingChargeItemSet()--");
		for(BookingChargeItemVO vo : bookingViewVO.getBookingChargeItemList()) {
			System.out.println(vo.getDesc() + " : " + vo.getAmount());
		}
		System.out.println();

		int loop = 1;
		for (BookingChargeItemVO bcvo : bookingViewVO.getBookingChargeItemList()) {
			System.out.println(loop + " - bcvo.getIdAcct(): " + bcvo.getIdAcct());
			loop++;
		}

		// add new booking
		BookingVO bookingVO = new BookingVO();
		bookingVO.setIdTourDep(tourDepVO.getId());
		bookingVO.setIdCompany(tmpBookingVO.getIdCompany());
		bookingVO.setIdEmployee(tmpBookingVO.getIdEmployee());
		bookingVO.setIdCust(tmpBookingVO.getIdCust());
		bookingVO.setIdSalerTfair(tmpBookingVO.getIdSalerTfair());
		bookingVO.setOrderTypeCd(tmpBookingVO.getOrderTypeCd());
		bookingVO.setQuantity(tmpBookingVO.getQuantity());
		bookingVO.setPmntStatusCd(tmpBookingVO.getPmntStatusCd());
		if (SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT.equals(tmpBookingVO.getPmntStatusCd())
				|| SalesConstant.BOOKING_PMNT_STATUS_FULL.equals(tmpBookingVO.getPmntStatusCd())) {
			bookingVO.setStatusCode(CommonConstant.STATUS_CD_CONFIRMED);
		} else if (SalesConstant.BOOKING_PMNT_STATUS_KIV.equals(tmpBookingVO.getPmntStatusCd())) {
			bookingVO.setStatusCode(CommonConstant.STATUS_CD_BOOKED);
		} else {
			bookingVO.setStatusCode(tmpBookingVO.getStatusCode());
		}
		bookingVO.setDtExp(tmpBookingVO.getDtExp());
		bookingVO.setTypeCd(tmpBookingVO.getTypeCd());
		bookingVO.setLockStatus(tmpBookingVO.getLockStatus());
		bookingVO.setCabinQty(tmpBookingVO.getCabinQty());
		bookingVO.setBookingChargeItemList(bookingViewVO.getBookingChargeItemList());
		bookingVO.setTourCruiseCabinList(new ArrayList<TourCruiseCabinVO>());

		TourCruiseCabinVO tourCabinVO = null;
		for (BookingChargeItemVO bookingChrg : bookingVO.getBookingChargeItemList()) {
			if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(bookingChrg.getTypeCd())
					&& bookingChrg.getCabinQty() != 0) {

				tourCabinVO = new TourCruiseCabinVO();
				tourCabinVO.setUuid(UUID.randomUUID().toString());
				tourCabinVO.setIdAcct(bookingChrg.getIdAcct());
				tourCabinVO.setIdTourCruiseCabin(bookingChrg.getIdTourCruiseCabin());
				tourCabinVO.setIdTourDep(tourDepVO.getId());
				tourCabinVO.setCruiseCabinCd(bookingChrg.getCode());
				tourCabinVO.setCruiseCabinDesc(bookingChrg.getDesc());
				tourCabinVO.setPriceTwn(bookingChrg.getAmount());
				tourCabinVO.setPrice3(bookingChrg.getAmount3());
				tourCabinVO.setPrice4(bookingChrg.getAmount4());
				tourCabinVO.setPriceSgl(bookingChrg.getAmountSgl());
				tourCabinVO.setPrice3Chd(bookingChrg.getAmount3Chd());
				tourCabinVO.setPrice4Chd(bookingChrg.getAmount4Chd());
				tourCabinVO.setPriceInf(bookingChrg.getAmountInf());
				tourCabinVO.setPaxTwn(bookingChrg.getQuantity());
				tourCabinVO.setPax3(bookingChrg.getQuantity3());
				tourCabinVO.setPax4(bookingChrg.getQuantity4());
				tourCabinVO.setPaxSgl(bookingChrg.getQuantitySgl());
				tourCabinVO.setPax3Chd(bookingChrg.getQuantity3Chd());
				tourCabinVO.setPax4Chd(bookingChrg.getQuantity4Chd());
				tourCabinVO.setPaxInf(bookingChrg.getQuantityInf());
				tourCabinVO.setTtlCabin(bookingChrg.getCabinQty());
				bookingVO.getTourCruiseCabinList().add(tourCabinVO);
			}
		}

		calculateCabin(bookingVO, tourDepVO);

		System.out.println();
		System.out.println("--bookingVO.getBookingChargeItemSet()--");
		for(BookingChargeItemVO vo : bookingVO.getBookingChargeItemList()) {
			System.out.println(vo.getDesc() + " : " + vo.getAmount());
		}
		System.out.println();


		System.out.println("before bookingVO.getId: " + bookingVO.getId());
		if (tourDepVO.getTourDepItemList() != null) {
			System.out
					.println("before tourDepVO.getTourDepItemList().size(): " + tourDepVO.getTourDepItemList().size());
		}
		insertVO(bookingVO);

		if(keepInvItem) {
			addNewCruiseBookingFromTsfrRemainPrevBkg(bookingVO, tourDepVO);
		}
		else {
			// add new booking item
			addNewCruiseBooking(bookingVO, tourDepVO);
		}

		System.out.println("after bookingVO.getId: " + bookingVO.getId());

		System.out.println();
		System.out.println("--addNewCruiseBooking--");
		for(BookingChargeItemVO vo : bookingVO.getBookingChargeItemList()) {
			System.out.println(vo.getDesc() + " : " + vo.getAmount());
		}
		System.out.println();

		// update current booking to cancel
		if (!CommonConstant.STATUS_CD_CANCELLED.equals(tmpBookingVO.getStatusCode())
				&& !CommonConstant.STATUS_CD_VOID.equals(tmpBookingVO.getStatusCode())) {
			tmpBookingVO.setStatusCode(CommonConstant.STATUS_CD_CANCELLED);
			updateVO(tmpBookingVO);
		}

		// add new booking item
//		tourDepVO.setTourDepItemList(tourPkgService.getTourDepItemList(tourDepVO.getId(), bookingVO.getIdCompany()));
//		addCruiseBookingChargeItemList(vo, tourDepVO);

		// update previous tour dep status
		TourDepartureVO prevTourDepVO = tourPkgService.getTourDepById(bookingVO.getIdTourDep());
		if (prevTourDepVO.getSeatAllot().intValue() > 0) {
			if (ProductConstant.TOUR_STATUS_CD_FULL.equals(prevTourDepVO.getTourStatusCd())) {
				prevTourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
				updateVO(prevTourDepVO);

				/*
				 * totalBook = bookingDAO.getTotalBookByTourDep(prevTourDepVO.getId(), null);
				 * balance = prevTourDepVO.getSeatAllot() - prevTourDepVO.getTourManagerPax() -
				 * prevTourDepVO.getReservedSeat() - totalBook; if (balance > 0) {
				 * prevTourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
				 * updateVO(prevTourDepVO); }
				 */
			}
		}

		// return invoice object
		if (isReturnValue) {
			boolean isGSTPeriod = gstService.isGSTPeriod(bookingVO.getIdCompany(), invDate);
			List<TourDepItemVO> tourDepItemVOList = null;
			if (isGSTPeriod) {
				tourDepItemVOList = tourPkgService.getTourDepItemList(tourDepVO.getId(), bookingVO.getIdCompany());
			}

			TourPackageVO tourPkgVO = tourPkgService.getTourPackageById(tourDepVO.getIdTourPkg());
			InvoiceVO invVO = new InvoiceVO();
			invVO.setInvoiceDt(invDate);
			invVO.setCustomerId(bookingVO.getIdCust());
			invVO.setBookingId(bookingVO.getId());
			invVO.setTourCd(tourDepVO.getCode());
			invVO.setTourDepId(tourDepVO.getId());
			invVO.setSubjLine(tourDepVO.getDesc());
			invVO.setDepartureDt(tourDepVO.getDtDep());
			invVO.setOrderCd(bookingVO.getOrderTypeCd());
			invVO.setCatCd(CommonConstant.LOOKUP_ITM_INV_CAT_CRUISE);
			StringBuilder sb = new StringBuilder();
			sb.append(tourDepVO.getNumDays() + "Days " + tourDepVO.getNumNights() + "Nights ");
			if (!StringUtils.isEmpty(tourPkgVO.getNameEn()))
				sb.append(tourPkgVO.getNameEn());
			if (!StringUtils.isEmpty(tourPkgVO.getNameZh()))
				sb.append(" " + tourPkgVO.getNameZh());
			if (!StringUtils.isEmpty(tourPkgVO.getNameOther()))
				sb.append(" " + tourPkgVO.getNameOther());
			invVO.setSubjLine(sb.toString());

