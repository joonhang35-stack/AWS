	@Override
	public synchronized void addCruiseBooking(BookingVO bookingVO, TourDepartureVO tourDepVO) throws BusinessException {
		if (bookingVO.getTourCruiseCabinList().size() > 0) {

			// check if cabin has available quantity
			for (TourCruiseCabinVO vo : bookingVO.getTourCruiseCabinList()) {
				int cabinAllot = 0;
				for (TourCruiseCabinVO vo2 : tourDepVO.getTourCruiseCabinList()) {
					if (vo2.getId().equals(vo.getIdTourCruiseCabin())) {
						cabinAllot = vo2.getCabinAllotment();
						break;
					}
				}
				if (cabinAllot > 0) {
					// // calculate total booking of the cabin by sum of related bookings
					// calculate total booking of the cabin by looping through all bookings and sum booking with matched cabin id
					int totalBook = bookingDAO.getTotalCabinByTourDep(tourDepVO.getId(), vo.getIdTourCruiseCabin(),
							null);
					int balance = cabinAllot - totalBook - vo.getTtlCabin();
					if (balance < 0)
						throw new BusinessException(CommonErrConstant.ERR_BOOKING_OVER_CABIN_BALANCE, null,
								new String[] { vo.getCruiseCabinCd() });

				}
			}
		}

		// set booking pax quantity
		bookingVO.setQuantity(bookingVO.getTotalHeadCount());
		bookingVO.setCabinQty(bookingVO.getTotalCabin());

		if (bookingVO.getQuantity() == 0)
			throw new BusinessException(CommonErrConstant.ERR_BOOKING_PAX_EMPTY);
		if (bookingVO.getCabinQty() == 0)
			throw new BusinessException(CommonErrConstant.ERR_BOOKING_CABIN_EMPTY);

		// add booking
		bookingVO.setPmntStatusCd(SalesConstant.BOOKING_PMNT_STATUS_KIV);
		bookingVO.setStatusCode(CommonConstant.STATUS_CD_BOOKED);
		insertVO(bookingVO);

		// Add booking survey
		if (CollectionUtils.isNotEmpty(bookingVO.getIdSurveyList())) {
			for (String code : bookingVO.getIdSurveyList()) {
				SurveyVO vo = new SurveyVO();
				vo.setBookingId(bookingVO.getId());
				vo.setCode(code);
				insertVO(vo);
			}
		}

		// add booking charge item
		addCruiseBookingChargeItemList(bookingVO, tourDepVO);

		updateVO(bookingVO);

		// update status to full status
		int flag = 0;
		// 1: cabin full (balance == 0)
		// 2: cabin not full (balance > 0)

		int isExisted = 0;
		for (TourCruiseCabinVO vo : tourDepVO.getTourCruiseCabinList()) {
			flag = 0;
			isExisted = 0;
			int cabinAllot = vo.getCabinAllotment();
			if (cabinAllot == 0) {
				flag = 2;
			} else {
				int totalBook = bookingDAO.getTotalCabinByTourDep(tourDepVO.getId(), vo.getId(), bookingVO.getId());
				for (TourCruiseCabinVO vo2 : bookingVO.getTourCruiseCabinList()) {
					if (vo.getId().equals(vo2.getIdTourCruiseCabin())) {
						int balance = cabinAllot - totalBook - vo2.getTtlCabin();
						if (balance == 0)
							flag = 1;
						else if (balance > 0)
							flag = 2;
						isExisted = 1;
						break;
					}
				}
				if (isExisted == 0) {
					int balance = cabinAllot - totalBook;
					if (balance == 0)
						flag = 1;
					else if (balance > 0)
						flag = 2;
				}
			}

			if (flag == 1) {
				if (ProductConstant.TOUR_STATUS_CD_AVAILABLE.equals(vo.getTourStatusCd())
						|| ProductConstant.TOUR_STATUS_CD_LIMITED.equals(vo.getTourStatusCd())) {
					vo.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_FULL);
					updateVO(vo);
				}
			} else if (flag == 2) {
				if (ProductConstant.TOUR_STATUS_CD_FULL.equals(vo.getTourStatusCd())) {
					vo.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
					updateVO(vo);
				}
			}
		}
	}

	@Override
	public synchronized void addCruiseBookingForQuote(BookingVO bookingVO, TourDepartureVO tourDepVO) throws BusinessException {
		if (bookingVO.getTourCruiseCabinList().size() > 0) {

			// check if cabin has available quantity
			for (TourCruiseCabinVO vo : bookingVO.getTourCruiseCabinList()) {
				int cabinAllot = 0;
				for (TourCruiseCabinVO vo2 : tourDepVO.getTourCruiseCabinList()) {
					if (vo2.getId().equals(vo.getIdTourCruiseCabin())) {
						cabinAllot = vo2.getCabinAllotment();
						break;
					}
				}
				if (cabinAllot > 0) {
					// // calculate total booking of the cabin by sum of related bookings
					// calculate total booking of the cabin by looping through all bookings and sum booking with matched cabin id
					int totalBook = bookingDAO.getTotalCabinByTourDep(tourDepVO.getId(), vo.getIdTourCruiseCabin(),
							null);
					int balance = cabinAllot - totalBook - vo.getTtlCabin();
					if (balance < 0)
						throw new BusinessException(CommonErrConstant.ERR_BOOKING_OVER_CABIN_BALANCE, null,
								new String[] { vo.getCruiseCabinCd() });

				}
			}
		}

		// set booking pax quantity
		bookingVO.setQuantity(bookingVO.getTotalHeadCount());
		bookingVO.setCabinQty(bookingVO.getTotalCabin());

		if (bookingVO.getQuantity() == 0)
			throw new BusinessException(CommonErrConstant.ERR_BOOKING_PAX_EMPTY);
		if (bookingVO.getCabinQty() == 0)
			throw new BusinessException(CommonErrConstant.ERR_BOOKING_CABIN_EMPTY);

		// add booking
		bookingVO.setPmntStatusCd(SalesConstant.BOOKING_PMNT_STATUS_KIV);
		bookingVO.setStatusCode(CommonConstant.STATUS_CD_BOOKED);

		// Add booking survey
		if (CollectionUtils.isNotEmpty(bookingVO.getIdSurveyList())) {
			for (String code : bookingVO.getIdSurveyList()) {
				SurveyVO vo = new SurveyVO();
				vo.setBookingId(bookingVO.getId());
				vo.setCode(code);
			}
		}

		// add booking charge item
		addCruiseBookingChargeItemListForQuote(bookingVO, tourDepVO);

		// update status to full status
		int flag = 0;
		// 1: cabin full (balance == 0)
		// 2: cabin not full (balance > 0)

		int isExisted = 0;
		for (TourCruiseCabinVO vo : tourDepVO.getTourCruiseCabinList()) {
			flag = 0;
			isExisted = 0;
			int cabinAllot = vo.getCabinAllotment();
			if (cabinAllot == 0) {
				flag = 2;
			} else {
				int totalBook = bookingDAO.getTotalCabinByTourDep(tourDepVO.getId(), vo.getId(), bookingVO.getId());
				for (TourCruiseCabinVO vo2 : bookingVO.getTourCruiseCabinList()) {
					if (vo.getId().equals(vo2.getIdTourCruiseCabin())) {
						int balance = cabinAllot - totalBook - vo2.getTtlCabin();
						if (balance == 0)
							flag = 1;
						else if (balance > 0)
							flag = 2;
						isExisted = 1;
						break;
					}
				}
				if (isExisted == 0) {
					int balance = cabinAllot - totalBook;
					if (balance == 0)
						flag = 1;
					else if (balance > 0)
						flag = 2;
				}
			}

			if (flag == 1) {
				if (ProductConstant.TOUR_STATUS_CD_AVAILABLE.equals(vo.getTourStatusCd())
						|| ProductConstant.TOUR_STATUS_CD_LIMITED.equals(vo.getTourStatusCd())) {
					vo.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_FULL);
					updateVO(vo);
				}
			} else if (flag == 2) {
				if (ProductConstant.TOUR_STATUS_CD_FULL.equals(vo.getTourStatusCd())) {
					vo.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
					updateVO(vo);
				}
			}
		}
	}

	@Override
	public synchronized void addNewCruiseBooking(BookingVO bookingVO, TourDepartureVO tourDepVO)
			throws BusinessException {

		List<BookingChargeItemVO> prevBookingChargeItemList = new ArrayList<BookingChargeItemVO>();
		for (BookingChargeItemVO vo : bookingVO.getBookingChargeItemList()) {
			BookingChargeItemVO newVO = new BookingChargeItemVO();
			BeanUtils.copyProperties(vo, newVO);
			prevBookingChargeItemList.add(newVO);
		}
		bookingDAO.insert(bookingVO);
		Long newBookingId = bookingVO.getId();

		// add booking charge item
		List<TourDepItemVO> tourDepItemList = tourDepVO.getTourDepItemList();

		if (tourDepItemList == null) {
			tourDepItemList = tourPkgDAO.getTourDepItemList(tourDepVO.getId(), bookingVO.getIdCompany(), null);
		}

		double total = 0.0;
		if (CollectionUtils.isNotEmpty(bookingVO.getTourCruiseCabinList())) {
			bookingVO.setBookingChargeItemList(new ArrayList<BookingChargeItemVO>());

			BookingChargeItemVO itemVO = null;
			TourDepItemVO tourDepItemVO = new TourDepItemVO();

			int count = 0;
			for (TourDepItemVO vo : tourDepItemList) {
				itemVO = new BookingChargeItemVO();
				itemVO.setIdBooking(bookingVO.getId());
				itemVO.setIdAcct(vo.getAcctId());
				itemVO.setIdInvEoItem(vo.getIdInvEoItem());
				itemVO.setCode(vo.getCode());
				itemVO.setDesc(vo.getDesc());
				itemVO.setAmount(vo.getAmount());
				itemVO.setTypeCd(vo.getTypeCd());
				if (vo.getAmount().doubleValue() > 0) {
					itemVO.setQuantity(bookingVO.getTotalHeadCount());
					total += itemVO.getQuantity() * itemVO.getAmount();
					insertVO(itemVO);
					bookingVO.getBookingChargeItemList().add(itemVO);
				}
				if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(vo.getCode())) {
					tourDepItemVO = vo;
				}
			}

			for (TourCruiseCabinVO vo : bookingVO.getTourCruiseCabinList()) {

				itemVO = new BookingChargeItemVO();
				itemVO.setIdBooking(bookingVO.getId());
				itemVO.setIdAcct(vo.getIdAcct());
				itemVO.setIdInvEoItem(null);
				itemVO.setCode(vo.getCruiseCabinCd());
				itemVO.setDesc(vo.getCruiseCabinDesc());
				itemVO.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_TOUR);

				itemVO.setAmount(vo.getPriceTwn());
				itemVO.setAmount3(vo.getPrice3());
				itemVO.setAmount4(vo.getPrice4());
				itemVO.setAmountSgl(vo.getPriceSgl());
				itemVO.setAmount3Chd(vo.getPrice3Chd());
				itemVO.setAmount4Chd(vo.getPrice4Chd());
				itemVO.setAmountInf(vo.getPriceInf());
				itemVO.setIdTourCruiseCabin(vo.getId());

				for (BookingChargeItemVO bciVO : prevBookingChargeItemList) {
					if (bciVO.getCode().equals(vo.getCruiseCabinCd())) {
						itemVO.setQuantity(bciVO.getQuantity());
						itemVO.setQuantity3(bciVO.getQuantity3());
						itemVO.setQuantity4(bciVO.getQuantity4());
						itemVO.setQuantitySgl(bciVO.getQuantitySgl());
						itemVO.setQuantity3Chd(bciVO.getQuantity3Chd());
						itemVO.setQuantity4Chd(bciVO.getQuantity4Chd());
						itemVO.setQuantityInf(bciVO.getQuantityInf());
						itemVO.setCabinQty(bciVO.getCabinQty());
						total += (itemVO.getQuantity() * itemVO.getAmount()
								+ itemVO.getQuantity3() * itemVO.getAmount3()
								+ itemVO.getQuantity4() * itemVO.getAmount4()
								+ itemVO.getQuantitySgl() * itemVO.getAmountSgl()
								+ itemVO.getQuantity3Chd() * itemVO.getAmount3Chd()
								+ itemVO.getQuantity4Chd() * itemVO.getAmount4Chd()
								+ itemVO.getQuantityInf() * itemVO.getAmountInf());
						insertVO(itemVO);
						bookingVO.getBookingChargeItemList().add(itemVO);
					}
				}

				// tour cabin discount logic
				List<TourCruiseCabinDiscountVO> discountList = tourCruiseCabinDAO
						.getTourCruiseCabinDiscountList(vo.getIdTourCruiseCabin());
//				List<TourCruiseCabinDiscountVO> discountList = new ArrayList<TourCruiseCabinDiscountVO>();
				int remainingPax = vo.getPaxTwn() + vo.getPax3() + vo.getPax4() + vo.getPaxSgl() + vo.getPax3Chd() + vo.getPax4Chd() + vo.getPaxInf();

				for (TourCruiseCabinDiscountVO discountVO : discountList) {
					itemVO = new BookingChargeItemVO();

					itemVO.setIdBooking(bookingVO.getId());
					itemVO.setIdTourCruiseCabin(vo.getIdTourCruiseCabin());
					itemVO.setIdAcct(tourDepItemVO.getAcctId());
					itemVO.setIdInvEoItem(null);
					itemVO.setCode(ProductConstant.TOUR_DEP_ITM_CD_DISC + "_" + vo.getCruiseCabinCd());
					itemVO.setDesc("DISCOUNT " + vo.getCruiseCabinDesc());
					itemVO.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE);
					itemVO.setAmount(0.0);

					if (remainingPax <= 0) {
						itemVO.setQuantity(0);
						insertVO(itemVO);
						bookingVO.getBookingChargeItemList().add(itemVO);
						break;
					}

					int availableDiscountPax = discountVO.getDiscountPax();
					double availableDiscountAmt = discountVO.getDiscountAmt();

					if (availableDiscountPax <= 0 || availableDiscountAmt <= 0) {
						itemVO.setQuantity(0);
						insertVO(itemVO);
						bookingVO.getBookingChargeItemList().add(itemVO);
						continue;
					}

					itemVO.setAmount(
							availableDiscountAmt > 0 ? -discountVO.getDiscountAmt() : discountVO.getDiscountAmt());

					total += itemVO.getAmount();

					if (availableDiscountPax >= remainingPax) {
						discountVO.setDiscountPax(discountVO.getDiscountPax() - remainingPax);
						itemVO.setQuantity(remainingPax);

						remainingPax = 0;
					} else {
						remainingPax = remainingPax - availableDiscountPax;

						discountVO.setDiscountPax(discountVO.getDiscountPax() - availableDiscountPax);
						itemVO.setQuantity(availableDiscountPax);
					}
					// }

					updateVO(discountVO);
					insertVO(itemVO);
					bookingVO.getBookingChargeItemList().add(itemVO);
				}
			}
		}

		bookingVO.setAmount(total);
		bookingDAO.update(bookingVO);
	}

	// used when transferring invoices and want to retain the invoice item details of the previous tour code
	public synchronized void addNewCruiseBookingFromTsfrRemainPrevBkg(BookingVO bookingVO, TourDepartureVO tourDepVO)
			throws BusinessException {
		bookingDAO.insert(bookingVO);

		// add booking charge item
		List<TourDepItemVO> tourDepItemList = tourDepVO.getTourDepItemList();

		if (tourDepItemList == null) {
			tourDepItemList = tourPkgDAO.getTourDepItemList(tourDepVO.getId(), bookingVO.getIdCompany(), null);
		}


		if (CollectionUtils.isNotEmpty(bookingVO.getTourCruiseCabinList())) {

			BookingChargeItemVO itemVO = null;
			TourDepItemVO tourDepItemVO = new TourDepItemVO();


			for (TourCruiseCabinVO vo : bookingVO.getTourCruiseCabinList()) {

				itemVO = new BookingChargeItemVO();
				itemVO.setIdBooking(bookingVO.getId());
				itemVO.setIdAcct(vo.getIdAcct());
				itemVO.setIdInvEoItem(null);
				itemVO.setCode(vo.getCruiseCabinCd());
				itemVO.setDesc(vo.getCruiseCabinDesc());
				itemVO.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_TOUR);

				itemVO.setAmount(vo.getPriceTwn());
				itemVO.setAmount3(vo.getPrice3());
				itemVO.setAmount4(vo.getPrice4());
				itemVO.setAmountSgl(vo.getPriceSgl());
				itemVO.setAmount3Chd(vo.getPrice3Chd());
				itemVO.setAmount4Chd(vo.getPrice4Chd());
				itemVO.setAmountInf(vo.getPriceInf());

				itemVO.setIdTourCruiseCabin(vo.getIdTourCruiseCabin());
				itemVO.setQuantity(vo.getPaxTwn());
				itemVO.setQuantity3(vo.getPax3());
				itemVO.setQuantity4(vo.getPax4());
				itemVO.setQuantitySgl(vo.getPaxSgl());
				itemVO.setQuantity3Chd(vo.getPax3Chd());
				itemVO.setQuantity4Chd(vo.getPax4Chd());
				itemVO.setQuantityInf(vo.getPaxInf());
				itemVO.setCabinQty(vo.getTtlCabin());

				// tour cabin discount logic
				List<TourCruiseCabinDiscountVO> discountList = tourCruiseCabinService
						.getTourCruiseCabinDiscountList(vo.getIdTourCruiseCabin());
				int remainingPax = vo.getPaxTwn() + vo.getPax3() + vo.getPax4() + vo.getPaxSgl() + vo.getPax3Chd() + vo.getPax4Chd() + vo.getPaxInf();

				for (TourCruiseCabinDiscountVO discountVO : discountList) {
					itemVO = new BookingChargeItemVO();

					itemVO.setIdBooking(bookingVO.getId());
					itemVO.setIdTourCruiseCabin(vo.getIdTourCruiseCabin());
					itemVO.setIdAcct(tourDepItemVO.getAcctId());
					itemVO.setIdInvEoItem(null);
					itemVO.setCode(ProductConstant.TOUR_DEP_ITM_CD_DISC + "_" + vo.getCruiseCabinCd());
					itemVO.setDesc("DISCOUNT " + vo.getCruiseCabinDesc());
					itemVO.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE);
					itemVO.setAmount(0.0);

					if (remainingPax <= 0) {
						itemVO.setQuantity(0);
						break;
					}

					int availableDiscountPax = discountVO.getDiscountPax();
					double availableDiscountAmt = discountVO.getDiscountAmt();

					if (availableDiscountPax <= 0 || availableDiscountAmt <= 0) {
						itemVO.setQuantity(0);
						continue;
					}

					itemVO.setAmount(
							availableDiscountAmt > 0 ? -discountVO.getDiscountAmt() : discountVO.getDiscountAmt());

					if (availableDiscountPax >= remainingPax) {
						discountVO.setDiscountPax(discountVO.getDiscountPax() - remainingPax);
						itemVO.setQuantity(remainingPax);

						remainingPax = 0;
					} else {
						remainingPax = remainingPax - availableDiscountPax;

						discountVO.setDiscountPax(discountVO.getDiscountPax() - availableDiscountPax);
						itemVO.setQuantity(availableDiscountPax);
					}

				}
			}
		}
	}

	@Override
	public void updBookingForQuote(BookingVO bookingVO, AddUpdDelVO bookItemAUDVO, TourDepartureVO tourDepVO)
			throws BusinessException {

		int flag = 0;
		if (tourDepVO.getSeatAllot().intValue() > 0) {
			int totalBook = bookingDAO.getTotalBookByTourDep(tourDepVO.getId(), bookingVO.getId(),
					bookingVO.getTypeCd());
			int balance = tourDepVO.getSeatAllot() - tourDepVO.getReservedSeat() - tourDepVO.getTourManagerPax()
					- totalBook - bookingVO.getPaxFullCeb() - bookingVO.getPaxFullCnb() - bookingVO.getPaxFullCtw()
					- bookingVO.getPaxFullTrpl() - bookingVO.getPaxFullSgl() - bookingVO.getPaxFullTwn();

			if (balance < 0) {
				tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_FULL);
				throw new BusinessException(CommonErrConstant.ERR_BOOKING_OVER_SEAT_BALANCE);
			}
			if (balance == 0) {
				flag = 1;
			} else if (balance > 0) {
				flag = 2;
			}
		}

		// set booking pax quantity
		bookingVO.setQuantity(bookingVO.getPaxFullCeb() + bookingVO.getPaxFullCnb() + bookingVO.getPaxFullCtw()
				+ bookingVO.getPaxFullInft() + bookingVO.getPaxFullSgl() + bookingVO.getPaxFullTwn()
				+ bookingVO.getPaxGrndCeb() + bookingVO.getPaxGrndCnb() + bookingVO.getPaxGrndCtw()
				+ bookingVO.getPaxGrndInft() + bookingVO.getPaxGrndSgl() + bookingVO.getPaxGrndTwn()
				+ bookingVO.getPaxFullTrpl()
				+ bookingVO.getPaxGrndTrpl()
				);

		if (bookingVO.getQuantity() == 0)
			throw new BusinessException(CommonErrConstant.ERR_BOOKING_PAX_EMPTY);

		// update booking charge items
		updBookingChargeItemListForQuote(bookingVO, tourDepVO);

		// update status to full status
		if (flag == 1) {
			if (ProductConstant.TOUR_STATUS_CD_AVAILABLE.equals(tourDepVO.getTourStatusCd())
					|| ProductConstant.TOUR_STATUS_CD_LIMITED.equals(tourDepVO.getTourStatusCd())) {
				tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_FULL);
			}
		} else if (flag == 2) {
			if (ProductConstant.TOUR_STATUS_CD_FULL.equals(tourDepVO.getTourStatusCd())) {
				tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
			}
		}

		// Add booking survey
		if (CollectionUtils.isNotEmpty(bookingVO.getIdSurveyList())) {
			bookingDAO.deleteSurveyList(bookingVO.getId());

			for (String code : bookingVO.getIdSurveyList()) {
				SurveyVO vo = new SurveyVO();
				vo.setBookingId(bookingVO.getId());
				vo.setCode(code);
			}
		}
	}

	@Override
	public synchronized void updCruiseBooking(BookingVO bookingVO, TourDepartureVO tourDepVO) throws BusinessException {
		if (bookingVO.getTourCruiseCabinList().size() > 0) {
			for (TourCruiseCabinVO vo : bookingVO.getTourCruiseCabinList()) {
				int cabinAllot = 0;
				for (TourCruiseCabinVO vo2 : tourDepVO.getTourCruiseCabinList()) {
					if (vo2.getId().equals(vo.getIdTourCruiseCabin())) {
						cabinAllot = vo2.getCabinAllotment();
						break;
					}
				}
				if (cabinAllot > 0) {
					int totalBook = bookingDAO.getTotalCabinByTourDep(tourDepVO.getId(), vo.getIdTourCruiseCabin(),
							bookingVO.getId());
					int balance = cabinAllot - totalBook - vo.getTtlCabin();
					if (balance < 0)
						throw new BusinessException(CommonErrConstant.ERR_BOOKING_OVER_CABIN_BALANCE, null,
								new String[] { vo.getCruiseCabinCd() });

				}
			}
		}

		// set booking pax quantity
		bookingVO.setQuantity(bookingVO.getTotalHeadCount());
		bookingVO.setCabinQty(bookingVO.getTotalCabin());

		if (bookingVO.getQuantity() == 0)
			throw new BusinessException(CommonErrConstant.ERR_BOOKING_PAX_EMPTY);
		if (bookingVO.getCabinQty() == 0)
			throw new BusinessException(CommonErrConstant.ERR_BOOKING_CABIN_EMPTY);

		// update booking
		updateVO(bookingVO);
		// update booking charge items
		updCruiseBookingChargeItemList(bookingVO, tourDepVO);

		// update status to full status
		int flag = 0;
		int isExisted = 0;
		for (TourCruiseCabinVO vo : tourDepVO.getTourCruiseCabinList()) {
			flag = 0;
			isExisted = 0;
			int cabinAllot = vo.getCabinAllotment();
			if (cabinAllot == 0) {
				flag = 2;
			} else {
				int totalBook = bookingDAO.getTotalCabinByTourDep(tourDepVO.getId(), vo.getId(), bookingVO.getId());
				for (TourCruiseCabinVO vo2 : bookingVO.getTourCruiseCabinList()) {
					if (vo.getId().equals(vo2.getIdTourCruiseCabin())) {
						int balance = cabinAllot - totalBook - vo2.getTtlCabin();
						if (balance == 0)
							flag = 1;
						else if (balance > 0)
							flag = 2;
						isExisted = 1;
						break;
					}
				}
				if (isExisted == 0) {
					int balance = cabinAllot - totalBook;
					if (balance == 0)
						flag = 1;
					else if (balance > 0)
						flag = 2;
				}
			}

			if (flag == 1) {
				if (ProductConstant.TOUR_STATUS_CD_AVAILABLE.equals(vo.getTourStatusCd())
						|| ProductConstant.TOUR_STATUS_CD_LIMITED.equals(vo.getTourStatusCd())) {
					vo.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_FULL);
					updateVO(vo);
				}
			} else if (flag == 2) {
				if (ProductConstant.TOUR_STATUS_CD_FULL.equals(vo.getTourStatusCd())) {
					vo.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
					updateVO(vo);
				}
			}
		}

		// Add booking survey
		if (CollectionUtils.isNotEmpty(bookingVO.getIdSurveyList())) {
			bookingDAO.deleteSurveyList(bookingVO.getId());

			for (String code : bookingVO.getIdSurveyList()) {
				SurveyVO vo = new SurveyVO();
				vo.setBookingId(bookingVO.getId());
				vo.setCode(code);
				insertVO(vo);
			}
		}
	}

	@Override
	public synchronized void cancelCruiseBooking(BookingVO bookingVO, TourDepartureVO tourDepVO)
			throws BusinessException {
		if (CommonConstant.STATUS_CD_CONFIRMED.equals(bookingVO.getStatusCode()))
			bookingVO.setStatusCode(CommonConstant.STATUS_CD_CANCELLED); // throw new
																			// BusinessException(CommonErrConstant.ERR_BOOKING_ISSUED_INV);
		else if (CommonConstant.STATUS_CD_BOOKED.equals(bookingVO.getStatusCode())) {
			if (SalesConstant.BOOKING_PMNT_STATUS_KIV.equals(bookingVO.getPmntStatusCd()))
				bookingVO.setStatusCode(CommonConstant.STATUS_CD_VOID);
			else
				bookingVO.setStatusCode(CommonConstant.STATUS_CD_CANCELLED);
		}
		if (bookingVO.getLockStatus()) {
			bookingVO.setLockStatus(false);
			bookingDAO.updateIndividualBookingLockStatus(bookingVO.getId(), false);
		}
		updateVO(bookingVO);

		int cabinAllot = 0;
		for (TourCruiseCabinVO vo : tourDepVO.getTourCruiseCabinList()) {
			cabinAllot = vo.getCabinAllotment();
			if (cabinAllot > 0) {
				int totalBook = bookingDAO.getTotalCabinByTourDep(tourDepVO.getId(), vo.getId(), bookingVO.getId());
				int balance = cabinAllot - totalBook;
				if (balance > 0) {
					if (ProductConstant.TOUR_STATUS_CD_FULL.equals(vo.getTourStatusCd())) {
						vo.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
						updateVO(vo);
						break;
					}
				}
			}
		}
	}

	@Override
	public void reactivateBooking(BookingVO bookingVO) throws BusinessException {
		Map<String, Object> params = new HashMap<String, Object>();
		params.put("idTourBooking", bookingVO.getId());
		params.put("simpleInvoice", BaseConstant.YES);
		List<InvoiceVO> invoiceList = invoiceDAO.getInvoiceList(params);
		InvoiceVO invoiceVO = null;

		if (invoiceList.size() > 0) {
			if (invoiceList.size() > 1)
				throw new BusinessException(CommonErrConstant.ERR_BOOKING_INVOICE_EXCEPTION, "",
						new String[] { bookingVO.getId().toString() });
			invoiceVO = invoiceList.get(0);
		}

		if (SalesConstant.BOOKING_PMNT_STATUS_KIVEXP.equals(bookingVO.getPmntStatusCd())) {
			bookingVO.setPmntStatusCd(SalesConstant.BOOKING_PMNT_STATUS_KIV);
			bookingVO.setStatusCode(CommonConstant.STATUS_CD_BOOKED);

		} else if (CommonConstant.STATUS_CD_CANCELLED.equals(bookingVO.getStatusCode())
				|| CommonConstant.STATUS_CD_VOID.equals(bookingVO.getStatusCode())) {
			if (SalesConstant.BOOKING_PMNT_STATUS_KIV.equals(bookingVO.getPmntStatusCd()))
				bookingVO.setStatusCode(CommonConstant.STATUS_CD_BOOKED);
			else
				bookingVO.setStatusCode(CommonConstant.STATUS_CD_CONFIRMED);
		}

		String kivExp = LookupItemUtils.getGlobalConfigValue(MaintConstant.GLOBAL_CD_GLOBAL, MaintConstant.GLOBAL_CD_KIV_EXP);
		Calendar cal = Calendar.getInstance();
		cal.setTime(new Date());
		cal.add(Calendar.DAY_OF_MONTH, Integer.parseInt(kivExp));
		bookingVO.setDtExp(cal.getTime());

		bookingDAO.update(bookingVO);

		if (invoiceVO != null && ((CommonConstant.STATUS_CD_CANCELLED.equals(invoiceVO.getStatusCd())
				|| CommonConstant.STATUS_CD_VOID.equals(invoiceVO.getStatusCd())))) {
			if (SalesConstant.BOOKING_PMNT_STATUS_KIV.equals(bookingVO.getPmntStatusCd()))
				invoiceVO.setStatusCd(CommonConstant.STATUS_CD_INVOICED);
			else {
				if (SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT.equals(bookingVO.getPmntStatusCd()))
					invoiceVO.setStatusCd(CommonConstant.STATUS_CD_DEPOSIT_PAID);
				else if (SalesConstant.BOOKING_PMNT_STATUS_FULL.equals(bookingVO.getPmntStatusCd()))
					invoiceVO.setStatusCd(CommonConstant.STATUS_CD_FULL_PAYMENT);
				else
					invoiceVO.setStatusCd(CommonConstant.STATUS_CD_INVOICED);
			}
			invoiceDAO.updateStatus(invoiceVO);
			invoiceDAO.insertInvoiceHistory(invoiceVO.getId(), CommonConstant.ACTION_CD_UPD,
					"Reactivate Booking ID " + bookingVO.getId());

			invoiceVO = null;
			invoiceList = null;
		}

		String allotmentIncludeInft = appSettingService.getAppSettingByCode(ConstantAppSetting.ADMIN_INCL_INFT_IN_ALLOTMENT_CALC_IN_OUTBOUND).getValue();
		System.out.println("CYY allotmentIncludeInft: " + allotmentIncludeInft);

		TourDepartureVO tourDepVO = tourPkgService.getTourDepById(bookingVO.getIdTourDep());
		int flag = 0;
		if (tourDepVO.getSeatAllot().intValue() > 0) {
			int totalBook = bookingDAO.getTotalBookByTourDep(tourDepVO.getId(), bookingVO.getId(),
					bookingVO.getTypeCd());
			int balance = tourDepVO.getSeatAllot() - tourDepVO.getReservedSeat() - tourDepVO.getTourManagerPax()
					- totalBook - bookingVO.getPaxFullCeb() - bookingVO.getPaxFullCnb() - bookingVO.getPaxFullCtw()
					- bookingVO.getPaxFullTrpl() - bookingVO.getPaxFullSgl() - bookingVO.getPaxFullTwn();

			if (allotmentIncludeInft.equals("Y"))	balance -= bookingVO.getPaxFullInft();

			if (balance < 0) {
				throw new BusinessException(CommonErrConstant.ERR_BOOKING_OVER_SEAT_BALANCE);
			}

			if (balance == 0) {
				flag = 1;
			} else if (balance > 0) {
				flag = 2;
			}
		}

		// update status to full status
		if (flag == 1) {
			if (ProductConstant.TOUR_STATUS_CD_AVAILABLE.equals(tourDepVO.getTourStatusCd())
					|| ProductConstant.TOUR_STATUS_CD_LIMITED.equals(tourDepVO.getTourStatusCd())) {
				tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_FULL);
				updateVO(tourDepVO);
			}
		} else if (flag == 2) {
			if (ProductConstant.TOUR_STATUS_CD_FULL.equals(tourDepVO.getTourStatusCd())) {
				tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
				updateVO(tourDepVO);
			}
		}
	}

	@Override
	public List<BookingVO> getBookingCuiseList(TourDepartureVO tourDepVO) throws BusinessException {
		List<BookingVO> bookingList = bookingDAO.getBookingList(tourDepVO.getId());

		if (CollectionUtils.isNotEmpty(bookingList)) {
			for (BookingVO bookingVO : bookingList) {
				bookingVO.setEmployeeViewVO(userService.getEmployeeView(bookingVO.getIdEmployee()));
				bookingVO.setBookingChargeItemList(
						new ArrayList<BookingChargeItemVO>(bookingVO.getBookingChargeItemSet()));
				bookingVO.setBookingChargeItemSet(null);
				bookingVO.setCustomerVO(custService.getCustomerSimpleDetail(bookingVO.getIdCust()));
				bookingVO.setCustName(bookingVO.getCustomerVO().getCustName());
				InvoiceVO invVO = bookingDAO.getInvoiceInfo(bookingVO.getId());
				if (invVO!=null && invVO.getId()!=null) {
					bookingVO.setInvId(invVO.getId());
					bookingVO.setPsNo(invVO.getPsNo());
					if (invVO.getDocTypeCd().equals("I")) {
						bookingVO.setInvCode(invVO.getCode());
					} else if (invVO.getDocTypeCd().equals("P")) {
						bookingVO.setInvCode("");
					}
				}
				
				bookingVO.setInvList(bookingDAO.getSubDocInfo(bookingVO.getId()));
				if (bookingVO.getInvList() == null)	bookingVO.setInvList(new ArrayList<InvoiceVO>());
				bookingVO.setPaxStmtList(new ArrayList<InvoiceVO>());
				Iterator<InvoiceVO> iterator = bookingVO.getInvList().iterator();
				// take out pax stmt from inv list and insert into pax stmt list
		        while (iterator.hasNext()) {
		        	InvoiceVO invoiceVO = iterator.next();
		            if (invoiceVO.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_PAX_STMT)) {
		            	// won't show converted stmt
		            	// 2/4/2025 Booking Made Page - Display PS No. although already converted to INV (You Yuan)
//		            	if (!invoiceVO.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_CONVERTED)) {
		            		bookingVO.getPaxStmtList().add(invoiceVO);
//		            	}
		            	iterator.remove();
		            }
		        }

		        if (invVO != null) {
		        	if (invVO.getDocTypeCd() != null) {
		        		if (invVO.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_INVC)) {
		        			// if is invc, is old record before pax stmt, no need check doc type status
		        			bookingVO.getInvList().add(invVO);
		        		} else {
		        			// if is not invc, then is pax stmt, will carry doc type status
//		        			if (!invVO.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_CONVERTED)
//		        					&& !invVO.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_SPLIT)) {
//				        		bookingVO.getPaxStmtList().add(invVO);
//				        	}

		        			if (!invVO.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_SPLIT)) {
				        		bookingVO.getPaxStmtList().add(invVO);
				        	}
		        		}

		        	} else {
		        		if (invVO.getId() != null) {
		        			System.out.println("BookingServiceImpl.getBookingCuiseList() " + bookingVO.getId());
			        		System.out.println("invVO.getId(): " + invVO.getId());
			        		System.out.println("CYY invVO.getDocTypeCd() IS NULL !!!");
		        		}
		        	}

		        }

//				for (InvoiceVO vo : bookingVO.getInvList()) {
//					System.out.println("CYY bookingVO.getInvList(): " + vo.getId() + " " + vo.getCode() + " " + vo.getPsNo());
//				}

				List<TourCruiseCabinVO> cabinList = tourDepVO.getTourCruiseCabinList();
				bookingVO.setTourCruiseCabinList(new ArrayList<TourCruiseCabinVO>());
				TourCruiseCabinVO cabinVO = null;

				for (TourCruiseCabinVO ccVO : cabinList) {
					for (BookingChargeItemVO itemVO : bookingVO.getBookingChargeItemList()) {
						if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(itemVO.getTypeCd())
								&& ccVO.getId().equals(itemVO.getIdTourCruiseCabin())
								&& itemVO.getCabinQty().intValue() > 0) {
							cabinVO = new TourCruiseCabinVO();
							cabinVO.setCruiseCabinCd(ccVO.getCruiseCabinCd());
							cabinVO.setCabinAllotment(itemVO.getCabinQty());
							bookingVO.getTourCruiseCabinList().add(cabinVO);
							break;
						}
					}
				}
			}
		}
		return bookingList;
	}

	private void updBookingChargeItemListForQuote(BookingVO bookingVO, TourDepartureVO tourDepVO) throws BusinessException {

		int totFullAdultPax = bookingVO.getPaxFullTwn() + bookingVO.getPaxFullSgl() + bookingVO.getPaxFullTrpl();
		int totFullChildPax = bookingVO.getPaxFullCeb() + bookingVO.getPaxFullCnb() + bookingVO.getPaxFullCtw();
		int totGrndPax = bookingVO.getPaxGrndCeb() + bookingVO.getPaxGrndCnb() + bookingVO.getPaxGrndCtw()
				+ bookingVO.getPaxGrndSgl() + bookingVO.getPaxGrndTwn() + bookingVO.getPaxGrndTrpl();
		int totBizAdultPax = 0;
		int totBizChildPax = 0;

		int totalDiscountPax = 0;
		double totalAmount = 0;

		for (BookingChargeItemVO vo : bookingVO.getBookingChargeItemList()) {
			if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxFullSgl());
				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxFullTwn());
				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CTW.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxFullCtw());

				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CWB.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxFullCeb());

				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CNB.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxFullCnb());

				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_INFT.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxFullInft());

				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_TRIPLE.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxFullTrpl());

				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_SGL.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxGrndSgl());

				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_TWN.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxGrndTwn());

				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CTW.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxGrndCtw());

				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CWB.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxGrndCeb());

				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CNB.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxGrndCnb());

				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_INFT.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxGrndInft());

				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_TRIPLE.equals(vo.getCode())) {
				vo.setQuantity(bookingVO.getPaxGrndTrpl());

				if (vo.getQuantity() > 0)
					totalAmount += (vo.getAmount() * vo.getQuantity());
			}
			else if (ProductConstant.AIRLINE_ITM_CD_APT_ADT.equals(vo.getCode())) {
				vo.setQuantity(totFullAdultPax + totBizAdultPax);

			} else if (ProductConstant.AIRLINE_ITM_CD_APT_CHD.equals(vo.getCode())) {
				vo.setQuantity(totFullChildPax + totBizChildPax);

			} else if (ProductConstant.AIRLINE_ITM_CD_FUEL_ADT.equals(vo.getCode())) {
				vo.setQuantity(totFullAdultPax + totBizAdultPax);

			} else if (ProductConstant.AIRLINE_ITM_CD_FUEL_CHD.equals(vo.getCode())) {
				vo.setQuantity(totFullChildPax + totBizChildPax);

			} else if (ProductConstant.AIRLINE_ITM_CD_AC.equals(vo.getCode())) {
				vo.setQuantity(totFullAdultPax + totFullChildPax + totBizAdultPax + totBizChildPax);

			} else if (ProductConstant.AIRLINE_ITM_CD_DEVIATION.equals(vo.getCode())) {
				vo.setQuantity(totFullAdultPax + totFullChildPax + totBizAdultPax + totBizChildPax);

			} else if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(vo.getCode())) {
				totalDiscountPax += vo.getQuantity();

			} else {
				vo.setQuantity(totFullAdultPax + totFullChildPax + totGrndPax + totBizAdultPax + totBizChildPax);

			}
		}

		// If user deduct booking pax -START-
		int totalBookingPax = totFullAdultPax + totFullChildPax + totBizAdultPax + totBizChildPax;
		int count = 1;
		int remainingPax = 0;

		if (totalDiscountPax > totalBookingPax) {
			int paxToDeduct = totalDiscountPax - totalBookingPax;

			// Reverse deduct
			for (int i = bookingVO.getBookingChargeItemList().size() - 1; i >= 0; i--) {
				BookingChargeItemVO vo = bookingVO.getBookingChargeItemList().get(i);

				if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(vo.getCode())) {
					if (count == 1) {
						remainingPax += paxToDeduct;
						if (paxToDeduct > vo.getQuantity()) {
							remainingPax -= vo.getQuantity();
							vo.setQuantity(0);
						} else {
							vo.setQuantity(vo.getQuantity() - paxToDeduct);
							count = 3;
						}
					} else if (count == 2) {
						if (remainingPax > vo.getQuantity()) {
							vo.setQuantity(0);
							vo.setAmount(0.0);
						} else {
							vo.setQuantity(vo.getQuantity() - remainingPax);
						}
					}
					count++;
				}
			}
		}
		// If user deduct booking pax -END-
	}

	private void addCruiseBookingChargeItemList(BookingVO bookingVO, TourDepartureVO tourDepVO)
			throws BusinessException {
		List<TourDepItemVO> tourDepItemList = tourDepVO.getTourDepItemList();

		if (tourDepItemList == null) {
			tourDepItemList = tourPkgDAO.getTourDepItemList(tourDepVO.getId(), bookingVO.getIdCompany(), null);
		}

		if (CollectionUtils.isNotEmpty(bookingVO.getTourCruiseCabinList())) {
//			if (bookingVO.getBookingChargeItemList() == null) {
			bookingVO.setBookingChargeItemList(new ArrayList<BookingChargeItemVO>());
//			}

			BookingChargeItemVO itemVO = null;
			TourDepItemVO tourDepItemVO = new TourDepItemVO();

			double totalAmount = 0.0;
			boolean isMisc = false;

			int count = 0;
			for (TourDepItemVO vo : tourDepItemList) {
				isMisc = false;
				System.out.println("vo.getCode: " + vo.getCode());
				System.out.println("vo.getDesc: " + vo.getDesc());
				System.out.println("vo.getAmount: " + vo.getAmount());
				System.out.println("vo.getAcctId: " + vo.getAcctId());
				itemVO = new BookingChargeItemVO();
				isMisc = vo.getIsMisc();

				itemVO.setIdBooking(bookingVO.getId());
				itemVO.setIdAcct(vo.getAcctId());
				itemVO.setIdInvEoItem(vo.getIdInvEoItem());
				itemVO.setCode(vo.getCode());
				itemVO.setDesc(vo.getDesc());
				itemVO.setAmount(vo.getAmount());
				itemVO.setTypeCd(vo.getTypeCd());
				itemVO.setIsMisc(isMisc);
				if (vo.getAmount().doubleValue() > 0) {
					itemVO.setQuantity(bookingVO.getTotalHeadCount());
					insertVO(itemVO);
					bookingVO.getBookingChargeItemList().add(itemVO);
					totalAmount += vo.getAmount() * itemVO.getQuantity();
				}
				if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(vo.getCode())) {
					tourDepItemVO = vo;
				}
			}

			for (TourCruiseCabinVO vo : bookingVO.getTourCruiseCabinList()) {

				itemVO = new BookingChargeItemVO();

				itemVO.setIdBooking(bookingVO.getId());
				itemVO.setIdAcct(vo.getIdAcct());
				itemVO.setIdInvEoItem(null);
				itemVO.setCode(vo.getCruiseCabinCd());
				itemVO.setDesc(vo.getCruiseCabinDesc());
				itemVO.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_TOUR);

				itemVO.setAmount(vo.getPriceTwn());
				itemVO.setAmount3(vo.getPrice3());
				itemVO.setAmount4(vo.getPrice4());
				itemVO.setAmountSgl(vo.getPriceSgl());
				itemVO.setAmount3Chd(vo.getPrice3Chd());
				itemVO.setAmount4Chd(vo.getPrice4Chd());
				itemVO.setAmountInf(vo.getPriceInf());

				itemVO.setIdTourCruiseCabin(vo.getIdTourCruiseCabin());
				itemVO.setQuantity(vo.getPaxTwn());
				itemVO.setQuantity3(vo.getPax3());
				itemVO.setQuantity4(vo.getPax4());
				itemVO.setQuantitySgl(vo.getPaxSgl());
				itemVO.setQuantity3Chd(vo.getPax3Chd());
				itemVO.setQuantity4Chd(vo.getPax4Chd());
				itemVO.setQuantityInf(vo.getPaxInf());
				itemVO.setCabinQty(vo.getTtlCabin());
				insertVO(itemVO);
				bookingVO.getBookingChargeItemList().add(itemVO);

				totalAmount += (itemVO.getAmount()*itemVO.getQuantity())
						+ (itemVO.getAmount3()*itemVO.getQuantity3())
						+ (itemVO.getAmount4()*itemVO.getQuantity4())
						+ (itemVO.getAmountSgl()*itemVO.getQuantitySgl())
						+ (itemVO.getAmount3Chd()*itemVO.getQuantity3Chd())
						+ (itemVO.getAmount4Chd()*itemVO.getQuantity4Chd())
						+ (itemVO.getAmountInf()*itemVO.getQuantityInf());

				// tour cabin discount logic
				List<TourCruiseCabinDiscountVO> discountList = tourCruiseCabinService
						.getTourCruiseCabinDiscountList(vo.getIdTourCruiseCabin());
				int remainingPax = vo.getPaxTwn() + vo.getPax3() + vo.getPax4() + vo.getPaxSgl() + vo.getPax3Chd() + vo.getPax4Chd() + vo.getPaxInf();

				for (TourCruiseCabinDiscountVO discountVO : discountList) {
					itemVO = new BookingChargeItemVO();

					itemVO.setIdBooking(bookingVO.getId());
					itemVO.setIdTourCruiseCabin(vo.getIdTourCruiseCabin());
					itemVO.setIdAcct(tourDepItemVO.getAcctId());
//					itemVO.setIdAcct(vo.getIdAcct());
					itemVO.setIdInvEoItem(null);
					itemVO.setCode(ProductConstant.TOUR_DEP_ITM_CD_DISC + "_" + vo.getCruiseCabinCd());
					itemVO.setDesc("DISCOUNT " + vo.getCruiseCabinDesc());
					itemVO.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE);
					itemVO.setAmount(0.0);

					if (remainingPax <= 0) {
						itemVO.setQuantity(0);
						insertVO(itemVO);
						bookingVO.getBookingChargeItemList().add(itemVO);
						break;
					}

					int availableDiscountPax = discountVO.getDiscountPax();
					double availableDiscountAmt = discountVO.getDiscountAmt();

					if (availableDiscountPax <= 0 || availableDiscountAmt <= 0) {
						itemVO.setQuantity(0);
						insertVO(itemVO);
						bookingVO.getBookingChargeItemList().add(itemVO);
						continue;
					}

					itemVO.setAmount(
							availableDiscountAmt > 0 ? -discountVO.getDiscountAmt() : discountVO.getDiscountAmt());

					if (availableDiscountPax >= remainingPax) {
						discountVO.setDiscountPax(discountVO.getDiscountPax() - remainingPax);
						itemVO.setQuantity(remainingPax);

						remainingPax = 0;
					} else {
						remainingPax = remainingPax - availableDiscountPax;

						discountVO.setDiscountPax(discountVO.getDiscountPax() - availableDiscountPax);
						itemVO.setQuantity(availableDiscountPax);
					}
					// }

					updateVO(discountVO);
					insertVO(itemVO);
					bookingVO.getBookingChargeItemList().add(itemVO);

					totalAmount += itemVO.getAmount() * itemVO.getQuantity();
				}
			}

			bookingVO.setAmount(totalAmount);
		}
	}

