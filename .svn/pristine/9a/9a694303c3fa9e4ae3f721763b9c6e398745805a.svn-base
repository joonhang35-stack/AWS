	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.BookingService#transferBooking(java.lang.Long, java.lang.Long, boolean)
	 */
	@Override
	public InvoiceVO transferBooking(Long idBooking, Long idTourDep, Date invDate, TourDepartureVO tourDepVO, boolean isReturnValue) throws BusinessException {
		if (idTourDep.equals(tourDepVO.getId())) throw new BusinessException(CommonErrConstant.ERR_BOOKING_TRANSFER_SAME_TOUR_DEP);
		tourDepVO = tourPkgService.getTourDepById(tourDepVO.getId());

		// update current booking to cancel
		BookingVO bookingVO = bookingDAO.getBooking(idBooking);
		if (!CommonConstant.STATUS_CD_CANCELLED.equals(bookingVO.getStatusCode()) && !CommonConstant.STATUS_CD_VOID.equals(bookingVO.getStatusCode())) {
			bookingVO.setStatusCode(CommonConstant.STATUS_CD_CANCELLED);
			updateVO(bookingVO);
		}

		// add new booking
		BookingVO vo = new BookingVO();
		vo.setIdTourDep(tourDepVO.getId());
		vo.setIdCompany(bookingVO.getIdCompany());
		vo.setIdEmployee(bookingVO.getIdEmployee());
		vo.setIdCust(bookingVO.getIdCust());
		vo.setOrderTypeCd(bookingVO.getOrderTypeCd());
		vo.setQuantity(bookingVO.getQuantity());
		vo.setPmntStatusCd(bookingVO.getPmntStatusCd());
		if (SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT.equals(bookingVO.getPmntStatusCd()) ||
				SalesConstant.BOOKING_PMNT_STATUS_FULL.equals(bookingVO.getPmntStatusCd()))
			vo.setStatusCode(CommonConstant.STATUS_CD_CONFIRMED);
		else if (SalesConstant.BOOKING_PMNT_STATUS_KIV.equals(bookingVO.getPmntStatusCd()))
			vo.setStatusCode(CommonConstant.STATUS_CD_BOOKED);
		else vo.setStatusCode(bookingVO.getStatusCode());
		vo.setDtExp(bookingVO.getDtExp());
		for (BookingChargeItemVO itemVO : bookingVO.getBookingChargeItemSet()) {
			if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(itemVO.getCode())) { vo.setPaxFullSgl(itemVO.getQuantity()); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(itemVO.getCode())) { vo.setPaxFullTwn(itemVO.getQuantity()); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CTW.equals(itemVO.getCode())) { vo.setPaxFullCtw(itemVO.getQuantity()); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CWB.equals(itemVO.getCode())) { vo.setPaxFullCeb(itemVO.getQuantity()); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CNB.equals(itemVO.getCode())) { vo.setPaxFullCnb(itemVO.getQuantity()); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_FT_INFT.equals(itemVO.getCode())) { vo.setPaxFullInft(itemVO.getQuantity()); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_GA_SGL.equals(itemVO.getCode())) { vo.setPaxGrndSgl(itemVO.getQuantity()); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_GA_TWN.equals(itemVO.getCode())) { vo.setPaxGrndTwn(itemVO.getQuantity()); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CTW.equals(itemVO.getCode())) { vo.setPaxGrndCtw(itemVO.getQuantity()); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CWB.equals(itemVO.getCode())) { vo.setPaxGrndCeb(itemVO.getQuantity()); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CNB.equals(itemVO.getCode())) { vo.setPaxGrndCnb(itemVO.getQuantity()); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_GA_INFT.equals(itemVO.getCode())) { vo.setPaxGrndInft(itemVO.getQuantity()); }
		}

		// if seat balance is 0, throw error msg
		int totalBook = 0;
		int balance = 0;
		if (tourDepVO.getSeatAllot().intValue() > 0) {
			totalBook = bookingDAO.getTotalBookByTourDep(tourDepVO.getId(), null);
			balance = tourDepVO.getSeatAllot() - tourDepVO.getTourManagerPax() - tourDepVO.getReservedSeat() - totalBook -
					vo.getPaxFullCeb() - vo.getPaxFullCnb() - vo.getPaxFullCtw() - vo.getPaxFullSgl() - vo.getPaxFullTwn();
			if (balance < 0) throw new BusinessException(CommonErrConstant.ERR_BOOKING_OVER_SEAT_BALANCE);
			if (balance == 0) {
				tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_FULL);
				updateVO(tourDepVO);
			}
		}
		insertVO(vo);

		// add new booking item
		tourDepVO.setTourDepItemList(tourPkgService.getTourDepItemList(tourDepVO.getId(), bookingVO.getIdCompany()));
		addBookingChargeItemList(vo, tourDepVO);

		// add booking sales commission
		addBookingSalesComm(vo, tourDepVO);

		// update previous tour dep status
		TourDepartureVO prevTourDepVO =  tourPkgService.getTourDepById(bookingVO.getIdTourDep());
		if (prevTourDepVO.getSeatAllot().intValue() > 0) {
			if (ProductConstant.TOUR_STATUS_CD_FULL.equals(prevTourDepVO.getTourStatusCd())) {
				prevTourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
				updateVO(prevTourDepVO);

				/*totalBook = bookingDAO.getTotalBookByTourDep(prevTourDepVO.getId(), null);
				balance = prevTourDepVO.getSeatAllot() - prevTourDepVO.getTourManagerPax() - prevTourDepVO.getReservedSeat() - totalBook;
				if (balance > 0) {
					prevTourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
					updateVO(prevTourDepVO);
				}*/
			}
		}

		// return invoice object
		if (isReturnValue) {
			boolean isGSTPeriod = gstService.isGSTPeriod(bookingVO.getIdCompany(), invDate);
			List<TourDepItemVO> tourDepItemVOList = null;
			if (isGSTPeriod) {
				tourDepItemVOList = tourPkgService.getTourDepItemList(tourDepVO.getId(), bookingVO.getIdCompany());
			}

			TourPackageVO tourPkgVO = tourPkgService.getTourPackageById(tourDepVO.getIdTourPkg());
			InvoiceVO invVO = new InvoiceVO();
			invVO.setInvoiceDt(invDate);
			invVO.setCustomerId(vo.getIdCust());
			invVO.setBookingId(vo.getId());
			invVO.setTourCd(tourDepVO.getCode());
			invVO.setTourDepId(tourDepVO.getId());
			invVO.setSubjLine(tourDepVO.getDesc());
			invVO.setDepartureDt(tourDepVO.getDtDep());
			invVO.setOrderCd(vo.getOrderTypeCd());
			invVO.setCatCd(CommonConstant.LOOKUP_ITM_INV_CAT_TOUR);
			StringBuilder sb = new StringBuilder();
			sb.append(tourDepVO.getNumDays() + "Days " + tourDepVO.getNumNights() + "Nights ");
			if (!StringUtils.isEmpty(tourPkgVO.getNameEn())) sb.append(tourPkgVO.getNameEn());
			if (!StringUtils.isEmpty(tourPkgVO.getNameZh())) sb.append(" " + tourPkgVO.getNameZh());
			if (!StringUtils.isEmpty(tourPkgVO.getNameOther())) sb.append(" " + tourPkgVO.getNameOther());
			invVO.setSubjLine(sb.toString());
			if (StringUtils.isNotEmpty(tourDepVO.getLangCode())) {
				invVO.setSubjLine(invVO.getSubjLine() + " [" +
					LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_PRODUCT_LANG, tourDepVO.getLangCode()) +
				"]");
			}

			invVO.setInvoiceItemList(new ArrayList<InvoiceItemVO>());
			for (BookingChargeItemVO itemVO : vo.getBookingChargeItemList()) {
				if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0) {
					InvoiceItemVO invItemVO = new InvoiceItemVO();
					invItemVO.setAcctId(itemVO.getIdAcct());
					invItemVO.setInvEOItemId(itemVO.getIdInvEoItem());
					invItemVO.setInvItemCd(itemVO.getCode());
					invItemVO.setCode(itemVO.getCode());
					invItemVO.setDesc(itemVO.getDesc());
					invItemVO.setQty(itemVO.getQuantity());
					invItemVO.setUnitPrice(itemVO.getAmount());
					invItemVO.setAmount(itemVO.getAmount() * itemVO.getQuantity());
					invItemVO.setAirfare(itemVO.getAirfare());
					if(itemVO.getIsLock() != null) invItemVO.setIsLock(itemVO.getIsLock()); else itemVO.setIsLock(false);
					// set GST info
					if (CollectionUtils.isNotEmpty(tourDepItemVOList)) {
						for (TourDepItemVO tourDepItemVO : tourDepItemVOList) {
							if (tourDepItemVO.getCode().equals(itemVO.getCode())) {
								invItemVO.setTaxCode(tourDepItemVO.getTaxCode());
								invItemVO.setTaxRate(tourDepItemVO.getTaxRate());
								tourDepItemVOList.remove(tourDepItemVO);
								break;
							}
						}
					} else {
						invItemVO.setTaxCode(null);
						invItemVO.setTaxRate(null);
					}
					invVO.getInvoiceItemList().add(invItemVO);
				}
			}
			return invVO;
		}

		InvoiceVO invVO = new InvoiceVO();
		invVO.setBookingId(vo.getId());
		return invVO;
	}

