	/**********
	 * HELPER *
	 **********/

	private void addBookingChargeItemList(BookingVO bookingVO, TourDepartureVO tourDepVO) throws BusinessException {
		List<TourDepItemVO> tourDepItemList = tourDepVO.getTourDepItemList();

		if (CollectionUtils.isNotEmpty(tourDepItemList)) {
			if (bookingVO.getBookingChargeItemList() == null) bookingVO.setBookingChargeItemList(new ArrayList<BookingChargeItemVO>());

			BookingChargeItemVO itemVO = null;
			int totFullAdultPax = bookingVO.getPaxFullTwn() + bookingVO.getPaxFullSgl();
			int totFullChildPax = bookingVO.getPaxFullCeb() + bookingVO.getPaxFullCnb() + bookingVO.getPaxFullCtw();
			int totGrndPax = bookingVO.getPaxGrndCeb() + bookingVO.getPaxGrndCnb() + bookingVO.getPaxGrndCtw() + bookingVO.getPaxGrndSgl() + bookingVO.getPaxGrndTwn();

			for (TourDepItemVO vo : tourDepItemList) {
				itemVO = new BookingChargeItemVO();

				itemVO.setIdBooking(bookingVO.getId());
				itemVO.setIdAcct(vo.getAcctId());
				itemVO.setIdInvEoItem(vo.getIdInvEoItem());
				itemVO.setCode(vo.getCode());
				itemVO.setDesc(vo.getDesc());
				itemVO.setAmount(vo.getAmount());
				itemVO.setTypeCd(vo.getTypeCd());
				if(vo.getIsLock() != null) itemVO.setIsLock(vo.getIsLock()); else itemVO.setIsLock(false);
				if(vo.getIsMisc() != null) itemVO.setIsMisc(vo.getIsMisc()); else itemVO.setIsMisc(false);
				if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(vo.getCode())) { itemVO.setQuantity(bookingVO.getPaxFullSgl()); itemVO.setAirfare(vo.getAirfare()); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(vo.getCode())) { itemVO.setQuantity(bookingVO.getPaxFullTwn()); itemVO.setAirfare(vo.getAirfare()); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CTW.equals(vo.getCode())) { itemVO.setQuantity(bookingVO.getPaxFullCtw()); itemVO.setAirfare(vo.getAirfare()); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CWB.equals(vo.getCode())) { itemVO.setQuantity(bookingVO.getPaxFullCeb()); itemVO.setAirfare(vo.getAirfare()); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CNB.equals(vo.getCode())) { itemVO.setQuantity(bookingVO.getPaxFullCnb()); itemVO.setAirfare(vo.getAirfare()); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_FT_INFT.equals(vo.getCode())) { itemVO.setQuantity(bookingVO.getPaxFullInft()); itemVO.setAirfare(vo.getAirfare()); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_GA_SGL.equals(vo.getCode())) { itemVO.setQuantity(bookingVO.getPaxGrndSgl()); itemVO.setAirfare(0.0); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_GA_TWN.equals(vo.getCode())) { itemVO.setQuantity(bookingVO.getPaxGrndTwn()); itemVO.setAirfare(0.0); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CTW.equals(vo.getCode())) { itemVO.setQuantity(bookingVO.getPaxGrndCtw()); itemVO.setAirfare(0.0); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CWB.equals(vo.getCode())) { itemVO.setQuantity(bookingVO.getPaxGrndCeb()); itemVO.setAirfare(0.0); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CNB.equals(vo.getCode())) { itemVO.setQuantity(bookingVO.getPaxGrndCnb()); itemVO.setAirfare(0.0); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_GA_INFT.equals(vo.getCode())) { itemVO.setQuantity(bookingVO.getPaxGrndInft()); itemVO.setAirfare(0.0); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.AIRLINE_ITM_CD_APT_ADT.equals(vo.getCode())) { itemVO.setQuantity(totFullAdultPax); itemVO.setAirfare(0.0); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.AIRLINE_ITM_CD_APT_CHD.equals(vo.getCode())) { itemVO.setQuantity(totFullChildPax); itemVO.setAirfare(0.0); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.AIRLINE_ITM_CD_FUEL_ADT.equals(vo.getCode())) { itemVO.setQuantity(totFullAdultPax); itemVO.setAirfare(0.0); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.AIRLINE_ITM_CD_FUEL_CHD.equals(vo.getCode())) { itemVO.setQuantity(totFullChildPax); itemVO.setAirfare(0.0); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.AIRLINE_ITM_CD_AC.equals(vo.getCode())) { itemVO.setQuantity(totFullAdultPax + totFullChildPax); itemVO.setAirfare(0.0); insertVO(itemVO); bookingVO.getBookingChargeItemList().add(itemVO); }
				else if (ProductConstant.AIRLINE_ITM_CD_DEVIATION.equals(vo.getCode())) {
					if (vo.getAcctId() != null) {
						itemVO.setQuantity(totFullAdultPax + totFullChildPax);
						itemVO.setAirfare(0.0);
						insertVO(itemVO);
						bookingVO.getBookingChargeItemList().add(itemVO);
					}
				} else {
					if (vo.getAcctId() != null) {
						if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(vo.getCode())) {
							List<TourDepartureDiscountVO> tourDepDiscountList = tourPkgDAO.getTourDepDiscount(tourDepVO.getId());

							int remainingPax = totFullAdultPax + totFullChildPax;
							for (TourDepartureDiscountVO discountVO : tourDepDiscountList) {
								itemVO = new BookingChargeItemVO();

								itemVO.setIdBooking(bookingVO.getId());
								itemVO.setIdAcct(vo.getAcctId());
								itemVO.setIdInvEoItem(vo.getIdInvEoItem());
								itemVO.setCode(vo.getCode());
								itemVO.setDesc(vo.getDesc());
								itemVO.setAmount(vo.getAmount());
								itemVO.setTypeCd(vo.getTypeCd());
								if(vo.getIsLock() != null) itemVO.setIsLock(vo.getIsLock()); else itemVO.setIsLock(false);

								itemVO.setAmount(discountVO.getDiscountAmt() > 0 ? -discountVO.getDiscountAmt() : discountVO.getDiscountAmt());

								if (remainingPax <= 0) {
									itemVO.setQuantity(0);
									itemVO.setAirfare(0.0);
									insertVO(itemVO);
									bookingVO.getBookingChargeItemList().add(itemVO);
									break;
								}

								int availableDiscountPax = discountVO.getDiscountPax();

								if (availableDiscountPax <= 0) {
									itemVO.setQuantity(0);
									itemVO.setAirfare(0.0);
									insertVO(itemVO);
									bookingVO.getBookingChargeItemList().add(itemVO);
									continue;
								}

								if (availableDiscountPax >= remainingPax) {
									discountVO.setDiscountPax(discountVO.getDiscountPax() - remainingPax);
									itemVO.setQuantity(remainingPax);
									itemVO.setAirfare(0.0);

									remainingPax = 0;
								} else {
									remainingPax = remainingPax - availableDiscountPax;

									discountVO.setDiscountPax(discountVO.getDiscountPax() - availableDiscountPax);
									itemVO.setQuantity(availableDiscountPax);
									itemVO.setAirfare(0.0);
								}

								updateVO(discountVO);
								insertVO(itemVO);
								bookingVO.getBookingChargeItemList().add(itemVO);
							}
						} else {
							itemVO.setQuantity(totFullAdultPax + totFullChildPax + totGrndPax);
							itemVO.setAirfare(0.0);

							insertVO(itemVO);
							bookingVO.getBookingChargeItemList().add(itemVO);
						}
					}
				}
			}
		}
	}

	/*
	 *
	 * @param bookingVO
	 */
	private void updBookingChargeItemList(BookingVO bookingVO) throws BusinessException {
		//List<BookingChargeItemVO> bookingChargeItemList = new ArrayList<BookingChargeItemVO>();
		//int totPax = 0;
		int totFullAdultPax = bookingVO.getPaxFullTwn() + bookingVO.getPaxFullSgl();
		int totFullChildPax = bookingVO.getPaxFullCeb() + bookingVO.getPaxFullCnb() + bookingVO.getPaxFullCtw();
		int totGrndPax = bookingVO.getPaxGrndCeb() + bookingVO.getPaxGrndCnb() + bookingVO.getPaxGrndCtw() + bookingVO.getPaxGrndSgl() + bookingVO.getPaxGrndTwn();

		int totalDiscountPax = 0;
		for (BookingChargeItemVO vo : bookingVO.getBookingChargeItemList()) {
			if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(vo.getCode())) { vo.setQuantity(bookingVO.getPaxFullSgl()); updateVO(vo); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(vo.getCode())) { vo.setQuantity(bookingVO.getPaxFullTwn()); updateVO(vo); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CTW.equals(vo.getCode())) { vo.setQuantity(bookingVO.getPaxFullCtw()); updateVO(vo); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CWB.equals(vo.getCode())) { vo.setQuantity(bookingVO.getPaxFullCeb()); updateVO(vo); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CNB.equals(vo.getCode())) { vo.setQuantity(bookingVO.getPaxFullCnb()); updateVO(vo); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_FT_INFT.equals(vo.getCode())) { vo.setQuantity(bookingVO.getPaxFullInft()); updateVO(vo); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_GA_SGL.equals(vo.getCode())) { vo.setQuantity(bookingVO.getPaxGrndSgl()); updateVO(vo); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_GA_TWN.equals(vo.getCode())) { vo.setQuantity(bookingVO.getPaxGrndTwn()); updateVO(vo); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CTW.equals(vo.getCode())) { vo.setQuantity(bookingVO.getPaxGrndCtw()); updateVO(vo); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CWB.equals(vo.getCode())) { vo.setQuantity(bookingVO.getPaxGrndCeb()); updateVO(vo); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CNB.equals(vo.getCode())) { vo.setQuantity(bookingVO.getPaxGrndCnb()); updateVO(vo); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_GA_INFT.equals(vo.getCode())) { vo.setQuantity(bookingVO.getPaxGrndInft()); updateVO(vo); }
			//else if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(vo.getCode())) { vo.setQuantity(totFullAdultPax + totFullChildPax); updateVO(vo); }
			else if (ProductConstant.AIRLINE_ITM_CD_APT_ADT.equals(vo.getCode())) { vo.setQuantity(totFullAdultPax); updateVO(vo); }
			else if (ProductConstant.AIRLINE_ITM_CD_APT_CHD.equals(vo.getCode())) { vo.setQuantity(totFullChildPax); updateVO(vo); }
			else if (ProductConstant.AIRLINE_ITM_CD_FUEL_ADT.equals(vo.getCode())) { vo.setQuantity(totFullAdultPax); updateVO(vo); }
			else if (ProductConstant.AIRLINE_ITM_CD_FUEL_CHD.equals(vo.getCode())) { vo.setQuantity(totFullChildPax); updateVO(vo); }
			else if (ProductConstant.AIRLINE_ITM_CD_AC.equals(vo.getCode())) { vo.setQuantity(totFullAdultPax + totFullChildPax); updateVO(vo); }
			else if (ProductConstant.AIRLINE_ITM_CD_DEVIATION.equals(vo.getCode())) { vo.setQuantity(totFullAdultPax + totFullChildPax); updateVO(vo); }
			else if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(vo.getCode())) {
				totalDiscountPax += vo.getQuantity();

				if (vo.getId() != null)
					updateVO(vo);
				else
					insertVO(vo);

			} else { vo.setQuantity(totFullAdultPax + totFullChildPax + totGrndPax); updateVO(vo); }
			/*else {
				vo.setQuantity(0);
				bookingChargeItemList.add(vo);
			}
			totPax += vo.getQuantity();*/
		}

		// If user deduct booking pax -START-
		int totalBookingPax = totFullAdultPax + totFullChildPax;
		int count = 1;
		int remainingPax = 0;
		if (totalDiscountPax > totalBookingPax) {
			int paxToDeduct = totalDiscountPax - totalBookingPax;

			// Reverse deduct
			for (int i = bookingVO.getBookingChargeItemList().size() - 1; i >= 0; i--) {
				BookingChargeItemVO vo = bookingVO.getBookingChargeItemList().get(i);

				if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(vo.getCode())) {
					if (count == 1) {
						remainingPax += paxToDeduct;
						if (paxToDeduct > vo.getQuantity()) {
							remainingPax -= vo.getQuantity();
							vo.setQuantity(0);
						} else {
							vo.setQuantity(vo.getQuantity() - paxToDeduct);
							count = 3;
						}
					} else if (count == 2) {
						if (remainingPax > vo.getQuantity()) {
							vo.setQuantity(0);
							vo.setAmount(0.0);
						} else {
							vo.setQuantity(vo.getQuantity() - remainingPax);
						}
					}
					count++;
				}
				updateVO(vo);
			}
		}
		// If user deduct booking pax -END-

		/*if (CollectionUtils.isNotEmpty(bookingChargeItemList)) {
			for (BookingChargeItemVO vo : bookingChargeItemList) {
				vo.setQuantity(totPax);
				updateVO(vo);
			}
		}*/
	}

