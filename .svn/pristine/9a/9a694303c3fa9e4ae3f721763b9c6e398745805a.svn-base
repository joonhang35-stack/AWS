	private void addBookingSalesComm(BookingVO bookingVO, TourDepartureVO tourDepVO) throws BusinessException {
		Double fullTwnAmt = 0.00, grndTwnAmt = 0.00;
		for (BookingChargeItemVO vo : bookingVO.getBookingChargeItemList()) {
			if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(vo.getCode())) {
				fullTwnAmt = vo.getAmount();
			} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_TWN.equals(vo.getCode())) {
				grndTwnAmt = vo.getAmount();
			}
		}

		List<SalesCommConfigDetailVO> salesCommConfigDetailList = salesCommConfigDAO.getSalesCommConfigDetailListByIdTourPkg(tourDepVO.getIdTourPkg());

		if (CollectionUtils.isNotEmpty(salesCommConfigDetailList)) {
			boolean setFTComm = false;
			boolean setGAComm = false;
			for (SalesCommConfigDetailVO dtlVO : salesCommConfigDetailList) {
				setFTComm = false;
				if (ProductConstant.TOUR_FARE_RANGE_TYPE_LT.equals(dtlVO.getFareRangetype()) && (Double.compare(fullTwnAmt, dtlVO.getFrAmt()) < 0 || Double.compare(fullTwnAmt, dtlVO.getFrAmt()) == 0)) {
					setFTComm = true;
				} else if (ProductConstant.TOUR_FARE_RANGE_TYPE_RG.equals(dtlVO.getFareRangetype()) &&
					((Double.compare(fullTwnAmt, dtlVO.getFrAmt()) > 0 || Double.compare(fullTwnAmt, dtlVO.getFrAmt()) == 0)  &&
					(Double.compare(fullTwnAmt, dtlVO.getToAmt()) < 0 || Double.compare(fullTwnAmt, dtlVO.getToAmt()) == 0))) {
					setFTComm = true;
				} else if (ProductConstant.TOUR_FARE_RANGE_TYPE_GT.equals(dtlVO.getFareRangetype()) && (Double.compare(fullTwnAmt, dtlVO.getFrAmt()) > 0 || Double.compare(fullTwnAmt, dtlVO.getFrAmt()) == 0)) {
					setFTComm = true;
				}

				if (setFTComm) {
					BookingSalesCommVO bookingSalesCommVO = new BookingSalesCommVO();
					bookingSalesCommVO.setIdTourBooking(bookingVO.getId());
					bookingSalesCommVO.setIdSalesCommConfDtl(dtlVO.getId());
					bookingSalesCommVO.setFareRangetype(dtlVO.getFareRangetype());
					bookingSalesCommVO.setTourType(ProductConstant.TOUR_TYPE_FULL_TOUR);
					bookingSalesCommVO.setFrAmt(dtlVO.getFrAmt());
					bookingSalesCommVO.setToAmt(dtlVO.getToAmt());
					bookingSalesCommVO.setTourFare(fullTwnAmt);
					bookingSalesCommVO.setSpComm(dtlVO.getSpComm());
					bookingSalesCommVO.setRefSpComm(dtlVO.getRefSpComm());
					bookingSalesCommVO.setSsComm(dtlVO.getSsComm());
					bookingSalesCommVO.setHodComm(dtlVO.getHodComm());
					bookingSalesCommVO.setOpComm(dtlVO.getOpComm());
					bookingSalesCommVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
					insertVO(bookingSalesCommVO);
					break;
				}
			}

			for (SalesCommConfigDetailVO dtlVO : salesCommConfigDetailList) {
				setGAComm = false;
				if (ProductConstant.TOUR_FARE_RANGE_TYPE_LT.equals(dtlVO.getFareRangetype()) && (Double.compare(grndTwnAmt, dtlVO.getFrAmt()) < 0 || Double.compare(grndTwnAmt, dtlVO.getFrAmt()) == 0)) {
					setGAComm = true;
				} else if (ProductConstant.TOUR_FARE_RANGE_TYPE_RG.equals(dtlVO.getFareRangetype()) &&
					((Double.compare(grndTwnAmt, dtlVO.getFrAmt()) > 0 || Double.compare(grndTwnAmt, dtlVO.getFrAmt()) == 0)  &&
					(Double.compare(grndTwnAmt, dtlVO.getToAmt()) < 0 || Double.compare(grndTwnAmt, dtlVO.getToAmt()) == 0))) {
					setGAComm = true;
				} else if (ProductConstant.TOUR_FARE_RANGE_TYPE_GT.equals(dtlVO.getFareRangetype()) && (Double.compare(grndTwnAmt, dtlVO.getFrAmt()) > 0 || Double.compare(grndTwnAmt, dtlVO.getFrAmt()) == 0)) {
					setGAComm = true;
				}

				if (setGAComm) {
					BookingSalesCommVO bookingSalesCommVO = new BookingSalesCommVO();
					bookingSalesCommVO.setIdTourBooking(bookingVO.getId());
					bookingSalesCommVO.setIdSalesCommConfDtl(dtlVO.getId());
					bookingSalesCommVO.setFareRangetype(dtlVO.getFareRangetype());
					bookingSalesCommVO.setTourType(ProductConstant.TOUR_TYPE_GROUND_ONLY);
					bookingSalesCommVO.setFrAmt(dtlVO.getFrAmt());
					bookingSalesCommVO.setToAmt(dtlVO.getToAmt());
					bookingSalesCommVO.setTourFare(grndTwnAmt);
					bookingSalesCommVO.setSpComm(dtlVO.getSpComm());
					bookingSalesCommVO.setRefSpComm(dtlVO.getRefSpComm());
					bookingSalesCommVO.setSsComm(dtlVO.getSsComm());
					bookingSalesCommVO.setHodComm(dtlVO.getHodComm());
					bookingSalesCommVO.setOpComm(dtlVO.getOpComm());
					bookingSalesCommVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
					insertVO(bookingSalesCommVO);
					break;
				}
			}
		}
	}

