	private void updCruiseBookingChargeItemList(BookingVO bookingVO, TourDepartureVO tourDepVO)
			throws BusinessException {
		List<TourDepItemVO> tourDepItemList = tourDepVO.getTourDepItemList();
		if (tourDepItemList == null) tourDepItemList = tourPkgDAO.getTourDepItemList(tourDepVO.getId(), tourDepVO.getIdCompany(), null);

		if (CollectionUtils.isNotEmpty(bookingVO.getTourCruiseCabinList())) {
			if (bookingVO.getBookingChargeItemList() == null)
				bookingVO.setBookingChargeItemList(new ArrayList<BookingChargeItemVO>());

			double totalAmount = 0.0;

			for (BookingChargeItemVO vo : bookingVO.getBookingChargeItemList()) {

				if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(vo.getTypeCd())) {
					vo.setQuantity(0);
					vo.setQuantity3(0);
					vo.setQuantity4(0);
					vo.setQuantitySgl(0);
					vo.setQuantity3Chd(0);
					vo.setQuantity4Chd(0);
					vo.setQuantityInf(0);
					vo.setCabinQty(0);
					updateVO(vo);
				} else {
					if (vo.getAmount().doubleValue() > 0) {
						vo.setQuantity(bookingVO.getTotalHeadCount());
						updateVO(vo);
						totalAmount += vo.getAmount() * vo.getQuantity();
					}
				}
			}

			BookingChargeItemVO itemVO = null;
			boolean isExited = false;
			int totalBookingPax = 0;
			int totalDiscountPax = 0;
			TourDepItemVO tourDepItemVO = new TourDepItemVO();

			for (TourDepItemVO depItemVO : tourDepItemList) {
				if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(depItemVO.getCode())) {
					tourDepItemVO = depItemVO;
					break;
				}
			}

			for (TourCruiseCabinVO vo : bookingVO.getTourCruiseCabinList()) {
				isExited = false;
				totalBookingPax = 0;
				totalDiscountPax = 0;

				for (BookingChargeItemVO vo2 : bookingVO.getBookingChargeItemList()) {
					if (vo.getIdTourCruiseCabin().equals(vo2.getIdTourCruiseCabin())) {
						if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(vo2.getTypeCd())) {
							vo2.setQuantity(vo.getPaxTwn());
							vo2.setQuantity3(vo.getPax3());
							vo2.setQuantity4(vo.getPax4());
							vo2.setQuantitySgl(vo.getPaxSgl());
							vo2.setQuantity3Chd(vo.getPax3Chd());
							vo2.setQuantity4Chd(vo.getPax4Chd());
							vo2.setQuantityInf(vo.getPaxInf());
							vo2.setCabinQty(vo.getTtlCabin());
							isExited = true;
							updateVO(vo2);
							totalBookingPax = vo.getPaxTwn() + vo.getPax3() + vo.getPax4() + vo.getPaxSgl() + vo.getPax3Chd() + vo.getPax4Chd()
									+ vo.getPaxInf();

							totalAmount += (vo2.getAmount()*vo2.getQuantity())
									+ (vo2.getAmount3()*vo2.getQuantity3())
									+ (vo2.getAmount4()*vo2.getQuantity4())
									+ (vo2.getAmountSgl()*vo2.getQuantitySgl())
									+ (vo2.getAmount3Chd()*vo2.getQuantity3Chd())
									+ (vo2.getAmount4Chd()*vo2.getQuantity4Chd())
									+ (vo2.getAmountInf()*vo2.getQuantityInf());
							// break;
						} else if (ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE.equals(vo2.getTypeCd())
								&& vo2.getCode().startsWith(ProductConstant.TOUR_DEP_ITM_CD_DISC)) {
							totalDiscountPax += vo2.getQuantity();
						}
					}
				}

				if (isExited) {
					// If user deduct booking pax -START-
					int count = 1;
					int remainingPax = 0;
					if (totalDiscountPax > totalBookingPax) {
						int paxToDeduct = totalDiscountPax - totalBookingPax;

						// Reverse deduct
						for (int i = bookingVO.getBookingChargeItemList().size() - 1; i >= 0; i--) {
							BookingChargeItemVO iVO = bookingVO.getBookingChargeItemList().get(i);

							if (ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE.equals(iVO.getTypeCd())
									&& iVO.getCode().startsWith(ProductConstant.TOUR_DEP_ITM_CD_DISC)) {
								if (count == 1) {
									remainingPax += paxToDeduct;
									if (paxToDeduct > iVO.getQuantity()) {
										remainingPax -= iVO.getQuantity();
										iVO.setQuantity(0);
									} else {
										iVO.setQuantity(iVO.getQuantity() - paxToDeduct);
										count = 3;
									}
								} else if (count == 2) {
									if (remainingPax > iVO.getQuantity()) {
										iVO.setQuantity(0);
										iVO.setAmount(0.0);
									} else {
										iVO.setQuantity(iVO.getQuantity() - remainingPax);
									}
								}
								count++;
							}
							updateVO(iVO);

							totalAmount += (iVO.getAmount()*iVO.getQuantity())
									+ (iVO.getAmount3()*iVO.getQuantity3())
									+ (iVO.getAmount4()*iVO.getQuantity4())
									+ (iVO.getAmountSgl()*iVO.getQuantitySgl())
									+ (iVO.getAmount3Chd()*iVO.getQuantity3Chd())
									+ (iVO.getAmount4Chd()*iVO.getQuantity4Chd())
									+ (iVO.getAmountInf()*iVO.getQuantityInf());
						}
					}

					System.out.println("33 CCL totalAmount: " + totalAmount);
					// If user deduct booking pax -END-

				} else {
					itemVO = new BookingChargeItemVO();

					itemVO.setIdBooking(bookingVO.getId());
					itemVO.setIdAcct(vo.getIdAcct());
					itemVO.setIdInvEoItem(null);
					itemVO.setCode(vo.getCruiseCabinCd());
					itemVO.setDesc(vo.getCruiseCabinDesc());
					itemVO.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_TOUR);

					itemVO.setAmount(vo.getPriceTwn());
					itemVO.setAmount3(vo.getPrice3());
					itemVO.setAmount4(vo.getPrice4());
					itemVO.setAmountSgl(vo.getPriceSgl());
					itemVO.setAmount3Chd(vo.getPrice3Chd());
					itemVO.setAmount4Chd(vo.getPrice4Chd());
					itemVO.setAmountInf(vo.getPriceInf());

					itemVO.setIdTourCruiseCabin(vo.getIdTourCruiseCabin());
					itemVO.setQuantity(vo.getPaxTwn());
					itemVO.setQuantity3(vo.getPax3());
					itemVO.setQuantity4(vo.getPax4());
					itemVO.setQuantitySgl(vo.getPaxSgl());
					itemVO.setQuantity3Chd(vo.getPax3Chd());
					itemVO.setQuantity4Chd(vo.getPax4Chd());
					itemVO.setQuantityInf(vo.getPaxInf());
					itemVO.setCabinQty(vo.getTtlCabin());
					insertVO(itemVO);
					bookingVO.getBookingChargeItemList().add(itemVO);

					totalAmount += (itemVO.getAmount()*itemVO.getQuantity())
							+ (itemVO.getAmount3()*itemVO.getQuantity3())
							+ (itemVO.getAmount4()*itemVO.getQuantity4())
							+ (itemVO.getAmountSgl()*itemVO.getQuantitySgl())
							+ (itemVO.getAmount3Chd()*itemVO.getQuantity3Chd())
							+ (itemVO.getAmount4Chd()*itemVO.getQuantity4Chd())
							+ (itemVO.getAmountInf()*itemVO.getQuantityInf());

					System.out.println("44 CCL totalAmount: " + totalAmount);

					// tour cabin discount logic
					List<TourCruiseCabinDiscountVO> discountList = tourCruiseCabinService
							.getTourCruiseCabinDiscountList(vo.getIdTourCruiseCabin());
					int remainingPax = vo.getPaxTwn() + vo.getPax3() + vo.getPax4() + vo.getPaxSgl() + vo.getPax3Chd() + vo.getPax4Chd() + vo.getPaxInf();

					for (TourCruiseCabinDiscountVO discountVO : discountList) {
						itemVO = new BookingChargeItemVO();

						itemVO.setIdBooking(bookingVO.getId());
						itemVO.setIdTourCruiseCabin(vo.getIdTourCruiseCabin());
						itemVO.setIdAcct(tourDepItemVO.getAcctId());
						itemVO.setIdInvEoItem(null);
						itemVO.setCode(ProductConstant.TOUR_DEP_ITM_CD_DISC + "_" + vo.getCruiseCabinCd());
						itemVO.setDesc("DISCOUNT " + vo.getCruiseCabinDesc());
						itemVO.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE);
						itemVO.setAmount(0.0);

						if (remainingPax <= 0) {
							itemVO.setQuantity(0);
							insertVO(itemVO);
							bookingVO.getBookingChargeItemList().add(itemVO);
							break;
						}

						int availableDiscountPax = discountVO.getDiscountPax();
						double availableDiscountAmt = discountVO.getDiscountAmt();

						if (availableDiscountPax <= 0 || availableDiscountAmt <= 0) {
							itemVO.setQuantity(0);
							insertVO(itemVO);
							bookingVO.getBookingChargeItemList().add(itemVO);
							continue;
						}

						itemVO.setAmount(
								availableDiscountAmt > 0 ? -discountVO.getDiscountAmt() : discountVO.getDiscountAmt());

						if (availableDiscountPax >= remainingPax) {
							discountVO.setDiscountPax(discountVO.getDiscountPax() - remainingPax);
							itemVO.setQuantity(remainingPax);

							remainingPax = 0;
						} else {
							remainingPax = remainingPax - availableDiscountPax;

							discountVO.setDiscountPax(discountVO.getDiscountPax() - availableDiscountPax);
							itemVO.setQuantity(availableDiscountPax);
						}

						updateVO(discountVO);
						insertVO(itemVO);
						bookingVO.getBookingChargeItemList().add(itemVO);

						totalAmount += itemVO.getAmount() * itemVO.getQuantity();
					}

					System.out.println("55 CCL totalAmount: " + totalAmount);
				}
			}

			bookingVO.setAmount(totalAmount);
		}
	}

	private void updCruiseBookingChargeItemListQuote(BookingVO bookingVO, TourDepartureVO tourDepVO)
			throws BusinessException {
		List<TourDepItemVO> tourDepItemList = tourDepVO.getTourDepItemList();
		if (tourDepItemList == null) tourDepItemList = tourPkgDAO.getTourDepItemList(tourDepVO.getId(), tourDepVO.getIdCompany(), null);

		if (CollectionUtils.isNotEmpty(bookingVO.getTourCruiseCabinList())) {
			if (bookingVO.getBookingChargeItemList() == null)
				bookingVO.setBookingChargeItemList(new ArrayList<BookingChargeItemVO>());

			for (BookingChargeItemVO vo : bookingVO.getBookingChargeItemList()) {

				if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(vo.getTypeCd())) {
					vo.setQuantity(0);
					vo.setQuantity3(0);
					vo.setQuantity4(0);
					vo.setQuantitySgl(0);
					vo.setQuantity3Chd(0);
					vo.setQuantity4Chd(0);
					vo.setQuantityInf(0);
					vo.setCabinQty(0);
					updateVO(vo);
				} else {
					if (vo.getAmount().doubleValue() > 0) {
						vo.setQuantity(bookingVO.getTotalHeadCount());
						updateVO(vo);
					}
				}
			}

			BookingChargeItemVO itemVO = null;
			boolean isExited = false;
			int totalBookingPax = 0;
			int totalDiscountPax = 0;
			TourDepItemVO tourDepItemVO = new TourDepItemVO();

			for (TourDepItemVO depItemVO : tourDepItemList) {
				if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(depItemVO.getCode())) {
					tourDepItemVO = depItemVO;
					break;
				}
			}

			for (TourCruiseCabinVO vo : bookingVO.getTourCruiseCabinList()) {
				isExited = false;
				totalBookingPax = 0;
				totalDiscountPax = 0;

				for (BookingChargeItemVO vo2 : bookingVO.getBookingChargeItemList()) {
					if (vo.getIdTourCruiseCabin().equals(vo2.getIdTourCruiseCabin())) {
						if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(vo2.getTypeCd())) {
							vo2.setQuantity(vo.getPaxTwn());
							vo2.setQuantity3(vo.getPax3());
							vo2.setQuantity4(vo.getPax4());
							vo2.setQuantitySgl(vo.getPaxSgl());
							vo2.setQuantity3Chd(vo.getPax3Chd());
							vo2.setQuantity4Chd(vo.getPax4Chd());
							vo2.setQuantityInf(vo.getPaxInf());
							vo2.setCabinQty(vo.getTtlCabin());
							isExited = true;
							updateVO(vo2);
							totalBookingPax = vo.getPaxTwn() + vo.getPax3() + vo.getPax4() + vo.getPaxSgl() + vo.getPax3Chd() + vo.getPax4Chd()
									+ vo.getPaxInf();
							// break;
						} else if (ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE.equals(vo2.getTypeCd())
								&& vo2.getCode().startsWith(ProductConstant.TOUR_DEP_ITM_CD_DISC)) {
							totalDiscountPax += vo2.getQuantity();
						}
					}
				}

				if (isExited) {
					// If user deduct booking pax -START-
					int count = 1;
					int remainingPax = 0;
					if (totalDiscountPax > totalBookingPax) {
						int paxToDeduct = totalDiscountPax - totalBookingPax;

						// Reverse deduct
						for (int i = bookingVO.getBookingChargeItemList().size() - 1; i >= 0; i--) {
							BookingChargeItemVO iVO = bookingVO.getBookingChargeItemList().get(i);

							if (ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE.equals(iVO.getTypeCd())
									&& iVO.getCode().startsWith(ProductConstant.TOUR_DEP_ITM_CD_DISC)) {
								if (count == 1) {
									remainingPax += paxToDeduct;
									if (paxToDeduct > iVO.getQuantity()) {
										remainingPax -= iVO.getQuantity();
										iVO.setQuantity(0);
									} else {
										iVO.setQuantity(iVO.getQuantity() - paxToDeduct);
										count = 3;
									}
								} else if (count == 2) {
									if (remainingPax > iVO.getQuantity()) {
										iVO.setQuantity(0);
										iVO.setAmount(0.0);
									} else {
										iVO.setQuantity(iVO.getQuantity() - remainingPax);
									}
								}
								count++;
							}
							updateVO(iVO);
						}
					}
					// If user deduct booking pax -END-

				} else {
					itemVO = new BookingChargeItemVO();

					itemVO.setIdBooking(bookingVO.getId());
					itemVO.setIdAcct(vo.getIdAcct());
					itemVO.setIdInvEoItem(null);
					itemVO.setCode(vo.getCruiseCabinCd());
					itemVO.setDesc(vo.getCruiseCabinDesc());
					itemVO.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_TOUR);

					itemVO.setAmount(vo.getPriceTwn());
					itemVO.setAmount3(vo.getPrice3());
					itemVO.setAmount4(vo.getPrice4());
					itemVO.setAmountSgl(vo.getPriceSgl());
					itemVO.setAmount3Chd(vo.getPrice3Chd());
					itemVO.setAmount4Chd(vo.getPrice4Chd());
					itemVO.setAmountInf(vo.getPriceInf());

					itemVO.setIdTourCruiseCabin(vo.getIdTourCruiseCabin());
					itemVO.setQuantity(vo.getPaxTwn());
					itemVO.setQuantity3(vo.getPax3());
					itemVO.setQuantity4(vo.getPax4());
					itemVO.setQuantitySgl(vo.getPaxSgl());
					itemVO.setQuantity3Chd(vo.getPax3Chd());
					itemVO.setQuantity4Chd(vo.getPax4Chd());
					itemVO.setQuantityInf(vo.getPaxInf());
					itemVO.setCabinQty(vo.getTtlCabin());
					insertVO(itemVO);
					bookingVO.getBookingChargeItemList().add(itemVO);

					// tour cabin discount logic
					List<TourCruiseCabinDiscountVO> discountList = tourCruiseCabinService
							.getTourCruiseCabinDiscountList(vo.getIdTourCruiseCabin());
					int remainingPax = vo.getPaxTwn() + vo.getPax3() + vo.getPax4() + vo.getPaxSgl() + vo.getPax3Chd() + vo.getPax4Chd() + vo.getPaxInf();

					for (TourCruiseCabinDiscountVO discountVO : discountList) {
						itemVO = new BookingChargeItemVO();

						itemVO.setIdBooking(bookingVO.getId());
						itemVO.setIdTourCruiseCabin(vo.getIdTourCruiseCabin());
						itemVO.setIdAcct(tourDepItemVO.getAcctId());
						itemVO.setIdInvEoItem(null);
						itemVO.setCode(ProductConstant.TOUR_DEP_ITM_CD_DISC + "_" + vo.getCruiseCabinCd());
						itemVO.setDesc("DISCOUNT " + vo.getCruiseCabinDesc());
						itemVO.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE);
						itemVO.setAmount(0.0);

						if (remainingPax <= 0) {
							itemVO.setQuantity(0);
							insertVO(itemVO);
							bookingVO.getBookingChargeItemList().add(itemVO);
							break;
						}

						int availableDiscountPax = discountVO.getDiscountPax();
						double availableDiscountAmt = discountVO.getDiscountAmt();

						if (availableDiscountPax <= 0 || availableDiscountAmt <= 0) {
							itemVO.setQuantity(0);
							insertVO(itemVO);
							bookingVO.getBookingChargeItemList().add(itemVO);
							continue;
						}

						itemVO.setAmount(
								availableDiscountAmt > 0 ? -discountVO.getDiscountAmt() : discountVO.getDiscountAmt());

						if (availableDiscountPax >= remainingPax) {
							discountVO.setDiscountPax(discountVO.getDiscountPax() - remainingPax);
							itemVO.setQuantity(remainingPax);

							remainingPax = 0;
						} else {
							remainingPax = remainingPax - availableDiscountPax;

							discountVO.setDiscountPax(discountVO.getDiscountPax() - availableDiscountPax);
							itemVO.setQuantity(availableDiscountPax);
						}

						updateVO(discountVO);
						insertVO(itemVO);
						bookingVO.getBookingChargeItemList().add(itemVO);
					}
				}
			}
		}
	}

	public synchronized void addBookingForQuote(BookingVO bookingVO, TourDepartureVO tourDepVO) throws BusinessException {
		// int flag = 0;
		int ecoBalance = 99;
		int bizBalance = 99;

		if (!ProductConstant.TYPE_MICE_INBOUND.equals(bookingVO.getTypeCd())
				&& !ProductConstant.TYPE_MICE_OUTBOUND.equals(bookingVO.getTypeCd())
				&& !ProductConstant.TYPE_MICE_DOMESTIC.equals(bookingVO.getTypeCd())) {

			String allotmentIncludeInft = appSettingService.getAppSettingByCode(ConstantAppSetting.ADMIN_INCL_INFT_IN_ALLOTMENT_CALC_IN_OUTBOUND).getValue();

			if (tourDepVO.getSeatAllot().intValue() > 0) {
				int totalBook = bookingDAO.getTotalBookByTourDep(tourDepVO.getId(), null, tourDepVO.getTourTypeCode());
				int balance = tourDepVO.getSeatAllot() - tourDepVO.getReservedSeat() - tourDepVO.getTourManagerPax()
						- totalBook - bookingVO.getPaxFullCeb() - bookingVO.getPaxFullCnb() - bookingVO.getPaxFullCtw()
						- bookingVO.getPaxFullTrpl() - bookingVO.getPaxFullSgl() - bookingVO.getPaxFullTwn();

				if (allotmentIncludeInft.equals("Y"))	balance -= bookingVO.getPaxFullInft();

				ecoBalance = balance;

				if (balance < 0)
					throw new BusinessException(CommonErrConstant.ERR_BOOKING_OVER_SEAT_BALANCE);
				// if (balance == 0) flag = 1;
			}

			// set booking pax quantity
			int totalQty = bookingVO.getPaxFullCeb() + bookingVO.getPaxFullCnb() + bookingVO.getPaxFullCtw()
						+ bookingVO.getPaxFullInft() + bookingVO.getPaxFullSgl() + bookingVO.getPaxFullTwn()
						+ bookingVO.getPaxGrndCeb() + bookingVO.getPaxGrndCnb() + bookingVO.getPaxGrndCtw()
						+ bookingVO.getPaxGrndInft() + bookingVO.getPaxGrndSgl() + bookingVO.getPaxGrndTwn()
						+ bookingVO.getPaxFullTrpl()
						+ bookingVO.getPaxGrndTrpl();
			bookingVO.setQuantity(totalQty);

			if (bookingVO.getQuantity() == 0)
				throw new BusinessException(CommonErrConstant.ERR_BOOKING_PAX_EMPTY);

		}

		// add booking
		bookingVO.setPmntStatusCd(SalesConstant.BOOKING_PMNT_STATUS_KIV);
		bookingVO.setStatusCode(CommonConstant.STATUS_CD_BOOKED);

		// add booking charge item
		addBookingChargeItemListForQuote(bookingVO, tourDepVO);
	}

	/**********
	 * HELPER *
	 **********/

	private void addBookingChargeItemListForQuote(BookingVO bookingVO, TourDepartureVO tourDepVO) throws BusinessException {
		List<TourDepItemVO> tourDepItemList = tourDepVO.getTourDepItemList();

		if (tourDepItemList == null) {
			tourDepItemList = tourPkgDAO.getTourDepItemList(tourDepVO.getId(), tourDepVO.getIdCompany(), null);
		}

		if (CollectionUtils.isNotEmpty(tourDepItemList)) {
			if (bookingVO.getBookingChargeItemList() == null) {
				bookingVO.setBookingChargeItemList(new ArrayList<BookingChargeItemVO>());
			}

			BookingChargeItemVO itemVO = null;
			int totFullAdultPax = bookingVO.getPaxFullTwn() + bookingVO.getPaxFullSgl() + bookingVO.getPaxFullTrpl();
			int totFullChildPax = bookingVO.getPaxFullCeb() + bookingVO.getPaxFullCnb() + bookingVO.getPaxFullCtw();
			int totGrndPax = bookingVO.getPaxGrndCeb() + bookingVO.getPaxGrndCnb() + bookingVO.getPaxGrndCtw()
					+ bookingVO.getPaxGrndSgl() + bookingVO.getPaxGrndTwn() + bookingVO.getPaxGrndTrpl();
			int totBizAdultPax = 0;
			int totBizChildPax = 0;

			double totalAmount = 0;

			for (TourDepItemVO vo : tourDepItemList) {
				itemVO = new BookingChargeItemVO();

				itemVO.setIdBooking(bookingVO.getId());
				itemVO.setIdAcct(vo.getAcctId());
				itemVO.setIdInvEoItem(vo.getIdInvEoItem());
				itemVO.setCode(vo.getCode());
				itemVO.setDesc(vo.getDesc());
				itemVO.setAmount(vo.getAmount());
				itemVO.setTypeCd(vo.getTypeCd());
				if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxFullSgl());
					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxFullTwn());

					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CTW.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxFullCtw());

					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CWB.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxFullCeb());

					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CNB.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxFullCnb());

					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_INFT.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxFullInft());

					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_TRIPLE.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxFullTrpl());

					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_SGL.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxGrndSgl());

					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_TWN.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxGrndTwn());

					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CTW.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxGrndCtw());

					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CWB.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxGrndCeb());

					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CNB.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxGrndCnb());

					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_INFT.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxGrndInft());

					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_TRIPLE.equals(vo.getCode())) {
					itemVO.setQuantity(bookingVO.getPaxGrndTrpl());

					bookingVO.getBookingChargeItemList().add(itemVO);
					if (itemVO.getQuantity() > 0)
						totalAmount += (itemVO.getAmount() * itemVO.getQuantity());
				} else if (ProductConstant.AIRLINE_ITM_CD_APT_ADT.equals(vo.getCode())) {
					itemVO.setQuantity(totFullAdultPax + totBizAdultPax);

					bookingVO.getBookingChargeItemList().add(itemVO);
				} else if (ProductConstant.AIRLINE_ITM_CD_APT_CHD.equals(vo.getCode())) {
					itemVO.setQuantity(totFullChildPax + totBizChildPax);

					bookingVO.getBookingChargeItemList().add(itemVO);
				} else if (ProductConstant.AIRLINE_ITM_CD_FUEL_ADT.equals(vo.getCode())) {
					itemVO.setQuantity(totFullAdultPax + totBizAdultPax);

					bookingVO.getBookingChargeItemList().add(itemVO);
				} else if (ProductConstant.AIRLINE_ITM_CD_FUEL_CHD.equals(vo.getCode())) {
					itemVO.setQuantity(totFullChildPax + totBizChildPax);

					bookingVO.getBookingChargeItemList().add(itemVO);
				} else if (ProductConstant.AIRLINE_ITM_CD_AC.equals(vo.getCode())) {
					itemVO.setQuantity(totFullAdultPax + totFullChildPax + totBizAdultPax + totBizChildPax);

					bookingVO.getBookingChargeItemList().add(itemVO);
				} else if (ProductConstant.AIRLINE_ITM_CD_DEVIATION.equals(vo.getCode())) {
					if (vo.getAcctId() != null) {
						itemVO.setQuantity(totFullAdultPax + totFullChildPax + totBizAdultPax + totBizChildPax);

						bookingVO.getBookingChargeItemList().add(itemVO);
					}
				} else {
					if (vo.getAcctId() != null) {
						if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(vo.getCode())) {
							List<TourDepartureDiscountVO> tourDepDiscountList = tourPkgDAO
									.getTourDepDiscount(tourDepVO.getId());

							if (!tourDepVO.isDiscountPercent()) {
								int remainingPax = totFullAdultPax + totFullChildPax + totBizAdultPax + totBizChildPax;
								for (TourDepartureDiscountVO discountVO : tourDepDiscountList) {
									itemVO = new BookingChargeItemVO();

									itemVO.setIdBooking(bookingVO.getId());
									itemVO.setIdAcct(vo.getAcctId());
									itemVO.setIdInvEoItem(vo.getIdInvEoItem());
									itemVO.setCode(vo.getCode());
									itemVO.setDesc(vo.getDesc());
									itemVO.setAmount(vo.getAmount());
									itemVO.setTypeCd(vo.getTypeCd());

									itemVO.setAmount(discountVO.getDiscountAmt() > 0 ? -discountVO.getDiscountAmt()
											: discountVO.getDiscountAmt());

									if (remainingPax <= 0) {
										itemVO.setQuantity(0);

										bookingVO.getBookingChargeItemList().add(itemVO);
										break;
									}

									int availableDiscountPax = discountVO.getDiscountPax();

									if (availableDiscountPax <= 0) {
										itemVO.setQuantity(0);
										bookingVO.getBookingChargeItemList().add(itemVO);
										continue;
									}

									if (availableDiscountPax >= remainingPax) {
										discountVO.setDiscountPax(discountVO.getDiscountPax() - remainingPax);
										itemVO.setQuantity(remainingPax);

										remainingPax = 0;
									} else {
										remainingPax = remainingPax - availableDiscountPax;

										discountVO.setDiscountPax(discountVO.getDiscountPax() - availableDiscountPax);
										itemVO.setQuantity(availableDiscountPax);
									}

									bookingVO.getBookingChargeItemList().add(itemVO);
								}
							} else {
								if (CollectionUtils.isNotEmpty(tourDepDiscountList)) {
									TourDepartureDiscountVO discountVO = tourDepDiscountList.get(0);

									if (discountVO.getDiscountPax() > 0) {
										itemVO = new BookingChargeItemVO();

										itemVO.setIdBooking(bookingVO.getId());
										itemVO.setIdAcct(vo.getAcctId());
										itemVO.setIdInvEoItem(vo.getIdInvEoItem());
										itemVO.setCode(vo.getCode());
										itemVO.setDesc(vo.getDesc());
										itemVO.setAmount(totalAmount * discountVO.getDiscountAmt() / 100 * -1);
										itemVO.setQuantity(1);
										itemVO.setTypeCd(vo.getTypeCd());

										bookingVO.getBookingChargeItemList().add(itemVO);
									}
								}
							}
						} else {
							itemVO.setQuantity(
									totFullAdultPax + totFullChildPax + totBizAdultPax + totBizChildPax + totGrndPax);

							bookingVO.getBookingChargeItemList().add(itemVO);
						}
					}
				}
			}
		}
	}

	public InvoiceVO transferCruiseInvoice(InvoiceVO invoiceVO,
			BookingVO bookingVO, TourDepartureVO tourDepVO, boolean isReturnValue, boolean keepInvItem) throws BusinessException {

		Date invDate = invoiceVO.getInvoiceDt();
//		Long idBooking = invoiceVO.getBookingId();
		Long idTourDep = invoiceVO.getTourDepId();

		// return invoice object
		if (isReturnValue) {
			boolean isGSTPeriod = gstService.isGSTPeriod(bookingVO.getIdCompany(), invDate);
			List<TourDepItemVO> tourDepItemVOList = null;
			if (isGSTPeriod) {
				tourDepItemVOList = tourPkgService.getTourDepItemList(tourDepVO.getId(), bookingVO.getIdCompany());
			}

			TourPackageVO tourPkgVO = tourPkgService.getTourPackageById(tourDepVO.getIdTourPkg());
			InvoiceVO invVO = new InvoiceVO();
			invVO.setInvoiceDt(invDate);
			invVO.setCustomerId(invoiceVO.getCustomerId());
			invVO.setBookingId(bookingVO.getId());
			invVO.setTourDepId(tourDepVO.getId());
			invVO.setDepartureDt(tourDepVO.getDtDep());
			invVO.setOrderCd(bookingVO.getOrderTypeCd());
			invVO.setCatCd(CommonConstant.LOOKUP_ITM_INV_CAT_CRUISE);
			StringBuilder sb = new StringBuilder();
			sb.append(tourDepVO.getNumDays() + "Days " + tourDepVO.getNumNights() + "Nights ");
			if (!StringUtils.isEmpty(tourPkgVO.getNameEn()))
				sb.append(tourPkgVO.getNameEn());
			if (!StringUtils.isEmpty(tourPkgVO.getNameZh()))
				sb.append(" " + tourPkgVO.getNameZh());
			if (!StringUtils.isEmpty(tourPkgVO.getNameOther()))
				sb.append(" " + tourPkgVO.getNameOther());
			invVO.setSubjLine(sb.toString());

			invVO.setInvoiceItemList(new ArrayList<InvoiceItemVO>());
			for (BookingChargeItemVO itemVO : bookingVO.getBookingChargeItemList()) {
				InvoiceItemVO invItemVO = new InvoiceItemVO();
				invItemVO.setAcctId(itemVO.getIdAcct());
				invItemVO.setInvEOItemId(itemVO.getIdInvEoItem());
				invItemVO.setInvItemCd(itemVO.getCode());
				invItemVO.setDesc(itemVO.getDesc());
				invItemVO.setQty(itemVO.getQuantity());
				invItemVO.setUnitPrice(itemVO.getAmount());
				invItemVO.setAmount((new BigDecimal(String.valueOf(itemVO.getAmount())))
						.multiply(new BigDecimal(String.valueOf(itemVO.getQuantity()))).doubleValue());
				invItemVO.setTaxAmount(0.00);
				if (isGSTPeriod) {
					for (TourDepItemVO tourDepItemVO : tourDepItemVOList) {
						if (tourDepItemVO.getCode().equals(itemVO.getCode())) {
							invItemVO.setTaxCode(tourDepItemVO.getTaxCode());
							invItemVO.setTaxRate(tourDepItemVO.getTaxRate());
							tourDepItemVOList.remove(tourDepItemVO);
							break;
						}
					}
				} else {
					invItemVO.setTaxCode(null);
					invItemVO.setTaxRate(null);
				}

				if (itemVO.getCabinQty() > 0 && ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(itemVO.getTypeCd())) {
					InvoiceItemVO cabinItemVO = new InvoiceItemVO();
					if (itemVO.getQuantity() > 0) {
						cabinItemVO = (InvoiceItemVO) invItemVO.clone();
						cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_TWN);
						cabinItemVO.setQty(itemVO.getQuantity());
						cabinItemVO.setUnitPrice(itemVO.getAmount());
						cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
								.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
						cabinItemVO.setShowInInv(true);
						invVO.getInvoiceItemList().add(cabinItemVO);
					}
					if (itemVO.getQuantity3() > 0) {
						cabinItemVO = (InvoiceItemVO) invItemVO.clone();
						cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_3RD);
