package com.bcs.zsg.bank.vo;

import java.util.Date;

import com.bcs.zsg.acct.vo.AcctBalVO;
import com.bcs.zsg.core.vo.BaseVO;

public class BankAcctVO extends BaseVO {

	private static final long serialVersionUID = 1L;

	private Long idCompany;
	private Long idAcct;
	private String typeCd;
	private String acctNo;
	private String name;
	private String contactName;
	private Date dtLastRecon;
	// for view purpose
	private String acctCode;
	private AcctBalVO beginBalVO;
	private AcctBalVO currentBalVO;
	
	private double currentBal;
	// bank account report
	private String bankAddress;
	private String description;
	private String companyName;

	/**
	 * @return the idCompany
	 */
	public Long getIdCompany() {
		return idCompany;
	}

	/**
	 * @param idCompany the idCompany to set
	 */
	public void setIdCompany(Long idCompany) {
		this.idCompany = idCompany;
	}

	/**
	 * @return the idAcct
	 */
	public Long getIdAcct() {
		return idAcct;
	}

	/**
	 * @param idAcct the idAcct to set
	 */
	public void setIdAcct(Long idAcct) {
		this.idAcct = idAcct;
	}

	/**
	 * @return the typeCd
	 */
	public String getTypeCd() {
		return typeCd;
	}

	/**
	 * @param typeCd the typeCd to set
	 */
	public void setTypeCd(String typeCd) {
		this.typeCd = typeCd;
	}

	/**
	 * @return the acctNo
	 */
	public String getAcctNo() {
		return acctNo;
	}

	/**
	 * @param acctNo the acctNo to set
	 */
	public void setAcctNo(String acctNo) {
		this.acctNo = acctNo;
	}

	/**
	 * @return the name
	 */
	public String getName() {
		return name;
	}

	/**
	 * @param name the name to set
	 */
	public void setName(String name) {
		this.name = name;
	}

	/**
	 * @return the contactName
	 */
	public String getContactName() {
		return contactName;
	}

	/**
	 * @param contactName the contactName to set
	 */
	public void setContactName(String contactName) {
		this.contactName = contactName;
	}

	/**
	 * @return the dtLastRecon
	 */
	public Date getDtLastRecon() {
		return dtLastRecon;
	}

	/**
	 * @param dtLastRecon the dtLastRecon to set
	 */
	public void setDtLastRecon(Date dtLastRecon) {
		this.dtLastRecon = dtLastRecon;
	}

	/**
	 * @return the acctCode
	 */
	public String getAcctCode() {
		return acctCode;
	}

	/**
	 * @param acctCode the acctCode to set
	 */
	public void setAcctCode(String acctCode) {
		this.acctCode = acctCode;
	}

	/**
	 * @return the beginBalVO
	 */
	public AcctBalVO getBeginBalVO() {
		return beginBalVO;
	}

	/**
	 * @param beginBalVO the beginBalVO to set
	 */
	public void setBeginBalVO(AcctBalVO beginBalVO) {
		this.beginBalVO = beginBalVO;
	}

	/**
	 * @return the currentBalVO
	 */
	public AcctBalVO getCurrentBalVO() {
		return currentBalVO;
	}

	/**
	 * @param currentBalVO the currentBalVO to set
	 */
	public void setCurrentBalVO(AcctBalVO currentBalVO) {
		this.currentBalVO = currentBalVO;
	}

	/**
	 * @return the currentBal
	 */
	public double getCurrentBal() {
		return currentBal;
	}

	/**
	 * @param currentBal the currentBal to set
	 */
	public void setCurrentBal(double currentBal) {
		this.currentBal = currentBal;
	}
	public String getBankAddress() {
		return bankAddress;
	}

	public void setBankAddress(String bankAddress) {
		this.bankAddress = bankAddress;
	}

	public String getDescription() {
		return description;
	}

	public void setDescription(String description) {
		this.description = description;
	}

	public String getCompanyName() {
		return companyName;
	}

	public void setCompanyName(String companyName) {
		this.companyName = companyName;
	}
}
