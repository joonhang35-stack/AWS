package com.bcs.zsg.acct.vo;

import com.bcs.zsg.core.vo.BaseVO;

public class GeneralLedgerVO extends BaseVO {

	private static final long serialVersionUID = 1L;

	private Long idGeneralLedger;
	private String transactionType;
	private String debit;
	private String credit;
	private String source;
	private String destination;
	
	public Long getIdGeneralLedger() {
		return idGeneralLedger;
	}
	public void setIdGeneralLedger(Long idGeneralLedger) {
		this.idGeneralLedger = idGeneralLedger;
	}
	public String getTransactionType() {
		return transactionType;
	}
	public void setTransactionType(String transactionType) {
		this.transactionType = transactionType;
	}
	public String getDebit() {
		return debit;
	}
	public void setDebit(String debit) {
		this.debit = debit;
	}
	public String getCredit() {
		return credit;
	}
	public void setCredit(String credit) {
		this.credit = credit;
	}
	public String getSource() {
		return source;
	}
	public void setSource(String source) {
		this.source = source;
	}
	public String getDestination() {
		return destination;
	}
	public void setDestination(String destination) {
		this.destination = destination;
	}

	
	
}
