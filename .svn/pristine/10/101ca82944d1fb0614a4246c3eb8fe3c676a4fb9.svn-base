<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="account_report">
	
	<var name="accountReportBean" class="com.bcs.zsg.acct.web.bean.AccountReportBean"/>
	<var name="custBean" class="com.bcs.zsg.sales.web.bean.CustomerBean"/>
	
	<view-state id="account_report">
		<on-entry>
			<evaluate expression="accountReportBean.init()"/>
			<evaluate expression="custBean.init(1)"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>