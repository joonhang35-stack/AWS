<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="tour_cruise_cabin" name="TourCruiseCabinVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="idTourDep" type="long" column="id_tour_dep"/>
        <property name="idCompany" type="long" column="id_company"/>
        <property name="idAcct" type="long" column="id_acct"/>
        <property name="cruiseCabinCd" type="string" column="cruise_cabin_cd"/>
        <property name="cabinAllotment" type="integer" column="cabin_allotment"/>
        <property name="paxPerCabin" type="integer" column="pax_per_cabin"/>
        <property name="priceTwn" type="double" column="price_twn"/>
        <property name="price3" type="double" column="price_3"/>
        <property name="price4" type="double" column="price_4"/>
        <property name="priceSgl" type="double" column="price_sgl"/>
        <property name="price3Chd" type="double" column="price_3_chd"/>
        <property name="price4Chd" type="double" column="price_4_chd"/>
        <property name="priceInf" type="double" column="price_inf"/>
		<property name="tourStatusCd" type="string" column="tour_status_cd"/>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY" update="false"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>