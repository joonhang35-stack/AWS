package com.bcs.zsg.sales.vo;

import java.util.Date;

import com.bcs.zsg.product.vo.TourDepartureViewVO;

public class BookingViewVO extends BookingVO {

	private static final long serialVersionUID = 1L;

	private TourDepartureViewVO tourDepViewVO;

	private String tourCode;
	private String staff;
	private String salutationCd;
	private String lastName;
	private String firstName;
	private Date dtDep;

	public static long getSerialversionuid() {
		return serialVersionUID;
	}

	public Date getDtDep() {
		return dtDep;
	}

	public void setDtDep(Date dtDep) {
		this.dtDep = dtDep;
	}

	/**
	 * @return the tourDepViewVO
	 */
	public TourDepartureViewVO getTourDepViewVO() {
		return tourDepViewVO;
	}

	/**
	 * @param tourDepViewVO the tourDepViewVO to set
	 */
	public void setTourDepViewVO(TourDepartureViewVO tourDepViewVO) {
		this.tourDepViewVO = tourDepViewVO;
	}

	/**
	 * @return the tourCode
	 */
	public String getTourCode() {
		return tourCode;
	}

	/**
	 * @param tourCode the tourCode to set
	 */
	public void setTourCode(String tourCode) {
		this.tourCode = tourCode;
	}

	/**
	 * @return the staff
	 */
	public String getStaff() {
		return staff;
	}

	/**
	 * @param staff the staff to set
	 */
	public void setStaff(String staff) {
		this.staff = staff;
	}

	/**
	 * @return the salutationCd
	 */
	public String getSalutationCd() {
		return salutationCd;
	}

	/**
	 * @param salutationCd the salutationCd to set
	 */
	public void setSalutationCd(String salutationCd) {
		this.salutationCd = salutationCd;
	}

	/**
	 * @return the lastName
	 */
	public String getLastName() {
		return lastName;
	}

	/**
	 * @param lastName the lastName to set
	 */
	public void setLastName(String lastName) {
		this.lastName = lastName;
	}

	/**
	 * @return the firstName
	 */
	public String getFirstName() {
		return firstName;
	}

	/**
	 * @param firstName the firstName to set
	 */
	public void setFirstName(String firstName) {
		this.firstName = firstName;
	}
}
