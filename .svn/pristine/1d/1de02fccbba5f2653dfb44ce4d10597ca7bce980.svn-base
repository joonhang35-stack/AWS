<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="change_password_entry">
	
	<!-- backing bean, extends com.bcs.zsg.component.common.web.swf.bean.AppBackingBean -->
	<var name="changePasswordBean" class="com.bcs.zsg.component.security.web.jsf.primefaces.bean.ChangePasswordBean"/>
	
	<view-state id="change_password_entry">
		<transition on="submit">
			<evaluate expression="changePasswordBean.submit()"/>
		</transition>
	</view-state>
	
	<end-state id="finish" />
	
</flow>