package com.bcs.zsg.product.vo;

import com.bcs.zsg.core.vo.BaseVO;

public class TourDepartureDiscountVO extends BaseVO {

	private static final long serialVersionUID = 1L;
	
	private Long idTourDep;
	private double discountAmt;
	private int discountPax;
	
	public Long getIdTourDep() {
		return idTourDep;
	}
	
	public void setIdTourDep(Long idTourDep) {
		this.idTourDep = idTourDep;
	}
	
	public double getDiscountAmt() {
		return discountAmt;
	}
	
	public void setDiscountAmt(double discountAmt) {
		this.discountAmt = discountAmt;
	}
	
	public int getDiscountPax() {
		return discountPax;
	}
	
	public void setDiscountPax(int discountPax) {
		this.discountPax = discountPax;
	}
}
