<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
				xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
				template="/WEB-INF/views/layouts/main.xhtml">

<ui:define name="content">
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        var filters = document.querySelectorAll('input.ui-column-filter');
        filters.forEach(function(filter) {
            filter.setAttribute('enterkeyhint', 'enter');
        });
    });
</script>
<p:panel header="Invoice Email Payment History" toggleable="true" toggleSpeed="500">
	<h:form id="idForm">
		<p:growl id="msg" />
		
		<p:dataTable id="idInvEmailPayment" widgetVar="varInvEmailPayment" value="#{invEmailPmntBean.lazyDMInvoiceEmailPayment}" var="vo" paginator="true" rows="20" lazy="true"
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink} Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
			rowsPerPageTemplate="20, 30, 50" filterEvent="enter">
			
			<p:column headerText="Edit" style="width:30px; text-align:center">
				<p:commandButton icon="ui-icon-pencil" update=":idEmailPayment" actionListener="#{invEmailPmntBean.navToDetail(vo)}" oncomplete="varEmailPayment.show()" disabled="#{vo.paymentStatus eq 'E'}"/>
			</p:column>
			<p:column headerText="Delete" style="width:30px; text-align:center">
				<p:commandButton icon="ui-icon-close" actionListener="#{invEmailPmntBean.navToDetail(vo)}" oncomplete="varDelTmpMsg.show()" update=":idForm:idInvEmailPayment" disabled="#{vo.paymentStatus ne 'P'}"/>
			</p:column>
			<p:column headerText="Merchant" style="width:150px;" filterBy="#{vo.ipayConfigComment}"
				sortBy="#{vo.ipayConfigComment}">
				<h:outputText value="#{vo.ipayConfigComment}"/>
			</p:column>
			<p:column headerText="Doc No." style="width:160px;" filterBy="#{vo.invoiceNo}"
				sortBy="#{vo.invoiceNo}">
				<p:commandLink actionListener="#{invEmailPmntBean.redirectToInvoice(vo, 'invoice')}" global="false" immediate="true" style="color:red;">
					<h:outputText value="#{vo.prefix} #{vo.invoiceNo}"/>
				</p:commandLink>
			</p:column>
			<p:column headerText="Inv Status" sortBy="#{vo.invoiceStatus}" filterBy="#{vo.invoiceStatus}" style="width:120px;">
				<h:outputText value="#{zsg:referenceDataValue('INV_STATUS', vo.invoiceStatus)}"/>
			</p:column>
			<p:column headerText="Admin Fee &lt;br/&gt; Inv No." style="width:160px;" filterBy="#{vo.invoiceAdminChargesNo}"
				sortBy="#{vo.invoiceAdminChargesNo}">
				<p:commandLink actionListener="#{invEmailPmntBean.redirectToInvoice(vo, 'charges')}" global="false" immediate="true" style="color:red;"
					rendered="#{not empty vo.invoiceAdminChargesNo}">
					<h:outputText value="#{vo.prefix} #{vo.invoiceAdminChargesNo}"/>
				</p:commandLink>
			</p:column>
			<p:column headerText="Email" style="width:300px;" filterBy="#{vo.email}" sortBy="#{vo.email}">
				<h:outputText value="#{vo.email}"/>
			</p:column>
			<p:column headerText="Payment Amt" style="width:150px;text-align:middle;">
				<h:outputText value="#{vo.paymentAmt}">
					<f:convertNumber pattern="#,##0.00" />
				</h:outputText>
			</p:column>
			<p:column headerText="Admin Fee (%)" style="width:150px;text-align:middle;">
				<h:outputText value="#{vo.adminChargesPercentage}">
					<f:convertNumber pattern="#,##0.00" />
				</h:outputText>
			</p:column>
			<p:column headerText="Admin Fee" style="width:150px;text-align:middle;">
				<h:outputText value="#{vo.adminCharges}">
					<f:convertNumber pattern="#,##0.00" />
				</h:outputText>
			</p:column>
			<p:column headerText="Total Payment Amt" style="width:150px;text-align:middle;">
				<h:outputText value="#{vo.totalPaymentAmt}">
					<f:convertNumber pattern="#,##0.00" />
				</h:outputText>
			</p:column>
			<p:column headerText="Status" style="width:100px;" filterBy="#{vo.paymentStatus}"
				sortBy="#{vo.paymentStatus}">
				<h:outputText value="#{vo.paymentStatus eq 'P' ? 'Pending' : ''}"/>
				<h:outputText value="#{vo.paymentStatus eq 'S' ? 'Success' : ''}"/>
				<h:outputText value="#{vo.paymentStatus eq 'E' ? 'Expired' : ''}"/>
			</p:column>
			<p:column headerText="Expired Date" style="width:250px;">
				<h:outputText value="#{vo.dtExpiry}" >
					<f:convertDateTime pattern="dd-MMM-yyyy HH:mm:ss" />
				</h:outputText>
			</p:column>
			<p:column headerText="Trans No." style="width:150px;" filterBy="#{vo.transId}"
				sortBy="#{vo.transId}">
				<h:outputText value="#{vo.transId}"/>
			</p:column>
			<p:column headerText="Auth. Code" style="width:150px;" filterBy="#{vo.authCode}"
				sortBy="#{vo.authCode}">
				<h:outputText value="#{vo.authCode}"/>
			</p:column>
			<p:column headerText="Updated By" sortBy="#{vo.updatedBy}"
				style="width: 80px;" styleClass="txt_center"
				filterBy="#{vo.updatedBy}">
				<h:outputText value="#{vo.updatedBy}" />
			</p:column>

			<p:column headerText="Updated Date" sortBy="#{vo.updatedDate}"
				style="width: 250px;" filterBy="#{vo.updatedDate}">
				<h:outputText value="#{vo.updatedDate}">
					<f:convertDateTime pattern="dd-MMM-yyyy HH:mm:ss" />
				</h:outputText>
			</p:column>
		</p:dataTable>
		<br/>
		<p:commandButton icon="ui-icon-print" value="Print PDF" actionListener="#{invEmailPmntBean.printInvEmailPmnt('PDF')}" ajax="false"/>
		<p:commandButton icon="ui-icon-print" value="Print Excel" actionListener="#{invEmailPmntBean.printInvEmailPmnt('XLSX')}" ajax="false"/>
	</h:form>
</p:panel>

<p:dialog id="idEmailPayment" widgetVar="varEmailPayment" modal="true" resizable="false" dynamic="true" draggable="true"
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Invoice Email Payment" />
	</f:facet>
	
	<h:form id="idEmailPaymentForm">
		<ui:include src="add_inv_email_payment.xhtml" />
	</h:form>
</p:dialog>

<!-- 
	DIALOG - DELETE TMP MSG 
-->
<p:confirmDialog id="idDelTmpMsg" widgetVar="varDelTmpMsg" header="Delete" message="Are you sure want to delete this record?" closable="false">
	<h:form>
		<p:commandButton value="Yes" actionListener="#{invEmailPmntBean.delete}" update=":idForm" oncomplete="varDelTmpMsg.hide()"/>
		<p:commandButton value="Cancel" oncomplete="varDelTmpMsg.hide()"/>
	</h:form>
</p:confirmDialog>

<p:dialog id="idIpayConfigListDialog" header="Merchant List"
	widgetVar="varIpayConfigListDialog" modal="true" resizable="false"
	dynamic="true" draggable="true" closable="false">
	<h:form id="idIpayConfigListForm">
		<p:dataTable widgetVar="varIpayConfigListTable" value="#{invEmailPmntBean.ipayConfigVOList}" var="vo" paginator="true" rows="10" 
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
			filterEvent="enter" lazy="true" rowKey="#{vo.id}" selectionMode="single">
			<p:ajax event="rowSelect" listener="#{invEmailPmntBean.handleIpayConfigSelect}" 
				update=":idEmailPaymentForm:idHiddenMerchant, :idEmailPaymentForm:idMerchant,
						:idEmailPaymentForm:idAdminChargesPercent, :idEmailPaymentForm:idAdminCharges, :idEmailPaymentForm:idTotalPayment" 
				oncomplete="varIpayConfigListDialog.hide();" process="@this"/>
			
			<p:column headerText="Merchant Code" style="width: 100px;">
				<h:outputText value="#{vo.merchantCode}" />
			</p:column>
			
			<p:column headerText="Comment" style="width: 250px;">
				<h:outputText value="#{vo.comment}" />
			</p:column>
			
			<p:column headerText="Remarks" style="width: 250px;">
				<h:outputText value="#{vo.remarks}" />
			</p:column>
			
			<p:column headerText="Admin Charges Rate" style="width: 80px;">
				<h:outputText value="#{vo.adminChargesPercentage}" />
			</p:column>
		</p:dataTable>
		
		<h:panelGrid columns="1">
			<p:commandButton value="#{msg['common.button.label.cancel']}" oncomplete="varIpayConfigListDialog.hide();"/>
		</h:panelGrid>
	</h:form>
</p:dialog>

<p:dialog id="idInvNoDialog" header="Invoice List"
	widgetVar="varInvNoDialog" modal="true" resizable="false"
	dynamic="true" draggable="true" closable="true">
	
	<h:form id="idInvNoListForm">
		<p:dataTable widgetVar="varInvNoTable"
			value="#{invEmailPmntBean.lazyDMInvoiceVO}" var="vo" paginator="true"
			rows="20"
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
			filterEvent="enter" lazy="true" rowKey="#{vo.id}"
			selectionMode="single">
			<p:ajax event="rowSelect" listener="#{invEmailPmntBean.handleInvNoSelect}"
				update=":idEmailPaymentForm:idTxtAdminChargesInvoiceNo"
				oncomplete="varInvNoDialog.hide()" />

			<p:column headerText="Invoice No." sortBy="#{vo.code}"
				filterBy="#{vo.code}" filterMatchMode="contains">
				<h:outputText value="#{salesBean.prefixValue} #{vo.code}" />
			</p:column>
			<p:column headerText="Invoice Date" sortBy="#{vo.invoiceDt}"
				filterBy="#{vo.invoiceDt}">
				<h:outputText value="#{vo.invoiceDt}">
					<f:convertDateTime pattern="dd-MMM-yyyy" />
				</h:outputText>
			</p:column>
			<p:column headerText="Customer No." sortBy="#{vo.custCd}"
				filterBy="#{vo.custCd}">
				<h:outputText value="#{vo.custCd}" />
			</p:column>
			<p:column headerText="Customer Name" sortBy="#{vo.custName}"
				filterBy="#{vo.custName}" filterMatchMode="contains">
				<h:outputText value="#{vo.custName}" />
			</p:column>
			<p:column headerText="Sales Amount" sortBy="#{vo.amount}"
				filterBy="#{vo.amount}">
				<h:outputText value="#{vo.amount}">
					<f:convertNumber pattern="#,##0.00" />
				</h:outputText>
			</p:column>
			<p:column headerText="Issued By" sortBy="#{vo.issuedBy}"
				filterBy="#{vo.issuedBy}" filterMatchMode="contains">
				<h:outputText value="#{vo.issuedBy}" />
			</p:column>
		</p:dataTable>

		<h:panelGrid columns="1">
			<p:commandButton value="#{msg['common.button.label.cancel']}"
				update=":idInvNoDialog" oncomplete="varInvNoDialog.hide()" />
		</h:panelGrid>
	</h:form>
</p:dialog>
</ui:define>
</ui:composition>