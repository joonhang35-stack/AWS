					oncomplete="varCloneTourPkgDialog.hide()" />
				<p:commandButton value="#{msg['common.button.label.no']}"
					actionListener="#{tourPkgBean.resetTourDepForm}"
					oncomplete="varCloneTourPkgDialog.hide()" />
			</h:form>
		</p:confirmDialog>

