			<h:form>
				<p:growl id="msg" />
				<p:panelGrid>
					<p:row>
						<p:column>
							<h:outputLabel for="idDelReason">Reason <span
									class="required">*</span>
							</h:outputLabel>
						</p:column>
						<p:column>
							<p:inputTextarea label="Reason" id="idDelReason"
								value="#{tourPkgBean.tourDepVO.reason}" rows="5"
								style="width:300px" required="true" />
						</p:column>
					</p:row>
				</p:panelGrid>
				<p:commandButton value="#{msg['common.button.label.yes']}"
					actionListener="#{tourPkgBean.delTourDep}"
