					oncomplete="onValidationReason(xhr, status, args)" />
				<p:commandButton value="#{msg['common.button.label.no']}"
					actionListener="#{tourPkgBean.resetTourDepForm}" update="@form"
					process="@this" oncomplete="varDelTourDepDialog.hide()" />
			</h:form>
		</p:confirmDialog>

		<!--
