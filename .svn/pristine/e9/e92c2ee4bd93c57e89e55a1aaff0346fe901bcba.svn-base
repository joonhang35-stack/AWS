<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui"
	xmlns:pe="http://primefaces.org/ui/extensions"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	template="/WEB-INF/views/layouts/main.xhtml"
	xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

	<ui:define name="content">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
		<style>
		.tourDepListClass .ui-datatable th div.ui-dt-c,
		.tourDepListClass .ui-datatable .ui-datatable-data td div.ui-dt-c {
			padding: 4px 0px; 
			font-size: 10px; 
			text-align: center;
		}
		.tourDepListClass .ui-state-highlight,
		.tourDepListClass .ui-widget-content .ui-state-highlight {
			border: 3px solid red;
			background: #7ddbfe !important;
		}
		.ui-tooltip {
			max-width: 600px;
		}
		.EORefDialog {
			height: 100% !important;
			overflow: auto;
		}
		</style>
		<script type="text/javascript">
			function onTransferValidation(xhr, status, args) {
				if (!args.validationFailed) {
					varAvailableTourDepListDialog.hide();
					varTransferConfirmationDialog.hide();
					varAddBookingDialog.hide();
				}
			}

			function onValidationReason(xhr, status, args) {
				if (args.validationFailed) {
					varDelTourDepDialog.show()
				} else {
					varDelTourDepDialog.hide()
				}
			}

			function onTourDepUpdateValidation(xhr, status, args) {
				if (!args.validationFailed) {
					varTourDepReasonDialog.hide();
					varEditTourDepDialog.hide();
				} else {
					varTourDepReasonDialog.hide();
				}
			}
			
			document.addEventListener('DOMContentLoaded', function() {
				var filters = document.querySelectorAll('input.ui-inputtext');
		        filters.forEach(function(filter) {
		            filter.setAttribute('enterkeyhint', 'enter');
		        });
		    });
			
			function setEnterKeyHint() {
		        var filters = document.querySelectorAll('input.ui-inputtext');
		        filters.forEach(function(filter) {
		            filter.setAttribute('enterkeyhint', 'enter');
		        });
		    }

			/* document.getElementById("idTourPkgForm:idTab:lastDay").value = new Date(date.getFullYear(), date.getMonth()+1, 0); */
		</script>

		<p:panel header="Tour Packages" toggleable="true" toggleSpeed="500">
			<h:form id="idTourPkgForm">
				<p:tabView id="idTab"
					activeIndex="#{tourPkgBean.tourPkgActiveIndex}">
					<p:tab id="idTabList" title="Package List">
						<h:panelGrid columns="2" style="width:210px;">
							<h:outputLabel for="idTourCat">Category:</h:outputLabel>
							<h:selectOneMenu id="idTourCat"
								value="#{tourPkgBean.searchParamVO.obj2}" effect="fade">
								<f:selectItem itemLabel="Select One" />
								<f:selectItems value="#{tourPkgBean.tourCatViewList}" var="vo"
									itemLabel="#{vo.desc}" itemValue="#{vo.id}" />
								<p:ajax event="change"
									listener="#{tourPkgBean.handleTourCatSelect(true)}"
									update="@form,:idAddTourThemeForm" />
							</h:selectOneMenu>
						</h:panelGrid>
						<h:panelGrid columns="2" style="width:250px;">
							<p:commandButton value="Add Country/Theme"
								actionListener="#{tourPkgBean.handleAcct(false)}"
								oncomplete="varAddTourThemeDialog.show()"
								update=":idAddTourThemeDialog" />
						</h:panelGrid>

						<p:panel rendered="#{empty tourPkgBean.searchParamVO.obj2}">
							<h:outputText value="Please select category." />
						</p:panel>

						<p:panel
							rendered="#{not empty tourPkgBean.searchParamVO.obj2 and empty tourPkgBean.tourThemeList}">
							<h:outputText value="Please add theme." />
						</p:panel>

						<p:accordionPanel id="idTourPkgList"
							value="#{tourPkgBean.tourThemeList}" var="vo"
							activeIndex="#{tourPkgBean.activeAccordionTabIndex}">
							<p:ajax event="tabChange"
								listener="#{tourPkgBean.onAccordionTabChange}" global="false" />
							<p:tab
								title="#{vo.desc} #{empty vo.countriesName ? '' : ' - '} #{vo.countriesName}"
								titleStyle="font-size: 13px;">
								<div style="font-size: 1.1em !important;">
									<h:inputHidden value="#{tourPkgBean.beginNumber}" />
									<p:panelGrid>
										<p:row>
											<!-- <p:column><p:commandButton icon="ui-icon-plus" value="Package" action="#{tourPkgBean.handleAddTourPkgSelect(vo)}" oncomplete="varAddTourPkgDialog.show()" update=":idAddTourPkgDialog"/></p:column> -->
											<p:column>
												<p:commandButton icon="ui-icon-plus" value="Package"
													actionListener="#{tourPkgBean.handleAddTourPkgSelect(vo)}"
													action="REDIRECT_TO_DETAIL" />
											</p:column>
											<p:column style="text-align:right;">
												<p:commandButton icon="ui-icon-pencil" value="Child Theme"
													action="#{tourPkgBean.handleTourThemeSelect(vo)}"
													oncomplete="varEditChildThemeDialog.show()"
													update=":idEditChildThemeDialog" />
												<p:commandButton icon="ui-icon-pencil"
													action="#{tourPkgBean.handleTourThemeSelect(vo)}"
													oncomplete="varEditTourThemeDialog.show()"
													update=":idEditTourThemeDialog" />
												<p:commandButton icon="ui-icon-close"
													action="#{tourPkgBean.handleTourThemeSelect(vo)}"
													oncomplete="varDelTourThemeDialog.show()" />
											</p:column>
										</p:row>
									</p:panelGrid>

									<ui:repeat value="#{vo.tourThemeMapList}" var="themeYearVO"
										varStatus="varStatus">
										<h:panelGrid columns="1" rendered="#{varStatus.index gt 0}"
											style="background:#cccccc;font-size:1.3em;color:red;font-weight:bold;">
											<h:outputText value="#{themeYearVO.key}" />
											<h:inputHidden value="#{tourPkgBean.beginNumber}" />
										</h:panelGrid>

										<ui:repeat value="#{themeYearVO.value}" var="child">
											<p:panelGrid rendered="#{not empty child.tourPkgList}">
												<p:row>
													<p:column
														style="background:#{config['table.header.color']}; font-weight:bold;font-size: 1.07em !important">
														<h:outputText
															value="#{child.desc} #{empty child.countriesName ? '' : ' - '} #{child.countriesName}" />
													</p:column>
													<p:column
														style="width:35px; background:#{config['table.header.color']}; text-align:right;">
														<p:commandLink styleClass="ui-icon ui-icon-pencil"
															actionListener="#{tourPkgBean.handleTourThemeSelect(child)}"
															oncomplete="varEditTourThemeDialog.show()"
															update=":idEditTourThemeDialog" style="float:left;" />
														<p:commandLink styleClass="ui-icon ui-icon-close"
															actionListener="#{tourPkgBean.handleTourThemeSelect(child)}"
															oncomplete="varDelTourThemeDialog.show()"
															style="float:left;" />
													</p:column>
												</p:row>
											</p:panelGrid>

											<p:dataTable value="#{child.tourPkgList}" var="tourPkgVO"
												rendered="#{not empty child.tourPkgList}">
												<p:column headerText="Edit" style="width:30px;">
													<p:commandLink styleClass="ui-icon ui-icon-pencil"
														actionListener="#{tourPkgBean.setTourPkgVO(tourPkgVO, vo)}"
														update=":idEditTourPkgDialog" action="REDIRECT_TO_DETAIL" />
												</p:column>
												<p:column headerText="Del" style="width:30px;">
													<p:commandLink styleClass="ui-icon ui-icon-close"
														actionListener="#{tourPkgBean.setTourPkgVO(tourPkgVO, vo)}"
														update=":idDelTourPkgForm"
														oncomplete="varDelTourPkgDialog.show()" />
												</p:column>
												<p:column headerText="Clone" style="width:30px;">
													<p:commandLink styleClass="ui-icon ui-icon-plus"
														actionListener="#{tourPkgBean.setTourPkgVO(tourPkgVO, vo)}"
														oncomplete="varCloneTourPkgDialog.show()"
														style="margin-left: 8px;" />
												</p:column>
												<p:column headerText="No."
													style="width:50px; text-align:center;">
													<h:outputText value="#{tourPkgBean.runningNumber}" />
												</p:column>
												<p:column headerText="Description">
													<p:commandLink
														actionListener="#{tourPkgBean.handleTourPkgSelectChild(tourPkgVO, child)}"
														update=":idTourDepListDialog"
														oncomplete="varTourDepListDialog.show()"
														style="color:#000000; margin-right:5px;">
														<h:outputText
															value="#{tourPkgVO.numDays}D/#{tourPkgVO.numNights}N #{tourPkgVO.nameEn} #{tourPkgVO.nameOther}" />
														<h:outputText value="-Theme Tour" style="color:#FF0000;"
															rendered="#{tourPkgVO.isThemeTour}" />
													</p:commandLink>
													<ui:repeat value="#{tourPkgVO.tourBadgeDescList}"
														var="tourBadgeVO">
														<h:outputText value="#{tourBadgeVO}"
															style="display:inline-block; background:white; color:black; border:1px solid grey; border-radius: 5px; padding:2px; margin:2px;"
															rendered="#{not empty tourPkgVO.tourBadgeTagList}" />
													</ui:repeat>
													<ui:repeat value="#{tourPkgVO.travelStyleDescList}"
														var="travelBadgeVO">
														<h:outputText value="#{travelBadgeVO}"
															style="display:inline-block; background:white; color:red; border:1px solid red; border-radius: 5px; padding:2px; margin:2px;"
															rendered="#{not empty tourPkgVO.travelStyleList}" />
													</ui:repeat>
													<p:outputPanel style="vertical-align:middle; display:inline-block;" rendered="#{not tourPkgVO.isPushToOnline}">
														<p:graphicImage value="/img/offline.png" width="22" height="22"/>
													</p:outputPanel>
												</p:column>
											</p:dataTable>
										</ui:repeat>
									</ui:repeat>

									<ui:repeat value="#{vo.tourPkgMapList}" var="pkgYearVO"
										varStatus="varTourPkgStatus">
										<h:panelGrid columns="1"
											rendered="#{varTourPkgStatus.index gt 0}"
											style="background:#cccccc;font-size:1.3em;color:red;font-weight:bold;">
											<h:outputText value="#{pkgYearVO.key}" />
										</h:panelGrid>
										<p:dataTable value="#{pkgYearVO.value}" var="tourPkgVO"
											style="margin-top:10px;"
											rendered="#{empty vo.tourThemeMapList}">
											<p:column headerText="Edit" style="width:30px;">
												<p:commandLink styleClass="ui-icon ui-icon-pencil"
													actionListener="#{tourPkgBean.setTourPkgVO(tourPkgVO, vo)}"
													update=":idEditTourPkgDialog" action="REDIRECT_TO_DETAIL" />
											</p:column>
											<p:column headerText="Del" style="width:30px;">
												<p:commandLink styleClass="ui-icon ui-icon-close"
													actionListener="#{tourPkgBean.setTourPkgVO(tourPkgVO, vo)}"
													oncomplete="varDelTourPkgDialog.show()" />
											</p:column>
											<p:column headerText="Clone" style="width:30px;">
												<p:commandLink styleClass="ui-icon ui-icon-plus"
													actionListener="#{tourPkgBean.setTourPkgVO(tourPkgVO, vo)}"
													oncomplete="varCloneTourPkgDialog.show()"
													style="margin-left: 8px;" />
											</p:column>
											<p:column headerText="No."
												style="width:50px; text-align:center;">
												<h:outputText value="#{tourPkgBean.runningNumber}" />
											</p:column>
											<p:column headerText="Description">
												<p:commandLink
													actionListener="#{tourPkgBean.handleTourPkgSelect(tourPkgVO)}"
													update=":idTourDepListDialog"
													oncomplete="varTourDepListDialog.show()"
													style="color:#000000;">
													<h:outputText
														value="#{tourPkgVO.numDays}D/#{tourPkgVO.numNights}N #{tourPkgVO.nameEn} #{tourPkgVO.nameOther} #{tourPkgVO.nameZh}" />
													<h:outputText value="-Theme Tour" style="color:#FF0000;"
														rendered="#{tourPkgVO.isThemeTour}" />
												</p:commandLink>
											</p:column>
										</p:dataTable>
									</ui:repeat>
								</div>
							</p:tab>
						</p:accordionPanel>
						<h:panelGrid columns="2" style="width:250px;">
							<p:commandButton value="Add Country/Theme"
								actionListener="#{tourPkgBean.handleAcct(false)}"
								oncomplete="varAddTourThemeDialog.show()"
								update=":idAddTourThemeDialog" />
						</h:panelGrid>
					</p:tab>
					<p:tab id="idTabSearchList" title="Find Tour List">
						<p:panelGrid id="idSearchFilter">
							<p:row>
								<p:column style="width: 80px;">
									<p:outputLabel value="Tour Code" />
								</p:column>
								<p:column style="width: 80px;">
									<p:outputLabel value="Package Title" />
								</p:column>
								<p:column style="width: 100px;">
									<p:outputLabel for="idValidFrom" value="Dep. Date From" />
								</p:column>
								<p:column style="width: 10px;">
									<p:outputLabel value="To" for="idValidTo" />
								</p:column>
								<p:column style="width: 10px;">
									<p:outputLabel value="Price From" for="idPriceFrom"/>
								</p:column>
								<p:column style="width: 10px;">
									<p:outputLabel value="To" for="idPriceTo"/>
								</p:column>
								<p:column style="width: 80px;">
									<p:outputLabel value="Balance Seat" for="idBalSeat"/>
								</p:column>
							</p:row>
							<p:row>
								<p:column>
									<p:inputText id="idTourCode" value="#{tourPkgBean.searchTourDepFilter.code}" />
									<p:watermark for="idTourCode" value="Tour Code" />
								</p:column>
								<p:column>
									<p:inputText id="idPkgTitle" value="#{tourPkgBean.searchTourDepFilter.packageDesc}" size="30" />
									<p:watermark for="idPkgTitle" value="Package Title" />
								</p:column>
								<p:column>
									<p:calendar id="idValidFrom" navigator="true" showButtonPanel="true" size="15"
										pattern="dd-MMM-yyyy" value="#{tourPkgBean.searchTourDepFilter.fromDate}"
										maxdate="#{tourPkgBean.searchTourDepFilter.toDate}">
										<p:ajax event="dateSelect"
											update=":idTourPkgForm:idTab:idValidFrom, :idTourPkgForm:idTab:idValidTo"
											global="false" />
									</p:calendar>
									<p:watermark for="idValidFrom" value="dd-mmm-yyyy" />
								</p:column>
								<p:column>
									<p:calendar id="idValidTo" navigator="true" showButtonPanel="true" size="15"
										pattern="dd-MMM-yyyy" value="#{tourPkgBean.searchTourDepFilter.toDate}"
										mindate="#{tourPkgBean.searchTourDepFilter.fromDate}">
										<p:ajax event="dateSelect"
											update=":idTourPkgForm:idTab:idValidFrom" global="false" />
										<p:ajax event="change"
											update=":idTourPkgForm:idTab:idValidFrom" global="false" />
									</p:calendar>
									<p:watermark for="idValidTo" value="dd-mmm-yyyy" />
								</p:column>
								<p:column>
									<p:inputText id="idPriceFrom" value="#{tourPkgBean.searchTourDepFilter.priceFrom}" size="10" maxlength="10">
										<!-- <f:convertNumber pattern="#,##0.00" /> -->
										<pe:keyFilter regEx="/[\d\.\s,]/" />
									</p:inputText>
								</p:column>
								<p:column>
									<p:inputText id="idPriceTo" value="#{tourPkgBean.searchTourDepFilter.priceTo}" size="10" maxlength="10">
										<pe:keyFilter regEx="/[\d\.\s,]/" />
									</p:inputText>
								</p:column>
								<p:column>
									<p:inputText id="idBalSeat" value="#{tourPkgBean.searchTourDepFilter.balanceSeat}" size="6" maxlength="3">
										<pe:keyFilter regEx="/[\d]/"/>
									</p:inputText>
								</p:column>
								<p:column>
									<p:spacer width="250" height="10"/>
								</p:column>
							</p:row>
							<p:row>
								<p:column colspan="8">
									<p:panelGrid style="width: 10px;">
										<p:row>
											<p:column>
												<p:selectCheckboxMenu value="#{tourPkgBean.searchTourDepFilter.tourStatusList}" label="Tour Status" style="width:100px; display:block;">
													<f:selectItems value="#{bterp:lookupItemList('tour_status')}" var="statusVO" itemLabel="#{statusVO.description}" itemValue="#{statusVO.code}" />
												</p:selectCheckboxMenu>
											</p:column>
											<p:column>
												<p:selectCheckboxMenu value="#{tourPkgBean.searchTourDepFilter.departDateBadgeList}" label="Depart date badge" style="width:150px; display:block;" >
												<f:selectItems value="#{bterp:lookupItemList('depart_date_badge')}" var="badgeVO" itemValue="#{badgeVO.code}" itemLabel="#{badgeVO.description}"/>
											</p:selectCheckboxMenu>
											</p:column>
											<p:column>
												<p:selectCheckboxMenu value="#{tourPkgBean.searchTourDepFilter.selectedSeason}" label="Season" style="width:100px; display:block;" >
													<f:selectItems value="#{tourPkgBean.refDataListSeason}" var="seasonVO" itemLabel="#{seasonVO.value}" itemValue="#{seasonVO.code}" />
												</p:selectCheckboxMenu>
											</p:column>
											<p:column>
												<p:selectCheckboxMenu value="#{tourPkgBean.searchTourDepFilter.tourLangList}" label="Tour Languages" style="width:150px; display:block;">
													<f:selectItems value="#{bterp:lookupItemList('product_lang')}" var="langVO" itemLabel="#{langVO.description}" itemValue="#{langVO.code}" />
												</p:selectCheckboxMenu>
											</p:column>
											<p:column>
												<p:selectCheckboxMenu id="idSectorType" label="Sector Type" filter="true" filterMatchMode="contains" style="width:100px; display:block;"
													value="#{tourPkgBean.searchTourDepFilter.sectorTypeList}" onHide="executeOnContinentOnhide();">
													<f:selectItems value="#{tourPkgBean.filterFullRegionList}" var="rgnVO" itemValue="#{rgnVO.id}" itemLabel="#{rgnVO.regionname}" />
												</p:selectCheckboxMenu>
												<p:remoteCommand name="executeOnContinentOnhide" actionListener="#{tourPkgBean.handleSectorTypeChange}" global="false"
									       			update=":idTourPkgForm:idTab:idSector" process="@this :idTourPkgForm:idTab:idSectorType" />
											</p:column>
											<p:column>
												<p:selectCheckboxMenu id="idSector" label="Sector" filter="true" filterMatchMode="contains" style="width:100px; display:block;"
													disabled="#{empty tourPkgBean.searchTourDepFilter.sectorTypeList}"
													value="#{tourPkgBean.searchTourDepFilter.sectorList}">
													<f:selectItems value="#{tourPkgBean.filterFullCountryList}" var="ctryVO" itemValue="#{ctryVO.id}" itemLabel="#{ctryVO.country}" />
												</p:selectCheckboxMenu>
											</p:column>
											<p:column>
												<p:selectBooleanCheckbox
													value="#{tourPkgBean.searchTourDepFilter.inactiveRecord}"
													itemLabel="Inactive Records" style="width:120px; display:block;"/>
											</p:column>
											<p:column>
												<p:commandButton value="Search" id="pkgSearch"
													actionListener="#{tourPkgBean.handleFilterTourDepList}"
													oncomplete="setEnterKeyHint();"
													update=":idTourPkgForm:idTab:idFilterTourDepList" />
												<p:defaultCommand target="pkgSearch" />
											</p:column>
											<p:column>
												<p:commandButton value="Clear All"
													actionListener="#{tourPkgBean.handleFilterClearAll}" style="width: 70px;"
													update=":idTourPkgForm:idTab:idSearchFilter" process="@this"/>
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:column>
							</p:row>
						</p:panelGrid>
						<div class="tourDepListClass">
						<p:dataTable id="idFilterTourDepList"
							value="#{tourPkgBean.tourFilterDepList}" var="filterVO" rows="10"
							rowStyleClass="#{filterVO.groupColor eq 0 ? 'group-color-one' : 'group-color-two'}"
							paginator="true"
							paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink} {RowsPerPageDropdown}"
							rowsPerPageTemplate="5,10,15" rowKey="#{filterVO.id}" selectionMode="single">

							<p:columnGroup type="header">
								<p:row>
									<p:column rowspan="2" headerText="Function" style="width:45px;" />
									<p:column rowspan="2" headerText="Tour Package" style="width:130px;" />
									<p:column rowspan="2" headerText="Dep Date" style="width:120px;" sortBy="#{filterVO.dtDep}" />
									<p:column rowspan="2" headerText="Status" style="width:60px;" sortBy="#{filterVO.tourStatusCd}" />
									<p:column rowspan="2" headerText="Tour Code" style="width:130px;" />
									<p:column rowspan="2" headerText="Departure Name" style="width:160px;" />
									<p:column rowspan="2" headerText="Airline" style="width:40px;" />
									<p:column colspan="2" headerText="Discount Level" />
									<p:column colspan="9" headerText="Seat Allotment" />
									<p:column colspan="2" headerText="Adult (RM)" />
									<p:column colspan="3" headerText="Child (RM)" />
									<p:column rowspan="2" headerText="Misc&lt;br/&gt;Adt/Chd"
										style="width:70px;" />
									<p:column rowspan="2" headerText="Normal&lt;br/&gt;AC/SI"
										style="width:45px;" />
									<p:column rowspan="2" headerText="More&lt;br/&gt;Info"
										style="width:30px;" />
								</p:row>
								<p:row>
									<p:column headerText="Level 1" style="width:60px;" />
									<p:column headerText="Level 2" style="width:60px;" />
									<p:column headerText="HK&lt;br/&gt;Seat" style="width:30px;" />
									<p:column headerText="TFair&lt;br/&gt;Pax" style="width:30px;" />
									<p:column headerText="AGT&lt;br/&gt;Pax" style="width:30px;" />
									<p:column headerText="In-Hs&lt;br/&gt;Pax" style="width:30px;" />
									<p:column headerText="On9&lt;br/&gt;Pax" style="width:30px;" />
									<p:column headerText="KIV&lt;br/&gt;Pax" style="width:30px;" />
									<p:column headerText="Total&lt;br/&gt;Sold" style="width:30px;" />
									<p:column headerText="Bal&lt;br/&gt;Seat" style="width:30px;" />
									<p:column headerText="GA" style="width:30px;" />
									<p:column headerText="TWN" style="width:55px;" />
									<p:column headerText="SGL" style="width:55px;" />
									<p:column headerText="CTW" style="width:55px;" />
									<p:column headerText="CWB" style="width:55px;" />
									<p:column headerText="CNB" style="width:55px;" />
								</p:row>
							</p:columnGroup>

							<p:column style="width:50px;">
								<p:commandButton icon="ui-icon-pencil"
									actionListener="#{tourPkgBean.handleTourDepSelectFromSearch(filterVO)}"
									update=":idEditTourDepDialog"
									oncomplete="varEditTourDepDialog.show()"
									rendered="#{filterVO.statusCode eq 'AC'}">
								</p:commandButton>
								<p:outputPanel style="vertical-align:middle; display:inline-block;" rendered="#{not filterVO.isPushToOnline}">
									<p:graphicImage id="idTooltipOffline" value="/img/offline.png" width="22" height="22"/>
									<pe:tooltip for="idTooltipOffline" rendered="#{not filterVO.isPushToOnline}">
										<h:outputText value="Offline"/>
									</pe:tooltip>
								</p:outputPanel>
							</p:column>
							<p:column style="width:130px;">
								<h:outputText
									value="#{filterVO.nameEn}#{filterVO.nameZh}#{filterVO.nameOther}" />
							</p:column>
							<p:column style="width:120px;">
								<h:outputText value="#{filterVO.dtDep}">
									<f:convertDateTime pattern="#{config['date.display.pattern2']}" />
								</h:outputText>
								<ui:repeat value="#{filterVO.departDateBadgeList}" var="badgeVO">
									<h:outputText id="idTooltipBadge" value="#{badgeVO}"
										style="display:inline-block; background:white; #{not empty filterVO.departDateBadgeList and filterVO.departDateBadgeList.contains('DISCx2') ? 'color:red; border:1px solid red;' : 'color:green; border:1px solid green;'} border-radius: 5px; padding:2px; margin:2px;"
										rendered="#{not empty filterVO.departDateBadgeList}"/>
									<pe:tooltip for="idTooltipBadge" rendered="#{not empty badgeVO}">
										<h:outputText value="#{bterp:lookupItemDesc('depart_date_badge', badgeVO)}"/>
									</pe:tooltip>
								</ui:repeat>
								<h:outputText id="idTooltipLangCode" rendered="#{not empty filterVO.langCode}" style="display:inline-block; background:#{filterVO.langCode eq 'BM' ? 'green' : 'white'}; color:#{filterVO.langCode eq 'BM' ? 'white' : 'green'}; border:1px solid green; border-radius: 5px; padding:2px; margin:2px;"
									value="#{filterVO.langCode}"/>
								<pe:tooltip for="idTooltipLangCode" rendered="#{not empty filterVO.langCode}">
									<h:outputText value="#{bterp:lookupItemDesc('product_lang', filterVO.langCode)}"/>
								</pe:tooltip>
							</p:column>
							<p:column style="width:60px;">
								<p:outputPanel layout="block">
									<h:outputText id="idTooltipPricing"
										value="#{bterp:lookupItemDesc('tour_status', filterVO.tourStatusCd)}"
										rendered="#{filterVO.tourStatusCd eq 'A' or filterVO.tourStatusCd eq 'L'}" />
									<h:outputText value="Full"
										style="text-transform:uppercase; color:#F00;"
										rendered="#{filterVO.tourStatusCd eq 'F'}" />
									<h:outputText
										value="#{bterp:lookupItemDesc('tour_status', filterVO.tourStatusCd)}"
										style="text-transform:uppercase; color:#F00;"
										rendered="#{filterVO.tourStatusCd eq 'I' or filterVO.tourStatusCd eq 'C' or filterVO.tourStatusCd eq 'N' or filterVO.tourStatusCd eq 'R' or filterVO.tourStatusCd eq 'C1'}" />
									<h:outputText value="#{bterp:lookupItemDesc('tour_status', filterVO.tourStatusCd)}"
										style="text-transform:uppercase; color:#F00;"
										rendered="#{filterVO.tourStatusCd ne 'A' and filterVO.tourStatusCd ne 'L' and filterVO.tourStatusCd ne 'F'
												and filterVO.tourStatusCd ne 'I' and filterVO.tourStatusCd ne 'C' and filterVO.tourStatusCd ne 'N'
												and filterVO.tourStatusCd ne 'R' and filterVO.tourStatusCd ne 'C1'}"/>
									<p:graphicImage id="idTooltipStatusReason" value="/img/more.png" width="11" style="margin-left: 3px;" rendered="#{not empty filterVO.tourStatusReason}"/>
								</p:outputPanel>
								<pe:tooltip for="idTooltipStatusReason" shared="true" showDelay="0" myPosition="left center" atPosition="right center"
									rendered="#{not empty filterVO.tourStatusReason}">
									<h:outputText value="#{filterVO.tourStatusReason}" escape="true" style="white-space: pre-wrap"/>
								</pe:tooltip>
								<pe:tooltip for="idTooltipPricing" shared="true" showDelay="0" myPosition="left center" atPosition="right center">
									<!-- <p:outputLabel value="#{salesBean.getCalculatedAmount(vo)}" style="white-space: pre-wrap"/> -->
                					TWN=<span style="font-weight: bold;">#{tourPkgBean.getDoubleDecimalFormat(((filterVO.fullTwn + filterVO.miscAdt - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) lt 0) ? 0 : (filterVO.fullTwn + filterVO.miscAdt - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((filterVO.fullTwn + filterVO.miscAdt - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) lt 0) ? 0 : (filterVO.fullTwn + filterVO.miscAdt - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))))}</span>
									<span style="color:#F00;">#{(filterVO.discountPax1 > 0 or filterVO.discountPax2 > 0) ? (filterVO.discountPax1 > 0 ? '('.concat(filterVO.discountPax1).concat(')') : '('.concat(filterVO.discountPax2).concat(')')) : ''}</span>
									&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
               					 	SGL=<span style="font-weight: bold;">#{tourPkgBean.getDoubleDecimalFormat(((filterVO.fullSgl + filterVO.miscAdt - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) lt 0) ? 0 : (filterVO.fullSgl + filterVO.miscAdt - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((filterVO.fullSgl + filterVO.miscAdt - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) lt 0) ? 0 : (filterVO.fullSgl + filterVO.miscAdt - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))))}</span>
									<span style="color:#F00;">#{(filterVO.discountPax1 > 0 or filterVO.discountPax2 > 0) ? (filterVO.discountPax1 > 0 ? '('.concat(filterVO.discountPax1).concat(')') : '('.concat(filterVO.discountPax2).concat(')')) : ''}</span>
									<br/>
                					CTW=<span style="font-weight: bold;">#{tourPkgBean.getDoubleDecimalFormat(((filterVO.fullCtw + filterVO.miscChd - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) lt 0) ? 0 : (filterVO.fullCtw + filterVO.miscChd - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((filterVO.fullCtw + filterVO.miscChd - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) lt 0) ? 0 : (filterVO.fullCtw + filterVO.miscChd - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))))}</span>
									<span style="color:#F00;">#{(filterVO.discountPax1 > 0 or filterVO.discountPax2 > 0) ? (filterVO.discountPax1 > 0 ? '('.concat(filterVO.discountPax1).concat(')') : '('.concat(filterVO.discountPax2).concat(')')) : ''}</span>
									&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                					CWB=<span style="font-weight: bold;">#{tourPkgBean.getDoubleDecimalFormat(((filterVO.fullCeb + filterVO.miscChd - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) lt 0) ? 0 : (filterVO.fullCeb + filterVO.miscChd - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((filterVO.fullCeb + filterVO.miscChd - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) lt 0) ? 0 : (filterVO.fullCeb + filterVO.miscChd - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))))}</span>
									<span style="color:#F00;">#{(filterVO.discountPax1 > 0 or filterVO.discountPax2 > 0) ? (filterVO.discountPax1 > 0 ? '('.concat(filterVO.discountPax1).concat(')') : '('.concat(filterVO.discountPax2).concat(')')) : ''}</span>
									&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                					CNB=<span style="font-weight: bold;">#{tourPkgBean.getDoubleDecimalFormat(((filterVO.fullCnb + filterVO.miscChd - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) lt 0) ? 0 : (filterVO.fullCnb + filterVO.miscChd - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((filterVO.fullCnb + filterVO.miscChd - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))) lt 0) ? 0 : (filterVO.fullCnb + filterVO.miscChd - (filterVO.discountPax1 > 0 ? filterVO.discount1 : (filterVO.discountPax2 > 0 ? filterVO.discount2 : 0))))}</span>
									<span style="color:#F00;">#{(filterVO.discountPax1 > 0 or filterVO.discountPax2 > 0) ? (filterVO.discountPax1 > 0 ? '('.concat(filterVO.discountPax1).concat(')') : '('.concat(filterVO.discountPax2).concat(')')) : ''}</span>
									<br/><br/>
									<span style="font-weight: bold;">Deposit #{tourPkgBean.getDoubleDecimalFormat('#,##0', filterVO.deposit)}</span> per pax 
									<h:outputLabel style="font-size:11px; color:#F00;" rendered="#{(filterVO.discountPax1 gt 0 and filterVO.discount1 gt 0) or (filterVO.discountPax2 gt 0 and filterVO.discount2 gt 0)}">
										<br/><br/>
										Noted: Above price is <b>Grand Total include Discount (If has)</b>
									</h:outputLabel>
								</pe:tooltip>
							</p:column>
							<p:column style="width:130px;">
								<p:commandLink actionListener="#{tourPkgBean.handleShowEOList(filterVO)}" update=":idEODetailsDialog" oncomplete="varEODetailsDialog.show()" style="color:#CC2EFA;" process="@this">
									<h:outputText value="#{filterVO.code} "/>
								</p:commandLink>
								<h:outputText id="idTooltipLock" class="fa fa-lock" rendered="#{filterVO.isLock}" style="margin-left: 3px;"/>
								<pe:tooltip for="idTooltipLock" rendered="#{filterVO.isLock}">
									<h:outputText value="Invoice Locked"/>
								</pe:tooltip>
								<h:outputText id="idTooltipPrivate" class="fa fa-user" rendered="#{filterVO.isPrivateTour}" style="margin-left: 3px;"/>
								<pe:tooltip for="idTooltipPrivate" rendered="#{filterVO.isPrivateTour}">
									<h:outputText value="Private Tour"/>
								</pe:tooltip>
							</p:column>
							<p:column style="width:160px;">
								<p:commandLink
									actionListener="#{tourPkgBean.handleShowBookingListFromSearch(filterVO)}"
									oncomplete="varBookingListDialog.show()"
									update=":idBookingListDialog" style="color:#CC2EFA;">
									<h:outputText value="#{filterVO.duration}" rendered="false" />
									<h:outputText value="PD " rendered="#{filterVO.isDepositPaid}" />
									<h:outputText
										value="#{filterVO.numDays}D/#{filterVO.numNights}N " />
									<h:outputText value="[#{filterVO.desc}]" style="color:#FF0000;"
										rendered="#{not empty filterVO.desc}" />
									<h:outputText value="[#{filterVO.prn}]" style="color:#0040FF;"
										rendered="#{not empty filterVO.prn}" />
									<h:outputText value="[S]" style="color:#86B404;"
										rendered="#{filterVO.isIssuedS}" />
									<h:outputText value="[F]" style="color:#86B404;"
										rendered="#{filterVO.isIssuedF}" />
									<h:outputText value="[#{filterVO.dailyCode}]"
										style="color:#000000;"
										rendered="#{not empty filterVO.dailyCode}" />
									<p:graphicImage value="/img/push.gif"
										rendered="#{filterVO.isPush and (filterVO.tourStatusCd eq 'A' or filterVO.tourStatusCd eq 'L')}" />
									<ui:repeat value="#{filterVO.departDateBadgeList}"
										var="badgeVO">
										<h:outputText value="(#{badgeVO})" style="color:brown;"
											rendered="#{not empty filterVO.departDateBadgeList}" />
									</ui:repeat>
								</p:commandLink>
							</p:column>
							<p:column style="width:40px;">
								<p:commandLink actionListener="#{tourPkgBean.handleTourDepSelectFromSearch(filterVO)}" oncomplete="varTourDepAirlineInfoDialog.show()" update=":idTourDepAirlineInfoDialog" style="color:#CC2EFA;" process="@this">
									<h:outputText value="#{filterVO.airlineCode}"/>
								</p:commandLink>
							</p:column>
							<p:column style="width:60px;">
								<h:outputText
									value="#{filterVO.discount1 gt 0 ? filterVO.discount1 * -1 : filterVO.discount1}"
									rendered="#{filterVO.discount1 % 1 &gt; 0}"
									style="#{not empty filterVO.departDateBadgeList and filterVO.departDateBadgeList.contains('DISCx2') ? 'color: red; font-weight:bold;' : ''}">
									<f:convertNumber pattern="#,##0.00" />
								</h:outputText>
								<h:outputText
									value="#{filterVO.discount1 gt 0 ? filterVO.discount1 * -1 : filterVO.discount1}"
									rendered="#{filterVO.discount1 % 1 &lt;= 0}"
									style="#{not empty filterVO.departDateBadgeList and filterVO.departDateBadgeList.contains('DISCx2') ? 'color: red; font-weight:bold;' : ''}">
									<f:convertNumber pattern="#,##0" />
								</h:outputText>
								<h:outputText value=" (#{filterVO.discountPax1})"
									style="color: red;" />
							</p:column>
							<p:column style="width:60px;">
								<h:outputText
									value="#{filterVO.discount2 gt 0 ? filterVO.discount2 * -1 : filterVO.discount2}"
									rendered="#{filterVO.discount2 % 1 &gt; 0}">
									<f:convertNumber pattern="#,##0.00" />
								</h:outputText>
								<h:outputText
									value="#{filterVO.discount2 gt 0 ? filterVO.discount2 * -1 : filterVO.discount2}"
									rendered="#{filterVO.discount2 % 1 &lt;= 0}">
									<f:convertNumber pattern="#,##0" />
								</h:outputText>
								<h:outputText value=" (#{filterVO.discountPax2})"
									style="color: red;" />
							</p:column>
							<p:column style="width:30px;">
								<h:outputText value="#{filterVO.seatAllot}" />
							</p:column>
							<p:column style="width:30px;">
								<h:outputText value="#{filterVO.tfairPax}" />
							</p:column>
							<p:column style="width:30px;">
								<h:outputText value="#{filterVO.agentPax}" />
							</p:column>
							<p:column style="width:30px;">
								<h:outputText value="#{filterVO.inHsePax}" />
							</p:column>
							<p:column style="width:30px;">
								<h:outputText value="#{filterVO.on9BookingPax}"/>
							</p:column>
							<p:column style="width:30px;">
								<h:outputText value="#{filterVO.kivPax}" />
							</p:column>
							<p:column style="width:30px; font-size:10px; background:#00BFFF; text-align:center;">
								<h:outputText
									value="#{filterVO.tfairPax + filterVO.agentPax + filterVO.inHsePax + filterVO.kivPax + filterVO.on9BookingPax}" />
							</p:column>
							<p:column style="width:30px;">
								<h:outputText
									value="#{filterVO.seatAllot - filterVO.reservedSeat - filterVO.tourManagerPax - (filterVO.tfairPax + filterVO.agentPax + filterVO.inHsePax + filterVO.kivPax + filterVO.on9BookingPax)}"
									style="#{(filterVO.seatAllot - filterVO.reservedSeat - filterVO.tourManagerPax - (filterVO.tfairPax + filterVO.agentPax + filterVO.inHsePax + filterVO.kivPax + filterVO.on9BookingPax)) eq 0 ? 'color:#f00; font-weight:bold;' : ''}" />
							</p:column>
							<p:column style="width:30px;">
								<h:outputText value="#{filterVO.totalGA}" />
							</p:column>
							<p:column style="width:55px;">
								<h:outputText value="#{filterVO.fullTwn}"
									rendered="#{filterVO.fullTwn % 1 &gt; 0}">
									<f:convertNumber pattern="#,##0.00" />
								</h:outputText>
								<h:outputText value="#{filterVO.fullTwn}"
									rendered="#{filterVO.fullTwn % 1 &lt;= 0}">
									<f:convertNumber pattern="#,##0" />
								</h:outputText>
							</p:column>
							<p:column style="width:55px;">
								<h:outputText value="#{filterVO.fullSgl}"
									rendered="#{filterVO.fullSgl % 1 &gt; 0}">
									<f:convertNumber pattern="#,##0.00" />
								</h:outputText>
								<h:outputText value="#{filterVO.fullSgl}"
									rendered="#{filterVO.fullSgl % 1 &lt;= 0}">
									<f:convertNumber pattern="#,##0" />
								</h:outputText>
							</p:column>
							<p:column style="width:55px;">
								<h:outputText value="#{filterVO.fullCtw}"
									rendered="#{filterVO.fullCtw % 1 &gt; 0}">
									<f:convertNumber pattern="#,##0.00" />
								</h:outputText>
								<h:outputText value="#{filterVO.fullCtw}"
									rendered="#{filterVO.fullCtw % 1 &lt;= 0}">
									<f:convertNumber pattern="#,##0" />
								</h:outputText>
							</p:column>
							<p:column style="width:55px;">
								<h:outputText value="#{filterVO.fullCeb}"
									rendered="#{filterVO.fullCeb % 1 &gt; 0}">
									<f:convertNumber pattern="#,##0.00" />
								</h:outputText>
								<h:outputText value="#{filterVO.fullCeb}"
									rendered="#{filterVO.fullCeb % 1 &lt;= 0}">
									<f:convertNumber pattern="#,##0" />
								</h:outputText>
							</p:column>
							<p:column style="width:55px;">
								<h:outputText value="#{filterVO.fullCnb}"
									rendered="#{filterVO.fullCnb % 1 &gt; 0}">
									<f:convertNumber pattern="#,##0.00" />
								</h:outputText>
								<h:outputText value="#{filterVO.fullCnb}"
									rendered="#{filterVO.fullCnb % 1 &lt;= 0}">
									<f:convertNumber pattern="#,##0" />
								</h:outputText>
							</p:column>
							<p:column style="width:70px;">
								<h:outputText value="#{filterVO.miscAdt}"
									rendered="#{filterVO.miscAdt % 1 &gt; 0}">
									<f:convertNumber pattern="#,##0.00" />
								</h:outputText>
								<h:outputText value="/"
									rendered="#{filterVO.miscAdt % 1 &gt; 0}" />
								<h:outputText value="#{filterVO.miscChd}"
									rendered="#{filterVO.miscChd % 1 &gt; 0}">
									<f:convertNumber pattern="#,##0.00" />
								</h:outputText>
								<h:outputText value="#{filterVO.miscAdt}"
									rendered="#{filterVO.miscAdt % 1 &lt;= 0}">
									<f:convertNumber pattern="#,##0" />
								</h:outputText>
								<h:outputText value="/"
									rendered="#{filterVO.miscAdt % 1 &lt;= 0}" />
								<h:outputText value="#{filterVO.miscChd}"
									rendered="#{filterVO.miscChd % 1 &lt;= 0}">
									<f:convertNumber pattern="#,##0" />
								</h:outputText>
							</p:column>
							<p:column style="width:45px;">
								<h:outputText value="#{filterVO.cnaAdt}"
									rendered="#{filterVO.cnaAdt % 1 &gt; 0}">
									<f:convertNumber pattern="#,##0.00" />
								</h:outputText>
								<h:outputText value="/" rendered="#{filterVO.cnaAdt % 1 &gt; 0}" />
								<h:outputText value="#{filterVO.csiAdt}"
									rendered="#{filterVO.csiAdt % 1 &gt; 0}">
									<f:convertNumber pattern="#,##0.00" />
								</h:outputText>
								<h:outputText value="#{filterVO.cnaAdt}"
									rendered="#{filterVO.cnaAdt % 1 &lt;= 0}">
									<f:convertNumber pattern="#,##0" />
								</h:outputText>
								<h:outputText value="/"
									rendered="#{filterVO.cnaAdt % 1 &lt;= 0}" />
								<h:outputText value="#{filterVO.csiAdt}"
									rendered="#{filterVO.csiAdt % 1 &lt;= 0}">
									<f:convertNumber pattern="#,##0" />
								</h:outputText>
							</p:column>
							<p:column style="width:30px;">
								<p:commandLink
									actionListener="#{tourPkgBean.handleTourDepSelectFromSearch(filterVO)}"
									oncomplete="varTourDepMoreInfoDialog.show()"
									update=":idTourDepMoreInfoDialog">
									<p:graphicImage value="/img/more.png" />
								</p:commandLink>
							</p:column>
						</p:dataTable>
						</div>
					</p:tab>
				</p:tabView>
			</h:form>
		</p:panel>

		<!--
	DIALOG - ADD TOUR THEME
-->
		<p:dialog id="idAddTourThemeDialog" widgetVar="varAddTourThemeDialog"
			header="Add Tour Theme" modal="true" resizable="false" dynamic="true"
			draggable="true" hideEffect="fade" showEffect="fade" closable="false">
			<h:form id="idAddTourThemeForm">
				<ui:include src="../common/add_theme.xhtml" />
			</h:form>
		</p:dialog>

		<!--
	DIALOG - EDIT TOUR THEME
-->
		<p:dialog id="idEditTourThemeDialog"
			widgetVar="varEditTourThemeDialog" header="Edit Tour Theme"
			modal="true" resizable="false" dynamic="true" draggable="true"
			hideEffect="fade" showEffect="fade" closable="false">
			<h:form id="idEditTourThemeForm">
				<ui:include src="../common/add_theme.xhtml" />
			</h:form>
		</p:dialog>

		<!--
	DIALOG - EDIT CHILD THEME
-->
		<p:dialog id="idEditChildThemeDialog"
			widgetVar="varEditChildThemeDialog" header="Edit Child Theme"
			modal="true" resizable="false" dynamic="true" draggable="true"
			hideEffect="fade" showEffect="fade" closable="true">
			<h:form id="idEditChildThemeForm">
				<ui:include src="../common/edit_child_theme.xhtml" />
			</h:form>
		</p:dialog>

		<!--
	DIALOG - DELETE TOUR THEME
-->
		<p:confirmDialog widgetVar="varDelTourThemeDialog"
			message="Are you sure want to delete this tour theme?">
			<h:form id="idDelTourThemeForm">
				<p:growl id="msg" />
				<p:commandButton value="#{msg['common.button.label.yes']}"
					actionListener="#{tourPkgBean.delTourTheme}"
					update="@form,:idTourPkgForm"
					oncomplete="varDelTourThemeDialog.hide(),if (args &amp;&amp; !args.validationFailed) varEditChildThemeDialog.hide()" />
				<p:commandButton value="#{msg['common.button.label.no']}"
					actionListener="#{tourPkgBean.resetForm}"
					oncomplete="varDelTourThemeDialog.hide()" update="@form"
					process="@this" global="false">
					<pe:resetEditableValues for="idDelTourThemeForm" />
				</p:commandButton>
			</h:form>
		</p:confirmDialog>

		<!--
	DIALOG - ADD TOUR PACKAGE
-->
