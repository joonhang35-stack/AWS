			<h:form id="idHotelListForm">
				<ui:include src="hotel_list.xhtml" />
			</h:form>
		</p:dialog>

		<!--
	DIALOG - ACCOUNT LIST
-->
		<p:dialog widgetVar="varAcctListDialog" header="GL Account List"
			modal="true" resizable="false" dynamic="true" draggable="true"
			closable="true">
			<h:form id="idAcctListForm">
				<!--p:dataTable value="#{tourPkgBean.acctViewList}" var="vo" paginator="true" rows="10" 
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
			rowsPerPageTemplate="5, 10, 15" rowKey="#{vo.id}" selectionMode="single"-->
				<p:dataTable value="#{tourPkgBean.acctViewList}" var="vo"
					rowKey="#{vo.id}" selectionMode="single" scrollable="true"
					scrollHeight="200">
					<p:ajax event="rowSelect"
						listener="#{tourPkgBean.handleAcctSelect}"
						update=":idAddDepItemForm:idGLAcct,:idEditDepItemForm:idGLAcct"
						oncomplete="varAcctListDialog.hide()" />

					<p:column headerText="Account" sortBy="#{vo.code}"
						filterBy="#{vo.code}" style="width:200px;">
						<h:outputText value="#{vo.code}" rendered="#{empty vo.subCode}" />
						<h:outputText value="#{vo.code}-#{vo.subCode}"
							rendered="#{not empty vo.subCode}" />
					</p:column>
					<p:column headerText="Description" sortBy="#{vo.desc}"
						filterBy="#{vo.desc}" style="width:250px;">
						<h:outputText value="#{vo.desc}" rendered="#{empty vo.subDesc}" />
						<h:outputText value="#{vo.desc}, #{vo.subDesc}"
							rendered="#{not empty vo.subDesc}" />
					</p:column>
				</p:dataTable>
				<h:panelGrid columns="1">
					<p:commandButton value="#{msg['common.button.label.cancel']}"
						onclick="varAcctListDialog.hide()" process="@this" />
				</h:panelGrid>
			</h:form>
		</p:dialog>

		<!--
	DIALOG - TOUR DEPARTURE MORE INFO
-->
		<p:dialog id="idTourDepMoreInfoDialog"
			widgetVar="varTourDepMoreInfoDialog" header="More Info" modal="true"
			resizable="false" dynamic="true" draggable="true" closable="false"
			style="width:100% !important;">
			<h:form id="idTourDepMoreInfoForm">
				<ui:include src="more_info.xhtml" />
			</h:form>
		</p:dialog>

		<!--
	DIALOG - REASON FOR UPDATE/DELETE
-->
		<p:dialog widgetVar="varTourPkgReasonDialog" header="Reason"
			modal="true" resizable="false" dynamic="true" draggable="true"
			closable="false">
			<h:form id="idTourPkgReasonDialog">
				<p:growl id="msg" />
				<p:panelGrid>
					<p:row>
						<p:column>
							<h:outputLabel>Reason <span class="required">*</span>
							</h:outputLabel>
						</p:column>
						<p:column>
							<p:inputTextarea label="Reason"
								value="#{tourPkgBean.tourPkgVO.reason}" rows="5"
								style="width:300px" required="true" />
						</p:column>
					</p:row>
				</p:panelGrid>
				<h:panelGrid columns="2" style="width:1px;">
					<p:commandButton value="#{msg['common.button.label.update']}"
						actionListener="#{tourPkgBean.updTourPkg}"
						oncomplete="varTourPkgReasonDialog.hide(),varEditTourPkgDialog.hide()"
						update="@form,:idTourPkgForm:idTourPkgList" />
					<p:commandButton value="#{msg['common.button.label.cancel']}"
						actionListener="#{tourPkgBean.resetForm}"
						oncomplete="varTourPkgReasonDialog.hide()" process="@this"
						update="@form" global="false">
						<pe:resetEditableValues for="idTourPkgReasonDialog" />
					</p:commandButton>
				</h:panelGrid>
			</h:form>
		</p:dialog>

		<p:dialog widgetVar="varTourDepReasonDialog" header="Reason"
			modal="true" resizable="false" dynamic="true" draggable="true"
			closable="false">
			<h:form id="idTourDepReasonDialog">
				<p:growl id="msg" />
				<p:panelGrid>
					<p:row>
						<p:column>
							<h:outputLabel>Reason <span class="required">*</span>
							</h:outputLabel>
						</p:column>
						<p:column>
							<p:inputTextarea label="Reason"
								value="#{tourPkgBean.tourDepVO.reason}" rows="5"
								style="width:300px" required="true" />
						</p:column>
					</p:row>
				</p:panelGrid>
				<h:panelGrid columns="2" style="width:1px;">
					<p:commandButton value="#{msg['common.button.label.update']}"
						actionListener="#{tourPkgBean.updTourDep}"
						oncomplete="onTourDepUpdateValidation(xhr, status, args)"
						update="@form,:idTourDepListForm, :idTourPkgForm:idTab:idFilterTourDepList" />
					<p:commandButton value="#{msg['common.button.label.cancel']}"
						oncomplete="varTourDepReasonDialog.hide()" process="@this"
						update="@form" global="false">
						<pe:resetEditableValues for="idTourDepReasonDialog" />
					</p:commandButton>
				</h:panelGrid>
			</h:form>
		</p:dialog>
		
		<p:confirmDialog widgetVar="varUpdDocAirfareDialog"
			message="Are you sure want to update related document airfare?">
			<h:form>
				<p:growl id="msg" />
				<p:commandButton value="Yes"
					actionListener="#{tourPkgBean.updDocumentAirfare}"
					update="@form" oncomplete="varUpdDocAirfareDialog.hide();" />
				<p:commandButton value="Cancel" oncomplete="varUpdDocAirfareDialog.hide()" />
			</h:form>
		</p:confirmDialog>

		<!--
	DIALOG - TOUR DEPARTURE REMARKS
-->
		<p:dialog id="idRemarksDialog" widgetVar="varRemarksDialog"
			modal="true" resizable="false" dynamic="true" draggable="true"
			closable="false">
			<f:facet name="header">
				<h:outputFormat value="Remark" />
			</f:facet>
			<h:form id="idRemarksForm">
				<ui:include src="../../product/common/add_remarks.xhtml" />
			</h:form>
		</p:dialog>

		<!--
	DIALOG - TOUR DEPARTURE SEND EMAIL
-->
		<p:dialog id="idSendEmailDialog" widgetVar="varSendEmailDialog"
			modal="true" resizable="false" dynamic="true" draggable="true"
			closable="false">
			<f:facet name="header">
				<h:outputFormat value="Send Email" />
			</f:facet>
			<h:form id="idSendEmailForm">
				<p:growl id="msg" />
				<p:panelGrid id="idTypeDetails">
					<p:row>
						<p:column>
							<h:outputLabel for="idEmailType">Choose Category<span
									class="required">*</span>
							</h:outputLabel>
						</p:column>
						<p:column>
							<h:selectOneMenu id="idEmailType" label="Choose Category"
								value="#{tourPkgBean.emailType}" required="true">
								<f:selectItem itemLabel="Individual" itemValue="IDV" />
								<f:selectItem itemLabel="Department" itemValue="DPT" />
								<p:ajax event="change" update=":idSendEmailForm:idTypeDetails" />
							</h:selectOneMenu>
						</p:column>
					</p:row>
					<p:row rendered="#{tourPkgBean.emailType == 'IDV'}">
						<p:column>
							<h:outputLabel for="idIndividualList">Individual<span
									class="required">*</span>
							</h:outputLabel>
						</p:column>
						<p:column>
							<p:selectCheckboxMenu id="idIndividualList"
								value="#{tourPkgBean.fullEmployeeList}" label="Individual"
								filter="true" filterMatchMode="contains" required="true">
								<f:selectItems value="#{tourPkgBean.idvEmployeeList}" var="vo"
									itemValue="#{vo.id}" itemLabel="#{vo.userVO.name}" />
							</p:selectCheckboxMenu>
						</p:column>
					</p:row>

					<p:row rendered="#{tourPkgBean.emailType == 'DPT'}">
						<p:column>
							<h:outputLabel for="idDepartmentList">Department<span
									class="required">*</span>
							</h:outputLabel>
						</p:column>
						<p:column>
							<p:selectCheckboxMenu id="idDepartmentList"
								value="#{tourPkgBean.departmentList}" label="Department"
								filter="true" filterMatchMode="contains" required="true">
								<f:selectItems value="#{bterp:lookupItemList('dept_type')}"
									var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
							</p:selectCheckboxMenu>
						</p:column>
					</p:row>
					<p:row>
						<p:column>
							<h:outputLabel for="idRemarks">Remarks
							</h:outputLabel>
						</p:column>
						<p:column>
							<p:column>
								<p:inputTextarea id="idRemarks" rows="10" cols="50"
									value="#{tourPkgBean.emailRemarks}"></p:inputTextarea>
							</p:column>
						</p:column>
					</p:row>
				</p:panelGrid>

				<h:panelGrid columns="2" style="width: 10px;">
					<p:commandButton value="#{msg['common.button.label.send']}"
						actionListener="#{tourPkgBean.processSendEmail}" update="@form"
						oncomplete="if (args &amp;&amp; !args.validationFailed) varSendEmailDialog.hide()" />
					<p:commandButton value="#{msg['common.button.label.cancel']}"
						actionListener="#{tourPkgBean.resetEmailForm}" update="@form"
						process="@this" oncomplete="varSendEmailDialog.hide()"
						global="false">
						<pe:resetEditableValues for="idSendEmailForm" />
					</p:commandButton>
				</h:panelGrid>
			</h:form>
		</p:dialog>

		<!--
	DIALOG - TOUR DEPARTURE REMARKS
-->
