package com.bcs.zsg.sales.vo;

import com.bcs.zsg.common.helper.FunctionUtils;
import com.bcs.zsg.core.vo.BaseVO;

public class PersonContactVO extends BaseVO {
	private static final long serialVersionUID = 1L;

	private Long personId;
	private String typeCd;
	private String areaCode; // areaCode + pNumber for separate
	private String number;
	private String pNumber;
	private String faxAreaCd;
	private String faxNum;
	private String attention;
	private String perMobileNumber;
	private String perMobileCountryCd; 
	private String perMobileAttention;
	private String perOfficeNumber;
	private String perOfficeCountryCd; 
	private String perOfficeAttention;
	private String perHomeNumber;
	private String perHomeCountryCd; 
	private String perHomeAttention;
	private String perFaxNumber;
	private String perFaxCountryCd; 
	private String perFaxAttention;
	private	String countryCd;
	private String fullPhoneNo;
	/**
	 * @return the personId
	 */
	public Long getPersonId() {
		return personId;
	}
	
	/**
	 * @param personId the personId to set
	 */
	public void setPersonId(Long personId) {
		this.personId = personId;
	}
	
	/**
	 * @return the typeCd
	 */
	public String getTypeCd() {
		return typeCd;
	}
	
	/**
	 * @param typeCd the typeCd to set
	 */
	public void setTypeCd(String typeCd) {
		this.typeCd = typeCd;
	}
	
	/**
	 * @return the number
	 */
	public String getNumber() {
		return number;
	}
	
	/**
	 * @param number the number to set
	 */
	public void setNumber(String number) {
		this.number = number;
	}

	/**
	 * @return the faxNum
	 */
	public String getFaxNum() {
		return faxNum;
	}

	/**
	 * @param faxNum the faxNum to set
	 */
	public void setFaxNum(String faxNum) {
		this.faxNum = faxNum;
	}

	/**
	 * @return the attention
	 */
	public String getAttention() {
		return attention;
	}

	/**
	 * @param attention the attention to set
	 */
	public void setAttention(String attention) {
		this.attention = attention;
	}

	/**
	 * @return the areaCode
	 */
	public String getAreaCode() {
		return areaCode;
	}

	/**
	 * @param areaCode the areaCode to set
	 */
	public void setAreaCode(String areaCode) {
		this.areaCode = areaCode;
	}

	/**
	 * @return the faxAreaCd
	 */
	public String getFaxAreaCd() {
		return faxAreaCd;
	}

	/**
	 * @param faxAreaCd the faxAreaCd to set
	 */
	public void setFaxAreaCd(String faxAreaCd) {
		this.faxAreaCd = faxAreaCd;
	}

	/**
	 * @return the pNumber
	 */
	public String getpNumber() {
		return pNumber;
	}

	/**
	 * @param pNumber the pNumber to set
	 */
	public void setpNumber(String pNumber) {
		this.pNumber = pNumber;
	}

	public String getPerMobileNumber() {
		return perMobileNumber;
	}

	public void setPerMobileNumber(String perMobileNumber) {
		this.perMobileNumber = perMobileNumber;
	}

	public String getPerMobileAttention() {
		return perMobileAttention;
	}

	public void setPerMobileAttention(String perMobileAttention) {
		this.perMobileAttention = perMobileAttention;
	}

	public String getPerOfficeNumber() {
		return perOfficeNumber;
	}

	public void setPerOfficeNumber(String perOfficeNumber) {
		this.perOfficeNumber = perOfficeNumber;
	}

	public String getPerOfficeAttention() {
		return perOfficeAttention;
	}

	public void setPerOfficeAttention(String perOfficeAttention) {
		this.perOfficeAttention = perOfficeAttention;
	}

	public String getPerHomeNumber() {
		return perHomeNumber;
	}

	public void setPerHomeNumber(String perHomeNumber) {
		this.perHomeNumber = perHomeNumber;
	}

	public String getPerHomeAttention() {
		return perHomeAttention;
	}

	public void setPerHomeAttention(String perHomeAttention) {
		this.perHomeAttention = perHomeAttention;
	}

	public String getPerFaxNumber() {
		return perFaxNumber;
	}

	public void setPerFaxNumber(String perFaxNumber) {
		this.perFaxNumber = perFaxNumber;
	}

	public String getPerFaxAttention() {
		return perFaxAttention;
	}

	public void setPerFaxAttention(String perFaxAttention) {
		this.perFaxAttention = perFaxAttention;
	}

	public String getCountryCd() {
		return countryCd;
	}

	public void setCountryCd(String countryCd) {
		this.countryCd = countryCd;
	}

	public String getPerMobileCountryCd() {
		return perMobileCountryCd;
	}

	public void setPerMobileCountryCd(String perMobileCountryCd) {
		this.perMobileCountryCd = perMobileCountryCd;
	}

	public String getPerOfficeCountryCd() {
		return perOfficeCountryCd;
	}

	public void setPerOfficeCountryCd(String perOfficeCountryCd) {
		this.perOfficeCountryCd = perOfficeCountryCd;
	}

	public String getPerHomeCountryCd() {
		return perHomeCountryCd;
	}

	public void setPerHomeCountryCd(String perHomeCountryCd) {
		this.perHomeCountryCd = perHomeCountryCd;
	}

	public String getPerFaxCountryCd() {
		return perFaxCountryCd;
	}

	public void setPerFaxCountryCd(String perFaxCountryCd) {
		this.perFaxCountryCd = perFaxCountryCd;
	}

	public String getFullNumber() {
		return FunctionUtils.phoneNumber(countryCd, number);
	}

	public String getFullPhoneNo() {
		return fullPhoneNo;
	}

	public void setFullPhoneNo(String fullPhoneNo) {
		this.fullPhoneNo = fullPhoneNo;
	}
}
