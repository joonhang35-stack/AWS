package com.bcs.zsg.common.vo;

import java.io.Serializable;
import java.util.List;

public class AddUpdDelVO implements Serializable {
	private static final long serialVersionUID = 1L;

	private List<Object> addList;
	private List<Object> updList;
	private List<Object> delList;
	
	public AddUpdDelVO(List<Object> addList, List<Object> updList, List<Object> delList) {
		this.addList = addList;
		this.updList = updList;
		this.delList = delList;
	}
	
	/**
	 * @return the addList
	 */
	public List<Object> getAddList() {
		return addList;
	}
	
	/**
	 * @param addList the addList to set
	 */
	public void setAddList(List<Object> addList) {
		this.addList = addList;
	}

	/**
	 * @return the updList
	 */
	public List<Object> getUpdList() {
		return updList;
	}

	/**
	 * @param updList the updList to set
	 */
	public void setUpdList(List<Object> updList) {
		this.updList = updList;
	}

	/**
	 * @return the delList
	 */
	public List<Object> getDelList() {
		return delList;
	}

	/**
	 * @param delList the delList to set
	 */
	public void setDelList(List<Object> delList) {
		this.delList = delList;
	}
}
