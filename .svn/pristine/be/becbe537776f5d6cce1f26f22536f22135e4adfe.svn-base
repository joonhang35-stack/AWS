################
#	   KEYCLOAK    #	
################

envbaseurl.sandbox=http://localhost:8090/
#envbaseurl.sandbox=https://uat.applevacations.my:8443/
envbaseurl.actual=https://myinvois.hasil.gov.my/

system.api.sandbox=https://preprod-api.myinvois.hasil.gov.my/
system.api.actual=https://api.myinvois.hasil.gov.my/

api.login=realms/myrealm/protocol/openid-connect/token/
api.register=realms/myrealm/protocol/openid-connect/registrations/
api.cert=realms/myrealm/protocol/openid-connect/certs/
api.admin.users=admin/realms/myrealm/users/

callback=app/maintenance/keycloakCallback

# api url controller
# true = testing mode, use sandbox
# false = production mode, use actual url
testing=true