	/* (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.CustomerService#updObjList(com.bcs.zsg.sales.vo.CustomerVO, com.bcs.zsg.common.vo.AddUpdDelVO)
	 */
	@Override
	public void updObjList(CustomerVO customerVO, AddUpdDelVO objectVO) throws BusinessException {
		if (objectVO.getAddList().size() > 0) {
			for (Object vo : objectVO.getAddList()) {
				if (vo instanceof IdentityVO) {
					Long identityId = (Long) customerDAO.insert((IdentityVO) vo);
					
					if (((IdentityVO) vo).getIdType().equals(CommonConstant.LOOKUP_ITM_ID_PASSPRT) || ((IdentityVO) vo).getIdType().equals(CommonConstant.LOOKUP_ITM_ID_VISA)) {
						IdentityDetailVO identityDetailVO = ((IdentityVO) vo).getIdentityDetailVO();
						identityDetailVO.setPersonIdentityId(identityId);
						customerDAO.insert(identityDetailVO);
					}
				}
				if (vo instanceof PersonLangVO) customerDAO.insert((PersonLangVO) vo);
				if (vo instanceof PersonMealVO) customerDAO.insert((PersonMealVO) vo);
				if (vo instanceof PersonContactVO) customerDAO.insert((PersonContactVO) vo);
				if (vo instanceof CorContactVO) customerDAO.insert((CorContactVO) vo);
				if (vo instanceof PersonClassVO) customerDAO.insert((PersonClassVO) vo);
				if (vo instanceof PersonComplicationVO) customerDAO.insert((PersonComplicationVO) vo);
				if (vo instanceof CustomerRemarksVO) customerDAO.insert((CustomerRemarksVO) vo);
			}
		}
		
		if (objectVO.getUpdList().size() > 0) {
			for (Object vo : objectVO.getUpdList()) {
				if (vo instanceof IdentityVO) {
					customerDAO.update((IdentityVO) vo);
					if (((IdentityVO) vo).getIdType().equals(CommonConstant.LOOKUP_ITM_ID_PASSPRT) || ((IdentityVO) vo).getIdType().equals(CommonConstant.LOOKUP_ITM_ID_VISA)) {
						customerDAO.update(((IdentityVO) vo).getIdentityDetailVO());
					}
				}
				if (vo instanceof PersonLangVO) customerDAO.update((PersonLangVO) vo);
				if (vo instanceof PersonMealVO) customerDAO.update((PersonMealVO) vo);
				if (vo instanceof PersonContactVO) customerDAO.update((PersonContactVO) vo);
				if (vo instanceof CorContactVO) customerDAO.update((CorContactVO) vo);
				if (vo instanceof PersonClassVO) customerDAO.update((PersonClassVO) vo);
				if (vo instanceof PersonComplicationVO) customerDAO.update((PersonComplicationVO) vo);
				if (vo instanceof CustomerRemarksVO) customerDAO.update((CustomerRemarksVO) vo);
			}
		}

		if (objectVO.getDelList().size() > 0) {
			for (Object vo : objectVO.getDelList()) {
				if (vo instanceof IdentityVO) {
					if (((IdentityVO) vo).getIdType().equals(CommonConstant.LOOKUP_ITM_ID_PASSPRT) || ((IdentityVO) vo).getIdType().equals(CommonConstant.LOOKUP_ITM_ID_VISA)) {
						customerDAO.delete(((IdentityVO) vo).getIdentityDetailVO());
					}
					customerDAO.delete((IdentityVO) vo);
				}
				if (vo instanceof PersonLangVO) customerDAO.delete((PersonLangVO) vo);
				if (vo instanceof PersonMealVO) customerDAO.delete((PersonMealVO) vo);
				if (vo instanceof PersonContactVO) customerDAO.delete((PersonContactVO) vo);
				if (vo instanceof CorContactVO) customerDAO.delete((CorContactVO) vo);
				if (vo instanceof PersonClassVO) customerDAO.delete((PersonClassVO) vo);
				if (vo instanceof PersonComplicationVO) customerDAO.delete((PersonComplicationVO) vo);
				if (vo instanceof CustomerRemarksVO) customerDAO.delete((CustomerRemarksVO) vo);
			}
		}
	}

