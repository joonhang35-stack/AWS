<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui"
	xmlns:pe="http://primefaces.org/ui/extensions"
	xmlns:zsg="http://www.bcs.com/zsg/jsf">

	<p:growl id="msg" />
        <h:panelGrid columns="1" cellpadding="5" rendered="#{empty custBean.crmVoucherVO.redemptionType}">
        	<p:row>
        		<h:outputText value="Name:" />
        		<h:outputText value="#{custBean.crmVoucherVO.name}" />
        	</p:row>
			<p:row>
            	<h:outputText value="Redemption ID:" />
           		<h:outputText value="#{custBean.crmVoucherVO.redemptionId}" />
			</p:row>
			<p:row>
	            <h:outputText value="Category:" />
	            <h:outputText value="#{custBean.crmVoucherVO.categoryName}" />
            </p:row>
			<p:row>
	            <h:outputText value="Category Type:" />
	            <h:outputText value="#{custBean.crmVoucherVO.categoryType}" />
            </p:row>
            <p:row>
	            <h:outputText value="Category Desc:" />
	            <h:outputText value="#{custBean.crmVoucherVO.categoryDesc}" />
            </p:row>
            <p:row>
	            <h:outputText value="Description:" />
	            <h:outputText value="#{custBean.crmVoucherVO.description}" />
            </p:row>
            <p:row>
	            <h:outputText value="Min Points:" />
	            <h:outputText value="#{custBean.crmVoucherVO.minPoints}" />
            </p:row>
            <p:row>
	            <h:outputText value="Max Points:" />
	            <h:outputText value="#{custBean.crmVoucherVO.maxPoints}" />
            </p:row>
            <p:row>
	            <h:outputText value="Min Sales:" />
	            <h:outputText value="#{custBean.crmVoucherVO.minSales}" />
            </p:row>
            <p:row>
	            <h:outputText value="Max Sales:" />
	            <h:outputText value="#{custBean.crmVoucherVO.maxSales}" />
            </p:row>
            <p:row>
	            <h:outputText value="Conversion Points:" />
	            <h:outputText value="#{custBean.crmVoucherVO.conversionPoints}" />
            </p:row>
            <p:row>
	            <h:outputText value="Conversion Rebate Amt:" />
	            <h:outputText value="#{custBean.crmVoucherVO.conversionRebateAmt}" />
            </p:row>
            <p:row>
	            <h:outputText value="Discount Amt:" />
	            <h:outputText value="#{custBean.crmVoucherVO.discountAmt}" />
            </p:row>
            <p:row>
	            <h:outputText value="Percentage:" />
	            <h:outputText value="#{custBean.crmVoucherVO.percentage}" />
            </p:row>
            <p:row>
	            <h:outputText value="Max Discount Capped:" />
	            <h:outputText value="#{custBean.crmVoucherVO.maxDiscountCapped}" />
            </p:row>
            <p:row>
	            <h:outputText value="Expiry Days:" />
	            <h:outputText value="#{custBean.crmVoucherVO.expiryDays}" />
			</p:row>
            <p:row>
	            <h:outputText value="Expiry End Of Month:" />
	            <h:outputText value="#{custBean.crmVoucherVO.isExpiryEndOfMonth ? 'Yes' : 'No'}" />
			</p:row>
            <p:row>
	            <h:outputText value="Effective From:" />
	            <h:outputText value="#{custBean.crmVoucherVO.effectiveFrom}">
                <f:convertDateTime pattern="dd/MM/yyyy" />
            </h:outputText>
        	</p:row>
            <p:row>
	            <h:outputText value="Effective Until:" />
	            <h:outputText value="#{custBean.crmVoucherVO.effectiveUntil}">
                <f:convertDateTime pattern="dd/MM/yyyy" />
            </h:outputText>
            </p:row>
            <p:row>
	            <h:outputText value="Currency:" />
	            <h:outputText value="#{custBean.crmVoucherVO.currency}" />
            </p:row>
            <p:row>
	            <h:outputText value="Active:" />
	            <h:outputText value="#{custBean.crmVoucherVO.isActive ? 'Yes' : 'No'}" />
            </p:row>
        </h:panelGrid>
        <h:panelGrid columns="1" cellpadding="5" rendered="#{not empty custBean.crmVoucherVO.redemptionType}">
        	<p:row>
        		<h:outputText value="Name:" />
        		<h:outputText value="#{custBean.crmVoucherVO.redemptionType.name}" />
        	</p:row>
			<p:row>
            	<h:outputText value="Redemption ID:" />
           		<h:outputText value="#{custBean.crmVoucherVO.redemptionType.redemptionId}" />
			</p:row>
			<p:row>
	            <h:outputText value="Category:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.categoryName}" />
            </p:row>
			<p:row>
	            <h:outputText value="Category Type:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.categoryType}" />
            </p:row>
            <p:row>
	            <h:outputText value="Category Desc:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.categoryDesc}" />
            </p:row>
            <p:row>
	            <h:outputText value="Description:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.description}" />
            </p:row>
            <p:row>
	            <h:outputText value="Min Points:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.minPoints}" />
            </p:row>
            <p:row>
	            <h:outputText value="Max Points:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.maxPoints}" />
            </p:row>
            <p:row>
	            <h:outputText value="Min Sales:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.minSales}" />
            </p:row>
            <p:row>
	            <h:outputText value="Max Sales:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.maxSales}" />
            </p:row>
            <p:row>
	            <h:outputText value="Conversion Points:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.conversionPoints}" />
            </p:row>
            <p:row>
	            <h:outputText value="Conversion Rebate Amt:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.conversionRebateAmt}" />
            </p:row>
            <p:row>
	            <h:outputText value="Discount Amt:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.discountAmt}" />
            </p:row>
            <p:row>
	            <h:outputText value="Percentage:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.percentage}" />
            </p:row>
            <p:row>
	            <h:outputText value="Max Discount Capped:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.maxDiscountCapped}" />
            </p:row>
            <p:row>
	            <h:outputText value="Expiry Days:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.expiryDays}" />
			</p:row>
            <p:row>
	            <h:outputText value="Expiry End Of Month:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.isExpiryEndOfMonth ? 'Yes' : 'No'}" />
			</p:row>
            <p:row>
	            <h:outputText value="Effective From:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.effectiveFrom}">
                <f:convertDateTime pattern="dd/MM/yyyy" />
            </h:outputText>
        	</p:row>
            <p:row>
	            <h:outputText value="Effective Until:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.effectiveUntil}">
                <f:convertDateTime pattern="dd/MM/yyyy" />
            </h:outputText>
            </p:row>
            <p:row>
	            <h:outputText value="Currency:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.currency}" />
            </p:row>
            <p:row>
	            <h:outputText value="Active:" />
	            <h:outputText value="#{custBean.crmVoucherVO.redemptionType.isActive ? 'Yes' : 'No'}" />
            </p:row>
        </h:panelGrid>
    <h:panelGrid columns="1">
    	<p:commandButton value="Close" type="button" onclick="varVoucherDetailsDialog.hide();" />
    </h:panelGrid>
</ui:composition>