	}
	public void setIdCustomer(Long idCustomer) {
		this.idCustomer = idCustomer;
	}
	public String getTitleCd() {
		return titleCd;
	}
	public void setTitleCd(String titleCd) {
		this.titleCd = titleCd;
	}
	public String getTaxIdNo() {
