	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getCountryList(java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<CountryVO> getCountryList(Long idRegion) throws BusinessException {
		StringBuilder queryStr = new StringBuilder();
		if (idRegion.longValue() == 0)  queryStr.append("SELECT C.id, C.code, C.name FROM country C ORDER BY C.name");
		else queryStr.append("SELECT C.id, C.code, C.name FROM country C, region R ").
				append("WHERE R.id = :id AND C.id_region = R.id ORDER BY C.name");
		
		Query query = this.createSQLQuery(queryStr.toString());
		if (idRegion.longValue() != 0) query.setLong("id", idRegion);
		
		List<Object> results = query.list();
		List<CountryVO> countryList = new ArrayList<CountryVO>();
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			CountryVO countryVO = new CountryVO();
			countryVO.setId(((BigInteger) row[0]).longValue());
			countryVO.setCode((String) row[1]);
			countryVO.setCountry((String) row[2]);
			countryList.add(countryVO);
		}
		return countryList;
	}
	
