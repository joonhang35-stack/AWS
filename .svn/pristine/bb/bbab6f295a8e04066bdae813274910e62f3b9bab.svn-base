	@SuppressWarnings("unchecked")
	@Override
	public List<TourPackageRoomPriceVO> getTourPackageRoomPrice(Long idPkg) throws BusinessException {
		StringBuilder queryStr = new StringBuilder();
		queryStr.append("SELECT id,id_pkg, room_name, price_from,price_to,dt_upd,upd_by,created_by FROM tour_package_room_price ").
			append("WHERE id_pkg = :id ");
		
		Query query = this.createSQLQuery(queryStr.toString());
		query.setLong("id", idPkg); 
		
		List<Object> results = query.list();
		List<TourPackageRoomPriceVO> roomPriceList = new ArrayList<TourPackageRoomPriceVO>();

      //  DateFormat df = new SimpleDateFormat("yyyy-mm-dd HH:mm:ss");
        Date tempDate;
	 	for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			TourPackageRoomPriceVO roomPriceVO = new TourPackageRoomPriceVO();
			roomPriceVO.setId(((BigInteger) row[0]).longValue());
			roomPriceVO.setPkgId(((BigInteger) row[1]).longValue());
			roomPriceVO.setRoomName((String) row[2]); 
			roomPriceVO.setPriceFrom(((Float) row[3]).longValue());
			roomPriceVO.setPriceTo(((Float) row[4]).longValue());
			tempDate = (Date)row[5];
			roomPriceVO.setUpdatedDate(tempDate);
			roomPriceVO.setUpdatedBy((String) row[6]);
			roomPriceVO.setCreatedBy((String) row[7]);
			roomPriceList.add(roomPriceVO); 
		}
		return roomPriceList;
	}
