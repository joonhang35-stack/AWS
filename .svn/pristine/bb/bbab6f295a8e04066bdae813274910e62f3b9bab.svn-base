	@SuppressWarnings("unchecked")
	public List<CompanyVO> getTourDepItemCompanyList(Long idTourDep) throws BusinessException{
		StringBuilder queryStr = new StringBuilder();
		queryStr.append("SELECT DISTINCT C.id, C.name, C.code FROM company C, tour_dep_item TDI ").
			append("WHERE C.id = TDI.id_company and TDI.id_tour_dep = '" + idTourDep + "'");
		
		Query query = this.createSQLQuery(queryStr.toString()); 
		List<Object> results = query.list();
		List<CompanyVO> companyList = new ArrayList<CompanyVO>();
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			CompanyVO companyVO = new CompanyVO();
			companyVO.setId(((BigInteger) row[0]).longValue());
			companyVO.setName((String) row[1]);
			companyVO.setCode((String) row[2]);
			companyList.add(companyVO);
		}
		
		return companyList;
	}
