	@SuppressWarnings("unchecked")
	@Override
	public List<TourPackageVO> getTourFreeNEasyList(String typeCd) throws BusinessException {
		Criteria criteria = createCriteria(TourPackageVO.class);
		criteria.add(Restrictions.eq("typeCd", typeCd));
		return criteria.list();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getTourDepList(java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getTourDepList(Long idTourPkg, Long idAirlineSchedule) throws BusinessException {
		if (idAirlineSchedule == null) {
			StringBuilder sb = new StringBuilder();
			sb.append("SELECT ").
				append("d.id, d.seq_no, d.dt_dep, d.tour_status_cd, d.code AS 'tourcode', d.num_days, d.num_nights, d.description, ").
				append("d.is_deposit_paid, d.is_issued_s, d.is_issued_f, d.is_push, d.tfair_discount, d.prn, ").
				append("d.seat_allotment, d.tour_mgr_pax, d.reserved_seat, d.full_twn, d.full_sgl, d.full_ctw, d.full_ceb, d.full_cnb, ").
				append("d.grnd_twn, d.grnd_sgl, d.grnd_ctw, d.grnd_ceb, d.grnd_cnb, d.cna_adt, d.csi_adt, d.misc_adt, d.misc_chd, a.code AS 'airline', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 't_fair%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'tfairpax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'agent%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'agentpax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'in_house%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'inhousepax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'online_booking%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'on9bookingpax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'BK' and b.pmnt_status_cd = 'KIV' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'kivpax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and (b.status_cd = 'CF' or (b.status_cd = 'BK' and pmnt_status_cd = 'KIV')) and i.code in ('GA_SGL', 'GA_TWN', 'GA_CTW', 'GA_CWB', 'GA_CNB', 'GA_INFT')) AS 'ga', d.tour_pkg_daily_cms, ").
				append("d.travel_ins_policy_s, d.travel_ins_policy_f, d.lang_cd, d.tour_status_reason, if((select is_push_to_online from tour_pkg where id = :idTourPkg)=0, 0, d.is_push_to_online) ").
				append(", d.deadline, d.is_lock, d.is_private_tour, d.private_pic, p.deposit ").
				append("from (tour_dep d, airline a) LEFT JOIN tour_pkg p ON d.id_tour_pkg = p.id where d.id_airline = a.id and d.id_tour_pkg = :idTourPkg and d.status_cd = :statusCode order by d.seq_no is null, d.seq_no, d.dt_dep, d.code");
			
			Query query = createSQLQuery(sb.toString());
			query.setLong("idTourPkg", idTourPkg);
			query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
			List<Object> results = query.list();
			List<TourDepartureVO> tourDepList = new ArrayList<TourDepartureVO>();
			TourDepartureVO vo;
			
			for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				vo = new TourDepartureVO();
				vo.setId(((BigInteger) row[0]).longValue());
				vo.setSeqNo(row[1] == null ? null : Integer.parseInt(row[1].toString()));
				vo.setDtDep((Date) row[2]);
				vo.setTourStatusCd((String) row[3]);
				vo.setCode((String) row[4]);
				vo.setNumDays(((Short) row[5]).intValue());
				vo.setNumNights(((Short) row[6]).intValue());
				vo.setDesc(row[7] == null ? null : (String) row[7]);
				vo.setIsDepositPaid((Boolean) row[8]);
				vo.setIsIssuedS((Boolean) row[9]);
				vo.setIsIssuedF((Boolean) row[10]);
				vo.setIsPush((Boolean) row[11]);
				vo.setTfairDiscount((Double) row[12]);
				vo.setPrn(row[13] == null ? null : (String) row[13]);
				vo.setSeatAllot(((Short) row[14]).intValue());
				vo.setTourManagerPax(((Short) row[15]).intValue());
				vo.setReservedSeat(((Short) row[16]).intValue());
				vo.setFullTwn((Double) row[17]);
				vo.setFullSgl((Double) row[18]);
				vo.setFullCtw((Double) row[19]);
				vo.setFullCeb((Double) row[20]);
				vo.setFullCnb((Double) row[21]);
				vo.setGrndTwn((Double) row[22]);
				vo.setGrndSgl((Double) row[23]);
				vo.setGrndCtw((Double) row[24]);
				vo.setGrndCeb((Double) row[25]);
				vo.setGrndCnb((Double) row[26]);
				vo.setCnaAdt((Double) row[27]);
				vo.setCsiAdt((Double) row[28]);
				vo.setMiscAdt((Double) row[29]);
				vo.setMiscChd((Double) row[30]);
				vo.setAirlineCode((String) row[31]);
				vo.setTfairPax(((BigDecimal) row[32]).intValue());
				vo.setAgentPax(((BigDecimal) row[33]).intValue());
				vo.setInHsePax(((BigDecimal) row[34]).intValue());
				vo.setOn9BookingPax(((BigDecimal) row[35]).intValue());
				vo.setKivPax(((BigDecimal) row[36]).intValue());
				vo.setTotalGA(((BigDecimal) row[37]).intValue());
				vo.setTourPkgDailyCms(row[38] != null ? ((BigInteger) row[38]).longValue() : null);
				
				if (StringUtils.isNotBlank(row[39] != null ? row[39].toString() : "")) {
					vo.setTravelInsS(true);
				}
				if (StringUtils.isNotBlank(row[40] != null ? row[40].toString() : "")) {
					vo.setTravelInsF(true);
				}
				vo.setLangCode(row[41] != null ? row[41].toString() : "");
				vo.setTourStatusReason(row[42] != null ? row[42].toString() : "");
				vo.setIsPushToOnline(row[43] != null ? ((BigInteger) row[43]).equals(BigInteger.ONE) : true);
				if(row[44] != null ) vo.setDeadline(Integer.parseInt(row[44].toString())); else vo.setDeadline(0);
				vo.setIsLock(row[45] != null ? ((Boolean) row[45]) : false);
				vo.setIsPrivateTour(row[46] != null ? ((Boolean) row[46]) : false);
				vo.setPrivatePic(row[47] != null ? row[47].toString() : "");
				vo.setDeposit((Double) row[48]);
				
				// Tour Departure Discount
				vo.setTourDepartureDiscountVOList(getTourDepDiscount(vo.getId()));
				
				vo.setDiscount1(0.00);
				vo.setDiscount2(0.00);
				if (CollectionUtils.isNotEmpty(vo.getTourDepartureDiscountVOList())) {
					int count = 1;
					
					for (TourDepartureDiscountVO discountVO : vo.getTourDepartureDiscountVOList()) {
						double discountAmt = discountVO.getDiscountAmt();
						int discountPax = discountVO.getDiscountPax();
						
						if (count == 1) {
							vo.setDiscount1(discountAmt);
							vo.setDiscountPax1(discountPax);
						} else if (count == 2) {
							vo.setDiscount2(discountAmt);
							vo.setDiscountPax2(discountPax);
						}
						count++;
					}
				}
				
				tourDepList.add(vo);
			}
			return tourDepList;
			
		} else {
			Criteria criteria = createCriteria(TourDepartureVO.class);
			criteria.add(Restrictions.eq("statusCode", CommonConstant.STATUS_CD_ACTIVE));
			criteria.add(Restrictions.eq("idAirlineSchedule", idAirlineSchedule));
			criteria.addOrder(Order.asc("seqNo"));
			criteria.addOrder(Order.asc("dtDep"));
			criteria.addOrder(Order.asc("code"));
			return criteria.list();
		}
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getTourDepList(java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getTourDepListbyCruise(Long idCruiseSchedule) throws BusinessException {
	
		Criteria criteria = createCriteria(TourDepartureVO.class);
		criteria.add(Restrictions.eq("statusCode", CommonConstant.STATUS_CD_ACTIVE));
		criteria.add(Restrictions.eq("idCruiseSchedule", idCruiseSchedule));
		criteria.addOrder(Order.asc("seqNo"));
		criteria.addOrder(Order.asc("dtDep"));
		criteria.addOrder(Order.asc("code"));
		return criteria.list();
		
	}
	
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getFilterTourDepList(java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getFilterTourDepList(Date dtFrom, Date dtTo, String code , String title, Boolean filterInactiveRcrd, String filterTourStatusCd) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT ").
			append("d.id, d.id_tour_pkg, d.dt_dep, d.tour_status_cd, d.code AS 'tourcode', d.num_days, d.num_nights, d.description, ").
			append("d.is_deposit_paid, d.is_issued_s, d.is_issued_f, d.is_push, d.tfair_discount, d.prn, ").
			append("d.seat_allotment, d.tour_mgr_pax, d.reserved_seat, d.full_twn, d.full_sgl, d.full_ctw, d.full_ceb, d.full_cnb, ").
			append("d.grnd_twn, d.grnd_sgl, d.grnd_ctw, d.grnd_ceb, d.grnd_cnb, d.cna_adt, d.csi_adt, d.misc_adt, d.misc_chd, a.code AS 'airline', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 't_fair%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'tfairpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'agent%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'agentpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'in_house%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'inhousepax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'online_booking%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'on9bookingpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'BK' and b.pmnt_status_cd = 'KIV' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'kivpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and (b.status_cd = 'CF' or (b.status_cd = 'BK' and pmnt_status_cd = 'KIV')) and i.code in ('GA_SGL', 'GA_TWN', 'GA_CTW', 'GA_CWB', 'GA_CNB', 'GA_INFT')) AS 'ga', d.tour_pkg_daily_cms, p.name_en, p.name_zh, p.name_other, ").
			append("d.travel_ins_policy_s, d.travel_ins_policy_f ").
			append("from (tour_dep d, airline a) LEFT JOIN tour_pkg p ON d.id_tour_pkg = p.id where d.id_airline = a.id and d.status_cd = :statusCode ");
		if (StringUtils.isNotBlank(code))
			sb.append("and (d.code like :trCode) ");
		if (dtFrom != null && dtTo != null)
			sb.append("and DATE(d.dt_dep) between DATE(:dtFrom) and DATE(:dtTo) ");
		if (dtFrom != null)
			sb.append("and DATE(d.dt_dep) >= DATE(:dtFrom) ");
		if (dtTo != null)
			sb.append("and DATE(d.dt_dep) <= DATE(:dtTo) ");
		if (StringUtils.isNotBlank(title)) {
			sb.append("and (CONCAT(IFNULL(p.name_en, ''), ' ', IFNULL(p.name_other, ''), ' ', IFNULL(p.name_zh, '')) like :pkgTitle) ");
		}
		if (StringUtils.isNotBlank(filterTourStatusCd)) {
			sb.append("and d.tour_status_cd = :tourStatusCd ");
		}
		sb.append("order by p.name_en, d.dt_dep");
		
		Query query = createSQLQuery(sb.toString());
		if(!filterInactiveRcrd) {
			query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
		}else {
			query.setString("statusCode", CommonConstant.STATUS_CD_INACTIVE);
		}
		if (StringUtils.isNotBlank(code))
			query.setString("trCode", "%" + code + "%");
		if(dtFrom != null && dtTo != null) {
			query.setDate("dtFrom", dtFrom);
			query.setDate("dtTo", dtTo);
		}
		if (dtFrom != null)
			query.setDate("dtFrom", dtFrom);
		if (dtTo != null)
			query.setDate("dtTo", dtTo);
		if (StringUtils.isNotBlank(title))
			query.setString("pkgTitle", "%" + title + "%");
		if (StringUtils.isNotBlank(filterTourStatusCd))
			query.setString("tourStatusCd", filterTourStatusCd);
		List<Object> results = query.list();
		List<TourDepartureVO> tourFilterDepList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new TourDepartureVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setIdTourPkg(((BigInteger) row[1]).longValue());
			vo.setDtDep((Date) row[2]);
			vo.setTourStatusCd((String) row[3]);
			vo.setCode((String) row[4]);
			vo.setNumDays(((Short) row[5]).intValue());
			vo.setNumNights(((Short) row[6]).intValue());
			vo.setDesc(row[7] == null ? null : (String) row[7]);
			vo.setIsDepositPaid((Boolean) row[8]);
			vo.setIsIssuedS((Boolean) row[9]);
			vo.setIsIssuedF((Boolean) row[10]);
			vo.setIsPush((Boolean) row[11]);
			vo.setTfairDiscount((Double) row[12]);
			vo.setPrn(row[13] == null ? null : (String) row[13]);
			vo.setSeatAllot(((Short) row[14]).intValue());
			vo.setTourManagerPax(((Short) row[15]).intValue());
			vo.setReservedSeat(((Short) row[16]).intValue());
			vo.setFullTwn((Double) row[17]);
			vo.setFullSgl((Double) row[18]);
			vo.setFullCtw((Double) row[19]);
			vo.setFullCeb((Double) row[20]);
			vo.setFullCnb((Double) row[21]);
			vo.setGrndTwn((Double) row[22]);
			vo.setGrndSgl((Double) row[23]);
			vo.setGrndCtw((Double) row[24]);
			vo.setGrndCeb((Double) row[25]);
			vo.setGrndCnb((Double) row[26]);
			vo.setCnaAdt((Double) row[27]);
			vo.setCsiAdt((Double) row[28]);
			vo.setMiscAdt((Double) row[29]);
			vo.setMiscChd((Double) row[30]);
			vo.setAirlineCode((String) row[31]);
			vo.setTfairPax(((BigDecimal) row[32]).intValue());
			vo.setAgentPax(((BigDecimal) row[33]).intValue());
			vo.setInHsePax(((BigDecimal) row[34]).intValue());
			vo.setOn9BookingPax(((BigDecimal) row[35]).intValue());
			vo.setKivPax(((BigDecimal) row[36]).intValue());
			vo.setTotalGA(((BigDecimal) row[37]).intValue());
			vo.setTourPkgDailyCms(row[38] !=null ? ((BigInteger) row[38]).longValue() : null);
			vo.setNameEn((String) row[39]);
			vo.setNameZh((String) row[40]);
			vo.setNameOther((String) row[41]);
			
			if (StringUtils.isNotBlank(row[42] != null ? row[42].toString() : "")) {
				vo.setTravelInsS(true);
			}
			if (StringUtils.isNotBlank(row[43] != null ? row[43].toString() : "")) {
				vo.setTravelInsF(true);
			}
			
			// Tour Departure Discount
			vo.setTourDepartureDiscountVOList(getTourDepDiscount(vo.getId()));
			
			vo.setDiscount1(0.00);
			vo.setDiscount2(0.00);
			if (CollectionUtils.isNotEmpty(vo.getTourDepartureDiscountVOList())) {
				int count = 1;
				
				for (TourDepartureDiscountVO discountVO : vo.getTourDepartureDiscountVOList()) {
					double discountAmt = discountVO.getDiscountAmt();
					int discountPax = discountVO.getDiscountPax();
					
					if (count == 1) {
						vo.setDiscount1(discountAmt);
						vo.setDiscountPax1(discountPax);
					} else if (count == 2) {
						vo.setDiscount2(discountAmt);
						vo.setDiscountPax2(discountPax);
					}
					count++;
				}
			}
			
			tourFilterDepList.add(vo);
		}
		return tourFilterDepList;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getFilterTourDepList(java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getFilterBookingTourDepList(Date dtFrom, Date dtTo, String code , String title, Long idAirlineSchedule, String filterTourStatusCd) throws BusinessException {
		if (idAirlineSchedule == null) {
			StringBuilder sb = new StringBuilder();
			sb.append("SELECT ").
				append("d.id, d.id_tour_pkg, d.dt_dep, d.tour_status_cd, d.code AS 'tourcode', d.num_days, d.num_nights, d.description, ").
				append("d.is_deposit_paid, d.is_issued_s, d.is_issued_f, d.is_push, d.tfair_discount, d.prn, ").
				append("d.seat_allotment, d.tour_mgr_pax, d.reserved_seat, d.full_twn, d.full_sgl, d.full_ctw, d.full_ceb, d.full_cnb, ").
				append("d.grnd_twn, d.grnd_sgl, d.grnd_ctw, d.grnd_ceb, d.grnd_cnb, d.cna_adt, d.csi_adt, d.misc_adt, d.misc_chd, a.code AS 'airline', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 't_fair%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'tfairpax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'agent%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'agentpax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'in_house%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'inhousepax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'online_booking%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'on9bookingpax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'BK' and b.pmnt_status_cd = 'KIV' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'kivpax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and (b.status_cd = 'CF' or (b.status_cd = 'BK' and pmnt_status_cd = 'KIV')) and i.code in ('GA_SGL', 'GA_TWN', 'GA_CTW', 'GA_CWB', 'GA_CNB', 'GA_INFT')) AS 'ga', d.tour_pkg_daily_cms, p.name_en, p.name_zh, p.name_other, ").
				append("d.travel_ins_policy_s, d.travel_ins_policy_f ").
				append("from (tour_dep d, airline a) LEFT JOIN tour_pkg p ON d.id_tour_pkg = p.id where d.id_airline = a.id and d.status_cd = :statusCode ");
			if (StringUtils.isNotBlank(code))
				sb.append("and (d.code like :trCode) ");
			if(dtFrom != null && dtTo != null)
				sb.append("and DATE(d.dt_dep) between DATE(:dtFrom) and DATE(:dtTo) ");
			if (dtFrom != null)
				sb.append("and DATE(d.dt_dep) >= DATE(:dtFrom) ");
			if (dtTo != null)
				sb.append("and DATE(d.dt_dep) <= DATE(:dtTo) ");
			if (StringUtils.isNotBlank(title))
				sb.append("and (CONCAT(IFNULL(p.name_en, ''), ' ', IFNULL(p.name_other, ''), ' ', IFNULL(p.name_zh, '')) like :pkgTitle) ");
			if (StringUtils.isNotBlank(filterTourStatusCd)) {
				sb.append("and d.tour_status_cd = :tourStatusCd ");
			}
			sb.append("order by p.name_en, d.dt_dep");
			
			Query query = createSQLQuery(sb.toString());
			query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
			if (StringUtils.isNotBlank(code))
				query.setString("trCode", "%" + code + "%");
			if(dtFrom != null && dtTo != null) {
				query.setDate("dtFrom", dtFrom);
				query.setDate("dtTo", dtTo);
			}
			if (dtFrom != null)
				query.setDate("dtFrom", dtFrom);
			if (dtTo != null)
				query.setDate("dtTo", dtTo);
			if (StringUtils.isNotBlank(title))
				query.setString("pkgTitle", "%" + title + "%");
			if (StringUtils.isNotBlank(filterTourStatusCd))
				query.setString("tourStatusCd", filterTourStatusCd);
			List<Object> results = query.list();
			List<TourDepartureVO> tourFilterBookingDepList = new ArrayList<TourDepartureVO>();
			TourDepartureVO vo;
			
			for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				vo = new TourDepartureVO();
				vo.setId(((BigInteger) row[0]).longValue());
				vo.setIdTourPkg(((BigInteger) row[1]).longValue());
				vo.setDtDep((Date) row[2]);
				vo.setTourStatusCd((String) row[3]);
				vo.setCode((String) row[4]);
				vo.setNumDays(((Short) row[5]).intValue());
				vo.setNumNights(((Short) row[6]).intValue());
				vo.setDesc(row[7] == null ? null : (String) row[7]);
				vo.setIsDepositPaid((Boolean) row[8]);
				vo.setIsIssuedS((Boolean) row[9]);
				vo.setIsIssuedF((Boolean) row[10]);
				vo.setIsPush((Boolean) row[11]);
				vo.setTfairDiscount((Double) row[12]);
				vo.setPrn(row[13] == null ? null : (String) row[13]);
				vo.setSeatAllot(((Short) row[14]).intValue());
				vo.setTourManagerPax(((Short) row[15]).intValue());
				vo.setReservedSeat(((Short) row[16]).intValue());
				vo.setFullTwn((Double) row[17]);
				vo.setFullSgl((Double) row[18]);
				vo.setFullCtw((Double) row[19]);
				vo.setFullCeb((Double) row[20]);
				vo.setFullCnb((Double) row[21]);
				vo.setGrndTwn((Double) row[22]);
				vo.setGrndSgl((Double) row[23]);
				vo.setGrndCtw((Double) row[24]);
				vo.setGrndCeb((Double) row[25]);
				vo.setGrndCnb((Double) row[26]);
				vo.setCnaAdt((Double) row[27]);
				vo.setCsiAdt((Double) row[28]);
				vo.setMiscAdt((Double) row[29]);
				vo.setMiscChd((Double) row[30]);
				vo.setAirlineCode((String) row[31]);
				vo.setTfairPax(((BigDecimal) row[32]).intValue());
				vo.setAgentPax(((BigDecimal) row[33]).intValue());
				vo.setInHsePax(((BigDecimal) row[34]).intValue());
				vo.setOn9BookingPax(((BigDecimal) row[35]).intValue());
				vo.setKivPax(((BigDecimal) row[36]).intValue());
				vo.setTotalGA(((BigDecimal) row[37]).intValue());
				vo.setTourPkgDailyCms(row[38] !=null ? ((BigInteger) row[38]).longValue() : null);
				vo.setNameEn((String) row[39]);
				vo.setNameZh((String) row[40]);
				vo.setNameOther((String) row[41]);
				
				if (StringUtils.isNotBlank(row[42] != null ? row[42].toString() : "")) {
					vo.setTravelInsS(true);
				}
				if (StringUtils.isNotBlank(row[43] != null ? row[43].toString() : "")) {
					vo.setTravelInsF(true);
				}
				
				// Tour Departure Discount
				vo.setTourDepartureDiscountVOList(getTourDepDiscount(vo.getId()));
				
				vo.setDiscount1(0.00);
				vo.setDiscount2(0.00);
				if (CollectionUtils.isNotEmpty(vo.getTourDepartureDiscountVOList())) {
					int count = 1;
					
					for (TourDepartureDiscountVO discountVO : vo.getTourDepartureDiscountVOList()) {
						double discountAmt = discountVO.getDiscountAmt();
						int discountPax = discountVO.getDiscountPax();
						
						if (count == 1) {
							vo.setDiscount1(discountAmt);
							vo.setDiscountPax1(discountPax);
						} else if (count == 2) {
							vo.setDiscount2(discountAmt);
							vo.setDiscountPax2(discountPax);
						}
						count++;
					}
				}
				
				tourFilterBookingDepList.add(vo);
			}
			return tourFilterBookingDepList;
		}else {
			Criteria criteria = createCriteria(TourDepartureVO.class);
			criteria.add(Restrictions.eq("idAirlineSchedule", idAirlineSchedule));
			criteria.addOrder(Order.asc("dtDep"));
			criteria.addOrder(Order.asc("code"));
			return criteria.list();
		}
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getTourDepListV2()
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getTourDepListV2() throws BusinessException {
		String tempStr= "select d.id,d.dt_dep,pkg.name_en,pkg.name_zh,d.num_days, d.num_nights,d.description,d.code from tour_dep d left join tour_pkg pkg on d.id_tour_pkg = pkg.id where d.status_cd <> :statusCd"; // where d.status_cd = :statusCd
		
		Query query = createSQLQuery(tempStr);
		query.setParameter("statusCd", CommonConstant.STATUS_CD_CANCELLED);
		String tempPackageName;
		List<Object> results = query.list(); 
		List<TourDepartureVO> eoList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new TourDepartureVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setDtDep((Date) row[1]);
			vo.setCode((String) row[7]);
			
			tempPackageName = "";
			
			if(row[4]!= null) {
				if(!row[4].toString().equals("0")) tempPackageName += row[4].toString() + " Days ";
			}
			if(row[5]!= null) {
				if(!row[5].toString().equals("0")) tempPackageName += row[5].toString()  + " Nights ";
			}
			if(row[2]!= null) tempPackageName += (String) row[2];
			if(row[3]!= null) tempPackageName += " " + (String) row[3];
			if(row[6]!= null) tempPackageName += (String) row[6]; 
			vo.setPackageDesc(tempPackageName);    
			eoList.add(vo);
		}
		return eoList;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getTourDepList(java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getEOTourDepList(Long idTourPkg, Long idAirlineSchedule) throws BusinessException {
		String tempStr= "select eo.id,c.name,eo.code,eo.DT_EO,d.code,eo.amt_due,eo.status_cd,eo.upd_by from EX_ORDER eo left join supplier s on eo.id_supplier =  s.id left join corporate c on c.id_person = s.id_person left join tour_dep d on d.id = eo.id_tour";
		tempStr += " where 1=1 ";
		tempStr += " and statusCode ='" +CommonConstant.STATUS_CD_ACTIVE + "'"; 
		 
		Query query = createSQLQuery(tempStr);
		List<Object> results = query.list(); 
		List<ExOrderVO> eoList = new ArrayList<ExOrderVO>();
		ExOrderVO vo;
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new ExOrderVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setSupplierName((String) row[1]);   
			vo.setCode((String) row[2]);   
			vo.setEoDt((Date) row[3]);  
			vo.setAmtDue(Double.parseDouble(row[4].toString()) );
			vo.setStatusCode((String) row[5]);
			vo.setUpdatedBy((String) row[6]); 
 
			eoList.add(vo);
		} 
		
		//return eoList;
		Criteria criteria = createCriteria(TourDepartureVO.class);
		criteria.add(Restrictions.eq("statusCode", CommonConstant.STATUS_CD_ACTIVE));
		if (idTourPkg != null) criteria.add(Restrictions.eq("idTourPkg", idTourPkg));
		if (idAirlineSchedule != null) criteria.add(Restrictions.eq("idAirlineSchedule", idAirlineSchedule));
		criteria.addOrder(Order.asc("dtDep"));
		criteria.addOrder(Order.asc("code"));
		return criteria.list();
	}
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getTourDepList(java.lang.Long)
	 */ 
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getTourDepListWithItems(Long idTourPkg) throws BusinessException {
		String tempStr= "SELECT id FROM tour_dep where id in (select id_tour_dep from tour_dep_item  ) ";
		if(idTourPkg != null) tempStr += "and id_tour_pkg = '"  + idTourPkg+ "'";
		
		Query query = createSQLQuery(tempStr);
		List<Object> results = query.list();
		List<Long> companyIdList = new ArrayList<Long>();
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			BigInteger id = (BigInteger) it.next();
			companyIdList.add(id.longValue());
		}
		
		if (CollectionUtils.isNotEmpty(companyIdList)) {
			Criteria criteria = createCriteria(TourDepartureVO.class);
			criteria.add(Restrictions.in("id", companyIdList)); 
			return criteria.list();
		}
		return null;
	} 
	
	@SuppressWarnings("unchecked")
	@Override
	public int getTourDepListCountWithInvoicePax(Map<String, Object> params) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("select d.id ");
		sb.append("from tour_dep d left join tour_pkg pkg on pkg.id = d.id_tour_pkg left join tour_theme t on t.id = pkg.id_tour_theme left join country c on c.id = t.id_country ");
		sb.append("left join tour_cat tc on tc.id = t.id_tour_cat where d.id IN (SELECT id_tour_dep FROM invoice where id IN (SELECT id_inv FROM invoice_pax)) ");
		
		Map<String, String> filters = (Map<String, String>) params.get("filters");
		if (!filters.isEmpty()) {
			sb.append("and (");
			for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) {
				Entry<String, String> entry = it.next();
				if ("idTourPkg".equals(entry.getKey())) sb.append("d.id_tour_pkg like '%").append(entry.getValue()).append("%'");
				else if ("code".equals(entry.getKey())) sb.append("d.code like '%").append(entry.getValue()).append("%'");
				else if ("tourCategoryName".equals(entry.getKey())) sb.append("tc.description like '%").append(entry.getValue()).append("%'");
				else if ("countryName".equals(entry.getKey())) sb.append("c.name like '%").append(entry.getValue()).append("%'");
				if (filters.size() > 1 && it.hasNext()) sb.append(" and ");
			}
			sb.append(")");
		}
		
		Query query = createSQLQuery(sb.toString());
		
		return query.list().size();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getTourDepList(java.lang.Long)
	 */ 
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getTourDepListWithInvoicePax(Map<String, Object> params) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("select d.id, d.id_airline, d.id_airline_schedule, d.code, d.dt_dep, d.airline_schedule_items, d.airline_schdl_itms_w_seq, pkg.name_en, pkg.name_zh , c.name as country, tc.description, d.travel_ins_policy_s, d.travel_ins_policy_f, d.prn ");
		sb.append("from tour_dep d left join tour_pkg pkg on pkg.id = d.id_tour_pkg left join tour_theme t on t.id = pkg.id_tour_theme left join country c on c.id = t.id_country ");
		sb.append("left join tour_cat tc on tc.id = t.id_tour_cat where d.id IN (SELECT id_tour_dep FROM invoice where id IN (SELECT id_inv FROM invoice_pax)) ");
		
		Map<String, String> filters = (Map<String, String>) params.get("filters");
		if (!filters.isEmpty()) {
			sb.append("AND (");
			for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) {
				Entry<String, String> entry = it.next();
				if ("idTourPkg".equals(entry.getKey())) sb.append("d.id_tour_pkg like '%").append(entry.getValue()).append("%'");
				else if ("code".equals(entry.getKey())) sb.append("d.code like '%").append(entry.getValue()).append("%'");
				else if ("tourCategoryName".equals(entry.getKey())) sb.append("tc.description like '%").append(entry.getValue()).append("%'");
				else if ("countryName".equals(entry.getKey())) sb.append("c.name like '%").append(entry.getValue()).append("%'");
				if (filters.size() > 1 && it.hasNext()) sb.append(" and ");
			}
			sb.append(")");
		}
		
		sb.append(" ORDER BY ");
		String sortField = (String) params.get("sortField");
		
		if (sortField == null) sb.append("d.dt_dep desc");
		else {
			if ("code".equals(sortField)) sb.append("d.code");
		}
		
		Query query = createSQLQuery(sb.toString());
		query.setFirstResult((Integer) params.get("first"));
		query.setMaxResults((Integer) params.get("pageSize"));
		
		List<Object> results = query.list();
		List<TourDepartureVO> tourDepList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new TourDepartureVO();
			if (row[0] != null) vo.setId(((BigInteger) row[0]).longValue());
			if (row[1] != null) vo.setIdAirline(((BigInteger) row[1]).longValue());
			if (row[2] != null) vo.setIdAirlineSchedule(((BigInteger) row[2]).longValue());
			if (row[3] != null) vo.setCode((String) row[3]);   
			if (row[4] != null) vo.setDtDep((Date) row[4]);  
			if (row[5] != null) vo.setAirlineScheduleItems((String) row[5]);
			if (row[6] != null) vo.setAirlineScheduleItemsBySeq((String) row[6]);
			vo.setPackageName(StringUtils.defaultIfBlank((String) row[7], "") + " " + StringUtils.defaultIfBlank((String) row[8], ""));
			if (row[9] != null) vo.setCountryName((String) row[9]);
			if (row[10] != null) vo.setTourCategoryName((String) row[10]); 
			if (row[11] != null) vo.setTravelInsPolicyS((String) row[11]);
			if (row[12] != null) vo.setTravelInsPolicyF((String) row[12]);
			if (row[13] != null) vo.setPrn((String) row[13]);
			tourDepList.add(vo);
		}
		return tourDepList;
	} 
