	@Override
	public int getTourDepListSize(Map<String, Object> params) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT count(d.id) ")
		  .append("FROM tour_dep d ")
		  .append("LEFT JOIN tour_pkg pkg ON d.id_tour_pkg = pkg.id ")
		  .append("WHERE 1=1 ");
		
		sb.append(getTourDepListFilters(params));
		
		Query query = createSQLQuery(sb.toString());
//		query.setParameter("statusCd", CommonConstant.STATUS_CD_CANCELLED);
		
		return ((BigInteger) query.uniqueResult()).intValue();
	}

	@Override
	public List<TourDepartureVO> getTourDepList(Map<String, Object> params) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT ")
		  .append("d.id, ")
		  .append("d.dt_dep, ")
		  .append("pkg.name_en, ")
		  .append("pkg.name_other, ")
		  .append("pkg.name_zh, ")
		  .append("d.num_days, ")
		  .append("d.num_nights, ")
		  .append("d.description, ")
		  .append("d.code, ")
		  .append("CONCAT_WS(' ', d.num_days, 'Days', d.num_nights, 'Nights', pkg.name_en, pkg.name_zh, d.description), ")
		  .append("d.lang_cd, ")
		  .append("pkg.type_cd, ")
		  .append("d.id_airline, ")
		  .append("d.id_airline_schedule, ")
		  .append("(SELECT ")
		  .append("CASE WHEN SUM(i.quantity) IS NULL THEN 0 ELSE SUM(i.quantity) END ")
		  .append("FROM tour_booking b, tour_booking_charge_item i ")
		  .append("WHERE b.id_tour_dep = d.id ")
		  .append("AND i.id_tour_booking = b.id ")
		  .append("AND b.status_cd = :bookingStatusCd ")
		  .append("AND i.code IN ('FT_SGL', 'FT_TWN', 'GA_SGL', 'GA_TWN')) AS adult_pax, ")
		  .append("(SELECT ")
		  .append("CASE WHEN SUM(i.quantity) IS NULL THEN 0 ELSE SUM(i.quantity) END ")
		  .append("FROM tour_booking b, tour_booking_charge_item i ")
		  .append("WHERE b.id_tour_dep = d.id ")
		  .append("AND i.id_tour_booking = b.id ")
		  .append("AND b.status_cd = :bookingStatusCd ")
		  .append("AND i.code IN ('FT_CTW', 'FT_CWB', 'FT_CNB', 'GA_CTW', 'GA_CWB', 'GA_CNB')) AS child_pax, ")
		  .append("(SELECT ")
		  .append("CASE WHEN SUM(i.quantity) IS NULL THEN 0 ELSE SUM(i.quantity) END ")
		  .append("FROM tour_booking b, tour_booking_charge_item i ")
		  .append("WHERE b.id_tour_dep = d.id ")
		  .append("AND i.id_tour_booking = b.id ")
		  .append("AND b.status_cd = :bookingStatusCd ")
		  .append("AND i.code IN ('FT_INFT', 'GA_INFT')) AS inf_pax, ")
		  .append("d.airline_schedule_items, ")
		  .append("d.airline_schdl_itms_w_seq, ")
		  .append("d.airline_schdl_itms_w_etd, ")
		  .append("d.airline_schdl_itms_w_eta, ")
		  .append("d.airline_schdl_itms_w_depDt, ")
		  .append("d.airline_schdl_itms_w_arrDt, ")
		  .append("d.airline_schdl_itms_w_remarks, ")
		  .append("d.dt_dep ")
		  .append("FROM tour_dep d ")
		  .append("LEFT JOIN tour_pkg pkg ON d.id_tour_pkg = pkg.id ")
		  .append("WHERE 1=1 ");
		
		sb.append(getTourDepListFilters(params));
		
		sb.append(" ORDER BY ");
		String sortField = (String) params.get("sortField");
		
		if (sortField == null) {
			if (params.get("requestType") != null && "INVOICE".equals(params.get("requestType").toString())) {
				sb.append("d.dt_dep, d.code");
			} else {
				sb.append("d.dt_dep desc");
			}
		} else {
			if ("code".equals(sortField)) sb.append("d.code");
			else if ("dtDep".equals(sortField)) sb.append("d.dt_dep");
			else if ("packageDesc".equals(sortField)) sb.append("CONCAT_WS(' ', d.num_days, 'Days', d.num_nights, 'Nights', pkg.name_en, pkg.name_zh, d.description)");
			
			if (CommonConstant.SORT_ASC.equals(((SortOrder) params.get("sortOrder")).toString())) sb.append(" asc");
			else sb.append(" desc");
		}
		
		System.out.println("###############sb.toString(): " + sb.toString());
		
		Query query = createSQLQuery(sb.toString());
//		query.setParameter("statusCd", CommonConstant.STATUS_CD_CANCELLED);
		query.setParameter("bookingStatusCd", CommonConstant.STATUS_CD_CONFIRMED);
		String tempPackageName;
		query.setFirstResult((Integer) params.get("first"));
		query.setMaxResults((Integer) params.get("pageSize"));
		
		List<Object> results = query.list();
		List<TourDepartureVO> tourDepList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new TourDepartureVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setDtDep((Date) row[1]);
			
			vo.setCode((String) row[8]);
			
			tempPackageName = "";
			
			if(row[2]!= null) vo.setNameEn((String) row[2]);
			if(row[3]!= null) vo.setNameOther((String) row[3]);
			if(row[4]!= null) vo.setNameZh((String) row[4]);
			if(row[5]!= null) vo.setNumDays(((Short) row[5]).intValue());
			if(row[6]!= null) vo.setNumNights(((Short) row[6]).intValue());
			if(row[7]!= null) vo.setDesc((String) row[7]);
			if(row[10]!= null) vo.setLangCode((String) row[10]);
			if(row[11]!= null) vo.setTourPkgTypeCd((String) row[11]);
			
			if(row[5]!= null) {
				if(!row[5].toString().equals("0")) tempPackageName += row[5].toString() + " Days ";
			}
			if(row[6]!= null) {
				if(!row[6].toString().equals("0")) tempPackageName += row[6].toString()  + " Nights ";
			}
			if(row[2]!= null) tempPackageName += (String) row[2];
			if(row[4]!= null) tempPackageName += " " + (String) row[4];
			if(row[7]!= null) tempPackageName += (String) row[7]; 
			vo.setPackageDesc((String) row[9]);
			if(row[12] != null) vo.setIdAirline(((BigInteger) row[12]).longValue());
			if(row[13] != null) vo.setIdAirlineSchedule(((BigInteger) row[13]).longValue());
			if(row[14] != null) vo.setTotalAdult(((BigDecimal) row[14]).intValue());
			if(row[15] != null) vo.setTotalChild(((BigDecimal) row[15]).intValue());
			if(row[16] != null) vo.setTotalInf(((BigDecimal) row[16]).intValue());
			if(row[17] != null) vo.setAirlineScheduleItems((String) row[17]);
			if(row[18] != null) vo.setAirlineScheduleItemsBySeq((String) row[18]);
			if(row[19] != null) vo.setAirlineScheduleItemsByEtd((String) row[19]);
			if(row[20] != null) vo.setAirlineScheduleItemsByEta((String) row[20]);
			if(row[21] != null) vo.setAirlineScheduleItemsByDepDt((String) row[21]);
			if(row[22] != null) vo.setAirlineScheduleItemsByArrDt((String) row[22]);
			if(row[23] != null) vo.setAirlineScheduleItemsByRemarks((String) row[23]);
			if(row[24] != null) vo.setDtDep((Date) row[24]);
			tourDepList.add(vo);
		}
		return tourDepList;
	}
	
	private StringBuilder getTourDepListFilters(Map<String, Object> params) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		Map<String, String> filters = (Map<String, String>) params.get("filters");
		if (!filters.isEmpty()) {
			sb.append("AND (");
			for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) {
				Entry<String, String> entry = it.next();
				if ("idTourPkg".equals(entry.getKey())) sb.append("d.id_tour_pkg like '%").append(entry.getValue()).append("%'");
				else if ("code".equals(entry.getKey())) sb.append("d.code like '%").append(entry.getValue()).append("%'");
				else if ("dtDep".equals(entry.getKey())) sb.append("date_format(d.dt_dep, '%d-%b-%Y') like '%").append(entry.getValue()).append("%'");
				else if ("packageDesc".equals(entry.getKey())) sb.append("CONCAT_WS(' ', d.num_days, 'Days', d.num_nights, 'Nights', pkg.name_en, pkg.name_zh, d.description) like '%").append(entry.getValue()).append("%'");
				
				if (filters.size() > 1 && it.hasNext()) sb.append(" and ");
			}
			sb.append(")");
		}
		
		if (params.get("showCancelled") != null && "Y".equals(params.get("showCancelled").toString())) {
		} else {
			sb.append(" and d.status_cd <> '").append(CommonConstant.STATUS_CD_CANCELLED).append("' ");
		}
		
		if (params.get("requestType") != null && "INVOICE".equals(params.get("requestType").toString())) {
			if (params.get("inactiveRecords") != null && "Y".equals(params.get("inactiveRecords").toString())) {
				sb.append(" and d.status_cd = '").append(CommonConstant.STATUS_CD_INACTIVE).append("' ");
			} else {
				sb.append(" and d.status_cd = '").append(CommonConstant.STATUS_CD_ACTIVE).append("' ");
				sb.append(" and d.tour_status_cd != '").append(ProductConstant.TOUR_STATUS_CD_CLOSE).append("' ");
				sb.append(" and d.tour_status_cd != '").append(ProductConstant.TOUR_STATUS_CD_NOT_OPT).append("' ");
				sb.append(" and d.tour_status_cd != '").append(ProductConstant.TOUR_STATUS_CD_FULL).append("' ");
			}
		}
		
		return sb;
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getTourDepListBySearch(TourDepartureVO searchTourDep) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT ").
			append("d.id, d.seq_no, d.dt_dep, d.tour_status_cd, d.code AS 'tourcode', d.num_days, d.num_nights, d.description, ").
			append("d.is_deposit_paid, d.is_issued_s, d.is_issued_f, d.is_push, d.tfair_discount, d.prn, ").
			append("d.seat_allotment, d.tour_mgr_pax, d.reserved_seat, d.full_twn, d.full_sgl, d.full_ctw, d.full_ceb, d.full_cnb, ").
			append("d.grnd_twn, d.grnd_sgl, d.grnd_ctw, d.grnd_ceb, d.grnd_cnb, d.cna_adt, d.csi_adt, d.misc_adt, d.misc_chd, a.code AS 'airline', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 't_fair%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'tfairpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'agent%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'agentpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'in_house%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'inhousepax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'online_booking%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'on9bookingpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'BK' and b.pmnt_status_cd = 'KIV' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'kivpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and (b.status_cd = 'CF' or (b.status_cd = 'BK' and pmnt_status_cd = 'KIV')) and i.code in ('GA_SGL', 'GA_TWN', 'GA_CTW', 'GA_CWB', 'GA_CNB', 'GA_INFT')) AS 'ga', d.tour_pkg_daily_cms, ").
			append("d.travel_ins_policy_s, d.travel_ins_policy_f, d.lang_cd ").
			append(", d.deadline, d.is_lock, d.is_private_tour, d.private_pic ").
			append("FROM tour_dep d JOIN airline a ON d.id_airline = a.id ");
		
		if (CollectionUtils.isNotEmpty(searchTourDep.getDepartDateBadgeList())) {
			sb.append("JOIN tour_dep_attribute ta ON ta.tag_type = 'depart_date_badge' AND ta.id_tour_dep = d.id AND ta.code in (");
			for (int i = 0; i < searchTourDep.getDepartDateBadgeList().size(); i++) {
				String s = searchTourDep.getDepartDateBadgeList().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		
		if (CollectionUtils.isNotEmpty(searchTourDep.getSelectedSeason())) {
			sb.append("JOIN tour_dep_season ts ON ts.id_tour_dep = d.id AND ts.season in (");
			for (int i = 0; i < searchTourDep.getSelectedSeason().size(); i++) {
				String s = searchTourDep.getSelectedSeason().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		
		sb.append("WHERE d.id_tour_pkg = :idTourPkg AND d.status_cd = :statusCode ");
		
		if (searchTourDep.getFromDate() != null && searchTourDep.getToDate() == null) {
			sb.append("AND d.dt_dep >= '").append(dateFormat.format(searchTourDep.getFromDate())).append("' ");
		}
		if (searchTourDep.getFromDate() != null && searchTourDep.getToDate() != null) {
			sb.append("AND d.dt_dep BETWEEN '").append(dateFormat.format(searchTourDep.getFromDate())).append("' ").append("AND '").append(dateFormat.format(searchTourDep.getToDate())).append("' ");
		}
		if (searchTourDep.getTourPkgDailyCms() != null) {
			sb.append("AND d.tour_pkg_daily_cms = ").append(searchTourDep.getTourPkgDailyCms()).append(" ");
		}
		if (StringUtils.isNotBlank(searchTourDep.getLangCode())) {
			sb.append("AND d.lang_cd = '").append(searchTourDep.getLangCode()).append("' ");
		}
		if (StringUtils.isNotBlank(searchTourDep.getTourStatusCd())) {
			sb.append("AND d.tour_status_cd = '").append(searchTourDep.getTourStatusCd()).append("' ");
		}
		sb.append("ORDER BY d.seq_no is null, d.seq_no, d.dt_dep, d.code");
		
		Query query = createSQLQuery(sb.toString());
		query.setLong("idTourPkg", searchTourDep.getIdTourPkg());
		query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
		List<Object> results = query.list();
		List<TourDepartureVO> tourDepList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new TourDepartureVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setSeqNo(row[1] == null ? null : Integer.parseInt(row[1].toString()));
			vo.setDtDep((Date) row[2]);
			vo.setTourStatusCd((String) row[3]);
			vo.setCode((String) row[4]);
			vo.setNumDays(((Short) row[5]).intValue());
			vo.setNumNights(((Short) row[6]).intValue());
			vo.setDesc(row[7] == null ? null : (String) row[7]);
			vo.setIsDepositPaid((Boolean) row[8]);
			vo.setIsIssuedS((Boolean) row[9]);
			vo.setIsIssuedF((Boolean) row[10]);
			vo.setIsPush((Boolean) row[11]);
			vo.setTfairDiscount((Double) row[12]);
			vo.setPrn(row[13] == null ? null : (String) row[13]);
			vo.setSeatAllot(((Short) row[14]).intValue());
			vo.setTourManagerPax(((Short) row[15]).intValue());
			vo.setReservedSeat(((Short) row[16]).intValue());
			vo.setFullTwn((Double) row[17]);
			vo.setFullSgl((Double) row[18]);
			vo.setFullCtw((Double) row[19]);
			vo.setFullCeb((Double) row[20]);
			vo.setFullCnb((Double) row[21]);
			vo.setGrndTwn((Double) row[22]);
			vo.setGrndSgl((Double) row[23]);
			vo.setGrndCtw((Double) row[24]);
			vo.setGrndCeb((Double) row[25]);
			vo.setGrndCnb((Double) row[26]);
			vo.setCnaAdt((Double) row[27]);
			vo.setCsiAdt((Double) row[28]);
			vo.setMiscAdt((Double) row[29]);
			vo.setMiscChd((Double) row[30]);
			vo.setAirlineCode((String) row[31]);
			vo.setTfairPax(((BigDecimal) row[32]).intValue());
			vo.setAgentPax(((BigDecimal) row[33]).intValue());
			vo.setInHsePax(((BigDecimal) row[34]).intValue());
			vo.setOn9BookingPax(((BigDecimal) row[35]).intValue());
			vo.setKivPax(((BigDecimal) row[36]).intValue());
			vo.setTotalGA(((BigDecimal) row[37]).intValue());
			vo.setTourPkgDailyCms(row[38] != null ? ((BigInteger) row[38]).longValue() : null);
			
			if (StringUtils.isNotBlank(row[39] != null ? row[39].toString() : "")) {
				vo.setTravelInsS(true);
			}
			if (StringUtils.isNotBlank(row[40] != null ? row[40].toString() : "")) {
				vo.setTravelInsF(true);
			}
			vo.setLangCode(row[41] != null ? row[41].toString() : "");
			if(row[42] != null ) vo.setDeadline(Integer.parseInt(row[42].toString())); else vo.setDeadline(0);
			vo.setIsLock(row[43] != null ? ((Boolean) row[43]) : false);
			vo.setIsPrivateTour(row[44] != null ? ((Boolean) row[44]) : false);
			vo.setPrivatePic(row[45] != null ? row[45].toString() : "");
			
			// Tour Departure Discount
			vo.setTourDepartureDiscountVOList(getTourDepDiscount(vo.getId()));
			
			vo.setDiscount1(0.00);
			vo.setDiscount2(0.00);
			if (CollectionUtils.isNotEmpty(vo.getTourDepartureDiscountVOList())) {
				int count = 1;
				
				for (TourDepartureDiscountVO discountVO : vo.getTourDepartureDiscountVOList()) {
					double discountAmt = discountVO.getDiscountAmt();
					int discountPax = discountVO.getDiscountPax();
					
					if (count == 1) {
						vo.setDiscount1(discountAmt);
						vo.setDiscountPax1(discountPax);
					} else if (count == 2) {
						vo.setDiscount2(discountAmt);
						vo.setDiscountPax2(discountPax);
					}
					count++;
				}
			}
			tourDepList.add(vo);
		}
		return tourDepList;
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getTourDepListCruiseBySearch(TourDepartureVO searchTourDep) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT ").append(
				"d.id, d.seq_no, d.dt_dep, d.tour_status_cd, d.code AS 'tourcode', d.num_days, d.num_nights, d.description, ")
				.append("d.is_deposit_paid, d.is_issued_s, d.is_issued_f, d.is_push, d.tfair_discount, d.prn, ")
				.append("d.seat_allotment, d.tour_mgr_pax, d.reserved_seat, d.full_twn, d.full_sgl, d.full_ctw, d.full_ceb, d.full_cnb, ")
				.append("d.grnd_twn, d.grnd_sgl, d.grnd_ctw, d.grnd_ceb, d.grnd_cnb, d.cna_adt, d.csi_adt, d.misc_adt, d.misc_chd, IF(ISNULL(d.id_cruise)=1, '', a.code) AS 'cruise', ")
				.append("d.tour_pkg_daily_cms, d.travel_ins_policy_s, d.travel_ins_policy_f, d.id_tour_pkg, ")
				.append("d.dt_created, d.created_by, d.dt_upd, d.upd_by, d.lang_cd, ")
				.append("d.deadline, d.is_lock, d.is_private_tour, d.private_pic, d.tour_status_reason ")
				.append("from tour_dep d join cruise a on d.id_cruise = a.id ");
		
		if (CollectionUtils.isNotEmpty(searchTourDep.getDepartDateBadgeList())) {
			sb.append("JOIN tour_dep_attribute ta ON ta.tag_type = 'depart_date_badge' AND ta.id_tour_dep = d.id AND ta.code in (");
			for (int i = 0; i < searchTourDep.getDepartDateBadgeList().size(); i++) {
				String s = searchTourDep.getDepartDateBadgeList().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		
		if (CollectionUtils.isNotEmpty(searchTourDep.getSelectedSeason())) {
			sb.append("JOIN tour_dep_season ts ON ts.id_tour_dep = d.id AND ts.season in (");
			for (int i = 0; i < searchTourDep.getSelectedSeason().size(); i++) {
				String s = searchTourDep.getSelectedSeason().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		
		sb.append("WHERE d.id_tour_pkg = :idTourPkg AND d.status_cd = :statusCode ");
		
		if (searchTourDep.getFromDate() != null && searchTourDep.getToDate() == null) {
			sb.append("AND d.dt_dep >= '").append(dateFormat.format(searchTourDep.getFromDate())).append("' ");
		}
		if (searchTourDep.getFromDate() != null && searchTourDep.getToDate() != null) {
			sb.append("AND d.dt_dep BETWEEN '").append(dateFormat.format(searchTourDep.getFromDate())).append("' ").append("AND '").append(dateFormat.format(searchTourDep.getToDate())).append("' ");
		}
		if (searchTourDep.getTourPkgDailyCms() != null) {
			sb.append("AND d.tour_pkg_daily_cms = ").append(searchTourDep.getTourPkgDailyCms()).append(" ");
		}
		if (StringUtils.isNotBlank(searchTourDep.getLangCode())) {
			sb.append("AND d.lang_cd = '").append(searchTourDep.getLangCode()).append("' ");
		}
		if (StringUtils.isNotBlank(searchTourDep.getTourStatusCd())) {
			sb.append("AND d.tour_status_cd = '").append(searchTourDep.getTourStatusCd()).append("' ");
		}
		sb.append("ORDER BY d.seq_no is null, d.seq_no, d.dt_dep, d.code");
		
		Query query = createSQLQuery(sb.toString());
		query.setLong("idTourPkg", searchTourDep.getIdTourPkg());
		query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
		List<Object> results = query.list();
		List<TourDepartureVO> tourDepList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		
		for (Iterator<Object> it = results.iterator(); it.hasNext();) {
			Object[] row = (Object[]) it.next();
			vo = new TourDepartureVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setSeqNo(row[1] == null ? null : Integer.parseInt(row[1].toString()));
			vo.setDtDep((Date) row[2]);
			vo.setTourStatusCd((String) row[3]);
			vo.setCode((String) row[4]);
			vo.setNumDays(((Short) row[5]).intValue());
			vo.setNumNights(((Short) row[6]).intValue());
			vo.setDesc(row[7] == null ? null : (String) row[7]);
			vo.setIsDepositPaid((Boolean) row[8]);
			vo.setIsIssuedS((Boolean) row[9]);
			vo.setIsIssuedF((Boolean) row[10]);
			vo.setIsPush((Boolean) row[11]);
			vo.setTfairDiscount((Double) row[12]);
			vo.setPrn(row[13] == null ? null : (String) row[13]);
			vo.setSeatAllot(((Short) row[14]).intValue());
			vo.setTourManagerPax(((Short) row[15]).intValue());
			vo.setReservedSeat(((Short) row[16]).intValue());
			vo.setFullTwn((Double) row[17]);
			vo.setFullSgl((Double) row[18]);
			vo.setFullCtw((Double) row[19]);
			vo.setFullCeb((Double) row[20]);
			vo.setFullCnb((Double) row[21]);
			vo.setGrndTwn((Double) row[22]);
			vo.setGrndSgl((Double) row[23]);
			vo.setGrndCtw((Double) row[24]);
			vo.setGrndCeb((Double) row[25]);
			vo.setGrndCnb((Double) row[26]);
			vo.setCnaAdt((Double) row[27]);
			vo.setCsiAdt((Double) row[28]);
			vo.setMiscAdt((Double) row[29]);
			vo.setMiscChd((Double) row[30]);
			vo.setCruiseMiscAdt((Double) row[29]);
			vo.setCruiseMiscChd((Double) row[30]);
			vo.setCruiseCode((String) row[31]);
			vo.setTourPkgDailyCms(row[32] != null ? ((BigInteger) row[32]).longValue() : null);

			if (StringUtils.isNotBlank(row[33] != null ? row[33].toString() : "")) {
				vo.setTravelInsS(true);
			}
			if (StringUtils.isNotBlank(row[34] != null ? row[34].toString() : "")) {
				vo.setTravelInsF(true);
			}
			vo.setIdTourPkg(((BigInteger) row[35]).longValue());
			vo.setCreatedDate((Date) row[36]);
			vo.setCreatedBy((String) row[37]);
			vo.setUpdatedDate((Date) row[38]);
			vo.setUpdatedBy((String) row[39]);
			vo.setLangCode(row[40] != null ? row[40].toString() : "");
			if(row[41] != null ) vo.setDeadline(Integer.parseInt(row[41].toString())); else vo.setDeadline(0);
			vo.setIsLock(row[42] != null ? ((Boolean) row[42]) : false);
			vo.setIsPrivateTour(row[43] != null ? ((Boolean) row[43]) : false);
			vo.setPrivatePic(row[44] != null ? row[44].toString() : "");
			vo.setTourStatusReason(row[45] != null ? row[45].toString() : "");
			tourDepList.add(vo);
		}
		return tourDepList;
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getTourDepartureInsuranceList(SearchParamVO searchParamVO, Map<String, Object> params) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		String psPrefix = LookupItemUtils.getPsPrefix((Long) params.get("companyId"));
		String invPrefix = LookupItemUtils.getInvPrefix((Long) params.get("companyId"));
		sb.append("SELECT d.id, d.dt_dep, d.code, d.num_days, d.num_nights, d.travel_ins_policy_s, d.travel_ins_policy_f, d.is_issued_s, d.is_issued_f, d.full_twn, d.misc_adt, ")
		  .append("(SELECT amount FROM tour_dep_item WHERE id_tour_dep = d.id AND code = 'TRVL_INS') AS travelIns, ")
		  .append("IFNULL(b.sumqty, 0) AS sumqty, d.status_cd, d.tour_status_cd, c.description AS tourCat, ct.name AS country, d.insurance_remarks, d.id_tour_pkg, tda.code AS departDateBadgeCode, tpa.code AS tourBadgeCode, d.is_private_tour, d.is_remain_tc, ")
		  .append("(select GROUP_CONCAT(CONCAT('By ', upd_by,' On ', DATE_FORMAT(dt_upd, '%d-%b-%Y %H:%i:%s')) ORDER BY dt_upd DESC SEPARATOR '<br/>') from (select upd_by, dt_upd from tour_dep_history h where h.id_hist = d.id AND h.action_cd = 'INS' order by dt_upd DESC limit 5) t) as updatedInfo, ")
		  .append("IFNULL(ins.totalInv, 0) AS totalInv, IFNULL(ins.totalNotIssuedDoc, 0) AS totalNotIssuedDoc,  IFNULL(ins.totalNotIssuedDocNo, '') AS totalNotIssuedDocNo ") 
		  .append("FROM tour_dep d ")
		  .append("LEFT JOIN (")
		    .append("SELECT b.id_tour_dep, SUM(i.quantity) AS sumqty ")
		    .append("FROM tour_booking b ")
		    .append("JOIN tour_booking_charge_item i ON b.id = i.id_tour_booking ")
		    .append("WHERE b.status_cd = 'CF' AND i.code IN ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB') ")
		    .append("GROUP BY b.id_tour_dep ")
		  .append(") b ON b.id_tour_dep = d.id ")
		  .append("LEFT JOIN tour_pkg p ON p.id = d.id_tour_pkg ")
		  .append("LEFT JOIN tour_theme t ON t.id = p.id_tour_theme ")
		  .append("LEFT JOIN tour_cat c ON c.id = t.id_tour_cat ")
		  .append("LEFT JOIN country ct ON ct.id = t.id_country ")
		  .append("LEFT JOIN tour_pkg_attribute tpa ON tpa.id_tour_pkg = p.id AND tpa.tag_type = 'tour_badge' AND tpa.code = 'char_flight' ")
		  .append("LEFT JOIN tour_dep_attribute tda ON tda.id_tour_dep = d.id AND tda.tag_type = 'depart_date_badge' AND tda.code = 'CFM' ")
//		  .append("LEFT JOIN (SELECT h1.id_hist, GROUP_CONCAT(CONCAT('By ', h1.upd_by, ' On ', DATE_FORMAT(h1.dt_upd, '%d-%b-%Y %H:%i:%s')) ORDER BY h1.dt_upd DESC SEPARATOR '<br/>') AS updatedInfo ")
//		  .append("FROM tour_dep_history h1 WHERE h1.action_cd = 'INS' AND (SELECT COUNT(*) FROM tour_dep_history h2 WHERE h2.id_hist = h1.id_hist AND h2.action_cd = 'INS' AND h2.dt_upd >= h1.dt_upd) <= 5 ")
//		  .append("GROUP BY h1.id_hist) h ON h.id_hist = d.id ")
		  .append("LEFT JOIN (SELECT iv.id_tour_dep, COUNT(*) AS totalInv, ")
	      .append("SUM(CASE WHEN EXISTS (SELECT 1 FROM invoice_pax ip where ip.id_inv = iv.id AND TRIM(IFNULL(ip.travel_ins_policy, '')) = '') ")
	      .append("THEN 1 ELSE 0 END) AS totalNotIssuedDoc, GROUP_CONCAT(CASE WHEN EXISTS (SELECT 1 FROM invoice_pax ip WHERE ip.id_inv = iv.id AND TRIM(IFNULL(ip.travel_ins_policy, '')) = '') ")
	      .append("THEN CASE WHEN iv.doc_type_cd = 'I' THEN CONCAT('"+invPrefix+"', iv.code) ELSE CONCAT('"+psPrefix+"', iv.ps_no) END ELSE NULL END SEPARATOR ', ') AS totalNotIssuedDocNo ")
	      .append("FROM invoice iv WHERE IFNULL(iv.status_cd,'') NOT IN ('CC','VD') AND (iv.doc_type_cd = 'I' OR ( iv.doc_type_cd = 'P' AND iv.doc_type_status IN ('OP','RW','CV') AND NOT EXISTS ( SELECT 1 FROM invoice iv2 ")
	      .append("WHERE iv2.ps_no = iv.ps_no AND iv2.doc_type_cd = 'I' AND IFNULL(iv2.status_cd,'') NOT IN ('CC','VD')))) GROUP BY iv.id_tour_dep) ins ON ins.id_tour_dep = d.id ")
	      .append("WHERE d.status_cd = :statusCode AND d.dt_dep BETWEEN DATE(:fromDate) AND DATE(:toDate) ")
	      .append("AND ((DATEDIFF(d.dt_dep, CURRENT_DATE) <= 65 AND b.sumqty >= 1) ")
	      .append("OR (DATEDIFF(d.dt_dep, CURRENT_DATE) > 65  AND b.sumqty >= 8) ")
		  .append("OR (d.tour_status_cd = 'I') ")
		  .append("OR (tpa.tag_type = :tpaTagType AND tpa.code = :tpaCode) ")
		  .append("OR (tda.tag_type = :tdaTagType AND tda.code = :tdaCode) ")
		  .append("OR d.is_remain_tc = 1) ");

		if (searchParamVO.getArrayObj1() != null) { // search country
			if (searchParamVO.getArrayObj1().length > 0) {
				//sb.append(" and d.id_tour_pkg in (select p.id from tour_pkg p, tour_pkg_country c").
				//	append(" where p.id = c.id_tour_pkg and c.type_cd = 'COUNTRY' and c.status_cd = 'AC' and c.id_location in (");
				
				sb.append(" and t.id_country in (");
				
				for (int i = 0; i < searchParamVO.getArrayObj1().length; i++) {
					String id = searchParamVO.getArrayObj1()[i].toString();
					if (i > 0) sb.append(",");
					sb.append(id);
				}
				sb.append(")");
			}
		}
		
		if (searchParamVO.getObj1() != null) { // search policy f fill or blank
			boolean isFill = "0".equals(searchParamVO.getObj1().toString()) ? true : false;
			if (isFill) sb.append(" and (d.travel_ins_policy_f is not null and d.travel_ins_policy_f != '')");
			else sb.append(" and (d.travel_ins_policy_f is null or d.travel_ins_policy_f = '')");
		}
		
		if (searchParamVO.getObj2() != null) { // search policy f issue checked or uncheck
			sb.append(" and (d.is_issued_f = ").append(searchParamVO.getObj2().toString()).append(")");
		}
		
		if (searchParamVO.getObj6() != null) { // search policy s fill or blank
			boolean isFill = "0".equals(searchParamVO.getObj6().toString()) ? true : false;
			if (isFill) sb.append(" and (d.travel_ins_policy_s is not null and d.travel_ins_policy_s != '')");
			else sb.append(" and (d.travel_ins_policy_s is null or d.travel_ins_policy_s = '')");
		}
		
		if (searchParamVO.getObj7() != null) { // search policy s issue checked or uncheck
			sb.append(" and (d.is_issued_s = ").append(searchParamVO.getObj7().toString()).append(")");
		}
		
		if (searchParamVO.getObj4() != null) { // search tour status
			sb.append(" and d.tour_status_cd = '").append(searchParamVO.getObj4().toString()).append("'");
		}
		
		if (searchParamVO.getObj5() != null) { // search for tour category
			sb.append(" and t.id_tour_cat = ").append(searchParamVO.getObj5().toString());
		}
		
		if (searchParamVO.getObj8() != null) { // search for tour code
		    sb.append(" and d.code like '%").append(searchParamVO.getObj8().toString()).append("%'");
		}
		
		sb.append(" order by d.dt_dep");
		
		Query query = createSQLQuery(sb.toString());
		if (searchParamVO.getObj3() == null) query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
		else query.setString("statusCode", searchParamVO.getObj3().toString());
		query.setDate("fromDate", searchParamVO.getFromDate());
		query.setDate("toDate", searchParamVO.getToDate());
		query.setString("tpaTagType", CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE);
		query.setString("tdaTagType", CommonConstant.LOOKUP_CAT_CD_DEPART_DATE_BADGE);
		query.setString("tpaCode", CommonConstant.LOOKUP_ITM_TOUR_BADGE_CHAR_FLIGHT);
		query.setString("tdaCode", CommonConstant.LOOKUP_ITM_DEPART_DATE_BADGE_CFM);
		
		List<Object> results = query.list();
		List<TourDepartureVO> tourDepList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		
		Date today = new Date();
		long diffInMillies;
		long diff;
		
		for (Object obj : results) {
			Object[] row = (Object[]) obj;
			vo = new TourDepartureVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setDtDep((Date) row[1]);
			vo.setCode(row[2].toString());
			vo.setNumDays(Integer.parseInt(row[3].toString()));
			vo.setNumNights(Integer.parseInt(row[4].toString()));
			vo.setTravelInsPolicyS(row[3] == null ? null : row[5].toString());
			vo.setTravelInsPolicyF(row[4] == null ? null : row[6].toString());
			vo.setIsIssuedS((Boolean) row[7]);
			vo.setIsIssuedF((Boolean) row[8]);
			vo.setFullTwn(Double.parseDouble(row[9].toString()));
			vo.setMiscAdt(Double.parseDouble(row[10].toString()));
			vo.setAirlineTrvlIns(row[11] == null ? 0 : Double.parseDouble(row[11].toString()));
			vo.setQuantity(Integer.parseInt(row[12].toString()));
			vo.setStatusCode(row[13].toString());
			vo.setTourStatusCd(row[14].toString());
			vo.setTourCategoryName(row[15].toString());
			vo.setCountryName((String) row[16]);
			vo.setInsuranceRemarks((String) row[17]);
			vo.setIdTourPkg(((BigInteger) row[18]).longValue());
			if(row[19] != null) vo.setDepartDateBadgeCode(row[19].toString());
			if(row[20] != null) vo.setTourBadgeCode(row[20].toString());
			vo.setIsPrivateTour((Boolean) row[21]);
			vo.setIsRemainTc((Boolean) row[22]);
			if(row[23] != null) vo.setUpdatedBy((String) row[23]);
			vo.setTotalInv(Integer.parseInt(row[24].toString()));
			vo.setTotalNotIssuedDoc(Integer.parseInt(row[25].toString()));
			vo.setTotalNotIssuedDocNo((String) row[26]);
			
			diffInMillies = Math.abs(vo.getDtDep().getTime() - today.getTime());
			diff = TimeUnit.DAYS.convert(diffInMillies, TimeUnit.MILLISECONDS);
			
//			if (diff > 64 && diff <= 90 && (StringUtils.isBlank(vo.getTravelInsPolicyF()) || StringUtils.isBlank(vo.getTravelInsPolicyS()))
//					&& CommonConstant.STATUS_CD_ACTIVE.equals(vo.getStatusCode())) vo.setGroupColor(1);
//			else if (diff > 13 && diff <= 64 && (StringUtils.isBlank(vo.getTravelInsPolicyF()) || StringUtils.isBlank(vo.getTravelInsPolicyS()))
//					&& CommonConstant.STATUS_CD_ACTIVE.equals(vo.getStatusCode())) vo.setGroupColor(2);
//			else if (diff <= 13 && (StringUtils.isBlank(vo.getTravelInsPolicyF()) || StringUtils.isBlank(vo.getTravelInsPolicyS()))
//					&& CommonConstant.STATUS_CD_ACTIVE.equals(vo.getStatusCode())) vo.setGroupColor(3);
//			
			if (diff > 64 && diff <= 90 && CommonConstant.STATUS_CD_ACTIVE.equals(vo.getStatusCode())) vo.setGroupColor(1);
			else if (diff > 13 && diff <= 64 && CommonConstant.STATUS_CD_ACTIVE.equals(vo.getStatusCode())) vo.setGroupColor(2);
			else if (diff <= 13 && CommonConstant.STATUS_CD_ACTIVE.equals(vo.getStatusCode())) vo.setGroupColor(3);
			
			tourDepList.add(vo);
		}
		return tourDepList;
	}

	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getTourDepartureInsurancePaxList(SearchParamVO searchParamVO, Map<String, Object> params) throws BusinessException {
		String PsPrefix = LookupItemUtils.getPsPrefix((Long) params.get("companyId"));
		String invPrefix = LookupItemUtils.getInvPrefix((Long) params.get("companyId"));
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT d.dt_dep, c.description AS tourCat, ct.name AS country, d.code, d.tour_status_cd, d.status_cd,  ")
		  .append("d.num_days, d.num_nights, d.full_twn + d.misc_adt AS tourFare, ") 
		  .append("(SELECT amount FROM tour_dep_item WHERE id_tour_dep = d.id AND code = 'TRVL_INS') AS travelIns, ")
		  .append("IFNULL(b.sumqty, 0) AS totalPax, ")   
		  .append("d.travel_ins_policy_f, d.is_issued_f, d.travel_ins_policy_s, d.is_issued_s, d.is_remain_tc, d.insurance_remarks, ")
		  .append("(select GROUP_CONCAT(CONCAT('By ', upd_by,' On ', DATE_FORMAT(dt_upd, '%d-%b-%Y %H:%i:%s')) ORDER BY dt_upd DESC SEPARATOR '<br/>') from (select upd_by, dt_upd from tour_dep_history h where h.id_hist = d.id AND h.action_cd = 'INS' order by dt_upd DESC limit 5) t) as updatedInfo, ")
		  .append("IFNULL(ins.totalInv, 0) AS totalInv, IFNULL(ins.totalNotIssuedDoc, 0) AS totalNotIssuedDoc,  IFNULL(ins.totalNotIssuedDocNo, '') AS totalNotIssuedDocNo ")
		  .append("FROM tour_dep d ")
		  .append("LEFT JOIN (")
		    .append("SELECT b.id_tour_dep, SUM(i.quantity) AS sumqty ")
		    .append("FROM tour_booking b ")
		    .append("JOIN tour_booking_charge_item i ON b.id = i.id_tour_booking ")
		    .append("WHERE b.status_cd = 'CF' AND i.code IN ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB', 'GA_SGL', 'GA_TWN', 'GA_CTW', 'GA_CWB', 'GA_CNB', 'GA_INFT') ")
		    .append("GROUP BY b.id_tour_dep ")
		  .append(") b ON b.id_tour_dep = d.id ")
		  .append("LEFT JOIN tour_pkg p ON p.id = d.id_tour_pkg ")
		  .append("LEFT JOIN tour_theme t ON t.id = p.id_tour_theme ")
		  .append("LEFT JOIN tour_cat c ON c.id = t.id_tour_cat ")
		  .append("LEFT JOIN country ct ON ct.id = t.id_country ")
//		  .append("LEFT JOIN (SELECT h1.id_hist, GROUP_CONCAT(CONCAT('By ', h1.upd_by, ' On ', DATE_FORMAT(h1.dt_upd, '%d-%b-%Y %H:%i:%s')) ORDER BY h1.dt_upd DESC SEPARATOR '<br/>') AS updatedInfo ")
//		  .append("FROM tour_dep_history h1 WHERE h1.action_cd = 'INS' AND (SELECT COUNT(*) FROM tour_dep_history h2 WHERE h2.id_hist = h1.id_hist AND h2.action_cd = 'INS' AND h2.dt_upd >= h1.dt_upd) <= 5 ")
//		  .append("GROUP BY h1.id_hist) h ON h.id_hist = d.id ")
		  .append("LEFT JOIN (SELECT iv.id_tour_dep, COUNT(*) AS totalInv, ")
		  .append("SUM(CASE WHEN EXISTS (SELECT 1 FROM invoice_pax ip where ip.id_inv = iv.id AND TRIM(IFNULL(ip.travel_ins_policy, '')) = '') ")
	      .append("THEN 1 ELSE 0 END) AS totalNotIssuedDoc, GROUP_CONCAT(CASE WHEN EXISTS (SELECT 1 FROM invoice_pax ip WHERE ip.id_inv = iv.id AND TRIM(IFNULL(ip.travel_ins_policy, '')) = '') ")
	      .append("THEN CASE WHEN iv.doc_type_cd = 'I' THEN CONCAT('"+invPrefix+"', iv.code) ELSE CONCAT('"+PsPrefix+"', iv.ps_no) END ELSE NULL END SEPARATOR ', ') AS totalNotIssuedDocNo ")
	      .append("FROM invoice iv WHERE IFNULL(iv.status_cd,'') NOT IN ('CC','VD') AND (iv.doc_type_cd = 'I' OR ( iv.doc_type_cd = 'P' AND iv.doc_type_status IN ('OP','RW','CV') AND NOT EXISTS ( SELECT 1 FROM invoice iv2 ")
	      .append("WHERE iv2.ps_no = iv.ps_no AND iv2.doc_type_cd = 'I' AND IFNULL(iv2.status_cd,'') NOT IN ('CC','VD')))) GROUP BY iv.id_tour_dep) ins ON ins.id_tour_dep = d.id ")
		  .append("WHERE d.status_cd = :statusCode AND d.dt_dep BETWEEN DATE(:fromDate) AND DATE(:toDate) ")
		  .append("AND (b.sumqty BETWEEN :rangeStart AND :rangeEnd)");
		
		if (searchParamVO.getArrayObj1() != null) { // search country
			if (searchParamVO.getArrayObj1().length > 0) {
				//sb.append(" and d.id_tour_pkg in (select p.id from tour_pkg p, tour_pkg_country c").
				//	append(" where p.id = c.id_tour_pkg and c.type_cd = 'COUNTRY' and c.status_cd = 'AC' and c.id_location in (");
				
				sb.append(" and t.id_country in (");
				
				for (int i = 0; i < searchParamVO.getArrayObj1().length; i++) {
					String id = searchParamVO.getArrayObj1()[i].toString();
					if (i > 0) sb.append(",");
					sb.append(id);
				}
				sb.append(")");
			}
		}
		
		if (searchParamVO.getObj1() != null) { // search policy f fill or blank
			boolean isFill = "0".equals(searchParamVO.getObj1().toString()) ? true : false;
			if (isFill) sb.append(" and (d.travel_ins_policy_f is not null and d.travel_ins_policy_f != '')");
			else sb.append(" and (d.travel_ins_policy_f is null or d.travel_ins_policy_f = '')");
		}
		
		if (searchParamVO.getObj2() != null) { // search policy f issue checked or uncheck
			sb.append(" and (d.is_issued_f = ").append(searchParamVO.getObj2().toString()).append(")");
		}
		
		if (searchParamVO.getObj6() != null) { // search policy s fill or blank
			boolean isFill = "0".equals(searchParamVO.getObj6().toString()) ? true : false;
			if (isFill) sb.append(" and (d.travel_ins_policy_s is not null and d.travel_ins_policy_s != '')");
			else sb.append(" and (d.travel_ins_policy_s is null or d.travel_ins_policy_s = '')");
		}
		
		if (searchParamVO.getObj7() != null) { // search policy s issue checked or uncheck
			sb.append(" and (d.is_issued_s = ").append(searchParamVO.getObj7().toString()).append(")");
		}
		
		if (searchParamVO.getObj4() != null) { // search tour status
			sb.append(" and d.tour_status_cd = '").append(searchParamVO.getObj4().toString()).append("'");
		}
		
		if (searchParamVO.getObj5() != null) { // search for tour category
			sb.append(" and t.id_tour_cat = ").append(searchParamVO.getObj5().toString());
		}
		
		if (searchParamVO.getObj8() != null) { // search for tour code
		    sb.append(" and d.code like '%").append(searchParamVO.getObj8().toString()).append("%'");
		}
		
		sb.append(" order by d.dt_dep");
		
		Query query = createSQLQuery(sb.toString());
		if (searchParamVO.getObj3() == null) query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
		else query.setString("statusCode", searchParamVO.getObj3().toString());
		query.setDate("fromDate", searchParamVO.getFromDate());
		query.setDate("toDate", searchParamVO.getToDate());
		query.setInteger("rangeStart", (int) searchParamVO.getObj9());
		query.setInteger("rangeEnd", (int) searchParamVO.getObj10());
	    
		List<Object> results = query.list();
		List<TourDepartureVO> tourDepList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		
		for (Object obj : results) {
			Object[] row = (Object[]) obj;
			vo = new TourDepartureVO();
			vo.setDtDep((Date) row[0]);                    
			vo.setTourCategoryName((String) row[1]);       			
			vo.setCountryName((String) row[2]);            		
			vo.setCode(row[3].toString());                 			
			vo.setTourStatusCd((String) row[4]);
			vo.setStatusCode((String) row[5]);
			vo.setNumDays(Integer.parseInt(row[6].toString())); 			
			vo.setNumNights(Integer.parseInt(row[7].toString())); 
			vo.setFullTwn(Double.parseDouble(row[8].toString())); 			
			vo.setAirlineTrvlIns(row[9] == null ? 0 : Double.parseDouble(row[9].toString()));
			vo.setQuantity(Integer.parseInt(row[10].toString())); 			
			vo.setTravelInsPolicyF((String) row[11]);      			
			vo.setIsIssuedF((Boolean) row[12]);             
			vo.setTravelInsPolicyS((String) row[13]);       
			vo.setIsIssuedS((Boolean) row[14]);            			
			vo.setIsRemainTc((Boolean) row[15]);           
			vo.setInsuranceRemarks((String) row[16]);
			if(row[17] != null) vo.setUpdatedBy((String) row[17]);
			vo.setTotalInv(Integer.parseInt(row[18].toString()));
			vo.setTotalNotIssuedDoc(Integer.parseInt(row[19].toString()));
			vo.setTotalNotIssuedDocNo((String) row[20]);
			tourDepList.add(vo);
		}
		return tourDepList;
	}
	
	@Override
	public void saveTourDepartureInsurance(TourDepartureVO tourDepartureVO) throws BusinessException {
		Query query = createQuery("UPDATE TourDepartureVO SET travelInsPolicyF = :travelInsPolicyF, travelInsPolicyS = :travelInsPolicyS, isIssuedF = :isIssuedF, isIssuedS = :isIssuedS, isRemainTc = :isRemainTc, insuranceRemarks = :insRemarks, updatedBy = :updatedBy, updatedDate = :updatedDate WHERE id = :id");
		query.setParameter("travelInsPolicyF", tourDepartureVO.getTravelInsPolicyF());
		query.setParameter("travelInsPolicyS", tourDepartureVO.getTravelInsPolicyS());
		query.setParameter("isIssuedF", tourDepartureVO.getIsIssuedF());
		query.setParameter("isIssuedS", tourDepartureVO.getIsIssuedS());
		query.setParameter("isRemainTc", tourDepartureVO.getIsRemainTc());
		query.setParameter("insRemarks", tourDepartureVO.getInsuranceRemarks());
		query.setParameter("id", tourDepartureVO.getId());
		query.setParameter("updatedBy", BaseContext.getUserFullName() == null ? BaseContext.getLoginId(): BaseContext.getUserFullName());
		query.setParameter("updatedDate", new Date());
		query.executeUpdate();
		
		Query query2 = createSQLQuery("CALL prc_tour_dep(:p_id, :p_action, :p_reason)");
		query2.setParameter("p_id", tourDepartureVO.getId());
		query2.setParameter("p_action", "INS");
		query2.setParameter("p_reason", "UPDATE FROM TOUR INSURANCE");
		query2.executeUpdate();
		
		Query query3 = createSQLQuery("SELECT GROUP_CONCAT(CONCAT('By ', upd_by, ' On ', DATE_FORMAT(dt_upd, '%d-%b-%Y %H:%i:%s')) ORDER BY dt_upd DESC SEPARATOR '<br/>' )"+
		        "FROM (SELECT upd_by, dt_upd FROM tour_dep_history WHERE id_hist = :id AND action_cd = 'INS' ORDER BY dt_upd DESC LIMIT 5) h");
		query3.setParameter("id",tourDepartureVO.getId());
		tourDepartureVO.setUpdatedBy((String)query3.uniqueResult());
		
		Date today = new Date();
		long diffInMillies = Math.abs(tourDepartureVO.getDtDep().getTime() - today.getTime());
		long diff = TimeUnit.DAYS.convert(diffInMillies, TimeUnit.MILLISECONDS);
		
//		if (diff > 20 && diff <= 90 && (StringUtils.isBlank(tourDepartureVO.getTravelInsPolicyF()) || StringUtils.isBlank(tourDepartureVO.getTravelInsPolicyS()))
//				&& CommonConstant.STATUS_CD_ACTIVE.equals(tourDepartureVO.getStatusCode())) tourDepartureVO.setGroupColor(1);
//		else if (diff > 13 && diff <= 20 && (StringUtils.isBlank(tourDepartureVO.getTravelInsPolicyF()) || StringUtils.isBlank(tourDepartureVO.getTravelInsPolicyS()))
//				&& CommonConstant.STATUS_CD_ACTIVE.equals(tourDepartureVO.getStatusCode())) tourDepartureVO.setGroupColor(2);
//		else if (diff <= 13 && (StringUtils.isBlank(tourDepartureVO.getTravelInsPolicyF()) || StringUtils.isBlank(tourDepartureVO.getTravelInsPolicyS()))
//				&& CommonConstant.STATUS_CD_ACTIVE.equals(tourDepartureVO.getStatusCode())) tourDepartureVO.setGroupColor(3);
		if (diff > 64 && diff <= 90 && CommonConstant.STATUS_CD_ACTIVE.equals(tourDepartureVO.getStatusCode())) tourDepartureVO.setGroupColor(1);
		else if (diff > 13 && diff <= 64 && CommonConstant.STATUS_CD_ACTIVE.equals(tourDepartureVO.getStatusCode())) tourDepartureVO.setGroupColor(2);
		else if (diff <= 13 && CommonConstant.STATUS_CD_ACTIVE.equals(tourDepartureVO.getStatusCode())) tourDepartureVO.setGroupColor(3);
		
		else tourDepartureVO.setGroupColor(0);
	}

	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getFilterTourDepList(TourDepartureVO searchTourDepFilter) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT * FROM (").
			append("SELECT ").
			append("d.id, d.id_tour_pkg, d.dt_dep, d.tour_status_cd, d.code AS 'tourcode', d.num_days, d.num_nights, d.description, ").
			append("d.is_deposit_paid, d.is_issued_s, d.is_issued_f, d.is_push, d.tfair_discount, d.prn, ").
			append("d.seat_allotment, d.tour_mgr_pax, d.reserved_seat, d.full_twn, d.full_sgl, d.full_ctw, d.full_ceb, d.full_cnb, ").
			append("d.grnd_twn, d.grnd_sgl, d.grnd_ctw, d.grnd_ceb, d.grnd_cnb, d.cna_adt, d.csi_adt, d.misc_adt, d.misc_chd, a.code AS 'airline', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 't_fair%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'tfairpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'agent%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'agentpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'in_house%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'inhousepax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'online_booking%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'on9bookingpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'BK' and b.pmnt_status_cd = 'KIV' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'kivpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and (b.status_cd = 'CF' or (b.status_cd = 'BK' and pmnt_status_cd = 'KIV')) and i.code in ('GA_SGL', 'GA_TWN', 'GA_CTW', 'GA_CWB', 'GA_CNB', 'GA_INFT')) AS 'ga', d.tour_pkg_daily_cms, p.name_en, p.name_zh, p.name_other, ").
			append("d.travel_ins_policy_s, d.travel_ins_policy_f, d.lang_cd, d.tour_status_reason, if(p.is_push_to_online=0, 0, d.is_push_to_online) ").
			append(", d.deadline, d.status_cd, d.is_lock, d.is_private_tour, p.deposit, d.seq_no ").
			append("from (tour_dep d, airline a) LEFT JOIN tour_pkg p ON d.id_tour_pkg = p.id ");
		
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getDepartDateBadgeList())) {
			sb.append("JOIN tour_dep_attribute ta ON ta.tag_type = 'depart_date_badge' AND ta.id_tour_dep = d.id AND ta.code in (");
			for (int i = 0; i < searchTourDepFilter.getDepartDateBadgeList().size(); i++) {
				String s = searchTourDepFilter.getDepartDateBadgeList().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getSelectedSeason())) {
			sb.append("JOIN tour_dep_season ts ON ts.id_tour_dep = d.id AND ts.season in (");
			for (int i = 0; i < searchTourDepFilter.getSelectedSeason().size(); i++) {
				String s = searchTourDepFilter.getSelectedSeason().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		
		sb.append("where d.id_airline = a.id and d.status_cd = :statusCode ");
		
		if (StringUtils.isNotBlank(searchTourDepFilter.getCode()))
			sb.append("and (d.code like :trCode) ");
		if (searchTourDepFilter.getFromDate() != null)
			sb.append("and DATE(d.dt_dep) >= DATE(:dtFrom) ");
		if (searchTourDepFilter.getToDate() != null)
			sb.append("and DATE(d.dt_dep) <= DATE(:dtTo) ");
		if (StringUtils.isNotBlank(searchTourDepFilter.getPackageDesc())) {
			sb.append("and (CONCAT(IFNULL(p.name_en, ''), ' ', IFNULL(p.name_other, ''), ' ', IFNULL(p.name_zh, '')) like :pkgTitle) ");
		}
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getTourStatusList())) {
			sb.append("and d.tour_status_cd in (");
			for (int i = 0; i < searchTourDepFilter.getTourStatusList().size(); i++) {
				String s = searchTourDepFilter.getTourStatusList().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getTourLangList())) {
			sb.append("and d.lang_cd in (");
			for (int i = 0; i < searchTourDepFilter.getTourLangList().size(); i++) {
				String s = searchTourDepFilter.getTourLangList().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		if (searchTourDepFilter.getPriceFrom() != null)
			sb.append("and d.full_twn >= :priceFrom ");
		if (searchTourDepFilter.getPriceTo() != null)
			sb.append("and d.full_twn <= :priceTo ");
		
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getSectorList())) {
			sb.append("and d.id_tour_pkg in (select id_tour_pkg from tour_pkg_country where type_cd = 'COUNTRY' and id_location in (");
			for (int i = 0; i < searchTourDepFilter.getSectorList().size(); i++) {
				String s = searchTourDepFilter.getSectorList().get(i);
				if (i > 0) sb.append(",");
				sb.append(s);
			}
			sb.append(") and status_cd = 'AC') ");
		} else if (CollectionUtils.isNotEmpty(searchTourDepFilter.getSectorTypeList())) {
			sb.append("and d.id_tour_pkg in (select id_tour_pkg from tour_pkg_country where type_cd = 'REGION' and id_location in (");
			for (int i = 0; i < searchTourDepFilter.getSectorTypeList().size(); i++) {
				String s = searchTourDepFilter.getSectorTypeList().get(i);
				if (i > 0) sb.append(",");
				sb.append(s);
			}
			sb.append(") and status_cd = 'AC') ");
		}
		
		sb.append(") a ");
		if (searchTourDepFilter.getBalanceSeat() != null) {
			sb.append("where ((a.seat_allotment - a.reserved_seat - a.tour_mgr_pax - (a.tfairpax + a.agentpax + a.inhousepax + a.kivpax + a.on9bookingpax)) < 0 or").
			append("(a.seat_allotment - a.reserved_seat - a.tour_mgr_pax - (a.tfairpax + a.agentpax + a.inhousepax + a.on9bookingpax)) >= :balanceSeat) ");
		}
		sb.append("order by a.name_en, a.dt_dep");
		
		Query query = createSQLQuery(sb.toString());
		if(!searchTourDepFilter.isInactiveRecord()) {
			query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
		}else {
			query.setString("statusCode", CommonConstant.STATUS_CD_INACTIVE);
		}
		if (StringUtils.isNotBlank(searchTourDepFilter.getCode()))
			query.setString("trCode", "%" + searchTourDepFilter.getCode() + "%");
		if (searchTourDepFilter.getFromDate() != null)
			query.setDate("dtFrom", searchTourDepFilter.getFromDate());
		if (searchTourDepFilter.getToDate() != null)
			query.setDate("dtTo", searchTourDepFilter.getToDate());
		if (StringUtils.isNotBlank(searchTourDepFilter.getPackageDesc()))
			query.setString("pkgTitle", "%" + searchTourDepFilter.getPackageDesc() + "%");
		if (searchTourDepFilter.getPriceFrom() != null)
			query.setDouble("priceFrom", searchTourDepFilter.getPriceFrom());
		if (searchTourDepFilter.getPriceTo() != null)
			query.setDouble("priceTo", searchTourDepFilter.getPriceTo());
		if (searchTourDepFilter.getBalanceSeat() != null)
			query.setInteger("balanceSeat", searchTourDepFilter.getBalanceSeat());
		
		List<Object> results = query.list();
		List<TourDepartureVO> tourFilterDepList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new TourDepartureVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setIdTourPkg(((BigInteger) row[1]).longValue());
			vo.setDtDep((Date) row[2]);
			vo.setTourStatusCd((String) row[3]);
			vo.setCode((String) row[4]);
			vo.setNumDays(((Short) row[5]).intValue());
			vo.setNumNights(((Short) row[6]).intValue());
			vo.setDesc(row[7] == null ? null : (String) row[7]);
			vo.setIsDepositPaid((Boolean) row[8]);
			vo.setIsIssuedS((Boolean) row[9]);
			vo.setIsIssuedF((Boolean) row[10]);
			vo.setIsPush((Boolean) row[11]);
			vo.setTfairDiscount((Double) row[12]);
			vo.setPrn(row[13] == null ? null : (String) row[13]);
			vo.setSeatAllot(((Short) row[14]).intValue());
			vo.setTourManagerPax(((Short) row[15]).intValue());
			vo.setReservedSeat(((Short) row[16]).intValue());
			vo.setFullTwn((Double) row[17]);
			vo.setFullSgl((Double) row[18]);
			vo.setFullCtw((Double) row[19]);
			vo.setFullCeb((Double) row[20]);
			vo.setFullCnb((Double) row[21]);
			vo.setGrndTwn((Double) row[22]);
			vo.setGrndSgl((Double) row[23]);
			vo.setGrndCtw((Double) row[24]);
			vo.setGrndCeb((Double) row[25]);
			vo.setGrndCnb((Double) row[26]);
			vo.setCnaAdt((Double) row[27]);
			vo.setCsiAdt((Double) row[28]);
			vo.setMiscAdt((Double) row[29]);
			vo.setMiscChd((Double) row[30]);
			vo.setAirlineCode((String) row[31]);
			vo.setTfairPax(((BigDecimal) row[32]).intValue());
			vo.setAgentPax(((BigDecimal) row[33]).intValue());
			vo.setInHsePax(((BigDecimal) row[34]).intValue());
			vo.setOn9BookingPax(((BigDecimal) row[35]).intValue());
			vo.setKivPax(((BigDecimal) row[36]).intValue());
			vo.setTotalGA(((BigDecimal) row[37]).intValue());
			vo.setTourPkgDailyCms(row[38] !=null ? ((BigInteger) row[38]).longValue() : null);
			vo.setNameEn((String) row[39]);
			vo.setNameZh((String) row[40]);
			vo.setNameOther((String) row[41]);
			
			if (StringUtils.isNotBlank(row[42] != null ? row[42].toString() : "")) {
				vo.setTravelInsS(true);
			}
			if (StringUtils.isNotBlank(row[43] != null ? row[43].toString() : "")) {
				vo.setTravelInsF(true);
			}
			vo.setLangCode((String) row[44]);
			vo.setTourStatusReason(row[45] != null ? row[45].toString() : "");
			vo.setIsPushToOnline(row[46] != null ? ((int) row[46]) == 1 : true);
			if(row[47] != null ) vo.setDeadline(Integer.parseInt(row[47].toString())); else vo.setDeadline(0);
			vo.setStatusCode((String) row[48]);
			vo.setIsLock(row[49] != null ? ((Boolean) row[49]) : false);
			vo.setIsPrivateTour(row[50] != null ? ((Boolean) row[50]) : false);
			vo.setDeposit((Double) row[51]);
			vo.setSeqNo(row[52] == null ? null : Integer.parseInt(row[52].toString()));
			
			// Tour Departure Discount
			vo.setTourDepartureDiscountVOList(getTourDepDiscount(vo.getId()));
			
			vo.setDiscount1(0.00);
			vo.setDiscount2(0.00);
			if (CollectionUtils.isNotEmpty(vo.getTourDepartureDiscountVOList())) {
				int count = 1;
				
				for (TourDepartureDiscountVO discountVO : vo.getTourDepartureDiscountVOList()) {
					double discountAmt = discountVO.getDiscountAmt();
					int discountPax = discountVO.getDiscountPax();
					
					if (count == 1) {
						vo.setDiscount1(discountAmt);
						vo.setDiscountPax1(discountPax);
					} else if (count == 2) {
						vo.setDiscount2(discountAmt);
						vo.setDiscountPax2(discountPax);
					}
					count++;
				}
			}
			tourFilterDepList.add(vo);
		}
		return tourFilterDepList;
	}

	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getFilterBookingTourDepList(TourDepartureVO searchTourDepFilter) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT * FROM (").
			append("SELECT ").
			append("d.id, d.id_tour_pkg, d.dt_dep, d.tour_status_cd, d.code AS 'tourcode', d.num_days, d.num_nights, d.description, ").
			append("d.is_deposit_paid, d.is_issued_s, d.is_issued_f, d.is_push, d.tfair_discount, d.prn, ").
			append("d.seat_allotment, d.tour_mgr_pax, d.reserved_seat, d.full_twn, d.full_sgl, d.full_ctw, d.full_ceb, d.full_cnb, ").
			append("d.grnd_twn, d.grnd_sgl, d.grnd_ctw, d.grnd_ceb, d.grnd_cnb, d.cna_adt, d.csi_adt, d.misc_adt, d.misc_chd, a.code AS 'airline', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 't_fair%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'tfairpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'agent%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'agentpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'in_house%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'inhousepax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'online_booking%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'on9bookingpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'BK' and b.pmnt_status_cd = 'KIV' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'kivpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and (b.status_cd = 'CF' or (b.status_cd = 'BK' and pmnt_status_cd = 'KIV')) and i.code in ('GA_SGL', 'GA_TWN', 'GA_CTW', 'GA_CWB', 'GA_CNB', 'GA_INFT')) AS 'ga', d.tour_pkg_daily_cms, p.name_en, p.name_zh, p.name_other, ").
			append("d.travel_ins_policy_s, d.travel_ins_policy_f, d.lang_cd, d.tour_status_reason, if(p.is_push_to_online=0, 0, d.is_push_to_online) ").
			append(", d.deadline, d.status_cd, d.is_lock, d.is_private_tour, d.private_pic, p.deposit ").
			append("from (tour_dep d, airline a) LEFT JOIN tour_pkg p ON d.id_tour_pkg = p.id ");
		
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getDepartDateBadgeList())) {
			sb.append("JOIN tour_dep_attribute ta ON ta.tag_type = 'depart_date_badge' AND ta.id_tour_dep = d.id AND ta.code in (");
			for (int i = 0; i < searchTourDepFilter.getDepartDateBadgeList().size(); i++) {
				String s = searchTourDepFilter.getDepartDateBadgeList().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getSelectedSeason())) {
			sb.append("JOIN tour_dep_season ts ON ts.id_tour_dep = d.id AND ts.season in (");
			for (int i = 0; i < searchTourDepFilter.getSelectedSeason().size(); i++) {
				String s = searchTourDepFilter.getSelectedSeason().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		
		sb.append("where d.id_airline = a.id and d.status_cd = :statusCode ");
		
		if (searchTourDepFilter.isAgent()) {
			sb.append("and (d.tour_status_cd = :available or d.tour_status_cd = :close or d.tour_status_cd = :limited) ");
		}
		
		if (StringUtils.isNotBlank(searchTourDepFilter.getCode()))
			sb.append("and (d.code like :trCode) ");
		if (searchTourDepFilter.getFromDate() != null)
			sb.append("and DATE(d.dt_dep) >= DATE(:dtFrom) ");
		if (searchTourDepFilter.getToDate() != null)
			sb.append("and DATE(d.dt_dep) <= DATE(:dtTo) ");
		if (StringUtils.isNotBlank(searchTourDepFilter.getPackageDesc()))
			sb.append("and (CONCAT(IFNULL(p.name_en, ''), ' ', IFNULL(p.name_other, ''), ' ', IFNULL(p.name_zh, '')) like :pkgTitle) ");
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getTourStatusList())) {
			sb.append("and d.tour_status_cd in (");
			for (int i = 0; i < searchTourDepFilter.getTourStatusList().size(); i++) {
				String s = searchTourDepFilter.getTourStatusList().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getTourLangList())) {
			sb.append("and d.lang_cd in (");
			for (int i = 0; i < searchTourDepFilter.getTourLangList().size(); i++) {
				String s = searchTourDepFilter.getTourLangList().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		if (searchTourDepFilter.getPriceFrom() != null)
			sb.append("and d.full_twn >= :priceFrom ");
		if (searchTourDepFilter.getPriceTo() != null)
			sb.append("and d.full_twn <= :priceTo ");
		
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getSectorList())) {
			sb.append("and d.id_tour_pkg in (select id_tour_pkg from tour_pkg_country where type_cd = 'COUNTRY' and id_location in (");
			for (int i = 0; i < searchTourDepFilter.getSectorList().size(); i++) {
				String s = searchTourDepFilter.getSectorList().get(i);
				if (i > 0) sb.append(",");
				sb.append(s);
			}
			sb.append(") and status_cd = 'AC') ");
		} else if (CollectionUtils.isNotEmpty(searchTourDepFilter.getSectorTypeList())) {
			sb.append("and d.id_tour_pkg in (select id_tour_pkg from tour_pkg_country where type_cd = 'REGION' and id_location in (");
			for (int i = 0; i < searchTourDepFilter.getSectorTypeList().size(); i++) {
				String s = searchTourDepFilter.getSectorTypeList().get(i);
				if (i > 0) sb.append(",");
				sb.append(s);
			}
			sb.append(") and status_cd = 'AC') ");
		}
		
		sb.append(") a ");
		if (searchTourDepFilter.getBalanceSeat() != null) {
			sb.append("where ((a.seat_allotment - a.reserved_seat - a.tour_mgr_pax - (a.tfairpax + a.agentpax + a.inhousepax + a.kivpax + a.on9bookingpax)) < 0 or").
			append("(a.seat_allotment - a.reserved_seat - a.tour_mgr_pax - (a.tfairpax + a.agentpax + a.inhousepax + a.on9bookingpax)) >= :balanceSeat) ");
		}
		sb.append("order by a.name_en, a.dt_dep");
		
		Query query = createSQLQuery(sb.toString());
		if(!searchTourDepFilter.isInactiveRecord()) {
			query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
		}else {
			query.setString("statusCode", CommonConstant.STATUS_CD_INACTIVE);
		}
		if (StringUtils.isNotBlank(searchTourDepFilter.getCode()))
			query.setString("trCode", "%" + searchTourDepFilter.getCode() + "%");
		if (searchTourDepFilter.getFromDate() != null)
			query.setDate("dtFrom", searchTourDepFilter.getFromDate());
		if (searchTourDepFilter.getToDate() != null)
			query.setDate("dtTo", searchTourDepFilter.getToDate());
		if (StringUtils.isNotBlank(searchTourDepFilter.getPackageDesc()))
			query.setString("pkgTitle", "%" + searchTourDepFilter.getPackageDesc() + "%");
		if (searchTourDepFilter.getPriceFrom() != null)
			query.setDouble("priceFrom", searchTourDepFilter.getPriceFrom());
		if (searchTourDepFilter.getPriceTo() != null)
			query.setDouble("priceTo", searchTourDepFilter.getPriceTo());
		if (searchTourDepFilter.getBalanceSeat() != null)
			query.setInteger("balanceSeat", searchTourDepFilter.getBalanceSeat());
		if (searchTourDepFilter.isAgent()) {
			query.setString("available", CommonConstant.STATUS_CD_AVAILABLE);
			query.setString("close", CommonConstant.STATUS_CD_CLOSE);
			query.setString("limited", CommonConstant.STATUS_CD_LIMITED);
		}
		
		List<Object> results = query.list();
		List<TourDepartureVO> tourFilterBookingDepList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new TourDepartureVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setIdTourPkg(((BigInteger) row[1]).longValue());
			vo.setDtDep((Date) row[2]);
			vo.setTourStatusCd((String) row[3]);
			vo.setCode((String) row[4]);
			vo.setNumDays(((Short) row[5]).intValue());
			vo.setNumNights(((Short) row[6]).intValue());
			vo.setDesc(row[7] == null ? null : (String) row[7]);
			vo.setIsDepositPaid((Boolean) row[8]);
			vo.setIsIssuedS((Boolean) row[9]);
			vo.setIsIssuedF((Boolean) row[10]);
			vo.setIsPush((Boolean) row[11]);
			vo.setTfairDiscount((Double) row[12]);
			vo.setPrn(row[13] == null ? null : (String) row[13]);
			vo.setSeatAllot(((Short) row[14]).intValue());
			vo.setTourManagerPax(((Short) row[15]).intValue());
			vo.setReservedSeat(((Short) row[16]).intValue());
			vo.setFullTwn((Double) row[17]);
			vo.setFullSgl((Double) row[18]);
			vo.setFullCtw((Double) row[19]);
			vo.setFullCeb((Double) row[20]);
			vo.setFullCnb((Double) row[21]);
			vo.setGrndTwn((Double) row[22]);
			vo.setGrndSgl((Double) row[23]);
			vo.setGrndCtw((Double) row[24]);
			vo.setGrndCeb((Double) row[25]);
			vo.setGrndCnb((Double) row[26]);
			vo.setCnaAdt((Double) row[27]);
			vo.setCsiAdt((Double) row[28]);
			vo.setMiscAdt((Double) row[29]);
			vo.setMiscChd((Double) row[30]);
			vo.setAirlineCode((String) row[31]);
			vo.setTfairPax(((BigDecimal) row[32]).intValue());
			vo.setAgentPax(((BigDecimal) row[33]).intValue());
			vo.setInHsePax(((BigDecimal) row[34]).intValue());
			vo.setOn9BookingPax(((BigDecimal) row[35]).intValue());
			vo.setKivPax(((BigDecimal) row[36]).intValue());
			vo.setTotalGA(((BigDecimal) row[37]).intValue());
			vo.setTourPkgDailyCms(row[38] !=null ? ((BigInteger) row[38]).longValue() : null);
			vo.setNameEn((String) row[39]);
			vo.setNameZh((String) row[40]);
			vo.setNameOther((String) row[41]);
			
			if (StringUtils.isNotBlank(row[42] != null ? row[42].toString() : "")) {
				vo.setTravelInsS(true);
			}
			if (StringUtils.isNotBlank(row[43] != null ? row[43].toString() : "")) {
				vo.setTravelInsF(true);
			}
			vo.setLangCode((String) row[44]);
			vo.setTourStatusReason(row[45] != null ? row[45].toString() : "");
			vo.setIsPushToOnline(row[46] != null ? ((int) row[46]) == 1 : true);
			if(row[47] != null ) vo.setDeadline(Integer.parseInt(row[47].toString())); else vo.setDeadline(0);
			vo.setStatusCode((String) row[48]);
			vo.setIsLock(row[49] != null ? ((Boolean) row[49]) : false);
			vo.setIsPrivateTour(row[50] != null ? ((Boolean) row[50]) : false);
			vo.setPrivatePic(row[51] != null ? row[51].toString() : "");
			vo.setDeposit((Double) row[52]);
			
			// Tour Departure Discount
			vo.setTourDepartureDiscountVOList(getTourDepDiscount(vo.getId()));
			
			vo.setDiscount1(0.00);
			vo.setDiscount2(0.00);
			if (CollectionUtils.isNotEmpty(vo.getTourDepartureDiscountVOList())) {
				int count = 1;
				
				for (TourDepartureDiscountVO discountVO : vo.getTourDepartureDiscountVOList()) {
					double discountAmt = discountVO.getDiscountAmt();
					int discountPax = discountVO.getDiscountPax();
					
					if (count == 1) {
						vo.setDiscount1(discountAmt);
						vo.setDiscountPax1(discountPax);
					} else if (count == 2) {
						vo.setDiscount2(discountAmt);
						vo.setDiscountPax2(discountPax);
					}
					count++;
				}
			}
			
			tourFilterBookingDepList.add(vo);
		}
		return tourFilterBookingDepList;
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepHistoryVO> getTourDepHistoryList(Long idTourDep) throws BusinessException {
		Criteria criteria = createCriteria(TourDepHistoryVO.class);
		criteria.add(Restrictions.eq("idHist", idTourDep));
		criteria.addOrder(Order.desc("id"));
		return criteria.list();
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getTourDepSalesSuppList(TourDepartureVO searchTourDepFilter, List<EmployeeViewVO> employeeList) throws BusinessException {
		SystemNumberGenerationVO  invSNGVO = systemNumberGenerationDAO.getSystemNumberGeneration(CommonConstant.SYS_NUM_CD_INVC, searchTourDepFilter.getIdCompany());
		SystemNumberGenerationVO  psSNGVO = systemNumberGenerationDAO.getSystemNumberGeneration(CommonConstant.SYS_NUM_CD_PAX_STMT, searchTourDepFilter.getIdCompany());
		
		StringBuilder sb = new StringBuilder();
		sb.append("select d.id, d.id_tour_pkg, d.dt_dep, p.name_en, d.code, d.num_days, d.num_nights, d.seat_allotment, ").
		append("ifnull(b.sumqty, 0) as sumqty, d.status_cd, d.tour_status_cd, ").
		append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
		append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and (b.status_cd = 'CF' or (b.status_cd = 'BK' and pmnt_status_cd = 'KIV')) ").
		append("and i.code in ('GA_SGL', 'GA_TWN', 'GA_CTW', 'GA_CWB', 'GA_CNB', 'GA_INFT')) AS 'ga', ifnull(i.totalPaid, 0) as totalPaid, ifnull(i.totalInv, 0) as totalInv, ").
		append("if(i.totalPaid = i.totalInv, 'CP', 'PE') as fullPayment, ").
		append("ifnull(i.totalValidPass, 0) as totalValidPass, if(i.totalValidPass = i.totalInv, 'CP', 'PE') as passport, ").
		append("ifnull(i.totalVisaCopies, 0) as totalVisaCopies, if(d.is_visa_required = 1, if(i.totalVisaCopies = i.totalInv, 'CP', 'PE'), 'CP') as visa, ").
		append("d.id_pic_user, usr.user_name, ").
		append("i.validPassInvNo, i.visaCopiesInvNo, i.totalUnpaidInvNo, d.deadline, d.is_visa_required, ").
		append("DATE_SUB(d.dt_dep, INTERVAL d.deadline day), ").
		append("i.totalUnpaidInvNoWithUser, i.validPassInvNoWithUser, i.visaCopiesInvNoWithUser, d.op_pic, ").
		append("case ").
			append("when (date(d.dt_dep) >= curdate() and date(d.dt_dep) < DATE_SUB(curdate(),INTERVAL -90 day) and b.sumqty >= 10) then '1' ").
			append("when (curdate() >= DATE_SUB(d.dt_dep,INTERVAL d.deadline day)) then '2' ").
			append("else '0' ").
		append("end as inDeadline, i.totalOpenedDoc, i.totalOpenedDocNo, i.totalOpenedDocNoWithUser ").
		append("from tour_dep d ").
		append("left join ( ").
			append("select b.id_tour_dep, sum(i.quantity) as sumqty ").
			append("from tour_booking b, tour_booking_charge_item i ").
			append("where b.status_cd = 'CF' and b.id = i.id_tour_booking and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB') ").
			append("group by id_tour_dep ").
		append(") b on b.id_tour_dep = d.id ").
		append("left join ( ").
//			append("select iv.id_tour_dep, sum(if(iv.balance <= 0, 1, 0)) as totalPaid, count(iv.id) as totalInv, ").
//			append("select iv.id_tour_dep, sum(if(iv.balance <= 0, 1, 0)) as totalPaid, sum(if(iv.id_tour_booking is not null or iv.id_parent_inv_tour_booking is not null, 1, 0)) as totalInv, ").
			append("select iv.id_tour_dep, sum(if(iv.balance <= 0, 1, 0)) as totalPaid, count(if(iv.id_tour_booking is not null or iv.id_parent_inv_tour_booking is not null, 1, 0)) as totalInv, ").
				append("sum(if(ifnull(iv.note_items, '') LIKE '%valid_passprt%', 1, 0)) as totalValidPass, ").
				append("sum(if(ifnull(iv.note_items, '') LIKE '%visa_copies%', 1, 0)) as totalVisaCopies, ").
				append("sum(if(ifnull(iv.doc_type_status, '') = 'OP', 1, 0)) as totalOpenedDoc, ").
//				append("GROUP_CONCAT(if(ifnull(iv.note_items, '') NOT LIKE '%valid_passprt%', concat(cfg.prefix_id, iv.code), null) SEPARATOR ', ') as validPassInvNo, ").
//				append("GROUP_CONCAT(if(ifnull(iv.note_items, '') NOT LIKE '%valid_passprt%', iv.code, null) SEPARATOR ', ') as validPassInvNo, ").
				append("GROUP_CONCAT(if(ifnull(iv.note_items, '') NOT LIKE '%valid_passprt%', if(iv.doc_type_cd = 'I', concat('" + invSNGVO.getPrefixid() + "', iv.code), concat('" + psSNGVO.getPrefixid() + "', iv.ps_no)), null) SEPARATOR ', ') as validPassInvNo, ").
				append("GROUP_CONCAT(if(ifnull(iv.note_items, '') NOT LIKE '%visa_copies%', if(iv.doc_type_cd = 'I', concat('" + invSNGVO.getPrefixid() + "', iv.code), concat('" + psSNGVO.getPrefixid() + "', iv.ps_no)), null) SEPARATOR ', ') as visaCopiesInvNo, ").
				append("GROUP_CONCAT(if(iv.balance > 0, if(iv.doc_type_cd = 'I', concat('" + invSNGVO.getPrefixid() + "', iv.code), concat('" + psSNGVO.getPrefixid() + "', iv.ps_no)), null) SEPARATOR ', ') as totalUnpaidInvNo, ").
				append("GROUP_CONCAT(if(ifnull(iv.note_items, '') NOT LIKE '%valid_passprt%', concat(" + "if(iv.doc_type_cd = 'I', concat('" + invSNGVO.getPrefixid() + "', iv.code), concat('" + psSNGVO.getPrefixid() + "', iv.ps_no)), ' - ', usr.user_name), null) SEPARATOR '[BR]') as validPassInvNoWithUser, ").
				append("GROUP_CONCAT(if(ifnull(iv.note_items, '') NOT LIKE '%visa_copies%', concat(" + "if(iv.doc_type_cd = 'I', concat('" + invSNGVO.getPrefixid() + "', iv.code), concat('" + psSNGVO.getPrefixid() + "', iv.ps_no)), ' - ', usr.user_name), null) SEPARATOR '[BR]') as visaCopiesInvNoWithUser, ").
				append("GROUP_CONCAT(if(ifnull(iv.doc_type_status, '') = 'OP', concat('" + psSNGVO.getPrefixid() + "', iv.code), null) SEPARATOR ', ') as totalOpenedDocNo, ").
//				append("GROUP_CONCAT(if(ifnull(iv.doc_type_status, '') = 'OP', concat(cfg.prefix_id, iv.code), null) SEPARATOR ', ') as totalOpenedDocNo, ").
				append("GROUP_CONCAT(if(iv.balance > 0, concat(" + "if(iv.doc_type_cd = 'I', concat('" + invSNGVO.getPrefixid() + "', iv.code), concat('" + psSNGVO.getPrefixid() + "', iv.ps_no)), ' - ', usr.user_name), null) SEPARATOR '[BR]') as totalUnpaidInvNoWithUser, ").
				append("GROUP_CONCAT(if(ifnull(iv.doc_type_status, '') = 'OP', concat(" + "if(iv.doc_type_cd = 'I', concat('" + invSNGVO.getPrefixid() + "', iv.code), concat('" + psSNGVO.getPrefixid() + "', iv.ps_no)), ' - ', usr.user_name), null) SEPARATOR '[BR]') as totalOpenedDocNoWithUser ").
			append("from invoice iv ").
			append("left join employee e on e.id = iv.id_saler ").
			append("left join sec_user usr on usr.uuid = e.u_sec_user ").
//			append("left join sys_num_conf cfg on cfg.code = CASE iv.doc_type_cd WHEN 'I' THEN 'invc' ELSE 'pax_statement' END AND cfg.id_company = 1 ").
			append("where iv.status_cd != 'CC' and iv.status_cd != 'VD' and iv.doc_type_cd in ('I', 'P') and ifnull(iv.doc_type_status,'') not in ('SP', 'CV', 'CL') ").
//			append(" and iv.id_tour_booking is not null or iv.id_parent_inv_tour_booking is not null ").
//			append("where iv.status_cd != 'CC' and iv.status_cd != 'VD' and iv.doc_type_cd = 'I' ").
			append("group by iv.id_tour_dep ").
			append(") i on i.id_tour_dep = d.id ").
		append("left join tour_pkg p on p.id = d.id_tour_pkg ").
		append("left join tour_theme t on t.id = p.id_tour_theme ").
		append("left join employee ep on d.id_pic_user = ep.id ").
		append("left join sec_user usr on ep.u_sec_user = usr.uuid ").
		append("where d.status_cd = 'AC' and d.tour_status_cd != 'N' and p.type_cd = 'TOUR' ").
//		append("and b.sumqty >= 10 and d.tour_status_cd != 'N' ").
//		append("and date(d.dt_dep) >= curdate() and date(d.dt_dep) < DATE_SUB(curdate(),INTERVAL -90 day) ");
		append("and ( ").
			append("(date(d.dt_dep) >= curdate() and date(d.dt_dep) < DATE_SUB(curdate(),INTERVAL -90 day) and b.sumqty >= 10) ").
			append("or ").
			append("(date(d.dt_dep) >= curdate() and curdate() >= DATE_SUB(d.dt_dep,INTERVAL d.deadline day)) ").
		append(") ");
		
//		if (searchTourDepFilter.getIdTourCat() != null)
//			sb.append("and t.id_tour_cat = " + searchTourDepFilter.getIdTourCat() + " ");
		
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getIdTourCatList())) {
			sb.append("and t.id_tour_cat in (");
			for (int i = 0; i < searchTourDepFilter.getIdTourCatList().size(); i++) {
				String s = "" + searchTourDepFilter.getIdTourCatList().get(i);
				if (i > 0) sb.append(",");
				sb.append(s);
			}
			sb.append(") ");
		}
		
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getSectorList())) {
			sb.append("and t.id_parent in (");
			for (int i = 0; i < searchTourDepFilter.getSectorList().size(); i++) {
				String s = searchTourDepFilter.getSectorList().get(i);
				if (i > 0) sb.append(",");
				sb.append(s);
			}
			sb.append(") ");
		}
		
		if (StringUtils.isNotBlank(searchTourDepFilter.getCode()))
			sb.append("and (d.code like '%" + searchTourDepFilter.getCode() + "%') ");
		if (StringUtils.isNotBlank(searchTourDepFilter.getPackageDesc()))
			sb.append("and p.name_en like '%" + searchTourDepFilter.getPackageDesc() + "%' ");
		if (searchTourDepFilter.getFromDate() != null)
			sb.append("and DATE(d.dt_dep) >= DATE(:dtFrom) ");
		if (searchTourDepFilter.getToDate() != null)
			sb.append("and DATE(d.dt_dep) <= DATE(:dtTo) ");
		
		if (searchTourDepFilter.getNumDays() != null)
			sb.append("and date(d.dt_dep) < DATE_SUB(curdate(),INTERVAL -" + searchTourDepFilter.getNumDays() + " day) ");
		
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getTourStatusList())) {
			sb.append("and d.tour_status_cd in (");
			for (int i = 0; i < searchTourDepFilter.getTourStatusList().size(); i++) {
				String s = searchTourDepFilter.getTourStatusList().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		
		if (searchTourDepFilter.getQuantity() != null)
			sb.append("and ifnull(b.sumqty, 0) >= " + searchTourDepFilter.getQuantity() + " ");
		
		if (StringUtils.isNotBlank(searchTourDepFilter.getFullPmntStatus())) {
			if (CommonConstant.STATUS_CD_PENDING.equals(searchTourDepFilter.getFullPmntStatus())) {
				sb.append("and i.totalPaid != i.totalInv ");
			} else {
				sb.append("and i.totalPaid = i.totalInv ");
			}
		}
		
		if (StringUtils.isNotBlank(searchTourDepFilter.getPassportStatus())) {
			if (CommonConstant.STATUS_CD_PENDING.equals(searchTourDepFilter.getPassportStatus())) {
				sb.append("and i.totalValidPass != i.totalInv ");
			} else {
				sb.append("and i.totalValidPass = i.totalInv ");
			}
		}
		
		if (StringUtils.isNotBlank(searchTourDepFilter.getVisaStatus())) {
			if (CommonConstant.STATUS_CD_PENDING.equals(searchTourDepFilter.getVisaStatus())) {
				sb.append("and i.totalVisaCopies != i.totalInv ");
			} else {
				sb.append("and i.totalVisaCopies = i.totalInv ");
			}
		}
		
		if(searchTourDepFilter.isPersonalRecord()) {
			sb.append("and d.id_pic_user = " + searchTourDepFilter.getIdPicUser() + " ");
		}
		
		if(searchTourDepFilter.getIdPicSearch() != null) {
			sb.append("and d.id_pic_user = " + searchTourDepFilter.getIdPicSearch() + " ");
		}
		
		// Show Archive
		if(!searchTourDepFilter.isInactiveRecord()) {
			sb.append("and (if(i.totalPaid = i.totalInv, 'CP', 'PE') = 'PE' ");
			sb.append("or if(i.totalValidPass = i.totalInv, 'CP', 'PE') = 'PE' ");
			sb.append("or if(d.is_visa_required = 1, if(i.totalVisaCopies = i.totalInv, 'CP', 'PE'), 'CP') = 'PE') ");
		}
		
		sb.append("order by d.dt_dep ");
		
//		System.out.println(sb);
		
		Query query = createSQLQuery(sb.toString());
		if (searchTourDepFilter.getFromDate() != null)
			query.setDate("dtFrom", searchTourDepFilter.getFromDate());
		if (searchTourDepFilter.getToDate() != null)
			query.setDate("dtTo", searchTourDepFilter.getToDate());
		
		List<Object> results = query.list();
		List<TourDepartureVO> tourDepList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		
		Date today = new Date();
		long diffInMillies;
		long diff;
		boolean isPending = true;
		
		for (Object obj : results) {
			Object[] row = (Object[]) obj;
			vo = new TourDepartureVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setIdTourPkg(((BigInteger) row[1]).longValue());
			vo.setDtDep((Date) row[2]);
			vo.setNameEn(row[3].toString());
			vo.setCode(row[4].toString());
			vo.setNumDays(Integer.parseInt(row[5].toString()));
			vo.setNumNights(Integer.parseInt(row[6].toString()));
			
			vo.setSeatAllot(Integer.parseInt(row[7].toString()));
			vo.setQuantity(Integer.parseInt(row[8].toString()));
			vo.setStatusCode(row[9].toString());
			vo.setTourStatusCd(row[10].toString());
			
			vo.setTotalGA(Integer.parseInt(row[11].toString()));
			vo.setTotalInvPaid(Integer.parseInt(row[12].toString()));
			vo.setTotalInv(Integer.parseInt(row[13].toString()));
			vo.setFullPmntStatus(row[14].toString());
			
			vo.setTotalValidPassport(Integer.parseInt(row[15].toString()));
			vo.setPassportStatus(row[16].toString());
			vo.setTotalVisaCopies(Integer.parseInt(row[17].toString()));
			vo.setVisaStatus(row[18].toString());
			vo.setIdPicUser(row[19] != null ? ((BigInteger) row[19]).longValue() : null);
			if(row[20] != null ) vo.setPicName(row[20].toString());
			if(row[21] != null ) vo.setValidPassInvNo(row[21].toString());
			if(row[22] != null ) vo.setVisaCopiesInvNo(row[22].toString());
			if(row[23] != null ) vo.setTotalUnpaidInvNo(row[23].toString());
			if(row[24] != null ) vo.setDeadline(Integer.parseInt(row[24].toString())); else vo.setDeadline(0);
			if(row[25] != null ) vo.setIsVisaRequired((Boolean) row[25]); else vo.setIsVisaRequired(false);
			vo.setDtDeadline((Date) row[26]);
			
			String copyPaste = vo.getCode();
			if(row[27] != null) copyPaste += "[BR]" + "FULL PAYMENT:[BR]" + row[27].toString();
			if(row[34] != null) copyPaste += "[BR]" + "IN-REVIEW:[BR]" + row[34].toString();
			if(row[28] != null) copyPaste += "[BR]" + "PASSPORT COPY:[BR]" + row[28].toString();
			if(row[29] != null && vo.getIsVisaRequired()) copyPaste += "[BR]" + "VISA:[BR]" + row[29].toString();
			vo.setCopyPasteDetails(copyPaste);
			
			// Set OP Person In Charge
			if(row[30] != null) {
				vo.setOpPic(row[30].toString());
				
				List<String>  opPicList = new ArrayList<String>();
				if (StringUtils.isNotEmpty(vo.getOpPic())) {
					opPicList = Arrays.asList(vo.getOpPic().replaceAll(",$", "").split(",", -1));
				}
				
				if (CollectionUtils.isNotEmpty(opPicList) && CollectionUtils.isNotEmpty(employeeList)) {
					for (String pic : opPicList) {
						for (EmployeeViewVO emp : employeeList) {
							if (emp.getId().longValue() == Long.parseLong(pic)) {
								if (StringUtils.isEmpty(vo.getOpPicName())) {
									vo.setOpPicName(emp.getUserVO().getName());
								} else {
									vo.setOpPicName(vo.getOpPicName() + ", " + emp.getUserVO().getName());
								}
								break;
							}
						}
					}
				}
			}
			
			diffInMillies = Math.abs(vo.getDtDep().getTime() - today.getTime());
			diff = TimeUnit.DAYS.convert(diffInMillies, TimeUnit.MILLISECONDS);
			isPending = CommonConstant.STATUS_CD_PENDING.equals(vo.getFullPmntStatus()) || CommonConstant.STATUS_CD_PENDING.equals(vo.getPassportStatus()) ||
						(vo.getIsVisaRequired() && CommonConstant.STATUS_CD_PENDING.equals(vo.getVisaStatus()));
			
			if(row[31] != null && "2".equals(row[31].toString())) {
				vo.setGroupColor(4);
			} else if (diff <= 21 && isPending) {
				vo.setGroupColor(3);
			} else if (diff <= 30 && isPending) {
				vo.setGroupColor(2);
			} else if (diff <= 45 && isPending) {
				vo.setGroupColor(1);
			}
			
			if (row[32] != null)	vo.setTotalOpenedDoc(Integer.parseInt(row[32].toString()));
			if (row[33] != null)	vo.setTotalOpenedDocNo((row[33].toString()));
			
			tourDepList.add(vo);
		}
		return tourDepList;
	}
	
	@Override
	public void saveTourDepSalesSupp(TourDepartureVO tourDepartureVO) throws BusinessException {
		Query query = createQuery("UPDATE TourDepartureVO SET id_pic_user = :idPicUser WHERE id = :id");
		query.setParameter("idPicUser", tourDepartureVO.getIdPicUser());
		query.setParameter("id", tourDepartureVO.getId());
		query.executeUpdate();
	}

	@Override
	public TourPackageItineryVO getTourPackageItineraryVOByCode(Long tourPkgId, Long idTourPkgDailyCms) throws BusinessException {
		StringBuilder sb = new StringBuilder();
	    sb.append("SELECT tpi.id, tpi.id_tour_pkg, tpi.id_tour_pkg_daily_itinerary, tpi.name, tpi.path, tpi.lang_cd, tpi.type_cd ");
	    sb.append("FROM tour_pkg_itinery tpi ");
	    sb.append("LEFT JOIN tour_pkg_daily_itinerary tpdi ON tpi.id_tour_pkg_daily_itinerary = tpdi.id ");
	    sb.append("WHERE tpdi.id_tour_pkg = :tourPkgId and tpi.id_tour_pkg_daily_itinerary = :idTourPkgDailyCms ");
	    sb.append("AND tpi.type_cd = :typeCd ");

	    SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
	    query.setParameter("tourPkgId", tourPkgId);
	    query.setParameter("idTourPkgDailyCms", idTourPkgDailyCms);
	    query.setParameter("typeCd", ProductConstant.TYPE_CUST);

	    Object[] result = (Object[]) query.uniqueResult();
	    if (result != null) {
	    	TourPackageItineryVO tourPackageItineryVO = new TourPackageItineryVO();
	    	if(result[0] != null ) tourPackageItineryVO.setId(Long.valueOf((Integer) result[0]));
	    	if(result[1] != null ) tourPackageItineryVO.setIdTourPkg(((BigInteger) result[1]).longValue());
	    	if(result[2] != null ) tourPackageItineryVO.setIdTourPkgDailyItinerary(((BigInteger) result[2]).longValue());
	    	if(result[3] != null ) tourPackageItineryVO.setName((String) result[3]);
	    	if(result[4] != null ) tourPackageItineryVO.setPath((String) result[4]);
	    	if(result[5] != null ) tourPackageItineryVO.setLangCd((String) result[5]);
	    	if(result[6] != null ) tourPackageItineryVO.setTypeCd((String) result[6]);
	    	
	    	return tourPackageItineryVO;
	    } else {
	    	return null;
	    }
	}
	

