	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getTourAcctCdStatusCd(com.bcs.zsg.product.vo.TourDepartureVO, com.bcs.zsg.maintenance.vo.CompanyVO)
	 */
	@Override
	public String getTourAcctCdStatusCd(TourDepartureVO tourDepVO, CompanyVO companyVO) throws BusinessException {
		Criteria criteria = createCriteria(TourDepItemVO.class);
		criteria.setProjection(Projections.projectionList().add(Projections.rowCount()));
		criteria.add(Restrictions.eq("idTourDep", tourDepVO.getId()));
		criteria.add(Restrictions.eq("companyVO", companyVO));
		long rowCount = (long) criteria.uniqueResult();
		
		if (rowCount == 0) return ProductConstant.TOUR_DEP_STATUS_CD_PENDING;
		else {
			criteria = createCriteria(TourDepItemVO.class);
			criteria.add(Restrictions.eq("idTourDep", tourDepVO.getId()));
			criteria.add(Restrictions.eq("companyVO", companyVO));
			//criteria.add(Restrictions.ne("amount", 0.0));
			criteria.add(Restrictions.isNull("acctId"));
			criteria.setMaxResults(1);
			return (criteria.uniqueResult() == null) ? ProductConstant.TOUR_DEP_STATUS_CD_COMPLETED : ProductConstant.TOUR_DEP_STATUS_CD_PENDING;
		}
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getTourPackageById(java.lang.Long)
	 */
	@Override
	public TourThemeVO getTourThemeById(Long idTourTheme) throws BusinessException {
		Criteria criteria = createCriteria(TourThemeVO.class);
		criteria.add(Restrictions.eq("id", idTourTheme));
		return (TourThemeVO) criteria.uniqueResult();
	}

	@Override
	public TourCatVO getTourCatById(Long idTourCat) throws BusinessException {
		Criteria criteria = createCriteria(TourCatVO.class);
		criteria.add(Restrictions.eq("id", idTourCat));
		return (TourCatVO) criteria.uniqueResult();
		
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#insertTourDepHistory(java.lang.Long, java.lang.String, java.lang.String)
	 */
	@Override
	public void insertTourDepHistory(Long id, String actionCdDel, String reason) throws BusinessException {
		Query query = createSQLQuery("CALL prc_tour_dep(:p_id, :p_action, :p_reason)");
		query.setParameter("p_id", id);
		query.setParameter("p_action", actionCdDel);
		query.setParameter("p_reason", reason);
		query.executeUpdate();
	}
	
	@Override
	public void insertTourPkgHistory(Long id, String actionCdDel, String reason) throws BusinessException {
		Query query = createSQLQuery("CALL prc_tour_pkg(:p_id, :p_action, :p_reason)");
		query.setParameter("p_id", id);
		query.setParameter("p_action", actionCdDel);
		query.setParameter("p_reason", reason);
		query.executeUpdate();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getAvailableTourDepList(java.lang.Long, boolean, com.bcs.zsg.sales.vo.BookingVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getAvailableTourDepList(Long idCompany, InvoiceVO invoiceVO) throws BusinessException {
		Query query = null;
		StringBuilder sb = new StringBuilder();
		
		if (invoiceVO != null && invoiceVO.isDateInFinPeriodClosed()) {
			sb.append("SELECT d.id, d.dt_dep, d.code, d.description, d.num_days, d.num_nights, d.seat_allotment, d.reserved_seat, d.tour_mgr_pax, p.name_en, p.name_zh, p.name_other, cc.quantity, d.tour_status_cd ").
			append("FROM tour_dep d JOIN (").
				append("SELECT tp.id, tp.name_en, tp.name_zh, tp.name_other FROM tour_pkg tp, tour_dep td WHERE tp.id = td.id_tour_pkg AND td.status_cd = 'AC' AND td.id = ?").
			append(") p ON d.id_tour_pkg = p.id ").
			append("LEFT JOIN (").
				append("SELECT SUM(c.quantity) AS 'quantity', b.id_tour_dep FROM tour_booking_charge_item c LEFT JOIN (").
					append("SELECT id, id_tour_dep, pmnt_status_cd FROM tour_booking WHERE status_cd NOT IN ('CC', 'VD')").
				append(") b ON b.pmnt_status_cd <> 'KIVEXP' ").
				append("WHERE c.id_tour_booking = b.id AND c.code LIKE 'FT%' AND c.code <> 'FT_INFT' group by b.id_tour_dep ").
			append(") cc on cc.id_tour_dep = d.id ").
			append("WHERE d.status_cd = 'AC' AND d.tour_status_cd NOT IN ('F', 'I', 'R', 'N', 'C') AND ").
			append("d.id NOT IN (SELECT id FROM tour_dep WHERE id NOT IN (SELECT DISTINCT id_tour_dep FROM tour_dep_item WHERE id_company = ?) OR ").
			append("d.id IN (SELECT DISTINCT id_tour_dep FROM tour_dep_item WHERE id_acct IS NULL AND id_company = ?))").
			append(" ORDER BY d.dt_dep, d.num_days");
			
			query = createSQLQuery(sb.toString());
			query.setParameter(0, invoiceVO.getTourDepId());
			query.setParameter(1, idCompany);
			query.setParameter(2, idCompany);
			
		} else {
			sb.append("SELECT d.id, d.dt_dep, d.code, d.description, d.num_days, d.num_nights, d.seat_allotment, d.reserved_seat, d.tour_mgr_pax, p.name_en, p.name_zh, p.name_other, cc.quantity, d.tour_status_cd ").
				append("FROM tour_dep d JOIN tour_pkg p ").
				append("LEFT JOIN (").
					append("SELECT SUM(c.quantity) AS 'quantity', b.id_tour_dep FROM tour_booking_charge_item c ").
					append("LEFT JOIN (SELECT id, id_tour_dep, pmnt_status_cd FROM tour_booking WHERE status_cd NOT IN ('CC', 'VD')) b ON b.pmnt_status_cd <> 'KIVEXP' ").
					append("WHERE c.id_tour_booking = b.id AND c.code LIKE 'FT%' AND c.code <> 'FT_INFT' group by b.id_tour_dep").
				append(") cc on cc.id_tour_dep = d.id ").
				append("WHERE d.id_tour_pkg = p.id AND d.status_cd = 'AC' AND d.tour_status_cd NOT IN ('F', 'I', 'R', 'N', 'C') AND ").
				append("d.id NOT IN (SELECT id FROM tour_dep WHERE id NOT IN (SELECT DISTINCT id_tour_dep FROM tour_dep_item WHERE id_company = ?) OR id IN (SELECT DISTINCT id_tour_dep FROM tour_dep_item WHERE id_acct IS NULL AND id_company = ?)) ").
				append("ORDER BY d.dt_dep, d.num_days");
			
			query = createSQLQuery(sb.toString());
			query.setParameter(0, idCompany);
			query.setParameter(1, idCompany);
		}
		List<Object> results = query.list();
		List<TourDepartureVO> list = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		
		if (CollectionUtils.isNotEmpty(results)) {
			for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				vo = new TourDepartureVO();
				vo.setId(((BigInteger) row[0]).longValue());
				vo.setDtDep((Date) row[1]);
				vo.setCode((String) row[2]);
				vo.setDesc((String) row[3]);
				vo.setNumDays(((Short) row[4]).intValue());
				vo.setNumNights(((Short) row[5]).intValue());
				vo.setSeatAllot(((Short) row[6]).intValue());
				vo.setReservedSeat(((Short) row[7]).intValue());
				vo.setTourManagerPax(((Short) row[8]).intValue());
				vo.setNameEn((String) row[9]);
				vo.setNameZh((String) row[10]);
				vo.setNameOther((String) row[11]);
				vo.setQuantity((row[12] == null) ? 0 : ((BigDecimal) row[12]).intValue());
				vo.setTourStatusCd((String) row[13]);
				if (vo.getSeatAllot().intValue() == 0) list.add(vo);
				else if (vo.getSeatAllot() > (vo.getReservedSeat() + vo.getTourManagerPax() + vo.getQuantity())) list.add(vo);
			}
		}
		return list;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#isTourThemeAvailable(com.bcs.zsg.product.vo.TourThemeVO)
	 */
	@Override
	public boolean isTourThemeAvailable(TourThemeVO tourThemeVO) throws BusinessException {
		Criteria criteria = createCriteria(TourThemeVO.class);
		criteria.add(Restrictions.eq("idTourCat", tourThemeVO.getIdTourCat()));
		if (tourThemeVO.getIdParent() == null) criteria.add(Restrictions.isNull("idParent"));
		else criteria.add(Restrictions.eq("idParent", tourThemeVO.getIdParent()));
		criteria.add(Restrictions.eq("desc", tourThemeVO.getDesc()));
		criteria.add(Restrictions.eq("statusCode", CommonConstant.STATUS_CD_ACTIVE));
		criteria.setMaxResults(1);
		return (criteria.uniqueResult() == null) ? true : false;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#updateTourDepsDiscount(com.bcs.zsg.product.vo.TourPackageVO)
	 */
	@Override
	public void updateTourDepsDiscount(TourPackageVO tourPkgVO) throws BusinessException {
		Query query = createQuery("UPDATE TourDepartureVO SET tfairDiscount = :discount WHERE idTourPkg = :idTourPkg");
		query.setParameter("discount", tourPkgVO.getTfairDiscount());
		query.setParameter("idTourPkg", tourPkgVO.getId());
		query.executeUpdate();
		
		query = createQuery("UPDATE TourDepItemVO SET amount = :amount WHERE idTourDep IN (SELECT d.id FROM TourDepartureVO d, TourPackageVO p WHERE p.id = :idTourPkg AND d.idTourPkg = p.id) AND code = :code");
		query.setParameter("amount", -tourPkgVO.getTfairDiscount());
		query.setParameter("idTourPkg", tourPkgVO.getId());
		query.setParameter("code", ProductConstant.TOUR_DEP_ITM_CD_DISC);
		query.executeUpdate();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#isInvEOIssued(com.bcs.zsg.product.vo.TourDepartureVO, com.bcs.zsg.sales.vo.BookingVO)
	 */
	@Override
	public boolean isInvEOIssued(TourDepartureVO tourDepVO, BookingVO bookingVO) throws BusinessException {
		Criteria criteria = createCriteria(InvoiceVO.class);
		if (bookingVO == null) criteria.add(Restrictions.eq("tourDepId", tourDepVO.getId()));
		else criteria.add(Restrictions.eq("bookingId", bookingVO.getId()));
		criteria.setMaxResults(1);
		if (criteria.uniqueResult() != null) return true;
		
		if (bookingVO == null) {
			criteria = createCriteria(ExOrderVO.class);
			criteria.add(Restrictions.eq("tourId", tourDepVO.getId()));
			criteria.setMaxResults(1);
			if (criteria.uniqueResult() != null) return true;
		}
		return false;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#isTourStatusFull(java.lang.Long)
	 */
	@Override
	public void updateTourStatusFull(Long idTourDep) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		sb.append("UPDATE tour_dep d SET d.tour_status_cd = 'F'");
		sb.append(" WHERE d.status_cd = 'AC' AND (d.tour_status_cd = 'A' or d.tour_status_cd = 'L' or d.tour_status_cd = 'F') AND d.seat_allotment > 0 and d.id=? AND");
		sb.append(" d.seat_allotment <= (d.reserved_seat + d.tour_mgr_pax +");
		sb.append(" (SELECT case when SUM(c.quantity) is null then 0 else sum(c.quantity) end FROM tour_booking_charge_item c");
		sb.append(" LEFT JOIN (");
		sb.append(" SELECT id, id_tour_dep, pmnt_status_cd FROM tour_booking WHERE status_cd NOT IN ('CC', 'VD')");
		sb.append(" ) b ON b.pmnt_status_cd <> 'KIVEXP'");
		sb.append(" WHERE b.id_tour_dep = d.id AND c.id_tour_booking = b.id AND c.code LIKE 'FT%' AND c.code <> 'FT_INFT')");
		sb.append(" )");
		
		Query query = createSQLQuery(sb.toString());
		query.setParameter(0, idTourDep);
		query.executeUpdate();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#updateTourStatus(java.lang.String, java.lang.Long)
	 */
	@Override
	public void updateTourStatus(String tourStatusCd, Long idTourDep) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		sb.append("SELECT CASE WHEN SUM(c.quantity) IS NULL THEN 0 ELSE SUM(c.quantity) END ");
		sb.append("FROM tour_booking_charge_item c, tour_booking b ");
		sb.append("WHERE b.id_tour_dep = :idTourDep AND b.pmnt_status_cd != 'KIVEXP' AND b.status_cd != 'CC' AND b.status_cd != 'VD' ");
		sb.append("AND c.id_tour_booking = b.id AND c.code LIKE 'FT%' AND c.code != 'FT_INFT' ");
		
		Query query = createSQLQuery(sb.toString());
		query.setParameter("idTourDep", idTourDep);
		
		int totalQty = ((Number) query.uniqueResult()).intValue();
		System.out.println("###############totalQty: " + totalQty);
		
		sb = new StringBuilder();
		sb.append("UPDATE tour_dep d SET d.tour_status_cd = :tourStatusCd");
		sb.append(" WHERE d.status_cd = 'AC' AND ");
		if(ProductConstant.TOUR_STATUS_CD_LIMITED.equals(tourStatusCd)) {
			int limitedSeatAllotment = Integer.parseInt(LookupItemUtils.getGlobalConfigValue(MaintConstant.GLOBAL_CD_GLOBAL, MaintConstant.GLOBAL_CD_SEAT_ALLOTMENT_LIMITED_STATUS));
			if (limitedSeatAllotment == 0) return;
			
			sb.append("(d.tour_status_cd = 'A' or d.tour_status_cd = 'C1') AND d.id = :idTourDep AND (").append(limitedSeatAllotment).append(" >= d.seat_allotment-");
			sb.append(" (d.reserved_seat + d.tour_mgr_pax + ").append(totalQty).append("))");
		} else if (ProductConstant.TOUR_STATUS_CD_FULL.equals(tourStatusCd)) {
			sb.append("(d.tour_status_cd = 'A' OR d.tour_status_cd = 'L') AND d.seat_allotment > 0 and d.id = :idTourDep AND d.seat_allotment <=");
			sb.append(" (d.reserved_seat + d.tour_mgr_pax + ").append(totalQty).append(")");
		} else {
			sb.append("d.tour_status_cd = 'F' AND d.seat_allotment > 0 and d.id = :idTourDep AND d.seat_allotment >");
			sb.append(" (d.reserved_seat + d.tour_mgr_pax + ").append(totalQty).append(")");
		}
		
		query = createSQLQuery(sb.toString());
		query.setParameter("tourStatusCd", tourStatusCd);
		query.setParameter("idTourDep", idTourDep);
		query.executeUpdate();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#isSubThemeAvailable(com.bcs.zsg.product.vo.TourThemeVO)
	 */
	@Override
	public boolean isSubThemeAvailable(TourThemeVO bakTourThemeVO) throws BusinessException {
		Criteria criteria = createCriteria(TourThemeVO.class);
		criteria.add(Restrictions.eq("statusCode", CommonConstant.STATUS_CD_ACTIVE));
		criteria.add(Restrictions.eq("idParent", bakTourThemeVO.getId()));
		criteria.setMaxResults(1);
		return (criteria.uniqueResult() == null) ? false : true;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getTourDepListWithPush(com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getTourDepListWithPush(SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT ").
			append("d.id, d.dt_dep, d.tour_status_cd, d.code AS 'tourcode', d.num_days, d.num_nights, d.description, ").
			append("d.is_deposit_paid, d.is_issued_s, d.is_issued_f, d.is_push, d.tfair_discount, d.prn, ").
			append("d.seat_allotment, d.tour_mgr_pax, d.reserved_seat, d.full_twn, d.full_sgl, d.full_ctw, d.full_ceb, d.full_cnb, ").
			append("d.grnd_twn, d.grnd_sgl, d.grnd_ctw, d.grnd_ceb, d.grnd_cnb, d.cna_adt, d.csi_adt, d.misc_adt, d.misc_chd, a.code AS 'airline', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 't_fair%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'tfairpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'agent%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'agentpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'in_house%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'inhousepax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'online_booking%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'on9bookingpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'BK' and b.pmnt_status_cd = 'KIV' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'kivpax', ").
			append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
			append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and (b.status_cd = 'CF' or (b.status_cd = 'BK' and pmnt_status_cd = 'KIV')) and i.code in ('GA_SGL', 'GA_TWN', 'GA_CTW', 'GA_CWB', 'GA_CNB', 'GA_INFT')) AS 'ga', d.tour_pkg_daily_cms, ").
			append("d.id_tour_pkg, p.name_en, p.name_zh, p.name_other, t1.description as 'countryName', p.num_days as 'pdays', p.num_nights as 'pnights', ").
			append("d.travel_ins_policy_s, d.travel_ins_policy_f, d.lang_cd, d.is_private_tour, d.private_pic, p.deposit, ").
			append("c.code as 'cruise', tc.type_cd ").

			append("FROM tour_dep d ").
			append("JOIN tour_pkg p ON d.id_tour_pkg = p.id ").
			append("LEFT JOIN airline a ON d.id_airline = a.id ").
			append("LEFT JOIN cruise c ON d.id_cruise = c.id ").
			append("JOIN tour_theme t ON p.id_tour_theme = t.id ").
			append("JOIN tour_cat tc ON t.id_tour_cat = tc.id ").
			append("JOIN tour_theme t1 ON t.id_parent = t1.id ").
			
			append("where d.is_push = 1 and d.status_cd = :statusCode and (d.tour_status_cd = 'A' or d.tour_status_cd = 'L') ").
			append("and d.id_tour_pkg = p.id ").
			append("and t.id_parent = t1.id ").
			append("and p.id_tour_theme = t.id ").
			append("and d.id_airline is not null ");
		
			//append("and t.id_tour_cat = :idTourCat ").
		
		if (searchParamVO.getFromDate() != null) {
			sb.append("and d.dt_dep >= :fromDate ");
			if (searchParamVO.getToDate() != null) sb.append("and d.dt_dep <= :toDate ");
		}
		sb.append("order by t1.description, t.description, p.num_days, d.dt_dep, d.code");
		
		Query query = createSQLQuery(sb.toString());
		query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
		//query.setString("idTourCat", (String) searchParamVO.getObj2());
		if (searchParamVO.getFromDate() != null) {
			query.setDate("fromDate", searchParamVO.getFromDate());
			if (searchParamVO.getToDate() != null) query.setDate("toDate", searchParamVO.getToDate());
		}
		List<Object> results = query.list();
		List<TourDepartureVO> tourDepList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new TourDepartureVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setDtDep((Date) row[1]);
			vo.setTourStatusCd((String) row[2]);
			vo.setCode((String) row[3]);
			vo.setNumDays(((Short) row[4]).intValue());
			vo.setNumNights(((Short) row[5]).intValue());
			vo.setDesc(row[6] == null ? null : (String) row[6]);
			vo.setIsDepositPaid((Boolean) row[7]);
			vo.setIsIssuedS((Boolean) row[8]);
			vo.setIsIssuedF((Boolean) row[9]);
			vo.setIsPush((Boolean) row[10]);
			//vo.setTfairDiscount((Double) row[11]);
			vo.setPrn(row[12] == null ? null : (String) row[12]);
			vo.setSeatAllot(((Short) row[13]).intValue());
			vo.setTourManagerPax(((Short) row[14]).intValue());
			vo.setReservedSeat(((Short) row[15]).intValue());
			vo.setFullTwn((Double) row[16]);
			vo.setFullSgl((Double) row[17]);
			vo.setFullCtw((Double) row[18]);
			vo.setFullCeb((Double) row[19]);
			vo.setFullCnb((Double) row[20]);
			vo.setGrndTwn((Double) row[21]);
			vo.setGrndSgl((Double) row[22]);
			vo.setGrndCtw((Double) row[23]);
			vo.setGrndCeb((Double) row[24]);
			vo.setGrndCnb((Double) row[25]);
			vo.setCnaAdt((Double) row[26]);
			vo.setCsiAdt((Double) row[27]);
			vo.setMiscAdt((Double) row[28]);
			vo.setMiscChd((Double) row[29]);
			vo.setAirlineCode((String) row[30]);
			vo.setTfairPax(((BigDecimal) row[31]).intValue());
			vo.setAgentPax(((BigDecimal) row[32]).intValue());
			vo.setInHsePax(((BigDecimal) row[33]).intValue());
			vo.setOn9BookingPax(((BigDecimal) row[34]).intValue());
			vo.setKivPax(((BigDecimal) row[35]).intValue());
			vo.setTotalGA(((BigDecimal) row[36]).intValue());
			vo.setTourPkgDailyCms(row[37] !=null ? ((BigInteger) row[37]).longValue() : null);
			vo.setIdTourPkg(((BigInteger) row[38]).longValue());
			vo.setNameEn((String) row[39]);
			vo.setNameZh((String) row[40]);
			vo.setNameOther((String) row[41]);
			vo.setCountryName((String) row[42]);
			vo.setPackageDays(((Short) row[43]).intValue());
			vo.setPackageNights(((Short) row[44]).intValue());
			
			if (StringUtils.isNotBlank(row[45] != null ? row[45].toString() : "")) {
				vo.setTravelInsS(true);
			}
			if (StringUtils.isNotBlank(row[46] != null ? row[46].toString() : "")) {
				vo.setTravelInsF(true);
			}
			vo.setLangCode((String) row[47]);
			vo.setIsPrivateTour(row[48] != null ? ((Boolean) row[48]) : false);
			vo.setPrivatePic(row[49] != null ? row[49].toString() : "");
			vo.setDeposit((Double) row[50]);
			vo.setCruiseCode((String) row[51]);
			vo.setTypeCd((String) row[52]);
			
			// Tour Departure Discount
			vo.setTourDepartureDiscountVOList(getTourDepDiscount(vo.getId()));
			
			vo.setTfairDiscount(0.00);
			vo.setDiscount1(0.00);
			vo.setDiscount2(0.00);
			if (CollectionUtils.isNotEmpty(vo.getTourDepartureDiscountVOList())) {
				int count = 1;
				
				for (TourDepartureDiscountVO discountVO : vo.getTourDepartureDiscountVOList()) {
					double discountAmt = discountVO.getDiscountAmt();
					int discountPax = discountVO.getDiscountPax();
					
					if (count == 1) {
						vo.setDiscount1(discountAmt);
						vo.setDiscountPax1(discountPax);
					} else if (count == 2) {
						vo.setDiscount2(discountAmt);
						vo.setDiscountPax2(discountPax);
					}
					count++;
				}
			}
			
			tourDepList.add(vo);
		}
		return tourDepList;
	}
	
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getTourDepListWithPush(com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<String> getTourDepSeason(Long idTourDep) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT id_tour_dep, season FROM tour_dep_season WHERE id_tour_dep = :idTourDep ");
		
		Query query = createSQLQuery(sb.toString());
		query.setLong("idTourDep", idTourDep);
		List<Object> results = query.list();
		List<String> seasonList = new ArrayList<String>();
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			seasonList.add((String) row[1]);
		}
		return seasonList;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#updateTourStatus(java.lang.String, java.lang.Long)
	 */
	@Override
	public void updateTourDepSeason(Long idTourDep, List<String> seasonList) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		sb = new StringBuilder();
		sb.append("DELETE FROM tour_dep_season WHERE id_tour_dep = :idTourDep ");
		Query query = createSQLQuery(sb.toString());
		query.setParameter("idTourDep", idTourDep);
		query.executeUpdate();
		
		sb = new StringBuilder();
		sb.append("INSERT INTO tour_dep_season (id_tour_dep, season) ");
		sb.append(" VALUES ");
		int i = 1;
		for (String str : seasonList) {
			if (i != 1) {
				sb.append(", ");
			}
			sb.append("(:idTourDep, '" + str + "') ");
			i ++;
		}
		
		query = createSQLQuery(sb.toString());
		query.setParameter("idTourDep", idTourDep);
		query.executeUpdate();
	}

