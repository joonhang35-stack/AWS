	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getTourThemeList(com.bcs.zsg.common.vo.SearchParamVO, java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<TourThemeVO> getTourThemeList(SearchParamVO searchParamVO, Long idParent) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT ").
			append("tt.id, tt.id_tour_cat, tt.id_acct, tt.id_country, tt.id_parent, tt.description, tt.remarks, ").
			append("tt.img_path, tt.seq, tt.status_cd, ").
			append("tt.dt_created, tt.created_by, tt.dt_upd, tt.upd_by, ").
			append("( ").
				append("SELECT GROUP_CONCAT(c.name ORDER BY c.name ASC SEPARATOR ', ') ").
				append("FROM tour_theme_country ttc LEFT JOIN country c ON ttc.id_country = c.id ").
				append("WHERE tt.id = ttc.id_tour_theme ").
			append(") AS countriesName ").
		append("FROM tour_theme tt ").
		append("WHERE tt.status_cd = :statusCode ");
		
		if (searchParamVO.getObj2() != null) {
			sb.append("AND tt.id_tour_cat = " + Long.parseLong((String) searchParamVO.getObj2()) + " ");
		}
		
		if (searchParamVO.getObj3() != null && StringUtils.equals("seqNo", (String) searchParamVO.getObj3())) {
			sb.append("AND tt.seq > 0 ");
		}
		
		if (idParent == null) {
			sb.append("AND tt.id_parent IS NULL ");
		} else {
			sb.append("AND tt.id_parent = " + idParent + " ");
		}
		
		sb.append("ORDER BY tt.seq, tt.description ");
		
		Query query = createSQLQuery(sb.toString());
		query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
		List<Object> results = query.list();
		List<TourThemeVO> tourThemeList = new ArrayList<TourThemeVO>();
		TourThemeVO vo;
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new TourThemeVO();
			vo.setId(Long.parseLong(row[0].toString()));
			vo.setIdTourCat(Long.parseLong(row[1].toString()));
			if(row[2] != null ) vo.setIdAcct(Long.parseLong(row[2].toString()));
			if(row[3] != null ) vo.setIdCountry(Long.parseLong(row[3].toString()));
			if(row[4] != null ) vo.setIdParent(Long.parseLong(row[4].toString()));
			vo.setDesc((String) row[5]);
			vo.setRemarks((String) row[6]);
			vo.setImgPath((String) row[7]);
			if (row[8] != null) vo.setSeq(Integer.parseInt(row[8].toString()));
			vo.setStatusCode((String) row[9]);
			vo.setCreatedDate((Date) row[10]);
			vo.setCreatedBy((String) row[11]);
			vo.setUpdatedDate((Date) row[12]);
			vo.setUpdatedBy((String) row[13]);
			vo.setCountriesName((String) row[14]);
			tourThemeList.add(vo);
		}
		return tourThemeList;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getTourPkgViewList(com.bcs.zsg.product.vo.TourThemeVO, java.lang.String)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<TourPackageVO> getTourPkgViewList(TourThemeVO tourThemeVO, String year) throws BusinessException {
		Criteria criteria = createCriteria(TourPackageVO.class);
		criteria.add(Restrictions.eq("idTourTheme", tourThemeVO.getId()));
		criteria.add(Restrictions.eq("statusCode", CommonConstant.STATUS_CD_ACTIVE));
		if (year != null) criteria.add(Restrictions.eq("year", year));
		criteria.addOrder(Order.asc("seq"));
		criteria.addOrder(Order.asc("numDays"));
		return criteria.list();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#getSpecTourThemeList(com.bcs.zsg.product.vo.TourThemeVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<TourThemeVO> getSpecTourThemeList(TourThemeVO tourThemeVO) throws BusinessException {
		Criteria criteria = createCriteria(TourThemeVO.class);
		criteria.add(Restrictions.eq("statusCode", CommonConstant.STATUS_CD_ACTIVE));
		criteria.add(Restrictions.eq("idParent", tourThemeVO.getId()));
		return criteria.list();
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<TourThemeVO> getTourThemeList(Map<String, Object> params) throws BusinessException {
//		List<Long> idTourCatList = (List<Long>) params.get("idTourCatList");
		List<Long> idTourCatList = new ArrayList<Long>();
		
		if (params.get("idTourCatList") != null) {
			for(String s : (List<String>) params.get("idTourCatList")) idTourCatList.add(Long.valueOf(s));
		}
		
		Criteria criteria = createCriteria(TourThemeVO.class);
		criteria.add(Restrictions.eq("statusCode", CommonConstant.STATUS_CD_ACTIVE));
		criteria.add(Restrictions.in("idTourCat", idTourCatList));
		criteria.add(Restrictions.isNull("idParent"));
		return criteria.list();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#isChildThemeAppear(java.lang.Long)
	 */
	@Override
	public boolean isChildThemeExisted(Long id) throws BusinessException {
		Criteria criteria = createCriteria(TourThemeVO.class);
		criteria.add(Restrictions.eq("idParent", id));
		criteria.add(Restrictions.eq("statusCode", CommonConstant.STATUS_CD_ACTIVE));
		criteria.setMaxResults(1);
		return (criteria.uniqueResult() == null) ? false : true;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#isPkgAppear(java.lang.Long)
	 */
	@Override
	public boolean isTourPkgExisted(Long id) throws BusinessException {
		Criteria criteria = createCriteria(TourPackageVO.class);
		criteria.add(Restrictions.eq("idTourTheme", id));
		criteria.add(Restrictions.eq("statusCode", CommonConstant.STATUS_CD_ACTIVE));
		criteria.add(Restrictions.ge("year", yearFormat.format(new Date())));
		criteria.setMaxResults(1);
		return (criteria.uniqueResult() == null) ? false : true;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.dao.TourPackageDAO#isTourDepExisted(com.bcs.zsg.product.vo.TourDepartureVO, java.lang.Long)
	 */
	@Override
	public boolean isTourDepExisted(TourDepartureVO tourDepVO, Long idTourPkg) throws BusinessException {
		Criteria criteria = createCriteria(TourDepartureVO.class);
		if (tourDepVO != null) {
			criteria.add(Restrictions.eq("code", tourDepVO.getCode()));
			criteria.add(Restrictions.eq("dtDep", tourDepVO.getDtDep()));
		}
		if (idTourPkg != null) criteria.add(Restrictions.eq("idTourPkg", idTourPkg));
		criteria.add(Restrictions.eq("statusCode", CommonConstant.STATUS_CD_ACTIVE));
		criteria.setMaxResults(1);
		return (criteria.uniqueResult() == null) ? false : true;
	}
	
