		Criteria criteria = createCriteria(TourDepartureViewVO.class);
		criteria.add(Restrictions.eq("statusCode", CommonConstant.STATUS_CD_ACTIVE));
		criteria.add(Restrictions.ne("tourStatusCd", ProductConstant.TOUR_STATUS_CD_CLOSE));
		criteria.add(Restrictions.ne("tourStatusCd", ProductConstant.TOUR_STATUS_CD_NOT_OPT));
		criteria.add(Restrictions.ne("tourStatusCd", ProductConstant.TOUR_STATUS_CD_FULL));
		criteria.addOrder(Order.asc("dtDep"));
		criteria.addOrder(Order.asc("code"));
		return criteria.list();
	}
	
