	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getFilterTourDepListCruise(Date dtFrom, Date dtTo, String code, String title,
			Boolean filterInactiveRcrd, String filterTourStatusCd, Long idCompany) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT ").append(
				"d.id, d.id_tour_pkg, d.dt_dep, d.tour_status_cd, d.code AS 'tourcode', d.num_days, d.num_nights, d.description, ")
				.append("d.is_deposit_paid, d.is_issued_s, d.is_issued_f, d.is_push, d.tfair_discount, d.prn, ")
				.append("d.seat_allotment, d.tour_mgr_pax, d.reserved_seat, d.full_twn, d.full_sgl, d.full_ctw, d.full_ceb, d.full_cnb, ")
				.append("d.grnd_twn, d.grnd_sgl, d.grnd_ctw, d.grnd_ceb, d.grnd_cnb, d.cna_adt, d.csi_adt, d.misc_adt, d.misc_chd, a.code AS 'cruise', ")
				.append("d.tour_pkg_daily_cms, p.name_en, p.name_zh, p.name_other, ")
				.append("d.travel_ins_policy_s, d.travel_ins_policy_f, if(p.is_push_to_online=0, 0, d.is_push_to_online)  ")
				.append("from tour_dep d ")
				.append("LEFT JOIN tour_pkg p ON d.id_tour_pkg = p.id ")
				.append("LEFT JOIN cruise a ON d.id_cruise = a.id ")
				.append("where d.status_cd = :statusCode and p.type_cd = :typeCd ");
		if (StringUtils.isNotBlank(code))
			sb.append("and (d.code like :trCode) ");
		if (dtFrom != null && dtTo != null)
			sb.append("and DATE(d.dt_dep) between DATE(:dtFrom) and DATE(:dtTo) ");
		if (dtFrom != null)
			sb.append("and DATE(d.dt_dep) >= DATE(:dtFrom) ");
		if (dtTo != null)
			sb.append("and DATE(d.dt_dep) <= DATE(:dtTo) ");
		if (StringUtils.isNotBlank(title)) {
			sb.append(
					"and (CONCAT(IFNULL(p.name_en, ''), ' ', IFNULL(p.name_other, ''), ' ', IFNULL(p.name_zh, '')) like :pkgTitle) ");
		}
		if (StringUtils.isNotBlank(filterTourStatusCd)) {
			sb.append("and d.tour_status_cd = :tourStatusCd ");
		}
		sb.append("order by p.name_en, d.dt_dep");

		Query query = createSQLQuery(sb.toString());
		query.setString("typeCd", ProductConstant.TYPE_CRUISE);
		if (!filterInactiveRcrd) {
			query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
		} else {
			query.setString("statusCode", CommonConstant.STATUS_CD_INACTIVE);
		}
		if (StringUtils.isNotBlank(code))
			query.setString("trCode", "%" + code + "%");
		if (dtFrom != null && dtTo != null) {
			query.setDate("dtFrom", dtFrom);
			query.setDate("dtTo", dtTo);
		}
		if (dtFrom != null)
			query.setDate("dtFrom", dtFrom);
		if (dtTo != null)
			query.setDate("dtTo", dtTo);
		if (StringUtils.isNotBlank(title))
			query.setString("pkgTitle", "%" + title + "%");
		if (StringUtils.isNotBlank(filterTourStatusCd))
			query.setString("tourStatusCd", filterTourStatusCd);
		List<Object> results = query.list();
		List<TourDepartureVO> tourFilterDepList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;

		for (Iterator<Object> it = results.iterator(); it.hasNext();) {
			Object[] row = (Object[]) it.next();
			vo = new TourDepartureVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setIdTourPkg(((BigInteger) row[1]).longValue());
			vo.setDtDep((Date) row[2]);
			vo.setTourStatusCd((String) row[3]);
			vo.setCode((String) row[4]);
			vo.setNumDays(((Short) row[5]).intValue());
			vo.setNumNights(((Short) row[6]).intValue());
			vo.setDesc(row[7] == null ? null : (String) row[7]);
			vo.setIsDepositPaid((Boolean) row[8]);
			vo.setIsIssuedS((Boolean) row[9]);
			vo.setIsIssuedF((Boolean) row[10]);
			vo.setIsPush((Boolean) row[11]);
			vo.setTfairDiscount((Double) row[12]);
			vo.setPrn(row[13] == null ? null : (String) row[13]);
			vo.setSeatAllot(((Short) row[14]).intValue());
			vo.setTourManagerPax(((Short) row[15]).intValue());
			vo.setReservedSeat(((Short) row[16]).intValue());
			vo.setFullTwn((Double) row[17]);
			vo.setFullSgl((Double) row[18]);
			vo.setFullCtw((Double) row[19]);
			vo.setFullCeb((Double) row[20]);
			vo.setFullCnb((Double) row[21]);
			vo.setGrndTwn((Double) row[22]);
			vo.setGrndSgl((Double) row[23]);
			vo.setGrndCtw((Double) row[24]);
			vo.setGrndCeb((Double) row[25]);
			vo.setGrndCnb((Double) row[26]);
			vo.setCnaAdt((Double) row[27]);
			vo.setCsiAdt((Double) row[28]);
			vo.setMiscAdt((Double) row[29]);
			vo.setMiscChd((Double) row[30]);
			vo.setCruiseCode((String) row[31]);
			vo.setTourPkgDailyCms(row[32] != null ? ((BigInteger) row[32]).longValue() : null);
			vo.setNameEn((String) row[33]);
			vo.setNameZh((String) row[34]);
			vo.setNameOther((String) row[35]);

			if (StringUtils.isNotBlank(row[36] != null ? row[36].toString() : "")) {
				vo.setTravelInsS(true);
			}
			if (StringUtils.isNotBlank(row[37] != null ? row[37].toString() : "")) {
				vo.setTravelInsF(true);
			}
			vo.setIsPushToOnline(row[38] != null ? ((int) row[38]) == 1 : true);

			// Tour Cruise Cabin
			List<TourCruiseCabinVO> tourCruiseCabinList = tourCruiseCabinDAO.getTourCruiseCabinList(vo.getId(),
					idCompany);

			int totalCabinAllotment = 0;
			int totalTotalConfirmedCabin = 0;
			int totalTotalKivCabin = 0;
			int totalBalanceCabin = 0;

			for (TourCruiseCabinVO tCCvo : tourCruiseCabinList) {
				totalCabinAllotment += tCCvo.getCabinAllotment();
				totalTotalConfirmedCabin += tCCvo.getTotalConfirmedCabin();
				totalTotalKivCabin += tCCvo.getTotalKivCabin();
				totalBalanceCabin += tCCvo.getCabinAllotment() - tCCvo.getTotalConfirmedCabin()
						- tCCvo.getTotalKivCabin();
			}

			vo.setTotalCabinAllotment(totalCabinAllotment);
			vo.setTotalConfirmedCabin(totalTotalConfirmedCabin);
			vo.setTotalKivCabin(totalTotalKivCabin);
			vo.setTotalBalanceCabin(totalBalanceCabin);

			vo.setTourCruiseCabinList(tourCruiseCabinList);

			tourFilterDepList.add(vo);
		}
		return tourFilterDepList;
	}

	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getFilterTourDepListCruise(TourDepartureVO searchTourDepFilter, Long idCompany) throws BusinessException {
		StringBuilder sb = new StringBuilder();
			sb.append("SELECT ").
			append("d.id, d.id_tour_pkg, d.dt_dep, d.tour_status_cd, d.code AS 'tourcode', d.num_days, d.num_nights, d.description, ")
			.append("d.is_deposit_paid, d.is_issued_s, d.is_issued_f, d.is_push, d.tfair_discount, d.prn, ")
			.append("d.seat_allotment, d.tour_mgr_pax, d.reserved_seat, d.full_twn, d.full_sgl, d.full_ctw, d.full_ceb, d.full_cnb, ")
			.append("d.grnd_twn, d.grnd_sgl, d.grnd_ctw, d.grnd_ceb, d.grnd_cnb, d.cna_adt, d.csi_adt, d.misc_adt, d.misc_chd, a.code AS 'cruise', ")
			.append("d.tour_pkg_daily_cms, p.name_en, p.name_zh, p.name_other, ")
			.append("d.travel_ins_policy_s, d.travel_ins_policy_f, if(p.is_push_to_online=0, 0, d.is_push_to_online), ")
			.append("d.lang_cd, d.tour_status_reason, ")
			.append("IFNULL(cabin.total_cabin_allotment,0) AS total_cabin_allotment, ")
			.append("IFNULL(bc.confirmed_cabin,0) AS confirmed_cabin, ")
			.append("IFNULL(bc.kiv_cabin,0) AS kiv_cabin ")			
			.append("from tour_dep d ")
			.append("JOIN tour_pkg p ON d.id_tour_pkg = p.id AND p.type_cd=:typeCd ")
			.append("LEFT JOIN cruise a ON d.id_cruise = a.id ")
			.append("LEFT JOIN (SELECT id_tour_dep, SUM(cabin_allotment) AS total_cabin_allotment FROM tour_cruise_cabin WHERE status_cd = :statusCd AND id_company = :idCompany GROUP BY id_tour_dep) cabin ON cabin.id_tour_dep = d.id ")
			.append("LEFT JOIN (SELECT cc.id_tour_dep, ")
			.append("SUM(CASE WHEN b.status_cd = 'CF' AND i.type_cd = 'T' THEN i.cabin_qty ELSE 0 END) AS confirmed_cabin, ")
			.append("SUM(CASE WHEN b.status_cd = 'BK' AND b.pmnt_status_cd = 'KIV' AND i.type_cd = 'T' THEN i.cabin_qty ELSE 0 END) AS kiv_cabin FROM tour_dep d2 ")
			.append("JOIN tour_cruise_cabin cc ON cc.id_tour_dep = d2.id JOIN tour_booking_charge_item i ON cc.id = i.id_tour_cruise_cabin JOIN tour_booking b ON b.id = i.id_tour_booking WHERE d2.status_cd = :statusCode AND cc.status_cd = :statusCd AND cc.id_company = :idCompany GROUP BY cc.id_tour_dep) bc ON bc.id_tour_dep = d.id ");

		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getDepartDateBadgeList())) {
			sb.append("JOIN tour_dep_attribute ta ON ta.tag_type = 'depart_date_badge' AND ta.id_tour_dep = d.id AND ta.code in (");
			for (int i = 0; i < searchTourDepFilter.getDepartDateBadgeList().size(); i++) {
				String s = searchTourDepFilter.getDepartDateBadgeList().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getSelectedSeason())) {
			sb.append("JOIN tour_dep_season ts ON ts.id_tour_dep = d.id AND ts.season in (");
			for (int i = 0; i < searchTourDepFilter.getSelectedSeason().size(); i++) {
				String s = searchTourDepFilter.getSelectedSeason().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		
		sb.append("WHERE d.status_cd = :statusCode ");
		if (StringUtils.isNotBlank(searchTourDepFilter.getCode()))
			sb.append("and (d.code like :trCode) ");
		if (searchTourDepFilter.getFromDate() != null)
			sb.append("and d.dt_dep >= :dtFrom ");
		if (searchTourDepFilter.getToDate() != null)
			sb.append("and d.dt_dep <= :dtTo ");
		if (StringUtils.isNotBlank(searchTourDepFilter.getPackageDesc())) {
			sb.append("and (CONCAT(IFNULL(p.name_en, ''), ' ', IFNULL(p.name_other, ''), ' ', IFNULL(p.name_zh, '')) like :pkgTitle) ");
		}
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getTourStatusList())) {
			sb.append("and d.tour_status_cd in (");
			for (int i = 0; i < searchTourDepFilter.getTourStatusList().size(); i++) {
				String s = searchTourDepFilter.getTourStatusList().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getTourLangList())) {
			sb.append("and d.lang_cd in (");
			for (int i = 0; i < searchTourDepFilter.getTourLangList().size(); i++) {
				String s = searchTourDepFilter.getTourLangList().get(i);
				if (i > 0) sb.append(",");
				sb.append("'").append(s).append("'");
			}
			sb.append(") ");
		}
		if (searchTourDepFilter.getPriceFrom() != null)
			sb.append("and d.misc_adt >= :priceFrom ");
		if (searchTourDepFilter.getPriceTo() != null)
			sb.append("and d.misc_adt <= :priceTo ");
		
		if (CollectionUtils.isNotEmpty(searchTourDepFilter.getSectorList())) {
			sb.append("and d.id_tour_pkg in (select id_tour_pkg from tour_pkg_country where type_cd = 'COUNTRY' and id_location in (");
			for (int i = 0; i < searchTourDepFilter.getSectorList().size(); i++) {
				String s = searchTourDepFilter.getSectorList().get(i);
				if (i > 0) sb.append(",");
				sb.append(s);
			}
			sb.append(") and status_cd = 'AC') ");
		} else if (CollectionUtils.isNotEmpty(searchTourDepFilter.getSectorTypeList())) {
			sb.append("and d.id_tour_pkg in (select id_tour_pkg from tour_pkg_country where type_cd = 'REGION' and id_location in (");
			for (int i = 0; i < searchTourDepFilter.getSectorTypeList().size(); i++) {
				String s = searchTourDepFilter.getSectorTypeList().get(i);
				if (i > 0) sb.append(",");
				sb.append(s);
			}
			sb.append(") and status_cd = 'AC') ");
		}
		
		if (searchTourDepFilter.getBalanceCabin() != null) {
			//sb.append("where ((a.seat_allotment - a.reserved_seat - a.tour_mgr_pax - (a.tfairpax + a.agentpax + a.inhousepax + a.kivpax + a.on9bookingpax)) < 0 or").
			sb.append("AND (IFNULL(cabin.total_cabin_allotment,0) - IFNULL(bc.confirmed_cabin,0) - IFNULL(bc.kiv_cabin,0)) >= :balanceCabin ");
		}
		sb.append("order by p.name_en, d.dt_dep");
		
		Query query = createSQLQuery(sb.toString());
		query.setString("typeCd", ProductConstant.TYPE_CRUISE);
		query.setString("statusCd", BaseConstant.STATUS_ACTIVE);
		query.setLong("idCompany", idCompany);
		if(!searchTourDepFilter.isInactiveRecord()) {
			query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
		}else {
			query.setString("statusCode", CommonConstant.STATUS_CD_INACTIVE);
		}
		if (StringUtils.isNotBlank(searchTourDepFilter.getCode()))
			query.setString("trCode", "%" + searchTourDepFilter.getCode() + "%");
		if (searchTourDepFilter.getFromDate() != null)
			query.setDate("dtFrom", searchTourDepFilter.getFromDate());
		if (searchTourDepFilter.getToDate() != null)
			query.setDate("dtTo", searchTourDepFilter.getToDate());
		if (StringUtils.isNotBlank(searchTourDepFilter.getPackageDesc()))
			query.setString("pkgTitle", "%" + searchTourDepFilter.getPackageDesc() + "%");
		if (searchTourDepFilter.getPriceFrom() != null)
			query.setDouble("priceFrom", searchTourDepFilter.getPriceFrom());
		if (searchTourDepFilter.getPriceTo() != null)
			query.setDouble("priceTo", searchTourDepFilter.getPriceTo());
		if (searchTourDepFilter.getBalanceCabin() != null)
			query.setInteger("balanceCabin", searchTourDepFilter.getBalanceCabin());
		
		List<Object> results = query.list();
		List<TourDepartureVO> tourFilterDepList = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new TourDepartureVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setIdTourPkg(((BigInteger) row[1]).longValue());
			vo.setDtDep((Date) row[2]);
			vo.setTourStatusCd((String) row[3]);
			vo.setCode((String) row[4]);
			vo.setNumDays(((Short) row[5]).intValue());
			vo.setNumNights(((Short) row[6]).intValue());
			vo.setDesc(row[7] == null ? null : (String) row[7]);
			vo.setIsDepositPaid((Boolean) row[8]);
			vo.setIsIssuedS((Boolean) row[9]);
			vo.setIsIssuedF((Boolean) row[10]);
			vo.setIsPush((Boolean) row[11]);
			vo.setTfairDiscount((Double) row[12]);
			vo.setPrn(row[13] == null ? null : (String) row[13]);
			vo.setSeatAllot(((Short) row[14]).intValue());
			vo.setTourManagerPax(((Short) row[15]).intValue());
			vo.setReservedSeat(((Short) row[16]).intValue());
			vo.setFullTwn((Double) row[17]);
			vo.setFullSgl((Double) row[18]);
			vo.setFullCtw((Double) row[19]);
			vo.setFullCeb((Double) row[20]);
			vo.setFullCnb((Double) row[21]);
			vo.setGrndTwn((Double) row[22]);
			vo.setGrndSgl((Double) row[23]);
			vo.setGrndCtw((Double) row[24]);
			vo.setGrndCeb((Double) row[25]);
			vo.setGrndCnb((Double) row[26]);
			vo.setCnaAdt((Double) row[27]);
			vo.setCsiAdt((Double) row[28]);
			vo.setMiscAdt((Double) row[29]);
			vo.setMiscChd((Double) row[30]);
			vo.setCruiseCode((String) row[31]);
			vo.setTourPkgDailyCms(row[32] != null ? ((BigInteger) row[32]).longValue() : null);
			vo.setNameEn((String) row[33]);
			vo.setNameZh((String) row[34]);
			vo.setNameOther((String) row[35]);

			if (StringUtils.isNotBlank(row[36] != null ? row[36].toString() : "")) {
				vo.setTravelInsS(true);
			}
			if (StringUtils.isNotBlank(row[37] != null ? row[37].toString() : "")) {
				vo.setTravelInsF(true);
			}
			vo.setIsPushToOnline(row[38] != null ? ((int) row[38]) == 1 : true);
			vo.setLangCode(row[39] != null ? row[39].toString() : "");
			vo.setTourStatusReason(row[40] != null ? row[40].toString() : "");
			vo.setTotalCabinAllotment(((BigDecimal) row[41]).intValue());
			vo.setTotalConfirmedCabin(((BigDecimal) row[42]).intValue());
			vo.setTotalKivCabin(((BigDecimal) row[43]).intValue());
			vo.setTotalBalanceCabin(vo.getTotalCabinAllotment() - vo.getTotalConfirmedCabin() - vo.getTotalKivCabin());

			// Tour Cruise Cabin
			List<TourCruiseCabinVO> tourCruiseCabinList = tourCruiseCabinDAO.getTourCruiseCabinList(vo.getId(), idCompany);
			vo.setTourCruiseCabinList(tourCruiseCabinList);
			tourFilterDepList.add(vo);
		}
		return tourFilterDepList;
	}
	
	@Override
	public void updateTourBookingChargeItem(TourCruiseCabinVO tourCruiseCabinVO) throws BusinessException {
		// TODO Auto-generated method stub
		StringBuilder sb = new StringBuilder();
		sb = new StringBuilder();
		sb.append("UPDATE tour_booking_charge_item ");
		sb.append("SET `amount` = :amount, `amount_3` = :amount3, `amount_4` = :amount4, `amount_sgl` = :amountSgl, `amount_inf` = :amountInf ");
		sb.append("WHERE `id_tour_cruise_cabin` = :idTourCruiseCabin ");
		sb.append("AND `code` = :code");
		
		Query query = createSQLQuery(sb.toString());
		query.setParameter("amount", tourCruiseCabinVO.getPriceTwn());
		query.setParameter("amount3", tourCruiseCabinVO.getPrice3());
		query.setParameter("amount4", tourCruiseCabinVO.getPrice4());
		query.setParameter("amountSgl", tourCruiseCabinVO.getPriceSgl());
		query.setParameter("amountInf", tourCruiseCabinVO.getPriceInf());
		query.setParameter("idTourCruiseCabin", tourCruiseCabinVO.getId());
		query.setParameter("code", tourCruiseCabinVO.getCruiseCabinCd());
		query.executeUpdate();
	}

	@Override
	public String getTourAcctCdStatusCd(TourDepartureVO tourDepVO, CompanyVO companyVO, String type)
			throws BusinessException {

		Criteria criteria = createCriteria(TourDepItemVO.class);
		criteria.add(Restrictions.eq("idTourDep", tourDepVO.getId()));
		criteria.add(Restrictions.eq("companyVO", companyVO));
		criteria.add(Restrictions.isNull("acctId"));
		criteria.setMaxResults(1);

		if (criteria.uniqueResult() != null) {
			return ProductConstant.TOUR_DEP_STATUS_CD_PENDING;
		} else {
			if (ProductConstant.TYPE_CRUISE.equals(type)) {
				criteria = createCriteria(TourCruiseCabinVO.class);
				criteria.add(Restrictions.eq("idTourDep", tourDepVO.getId()));
				criteria.add(Restrictions.eq("idCompany", companyVO.getId()));
				criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
				criteria.add(Restrictions.isNull("idAcct"));
				criteria.setMaxResults(1);

				if (criteria.uniqueResult() != null)
					return ProductConstant.TOUR_DEP_STATUS_CD_PENDING;
				else
					return ProductConstant.TOUR_DEP_STATUS_CD_COMPLETED;
			} else {
				return ProductConstant.TOUR_DEP_STATUS_CD_COMPLETED;
			}
		}
	}

	@Override
	public void updateCruiseTourStatus(Long idTourDep) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("UPDATE tour_dep d ");
		sb.append(
				"SET d.tour_status_cd = CASE WHEN (SELECT SUM(1) - SUM(IF(c.tour_status_cd = 'F', 1, 0))  FROM tour_cruise_cabin c WHERE c.id_tour_dep = d.id AND c.status_cd = 'A') > 0 THEN 'A' ");
		sb.append("ELSE 'F' END ");
		sb.append("WHERE d.status_cd = 'AC' AND d.id = :idTourDep ");
		
		Query query = createSQLQuery(sb.toString());
		query.setParameter("idTourDep", idTourDep);
		query.executeUpdate();
	}

	@Override
	public TourDepItemVO getTourDepItem(Long idTourDep, String code, CompanyVO campanyVO) throws BusinessException {
		Criteria criteria = createCriteria(TourDepItemVO.class);
		criteria.add(Restrictions.eq("idTourDep", idTourDep));
		criteria.add(Restrictions.eq("code", code));
		criteria.add(Restrictions.eq("companyVO", campanyVO));
		criteria.setMaxResults(1);
		return (TourDepItemVO) criteria.uniqueResult();
	}

	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getAvailableCruiseTourDepList(Long idCompany, InvoiceVO invoiceVO, BookingVO bookingVO)
			throws BusinessException {
		Query query = null;
		StringBuilder sb = new StringBuilder();

		ArrayList<String> cabinCodeList = new ArrayList<String>();
		StringBuilder cond1 = new StringBuilder();
		cond1.append("(");
		for (int i = 0; i < bookingVO.getBookingChargeItemList().size(); i++) {
			BookingChargeItemVO chargeItemVO = bookingVO.getBookingChargeItemList().get(i);

			if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(chargeItemVO.getTypeCd())) {
				if (cabinCodeList.size() > 0)
					cond1.append(",");
				cond1.append("'").append(chargeItemVO.getCode()).append("'");

				cabinCodeList.add(chargeItemVO.getCode());
			}
		}
		cond1.append(")");

		sb = new StringBuilder();
		sb.append("SELECT tp.id_tour_cat, tp.id").append(" FROM tour_booking tb")
				.append(" JOIN tour_dep td ON tb.id_tour_dep = td.id")
				.append(" JOIN tour_pkg tp ON td.id_tour_pkg = tp.id").append(" WHERE tb.id = :id");
		query = createSQLQuery(sb.toString());
		query.setLong("id", bookingVO.getId());
		List<Object> rs = query.list();

		Long idTourCat = 0L;
		Long idTourPkg = 0L;
		for (Iterator<Object> it = rs.iterator(); it.hasNext();) {
			Object[] row = (Object[]) it.next();
			idTourCat = ((BigInteger) row[0]).longValue();
			idTourPkg = ((BigInteger) row[1]).longValue();
		}

		String cond2 = "";
		if (CommonConstant.CRUISE_TRANSFER_ONLY_SAME_PACKAGE.equals("Y")) {
			cond2 = "AND p.id = '" + idTourPkg + "' ";
		}

		sb = new StringBuilder();
		sb.append(
				"SELECT d.id, d.dt_dep, d.code, d.description, d.num_days, d.num_nights, p.name_en, p.name_zh, p.name_other, d.tour_status_cd ")
				.append("FROM tour_dep d JOIN tour_pkg p ON d.id_tour_pkg = p.id ").append("LEFT JOIN (")
				.append("SELECT c.id_tour_dep, c.cruise_cabin_cd, c.id_company ")
				.append("FROM tour_cruise_cabin c, tour_dep d WHERE c.id_tour_dep = d.id ")
				.append("AND c.id_company = :idCompany ").append("AND d.status_cd = 'AC' AND c.cruise_cabin_cd IN ")
				.append(cond1.toString()).append(") tc ON tc.id_tour_dep = d.id ")
				.append("WHERE d.id_tour_pkg = p.id AND d.dt_dep >= :dtDep ").append("AND p.id_tour_cat = :idTourCat ")
				.append(cond2).append("")
				.append("AND d.status_cd = 'AC' AND d.tour_status_cd NOT IN ('F', 'I', 'R', 'N', 'C') AND p.type_cd = :typeCd ")
				.append("ORDER BY d.dt_dep, d.num_days");
		query = createSQLQuery(sb.toString());
		query.setString("typeCd", bookingVO.getTypeCd());
		query.setLong("idCompany", idCompany);
		query.setDate("dtDep", new Date());
		query.setLong("idTourCat", idTourCat);

		List<Object> results = query.list();
		List<TourDepartureVO> list = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo = new TourDepartureVO();

		if (CollectionUtils.isNotEmpty(results)) {
			Long id = null;
			Long prevId = null;
			boolean isCabinNotExist = false;
			cabinCodeList = new ArrayList<String>();

			for (Iterator<Object> it = results.iterator(); it.hasNext();) {
				Object[] row = (Object[]) it.next();
				vo = new TourDepartureVO();
				vo.setId(((BigInteger) row[0]).longValue());
				vo.setDtDep((Date) row[1]);
				vo.setCode((String) row[2]);
				vo.setDesc((String) row[3]);
				vo.setNumDays(((Short) row[4]).intValue());
				vo.setNumNights(((Short) row[5]).intValue());
				vo.setNameEn((String) row[6]);
				vo.setNameZh((String) row[7]);
				vo.setNameOther((String) row[8]);
				vo.setTourStatusCd((String) row[9]);
				list.add(vo);
			}
		}

		return list;
	}

	@Override
	public void updateTourDepsRemainTc(TourPackageVO tourPkgVO) throws BusinessException {
		Query query = createQuery("UPDATE TourDepartureVO SET isRemainTc = :isRemainTc WHERE idTourPkg = :idTourPkg");
		query.setParameter("isRemainTc", true);
		query.setParameter("idTourPkg", tourPkgVO.getId());
		query.executeUpdate();
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<TourDepartureVO> getAgentTourDepList(Long idTourPkg, Long idAirlineSchedule) throws BusinessException {
		if (idAirlineSchedule == null) {
			StringBuilder sb = new StringBuilder();
			sb.append("SELECT ").
				append("d.id, d.seq_no, d.dt_dep, d.tour_status_cd, d.code AS 'tourcode', d.num_days, d.num_nights, d.description, ").
				append("d.is_deposit_paid, d.is_issued_s, d.is_issued_f, d.is_push, d.tfair_discount, d.prn, ").
				append("d.seat_allotment, d.tour_mgr_pax, d.reserved_seat, d.full_twn, d.full_sgl, d.full_ctw, d.full_ceb, d.full_cnb, ").
				append("d.grnd_twn, d.grnd_sgl, d.grnd_ctw, d.grnd_ceb, d.grnd_cnb, d.cna_adt, d.csi_adt, d.misc_adt, d.misc_chd, a.code AS 'airline', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 't_fair%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'tfairpax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'agent%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'agentpax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'in_house%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'inhousepax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'CF' and b.order_type_cd like 'online_booking%' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'on9bookingpax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and b.status_cd = 'BK' and b.pmnt_status_cd = 'KIV' and i.code in ('FT_SGL', 'FT_TWN', 'FT_CTW', 'FT_CWB', 'FT_CNB')) AS 'kivpax', ").
				append("(select case when sum(i.quantity) is null then 0 else sum(i.quantity) end from tour_booking b, tour_booking_charge_item i ").
				append("where b.id_tour_dep = d.id and i.id_tour_booking = b.id and (b.status_cd = 'CF' or (b.status_cd = 'BK' and pmnt_status_cd = 'KIV')) and i.code in ('GA_SGL', 'GA_TWN', 'GA_CTW', 'GA_CWB', 'GA_CNB', 'GA_INFT')) AS 'ga', d.tour_pkg_daily_cms, ").
				append("d.travel_ins_policy_s, d.travel_ins_policy_f, d.lang_cd, d.tour_status_reason, if((select is_push_to_online from tour_pkg where id = :idTourPkg)=0, 0, d.is_push_to_online) ").
				append(", d.deadline, d.is_lock, d.is_private_tour, d.private_pic, p.deposit ").
				append("from (tour_dep d, airline a) LEFT JOIN tour_pkg p ON d.id_tour_pkg = p.id where d.id_airline = a.id and d.id_tour_pkg = :idTourPkg and d.status_cd = :statusCode and (d.tour_status_cd = 'A' or d.tour_status_cd = 'C1' or d.tour_status_cd = 'L') order by d.seq_no is null, d.seq_no, d.dt_dep, d.code");
			
			Query query = createSQLQuery(sb.toString());
			query.setLong("idTourPkg", idTourPkg);
			query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
			List<Object> results = query.list();
			List<TourDepartureVO> tourDepList = new ArrayList<TourDepartureVO>();
			TourDepartureVO vo;
			
			for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				vo = new TourDepartureVO();
				vo.setId(((BigInteger) row[0]).longValue());
				vo.setSeqNo(row[1] == null ? null : Integer.parseInt(row[1].toString()));
				vo.setDtDep((Date) row[2]);
				vo.setTourStatusCd((String) row[3]);
				vo.setCode((String) row[4]);
				vo.setNumDays(((Short) row[5]).intValue());
				vo.setNumNights(((Short) row[6]).intValue());
				vo.setDesc(row[7] == null ? null : (String) row[7]);
				vo.setIsDepositPaid((Boolean) row[8]);
				vo.setIsIssuedS((Boolean) row[9]);
				vo.setIsIssuedF((Boolean) row[10]);
				vo.setIsPush((Boolean) row[11]);
				vo.setTfairDiscount((Double) row[12]);
				vo.setPrn(row[13] == null ? null : (String) row[13]);
				vo.setSeatAllot(((Short) row[14]).intValue());
				vo.setTourManagerPax(((Short) row[15]).intValue());
				vo.setReservedSeat(((Short) row[16]).intValue());
				vo.setFullTwn((Double) row[17]);
				vo.setFullSgl((Double) row[18]);
				vo.setFullCtw((Double) row[19]);
				vo.setFullCeb((Double) row[20]);
				vo.setFullCnb((Double) row[21]);
				vo.setGrndTwn((Double) row[22]);
				vo.setGrndSgl((Double) row[23]);
				vo.setGrndCtw((Double) row[24]);
				vo.setGrndCeb((Double) row[25]);
				vo.setGrndCnb((Double) row[26]);
				vo.setCnaAdt((Double) row[27]);
				vo.setCsiAdt((Double) row[28]);
				vo.setMiscAdt((Double) row[29]);
				vo.setMiscChd((Double) row[30]);
				vo.setAirlineCode((String) row[31]);
				vo.setTfairPax(((BigDecimal) row[32]).intValue());
				vo.setAgentPax(((BigDecimal) row[33]).intValue());
				vo.setInHsePax(((BigDecimal) row[34]).intValue());
				vo.setOn9BookingPax(((BigDecimal) row[35]).intValue());
				vo.setKivPax(((BigDecimal) row[36]).intValue());
				vo.setTotalGA(((BigDecimal) row[37]).intValue());
				vo.setTourPkgDailyCms(row[38] != null ? ((BigInteger) row[38]).longValue() : null);
				
				if (StringUtils.isNotBlank(row[39] != null ? row[39].toString() : "")) {
					vo.setTravelInsS(true);
				}
				if (StringUtils.isNotBlank(row[40] != null ? row[40].toString() : "")) {
					vo.setTravelInsF(true);
				}
				vo.setLangCode(row[41] != null ? row[41].toString() : "");
				vo.setTourStatusReason(row[42] != null ? row[42].toString() : "");
				vo.setIsPushToOnline(row[43] != null ? ((BigInteger) row[43]).equals(BigInteger.ONE) : true);
				if(row[44] != null ) vo.setDeadline(Integer.parseInt(row[44].toString())); else vo.setDeadline(0);
				vo.setIsLock(row[45] != null ? ((Boolean) row[45]) : false);
				vo.setIsPrivateTour(row[46] != null ? ((Boolean) row[46]) : false);
				vo.setPrivatePic(row[47] != null ? row[47].toString() : "");
				vo.setDeposit((Double) row[48]);
				
				// Tour Departure Discount
				vo.setTourDepartureDiscountVOList(getTourDepDiscount(vo.getId()));
				
				vo.setDiscount1(0.00);
				vo.setDiscount2(0.00);
				if (CollectionUtils.isNotEmpty(vo.getTourDepartureDiscountVOList())) {
					int count = 1;
					
					for (TourDepartureDiscountVO discountVO : vo.getTourDepartureDiscountVOList()) {
						double discountAmt = discountVO.getDiscountAmt();
						int discountPax = discountVO.getDiscountPax();
						
						if (count == 1) {
							vo.setDiscount1(discountAmt);
							vo.setDiscountPax1(discountPax);
						} else if (count == 2) {
							vo.setDiscount2(discountAmt);
							vo.setDiscountPax2(discountPax);
						}
						count++;
					}
				}
				
				tourDepList.add(vo);
			}
			return tourDepList;
			
		} else {
			Criteria criteria = createCriteria(TourDepartureVO.class);
			criteria.add(Restrictions.eq("statusCode", CommonConstant.STATUS_CD_ACTIVE));
			criteria.add(Restrictions.eq("idAirlineSchedule", idAirlineSchedule));
			criteria.addOrder(Order.asc("seqNo"));
			criteria.addOrder(Order.asc("dtDep"));
			criteria.addOrder(Order.asc("code"));
			return criteria.list();
		}
	}
	
	public List<TourDepartureVO> getAvailableTourDepList(Long idCompany, InvoiceVO invoiceVO, String tourTypeCode)
			throws BusinessException {
		Query query = null;
		StringBuilder sb = new StringBuilder();
		
		if (invoiceVO != null && invoiceVO.isDateInFinPeriodClosed()) {
			sb.append("SELECT d.id, d.dt_dep, d.code, d.description, d.num_days, d.num_nights, d.seat_allotment, d.reserved_seat, d.tour_mgr_pax, p.name_en, p.name_zh, p.name_other, cc.quantity, d.tour_status_cd ").
			append("FROM tour_dep d JOIN (").
				append("SELECT tp.id, tp.name_en, tp.name_zh, tp.name_other FROM tour_pkg tp, tour_dep td WHERE tp.id = td.id_tour_pkg AND td.status_cd = 'AC' AND td.id = ?");
				
			sb.append(" AND tp.type_cd in ('" + tourTypeCode + "')"); 
				
			sb.append(") p ON d.id_tour_pkg = p.id ").
			append("LEFT JOIN (").
				append("SELECT SUM(c.quantity) AS 'quantity', b.id_tour_dep FROM tour_booking_charge_item c LEFT JOIN (").
					append("SELECT id, id_tour_dep, pmnt_status_cd FROM tour_booking WHERE status_cd NOT IN ('CC', 'VD')").
				append(") b ON b.pmnt_status_cd <> 'KIVEXP' ").
				append("WHERE c.id_tour_booking = b.id AND c.code LIKE 'FT%' AND c.code <> 'FT_INFT' group by b.id_tour_dep ").
			append(") cc on cc.id_tour_dep = d.id ").
			append("WHERE d.status_cd = 'AC' AND d.tour_status_cd NOT IN ('F', 'I', 'R', 'N', 'C') AND ").
			append("d.id NOT IN (SELECT id FROM tour_dep WHERE id NOT IN (SELECT DISTINCT id_tour_dep FROM tour_dep_item WHERE id_company = ?) OR ").
			append("d.id IN (SELECT DISTINCT id_tour_dep FROM tour_dep_item WHERE id_acct IS NULL AND id_company = ?))").
			append(" ORDER BY d.dt_dep, d.num_days");
			
			query = createSQLQuery(sb.toString());
			query.setParameter(0, invoiceVO.getTourDepId());
			query.setParameter(1, idCompany);
			query.setParameter(2, idCompany);
			
		} else {
			sb.append("SELECT d.id, d.dt_dep, d.code, d.description, d.num_days, d.num_nights, d.seat_allotment, d.reserved_seat, d.tour_mgr_pax, p.name_en, p.name_zh, p.name_other, cc.quantity, d.tour_status_cd ").
				append("FROM tour_dep d JOIN tour_pkg p ").
				append("LEFT JOIN (").
					append("SELECT SUM(c.quantity) AS 'quantity', b.id_tour_dep FROM tour_booking_charge_item c ").
					append("LEFT JOIN (SELECT id, id_tour_dep, pmnt_status_cd FROM tour_booking WHERE status_cd NOT IN ('CC', 'VD')) b ON b.pmnt_status_cd <> 'KIVEXP' ").
					append("WHERE c.id_tour_booking = b.id AND c.code LIKE 'FT%' AND c.code <> 'FT_INFT' group by b.id_tour_dep").
				append(") cc on cc.id_tour_dep = d.id ").
				append("WHERE d.id_tour_pkg = p.id AND d.status_cd = 'AC' AND d.tour_status_cd NOT IN ('F', 'I', 'R', 'N', 'C')");
			
				sb.append(" AND p.type_cd in ('" + tourTypeCode + "')"); 
				sb.append(" AND ");
			
				sb.append("d.id NOT IN (SELECT id FROM tour_dep WHERE id NOT IN (SELECT DISTINCT id_tour_dep FROM tour_dep_item WHERE id_company = ?) OR id IN (SELECT DISTINCT id_tour_dep FROM tour_dep_item WHERE id_acct IS NULL AND id_company = ?)) ").
				append("ORDER BY d.dt_dep, d.num_days");
			
			query = createSQLQuery(sb.toString());
			query.setParameter(0, idCompany);
			query.setParameter(1, idCompany);
		}
		List<Object> results = query.list();
		List<TourDepartureVO> list = new ArrayList<TourDepartureVO>();
		TourDepartureVO vo;
		
		if (CollectionUtils.isNotEmpty(results)) {
			for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				vo = new TourDepartureVO();
				vo.setId(((BigInteger) row[0]).longValue());
				vo.setDtDep((Date) row[1]);
				vo.setCode((String) row[2]);
				vo.setDesc((String) row[3]);
				vo.setNumDays(((Short) row[4]).intValue());
				vo.setNumNights(((Short) row[5]).intValue());
				vo.setSeatAllot(((Short) row[6]).intValue());
				vo.setReservedSeat(((Short) row[7]).intValue());
				vo.setTourManagerPax(((Short) row[8]).intValue());
				vo.setNameEn((String) row[9]);
				vo.setNameZh((String) row[10]);
				vo.setNameOther((String) row[11]);
				vo.setQuantity((row[12] == null) ? 0 : ((BigDecimal) row[12]).intValue());
				vo.setTourStatusCd((String) row[13]);
				if (vo.getSeatAllot().intValue() == 0) list.add(vo);
				else if (vo.getSeatAllot() > (vo.getReservedSeat() + vo.getTourManagerPax() + vo.getQuantity())) list.add(vo);
			}
		}
		return list;
	}

	@Override
	public void updateDocumentAirfare(Long idTourDep) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		sb.append("UPDATE invoice i ").
			append("LEFT JOIN tour_booking tb on ").
			append("CASE WHEN i.id_tour_booking IS NULL AND i.id_parent_inv_tour_booking IS NOT NULL THEN ").
				append("i.id_parent_inv_tour_booking ").
				append("ELSE i.id_tour_booking  ").
		append("END = tb.id and i.id_company = tb.id_company ").
		append(", invoice_item ii, tour_dep td ").
		append("SET ii.airfare = ").
			append("(if(ii.amount < 0 and ii.amount != 0, -1, 1) * ").
				append("ifnull((CASE ").
					append("WHEN ii.code = 'FT_TWN' THEN td.airfare_twn ").
					append("WHEN ii.code = 'FT_SGL' THEN td.airfare_sgl ").
					append("WHEN ii.code = 'FT_CTW' THEN td.airfare_ctw ").
					append("WHEN ii.code = 'FT_CWB' THEN td.airfare_ceb ").
					append("WHEN ii.code = 'FT_CNB' then td.airfare_cnb ").
					append("ELSE ii.airfare ").
				append("END), 0) ").
			append("), ").
			append("ii.upd_by = :updatedBy, ").
			append("ii.dt_upd = NOW() ").
		append("WHERE i.id = ii.id_inv AND i.id_tour_dep = td.id AND i.doc_type_cd IN ('P', 'I') ").
			append("AND td.id = :idTourDep ").
			append("AND ii.code IN ('FT_TWN', 'FT_SGL', 'FT_CTW', 'FT_CWB', 'FT_CNB') ").
			append("AND ii.airfare = 0 AND ii.amount != 0 ").
			append("AND ifnull(e_invoice_status, '') != :eInvoiceStatus ").
			append("AND ii.status_cd = :statusCode ").
			append("AND ifnull(i.status_cd, '') not in (:statusCdCC, :statusCdVD) ").
			append("AND ifnull(tb.status_cd, '') not in (:statusCdCC, :statusCdVD) ");
		
		Query query = createSQLQuery(sb.toString());
		query.setString("updatedBy", BaseContext.getUserFullName() == null ? BaseContext.getLoginId() : BaseContext.getUserFullName());
		query.setLong("idTourDep", idTourDep);
		query.setString("eInvoiceStatus", EInvoiceConstant.E_INV_STATUS_VALID);
		query.setString("statusCode", BaseConstant.STATUS_ACTIVE);
		query.setParameter("statusCdCC", CommonConstant.STATUS_CD_CANCELLED);
		query.setParameter("statusCdVD", CommonConstant.STATUS_CD_VOID);
		query.executeUpdate();
	}
	
	@Override
	public void updateDocumentAirfareCN(Long idTourDep) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		sb.append("UPDATE invoice iv ").
			append("LEFT JOIN invoice cn_iv ").
				append("ON iv.id_company = cn_iv.id_company AND iv.doc_type_cd = 'C' AND iv.cn_inv_no IS NOT NULL AND cn_iv.code = iv.cn_inv_no AND cn_iv.doc_type_cd = 'I' ").
			append("LEFT JOIN invoice cn_ps ").
				append("ON iv.id_company = cn_ps.id_company AND iv.doc_type_cd = 'C' AND iv.cn_ps_no IS NOT NULL AND cn_ps.ps_no = iv.cn_ps_no AND cn_ps.doc_type_cd = 'P' ").
			append("LEFT JOIN tour_dep td ON td.id = ifnull(cn_iv.id_tour_dep, cn_ps.id_tour_dep) ").
		append(", invoice_item ii ").
		append("SET ii.airfare = ").
			append("(if(ii.amount < 0 and ii.amount != 0, -1, 1) * ").
				append("ifnull((CASE ").
					append("WHEN ii.code = 'FT_TWN' THEN if(ABS(ii.amount) < td.airfare_twn, ABS(ii.amount), td.airfare_twn) ").
					append("WHEN ii.code = 'FT_SGL' THEN if(ABS(ii.amount) < td.airfare_sgl, ABS(ii.amount), td.airfare_sgl) ").
					append("WHEN ii.code = 'FT_CTW' THEN if(ABS(ii.amount) < td.airfare_ctw, ABS(ii.amount), td.airfare_ctw) ").
					append("WHEN ii.code = 'FT_CWB' THEN if(ABS(ii.amount) < td.airfare_ceb, ABS(ii.amount), td.airfare_ceb) ").
					append("WHEN ii.code = 'FT_CNB' then if(ABS(ii.amount) < td.airfare_cnb, ABS(ii.amount), td.airfare_cnb) ").
					append("ELSE ii.airfare ").
				append("END), 0) ").
			append("), ").
			append("ii.upd_by = :updatedBy, ").
			append("ii.dt_upd = NOW() ").
		append("WHERE iv.id = ii.id_inv ").
			append("AND iv.doc_type_cd = 'C' ").
			append(" AND td.id = :idTourDep ").
			append("AND ii.code IN ('FT_TWN', 'FT_SGL', 'FT_CTW', 'FT_CWB', 'FT_CNB') ").
			append("AND ii.airfare = 0 ").
			append("AND ii.amount != 0 ").
			append("AND (ifnull(iv.e_invoice_status, '') not in (:eInvoiceStatusSubmit, :eInvoiceStatusValid) ").
					append("AND ifnull(iv.e_invoice_rn_status, '') not in (:eInvoiceStatusSubmit, :eInvoiceStatusValid) ").
				append(") ").
			append("AND ii.status_cd = :statusCode ").
			append("AND ifnull(iv.status_cd, '') not in (:statusCdCC, :statusCdVD) ");
		
		Query query = createSQLQuery(sb.toString());
		query.setString("updatedBy", BaseContext.getUserFullName() == null ? BaseContext.getLoginId() : BaseContext.getUserFullName());
		query.setLong("idTourDep", idTourDep);
		query.setString("eInvoiceStatusSubmit", EInvoiceConstant.E_INV_STATUS_SUBMIT);
		query.setString("eInvoiceStatusValid", EInvoiceConstant.E_INV_STATUS_VALID);
		query.setString("statusCode", BaseConstant.STATUS_ACTIVE);
		query.setParameter("statusCdCC", CommonConstant.STATUS_CD_CANCELLED);
		query.setParameter("statusCdVD", CommonConstant.STATUS_CD_VOID);
		query.executeUpdate();
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<TourPackageVO> getTourPkgListForCMS(Map<String, Object> params) throws BusinessException {
		Query query = null;
		StringBuilder sb = new StringBuilder();
		
		sb.append("SELECT ").
			append("tc.description AS cat_desc, t2.description AS parent_theme_desc, t.description AS theme_desc, ").
			append("p.id, p.code, p.num_days, p.num_nights, p.name_en, p.name_zh, p.name_other, p.name_other_zh, p.year, ").
			append("(SELECT count(tpdi.id) FROM tour_pkg_daily_itinerary tpdi WHERE tpdi.id_tour_pkg = p.id AND tpdi.status_cd = 'A') as daily_itinerary_count ").
		append("FROM tour_pkg p ").
			append("LEFT JOIN tour_theme t ON t.id = p.id_tour_theme ").
			append("LEFT JOIN tour_theme t2 ON t2.id = t.id_parent ").
			append("LEFT JOIN tour_cat tc ON tc.id = t.id_tour_cat ").
		append("WHERE tc.type_cd = 'TOUR' ").
		append(" AND p.status_cd = '").append(CommonConstant.STATUS_CD_ACTIVE).append("' ");
		if (params.get("inactiveRecords") != null && "Y".equals(params.get("inactiveRecords").toString())) {
		} else {
			sb.append("AND p.year >= YEAR(now()) ");
		}
		sb.append("ORDER BY p.year, p.seq, p.name_en ");
		
		query = createSQLQuery(sb.toString());
		
		List<Object> results = query.list();
		List<TourPackageVO> list = new ArrayList<TourPackageVO>();
		TourPackageVO vo;
		
		if (CollectionUtils.isNotEmpty(results)) {
			for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				vo = new TourPackageVO();
				vo.setCatDesc((String) row[0]);
				vo.setParentThemeDesc((String) row[1]);
				vo.setThemeDesc((String) row[2]);
				vo.setId(((BigInteger) row[3]).longValue());
				vo.setCode((String) row[4]);
				vo.setNumDays(((Short) row[5]).intValue());
				vo.setNumNights(((Short) row[6]).intValue());
				vo.setNameEn((String) row[7]);
				vo.setNameZh((String) row[8]);
				vo.setNameOther((String) row[9]);
				vo.setNameOtherZh((String) row[10]);
				vo.setYear((String) row[11]);
				vo.setTourPkgDailyItineraryCount(((BigInteger) row[12]).intValue());
				
				list.add(vo);
			}
		}
		return list;
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<FeedbackVO> getInvoiceForFeedback() throws BusinessException {
	    StringBuilder sb = new StringBuilder();
	    sb.append("SELECT ")
		    // Invoice
		    .append("i.id AS inv_id, ")
		    .append("i.id_parent_inv, ")
		    .append("i.id_parent_inv_tour_booking, ")
		    .append("i.code AS inv_code, ")
		    .append("i.ps_no, ")
		    .append("i.doc_type_cd, ")
		    .append("i.doc_type_status, ")
		    .append("i.attn_to, ")
		    // Tour Departure
		    .append("td.id AS td_id, ")
		    .append("td.num_nights, ")
		    .append("td.dt_dep, ")
		    .append("td.code AS td_code, ")
		    .append("td.op_pic, ")
		    .append("CASE ")
		    .append("    WHEN i.doc_type_cd = 'I' THEN CONCAT('AV', i.code) ")
		    .append("    WHEN i.doc_type_cd = 'P' THEN CONCAT('PS', i.ps_no) ")
		    .append("    ELSE NULL ")
		    .append("END AS doc_id, ")
		    // Tour Package
		    .append("tp.id AS tp_id, ")
		    .append("tp.type_cd AS tp_type_cd, ")
		    .append("tp.code AS tp_code, ")
		    // Customer
		    .append("c.id AS c_id, ")
		    .append("c.id_pc, ")
		    .append("c.id_corporate, ")
		    .append("c.corporate_name, ")
		    .append("c.status_cd AS c_status_cd, ")
		    // Person
		    .append("p.id AS p_id, ")
		    .append("p.salutation_cd, ")
		    .append("p.title, ")
		    .append("p.first_name, ")
		    .append("p.middle_name, ")
		    .append("p.last_name, ")
		    .append("p.email, ")
		    // Tour Booking
		    .append("tb.id AS tb_id, ")
		    .append("tb.type_cd AS tb_type_cd, ")
		    .append("tb.pmnt_status_cd, ")
		    .append("tb.status_cd  AS tb_status_cd, ")
		    // Op Pic Names
		    .append("GROUP_CONCAT( ")
		    .append("    DISTINCT su.user_name ")
		    .append("    ORDER BY FIND_IN_SET(e.id, td.op_pic) ")
		    .append("    SEPARATOR ', ' ")
		    .append(") AS op_pic_names ")
	
			.append("FROM invoice i ")
			.append("LEFT JOIN tour_dep td ON i.id_tour_dep = td.id ")
			.append("LEFT JOIN tour_pkg tp ON td.id_tour_pkg = tp.id ")
			.append("LEFT JOIN customer c ON i.id_customer = c.id ")
			.append("LEFT JOIN person p ON c.id_pc = p.id ")
			.append("LEFT JOIN tour_booking tb  ON i.id_tour_booking = tb.id ")
			.append("LEFT JOIN JSON_TABLE( ")
			.append("    CONCAT('[\"', REPLACE(td.op_pic, ',', '\",\"'), '\"]'), ")
			.append("    '$[*]' COLUMNS (emp_id BIGINT PATH '$') ")
			.append(") AS jt                   ON jt.emp_id > 0 ")
			.append("LEFT JOIN employee e ON e.id = jt.emp_id ")
			.append("LEFT JOIN sec_user su ON su.uuid = e.u_sec_user ")
			
			//	      .append("WHERE td.status_cd = :statusCode ")
			//	      .append("AND tp.type_cd = :tourTypeCd ")
			//	      .append("AND i.doc_type_status NOT IN (:statusCdCC, :statusCdVD) ")
			.append("WHERE (jt.emp_id IS NULL OR jt.emp_id > 0) ")
			.append("AND DATE(DATE_ADD(td.dt_dep, INTERVAL td.num_nights DAY)) ")
			.append("  = DATE(DATE_ADD(CURDATE(), INTERVAL 1 DAY)) ")
			
			.append("GROUP BY ")
			.append("i.id");


	    Query query = createSQLQuery(sb.toString());
//	    query.setString("statusCode",  CommonConstant.STATUS_CD_ACTIVE);
//	    query.setString("tourTypeCd",  ProductConstant.TYPE_TOUR);
//	    query.setString("statusCdCC",  CommonConstant.STATUS_CD_CANCELLED);
//	    query.setString("statusCdVD",  CommonConstant.STATUS_CD_VOID);

	    List<Object> results = query.list();
	    List<FeedbackVO> feedbackList = new ArrayList<FeedbackVO>();
	    FeedbackVO vo;

	    for (Iterator<Object> it = results.iterator(); it.hasNext();) {
	        Object[] row = (Object[]) it.next();
	        vo = new FeedbackVO();

	        // Invoice
	        if (row[0]  != null) vo.setInvId(((BigInteger) row[0]).longValue());
	        if (row[1]  != null) vo.setParentInvId(((BigInteger) row[1]).longValue());
	        if (row[2]  != null) vo.setParentInvTourBookingId(((BigInteger) row[2]).longValue());
	        if (row[3]  != null) vo.setInvCode((String) row[3]);
	        if (row[4]  != null) vo.setPsNo((String) row[4]);
	        if (row[5]  != null) vo.setDocTypeCd((String) row[5]);
	        if (row[6]  != null) vo.setDocTypeStatus((String) row[6]);
	        if (row[7]  != null) vo.setAttnTo((String) row[7]);

	        // Tour Departure
	        if (row[8]  != null) vo.setIdTourDeparture(((BigInteger) row[8]).longValue());
	        if (row[9]  != null) vo.setNumNights(((Short) row[9]).intValue());
	        if (row[10] != null) vo.setDepartureDate((Date) row[10]);
	        if (row[11] != null) vo.setTourDepCode((String) row[11]);
	        if (row[12] != null) vo.setOpPic((String) row[12]);
	        if (row[13] != null) vo.setDocId((String) row[13]);

	        // Tour Package
	        if (row[14] != null) vo.setIdTourPkg(((BigInteger) row[14]).longValue());
	        if (row[15] != null) vo.setTourPkgTypeCd((String) row[15]);
	        if (row[16] != null) vo.setTourPkgCode((String) row[16]);

	        if (row[17] != null) vo.setCustomerId(((BigInteger) row[17]).longValue());
	        if (row[18] != null) vo.setCustomerPersonId(((BigInteger) row[18]).longValue());
	        if (row[19] != null) vo.setCustomerCorporateId(((BigInteger) row[19]).longValue());
	        if (row[20] != null) vo.setCorporateName((String) row[20]);
	        if (row[21] != null) vo.setCustomerStatusCode((String) row[21]);

	        if (row[22] != null) vo.setPersonId(((BigInteger) row[22]).longValue());
	        String salutation = row[23] != null ? row[23].toString() : "";
	        String title      = row[24] != null ? row[24].toString() : "";
	        String firstName  = row[25] != null ? row[25].toString() : "";
	        String middleName = row[26] != null ? row[26].toString() : "";
	        String lastName   = row[27] != null ? row[27].toString() : "";
	        if (row[28] != null) vo.setCustomerEmail((String) row[28]);

	        vo.setSalutationCd(salutation);
	        vo.setTitle(title);
	        vo.setFirstName(firstName);
	        vo.setMiddleName(middleName);
	        vo.setLastName(lastName);

	        String fullName = (StringUtils.isNotBlank(salutation) ? salutation + ". " : "")
	                        + firstName
	                        + (StringUtils.isNotBlank(middleName) ? " " + middleName : "")
	                        + (StringUtils.isNotBlank(lastName)   ? " " + lastName   : "");
	        vo.setCustomerName(fullName.trim());

	        // Tour Booking
	        if (row[29] != null) vo.setBookingId(((BigInteger) row[29]).longValue());
	        if (row[30] != null) vo.setTourBookingTypeCd((String) row[30]);
	        if (row[31] != null) vo.setPaymentStatusCode((String) row[31]);
	        if (row[32] != null) vo.setBookingStatusCode((String) row[32]);

	        // Op Pic Names
	        if (row[33] != null) vo.setOpPicNames((String) row[33]);

	        feedbackList.add(vo);
	    }

	    System.out.println("Invoice records for feedback email: " + feedbackList.size());

	    return feedbackList;
	}
	
	
	public void insertFeedback(FeedbackVO feedbackVO) throws BusinessException {
	    String sql = "INSERT INTO feedback "
	               + "(id_tour_pkg, id_tour_dep, id_invoice, id_customer, token_uuid, status, created_at) "
	               + "VALUES (:id_tour_pkg, :id_tour_dep, :id_invoice, :id_customer, :token_uuid, :status, NOW())";

//	    String debugSql = sql
//	        .replace(":id_tour_pkg", String.valueOf(feedbackVO.getIdTourPkg()))
//	        .replace(":id_tour_dep", String.valueOf(feedbackVO.getIdTourDeparture()))
//	        .replace(":id_invoice", String.valueOf(feedbackVO.getInvId()))
//	        .replace(":id_customer", String.valueOf(feedbackVO.getCustomerId()))
//	        .replace(":token_uuid",  "'" + feedbackVO.getTokenUuid() + "'")
//	        .replace(":status",      "'" + feedbackVO.getFeedbackStatus() + "'");
//	    System.out.println("[DEBUG] insertFeedback SQL: " + debugSql);

	    Query query = createSQLQuery(sql);
	    query.setParameter("id_tour_pkg", feedbackVO.getIdTourPkg());
	    query.setParameter("id_tour_dep", feedbackVO.getIdTourDeparture());
	    query.setParameter("id_invoice", feedbackVO.getInvId());
	    query.setParameter("id_customer", feedbackVO.getCustomerId());
	    query.setParameter("token_uuid",  feedbackVO.getTokenUuid());
	    query.setParameter("status",      feedbackVO.getFeedbackStatus());
	    query.executeUpdate();
	}
	
	
	@SuppressWarnings("unchecked")
	public List<FeedbackVO> getFeedbackListbyTourDepId(Long idTourDep) throws BusinessException {
	    StringBuilder sb = new StringBuilder();
	    sb.append("SELECT ")
	      .append("f.id AS feedback_id, f.id_tour_pkg, f.id_tour_dep, f.id_customer, f.status, f.customer_answer, ")
	      .append("fq.id AS id_feedback_question, fq.seq_no, fq.section_type, fq.question_code, fq.question_text_en, ")
	      .append("fq.answer_type, fq.is_required, fq.has_remark, fq.placeholder_en, ")
	      .append("fa.id AS id_feedback_answer, fa.answer_label_en, fa.score_value, ")
	      .append("fb_ans.remarks, fb_ans.answer_text, ")
	      .append("td.num_nights, td.dt_dep, td.code AS tour_dep_code, td.op_pic, ")
	      .append("p.id AS person_id, p.salutation_cd, p.first_name, p.last_name, p.email, ")
	      .append("c.id AS customer_id ")
	      .append("FROM feedback f ")
	      .append("JOIN feedback_question fq ON fq.id = fb_ans.id_feedback_question ")
	      .append("LEFT JOIN feedback_answer fa ON fa.id = fb_ans.id_feedback_answer ")
	      .append("LEFT JOIN feedback_response fb_ans ON fb_ans.id_feedback = f.id ")
	      .append("JOIN tour_dep td ON td.id = f.id_tour_dep ")
	      .append("JOIN customer c ON c.id = f.id_customer ")
	      .append("JOIN person p ON p.id = c.id_pc ")
	      .append("WHERE f.id_tour_dep = :idTourDep ")
	      .append("ORDER BY f.id, fq.seq_no");

	    Query query = createSQLQuery(sb.toString());
	    query.setLong("idTourDep", idTourDep);

	    List<Object> results = query.list();
	    List<FeedbackVO> feedbackList = new ArrayList<FeedbackVO>();
	    FeedbackVO vo;

	    for (Iterator<Object> it = results.iterator(); it.hasNext();) {
	        Object[] row = (Object[]) it.next();
	        vo = new FeedbackVO();
	        vo.setIdFeedback(row[0] != null ? ((BigInteger) row[0]).longValue() : null);
	        vo.setIdTourPkg(row[1] != null ? ((BigInteger) row[1]).longValue() : null);
	        vo.setIdTourDeparture(row[2] != null ? ((BigInteger) row[2]).longValue() : null);
	        vo.setCustomerId(row[3] != null ? ((BigInteger) row[3]).longValue() : null);
	        vo.setFeedbackStatus(row[4] != null ? row[4].toString() : null);
	        vo.setCustomerAnswer(row[5] != null ? row[5].toString() : null);
	        vo.setSectionType(row[8] != null ? row[8].toString() : null);
	        vo.setQuestionCode(row[9] != null ? row[9].toString() : null);
	        vo.setQuestionTextEn(row[10] != null ? row[10].toString() : null);
	        vo.setAnswerType(row[11] != null ? row[11].toString() : null);
	        vo.setAnswerLabelEn(row[16] != null ? row[16].toString() : null);
	        vo.setScoreValue(row[17] != null ? Integer.parseInt(row[17].toString()) : 0);
	        vo.setRemarks(row[18] != null ? row[18].toString() : null);
	        vo.setAnswerText(row[19] != null ? row[19].toString() : null);
	        vo.setNumNights(row[20] != null ? ((Short) row[20]).intValue() : 0);
	        vo.setTourCode(row[22] != null ? row[22].toString() : null);
	        vo.setCustomerEmail(row[28] != null ? row[28].toString() : null);

	        String salutation = row[25] != null ? row[25].toString() : "";
	        String firstName  = row[26] != null ? row[26].toString() : "";
	        String lastName   = row[27] != null ? row[27].toString() : "";
	        vo.setCustomerName(
	            (StringUtils.isNotBlank(salutation) ? salutation + ". " : "")
	            + firstName
	            + (StringUtils.isNotBlank(lastName) ? " " + lastName : "")
	        );

	        feedbackList.add(vo);
	    }
	    return feedbackList;
	}
	

}
