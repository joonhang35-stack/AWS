package com.bcs.zsg.common.helper;

public class AppConfigConstant {

	public static String appName;
	public static String uploadPath;
	public static String softwareVersion;
	public static String GAFVersion;

	public static String getAppName() {
		return appName;
	}

	public static void setAppName(String appName) {
		AppConfigConstant.appName = appName;
	}

	/**
	 * @return the uploadPath
	 */
	public static String getUploadPath() {
		return uploadPath;
	}

	/**
	 * @param uploadPath the uploadPath to set
	 */
	public static void setUploadPath(String uploadPath) {
		AppConfigConstant.uploadPath = uploadPath;
	}

	public static String getSoftwareVersion() {
		return softwareVersion;
	}

	public static void setSoftwareVersion(String softwareVersion) {
		AppConfigConstant.softwareVersion = softwareVersion;
	}

	/**
	 * @return the gAFVersion
	 */
	public static String getGAFVersion() {
		return GAFVersion;
	}

	/**
	 * @param gAFVersion the gAFVersion to set
	 */
	public static void setGAFVersion(String gAFVersion) {
		GAFVersion = gAFVersion;
	}
}
