							<p:ajax listener="#{tourPkgBean.handleTwnSharingInput(1)}"
								event="blur"
								update="idGrndOnlyTwn,idGrndOnlySgl,idGrndOnlyCtw,idGrndOnlyCeb,idGrndOnlyCnb" />
						</p:inputText>
						<p:inputText id="idGrndOnlySgl"
							value="#{tourPkgBean.tourDepVO.grndSgl}" style="width:50px; background-color:#{tourPkgBean.tourDepVO.isGroundNotApplicable ? 'grey' : 'white'};"
							disabled="#{tourPkgBean.tourDepVO.isGroundNotApplicable}">
							<f:convertNumber pattern="#,##0.00" />
							<pe:keyFilter regEx="/[\d\.\s,]/" />
						</p:inputText>
						<p:inputText id="idGrndOnlyCtw"
							value="#{tourPkgBean.tourDepVO.grndCtw}" style="width:50px; background-color:#{tourPkgBean.tourDepVO.isGroundNotApplicable ? 'grey' : 'white'};"
							disabled="#{tourPkgBean.tourDepVO.isGroundNotApplicable}">
							<f:convertNumber pattern="#,##0.00" />
							<pe:keyFilter regEx="/[\d\.\s,]/" />
						</p:inputText>
						<p:inputText id="idGrndOnlyCeb"
							value="#{tourPkgBean.tourDepVO.grndCeb}" style="width:50px; background-color:#{tourPkgBean.tourDepVO.isGroundNotApplicable ? 'grey' : 'white'};"
							disabled="#{tourPkgBean.tourDepVO.isGroundNotApplicable}">
							<f:convertNumber pattern="#,##0.00" />
							<pe:keyFilter regEx="/[\d\.\s,]/" />
						</p:inputText>
						<p:inputText id="idGrndOnlyCnb"
							value="#{tourPkgBean.tourDepVO.grndCnb}" style="width:50px; background-color:#{tourPkgBean.tourDepVO.isGroundNotApplicable ? 'grey' : 'white'};"
							disabled="#{tourPkgBean.tourDepVO.isGroundNotApplicable}">
							<f:convertNumber pattern="#,##0.00" />
							<pe:keyFilter regEx="/[\d\.\s,]/" />
						</p:inputText>
					</h:panelGrid>
				</p:column>
			</p:row>
