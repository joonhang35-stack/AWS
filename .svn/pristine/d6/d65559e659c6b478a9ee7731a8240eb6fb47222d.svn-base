						<h:outputLabel for="idFullTourCeb">CEB</h:outputLabel>
						<h:outputLabel for="idFullTourCnb">CNB</h:outputLabel>
						
						<p:inputText id="idGrndOnlyTwn"
							value="#{tourPkgBean.tourDepVO.grndTwn}" style="width:50px; background-color:#{tourPkgBean.tourDepVO.isGroundNotApplicable ? 'grey' : 'white'};"
							disabled="#{tourPkgBean.tourDepVO.isGroundNotApplicable}">
							<f:convertNumber pattern="#,##0.00" />
							<pe:keyFilter regEx="/[\d\.\s,]/" />
