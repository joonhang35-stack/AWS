			<p:row>
				<p:column>
					<h:outputLabel>Agent Commision (RM)</h:outputLabel>
				</p:column>
				<p:column>
					<p:panelGrid>
						<p:row>
							<p:column>
								<h:outputLabel style="width:50px;">ADT/NA</h:outputLabel>
							</p:column>
							<p:column>
								<h:outputLabel style="width:50px;">ADT/PA</h:outputLabel>
							</p:column>
							<p:column>
								<h:outputLabel style="width:50px;">ADT/SI</h:outputLabel>
							</p:column>
						</p:row>
						<p:row>
							<p:column>
								<p:inputText value="#{tourPkgBean.tourDepVO.cnaAdt}"
									style="width:50px">
									<f:convertNumber pattern="#,##0.00" />
									<pe:keyFilter regEx="/[\d\.\s,]/" />
								</p:inputText>
							</p:column>
							<p:column>
								<p:inputText value="#{tourPkgBean.tourDepVO.cpaAdt}"
									style="width:50px">
									<f:convertNumber pattern="#,##0.00" />
									<pe:keyFilter regEx="/[\d\.\s,]/" />
								</p:inputText>
							</p:column>
							<p:column>
								<p:inputText value="#{tourPkgBean.tourDepVO.csiAdt}"
									style="width:50px">
									<f:convertNumber pattern="#,##0.00" />
									<pe:keyFilter regEx="/[\d\.\s,]/" />
								</p:inputText>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel>Staff Comm Config </h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<h:outputText value="#{tourPkgBean.salesCommConfigVO.groupName}"/>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idFullTourRemark">Full Tour Remark</h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<p:inputTextarea id="idFullTourRemark"
						value="#{tourPkgBean.tourDepVO.fullRemarks}"
						style="width:300px; height:80px;" />
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idGroundRemark">Ground Remark</h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<p:inputTextarea id="idGroundRemark"
						value="#{tourPkgBean.tourDepVO.grndRemarks}"
						style="width:300px; height:80px;" />
				</p:column>
			</p:row>

			<p:row>
				<p:column>
					<p:commandButton value="Add Remarks"
						actionListener="#{tourPkgBean.setRemarksAdd(true)}"
						oncomplete="varRemarksDialog.show()" immediate="true"
						update=":idRemarksDialog" />
				</p:column>

				<p:column colspan="3">
					<p:panel id="idRemarksListPanel" style="border:none">
						<p:dataTable id="idRemarksListTable"
							value="#{tourPkgBean.tourDepVO.tourPackageRemarksList}"
							var="remarksVO" rowKey="#{remarksVO.timestamp}"
							selectionMode="single"
							rendered="#{not empty tourPkgBean.tourDepVO.tourPackageRemarksList}">
							<p:column headerText="Edit"
								style="width:50px; text-align:center;">
								<p:commandButton icon="ui-icon-pencil"
									actionListener="#{tourPkgBean.onRemarksSelected(remarksVO)}"
									oncomplete="varRemarksDialog.show()" process="@this"
									update=":idRemarksDialog" />
							</p:column>
							<p:column headerText="Delete"
								style="width:50px; text-align:center;">
								<p:commandButton icon="ui-icon-close"
									actionListener="#{tourPkgBean.deleteRemarks(remarksVO)}"
									update=":idAddTourDepForm:idRemarksListPanel,:idEditTourDepForm:idRemarksListPanel"
									process="@this" />
							</p:column>
							<p:column headerText="Remarks Details">
								<h:outputText value="#{remarksVO.remarksDetails}" />
							</p:column>
							<p:column headerText="Time Stamp">
								<h:outputText value="#{remarksVO.timestamp}">
									<f:convertDateTime pattern="dd-MMM-yyyy HH:mm:ss" />
								</h:outputText>
							</p:column>
						</p:dataTable>
					</p:panel>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idAirline">Airline <span
							class="required">*</span>
					</h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu id="idAirline" label="Airline"
						value="#{tourPkgBean.tourDepVO.idAirline}" effect="fade"
						required="true">
						<f:selectItem itemLabel="Select One" />
						<f:selectItems value="#{tourPkgBean.airlineList}" var="vo"
							itemValue="#{vo.id}" itemLabel="#{vo.code}" />
						<p:ajax listener="#{tourPkgBean.handleAirlineSelect}"
							event="change" update=":idAirlineScheduleListForm, idTourCd"
							oncomplete="varAirlineScheduleListDialog.show()" />
					</h:selectOneMenu>
					<p:commandButton icon="ui-icon-search"
						actionListener="#{tourPkgBean.handleAirlineSelect}"
						update=":idAirlineScheduleListDialog"
						oncomplete="varAirlineScheduleListDialog.show()" process="@this" />
				</p:column>
				<p:column>
					<p:commandLink actionListener="#{tourPkgBean.handleAirlineSelect}"
						update=":idAirlineScheduleListForm"
						oncomplete="varAirlineScheduleListDialog.show()" process="@this"
						style="color:#0040FF; text-decoration:underline;">
						<h:outputText id="idAirlineScheduleDesc"
							value="#{tourPkgBean.tourDepVO.airlineScheduleVO.desc}" />
					</p:commandLink>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idShowAirline">Show Flight Schedule</h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<p:selectBooleanButton id="idShowAirline"
						value="#{tourPkgBean.tourDepVO.isShowAirline}" onLabel="Yes"
						offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close" />
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idPNR">PNR</h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<p:inputText id="idPNR" value="#{tourPkgBean.tourDepVO.prn}"
						maxlength="20" />
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idSeatAllotment">Seat Allotment <span
							class="required">*</span>
					</h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<p:inputText id="idSeatAllotment"
						value="#{tourPkgBean.tourDepVO.seatAllot}" required="true"
						maxlength="3">
						<pe:keyFilter regEx="/[\d]/" />
					</p:inputText>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idTourManagerPax">Tour Manager Pax <span
							class="required">*</span>
					</h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<p:inputText id="idTourManagerPax"
						value="#{tourPkgBean.tourDepVO.tourManagerPax}" required="true"
						maxlength="2">
						<pe:keyFilter regEx="/[\d]/" />
					</p:inputText>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idReservedSeat">Reserved Seat <span
							class="required">*</span>
					</h:outputLabel>
				</p:column>
				<p:column>
					<p:inputText id="idReservedSeat"
						value="#{tourPkgBean.tourDepVO.reservedSeat}" required="true"
						maxlength="2">
						<p:ajax event="blur"
							update=":idAddTourDepForm:idReservedSeatsPanel, :idEditTourDepForm:idReservedSeatsPanel" />
						<pe:keyFilter regEx="/[\d]/" />
					</p:inputText>
				</p:column>
				<p:column colspan="2">
					<p:panelGrid id="idReservedSeatsPanel"
						style="border:0; margin:0; padding:0;">
						<p:row>
							<p:column style="width:80px;">
								<h:outputLabel id="idLabelReservedSeatReas2"
									for="idReservedSeatReas2"
									rendered="#{tourPkgBean.tourDepVO.reservedSeat == 0}">Reason <span
										class="required"><h:outputText value="*"
											rendered="#{tourPkgBean.tourDepVO.reservedSeat > 0}" /></span>
								</h:outputLabel>
								<h:outputLabel id="idLabelReservedSeatReas1"
									for="idReservedSeatReas1"
									rendered="#{tourPkgBean.tourDepVO.reservedSeat > 0}">Reason <span
										class="required"><h:outputText value="*" /></span>
								</h:outputLabel>
							</p:column>
							<p:column>
								<p:inputText id="idReservedSeatReas1"
									label="Reserved Seat Reason"
									value="#{tourPkgBean.tourDepVO.reservedSeatReason}"
									required="true"
									rendered="#{tourPkgBean.tourDepVO.reservedSeat > 0}" />
								<p:inputText id="idReservedSeatReas2"
									value="#{tourPkgBean.tourDepVO.reservedSeatReason}"
									rendered="#{tourPkgBean.tourDepVO.reservedSeat == 0}" />
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<p:commandButton id="idBtnAddDiscount" value="Add Discount"
						actionListener="#{tourPkgBean.initDiscount}"
						oncomplete="varDiscountDialog.show();" process="@this"
						update=":idDiscountDialog, :idAddTourDepForm:msg, :idEditTourDepForm:msg"
						disabled="#{tourPkgBean.discountLimit != 0 and tourPkgBean.tourDepVO.tourDepartureDiscountVOList.size() eq tourPkgBean.discountLimit}" />
				</p:column>
				<p:column colspan="3">
					<p:panel id="idDiscountListPanel" style="border:none">
						<p:dataTable id="idDiscountListTable"
							value="#{tourPkgBean.tourDepVO.tourDepartureDiscountVOList}"
							var="discountVO"
							rendered="#{not empty tourPkgBean.tourDepVO.tourDepartureDiscountVOList}">
							<p:column headerText="Edit"
								style="width:50px; text-align:center;">
								<p:commandButton icon="ui-icon-pencil"
									actionListener="#{tourPkgBean.onDiscountSelected(discountVO)}"
									oncomplete="varDiscountDialog.show()" process="@this"
									update=":idDiscountDialog" />
							</p:column>
							<p:column headerText="Delete"
								style="width:50px; text-align:center;">
								<p:commandButton icon="ui-icon-close"
									actionListener="#{tourPkgBean.deleteDiscount(discountVO)}"
									update=":idAddTourDepForm:idDiscountListPanel,:idEditTourDepForm:idDiscountListPanel, :idAddTourDepForm:idBtnAddDiscount, :idEditTourDepForm:idBtnAddDiscount"
									process="@this" />
							</p:column>
							<p:column headerText="Discount Amount" style="text-align:center;">
								<h:outputText value="#{discountVO.discountAmt}">
									<f:convertNumber pattern="#,##0.00" />
								</h:outputText>
							</p:column>
							<p:column headerText="Discount Pax" style="text-align:center;">
								<h:outputText value="#{discountVO.discountPax}">
								</h:outputText>
							</p:column>
						</p:dataTable>
					</p:panel>
				</p:column>
			</p:row>

			<p:row>
				<p:column>
					<h:outputLabel for="idTrvlInsPolicyS">Trvl Ins Policy (S)</h:outputLabel>
				</p:column>
				<p:column>
					<p:inputTextarea id="idTrvlInsPolicyS"
						value="#{tourPkgBean.tourDepVO.travelInsPolicyS}"
						style="width:200px;" />
				</p:column>
				<p:column>
					<h:outputLabel for="idTrvlInsPolicySIssued">Issued</h:outputLabel>
				</p:column>
				<p:column>
					<p:selectBooleanButton id="idTrvlInsPolicySIssued"
						value="#{tourPkgBean.tourDepVO.isIssuedS}" onLabel="Yes"
						offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close" />
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idTrvlInsPolicyF">Trvl Ins Policy (F)</h:outputLabel>
				</p:column>
				<p:column>
					<p:inputTextarea id="idTrvlInsPolicyF"
						value="#{tourPkgBean.tourDepVO.travelInsPolicyF}"
						style="width:200px;" />
				</p:column>
				<p:column>
					<h:outputLabel for="idTrvlInsPolicyFIssued">Issued</h:outputLabel>
				</p:column>
				<p:column>
					<p:selectBooleanButton id="idTrvlInsPolicyFIssued"
						value="#{tourPkgBean.tourDepVO.isIssuedF}" onLabel="Yes"
						offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close" />
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idTourStatus">Tour Status</h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu id="idTourStatus"
						value="#{tourPkgBean.tourDepVO.tourStatusCd}" effect="fade">
						<f:selectItems value="#{bterp:lookupItemList('tour_status')}"
							var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}" />
						<p:ajax event="change"
							listener="#{tourPkgBean.setIsTourStatusChanged(true)}"
							update=":idAddTourDepForm:idTourStatusReasonPanel, :idEditTourDepForm:idTourStatusReasonPanel" />
					</h:selectOneMenu>
					
					<p:commandButton icon="ui-icon-script" value="Audit Trail"
						actionListener="#{tourPkgBean.loadTourStatusReasonHistoryList}"
						oncomplete="varTourStatusReasonDialog.show()" update=":idTourStatusReasonDialog"
						rendered="#{not empty tourPkgBean.tourDepVO.id}"
						style="margin-left: 8px;"/>
				</p:column>
				
				<p:column colspan="2">
					<p:panelGrid id="idTourStatusReasonPanel" style="border:0; margin:0; padding:0;">
						<p:row>
							<p:column style="width:80px;">
								<h:outputLabel id="idLabelTourStatusReason1" for="idTourStatusReason1"
									 rendered="#{tourPkgBean.tourDepVO.tourStatusCd eq 'R' or tourPkgBean.tourDepVO.tourStatusCd eq 'N'}">Tour Status Reason <span class="required">
									<h:outputText value="*" rendered="#{tourPkgBean.tourDepVO.tourStatusCd eq 'R' or tourPkgBean.tourDepVO.tourStatusCd eq 'N'}"/></span>
								</h:outputLabel>
								<h:outputLabel id="idLabelTourStatusReason2" for="idTourStatusReason2"
									 rendered="#{tourPkgBean.tourDepVO.tourStatusCd ne 'R' and tourPkgBean.tourDepVO.tourStatusCd ne 'N'}">Tour Status Reason </h:outputLabel>
							</p:column>
							<p:column>
								<p:inputTextarea id="idTourStatusReason1" label="Tour Status Reason" value="#{tourPkgBean.tourDepVO.tourStatusReason}" required="true" size="50"
									rendered="#{tourPkgBean.tourDepVO.tourStatusCd eq 'R' or tourPkgBean.tourDepVO.tourStatusCd eq 'N'}"/>
								<p:inputTextarea id="idTourStatusReason2" label="Tour Status Reason" value="#{tourPkgBean.tourDepVO.tourStatusReason}" size="50"
									rendered="#{tourPkgBean.tourDepVO.tourStatusCd ne 'R' and tourPkgBean.tourDepVO.tourStatusCd ne 'N'}"/>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
				
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idDeadline">Deadline <span class="required">*</span></h:outputLabel>
				</p:column>
				<p:column>
					<p:inputText id="idDeadline" value="#{tourPkgBean.tourDepVO.deadline}" required="true" maxlength="3">
						<pe:keyFilter regEx="/[\d]/" />
					</p:inputText>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idVisaRequired">Visa Required</h:outputLabel>
				</p:column>
				<p:column>
					<p:selectBooleanButton label="Visa Required" id="idVisaRequired" value="#{tourPkgBean.tourDepVO.isVisaRequired}"
						onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"/>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idDepositPaid">Deposit Paid</h:outputLabel>
				</p:column>
				<p:column>
					<p:selectBooleanButton id="idDepositPaid"
						value="#{tourPkgBean.tourDepVO.isDepositPaid}" onLabel="Yes"
						offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close" />
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idPush">Is Push</h:outputLabel>
				</p:column>
				<p:column>
					<p:selectBooleanButton id="idPush"
						value="#{tourPkgBean.tourDepVO.isPush}" onLabel="Yes"
						offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close" />
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idHotDeal">Is Hot Deal</h:outputLabel>
				</p:column>
				<p:column>
					<p:selectBooleanButton id="idHotDeal"
						value="#{tourPkgBean.tourDepVO.isHotDeal}" onLabel="Yes"
						offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close" />
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel>
						<p:commandButton value="Hotel"
							oncomplete="varAddHotelDialog.show()" update=":idAddHotelDialog" />
					</h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<p:panel id="idShowHotelList" style="border:0;">
						<p:dataTable value="#{tourPkgBean.tourDepVO.tourHotelList}"
							var="vo"
							rendered="#{not empty tourPkgBean.tourDepVO.tourHotelList}">
							<p:column style="width:30px;">
								<p:commandLink styleClass="ui-icon ui-icon-close"
									actionListener="#{tourPkgBean.delTourHotel(vo)}"
									update=":idAddTourDepForm:idShowHotelList,:idEditTourDepForm:idShowHotelList,:idAddTourHotelForm" />
							</p:column>
							<p:column headerText="From Date" style="width:50px;">
								<h:outputText value="#{vo.fromDate}">
									<f:convertDateTime pattern="dd-MMM-yyyy" />
								</h:outputText>
							</p:column>
							<p:column headerText="To Date" style="width:50px;">
								<h:outputText value="#{vo.toDate}">
									<f:convertDateTime pattern="dd-MMM-yyyy" />
								</h:outputText>
							</p:column>
							<p:column headerText="Hotel Name">
								<h:outputText value="#{vo.hotelVO.name}" />
							</p:column>
						</p:dataTable>
					</p:panel>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel>
						<p:commandButton value="Company Code"
							actionListener="#{tourPkgBean.showTourDepItemList}"
							oncomplete="varDepItemListDialog.show()"
							update=":idDepItemListDialog,:idAddTourDepForm:idDiscountListPanel"
							process="@this,:idAddTourDepForm:idDiscountListPanel" />
					</h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<p:panel id="idShowCompanyCodeList" style="border:0;">
						<ui:repeat value="#{tourPkgBean.tourDepItemList}" var="list">
							<h:outputText value="#{list.get(0).companyVO.name}"
								style="padding:2px 0;" />
							<br />
						</ui:repeat>
					</p:panel>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idInvRemarks">Tour Remarks</h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<p:inputTextarea id="idInvRemarks"
						value="#{tourPkgBean.tourDepVO.invRemarks}" style="width:300px;" />
				</p:column>
			</p:row>
		</p:panelGrid>
	</div>
	<h:panelGrid columns="3" style="width:1px">
		<p:commandButton value="#{msg['common.button.label.save']}"
			actionListener="#{tourPkgBean.addTourDep}"
			update="@form,:idTourDepListForm:idTourDepList"
			rendered="#{empty tourPkgBean.tourDepVO.id}" />
		<p:commandButton value="#{msg['common.button.label.update']}"
			actionListener="#{tourPkgBean.setReasonType2}"
			oncomplete="onTourDepReasonValidation(xhr, status, args)"
			update="@form,:idTourDepListForm:idTourDepList"
			rendered="#{not empty tourPkgBean.tourDepVO.id}" />
		<p:commandButton value="Airfare Update" style="width:200px;"
			oncomplete="varUpdDocAirfareDialog.show()"
			update="@form"
			rendered="#{not empty tourPkgBean.tourDepVO.id}" />
		<p:commandButton value="#{msg['common.button.label.cancel']}"
			actionListener="#{tourPkgBean.resetTourDepForm}"
			oncomplete="varAddTourDepDialog.hide(),varEditTourDepDialog.hide()"
			process="@this" update="@form">
			<pe:resetEditableValues for="idAddTourDepForm,idEditTourDepForm" />
		</p:commandButton>
	</h:panelGrid>
</ui:composition>