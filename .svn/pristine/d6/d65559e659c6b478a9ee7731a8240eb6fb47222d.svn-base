<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui"
	xmlns:pe="http://primefaces.org/ui/extensions"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

	<script type="text/javascript">
		function onTourDepValidation(xhr, status, args) {
			if (!args.validationFailed) {
				varEditTourDepDialog.hide();
			}
		}

		function onTourDepReasonValidation(xhr, status, args) {
			if (!args.validationFailed) {
				varTourDepReasonDialog.show();
			}
		}
	</script>
	<p:growl id="msg" />
	<div style="height: 500px; overflow: auto;">
		<p:panelGrid>
			<p:row>
				<p:column>
					<h:outputLabel for="idSeqNo">Sequence Number</h:outputLabel>
				</p:column>
				<p:column colspan="2">
					<p:inputText label="Sequence Number" id="idSeqNo"
						value="#{tourPkgBean.tourDepVO.seqNo}" maxlength="4" style="width:50px" >
					</p:inputText>
					<span style="font-style: italic; font-size: 9px; color: #333333;">max:
						4 char</span>
				</p:column>
				<p:column>
					<p:panelGrid style="border:0; margin:0; padding:0;">
						<p:row>
							<p:column style="width:100px;">
								<h:outputLabel for="idPushToOnline">Push To Online</h:outputLabel>
							</p:column>
							<p:column>
								<p:selectBooleanButton label="Push To Online" id="idPushToOnline" value="#{tourPkgBean.tourDepVO.isPushToOnline}"
									onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"/>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel>Departure ID </h:outputLabel>
				</p:column>
				<p:column colspan="2">#{tourPkgBean.tourDepVO.id} </p:column>
				<p:column>
					<p:panelGrid style="border:0; margin:0; padding:0;">
						<p:row>
							<p:column style="width:100px;">
								<h:outputLabel for="idOpPicList">OP PIC</h:outputLabel>
							</p:column>
							<p:column>
								<p:selectCheckboxMenu id="idOpPicList" label="OP PIC"
									value="#{tourPkgBean.tourDepVO.opPicList}" filter="true" filterMatchMode="contains" onHide="executeOnOpPicOnhide();" style="display: flex;width: fit-content;">
									<f:selectItems value="#{tourPkgBean.employeeList}" var="picVO" itemValue="#{picVO.id}" itemLabel="#{picVO.userVO.name}"/>
								</p:selectCheckboxMenu>
								<p:remoteCommand name="executeOnOpPicOnhide" actionListener="#{tourPkgBean.handleOpPicChange('DEP')}" update="idTxtOpPicName" global="false"
									process="@this, idOpPicList"/>
								<p:outputLabel id="idTxtOpPicName" value="#{tourPkgBean.tourDepVO.opPicName}" style="float:left;" />
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
				<!-- <p:column>
					<p:panelGrid style="border:0; margin:0; padding:0;">
						<p:row>
							<p:column style="width:100px;">
								<h:outputLabel for="idPromotion">Promotion</h:outputLabel>
							</p:column>
							<p:column>
								<p:selectBooleanButton label="Promotion" id="idPromotion" value="#{tourPkgBean.tourDepVO.isPromo}"
									onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close">
								</p:selectBooleanButton>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column> -->
			</p:row>
			<p:row>
				<p:column style="width:150px"></p:column>
				<p:column style="width:100px">
					<p:inputText label="Days" value="#{tourPkgBean.tourDepVO.numDays}"
						style="width:50px" /> Days</p:column>
				<p:column>
					<p:inputText label="Nights"
						value="#{tourPkgBean.tourDepVO.numNights}" style="width:50px" /> Nights</p:column>
				<p:column>
					<p:panelGrid id="idTourLeaderPanel" style="border:0; margin:0; padding:0;">
						<p:row>
							<p:column style="width:100px;">
								<h:outputLabel for="idTourLeader">Tour Leader</h:outputLabel>
							</p:column>
							<p:column>
								<p:selectOneMenu id="idTourLeader" Label="Tour Leader" value="#{tourPkgBean.tourDepVO.idTourLeader}"
									 filter="true" filterMatchMode="contains" style="width:150px;">  
						           <f:selectItem itemLabel="Select One" itemValue="" />  
						           <f:selectItems value="#{tourPkgBean.employeeList}" var="vo" itemLabel="#{vo.userVO.name}" itemValue="#{vo.id}" /> 
							    </p:selectOneMenu>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
				<!-- <p:column>
					<p:panelGrid style="border:0; margin:0; padding:0;">
						<p:row>
							<p:column style="width:100px;">
								<h:outputLabel/>
							</p:column>
							<p:column>
								<p:calendar id="idDtPromoFrom" label="Promotion From" navigator="true" showButtonPanel="true"
									value="#{tourPkgBean.tourDepVO.dtPromoFrom}" pattern="dd-MMM-yyyy" size="11">
								</p:calendar>
								<p:watermark for="idDtPromoFrom" value="Promo From" />
							</p:column>
							<p:column>
								<p:calendar id="idDtPromoTo" label="Promotion To" navigator="true" showButtonPanel="true"
									value="#{tourPkgBean.tourDepVO.dtPromoFrom}" pattern="dd-MMM-yyyy" size="11">
								</p:calendar>
								<p:watermark for="idDtPromoTo" value="Promo To" />
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column> -->
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idDtDep">Departure <span
							class="required">*</span>
					</h:outputLabel>
				</p:column>
				<p:column colspan="2">
					<p:calendar id="idDtDep" label="Departure" navigator="true" showButtonPanel="true"
						value="#{tourPkgBean.tourDepVO.dtDep}" pattern="dd-MMM-yyyy" mindate="#{tourPkgBean.minDate}"
                    	maxdate="#{tourPkgBean.maxDate}" required="true">
						<p:ajax event="dateSelect"
							listener="#{tourPkgBean.handleDepartureDateChange}"
							update="idDtDep, idTourCd" global="false" />
					</p:calendar>
					<span style="font-style: italic; font-size: 9px; color: #333333;">(dd-MMM-yyyy)</span>
				</p:column>
				<p:column>
					<p:panelGrid id="idTourGuidePenal" style="border:0; margin:0; padding:0;">
						<p:row>
							<p:column style="width:100px;">
								<h:outputLabel for="idTourGuide">Tour Guide</h:outputLabel>
							</p:column>
							<p:column>
								<p:selectOneMenu id="idTourGuide" Label="Tour Guide" value="#{tourPkgBean.tourDepVO.idTourGuide}"
									 filter="true" filterMatchMode="contains" style="width:150px;">  
						           <f:selectItem itemLabel="Select One" itemValue="" />  
						           <f:selectItems value="#{tourPkgBean.employeeList}" var="vo" itemLabel="#{vo.userVO.name}" itemValue="#{vo.id}" /> 
							    </p:selectOneMenu>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idTourCd">Tour Code <span
							class="required">*</span>
					</h:outputLabel>
				</p:column>
				<p:column colspan="2">
					<p:inputText id="idTourCd" label="Tour Code"
						value="#{tourPkgBean.tourDepVO.code}" maxlength="30"
						required="true">
						<p:ajax global="false" />
					</p:inputText>
					<span style="font-style: italic; font-size: 9px; color: #333333;">max:
						30 char</span>
				</p:column>
				<p:column>
					<p:panelGrid style="border:0; margin:0; padding:0;">
						<p:row>
							<p:column style="width:100px;">
								<h:outputLabel for="idPrivateTour">Private Tour</h:outputLabel>
							</p:column>
							<p:column>
								<p:selectBooleanButton label="Private Tour" id="idPrivateTour" value="#{tourPkgBean.tourDepVO.isPrivateTour}"
									onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close">
									<p:ajax event="change"
										update=":idAddTourDepForm:idPrivatePICPanel,:idEditTourDepForm:idPrivatePICPanel" />	
								</p:selectBooleanButton>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idTourDesc">Desc</h:outputLabel>
				</p:column>
				<p:column colspan="2">
					<p:inputText id="idTourDesc" value="#{tourPkgBean.tourDepVO.desc}"
						maxlength="100" style="width:500px;" />
					<span style="font-style: italic; font-size: 9px; color: #333333;">max:
						100 char</span>
				</p:column>
				<p:column>
					<p:panelGrid id="idPrivatePICPanel" style="border:0; margin:0; padding:0;">
						<p:row rendered="#{tourPkgBean.tourDepVO.isPrivateTour}">
							<p:column style="width:100px;">
								<h:outputLabel for="idPrivatePicList">PIC <span class="required">*</span></h:outputLabel>
							</p:column>
							<p:column>
								<p:selectCheckboxMenu id="idPrivatePicList" label="Private PIC" required="true"
									value="#{tourPkgBean.tourDepVO.privatePicList}" filter="true" filterMatchMode="contains"
									onHide="executeOnPrivatePicOnhide();" style="display: flex;width: fit-content;">
									<f:selectItems value="#{tourPkgBean.employeeList}" var="pvtPicVO" itemValue="#{pvtPicVO.id}" itemLabel="#{pvtPicVO.userVO.name}"/>
								</p:selectCheckboxMenu>
								<p:remoteCommand name="executeOnPrivatePicOnhide" actionListener="#{tourPkgBean.handlePrivatePicChange('DEP')}" update="idTxtPrivatePicName" global="false"
									process="@this, idPrivatePicList"/>
								<p:outputLabel id="idTxtPrivatePicName" value="#{tourPkgBean.tourDepVO.privatePicName}" style="float:left;" />
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idTourDescZh">Desc (Chinese)</h:outputLabel>
				</p:column>
				<p:column colspan="2">
					<p:inputText id="idTourDescZh" value="#{tourPkgBean.tourDepVO.descZh}"
						maxlength="100" style="width:500px;" />
					<span style="font-style: italic; font-size: 9px; color: #333333;">max:
						100 char</span>
				</p:column>
				<p:column>
					<p:panelGrid style="border:0; margin:0; padding:0;">
						<p:row>
							<p:column style="width:100px;">
								<h:outputLabel for="idLock">Invoice Lock</h:outputLabel>
							</p:column>
							<p:column>
								<p:selectBooleanButton label="Invoice Lock" id="idLock" value="#{tourPkgBean.tourDepVO.isLock}"
									onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close">
									<p:ajax event="change" listener="#{tourPkgBean.setIsTourDepLockChanged(true)}" global="false"/>
								</p:selectBooleanButton>
								<pe:tooltip for="idLock">
									<h:outputText value="Once lock all booking referring invoice remarks will not able to edit."/>
								</pe:tooltip>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idSeason">Season</h:outputLabel>
				</p:column>
				<p:column colspan="2">
					<p:selectManyCheckbox id="idSeason" label="Season"
						value="#{tourPkgBean.tourDepVO.selectedSeason}">
						<f:selectItems value="#{tourPkgBean.refDataListSeason}" var="vo"
							itemLabel="#{vo.value}" itemValue="#{vo.code}" />
						<p:ajax event="change" update="idSeason"
							listener="#{tourPkgBean.selectAllSeason}" global="false" />
					</p:selectManyCheckbox>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idDepartDateBadge">Depart Date Badge</h:outputLabel>
				</p:column>
				<p:column colspan="2">
					<p:selectCheckboxMenu id="idDepartDateBadge" value="#{tourPkgBean.tourDepVO.departDateBadgeList}" label="Depart Date Badge" filter="true" filterMatchMode="contains" onHide="executeOnBadgeOnhide();" style="display: flex;width: fit-content;">
						<f:selectItems value="#{bterp:lookupItemList('depart_date_badge')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
					</p:selectCheckboxMenu>
					<p:remoteCommand name="executeOnBadgeOnhide" actionListener="#{tourPkgBean.handleDepartDateBadgeChange(false)}" update="idTxtDeptDateBadgeTag" global="false" />
					<p:outputLabel id="idTxtDeptDateBadgeTag" value="#{tourPkgBean.deptDateDesc}" style="float:left;"/>
				</p:column>
			</p:row>
			
			<p:row>
				<p:column>
					<h:outputLabel for="idDepartDateBadgeZh">Depart Date Badge (Chinese)</h:outputLabel>
				</p:column>
				<p:column colspan="2">
					<p:selectCheckboxMenu id="idDepartDateBadgeZh" value="#{tourPkgBean.tourDepVO.departDateBadgeZhList}" label="Depart Date Badge (Chinese)" filter="true" filterMatchMode="contains" onHide="executeOnBadgeZHOnhide();" style="display: flex;width: fit-content;">
						<f:selectItems value="#{bterp:lookupItemList('depart_date_badge_zh')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
					</p:selectCheckboxMenu>
					<p:remoteCommand name="executeOnBadgeZHOnhide" actionListener="#{tourPkgBean.handleDepartDateBadgeChange(true)}" update="idTxtDeptDateBadgeZHTag" global="false" />
					<p:outputLabel id="idTxtDeptDateBadgeZHTag" value="#{tourPkgBean.deptDateZhDesc}" style="float:left;"/>
				</p:column>
			</p:row>
			<p:row>
				<p:column><h:outputLabel for="idLanguage">Language <span class="required">*</span></h:outputLabel></p:column>
				<p:column colspan="2">
					<h:selectOneMenu id="idLanguage" label="Season" value="#{tourPkgBean.tourDepVO.langCode}" effect="fade" required="true">
						<f:selectItems value="#{bterp:lookupItemList('product_lang')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
					</h:selectOneMenu>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idDailyCMS">Itinerary CMS</h:outputLabel>
				</p:column>
				<p:column colspan="2">
					<h:selectOneMenu id="idDailyCMS" label="Itinerary CMS"
						value="#{tourPkgBean.tourDepVO.tourPkgDailyCms}"
						effect="fade">
						<f:selectItem itemLabel="Select One" />
						<f:selectItems value="#{tourPkgBean.tourDepVO.tourPkgDailyItineraryVOList}"
							var="vo" itemLabel="#{vo.code} - #{vo.title}" itemValue="#{vo.id}" />
					</h:selectOneMenu>
				</p:column>
			</p:row>

			<p:row>
				<p:column>
					<h:outputLabel>Customer Itinerary</h:outputLabel>
				</p:column>
				<p:column colspan="2"></p:column>
			</p:row>
		</p:panelGrid>
		<p:panelGrid id="idShowTourItineries">
			<p:row>
				<p:column style="width:150px">
					<h:outputLabel>
						<p:commandButton value="English"
							actionListener="#{tourPkgBean.handleTourItineryButtonClick('CUST', 'EN')}"
							process="@this" oncomplete="varAddCustItineryDialog.show()"
							update=":idAddCustItineryDialog" />
					</h:outputLabel>
				</p:column>
				<p:column>
					<p:panelGrid id="idCustItineryEN" style="border:0">
						<p:row>
							<p:column style="width:20px">
								<p:commandLink styleClass="ui-icon ui-icon-close"
									actionListener="#{tourPkgBean.delTourItinery('CUST', 'EN')}"
									update=":idAddTourDepForm:idCustItineryEN,:idEditTourDepForm:idCustItineryEN, :idAddTourDepForm:idCustItineryENUploadBy, :idEditTourDepForm:idCustItineryENUploadBy"
									process="@this"
									rendered="#{not empty tourPkgBean.itineryMap['CUSTEN'] and not tourPkgBean.itineryMap['CUSTEN'].isFromPkg}" />
							</p:column>
							<p:column>
								<h:outputText
									rendered="#{not tourPkgBean.itineryMap['CUSTEN'].isFromPkg}"
									value="#{tourPkgBean.itineryMap['CUSTEN'].name}" />
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
			</p:row>
			<p:row>
				<p:column />
				<p:column>
					<p:panelGrid id="idCustItineryENUploadBy" style="border:0">
						<p:row
							rendered="#{not empty tourPkgBean.itineryMap['CUSTEN'] and not tourPkgBean.itineryMap['CUSTEN'].isFromPkg}">
							<p:column style="width:75px;">
								<h:outputText value="Upload Date:" />
							</p:column>
							<p:column style="width:150px;">
								<p:inputText
									value="#{tourPkgBean.itineryMap['CUSTEN'].createdDate}"
									readonly="true" style="background:#ccc">
									<f:convertDateTime pattern="dd-MMM-yyyy" />
								</p:inputText>
							</p:column>
							<p:column style="width:75px;">
								<h:outputText value="Upload By:" />
							</p:column>
							<p:column>
								<p:inputText
									value="#{tourPkgBean.itineryMap['CUSTEN'].createdBy}"
									readonly="true" style="background:#ccc" />
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel>
						<p:commandButton value="Chinese/Malay"
							actionListener="#{tourPkgBean.handleTourItineryButtonClick('CUST', 'ZH')}"
							process="@this" oncomplete="varAddCustItineryDialog.show()"
							update=":idAddCustItineryDialog" />
					</h:outputLabel>
				</p:column>
				<p:column>
					<p:panelGrid id="idCustItineryZH" style="border:0">
						<p:row>
							<p:column style="width:20px">
								<p:commandLink styleClass="ui-icon ui-icon-close"
									actionListener="#{tourPkgBean.delTourItinery('CUST', 'ZH')}"
									update=":idAddTourDepForm:idCustItineryZH,:idEditTourDepForm:idCustItineryZH,:idAddTourDepForm:idCustItineryZHUploadBy,:idEditTourDepForm:idCustItineryZHUploadBy"
									process="@this"
									rendered="#{not empty tourPkgBean.itineryMap['CUSTZH'] and not tourPkgBean.itineryMap['CUSTZH'].isFromPkg}" />
							</p:column>
							<p:column>
								<h:outputText
									rendered="#{not tourPkgBean.itineryMap['CUSTZH'].isFromPkg}"
									value="#{tourPkgBean.itineryMap['CUSTZH'].name}" />
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
			</p:row>
			<p:row>
				<p:column />
				<p:column>
					<p:panelGrid id="idCustItineryZHUploadBy" style="border:0">
						<p:row
							rendered="#{not empty tourPkgBean.itineryMap['CUSTZH'] and not tourPkgBean.itineryMap['CUSTZH'].isFromPkg}">
							<p:column style="width:75px;">
								<h:outputText value="Upload Date:" />
							</p:column>
							<p:column style="width:150px;">
								<p:inputText
									value="#{tourPkgBean.itineryMap['CUSTZH'].createdDate}"
									readonly="true" style="background:#ccc">
									<f:convertDateTime pattern="dd-MMM-yyyy" />
								</p:inputText>
							</p:column>
							<p:column style="width:75px;">
								<h:outputText value="Upload By:" />
							</p:column>
							<p:column>
								<p:inputText
									value="#{tourPkgBean.itineryMap['CUSTZH'].createdBy}"
									readonly="true" style="background:#ccc" />
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel>Agent Itinerary</h:outputLabel>
				</p:column>
				<p:column></p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel>
						<p:commandButton value="English"
							actionListener="#{tourPkgBean.handleTourItineryButtonClick('AGENT', 'EN')}"
							process="@this" oncomplete="varAddAgentItineryDialog.show()"
							update=":idAddAgentItineryDialog" />
					</h:outputLabel>
				</p:column>
				<p:column>
					<p:panelGrid id="idAgentItineryEN" style="border:0">
						<p:row>
							<p:column style="width:20px">
								<p:commandLink styleClass="ui-icon ui-icon-close"
									actionListener="#{tourPkgBean.delTourItinery('AGENT', 'EN')}"
									update=":idAddTourDepForm:idAgentItineryEN,:idEditTourDepForm:idAgentItineryEN,:idAddTourDepForm:idAgentItineryENUploadBy,:idEditTourDepForm:idAgentItineryENUploadBy"
									process="@this"
									rendered="#{not empty tourPkgBean.itineryMap['AGENTEN'] and not tourPkgBean.itineryMap['AGENTEN'].isFromPkg}" />
							</p:column>
							<p:column>
								<h:outputText
									rendered="#{not tourPkgBean.itineryMap['AGENTEN'].isFromPkg}"
									value="#{tourPkgBean.itineryMap['AGENTEN'].name}" />
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
			</p:row>
			<p:row>
				<p:column />
				<p:column>
					<p:panelGrid id="idAgentItineryENUploadBy" style="border:0">
						<p:row
							rendered="#{not empty tourPkgBean.itineryMap['AGENTEN'] and not tourPkgBean.itineryMap['AGENTEN'].isFromPkg}">
							<p:column style="width:75px;">
								<h:outputText value="Upload Date:" />
							</p:column>
							<p:column style="width:150px;">
								<p:inputText
									value="#{tourPkgBean.itineryMap['AGENTEN'].createdDate}"
									readonly="true" style="background:#ccc">
