			<p:row>
				<p:column>
					<h:outputLabel>Airfare <span class="required">*</span></h:outputLabel> 
				</p:column>
				<p:column colspan="3">
					<h:panelGrid columns="5" style="text-align:center; border-collapse:collapse;">
						<h:outputLabel for="idAirfareOnlyTwn">TWN</h:outputLabel>
						<h:outputLabel for="idAirfareOnlySgl">SGL</h:outputLabel>
						<h:outputLabel for="idAirfareOnlyCtw">CTW</h:outputLabel>
						<h:outputLabel for="idAirfareOnlyCeb">CEB</h:outputLabel>
						<h:outputLabel for="idAirfareOnlyCnb">CNB</h:outputLabel>

						<p:inputText id="idAirfareOnlyTwn" label="Airfare TWN" required="true"
							value="#{tourPkgBean.tourDepVO.airfareTwn}" style="width:50px">
							<f:convertNumber pattern="#,##0.00" />
							<pe:keyFilter regEx="/[\d\.\s,]/" />
