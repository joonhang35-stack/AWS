								event="blur"
								update="idAirfareOnlyTwn,idAirfareOnlySgl,idAirfareOnlyCtw,idAirfareOnlyCeb,idAirfareOnlyCnb,idGrndOnlyTwn,idGrndOnlySgl,idGrndOnlyCtw,idGrndOnlyCeb,idGrndOnlyCnb" />
						</p:inputText>
						<p:inputText id="idAirfareOnlySgl" label="Airfare SGL" required="true"
							value="#{tourPkgBean.tourDepVO.airfareSgl}" style="width:50px">
							<f:convertNumber pattern="#,##0.00" />
							<pe:keyFilter regEx="/[\d\.\s,]/" />
							<p:ajax listener="#{tourPkgBean.handleCalculateGrndInput()}"
								event="blur"
								update="idGrndOnlySgl" />
						</p:inputText>
						<p:inputText id="idAirfareOnlyCtw" label="Airfare CTW" required="true"
							value="#{tourPkgBean.tourDepVO.airfareCtw}" style="width:50px">
							<f:convertNumber pattern="#,##0.00" />
							<pe:keyFilter regEx="/[\d\.\s,]/" />
							<p:ajax listener="#{tourPkgBean.handleCalculateGrndInput()}"
								event="blur"
								update="idGrndOnlyCtw" />
						</p:inputText>
						<p:inputText id="idAirfareOnlyCeb" label="Airfare CEB" required="true"
							value="#{tourPkgBean.tourDepVO.airfareCeb}" style="width:50px">
							<f:convertNumber pattern="#,##0.00" />
							<pe:keyFilter regEx="/[\d\.\s,]/" />
							<p:ajax listener="#{tourPkgBean.handleCalculateGrndInput()}"
								event="blur"
								update="idGrndOnlyCeb" />
						</p:inputText> 
						<p:inputText id="idAirfareOnlyCnb" label="Airfare CNB" required="true"
							value="#{tourPkgBean.tourDepVO.airfareCnb}" style="width:50px">
							<f:convertNumber pattern="#,##0.00" />
							<pe:keyFilter regEx="/[\d\.\s,]/" />
							<p:ajax listener="#{tourPkgBean.handleCalculateGrndInput()}"
								event="blur"
								update="idGrndOnlyCnb" />
						</p:inputText>
					</h:panelGrid>
				</p:column>
			</p:row>
			<p:row>
				<p:column style="width:225px; padding-left:0px" >
					<h:panelGrid columns="2" style="border-collapse:collapse;">
						<h:outputLabel>Ground Only</h:outputLabel>
            			<p:selectBooleanCheckbox id="idCheckboxNotApplicable" itemLabel="Not Applicable" value="#{tourPkgBean.tourDepVO.isGroundNotApplicable}">
            				<p:ajax listener="#{tourPkgBean.handleCheckboxNotApplicable}" 
            					event="change"
								update="idGrndOnlyTwn,idGrndOnlySgl,idGrndOnlyCtw,idGrndOnlyCeb,idGrndOnlyCnb" process="@this"/>
