									actionListener="#{tourPkgBean.delTourItinery('AGENT', 'ZH')}"
									update=":idAddTourDepForm:idAgentItineryZH,:idEditTourDepForm:idAgentItineryZH,:idAddTourDepForm:idAgentItineryZHUploadBy,:idEditTourDepForm:idAgentItineryZHUploadBy"
									process="@this"
									rendered="#{not empty tourPkgBean.itineryMap['AGENTZH'] and not tourPkgBean.itineryMap['AGENTZH'].isFromPkg}" />
							</p:column>
							<p:column>
								<h:outputText
									rendered="#{not tourPkgBean.itineryMap['AGENTZH'].isFromPkg}"
									value="#{tourPkgBean.itineryMap['AGENTZH'].name}" />
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:column>
			</p:row>
			<p:row>
