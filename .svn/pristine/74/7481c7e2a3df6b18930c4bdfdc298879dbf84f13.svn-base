package com.bcs.zsg.product.vo;

import java.util.Date;

import com.bcs.zsg.core.vo.BaseVO;

public class TicketingVO extends BaseVO {

	private static final long serialVersionUID = 1L;

	private Long idAirline;
	private String destination;
	private String desc;
	private Double priceFrom;
	private Double priceTo;
	private Date dtBookStart;
	private Date dtBookEnd;
	private Date dtTrvlStart;
	private Date dtTrvlEnd;
	private Boolean isPromo;

	/**
	 * @return the idAirline
	 */
	public Long getIdAirline() {
		return idAirline;
	}

	/**
	 * @param idAirline the idAirline to set
	 */
	public void setIdAirline(Long idAirline) {
		this.idAirline = idAirline;
	}

	/**
	 * @return the destination
	 */
	public String getDestination() {
		return destination;
	}

	/**
	 * @param destination the destination to set
	 */
	public void setDestination(String destination) {
		this.destination = destination;
	}

	/**
	 * @return the desc
	 */
	public String getDesc() {
		return desc;
	}

	/**
	 * @param desc the desc to set
	 */
	public void setDesc(String desc) {
		this.desc = desc;
	}

	/**
	 * @return the priceFrom
	 */
	public Double getPriceFrom() {
		return priceFrom;
	}

	/**
	 * @param priceFrom the priceFrom to set
	 */
	public void setPriceFrom(Double priceFrom) {
		this.priceFrom = priceFrom;
	}

	/**
	 * @return the priceTo
	 */
	public Double getPriceTo() {
		return priceTo;
	}

	/**
	 * @param priceTo the priceTo to set
	 */
	public void setPriceTo(Double priceTo) {
		this.priceTo = priceTo;
	}

	/**
	 * @return the dtBookStart
	 */
	public Date getDtBookStart() {
		return dtBookStart;
	}

	/**
	 * @param dtBookStart the dtBookStart to set
	 */
	public void setDtBookStart(Date dtBookStart) {
		this.dtBookStart = dtBookStart;
	}

	/**
	 * @return the dtBookEnd
	 */
	public Date getDtBookEnd() {
		return dtBookEnd;
	}

	/**
	 * @param dtBookEnd the dtBookEnd to set
	 */
	public void setDtBookEnd(Date dtBookEnd) {
		this.dtBookEnd = dtBookEnd;
	}

	/**
	 * @return the dtTrvlStart
	 */
	public Date getDtTrvlStart() {
		return dtTrvlStart;
	}

	/**
	 * @param dtTrvlStart the dtTrvlStart to set
	 */
	public void setDtTrvlStart(Date dtTrvlStart) {
		this.dtTrvlStart = dtTrvlStart;
	}

	/**
	 * @return the dtTrvlEnd
	 */
	public Date getDtTrvlEnd() {
		return dtTrvlEnd;
	}

	/**
	 * @param dtTrvlEnd the dtTrvlEnd to set
	 */
	public void setDtTrvlEnd(Date dtTrvlEnd) {
		this.dtTrvlEnd = dtTrvlEnd;
	}

	/**
	 * @return the isPromo
	 */
	public Boolean getIsPromo() {
		return isPromo;
	}

	/**
	 * @param isPromo the isPromo to set
	 */
	public void setIsPromo(Boolean isPromo) {
		this.isPromo = isPromo;
	}
}
