package com.bcs.zsg.product.vo;

import com.bcs.zsg.core.vo.BaseVO;

public class RoomingListLandOperatorContVO extends BaseVO{
	private static final long serialVersionUID = 1L;
	private Long idLandOperator;
	private String contactType;
	private String contactNo;
	
	public Long getIdLandOperator() {
		return idLandOperator;
	}
	public void setIdLandOperator(Long idLandOperator) {
		this.idLandOperator = idLandOperator;
	}
	public String getContactType() {
		return contactType;
	}
	public void setContactType(String contactType) {
		this.contactType = contactType;
	}
	public String getContactNo() {
		return contactNo;
	}
	public void setContactNo(String contactNo) {
		this.contactNo = contactNo;
	}
}
