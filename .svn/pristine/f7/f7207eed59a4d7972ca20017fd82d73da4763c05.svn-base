	@SuppressWarnings("unchecked")
	@Override
	public List<AcctTransVO> getAcctTransList(Long CompId) throws BusinessException {
		Criteria criteria = createCriteria(AcctTransVO.class);
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
		criteria.add(Restrictions.eq("companyId",CompId));
		criteria.addOrder(Order.asc("id"));
		return criteria.list();
	}

	@SuppressWarnings("unchecked")
	@Override
	public List<CashBookVO> getCashBookList() throws BusinessException {
		Criteria criteria = createCriteria(CashBookVO.class);
		criteria.addOrder(Order.asc("id"));
		return criteria.list();
	}

	@SuppressWarnings("unchecked")
	@Override
	public List<BankAcctVO> getBankAcctList() throws BusinessException {
		Criteria criteria = createCriteria(BankAcctVO.class);
		criteria.addOrder(Order.asc("id"));
		return criteria.list();
	}

	@SuppressWarnings("unchecked")
	@Override
	public List<AcctVO> getAcctList(Long idCompany,String strAutoComplete) throws BusinessException {
		Query query = createSQLQuery("SELECT id FROM account where CONCAT(code,'-',sub_code) like '" + strAutoComplete + "%'");
		//query.setString("strAutoComplete", strAutoComplete);
		List<Object> results = query.list();
		List<Long> acctIdList = new ArrayList<Long>();

		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			BigInteger id = (BigInteger) it.next();
			acctIdList.add(id.longValue());
		}
		
		if (CollectionUtils.isNotEmpty(acctIdList)) {
			Criteria criteria = createCriteria(AcctVO.class);
			criteria.add(Restrictions.eq("idCompany",idCompany));
			criteria.add(Restrictions.in("id", acctIdList));
			criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
			return criteria.list();
		}
		return null;
	}

	@Override
	public AcctVO getAcctDescList(String acctCd,String acctSubCd,Long CompId) throws BusinessException {
		Criteria criteria = getSession().createCriteria(AcctVO.class);
		criteria.add(Restrictions.eq("code",acctCd));
		criteria.add(Restrictions.eq("subCode",acctSubCd));
		criteria.add(Restrictions.eq("idCompany",CompId));
		return (AcctVO)criteria.uniqueResult();
	}

	@Override
	public BankAcctVO getBankAcctSearchList(Long idBank) throws BusinessException {
