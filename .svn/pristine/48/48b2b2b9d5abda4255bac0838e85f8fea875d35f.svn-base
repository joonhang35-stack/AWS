<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.acct.vo">

    <class table="account_bal" name="AcctBalVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idAcct" type="long" column="id_acct"/>
        <property name="debitBeginBal" type="double" column="debit_begin_bal"/>
        <property name="creditBeginBal" type="double" column="credit_begin_bal"/>
        <property name="debitCurrentBal" type="double" column="debit_current_bal"/>
        <property name="creditCurrentBal" type="double" column="credit_current_bal"/>
        <property name="debitCloseBal" type="double" column="debit_close_bal"/>
        <property name="creditCloseBal" type="double" column="credit_close_bal"/>
        <property name="dtBeginBal" type="timestamp" column="dt_begin_bal"/>
        <property name="dtCurrentBal" type="timestamp" column="dt_current_bal"/>
        <property name="dtCloseBal" type="timestamp" column="dt_close_bal"/>
        <property name="typeCode" type="string" column="type_cd"/>
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>