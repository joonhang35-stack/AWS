package com.bcs.zsg.acct.vo;

import java.util.Date;

import com.bcs.zsg.core.vo.BaseVO;

public class EInvoiceSchedulerLogVO extends BaseVO {
	private static final long serialVersionUID = 1L;

	private Long idCompany;
	private String schedulerName;
	private Date dtExec;
	private Integer execTime;
	private Integer docCnt;
	
	public Integer getExecTime() {
		return execTime;
	}
	public void setExecTime(Integer execTime) {
		this.execTime = execTime;
	}
	public Long getIdCompany() {
		return idCompany;
	}
	public void setIdCompany(Long idCompany) {
		this.idCompany = idCompany;
	}
	public String getSchedulerName() {
		return schedulerName;
	}
	public void setSchedulerName(String schedulerName) {
		this.schedulerName = schedulerName;
	}
	public Date getDtExec() {
		return dtExec;
	}
	public void setDtExec(Date dtExec) {
		this.dtExec = dtExec;
	}
	public Integer getDocCnt() {
		return docCnt;
	}
	public void setDocCnt(Integer docCnt) {
		this.docCnt = docCnt;
	}

}
