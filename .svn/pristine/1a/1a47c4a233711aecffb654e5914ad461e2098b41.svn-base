package com.bcs.zsg.web.object;

public class tempObjClass {

	public String tempStr1;
	public String tempStr2;
	
	public tempObjClass()
	{
		
	}
	
	public void setTempStr1(String tempStr)
	{
		tempStr1 = tempStr;
	}
	
	public String getTempStr1()
	{
		return tempStr1;
	}
	
	public void setTempStr2(String tempStr)
	{
		tempStr2 = tempStr;
	}
	
	public String getTempStr2()
	{
		return tempStr2;
	}
}
