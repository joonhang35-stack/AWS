	}

	public void setInvCat(String invCat) {
		this.invCat = invCat;
	}

	public String getInvCatDesc() {
		return invCatDesc;
	}

	public void setInvCatDesc(String invCatDesc) {
		this.invCatDesc = invCatDesc;
	}

	public List<String> getInvCatList() {
