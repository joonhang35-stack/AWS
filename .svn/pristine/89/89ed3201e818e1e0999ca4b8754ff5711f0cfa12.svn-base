package com.bcs.zsg.bank.vo;

import java.util.Set;

import com.bcs.zsg.acct.vo.AcctViewVO;

public class BankAcctViewVO extends BankAcctVO {

	private static final long serialVersionUID = 1L;

	private AcctViewVO acctViewVO;
	private Set<BankAddrVO> bankAddrList;
	private Set<BankContactVO> bankContactList;

	/**
	 * @return the acctViewVO
	 */
	public AcctViewVO getAcctViewVO() {
		return acctViewVO;
	}

	/**
	 * @param acctViewVO the acctViewVO to set
	 */
	public void setAcctViewVO(AcctViewVO acctViewVO) {
		this.acctViewVO = acctViewVO;
	}

	/**
	 * @return the bankAddrList
	 */
	public Set<BankAddrVO> getBankAddrList() {
		return bankAddrList;
	}

	/**
	 * @param bankAddrList the bankAddrList to set
	 */
	public void setBankAddrList(Set<BankAddrVO> bankAddrList) {
		this.bankAddrList = bankAddrList;
	}

	/**
	 * @return the bankContactList
	 */
	public Set<BankContactVO> getBankContactList() {
		return bankContactList;
	}

	/**
	 * @param bankContactList the bankContactList to set
	 */
	public void setBankContactList(Set<BankContactVO> bankContactList) {
		this.bankContactList = bankContactList;
	}
}
