package com.bcs.zsg.product.vo;

import com.bcs.zsg.core.vo.BaseVO;

public class RoomingListVO extends BaseVO {
	private static final long serialVersionUID = 1L;

	private Long tourDepId; 
	private String category; 
	private Long fkId; 
	private String tourGuideName;
	private String tourGuideContactNo;
	private String tourGuideEmail;
	private String description; 
	private String description2; 
	private String department;

	public Long getTourDepId() {
		return tourDepId;
	}
 
	public void setTourDepId(Long tourDepId) {
		this.tourDepId = tourDepId;
	}
	
	public String getCategory() {
		return category;
	}
 
	public void setCategory(String category) {
		this.category = category;
	}
	
	public Long getFkId() {
		return fkId;
	}
 
	public void setFkId(Long fkId) {
		this.fkId = fkId;
	}
	
	public String getDescription() {
		return description;
	}
 
	public void setDescription(String description) {
		this.description = description;
	}
	

	public String getDescription2() {
		return description2;
	}
 
	public void setDescription2(String description2) {
		this.description2 = description2;
	}

	public String getTourGuideName() {
		return tourGuideName;
	}

	public void setTourGuideName(String tourGuideName) {
		this.tourGuideName = tourGuideName;
	}

	public String getTourGuideContactNo() {
		return tourGuideContactNo;
	}

	public void setTourGuideContactNo(String tourGuideContactNo) {
		this.tourGuideContactNo = tourGuideContactNo;
	}

	public String getTourGuideEmail() {
		return tourGuideEmail;
	}

	public void setTourGuideEmail(String tourGuideEmail) {
		this.tourGuideEmail = tourGuideEmail;
	}

	public String getDepartment() {
		return department;
	}

	public void setDepartment(String department) {
		this.department = department;
	}
}
