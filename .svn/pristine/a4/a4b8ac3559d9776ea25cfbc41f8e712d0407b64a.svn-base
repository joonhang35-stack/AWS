	@Override
	public void processCreateInvoiceForOnlineBooking() throws BusinessException {
		try {
			Map<String, Object> params = new HashMap<String, Object>();
			params.put("paymentStatus", "S");
			params.put("idInvoice", null);
			List<OnlineBookingPaymentVO> list = onlineBookingBO.getAutogenerateInvoicePaymentList(params);
			//System.out.println("------ " + list.size());
			for (OnlineBookingPaymentVO onlineBookingPaymentVO : list) {
				BookingVO bookingVO = bookingBO.getBooking(onlineBookingPaymentVO.getIdBooking());
				TourDepartureVO tourDepVO = tourPkgBO.getTourDepById(bookingVO.getIdTourDep());
				TourPackageVO tourPkgVO = tourPkgBO.getTourPackageById(tourDepVO.getIdTourPkg());
				OnlineBookingCustomerVO customerVO = onlineBookingBO.getOnlineBookingCustomerByBookingId(bookingVO.getId());
				CompanyVO companyVO = corporateProfileBO.getCompanyDetails(bookingVO.getIdCompany());
				IpayConfigVO ipayConfigVO = ipayConfigBO.getIpayConfigVO(onlineBookingPaymentVO.getIdIpayConfig());
				
				InvoiceVO invoiceVO = new InvoiceVO();
				invoiceVO.setCompanyId(bookingVO.getIdCompany());
				invoiceVO.setAcctId(companyVO.getIdAcctSales());
				invoiceVO.setIdAcctGST(companyVO.getIdAcctGST());
				invoiceVO.setInvoiceDt(new Date());
				invoiceVO.setCustomerId(bookingVO.getIdCust());
				invoiceVO.setBookingId(bookingVO.getId());
				invoiceVO.setTourCd(tourDepVO.getCode());
				invoiceVO.setTourDepId(tourDepVO.getId());
				invoiceVO.setSubjLine(tourDepVO.getDesc());
				invoiceVO.setDepartureDt(tourDepVO.getDtDep());
				invoiceVO.setOrderCd(bookingVO.getOrderTypeCd());
				invoiceVO.setCatCd(CommonConstant.LOOKUP_ITM_INV_CAT_TOUR);
				invoiceVO.setSalerId(bookingVO.getIdEmployee());
				invoiceVO.setIssuerId(bookingVO.getIdEmployee());
//				invoiceVO.setDocTypeCd("I");
				invoiceVO.setDocTypeCd(SalesConstant.DOC_TYPE_CD_PAX_STMT);
				invoiceVO.setAttnTo(customerVO.getSalutationCd() + " " + customerVO.getSurname() + " " + customerVO.getGivenName());
				invoiceVO.setRemarks(onlineBookingPaymentVO.getRemarks());
				
				Calendar invDt = Calendar.getInstance();
				invDt.setTime(new Date());
				invDt.add(Calendar.DATE, 30);
				invoiceVO.setInvoiceDue(invDt.getTime());
				
				invoiceVO.setCustDetailsVO(getCustDetails(bookingVO.getIdCust(), false, false));
				invoiceVO.getCustDetailsVO().setContPersonName(invoiceVO.getAttnTo());
				
				// add invoice items
				for (BookingChargeItemVO itemVO : bookingVO.getBookingChargeItemSet()) {
					if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0) {
						BigDecimal amount = new BigDecimal(String.valueOf(itemVO.getAmount())).multiply(new BigDecimal(String.valueOf(itemVO.getQuantity())));
						
						InvoiceItemVO invItemVO = new InvoiceItemVO();
						invItemVO.setAcctId(itemVO.getIdAcct());
						invItemVO.setInvEOItemId(itemVO.getIdInvEoItem());
						invItemVO.setInvItemCd(itemVO.getCode());
						invItemVO.setCode(itemVO.getCode());
						invItemVO.setDesc(itemVO.getDesc());
						invItemVO.setQty(itemVO.getQuantity());
						invItemVO.setUnitPrice(itemVO.getAmount());
						invItemVO.setAmount(amount.doubleValue());
						invItemVO.setTaxAmount(0.00);
						invItemVO.setTaxCode(null);
						invItemVO.setTaxRate(null);
						invItemVO.setIsLock(itemVO.getIsLock());
						invoiceVO.getInvoiceItemList().add(invItemVO);
					}
				}
				// add admin charges into invoice item
				if (onlineBookingPaymentVO.getAdminCharges().compareTo(BigDecimal.ZERO) > 0) {
					InvoiceItemVO invoiceItemVO = new InvoiceItemVO();
					invoiceItemVO.setAcctId(ipayConfigVO.getIdAcct());
					invoiceItemVO.setCode(SalesConstant.INV_ITM_CD_ADMIN_CHRG);
					invoiceItemVO.setDesc(ipayConfigVO.getAcctDesc());
					invoiceItemVO.setInvItemCd("");
					invoiceItemVO.setQty(1);
					invoiceItemVO.setUnitPrice(onlineBookingPaymentVO.getAdminCharges().doubleValue());
					invoiceItemVO.setAmount(onlineBookingPaymentVO.getAdminCharges().doubleValue());
					invoiceItemVO.setInvId(invoiceVO.getId());
					invoiceVO.getInvoiceItemList().add(invoiceItemVO);
				}
				
				StringBuilder sb = new StringBuilder();
				sb.append(tourDepVO.getNumDays() + "Days " + tourDepVO.getNumNights() + "Nights ");
				if (!StringUtils.isEmpty(tourPkgVO.getNameEn()))
					sb.append(tourPkgVO.getNameEn());
				if (!StringUtils.isEmpty(tourPkgVO.getNameZh()))
					sb.append(" " + tourPkgVO.getNameZh());
				if (!StringUtils.isEmpty(tourPkgVO.getNameOther()))
					sb.append(" " + tourPkgVO.getNameOther());
				if (!StringUtils.isEmpty(tourDepVO.getDesc()))
					sb.append(" [" + tourDepVO.getDesc() + "]");
				invoiceVO.setSubjLine(sb.toString());
				if (StringUtils.isNotEmpty(tourDepVO.getLangCode())) {
					invoiceVO.setSubjLine(invoiceVO.getSubjLine() + " [" +
						LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_PRODUCT_LANG, tourDepVO.getLangCode()) +
					"]");
				}

				InvoicePaymentVO paymentVO = new InvoicePaymentVO();
				paymentVO.setInvId(invoiceVO.getId());
				paymentVO.setPmntDt(new Date());
				paymentVO.setPmntTypeCd("ipay88");
				paymentVO.setRefNo(onlineBookingPaymentVO.getTransId());
				paymentVO.setPmntFor(ipayConfigVO.getComment()); // ?
				paymentVO.setAmount(onlineBookingPaymentVO.getTotalPaymentAmt().doubleValue());
				paymentVO.setPmntIssuedBy("SYSTEM");
				paymentVO.setRecievedFr(invoiceVO.getAttnTo());
				paymentVO.setCreatedBy("SYSTEM");
				paymentVO.setUpdatedBy("SYSTEM");
				paymentVO.setIssuerId(invoiceVO.getIssuerId());

				invoiceVO.getInvoicePaymentList().add(paymentVO);

				calTtlAmt(invoiceVO);
				insertInvoice(invoiceVO, tourDepVO.getId(), true);
				updInvCd(invoiceVO);
				
				String psPrefixVal = LookupItemUtils.getSysNumGenVO(companyVO.getId(), CommonConstant.SYS_NUM_CD_PAX_STMT).getPrefixid();
				onlineBookingPaymentVO.setPrefix(psPrefixVal);
				
				onlineBookingPaymentVO.setIdInvoice(invoiceVO.getId());
				onlineBookingBO.updateVO(onlineBookingPaymentVO, "SYSTEM");
				// return "RECEIVEOK";
				System.out.print("RECEIVEOK");
			}
		} catch (Exception e) {
			logger.error(e.getMessage(), e);
		}
	}
	
	private void calTtlAmt(InvoiceVO invoiceVO) throws BusinessException {
		// manual update the item amount here
		AmountCalcViewVO amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(new AmountCalcViewVO(), false, invoiceVO.getInvoiceItemList(),
															invoiceVO.getInvoicePaymentList(), false);
		
		invoiceVO.setTaxAmt(amtCalcViewVO.getTotalTax().doubleValue());
		invoiceVO.setTaxIncAmt(amtCalcViewVO.getTotalAmountIncludeTax().doubleValue());
		invoiceVO.setRoundingAmt(amtCalcViewVO.getTotalRounding().doubleValue());
		invoiceVO.setAmount(amtCalcViewVO.getTotalAmountAfterRounding().doubleValue());
		invoiceVO.setAmtPaid(amtCalcViewVO.getTotalAmountPaid().doubleValue());
		invoiceVO.setBalance(amtCalcViewVO.getTotalAmountAfterRounding()
								.subtract(amtCalcViewVO.getTotalAmountPaid()).doubleValue());
		
		BigDecimal taxAmt = new BigDecimal(String.valueOf(invoiceVO.getTaxAmt()));
		BigDecimal taxIncAmt = new BigDecimal(String.valueOf(invoiceVO.getTaxIncAmt()));
		BigDecimal taxExcAmt = taxIncAmt.subtract(taxAmt);
		invoiceVO.setTaxExcAmt(taxExcAmt.doubleValue());
		
		EInvoiceUtils.calcEInvItemList(invoiceVO);
	}
	
	public Date addInvoiceDueDate(Date dt) {
		Calendar invDt = Calendar.getInstance();
		if (dt == null) {
			invDt.setTime(new Date());
		} else {
			invDt.setTime(dt);
		}
		invDt.add(Calendar.DATE, Integer.parseInt(LookupItemUtils.getGlobalConfigValue(LookupItemConstant.GC_CATEGORY, LookupItemConstant.GC_PAID_EXP)));
		return invDt.getTime();
	}

