	@Override
	public InvoiceVO processReversePsSales(InvoiceVO paxStmtVO) throws BusinessException, QueueException {
		String sysCd = CommonConstant.SYS_NUM_CD_INVC;
		if (StringUtils.equals(paxStmtVO.getDocTypeCd(), SalesConstant.DOC_TYPE_CD_PAX_STMT)) {
			sysCd = CommonConstant.SYS_NUM_CD_PAX_STMT;
		}
		
		List<AcctTransVO> acctTransList = invoiceDAO.getAcctTransListByInv(sysCd, paxStmtVO.getPsNo(), paxStmtVO.getCompanyId());
		List<InvoiceItemVO> itemList = invoiceDAO.getInvoiceItemList(paxStmtVO.getId()); paxStmtVO.setInvoiceItemList(itemList);
		AcctTransVO tradeDebtorAcctTransVO = invoiceDAO.getAcctTransVO(sysCd, paxStmtVO.getPsNo(), paxStmtVO.getPsNo(), paxStmtVO.getCompanyId());

//		System.out.println("PS - " + paxStmtVO.getPsNo());
//		System.out.println();
		
		// -------------- check account transaction all terminated Start -----------------
		
		boolean isAcctTransTerminated = true;
		
		if (!StringUtils.equals(tradeDebtorAcctTransVO.getStatusCode(), BaseConstant.STATUS_TERMINATED)) {
			isAcctTransTerminated = false;
		}
		
//		System.out.println(tradeDebtorAcctTransVO.getRefNo() + " " + tradeDebtorAcctTransVO.getDesc() + " " + tradeDebtorAcctTransVO.getDebit() + " " + tradeDebtorAcctTransVO.getCredit() + " " + tradeDebtorAcctTransVO.getStatusCode());
		for (AcctTransVO acctTransVO : acctTransList) {
			if (!StringUtils.equals(acctTransVO.getStatusCode(), BaseConstant.STATUS_TERMINATED)) {
				isAcctTransTerminated = false;
			}
//			System.out.println(acctTransVO.getRefNo() + " " + acctTransVO.getDesc() + " " + acctTransVO.getDebit() + " " + acctTransVO.getCredit() + " " + acctTransVO.getStatusCode());
		}
		
		AcctTransVO taxTransVO = invoiceDAO.getAcctTransByInv(sysCd, paxStmtVO.getPsNo(), paxStmtVO.getCompanyId(), CommonConstant.SYS_NUM_CD_TAX);
		if (taxTransVO != null && taxTransVO.getStatusCode().equals(BaseConstant.STATUS_ACTIVE)) {
			isAcctTransTerminated = false;
		}
		
		AcctTransVO roundingTransVO = invoiceDAO.getAcctTransByInv(sysCd, paxStmtVO.getPsNo(), paxStmtVO.getCompanyId(), CommonConstant.SYS_NUM_CD_ROUNDING);
		if (roundingTransVO != null && roundingTransVO.getStatusCode().equals(BaseConstant.STATUS_ACTIVE)) {
			isAcctTransTerminated = false;
		}
		
		if (!isAcctTransTerminated) {
			JournalVO reverseJournalVO = journalService.getJournalByPaxStmtId(paxStmtVO.getId(), paxStmtVO.getCompanyId());
			System.out.println("!!! PS - " + paxStmtVO.getPsNo() + " NOT TERMINATED. Journal ID=" + " " + (reverseJournalVO != null ? reverseJournalVO.getId() : "[No Journal]"));
			
			if (reverseJournalVO != null) {
				// reverse sales journal exists, skip creating
				return new InvoiceVO();
			}
		}
		
		// -------------- check account transaction all terminated End -----------------
		
		
		// -------------- check account transaction included deleted invoice item Start -----------------
		{
			boolean isAcctTransIncludeDelItem = false;
			
			for (AcctTransVO acctTransVO : acctTransList) {
				boolean foundInInvItem = false;
				for (InvoiceItemVO invoiceItemVO : itemList) {
					if (invoiceItemVO.getId().equals(Long.valueOf(acctTransVO.getRefNo()))) {
						foundInInvItem = true;
					}
				}
				if (!foundInInvItem) {
					isAcctTransIncludeDelItem = true;
				}
				
	//			System.out.println(
	//					"Status=" + acctTransVO.getStatusCode() +
	//					", foundInInvItem=" + foundInInvItem +
	//				    ", AcctId=" + acctTransVO.getAcctId() +
	//				    ", SysNo=" + acctTransVO.getSysNo() +
	//				    ", RefNo=" + acctTransVO.getRefNo() +
	//				    ", Code=" + acctTransVO.getCode() +
	//				    ", Desc=" + acctTransVO.getDesc() +
	//				    ", Credit=" + acctTransVO.getCredit() 
	//				    
	//				);
				
	//			if (StringUtils.isBlank(acctTransVO.getRefNo())) {
	//				System.out.println(acctTransVO.getId() + " is blank");
	//			}
			}
			
	//		if (isAcctTransIncludeDelItem) {
	//			System.out.println("PS -- " + invoiceVO.getPsNo());
	//		}
		}
		// -------------- check account transaction included deleted invoice item End -----------------
		
		// -------------- reactivate account transaction Start -----------------
		{
			// reactivate trade debtor
			tradeDebtorAcctTransVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
			chartOfAcctBO.audAcctTransEmailPayment(CommonConstant.ACTION_CD_UPD, tradeDebtorAcctTransVO); // this function is just to make upd_by = "SYSTEM"
			
			reactivePaxStmtItemAcctTrans(itemList, acctTransList);
			reactivePaxStmtTaxOrRoundingAcctTrans(sysCd, paxStmtVO, CommonConstant.SYS_NUM_CD_TAX);
			reactivePaxStmtTaxOrRoundingAcctTrans(sysCd, paxStmtVO, CommonConstant.SYS_NUM_CD_ROUNDING);
			
//				if (isAcctTransIncludeDelItem) {
//					System.out.println("PS -- " + invoiceVO.getPsNo());
//				}
					
		}
		// -------------- reactivate account transaction End -----------------
		
//		System.out.println("----------");
		
		CompanyVO companyVO = corporateProfileBO.getCompanyDetails(paxStmtVO.getCompanyId());
		
		// get invoice
		InvoiceVO invoiceVO = getInvoiceByCode(paxStmtVO.getCode());
//		paxStmtVO = getInvoiceDetails(paxStmtVO);
//		invoiceVO = getInvoiceDetails(invoiceVO);
		
		// set tax account
		paxStmtVO.setIdAcctGST(companyVO.getIdAcctGST());
		invoiceVO.setIdAcctGST(companyVO.getIdAcctGST());
		
		// reverse journal
		journalService.insertReverseJournal(paxStmtVO, invoiceVO);	
		
		return new InvoiceVO();
	}
	
	/**
	 * reactivate terminated converted pax statement invoice item account trans before reverse sales journal implemented
	 * @param itemList
	 * @param acctTransList
	 * @throws BusinessException
	 */
	private void reactivePaxStmtItemAcctTrans(List<InvoiceItemVO> itemList, List<AcctTransVO> acctTransList) throws BusinessException {
		boolean isAcctTransIncludeDelItem = false;
		
		// reactivate invoice item account trans
		for (AcctTransVO acctTransVO : acctTransList) {
			boolean foundInInvItem = false;
			for (InvoiceItemVO invoiceItemVO : itemList) {
				if (invoiceItemVO.getId().equals(Long.valueOf(acctTransVO.getRefNo()))) {
					foundInInvItem = true;
				}
			}
			if (!foundInInvItem) {
				isAcctTransIncludeDelItem = true;
			}
			
			if (foundInInvItem) {
				// is invoice item account trans, reactivate it
				acctTransVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
				chartOfAcctBO.audAcctTransEmailPayment(CommonConstant.ACTION_CD_UPD, acctTransVO); // this function is just to make upd_by = "SYSTEM"
			}
//				System.out.println(
//						"Status=" + acctTransVO.getStatusCode() +
//						", foundInInvItem=" + foundInInvItem +
//					    ", AcctId=" + acctTransVO.getAcctId() +
//					    ", SysNo=" + acctTransVO.getSysNo() +
//					    ", RefNo=" + acctTransVO.getRefNo() +
//					    ", Code=" + acctTransVO.getCode() +
//					    ", Desc=" + acctTransVO.getDesc() +
//					    ", Credit=" + acctTransVO.getCredit() 
//					    
//					);
			
//				if (StringUtils.isBlank(acctTransVO.getRefNo())) {
//					System.out.println(acctTransVO.getId() + " is blank");
//				}
		}
		
	}
	
	private void reactivePaxStmtTaxOrRoundingAcctTrans(String sysCd, InvoiceVO paxStmtVO, String taxOrRounding) throws BusinessException {
		AcctTransVO acctTransVO = invoiceDAO.getAcctTransByInv(sysCd, paxStmtVO.getPsNo(), paxStmtVO.getCompanyId(), taxOrRounding);
		
		if (acctTransVO != null && acctTransVO.getStatusCode().equals(BaseConstant.STATUS_TERMINATED)) {
			acctTransVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
			chartOfAcctBO.audAcctTransEmailPayment(CommonConstant.ACTION_CD_UPD, acctTransVO); // this function is just to make upd_by = "SYSTEM"
		}
	}
	
