//					if (CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getMealList())) {
//						for (PersonMealVO personMealVO : invoicePaxVO.getCustDetailsVO().getMealList()) {
//							personMealVO.setPersonId(invoicePaxVO.getCustDetailsVO().getPersonId());
//							customerDAO.insert(personMealVO);
//						}
//					}
					
					// update languages
					customerDAO.deletePersonSubInfo("person_lang", invoicePaxVO.getCustDetailsVO().getPersonId());
					if(CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getLangCdList())) {
						for(String code : invoicePaxVO.getCustDetailsVO().getLangCdList()) {
							PersonLangVO vo = new PersonLangVO();
							vo.setPersonId(invoicePaxVO.getCustDetailsVO().getPersonId());
							vo.setLangCd(code);
							customerDAO.insert(vo);
						}
					}
					// update meals
					customerDAO.deletePersonSubInfo("person_meal", invoicePaxVO.getCustDetailsVO().getPersonId());
					if(CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getMealCdList())) {
						for(String code : invoicePaxVO.getCustDetailsVO().getMealCdList()) {
							PersonMealVO vo = new PersonMealVO();
							vo.setPersonId(invoicePaxVO.getCustDetailsVO().getPersonId());
							vo.setMealCd(code);
							customerDAO.insert(vo);
						}
					}
					// update classes
					customerDAO.deletePersonSubInfo("person_class", invoicePaxVO.getCustDetailsVO().getPersonId());
					if(CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getClassCdList())) {
						for(String code : invoicePaxVO.getCustDetailsVO().getClassCdList()) {
							PersonClassVO vo = new PersonClassVO();
							vo.setPersonId(invoicePaxVO.getCustDetailsVO().getPersonId());
							vo.setClassCd(code);
							customerDAO.insert(vo);
						}
					}
					// update complications
					customerDAO.deletePersonSubInfo("person_complication", invoicePaxVO.getCustDetailsVO().getPersonId());
					if(CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getCompliCdList())) {
						for(String code : invoicePaxVO.getCustDetailsVO().getCompliCdList()) {
							PersonComplicationVO vo = new PersonComplicationVO();
							vo.setPersonId(invoicePaxVO.getCustDetailsVO().getPersonId());
							vo.setComplicationCd(code);
							customerDAO.insert(vo);
						}
					}
					
					// insert/update email
					customerDAO.terminatePersonSubInfo("person_email", invoicePaxVO.getCustDetailsVO().getPersonId());
					if (CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getEmailList())) {
						for (PersonEmailVO emailVO : invoicePaxVO.getCustDetailsVO().getEmailList()) {
							emailVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
							if (null == emailVO.getId()) {
								emailVO.setIdPerson(invoicePaxVO.getCustDetailsVO().getPersonId());
								customerDAO.insert(emailVO);
							} else customerDAO.update(emailVO);
						}
					}
					
					// insert/update contacts
					customerDAO.terminatePersonSubInfo("person_contact", invoicePaxVO.getCustDetailsVO().getPersonId());
					if (CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getContactList())) {
						for (PersonContactVO contactVO : invoicePaxVO.getCustDetailsVO().getContactList()) {
							contactVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
							if (null == contactVO.getId()) {
								contactVO.setPersonId(invoicePaxVO.getCustDetailsVO().getPersonId());
								customerDAO.insert(contactVO);
							} else customerDAO.update(contactVO);
						}
					}
					
					// insert/update identities
					customerDAO.terminatePersonSubInfo("person_identity", invoicePaxVO.getCustDetailsVO().getPersonId());
					if (CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getIdentityList())) {
						for (IdentityVO identityVO : invoicePaxVO.getCustDetailsVO().getIdentityList()) {
							identityVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
							if (null == identityVO.getId()) {
								identityVO.setPersonId(invoicePaxVO.getCustDetailsVO().getPersonId());
								customerDAO.insert(identityVO);
								if (identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_PASSPRT) || identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_VISA)) {
									if (identityVO.getIdentityDetailVO() != null) {
										identityVO.getIdentityDetailVO().setPersonIdentityId(identityVO.getId());
										if (identityVO.getIdentityDetailVO().getIdCountry() == null) identityVO.getIdentityDetailVO().setIdCountry(CommonConstant.DEF_COUNTRY_ID);
										customerDAO.insert(identityVO.getIdentityDetailVO());
									}
								}
							} else {
								customerDAO.update(identityVO);
								if (identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_PASSPRT) || identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_VISA)) {
									if (identityVO.getIdentityDetailVO() != null && identityVO.getIdentityDetailVO().getId() != null) {
										customerDAO.update(identityVO.getIdentityDetailVO());
									}
								}
							}
						}
					}
					
					// insert person attachment
					if (CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getAttachmentList())) {
						for (PersonAttachmentVO attachmentVO : invoicePaxVO.getCustDetailsVO().getAttachmentList()) {
							if (attachmentVO.getId() == null) {
								attachmentVO.setPersonId(invoicePaxVO.getCustDetailsVO().getPersonId());
								attachmentVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
								customerDAO.insert(attachmentVO);
							} else customerDAO.update(attachmentVO);
						}
					}
					
					PersonVO personVO = customerDAO.getPersonById(invoicePaxVO.getCustDetailsVO().getPersonId());
					personVO.setEmail(invoicePaxVO.getCustDetailsVO().getEmail());
					if (invoicePaxVO.getCustDetailsVO().getTitle() != null) personVO.setTitle(invoicePaxVO.getCustDetailsVO().getTitle());
					if (invoicePaxVO.getCustDetailsVO().getCountryId() != null) personVO.setCountryId(invoicePaxVO.getCustDetailsVO().getCountryId());
					if (invoicePaxVO.getCustDetailsVO().getTaxIdNo() != null) personVO.setTaxIdNo(invoicePaxVO.getCustDetailsVO().getTaxIdNo());
					if (invoicePaxVO.getCustDetailsVO().getRace() != null) personVO.setRace(invoicePaxVO.getCustDetailsVO().getRace());
					if (invoicePaxVO.getCustDetailsVO().getDob() != null) personVO.setDob(invoicePaxVO.getCustDetailsVO().getDob());
					if (invoicePaxVO.getCustDetailsVO().getAge() != null) personVO.setAge(invoicePaxVO.getCustDetailsVO().getAge());
					if (invoicePaxVO.getCustDetailsVO().getSex() != null) personVO.setSex(invoicePaxVO.getCustDetailsVO().getSex());
					customerDAO.update(personVO);
					
					if (invoicePaxVO.getCustDetailsVO().getAddressVO() != null && invoicePaxVO.getCustDetailsVO().getAddressVO().getId() != null) {
						invoicePaxVO.getCustDetailsVO().getAddressVO().setAddrType(CommonConstant.BILL_ADDR);
						customerDAO.update(invoicePaxVO.getCustDetailsVO().getAddressVO());
					} else {
						invoicePaxVO.getCustDetailsVO().getAddressVO().setPersonId(personVO.getId());
						invoicePaxVO.getCustDetailsVO().getAddressVO().setAddrType(CommonConstant.BILL_ADDR);
						customerDAO.insert(invoicePaxVO.getCustDetailsVO().getAddressVO());
					}
					
					if(invoicePaxVO.getCustDetailsVO().getMailAddressVO() != null && invoicePaxVO.getCustDetailsVO().getMailAddressVO().getId() != null) {
						invoicePaxVO.getCustDetailsVO().getMailAddressVO().setAddrType(CommonConstant.MAIL_ADDR);
						customerDAO.update(invoicePaxVO.getCustDetailsVO().getMailAddressVO());
					} else if (invoicePaxVO.getCustDetailsVO().getMailAddressVO() != null &&
							(StringUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getMailAddressVO().getCompanyName()) || 
							StringUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getMailAddressVO().getAddr1()))) {
						invoicePaxVO.getCustDetailsVO().getMailAddressVO().setPersonId(personVO.getId());
						invoicePaxVO.getCustDetailsVO().getMailAddressVO().setAddrType(CommonConstant.MAIL_ADDR);
						customerDAO.insert(invoicePaxVO.getCustDetailsVO().getMailAddressVO());
					}
				}
			}
		}
	}
	
	public void updateCustomerId(InvoiceVO invoiceVO) {
		invoiceDAO.update(invoiceVO);
	}

	/* (non-Javadoc)
