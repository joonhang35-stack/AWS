						custVO.getPersonVO().setGivenName(invPaxVO.getCustDetailsVO().getFirstName().toUpperCase().trim());
						
						customerService.insertCustomer(custVO);
						updObjPassangerList(custVO.getPersCorpId(), invPaxVO.getCustDetailsVO().getLangVOList());
						updObjPassangerList(custVO.getPersCorpId(), invPaxVO.getCustDetailsVO().getMealVOList());
						
