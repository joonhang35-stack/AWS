					} else {
						updObjPassangerList(invPaxVO.getCustDetailsVO().getPersonId(), invPaxVO.getCustDetailsVO().getLangVOList());
						updObjPassangerList(invPaxVO.getCustDetailsVO().getPersonId(), invPaxVO.getCustDetailsVO().getMealVOList());
					}
					
					invoiceDAO.insert(invPaxVO);
				}
				
				if (vo instanceof InvoicePaymentVO) {
					SystemNumberGenerationVO invPmntSNGVO = getSNGVO(CommonConstant.SYS_NUM_CD_BANK_DEPS, invoiceVO.getCompanyId());
					((InvoicePaymentVO) vo).setCode(Long.toString(invPmntSNGVO.getNextnumber()));
					
					invoiceDAO.insert((InvoicePaymentVO) vo);
