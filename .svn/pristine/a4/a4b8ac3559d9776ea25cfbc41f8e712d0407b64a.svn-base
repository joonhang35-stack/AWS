	@Override
	public void convertToInvoice(InvoiceVO paxStmtVO) throws BusinessException, QueueException {
		
		Long psId = paxStmtVO.getId(); // get original row id, cuz after insert statement id will change
		paxStmtVO = getInvoiceById(psId);
		
		CompanyVO companyVO = corporateProfileBO.getCompanyDetails(paxStmtVO.getCompanyId());
		
		// set tax account
		paxStmtVO.setIdAcctGST(companyVO.getIdAcctGST());
		
		if (paxStmtVO.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_CONVERTED)) {
//			throw new BusinessException(CommonErrConstant.ERR_PS_CONVERTED);
			TrackingLogUtils.printLogs("Pax Statement PS" + paxStmtVO.getPsNo() + " has already been converted. Skipping duplicate conversion attempt.");
			return; // just stop converting will do
		}
		getInvoiceDetails(paxStmtVO);
		
		InvoiceVO invoiceVO = getInvoiceById(psId);
		getInvoiceDetails(invoiceVO);
		
		// set tax account
		invoiceVO.setIdAcctGST(companyVO.getIdAcctGST());

		InvoiceVO cloned = SerializationUtils.clone(invoiceVO);
		cloned.setId(null);
		cloned.setInvoiceDt(new Date()); // use conversion date as converted invoice date
		cloned.setDocTypeCd("I");
		cloned.setDocTypeStatus(null);
		// store a copy of bookingId in idParentInvTourBooking, and clear it to avoid NonUniqueResultException
		cloned.setBookingId(null);
		if (invoiceVO.getBookingId() != null)	cloned.setIdParentInvTourBooking(invoiceVO.getBookingId());
		
		// convert pre sales account into recognized sales account
		for (InvoiceItemVO vo : cloned.getInvoiceItemList()) {
			AcctVO acctVO = chartOfAcctBO.getAcctVO(vo.getAcctId());
			if (acctVO.isPreSales()) {
//				System.out.println("acctVO.isPreSales()");
//				System.out.println(acctVO.getIdParentAcct());
				vo.setIdPreSalesAcct(vo.getAcctId());
				vo.setAcctId(acctVO.getIdParentAcct());
			}
		}
		
		// set invoice pax id to null to insert in updateInvoicePax
		for (InvoicePaxVO vo : cloned.getInvoicePaxList()) {
			vo.setId(null);
			
			if (CollectionUtils.isNotEmpty(vo.getInvoicePaxRefNoList())) {
				for (InvoicePaxRefNoVO refNoVO : vo.getInvoicePaxRefNoList()) {
					refNoVO.setId(null);
				}
			}
		}
		
		// set pmnt parent pmnt id to parent id
		if (CollectionUtils.isNotEmpty(cloned.getInvoicePaymentList())) {
			for (InvoicePaymentVO paymentVO : cloned.getInvoicePaymentList()) {
				paymentVO.setIdParentPmnt(paymentVO.getId());
			}
		}
		
		invoiceDAO.insert(cloned);
		
		insertInvoice(cloned, cloned.getTourDepId());
		
		if (CollectionUtils.isNotEmpty(cloned.getInvoiceAttachmentVOList())) {
			for (InvoiceAttachmentVO vo : cloned.getInvoiceAttachmentVOList()) {
				vo.setInvId(cloned.getId());
				invoiceDAO.insert(vo);
			}
		}
		
//		terminateAcctTrans(paxStmtVO);
		
		updInvCd(cloned);
		
//		updateInvoiceDocTypeStatus(psId, ProductConstant.PAX_STMT_STATUS_CONVERTED);
		
		// reverse journal
		// replaced by scheduler (You Yuan 2025.09.25)
//		journalService.insertReverseJournal(paxStmtVO, cloned);	
		
		// pending reverse journal
		pendingJournalService.insertPendingReverseJournal(paxStmtVO, cloned);
		
		// if ps linked to cn, access to cn data to add link from cn to converted inv
		if (CollectionUtils.isNotEmpty(cloned.getInvoicePaymentList())) {
			for (InvoicePaymentVO paymentVO : cloned.getInvoicePaymentList()) {
				if (paymentVO.getCreditNoteId() != null) {
					InvoiceVO creditNoteVO = invoiceDAO.getInvoiceById(paymentVO.getCreditNoteId());
					creditNoteVO.setCnInvNo(cloned.getCode());
					invoiceDAO.update(creditNoteVO);
				}
			}
		}
		
		// set converted invoice code to original pax statement
		invoiceVO.setDocTypeStatus(ProductConstant.PAX_STMT_STATUS_CONVERTED);
		invoiceVO.setCode(cloned.getCode());
//		invoiceVO.setBookingId(null);
		invoiceDAO.update(invoiceVO);
				
		// insert invoice history for newly converted invoice
		insertInvoiceHistory(cloned.getId(), CommonConstant.ACTION_CD_ADD, "");
		
		TrackingLogUtils.printLogs(
				"PS" + invoiceVO.getPsNo() + " (ID=" + paxStmtVO.getId() 
				+ ") converted to AV" + invoiceVO.getCode() + " (ID=" + cloned.getId() + ")");
	}
	
	@Override
	public boolean validateConvert(InvoiceVO oriVO) throws BusinessException {
		
		oriVO.setInvoiceItemList(getInvItemList(oriVO));
		
		if (!CommonConstant.LOOKUP_ITM_INV_CAT_TOUR.equals(oriVO.getCatCd()) || CommonConstant.STATUS_CD_CANCELLED.equals(oriVO.getBookingStatusCd())) {
			return true;
		}
		
		String[] arrShouldHaveAirfare = { 
				ProductConstant.TOUR_DEP_ITM_CD_FT_TWN,
				ProductConstant.TOUR_DEP_ITM_CD_FT_SGL, 
				ProductConstant.TOUR_DEP_ITM_CD_FT_CTW,
				ProductConstant.TOUR_DEP_ITM_CD_FT_CNB, 
				ProductConstant.TOUR_DEP_ITM_CD_FT_CWB 
		};
		
		if (CollectionUtils.isNotEmpty(oriVO.getInvoiceItemList())) {
			for (InvoiceItemVO itemVO : oriVO.getInvoiceItemList()) {
				if (StringUtils.isNotBlank(itemVO.getCode())) {
					if (Arrays.asList(arrShouldHaveAirfare).contains(itemVO.getCode())) {
						if (itemVO.getAirfare().equals(0D)) {
							return false;
						}
					}
				}
				
			}
		}
		
		return true;
	}
	
	@Override
	public void terminateAcctTrans(InvoiceVO invoiceVO) throws BusinessException {
		String sysCd = CommonConstant.SYS_NUM_CD_INVC;
		if (invoiceVO.getDocTypeCd().equals("C")) sysCd = CommonConstant.SYS_NUM_CD_CRDT_NOTE;
		else if (invoiceVO.getDocTypeCd().equals("P")) sysCd = CommonConstant.SYS_NUM_CD_PAX_STMT;
		
		for (InvoiceItemVO vo : invoiceVO.getInvoiceItemList()) {
			//Retrieve data from transaction table
			//statusCrDr = "Credit";
			//if (invoiceVO.getDocTypeCd().equals("C")) statusCrDr = "Debit";
			
			AcctTransVO acctTransVO = invoiceDAO.getAcctTransVO(sysCd, invoiceVO.getCode(), Long.toString(vo.getId()), invoiceVO.getCompanyId());
			if (acctTransVO != null) {
				chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_DEL, acctTransVO);
			}
		}
		
		//Retrieve data from transaction table
		//statusCrDr = "Debit";
		//if (invoiceVO.getDocTypeCd().equals("C")) statusCrDr = "Credit";
		AcctTransVO acctTransVO = invoiceDAO.getAcctTransVO(sysCd, invoiceVO.getCode(), invoiceVO.getCode(), invoiceVO.getCompanyId());
		if (acctTransVO != null) {
			chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_DEL, acctTransVO);
		}
		
		List<AcctTransVO> acctTransList = acctTransDAO.getAcctTransTaxRndList(invoiceVO.getCompanyId(), sysCd, invoiceVO.getCode());
		for(AcctTransVO acctVO : acctTransList) {
			chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_DEL, acctVO);
		}
	}
	
	@Override
	public void terminateAcctTrans(InvoiceVO invoiceVO, String action) throws BusinessException {
		String sysCd = CommonConstant.SYS_NUM_CD_INVC;
		if (invoiceVO.getDocTypeCd().equals("C")) sysCd = CommonConstant.SYS_NUM_CD_CRDT_NOTE;
		else if (invoiceVO.getDocTypeCd().equals("P")) sysCd = CommonConstant.SYS_NUM_CD_PAX_STMT;
		
		for (InvoiceItemVO vo : invoiceVO.getInvoiceItemList()) {
			//Retrieve data from transaction table
			//statusCrDr = "Credit";
			//if (invoiceVO.getDocTypeCd().equals("C")) statusCrDr = "Debit";
			
			AcctTransVO acctTransVO = invoiceDAO.getAcctTransVO(sysCd, invoiceVO.getCode(), Long.toString(vo.getId()), invoiceVO.getCompanyId());
			if (acctTransVO != null) {
//				if (action.equals(CommonConstant.ACTION_CD_REACTIVE)) {
//					acctTransVO.setStatusCode(sysCd);
//				}
				chartOfAcctBO.audAcctTrans(action, acctTransVO);
			}
		}
		
		//Retrieve data from transaction table
		//statusCrDr = "Debit";
		//if (invoiceVO.getDocTypeCd().equals("C")) statusCrDr = "Credit";
		AcctTransVO acctTransVO = invoiceDAO.getAcctTransVO(sysCd, invoiceVO.getCode(), invoiceVO.getCode(), invoiceVO.getCompanyId());
		if (acctTransVO != null) {
			chartOfAcctBO.audAcctTrans(action, acctTransVO);
		}
		
		List<AcctTransVO> acctTransList = acctTransDAO.getAcctTransTaxRndList(invoiceVO.getCompanyId(), sysCd, invoiceVO.getCode());
		for(AcctTransVO acctVO : acctTransList) {
			chartOfAcctBO.audAcctTrans(action, acctVO);
		}
	}
	
