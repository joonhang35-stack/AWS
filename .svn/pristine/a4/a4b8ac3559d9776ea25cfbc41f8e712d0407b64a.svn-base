						StringUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getMailAddressVO().getAddr1()))) {
					
					invoicePaxVO.getCustDetailsVO().getMailAddressVO().setAddrType(CommonConstant.MAIL_ADDR);
					custVO.setMailAddressVO(invoicePaxVO.getCustDetailsVO().getMailAddressVO());
				}
				
				customerService.insertCustomer(custVO);
				// set customer id to invoice pax
				invoicePaxVO.setCustId(custVO.getId());
				invoicePaxVO.getCustDetailsVO().setPersonId(custVO.getPersCorpId());
				invoicePaxVO.getCustDetailsVO().setCode(custVO.getCode());
				
