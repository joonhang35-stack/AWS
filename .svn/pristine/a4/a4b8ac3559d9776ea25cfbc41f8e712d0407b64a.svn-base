	private void updateParentBooking(InvoiceVO invoiceVO) throws BusinessException {
		InvoiceVO parentInvoiceVO = getInvoiceById(invoiceVO.getIdParentInv());
		List<InvoiceVO> subInvoiceList = getSubInvoiceList(parentInvoiceVO.getId());
		
		String bookingStatus = CommonConstant.STATUS_CD_BOOKED;
		String bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_KIV;
		boolean isAllFP = true; // is all full payment
		boolean isDepositPaid = false; // is any deposit paid
		
		for (InvoiceVO subInvoiceVO : subInvoiceList) {
			
			// skip voided/cancelled sub stmt, as it might be reverted sub stmt
			if (subInvoiceVO.getStatusCd().equals(CommonConstant.STATUS_CD_VOID) || subInvoiceVO.getStatusCd().equals(CommonConstant.STATUS_CD_CANCELLED)) {
				continue;
			}
			
			String subBookingStatus = CommonConstant.STATUS_CD_BOOKED;
			String subBookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_KIV;
			
			// Full payment
			if (subInvoiceVO.getBalance().doubleValue() <= 0) {
				subInvoiceVO.setIsInvPaid(true);
				subInvoiceVO.setStatusCd(CommonConstant.STATUS_CD_FULL_PAYMENT);
				subBookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_FULL;
				subBookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
			} else {
				subInvoiceVO.setIsInvPaid(false);
				// Deposit
				if ((subInvoiceVO.getAmount() - subInvoiceVO.getBalance()) > 0) {
					subInvoiceVO.setStatusCd(CommonConstant.STATUS_CD_DEPOSIT_PAID);
					subBookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT;
					subBookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
				} else {
					if(subInvoiceVO.getTrvWarrantChecked()) {
						subBookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT;
						// to fix travel warrant = true booking to be confirm
						subBookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
						subInvoiceVO.setStatusCd(CommonConstant.STATUS_CD_DEPOSIT_PAID);
					} else {
						subBookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_KIV;
						subInvoiceVO.setStatusCd(CommonConstant.STATUS_CD_INVOICED);
					}
				}
			}
			
			// update booking status
			if (subBookingStatus.equals(CommonConstant.STATUS_CD_CONFIRMED)) {
				bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
				isDepositPaid = true;
			}
			
			// update booking payment status
			if (subBookingPmntStatus.equals(SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT)) {
				bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT;
			}
			
			// update invoice status
			if (subInvoiceVO.getStatusCd().equals(CommonConstant.STATUS_CD_DEPOSIT_PAID)) {
				parentInvoiceVO.setStatusCd(CommonConstant.STATUS_CD_DEPOSIT_PAID);
			}
				
			if (!subBookingPmntStatus.equals(SalesConstant.BOOKING_PMNT_STATUS_FULL)) {
				isAllFP = false;
			}
			
//			System.out.println("CYY subInvoiceVO.getCode(): " + subInvoiceVO.getCode());
//			System.out.println("CYY isAllFP: " + isAllFP);
//			System.out.println("CYY isDepositPaid: " + isDepositPaid);
//			System.out.println("CYY subBookingPmntStatus: " + subBookingPmntStatus);
//			System.out.println("CYY subBookingStatus: " + subBookingStatus);
//			System.out.println("CYY subInvoiceVO.getStatusCd(): " + subInvoiceVO.getStatusCd());
//			System.out.println();
		}
		
		// update booking payment status to full if all sub stmt fully paid
		if (isAllFP) {
			bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_FULL;
			parentInvoiceVO.setStatusCd(CommonConstant.STATUS_CD_FULL_PAYMENT);
			parentInvoiceVO.setIsInvPaid(true);
		} else {
			parentInvoiceVO.setIsInvPaid(false);
			if (isDepositPaid) {
				parentInvoiceVO.setStatusCd(CommonConstant.STATUS_CD_DEPOSIT_PAID);
				// added 2025.10.08 (You Yuan)
				bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT;
				bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
			} else {
				parentInvoiceVO.setStatusCd(CommonConstant.STATUS_CD_INVOICED);
			}
		}
		
//		System.out.println("CYY isAllFP: " + isAllFP);
//		System.out.println("CYY isDepositPaid: " + isDepositPaid);
//		System.out.println("CYY parentInvoiceVO.getBookingId(): " + parentInvoiceVO.getBookingId());
//		System.out.println("CYY bookingPmntStatus: " + bookingPmntStatus);
//		System.out.println("CYY bookingStatus: " + bookingStatus);
//		System.out.println("CYY parentInvoiceVO.getStatusCd(): " + parentInvoiceVO.getStatusCd());
		
		if (parentInvoiceVO.getBookingId() != null) {
			invoiceDAO.updateBooking(parentInvoiceVO.getBookingId(), bookingPmntStatus, bookingStatus, null, null, null, null);
		}
		invoiceDAO.updateStatus(parentInvoiceVO);
	}
	
