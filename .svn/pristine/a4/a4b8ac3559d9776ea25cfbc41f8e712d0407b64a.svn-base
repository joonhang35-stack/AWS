	/* (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.InvoiceService#insertInvoice(com.bcs.zsg.sales.vo.InvoiceVO)
	 */
	private void insertInvoice(InvoiceVO invoiceVO, Long idTourDep, boolean bySystem) throws BusinessException, QueueException {
		String bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_KIV;
		String bookingStatus = CommonConstant.STATUS_CD_BOOKED;
		
		// Full payment
		if (invoiceVO.getBalance().doubleValue() <= 0) {
			invoiceVO.setIsInvPaid(true);
			invoiceVO.setStatusCd(CommonConstant.STATUS_CD_FULL_PAYMENT);
			bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_FULL;
			bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
			
		} else {
			invoiceVO.setIsInvPaid(false);
			// Deposit
			if (invoiceVO.getAmtPaid().doubleValue() > 0) {
				invoiceVO.setStatusCd(CommonConstant.STATUS_CD_DEPOSIT_PAID);
				bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT;
				bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
			} else {
				if(invoiceVO.getTrvWarrantChecked()) {
					bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT;
					//to fix travel warrant = true booking to be confirm
					bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
					invoiceVO.setStatusCd(CommonConstant.STATUS_CD_DEPOSIT_PAID);
				} else {
					bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_KIV;
					invoiceVO.setStatusCd(CommonConstant.STATUS_CD_INVOICED);
				}
			}
		}
		
		
		String sysCd = CommonConstant.SYS_NUM_CD_INVC;
		// Credit Note
		if (invoiceVO.getDocTypeCd().equals("C")) sysCd = CommonConstant.SYS_NUM_CD_CRDT_NOTE;
		else if (invoiceVO.getDocTypeCd().equals("P")) sysCd = CommonConstant.SYS_NUM_CD_PAX_STMT;

		SystemNumberGenerationVO invSNG = systemNumberGenerationDAO.getSystemNumberGeneration(sysCd, invoiceVO.getCompanyId());
		sysCd = invSNG.getCode();					// invc
		String prefixInv = invSNG.getPrefixid();	// INV/CN
		String invNo = FunctionUtils.getUUID(20, invoiceVO.getIssuerId().toString()); // Invoice Number

		if (invoiceVO.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_PAX_STMT)) {
			invoiceVO.setDocTypeStatus(ProductConstant.PAX_STMT_STATUS_OPENED);
			invoiceVO.setPsNo(invNo);
		} 
		
		invoiceVO.setCode(invNo);
		invoiceVO.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_NOT_SUBMIT);
		invoiceVO.seteInvoiceRnStatus(EInvoiceConstant.E_INV_STATUS_NOT_SUBMIT);
		
		Long invId = null;
		
		/*boolean isNotTfairSp = true;
		for (String orderType : SalesConstant.BOOKING_ORDER_TYPE_TFAIR_SP) {
			if (invoiceVO.getOrderCd().startsWith(orderType)) {
				isNotTfairSp = false;
				break;
			}
		}
		if (isNotTfairSp) invoiceVO.setTfairSalerId(null);*/
		if (bySystem) invId = (Long) invoiceDAO.insert(invoiceVO, "SYSTEM");
		else invId = (Long) invoiceDAO.insert(invoiceVO);
		
		// Debit
		AcctTransVO acctTransVO = new AcctTransVO();
		acctTransVO = new AcctTransVO();
		acctTransVO.setCompanyId(invoiceVO.getCompanyId());
		acctTransVO.setAcctId(invoiceVO.getAcctId());
		acctTransVO.setTransDt(invoiceVO.getInvoiceDt());
		acctTransVO.setSysCode(sysCd);
		acctTransVO.setSysPrefix(prefixInv);
		acctTransVO.setSysNo(invoiceVO.getCode());
		acctTransVO.setRefNo(invoiceVO.getCode());
		String source = prefixInv + "-" + invoiceVO.getCode();
		acctTransVO.setSource(source);
		String destination = "Cust-" + invoiceVO.getCustDetailsVO().getContPersonName() + " " + invoiceVO.getCustDetailsVO().getCode();
		// Customer As Company
		if (invoiceVO.getCustDetailsVO().getCustType().equals("C")) {
			destination = "Cust-" + invoiceVO.getCustDetailsVO().getCompanyName() + " " + invoiceVO.getCustDetailsVO().getCode();
		}
		acctTransVO.setDestination(destination);
		if (invoiceVO.getAcctVO() != null) {
			if (!invoiceVO.getAcctVO().getSubCode().equals("")) {
				acctTransVO.setCode(invoiceVO.getAcctVO().getCode() + "-" + invoiceVO.getAcctVO().getSubCode());
				acctTransVO.setDesc(invoiceVO.getAcctVO().getDesc() + "-" + invoiceVO.getAcctVO().getSubDesc());
			} else {
				acctTransVO.setCode(invoiceVO.getAcctVO().getCode());
				acctTransVO.setDesc(invoiceVO.getAcctVO().getDesc());
			}
		} else { 
			acctTransVO.setCode("");
			acctTransVO.setDesc(""); 
		}
		// Credit note total to credit
		if (invoiceVO.getDocTypeCd().equals("C")) {
			acctTransVO.setDebit(0.0);
			acctTransVO.setCredit(invoiceVO.getAmount());
		} else {
			acctTransVO.setDebit(invoiceVO.getAmount());
			acctTransVO.setCredit(0.0);
		}
		acctTransVO.setTaxCode(null);
		acctTransVO.setTaxRate(null);
		acctTransVO.setTaxAmount(0.00);
		if (bySystem) chartOfAcctBO.audAcctTransEmailPayment(CommonConstant.ACTION_CD_ADD, acctTransVO);
		else chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_ADD, acctTransVO);
		
		// insert invoice items
		for (InvoiceItemVO vo : invoiceVO.getInvoiceItemList()) {
			vo.setInvId(invId);
			vo.setStatusCode(BaseConstant.STATUS_ACTIVE);
			Long invItemId = null;
			
			if (bySystem) invItemId = (Long) invoiceDAO.insert(vo, "SYSTEM");
			else invItemId = (Long) invoiceDAO.insert(vo);
			
			// Credit
			acctTransVO = new AcctTransVO();
			acctTransVO.setCompanyId(invoiceVO.getCompanyId());
			acctTransVO.setAcctId(vo.getAcctId());
			acctTransVO.setTransDt(invoiceVO.getInvoiceDt());
			acctTransVO.setSysCode(sysCd);
			acctTransVO.setSysPrefix(prefixInv);
			acctTransVO.setSysNo(invoiceVO.getCode());
			acctTransVO.setRefNo(Long.toString(invItemId));
			acctTransVO.setSource(source);
			acctTransVO.setDestination(destination);
			acctTransVO.setCode(vo.getInvItemCd());
			acctTransVO.setDesc(vo.getDesc());
			if (StringUtils.isNotEmpty(vo.getSubDesc())) acctTransVO.setDesc(acctTransVO.getDesc() + " / " + vo.getSubDesc());
			// Credit note item to debit
			if (invoiceVO.getDocTypeCd().equals("C")) {
				acctTransVO.setDebit(vo.getAmount());
				acctTransVO.setCredit(0.0);
			} else {
				acctTransVO.setDebit(0.0);
				acctTransVO.setCredit(vo.getAmount());
			}
			acctTransVO.setTaxCode(vo.getTaxCode());
			acctTransVO.setTaxRate(vo.getTaxRate());
			acctTransVO.setTaxAmount(vo.getTaxAmount());
			
			if (bySystem) chartOfAcctBO.audAcctTransEmailPayment(CommonConstant.ACTION_CD_ADD, acctTransVO);
			else chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_ADD, acctTransVO);;
		}
		
		// Insert GST or Rounding Account Trans
		if (invoiceVO.getIdAcctGST() != null) 
			acctTransGSTandRounding(invoiceVO, "INS", CommonConstant.SYS_NUM_CD_TAX, sysCd, prefixInv, source, destination, bySystem);
		if (invoiceVO.getIdAcctRounding() != null) 
			acctTransGSTandRounding(invoiceVO, "INS", CommonConstant.SYS_NUM_CD_ROUNDING, sysCd, prefixInv, source, destination, bySystem);
		
		// invoice payment
		List<String> origRcptList = new ArrayList<String>();
		String origRcpt = "";
		for (InvoicePaymentVO vo : invoiceVO.getInvoicePaymentList()) {
			vo.setStatusCode(BaseConstant.STATUS_ACTIVE);
			vo.setInvId(invId);
			
			origRcpt = FunctionUtils.getUUID(20, "");
			vo.setCode(origRcpt);
			origRcptList.add(origRcpt);
			
			if (vo.getRecievedFr() == null) {
				if (invoiceVO.getCustDetailsVO().getCustType().equals("P")) {
					vo.setRecievedFr(invoiceVO.getCustDetailsVO().getContPersonName());
				} else if (invoiceVO.getCustDetailsVO().getCustType().equals("C")) {
					vo.setRecievedFr(invoiceVO.getCustDetailsVO().getCompanyName());
				}
			}
			if (bySystem) invoiceDAO.insert(vo, "SYSTEM");
			else invoiceDAO.insert(vo);
		}
		
		// insert invoice pax
		updateInvoicePax(invoiceVO, null, bySystem);
		
		// invoice eo link
		for (EOInvoiceVO vo : invoiceVO.getEoInvList()) {
			vo.setInvId(invId);
			if (bySystem) invoiceDAO.insert(vo, "SYSTEM");
			else invoiceDAO.insert(vo);
		}
		
		// invoice reference
		for (InvoiceReferenceVO vo : invoiceVO.getGenAUDINvoiceRefVOList().getAddList()) {
			vo.setInvId(invId);
			if (bySystem) invoiceDAO.insert(vo, "SYSTEM");
			else invoiceDAO.insert(vo);
		}
		
		// update booking status
		if (invoiceVO.getBookingId() != null) {
			invoiceDAO.updateBooking(invoiceVO.getBookingId(), bookingPmntStatus, bookingStatus, invoiceVO.getSalerId(), invoiceVO.getCustomerId(), invoiceVO.getOrderCd(), invoiceVO.getTfairSalerId());
		}
		
//		SystemNumberGenerationVO invPmntSNGVO = null;
		
		// Update UUID to auto generate number code
		for (String strOrigRcpt : origRcptList) {
			
			SystemNumberGenerationVO invPmntSNGVO = getSNGVO(CommonConstant.SYS_NUM_CD_ORIG_RCPT, invoiceVO.getCompanyId());
			invoiceDAO.updateInvoicePmntCode(strOrigRcpt, Long.toString(invPmntSNGVO.getNextnumber()));
			
//			invPmntSNGVO = getSNGVO(CommonConstant.SYS_NUM_CD_ORIG_RCPT, invoiceVO.getCompanyId());
//			vo.setCode(invPmntSNGVO.getNextnumber());
//			invoiceDAO.updateInvoicePmntCode(strOrigRcpt, Long.toString(invPmntSNGVO.getNextnumber()));
		}
		
//		for (InvoicePaymentVO vo : invoiceVO.getInvoicePaymentList()) {
//			invPmntSNGVO = getSNGVO(CommonConstant.SYS_NUM_CD_ORIG_RCPT, invoiceVO.getCompanyId());
//			vo.setCode(String.valueOf(invPmntSNGVO.getNextnumber()));
//			invoiceDAO.update(vo);
//		}
		
		// Upload Sales To CRM
//		try {
//			crmUploadSalesService.processCRMUploadSales(invoiceVO);
//		} catch (IOException e) {}
//		
		/*if(StringUtils.equals(invoiceVO.getStatusCd(), CommonConstant.STATUS_CD_FULL_PAYMENT) || StringUtils.equals(invoiceVO.getStatusCd(), CommonConstant.STATUS_CD_DEPOSIT_PAID)) {
			
			for(LookupItemVO vo : lookUpDAO.getLookItemList()) {
				if(StringUtils.equals(vo.getLookupCatCd(), "tour_status") && StringUtils.equals(vo.getCode(), "C1"))
					isExistConfirmed = true;
				else
					isExistConfirmed = false;
			}
			if(isExistConfirmed)
				tourPkgDAO.updateTourStatus(ProductConstant.TOUR_STATUS_CD_CONFIRMED, idTourDep);
			else*/
				tourPkgDAO.updateTourStatus(ProductConstant.TOUR_STATUS_CD_FULL, idTourDep);
		/*}*/
	}
	
	@Override
	public void insertSubPaxStatement(InvoiceVO invoiceVO, Long idTourDep, boolean bySystem) throws BusinessException, QueueException {
		String bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_KIV;
		String bookingStatus = CommonConstant.STATUS_CD_BOOKED;
		
		// Full payment
		if (invoiceVO.getBalance().doubleValue() <= 0) {
			invoiceVO.setIsInvPaid(true);
			invoiceVO.setStatusCd(CommonConstant.STATUS_CD_FULL_PAYMENT);
			bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_FULL;
			bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
			
		} else {
			invoiceVO.setIsInvPaid(false);
			// Deposit
			if (invoiceVO.getAmtPaid().doubleValue() > 0) {
				invoiceVO.setStatusCd(CommonConstant.STATUS_CD_DEPOSIT_PAID);
				bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT;
				bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
			} else {
				if(invoiceVO.getTrvWarrantChecked()) {
					bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT;
					//to fix travel warrant = true booking to be confirm
					bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
					invoiceVO.setStatusCd(CommonConstant.STATUS_CD_DEPOSIT_PAID);
				} else {
					bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_KIV;
					invoiceVO.setStatusCd(CommonConstant.STATUS_CD_INVOICED);
				}
			}
		}
		
		
		String sysCd = CommonConstant.SYS_NUM_CD_INVC;
		// Credit Note
		if (invoiceVO.getDocTypeCd().equals("C")) sysCd = CommonConstant.SYS_NUM_CD_CRDT_NOTE;
		else if (invoiceVO.getDocTypeCd().equals("P")) sysCd = CommonConstant.SYS_NUM_CD_PAX_STMT;

		SystemNumberGenerationVO invSNG = systemNumberGenerationDAO.getSystemNumberGeneration(sysCd, invoiceVO.getCompanyId());
		sysCd = invSNG.getCode();					// invc
		String prefixInv = invSNG.getPrefixid();	// INV/CN
		String invNo = FunctionUtils.getUUID(20, invoiceVO.getIssuerId().toString()); // Invoice Number

		if (invoiceVO.getDocTypeCd().equals("P")) {
//			invoiceVO.setDocTypeStatus(ProductConstant.PAX_STMT_STATUS_OPENED);
//			invoiceVO.setPsNo(invNo);
		} 
		
		// code set before calling insertSubPaxStatement
//		invoiceVO.setCode(invNo);
		
		Long invId = null;
		
		/*boolean isNotTfairSp = true;
		for (String orderType : SalesConstant.BOOKING_ORDER_TYPE_TFAIR_SP) {
			if (invoiceVO.getOrderCd().startsWith(orderType)) {
				isNotTfairSp = false;
				break;
			}
		}
		if (isNotTfairSp) invoiceVO.setTfairSalerId(null);*/
		if (bySystem) invId = (Long) invoiceDAO.insert(invoiceVO, "SYSTEM");
		else invId = (Long) invoiceDAO.insert(invoiceVO);
		
		// Debit
		AcctTransVO acctTransVO = new AcctTransVO();
		acctTransVO = new AcctTransVO();
		acctTransVO.setCompanyId(invoiceVO.getCompanyId());
		acctTransVO.setAcctId(invoiceVO.getAcctId());
		acctTransVO.setTransDt(invoiceVO.getInvoiceDt());
		acctTransVO.setSysCode(sysCd);
		acctTransVO.setSysPrefix(prefixInv);
		acctTransVO.setSysNo(invoiceVO.getCode());
		acctTransVO.setRefNo(invoiceVO.getCode());
		String source = prefixInv + "-" + invoiceVO.getCode();
		acctTransVO.setSource(source);
		String destination = "Cust-" + invoiceVO.getCustDetailsVO().getContPersonName() + " " + invoiceVO.getCustDetailsVO().getCode();
		// Customer As Company
		if (invoiceVO.getCustDetailsVO().getCustType().equals("C")) {
			destination = "Cust-" + invoiceVO.getCustDetailsVO().getCompanyName() + " " + invoiceVO.getCustDetailsVO().getCode();
		}
		acctTransVO.setDestination(destination);
		if (invoiceVO.getAcctVO() != null) {
			if (!invoiceVO.getAcctVO().getSubCode().equals("")) {
				acctTransVO.setCode(invoiceVO.getAcctVO().getCode() + "-" + invoiceVO.getAcctVO().getSubCode());
				acctTransVO.setDesc(invoiceVO.getAcctVO().getDesc() + "-" + invoiceVO.getAcctVO().getSubDesc());
			} else {
				acctTransVO.setCode(invoiceVO.getAcctVO().getCode());
				acctTransVO.setDesc(invoiceVO.getAcctVO().getDesc());
			}
		} else { 
			acctTransVO.setCode("");
			acctTransVO.setDesc(""); 
		}
		// Credit note total to credit
		if (invoiceVO.getDocTypeCd().equals("C")) {
			acctTransVO.setDebit(0.0);
			acctTransVO.setCredit(invoiceVO.getAmount());
		} else {
			acctTransVO.setDebit(invoiceVO.getAmount());
			acctTransVO.setCredit(0.0);
		}
		acctTransVO.setTaxCode(null);
		acctTransVO.setTaxRate(null);
		acctTransVO.setTaxAmount(0.00);
		if (bySystem) chartOfAcctBO.audAcctTransEmailPayment(CommonConstant.ACTION_CD_ADD, acctTransVO);
		else chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_ADD, acctTransVO);
		
		// insert invoice items
		for (InvoiceItemVO vo : invoiceVO.getInvoiceItemList()) {
			
			// skip insert when qty is zero
			if (vo.getQty().equals(0))	continue;
			
			vo.setInvId(invId);
			vo.setStatusCode(BaseConstant.STATUS_ACTIVE);
			Long invItemId = null;
			
			if (bySystem) invItemId = (Long) invoiceDAO.insert(vo, "SYSTEM");
			else invItemId = (Long) invoiceDAO.insert(vo);
			
			// Credit
			acctTransVO = new AcctTransVO();
			acctTransVO.setCompanyId(invoiceVO.getCompanyId());
			acctTransVO.setAcctId(vo.getAcctId());
			acctTransVO.setTransDt(invoiceVO.getInvoiceDt());
			acctTransVO.setSysCode(sysCd);
			acctTransVO.setSysPrefix(prefixInv);
			acctTransVO.setSysNo(invoiceVO.getCode());
			acctTransVO.setRefNo(Long.toString(invItemId));
			acctTransVO.setSource(source);
			acctTransVO.setDestination(destination);
			acctTransVO.setCode(vo.getInvItemCd());
			acctTransVO.setDesc(vo.getDesc());
			if (StringUtils.isNotEmpty(vo.getSubDesc())) acctTransVO.setDesc(acctTransVO.getDesc() + " / " + vo.getSubDesc());
			// Credit note item to debit
			if (invoiceVO.getDocTypeCd().equals("C")) {
				acctTransVO.setDebit(vo.getAmount());
				acctTransVO.setCredit(0.0);
			} else {
				acctTransVO.setDebit(0.0);
				acctTransVO.setCredit(vo.getAmount());
			}
			acctTransVO.setTaxCode(vo.getTaxCode());
			acctTransVO.setTaxRate(vo.getTaxRate());
			acctTransVO.setTaxAmount(vo.getTaxAmount());
			
			if (bySystem) chartOfAcctBO.audAcctTransEmailPayment(CommonConstant.ACTION_CD_ADD, acctTransVO);
			else chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_ADD, acctTransVO);;
		}
		
		// Insert GST or Rounding Account Trans
		if (invoiceVO.getIdAcctGST() != null) 
			acctTransGSTandRounding(invoiceVO, "INS", CommonConstant.SYS_NUM_CD_TAX, sysCd, prefixInv, source, destination, bySystem);
		if (invoiceVO.getIdAcctRounding() != null) 
			acctTransGSTandRounding(invoiceVO, "INS", CommonConstant.SYS_NUM_CD_ROUNDING, sysCd, prefixInv, source, destination, bySystem);
		
		// invoice payment
		List<String> origRcptList = new ArrayList<String>();
		String origRcpt = "";
		for (InvoicePaymentVO vo : invoiceVO.getInvoicePaymentList()) {
			vo.setStatusCode(BaseConstant.STATUS_ACTIVE);
			vo.setInvId(invId);
			
			origRcpt = FunctionUtils.getUUID(20, "");
			vo.setCode(origRcpt);
			origRcptList.add(origRcpt);
			
			if (vo.getRecievedFr() == null) {
				if (invoiceVO.getCustDetailsVO().getCustType().equals("P")) {
					vo.setRecievedFr(invoiceVO.getCustDetailsVO().getContPersonName());
				} else if (invoiceVO.getCustDetailsVO().getCustType().equals("C")) {
					vo.setRecievedFr(invoiceVO.getCustDetailsVO().getCompanyName());
				}
			}
			if (bySystem) invoiceDAO.insert(vo, "SYSTEM");
			else invoiceDAO.insert(vo);
			
			if (CollectionUtils.isNotEmpty(vo.getInvoicePaymentAttachmentList())) {
				for (InvoicePaymentAttachmentVO attachmentVO : vo.getInvoicePaymentAttachmentList()) {
//					InvoicePaymentAttachmentVO clonedVO = SerializationUtils.clone(attachmentVO);
					attachmentVO.setIdInvPmnt(vo.getId());
					if (bySystem) invoiceDAO.insert(attachmentVO, "SYSTEM");
					else invoiceDAO.insert(attachmentVO);
				}
			}
		}
		
		// insert invoice pax
		updateInvoicePax(invoiceVO, null, bySystem);
		
		// invoice eo link
		for (EOInvoiceVO vo : invoiceVO.getEoInvList()) {
			vo.setInvId(invId);
			if (bySystem) invoiceDAO.insert(vo, "SYSTEM");
			else invoiceDAO.insert(vo);
		}
		
		// invoice reference
//		for (InvoiceReferenceVO vo : invoiceVO.getGenAUDINvoiceRefVOList().getAddList()) { // original code in insertInvoice
		for (InvoiceReferenceVO oriVO : invoiceVO.getInvoiceRefVOList()) { // **
			InvoiceReferenceVO vo = SerializationUtils.clone(oriVO); // **
			vo.setInvId(invId);
			if (bySystem) invoiceDAO.insert(vo, "SYSTEM");
			else invoiceDAO.insert(vo);
		}
		
		// code apart from insertInvoice, to insert invoice attachment
		if (CollectionUtils.isNotEmpty(invoiceVO.getInvoiceAttachmentVOList())) {
			for (InvoiceAttachmentVO vo : invoiceVO.getInvoiceAttachmentVOList()) {
				vo.setInvId(invoiceVO.getId());
				invoiceDAO.insert(vo);
			}
		}
		
//		terminateAcctTrans(invoiceVO);
		
		// update booking status
		if (invoiceVO.getBookingId() != null) {
			invoiceDAO.updateBooking(invoiceVO.getBookingId(), bookingPmntStatus, bookingStatus, invoiceVO.getSalerId(), invoiceVO.getCustomerId(), invoiceVO.getOrderCd(), invoiceVO.getTfairSalerId());
		}
		
		// Update UUID to auto generate number code
		for (String strOrigRcpt : origRcptList) {
			SystemNumberGenerationVO invPmntSNGVO = getSNGVO(CommonConstant.SYS_NUM_CD_ORIG_RCPT, invoiceVO.getCompanyId());
			invoiceDAO.updateInvoicePmntCode(strOrigRcpt, Long.toString(invPmntSNGVO.getNextnumber()));
		}
		
		// Upload Sales To CRM
//		try {
//			crmUploadSalesService.processCRMUploadSales(invoiceVO);
//		} catch (IOException e) {}
//		
		/*if(StringUtils.equals(invoiceVO.getStatusCd(), CommonConstant.STATUS_CD_FULL_PAYMENT) || StringUtils.equals(invoiceVO.getStatusCd(), CommonConstant.STATUS_CD_DEPOSIT_PAID)) {
			
			for(LookupItemVO vo : lookUpDAO.getLookItemList()) {
				if(StringUtils.equals(vo.getLookupCatCd(), "tour_status") && StringUtils.equals(vo.getCode(), "C1"))
					isExistConfirmed = true;
				else
					isExistConfirmed = false;
			}
			if(isExistConfirmed)
				tourPkgDAO.updateTourStatus(ProductConstant.TOUR_STATUS_CD_CONFIRMED, idTourDep);
			else*/
				tourPkgDAO.updateTourStatus(ProductConstant.TOUR_STATUS_CD_FULL, idTourDep);
			
		/*}*/
				
		// insert invoice history
		insertInvoiceHistory(invoiceVO.getId(), CommonConstant.ACTION_CD_ADD, "");
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.InvoiceService#updInvCd(com.bcs.zsg.sales.vo.InvoiceVO)
	 */
	@Override
	public void updInvCd(InvoiceVO invoiceVO) throws BusinessException, QueueException {
		// Why need this function cause facing deadlock issues on invoiceDAO.updateInvoiceCode
		
		String sysCd = CommonConstant.SYS_NUM_CD_INVC;
		
//		Long invCodeRN = null;
		
		// Credit Note
		if (invoiceVO.getDocTypeCd().equals("C")) {
			sysCd = CommonConstant.SYS_NUM_CD_CRDT_NOTE;
			
//			SystemNumberGenerationVO invSNGVORN = getSNGVO(CommonConstant.SYS_NUM_CD_RFND_NOTE, invoiceVO.getCompanyId());
//			invCodeRN = invSNGVORN.getNextnumber();
		} else if (invoiceVO.getDocTypeCd().equals("P")) { // Pax Statement
			sysCd = CommonConstant.SYS_NUM_CD_PAX_STMT;
		}
		
		// Update UUID to auto generate number code
		SystemNumberGenerationVO invSNGVO = getSNGVO(sysCd, invoiceVO.getCompanyId());
		Long invCode = invSNGVO.getNextnumber();
		
		// Credit Note Update invoice payment ref no
//		if (invoiceVO.getDocTypeCd().equals("C") && StringUtils.isNotEmpty(invoiceVO.getCnInvNo())) {
//			logger.info("########## CN " + invCode + " Update Payment: " + invoiceVO.getId() + " / Inv Pmnt ID: " + invoiceVO.getInvPmntId());
//			invoiceDAO.updateInvoicePaymentRef(invoiceVO.getCompanyId(), Long.toString(invCode), invoiceVO.getId(), invoiceVO.getInvPmntId());
//		}
		
		// Credit Note Update invoice payment ref no
		if (invoiceVO.getDocTypeCd().equals("C")) {
			if (invoiceVO.getCnInv() != null && StringUtils.isNotBlank(invoiceVO.getCnInv().getDocTypeCd())) {
				
				if (invoiceVO.getCnInv().getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_PAX_STMT)) {
					if (StringUtils.isNotBlank(invoiceVO.getCnPsNo())) {
						logger.error("########## CN " + invCode + " Update Payment: " + invoiceVO.getId() + " / Inv Pmnt ID: " + invoiceVO.getInvPmntId());
						invoiceDAO.updateInvoicePaymentRef(invoiceVO.getCompanyId(), Long.toString(invCode), invoiceVO.getId(), invoiceVO.getInvPmntId());
					}
				} else if (invoiceVO.getCnInv().getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_INVC)) {
					if (StringUtils.isNotBlank(invoiceVO.getCnInvNo())) {
						logger.error("########## CN " + invCode + " Update Payment: " + invoiceVO.getId() + " / Inv Pmnt ID: " + invoiceVO.getInvPmntId());
						invoiceDAO.updateInvoicePaymentRef(invoiceVO.getCompanyId(), Long.toString(invCode), invoiceVO.getId(), invoiceVO.getInvPmntId());
					}
					
					if (StringUtils.isNotBlank(invoiceVO.getCnPsNo())) {
						InvoicePaymentVO paymentVO = invoiceDAO.getInvPaymentById(invoiceVO.getInvPmntId());
						if (paymentVO.getIdParentPmnt() != null) {
							invoiceDAO.updatePsPaymentRef(invoiceVO.getCompanyId(), Long.toString(invCode), invoiceVO.getId(), paymentVO.getIdParentPmnt());
						} else {
							// CN payment is not added in PS, it is added after PS convert to INV
							// do nothing
						}
					}
				} else {
					throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Invalid doc type code \"" + invoiceVO.getCnInv().getDocTypeCd() + "\""));
				}
				
			} else if (invoiceVO.getCnInv() == null) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("No CN document."));
			} else if (StringUtils.isBlank(invoiceVO.getCnInv().getDocTypeCd())) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("CN document does not have a doc type code."));
			}
		}
		
		if (invoiceVO.getDocTypeCd().equals("C")) {
			logger.error("########## Create Credit Note No.: " + invCode + " ########## " + invoiceVO.getCode());
		} else {
			logger.error("########## [" + invoiceVO.getDocTypeCd() + "] Create Invoice No.: " + invCode + " ########## " + invoiceVO.getCode());
		}
		
		try {
//			if (invCodeRN != null)
//				invoiceDAO.updateInvoiceCode(invoiceVO.getCode(), Long.toString(invCode), invoiceVO.getDocTypeCd(), Long.toString(invCodeRN));
//			else
				invoiceDAO.updateInvoiceCode(invoiceVO.getCode(), Long.toString(invCode), invoiceVO.getDocTypeCd());
			
			invoiceVO.setCode(Long.toString(invCode));
//			if (invoiceVO.getDocTypeCd().equals("C") && invCodeRN != null) invoiceVO.setRnNo(Long.toString(invCodeRN));
		} catch (LockAcquisitionException e) {
		    try {
		    	logger.error("########## ERR - Trigger LockAcquisitionException Doc. No.[" + invoiceVO.getDocTypeCd() + "]: " + invCode + " ########## " + invoiceVO.getCode());
		        Thread.sleep(1000);
//		        if (invCodeRN != null)
//		        	invoiceDAO.updateInvoiceCode(invoiceVO.getCode(), Long.toString(invCode), invoiceVO.getDocTypeCd(), Long.toString(invCodeRN));
//		        else
		        	invoiceDAO.updateInvoiceCode(invoiceVO.getCode(), Long.toString(invCode), invoiceVO.getDocTypeCd());
				invoiceVO.setCode(Long.toString(invCode));
//				if (invoiceVO.getDocTypeCd().equals("C") && invCodeRN != null) invoiceVO.setRnNo(Long.toString(invCodeRN));
		     } catch(Exception e2) {
		    	 e2.printStackTrace();
		    	throw e;
		    }
		}
	}
	
	@Override
	public void updRfndNoteCd(InvoiceVO invoiceVO) throws BusinessException, QueueException {
		InvoiceVO invVO = getInvoiceById(invoiceVO.getId());
		if (StringUtils.isNotEmpty(invVO.getRnNo())) return;
		
		SystemNumberGenerationVO invSNGVORN = getSNGVO(CommonConstant.SYS_NUM_CD_RFND_NOTE, invoiceVO.getCompanyId());
		Long invCodeRN = invSNGVORN.getNextnumber();
		
		logger.error("########## Update Credit Note No.: " + invoiceVO.getCode() + ", id: " + invoiceVO.getId() + ", Refind Note No.: " + invCodeRN);
		
		try {
			invoiceDAO.updateRfndNoteCode(invoiceVO.getId(), invoiceVO.getDocTypeCd(), Long.toString(invCodeRN));
			if (invoiceVO.getDocTypeCd().equals("C") && invCodeRN != null) invoiceVO.setRnNo(Long.toString(invCodeRN));
		} catch (LockAcquisitionException e) {
		    try {
		        Thread.sleep(1000);
		        
		        invoiceDAO.updateInvoiceCode(invoiceVO.getCode(), invoiceVO.getDocTypeCd(), Long.toString(invCodeRN));
				if (invoiceVO.getDocTypeCd().equals("C") && invCodeRN != null) invoiceVO.setRnNo(Long.toString(invCodeRN));
		     } catch(Exception e2) {
		    	throw e;
		    }
		}
	}
	
