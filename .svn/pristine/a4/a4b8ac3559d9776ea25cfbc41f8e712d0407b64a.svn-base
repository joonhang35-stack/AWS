	/**
	 * https://applevacationsmy.monday.com/boards/1957264979/pulses/2049220073
	 */
	@Override
	public List<InvoiceVO> getInvoiceListToSubmitEInvoice(Map <String, Object> params, Date dateChecked) throws BusinessException {
		
		TrackingLogUtils trackingLogUtils = new TrackingLogUtils(getClass());
		trackingLogUtils.startLogs();
		
		AppSettingVO appSettingVO = appSettingService.getAppSettingByCode(ConstantAppSetting.MAINT_AUTO_E_INV_CONFIG_SCHEDULER_SUBMIT_INV_CAT);
		List<String> invCatList = Arrays.asList(appSettingVO.getValue().split(","));
		
		List<InvoiceVO> invoiceList = invoiceDAO.getInvoiceListByParams(params);
		System.out.println("CYY invoiceList.size(): " + invoiceList.size());
		System.out.println("CYY dateChecked: " + dateChecked);
		
		trackingLogUtils.endLogs("getInvoiceListByParams"); trackingLogUtils.startLogs();
		
//		invoiceList.clear();
		
		if (CollectionUtils.isEmpty(invoiceList)) {
			return invoiceList;
		}
		
		List<InvoiceVO> returnInvList = new ArrayList<InvoiceVO>();
		
		for (InvoiceVO invVO : invoiceList) {
			
			if (invVO.isSkipAutoSubmit())	continue;
			
			if (StringUtils.equalsIgnoreCase(invVO.getCatCd(), CommonConstant.LOOKUP_ITM_INV_CAT_TOUR) && invCatList.contains(CommonConstant.LOOKUP_ITM_INV_CAT_TOUR)) {
				if (DatesUtils.isDateBetween(invVO.getDepartureDt(), EInvoiceConstant.getEInvoiceSchedulerTourStartDate(), dateChecked)) {
					if (invVO.getAmount() == 0.0)	continue; // if amt = 0, skip
					returnInvList.add(invVO);
				}
		    } else if (StringUtils.equalsIgnoreCase(invVO.getCatCd(), CommonConstant.LOOKUP_ITM_INV_CAT_TICKETING) && invCatList.contains(CommonConstant.LOOKUP_ITM_INV_CAT_TICKETING)) {
				if (DatesUtils.isDateBetween(invVO.getInvoiceDt(), EInvoiceConstant.getEInvoiceSchedulerTktStartDate(), dateChecked)) {
					if (shouldSkipAutoSubmitForAllInvCategory(invVO))	continue; 
					returnInvList.add(invVO);
				}
		    }
		}
		
		System.out.println("CYY returnInvList.size(): " + returnInvList.size());
		
		trackingLogUtils.endLogs("getInvoiceListToSubmitEInvoice");
		
		return returnInvList;
	}
	
	/**
	 * Determines whether the given invoice should be excluded from e-Invoice auto submission
	 * under the "All Invoice Category" rule.
	 *
	 * <p>The invoice will be skipped when all of the following conditions are met:</p>
	 * <ul>
	 *   <li>Total Sales Amount = 0</li>
	 *   <li>booking status is BOOKED, CONFIRMED, or null (no booking)</li>
	 * </ul>
	 * https://applevacationsmy.monday.com/boards/1957264979/pulses/2049220073
	 * <p></p>
	 * @param invVO
	 * @return
	 * @throws BusinessException 
	 */
	private boolean shouldSkipAutoSubmitForAllInvCategory(InvoiceVO invVO) throws BusinessException {
		if (invVO.getAmount() == 0.0) {
			if (invVO.getBookingId() != null && invVO.getIdParentInvTourBooking() != null) {
				BookingVO bookingVO = bookingDAO.getBooking(invVO.getBookingId() == null ? invVO.getIdParentInvTourBooking() : invVO.getBookingId());
				if (bookingVO == null 
						|| StringUtils.equalsIgnoreCase(bookingVO.getStatusCode(), CommonConstant.STATUS_CD_BOOKED)
						|| StringUtils.equalsIgnoreCase(bookingVO.getStatusCode(), CommonConstant.STATUS_CD_CONFIRMED)) {
//						Scenario 2:
//							Invoice Category = All 
//							Booking Status = Booked, Confirmed or null
//							Total Sales Amount = 0
					return true;
				}
				
			} else {
				return true; // if amt = 0, no booking, skip
			}
		}
		
//		Scenario 3:
//			Invoice Category = All
//			Booking Status & Invoice Payment Status = Void
//			Total Sales Amount = or ≠ 0
		
		// the pulled invoices list already excluded voided invoices
		
		return false;
	}
	
	@Override
	public void undoSplitPS(Long idInv) throws BusinessException, QueueException {
		List <InvoiceVO> invoiceList = getInvoiceByParentInvoiceId(idInv);
		for (InvoiceVO subInvoiceVO : invoiceList) {
			if (subInvoiceVO.getStatusCd().equals(CommonConstant.STATUS_CD_VOID) || subInvoiceVO.getStatusCd().equals(CommonConstant.STATUS_CD_CANCELLED)) {
				continue;
			}
			subInvoiceVO = getInvoiceDetails(subInvoiceVO);
			subInvoiceVO.setDocTypeStatus(ProductConstant.PAX_STMT_STATUS_CLOSED);	
			deleteInvoice(subInvoiceVO);
			terminateAcctTrans(subInvoiceVO, CommonConstant.ACTION_CD_DEL);
			insertInvoiceHistory(subInvoiceVO.getId(), CommonConstant.ACTION_CD_DEL, "UNDO SPLIT");
		}
		
		InvoiceVO invoiceVO = getInvoiceById(idInv);
		invoiceVO = getInvoiceDetails(invoiceVO);
		
		// insert back inv pmnt added in sub pmnt (not split from pr stmt)
		for (InvoiceVO subInvoiceVO : invoiceList) {
			for (InvoicePaymentVO paymentVO : subInvoiceVO.getInvoicePaymentList()) {
				if (paymentVO.getIdParentPmnt() == null) {
					InvoicePaymentVO clonedPaymentVO = SerializationUtils.clone(paymentVO);
					clonedPaymentVO.setInvId(invoiceVO.getId());
					clonedPaymentVO.setIdParentPmnt(null);
					invoiceVO.getInvoicePaymentList().add(clonedPaymentVO);
					
					InvPmntCBLinkVO linkVO = depositDAO.getInvPmntCBLinkByIdInvPmnt(paymentVO.getId());
					if (linkVO != null) {
						linkVO.setIdInvoice(invoiceVO.getId());
						linkVO.setInvoiceNo(invoiceVO.getPsNo());
						depositDAO.update(linkVO);
					}
				}
			}
		}
		calTtlAmt(invoiceVO);
		
		// set status opened
		invoiceVO.setDocTypeStatus(ProductConstant.PAX_STMT_STATUS_OPENED);
		
		// upd inv
		updateInvoice(invoiceVO, invoiceVO.getTourDepId(), true);
		
		// reactivate terminated account trans
		terminateAcctTrans(invoiceVO, CommonConstant.ACTION_CD_ADD);
	}
}
