	/**
	 * update invoice payments only for invoice converted from pax statement
	 * @throws BusinessException 
	 * @throws QueueException 
	 */
	@Override
	public void updateInvoicePayments(InvoiceVO invoiceVO, Long idTourDep, Boolean isUpdateCashBook) throws BusinessException, QueueException {
		
		long start = System.currentTimeMillis();
		
		String bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_KIV;
		String bookingStatus = CommonConstant.STATUS_CD_BOOKED;
		
		// Full payment
		if (invoiceVO.getBalance().doubleValue() <= 0) {
			invoiceVO.setIsInvPaid(true);
			invoiceVO.setStatusCd(CommonConstant.STATUS_CD_FULL_PAYMENT);
			bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_FULL;
			bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
		} else {
			invoiceVO.setIsInvPaid(false);
			// Deposit
			if (invoiceVO.getAmtPaid().doubleValue() > 0) {
				invoiceVO.setStatusCd(CommonConstant.STATUS_CD_DEPOSIT_PAID);
				bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT;
				bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
			} else {
				if(invoiceVO.getTrvWarrantChecked()) {
					bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT;
					//to fix travel warrant = true booking to be confirm
					bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
					invoiceVO.setStatusCd(CommonConstant.STATUS_CD_DEPOSIT_PAID);
				} else {
					bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_KIV;
					invoiceVO.setStatusCd(CommonConstant.STATUS_CD_INVOICED);
				}
			}
		}
		
		// update by SQL query, update only related columns
		invoiceDAO.updateStatus(invoiceVO);
		invoiceDAO.updateInvoiceAmount(invoiceVO, true, true);
//		invoiceDAO.update(invoiceVO);
		
		// update booking status
		if (invoiceVO.getBookingId() != null) {
			invoiceDAO.updateBooking(invoiceVO.getBookingId(), bookingPmntStatus, bookingStatus, invoiceVO.getSalerId(), invoiceVO.getCustomerId(), invoiceVO.getOrderCd(), invoiceVO.getTfairSalerId());
		}
		
		// Update booking to lock if tour departure status is `ISSUED`
		if (invoiceVO.getBookingId() != null && invoiceVO.getTourDepId() != null) {
			TourDepartureVO tourDepVO = tourPkgDAO.getTourDepById(invoiceVO.getTourDepId());
			
			if (tourDepVO != null && StringUtils.equals(tourDepVO.getTourStatusCd(), CommonConstant.LOOKUP_ITM_DEPT_TOUR_STATUS_ISSUED)) {
				BookingVO bookingVO = bookingDAO.getBooking(invoiceVO.getBookingId());
				if (bookingVO.getLockStatus() == false) {
					bookingVO.setLockStatus(true);
					invoiceDAO.update(bookingVO);
				}
			} else if (tourDepVO != null && !StringUtils.equals(tourDepVO.getTourStatusCd(), CommonConstant.LOOKUP_ITM_DEPT_TOUR_STATUS_ISSUED)) {
				if (tourDepVO.getIsLock() != null && tourDepVO.getIsLock() == true) {
					BookingVO bookingVO = bookingDAO.getBooking(invoiceVO.getBookingId());
					if (bookingVO.getLockStatus() == false) {
						bookingVO.setLockStatus(true);
						invoiceDAO.update(bookingVO);
					}
				}
			}
		}
		
		// to check id_credit_note updated in after user opened inv and before saved inv
		// issue : after saved CN, id_credit_note will be covered after inv saved as the pmnt data carried in the opened inv is not the latest
		List <InvoicePaymentVO> dbPmntList = invoiceDAO.getInvPmntList(invoiceVO.getId());
		if (CollectionUtils.isNotEmpty(invoiceVO.getInvoicePaymentList()) && CollectionUtils.isNotEmpty(dbPmntList)) {
			for (InvoicePaymentVO openedPmntVO : invoiceVO.getInvoicePaymentList()) { // original
				for (InvoicePaymentVO dbPmntVO : dbPmntList) { // current
					if (openedPmntVO.getId() != null && openedPmntVO.getId().equals(dbPmntVO.getId())) {
						if (dbPmntVO.getCreditNoteId() != null && openedPmntVO.getCreditNoteId() == null) {
							openedPmntVO.setCreditNoteId(dbPmntVO.getCreditNoteId());
							openedPmntVO.setRefNo(dbPmntVO.getRefNo());
						}
					}
				}
			}
		}
		
//		System.out.println(" ### Speed : " + (System.currentTimeMillis() - start1));
//		System.out.println("\n---\n");
		
		List<String> origRcptList = new ArrayList<String>();
		String origRcpt = "";
		invoiceDAO.terminateInvoiceSubInfo("invoice_pmnt", invoiceVO.getId());
		if (CollectionUtils.isNotEmpty(invoiceVO.getInvoicePaymentList())) {
			for (InvoicePaymentVO vo : invoiceVO.getInvoicePaymentList()) {
//					System.out.println("id=" + vo.getId() + " id_credit_note=" + vo.getCreditNoteId());
				vo.setStatusCode(BaseConstant.STATUS_ACTIVE);
				// insert
				if (vo.getId() == null) {
					origRcpt = FunctionUtils.getUUID(20, "");
					vo.setCode(origRcpt);
					origRcptList.add(origRcpt);
					
					invoiceDAO.insert(vo);
				// update
				} else invoiceDAO.update(vo);
			}
		}
		
		// Update UUID to auto generate number code
		for (String strOrigRcpt : origRcptList) {
			SystemNumberGenerationVO invPmntSNGVO = getSNGVO(CommonConstant.SYS_NUM_CD_ORIG_RCPT, invoiceVO.getCompanyId());
			invoiceDAO.updateInvoicePmntCode(strOrigRcpt, Long.toString(invPmntSNGVO.getNextnumber()));
		}
		
		tourPkgDAO.updateTourStatus(ProductConstant.TOUR_STATUS_CD_FULL, idTourDep);
	}
	
	@Override
	public void updateInvoiceForEmailPayment(InvoiceVO invoiceVO, Long idTourDep) throws BusinessException, QueueException {
		String bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_KIV;
		String bookingStatus = CommonConstant.STATUS_CD_BOOKED;
		
		// Full payment
		if (invoiceVO.getBalance().doubleValue() <= 0) {
			invoiceVO.setIsInvPaid(true);
			invoiceVO.setStatusCd(CommonConstant.STATUS_CD_FULL_PAYMENT);
			bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_FULL;
			bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
		} else {
			invoiceVO.setIsInvPaid(false);
			// Deposit
			if (invoiceVO.getAmtPaid().doubleValue() > 0) {
				invoiceVO.setStatusCd(CommonConstant.STATUS_CD_DEPOSIT_PAID);
				bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT;
				bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
			} else {
				if(invoiceVO.getTrvWarrantChecked()) {
					bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT;
					//to fix travel warrant = true booking to be confirm
					bookingStatus = CommonConstant.STATUS_CD_CONFIRMED;
					invoiceVO.setStatusCd(CommonConstant.STATUS_CD_DEPOSIT_PAID);
				} else {
					bookingPmntStatus = SalesConstant.BOOKING_PMNT_STATUS_KIV;
					invoiceVO.setStatusCd(CommonConstant.STATUS_CD_INVOICED);
				}
			}
		}
		
		invoiceDAO.update(invoiceVO, "SYSTEM");
		
		updateInvoiceItems(invoiceVO, true);
		
		// update booking status
		if (invoiceVO.getBookingId() != null) {
			invoiceDAO.updateBooking(invoiceVO.getBookingId(), bookingPmntStatus, bookingStatus, invoiceVO.getSalerId(), invoiceVO.getCustomerId(), null, invoiceVO.getTfairSalerId());
		}
		
		// Update booking to lock if tour departure status is `ISSUED`
		if (invoiceVO.getBookingId() != null && invoiceVO.getTourDepId() != null) {
			TourDepartureVO tourDepVO = tourPkgDAO.getTourDepById(invoiceVO.getTourDepId());
			
			if (tourDepVO != null && StringUtils.equals(tourDepVO.getTourStatusCd(), CommonConstant.LOOKUP_ITM_DEPT_TOUR_STATUS_ISSUED)) {
				BookingVO bookingVO = bookingDAO.getBooking(invoiceVO.getBookingId());
				bookingVO.setLockStatus(true);
				invoiceDAO.update(bookingVO, "SYSTEM");
			}
		}
		
		List<String> origRcptList = new ArrayList<String>();
		String origRcpt = "";
		invoiceDAO.terminateInvoiceSubInfo("invoice_pmnt", invoiceVO.getId());
		if (CollectionUtils.isNotEmpty(invoiceVO.getInvoicePaymentList())) {
			for (InvoicePaymentVO vo : invoiceVO.getInvoicePaymentList()) {
				vo.setStatusCode(BaseConstant.STATUS_ACTIVE);
				// insert
				if (vo.getId() == null) {
					origRcpt = FunctionUtils.getUUID(20, "");
					vo.setCode(origRcpt);
					origRcptList.add(origRcpt);
					
					invoiceDAO.insert(vo, "SYSTEM");
				// update
				} else invoiceDAO.update(vo, "SYSTEM");
			}
		}
		
		if (CollectionUtils.isNotEmpty(invoiceVO.getGenAUDINvoiceRefVOList().getAddList())) {
			for (InvoiceReferenceVO vo : invoiceVO.getGenAUDINvoiceRefVOList().getAddList()) {
				vo.setInvId(invoiceVO.getId());
				invoiceDAO.insert(vo, "SYSTEM");
			}
		}
		
		// update invoice pax
		invoiceDAO.terminateInvoiceSubInfo("invoice_pax", invoiceVO.getId());
		updateInvoicePax(invoiceVO, null, true);
		
		// Update UUID to auto generate number code
		for (String strOrigRcpt : origRcptList) {
			SystemNumberGenerationVO invPmntSNGVO = getSNGVO(CommonConstant.SYS_NUM_CD_ORIG_RCPT, invoiceVO.getCompanyId());
			invoiceDAO.updateInvoicePmntCode(strOrigRcpt, Long.toString(invPmntSNGVO.getNextnumber()));
		}

		// Credit Note Update invoice payment ref no
		if (invoiceVO.getDocTypeCd().equals("C") && StringUtils.isNotEmpty(invoiceVO.getCnInvNo())) {
			invoiceDAO.updateInvoicePaymentRef(invoiceVO.getCompanyId(), invoiceVO.getCode(), invoiceVO.getId(), invoiceVO.getInvPmntId());
		}
		
		tourPkgDAO.updateTourStatus(ProductConstant.TOUR_STATUS_CD_FULL, idTourDep);
	}

	/* (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.InvoiceService#deleteInvoice(com.bcs.zsg.sales.vo.InvoiceVO)
	 */
	@Override
	public void deleteInvoice(InvoiceVO invoiceVO) throws BusinessException {
		String bookingStatus = CommonConstant.STATUS_CD_VOID;
		AcctTransVO acctTransVO = new AcctTransVO();
		//String statusCrDr = "";
		
		// No payment
		if (invoiceVO.getStatusCd().equals(CommonConstant.STATUS_CD_INVOICED)) {
			invoiceVO.setStatusCd(CommonConstant.STATUS_CD_VOID);
			
			String sysCd = CommonConstant.SYS_NUM_CD_INVC;
			if (invoiceVO.getDocTypeCd().equals("C")) sysCd = CommonConstant.SYS_NUM_CD_CRDT_NOTE;
			else if (invoiceVO.getDocTypeCd().equals("P"))	sysCd = CommonConstant.SYS_NUM_CD_PAX_STMT;
			
			for (InvoiceItemVO vo : invoiceVO.getInvoiceItemList()) {
				//Retrieve data from transaction table
				//statusCrDr = "Credit";
				//if (invoiceVO.getDocTypeCd().equals("C")) statusCrDr = "Debit";
				
				acctTransVO = invoiceDAO.getAcctTransVO(sysCd, invoiceVO.getCode(), Long.toString(vo.getId()), invoiceVO.getCompanyId());
				if (acctTransVO != null) {
					chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_DEL, acctTransVO);
				}
			}
			
			//Retrieve data from transaction table
			//statusCrDr = "Debit";
			//if (invoiceVO.getDocTypeCd().equals("C")) statusCrDr = "Credit";
			acctTransVO = invoiceDAO.getAcctTransVO(sysCd, invoiceVO.getCode(), invoiceVO.getCode(), invoiceVO.getCompanyId());
			if (acctTransVO != null) {
				chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_DEL, acctTransVO);
			}
			
			List<AcctTransVO> acctTransList = acctTransDAO.getAcctTransTaxRndList(invoiceVO.getCompanyId(), sysCd, invoiceVO.getCode());
			for(AcctTransVO acctVO : acctTransList) {
				chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_DEL, acctVO);
			}
		} else {
			//invoiceVO.setStatusCd(CommonConstant.STATUS_CD_VOID);
			invoiceVO.setStatusCd(CommonConstant.STATUS_CD_CANCELLED);
			bookingStatus = CommonConstant.STATUS_CD_CANCELLED;
			
			// When credit note delete [Warning] just for credit note
			if (invoiceVO.getDocTypeCd().equals("C")) {
				String sysCd = CommonConstant.SYS_NUM_CD_CRDT_NOTE;
				for (InvoiceItemVO vo : invoiceVO.getInvoiceItemList()) {
					//Retrieve data from transaction table
					//statusCrDr = "Debit";
					acctTransVO = invoiceDAO.getAcctTransVO(sysCd, invoiceVO.getCode(), Long.toString(vo.getId()), invoiceVO.getCompanyId());
					if (acctTransVO != null) {
						chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_DEL, acctTransVO);
					}
				}
				
				//Retrieve data from transaction table
				//statusCrDr = "Credit";
				acctTransVO = invoiceDAO.getAcctTransVO(sysCd, invoiceVO.getCode(), invoiceVO.getCode(), invoiceVO.getCompanyId());
				if (acctTransVO != null) {
					chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_DEL, acctTransVO);
				}
				
				List<AcctTransVO> acctTransList = acctTransDAO.getAcctTransTaxRndList(invoiceVO.getCompanyId(), sysCd, invoiceVO.getCode());
				for(AcctTransVO acctVO : acctTransList) {
					chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_DEL, acctVO);
				}
			}
		}
		
		invoiceDAO.update(invoiceVO);
		if (invoiceVO.getBookingId() != null) {
			invoiceDAO.updateBooking(invoiceVO.getBookingId(), null, bookingStatus, null, null, null, null);
		}
	}
	
	/**
	 * Insert or update GST or Rounding for Account Trans
	 */
	public void acctTransGSTandRounding(InvoiceVO invoiceVO, String insOrUpd, String roundOrTax, String sysCd, String prefixInv, String source, String destination, boolean bySystem) throws BusinessException {
		// Credit
		AcctTransVO acctTransVO = new AcctTransVO();
		if (insOrUpd.equalsIgnoreCase("UPD")) {
			acctTransVO = invoiceDAO.getAcctTransByInv(sysCd, invoiceVO.getCode(), invoiceVO.getCompanyId(), roundOrTax);
			if (acctTransVO == null) {
				insOrUpd = "INS";
				acctTransVO = new AcctTransVO();
			}
		}
		
		acctTransVO.setCompanyId(invoiceVO.getCompanyId());
		if (roundOrTax.equalsIgnoreCase("TAX")) {
			acctTransVO.setAcctId(invoiceVO.getIdAcctGST());
		} else {
			acctTransVO.setAcctId(invoiceVO.getIdAcctRounding());
		}
		
		acctTransVO.setTransDt(invoiceVO.getInvoiceDt());
		if (insOrUpd.equalsIgnoreCase("INS")) acctTransVO.setSysCode(sysCd);
		if (insOrUpd.equalsIgnoreCase("INS")) acctTransVO.setSysPrefix(prefixInv);
		if (insOrUpd.equalsIgnoreCase("INS")) acctTransVO.setSysNo(invoiceVO.getCode());
		if (insOrUpd.equalsIgnoreCase("INS")) acctTransVO.setRefNo("");
		acctTransVO.setSource(source);
		acctTransVO.setDestination(destination);
		acctTransVO.setCode("");
		acctTransVO.setDesc("");
		acctTransVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
		if (insOrUpd.equalsIgnoreCase("INS")) acctTransVO.setType(roundOrTax);
		// Credit note item to debit
		if (invoiceVO.getDocTypeCd().equals("C")) {
			if (roundOrTax.equalsIgnoreCase("TAX")) {
				acctTransVO.setDebit(invoiceVO.getTaxAmt());
			} else {
				acctTransVO.setDebit(invoiceVO.getRoundingAmt());
			}
			acctTransVO.setCredit(0.0);
		} else {
			acctTransVO.setDebit(0.0);
			if (roundOrTax.equalsIgnoreCase("TAX")) {
				acctTransVO.setCredit(invoiceVO.getTaxAmt());
			} else {
				acctTransVO.setCredit(invoiceVO.getRoundingAmt());
			}
		}
		acctTransVO.setTaxCode(null);
		acctTransVO.setTaxRate(null);
		acctTransVO.setTaxAmount(0.00);
		if (insOrUpd.equalsIgnoreCase("INS")) {
			if (bySystem) chartOfAcctBO.audAcctTransEmailPayment(CommonConstant.ACTION_CD_ADD, acctTransVO);
			else chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_ADD, acctTransVO);
		} else {
			if (bySystem) chartOfAcctBO.audAcctTransEmailPayment(CommonConstant.ACTION_CD_UPD, acctTransVO);
			else chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_UPD, acctTransVO);
		}
	}
	
	/**
	 * Calculate total amount
	 */
	/*public void calTtlAmt(InvoiceVO invoiceVO) throws BusinessException {
			
		BigDecimal ttlTaxIncAmt = new BigDecimal("0.0");
		BigDecimal ttlAmtPaid = new BigDecimal("0.0");
		BigDecimal ttlTax = new BigDecimal("0.0");
		
		if (CollectionUtils.isNotEmpty(invoiceVO.getInvoiceItemList())) {
			for (InvoiceItemVO vo : invoiceVO.getInvoiceItemList()) {
				ttlTaxIncAmt = ttlTaxIncAmt.add(new BigDecimal(vo.getTaxIncAmt().toString()));
				ttlTax = ttlTax.add(new BigDecimal(vo.getTaxAmount().toString()));
			}
		}

		if (CollectionUtils.isNotEmpty(invoiceVO.getInvoicePaymentList())) {
			for (InvoicePaymentVO vo : invoiceVO.getInvoicePaymentList()) {
				ttlAmtPaid = ttlAmtPaid.add(new BigDecimal(vo.getAmount().toString()));
			}
		}
		
		BigDecimal ttlAmtAftRounded = BigDecimal.valueOf(roundToNearest(ttlTaxIncAmt.doubleValue()));
		BigDecimal ttlRounding = ttlAmtAftRounded.subtract(ttlTaxIncAmt);
		
		invoiceVO.setTaxAmt(ttlTax.doubleValue());
		invoiceVO.setTaxIncAmt(ttlTaxIncAmt.doubleValue());
		invoiceVO.setRoundingAmt(ttlRounding.doubleValue());
		invoiceVO.setAmount(ttlAmtAftRounded.doubleValue());
		invoiceVO.setAmtPaid(ttlAmtPaid.doubleValue());
		invoiceVO.setBalance(ttlAmtAftRounded.subtract(ttlAmtPaid).doubleValue());
	}
	
	public double roundToNearest(double price) throws BusinessException {
		BigDecimal value = BigDecimal.valueOf(price);
		value = value.multiply(new BigDecimal("2"));
		value = value.setScale(1, BigDecimal.ROUND_HALF_UP);
		value = value.divide(new BigDecimal("2"));
		value = new BigDecimal(new DecimalFormat("#0.00").format(value));
		
		return value.doubleValue();
	}*/
	
	/*
	 * 
	 * @param invoiceVO
	 * @throws BusinessException
	 */
	private void updateInvoiceItems(InvoiceVO invoiceVO, Boolean bySystem) throws BusinessException {
		// default values
		//AcctTransVO acctTransVO;
		//boolean invItemFlg = false;
		//String statusCrDr = "Credit";
		String sysCd = CommonConstant.SYS_NUM_CD_INVC;
		String source = invoiceVO.getCode();
		String destination = "Cust-" + invoiceVO.getCustDetailsVO().getContPersonName() + " " + invoiceVO.getCustDetailsVO().getCode();
		// Customer As Company
		if (invoiceVO.getCustDetailsVO().getCustType().equals("C")) {
			destination = "Cust-" + invoiceVO.getCustDetailsVO().getCompanyName() + " " + invoiceVO.getCustDetailsVO().getCode();
		}
		if (invoiceVO.getDocTypeCd().equals("C")) {
			sysCd = CommonConstant.SYS_NUM_CD_CRDT_NOTE; // credit note
			//statusCrDr = "Debit";
		} else if (invoiceVO.getDocTypeCd().equals("P")) {
			sysCd = CommonConstant.SYS_NUM_CD_PAX_STMT;
		}
		SystemNumberGenerationVO invSNGVO = systNumGenService.getSystemNumberGeneration(sysCd, invoiceVO.getCompanyId());
		String prefixInv = invSNGVO.getPrefixid();	// INV/CN
		source = prefixInv + "-" + invoiceVO.getCode();
		
		// terminate all invoice items 1st
		invoiceDAO.terminateInvoiceItems(invoiceVO, sysCd);
		
		List<AcctTransVO> acctTransList = invoiceDAO.getAcctTransListByInv(sysCd, invoiceVO.getCode(), invoiceVO.getCompanyId());
		// insert or update invoice items
		for (InvoiceItemVO vo : invoiceVO.getInvoiceItemList()) {
			// insert
			if (vo.getId() == null) {
				vo.setInvId(invoiceVO.getId());
				vo.setStatusCode(BaseConstant.STATUS_ACTIVE);
				if (bySystem) invoiceDAO.insert(vo, "SYSTEM");
				else invoiceDAO.insert(vo);
				
				// Credit
				AcctTransVO acctTransVO = new AcctTransVO();
				acctTransVO.setCompanyId(invoiceVO.getCompanyId());
				acctTransVO.setAcctId(((InvoiceItemVO) vo).getAcctId());
				acctTransVO.setTransDt(invoiceVO.getInvoiceDt());
				acctTransVO.setSysCode(sysCd);
				acctTransVO.setSysPrefix(prefixInv);
				acctTransVO.setSysNo(invoiceVO.getCode());
				acctTransVO.setRefNo(Long.toString(vo.getId()));
				acctTransVO.setSource(source);
				acctTransVO.setDestination(destination);
				acctTransVO.setCode(((InvoiceItemVO) vo).getInvItemCd());
				acctTransVO.setDesc(((InvoiceItemVO) vo).getDesc());
				if (StringUtils.isNotEmpty(((InvoiceItemVO) vo).getSubDesc())) acctTransVO.setDesc(acctTransVO.getDesc() + " / " + ((InvoiceItemVO) vo).getSubDesc());
				// Credit note item to debit
				if (invoiceVO.getDocTypeCd().equals("C")) {
					acctTransVO.setDebit(((InvoiceItemVO) vo).getAmount());
					acctTransVO.setCredit(0.0);
				} else {
					acctTransVO.setDebit(0.0);
					acctTransVO.setCredit(((InvoiceItemVO) vo).getAmount());
				}
				acctTransVO.setTaxCode(((InvoiceItemVO) vo).getTaxCode());
				acctTransVO.setTaxRate(((InvoiceItemVO) vo).getTaxRate());
				acctTransVO.setTaxAmount(((InvoiceItemVO) vo).getTaxAmount());
				
				if (bySystem) chartOfAcctBO.audAcctTransEmailPayment(CommonConstant.ACTION_CD_ADD, acctTransVO);
				else chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_ADD, acctTransVO);
				
			// update
			} else {
				if (bySystem) invoiceDAO.update(vo, "SYSTEM");
				else invoiceDAO.update(vo);
				
				for (AcctTransVO acctTransVO : acctTransList) {
					if (acctTransVO.getRefNo().equals(vo.getId().toString())) {
						// Credit
						acctTransVO.setTransDt(invoiceVO.getInvoiceDt());
						acctTransVO.setAcctId(((InvoiceItemVO) vo).getAcctId());
						acctTransVO.setSource(source);
						acctTransVO.setDestination(destination);
						acctTransVO.setCode(((InvoiceItemVO) vo).getInvItemCd());
						acctTransVO.setDesc(((InvoiceItemVO) vo).getDesc());
						if (StringUtils.isNotEmpty(((InvoiceItemVO) vo).getSubDesc())) acctTransVO.setDesc(acctTransVO.getDesc() + " / " + ((InvoiceItemVO) vo).getSubDesc());
						acctTransVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
						// Credit note item to debit
						if (invoiceVO.getDocTypeCd().equals("C")) {
							acctTransVO.setDebit(((InvoiceItemVO) vo).getAmount());
							acctTransVO.setCredit(0.0);
						} else {
							acctTransVO.setDebit(0.0);
							acctTransVO.setCredit(((InvoiceItemVO) vo).getAmount());
						}
						acctTransVO.setTaxCode(((InvoiceItemVO) vo).getTaxCode());
						acctTransVO.setTaxRate(((InvoiceItemVO) vo).getTaxRate());
						acctTransVO.setTaxAmount(((InvoiceItemVO) vo).getTaxAmount());
						
						if (bySystem) chartOfAcctBO.audAcctTransEmailPayment(CommonConstant.ACTION_CD_UPD, acctTransVO);
						else chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_UPD, acctTransVO);
						
						acctTransList.remove(acctTransVO);
						break;
					}
				}
			}
		}
		
		// update trade debtor transaction
		//Retrieve data from transaction table
		//statusCrDr = "Debit";
		//if (invoiceVO.getDocTypeCd().equals("C")) statusCrDr = "Credit";
//		System.out.println("CYY sysCd: " + sysCd);
//		System.out.println("CYY invoiceVO.getCode(): " + invoiceVO.getCode());
//		System.out.println("CYY  invoiceVO.getCompanyId(): " +  invoiceVO.getCompanyId());
		AcctTransVO acctTransVO = invoiceDAO.getAcctTransVO(sysCd, invoiceVO.getCode(), invoiceVO.getCode(), invoiceVO.getCompanyId());
//		System.out.println("CYY acctTransVO: " + acctTransVO);
		
		// Debit
		acctTransVO.setAcctId(invoiceVO.getAcctVO().getId());
		acctTransVO.setTransDt(invoiceVO.getInvoiceDt());
		acctTransVO.setSysNo(invoiceVO.getCode());
		acctTransVO.setRefNo(invoiceVO.getCode());
		acctTransVO.setSource(source);
		acctTransVO.setDestination(destination);
		if (!invoiceVO.getAcctVO().getSubCode().equals("")) {
			acctTransVO.setCode(invoiceVO.getAcctVO().getCode() + "-" + invoiceVO.getAcctVO().getSubCode());
			acctTransVO.setDesc(invoiceVO.getAcctVO().getDesc() + "-" + invoiceVO.getAcctVO().getSubDesc());
		} else {
			acctTransVO.setCode(invoiceVO.getAcctVO().getCode());
			acctTransVO.setDesc(invoiceVO.getAcctVO().getDesc());
		}
		// Credit note total to credit
		if (invoiceVO.getDocTypeCd().equals("C")) {
			acctTransVO.setDebit(0.0);
			acctTransVO.setCredit(invoiceVO.getAmount());
		} else {
			acctTransVO.setDebit(invoiceVO.getAmount());
			acctTransVO.setCredit(0.0);
		}
		
		if (bySystem) chartOfAcctBO.audAcctTransEmailPayment(CommonConstant.ACTION_CD_UPD, acctTransVO);
		else chartOfAcctBO.audAcctTrans(CommonConstant.ACTION_CD_UPD, acctTransVO);
		
		if (invoiceVO.getIdAcctGST() != null) 
			acctTransGSTandRounding(invoiceVO, "UPD", CommonConstant.SYS_NUM_CD_TAX, sysCd, prefixInv, source, destination, bySystem);
		if (invoiceVO.getIdAcctRounding() != null) 
			acctTransGSTandRounding(invoiceVO, "UPD", CommonConstant.SYS_NUM_CD_ROUNDING, sysCd, prefixInv, source, destination, bySystem);
	}
	
	public void updateInvoicePax(InvoiceVO invoiceVO, InvoicePaxVO invoicePaxVO) throws BusinessException, QueueException {
		updateInvoicePax(invoiceVO, invoicePaxVO, false);
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.InvoiceService#updateInvoicePax(com.bcs.zsg.sales.vo.InvoiceVO, com.bcs.zsg.sales.vo.InvoicePaxVO)
	 */
	private void updateInvoicePax(InvoiceVO invoiceVO, InvoicePaxVO invoicePaxVO, boolean bySystem) throws BusinessException, QueueException {
		if (invoicePaxVO == null) {
			if (CollectionUtils.isNotEmpty(invoiceVO.getInvoicePaxList())) {
				for (InvoicePaxVO vo : invoiceVO.getInvoicePaxList()) {
					vo.setInvId(invoiceVO.getId());
					vo.setStatusCode(BaseConstant.STATUS_ACTIVE);
					// insert
					if (vo.getId() == null) {
						if(bySystem) invoiceDAO.insert(vo, "SYSTEM");
						else invoiceDAO.insert(vo);
					}
					// update
					else {
						if(bySystem) invoiceDAO.update(vo, "SYSTEM");
						else invoiceDAO.update(vo);
					}
					
					if (CollectionUtils.isNotEmpty(vo.getInvoicePaxRefNoList())) {
						for (InvoicePaxRefNoVO invPaxRefNoVO : vo.getInvoicePaxRefNoList()) {
							invPaxRefNoVO.setInvPaxId(vo.getId());
							invPaxRefNoVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
							// insert
							if (invPaxRefNoVO.getId() == null) {
								if(bySystem) invoiceDAO.insert(invPaxRefNoVO, "SYSTEM");
								else invoiceDAO.insert(invPaxRefNoVO);
							}
							// update
							else {
								if(bySystem) invoiceDAO.update(invPaxRefNoVO, "SYSTEM");
								else invoiceDAO.update(invPaxRefNoVO);
							}
						}
					}
				}
			}
		} else {
			if (invoicePaxVO.getCustDetailsVO().getPersonContactVO() != null) {
				invoicePaxVO.getCustDetailsVO().setContactList(new ArrayList<PersonContactVO>());
				if(StringUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getPersonContactVO().getPerMobileNumber())) {
					PersonContactVO vo = new PersonContactVO();
					vo.setTypeCd(SalesConstant.MOBILE_TYPE_CD);
					vo.setNumber(invoicePaxVO.getCustDetailsVO().getPersonContactVO().getPerMobileNumber());
					vo.setAttention(invoicePaxVO.getCustDetailsVO().getPersonContactVO().getPerMobileAttention());
					invoicePaxVO.getCustDetailsVO().getContactList().add(vo);
				}
				
				if(StringUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getPersonContactVO().getPerOfficeNumber())) {
					PersonContactVO vo = new PersonContactVO();
					vo.setTypeCd(SalesConstant.OFFICE_TYPE_CD);
					vo.setNumber(invoicePaxVO.getCustDetailsVO().getPersonContactVO().getPerOfficeNumber());
					vo.setAttention(invoicePaxVO.getCustDetailsVO().getPersonContactVO().getPerOfficeAttention());
					invoicePaxVO.getCustDetailsVO().getContactList().add(vo);
				}
				
				if(StringUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getPersonContactVO().getPerHomeNumber())) {
					PersonContactVO vo = new PersonContactVO();
					vo.setTypeCd(SalesConstant.HOME_TYPE_CD);
					vo.setNumber(invoicePaxVO.getCustDetailsVO().getPersonContactVO().getPerHomeNumber());
					vo.setAttention(invoicePaxVO.getCustDetailsVO().getPersonContactVO().getPerHomeAttention());
					invoicePaxVO.getCustDetailsVO().getContactList().add(vo);
				}
				
				if(StringUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getPersonContactVO().getPerFaxNumber())) {
					PersonContactVO vo = new PersonContactVO();
					vo.setTypeCd(SalesConstant.FAX_TYPE_CD);
					vo.setNumber(invoicePaxVO.getCustDetailsVO().getPersonContactVO().getPerFaxNumber());
					vo.setAttention(invoicePaxVO.getCustDetailsVO().getPersonContactVO().getPerFaxAttention());
					invoicePaxVO.getCustDetailsVO().getContactList().add(vo);
				}
			}
			
//			IdentityVO nricIdVO = invoicePaxVO.getCustDetailsVO().getNricIdVO();
//			if (nricIdVO != null && StringUtils.isNotEmpty(nricIdVO.getIdNo())) {
//				if (nricIdVO.getId() != null) {
//					for (IdentityVO idVO : invoicePaxVO.getCustDetailsVO().getIdentityList()) {
//						if (StringUtils.equals(idVO.getIdType(), CommonConstant.LOOKUP_ITM_ID_NRIC) && nricIdVO.getId().equals(idVO.getId())) {
//							idVO.setIdNo(nricIdVO.getIdNo());
//							break;
//						}
//					}
//				} else {
//					IdentityVO idttyVO = new IdentityVO();
//					idttyVO.setIdType(CommonConstant.LOOKUP_ITM_ID_NRIC);
//					idttyVO.setIdNo(nricIdVO.getIdNo());
//					idttyVO.setIdentityDetailVO(new IdentityDetailVO());
//					invoicePaxVO.getCustDetailsVO().getIdentityList().add(idttyVO);
//				}
//			}
//			
//			IdentityVO passportIdVO = invoicePaxVO.getCustDetailsVO().getPassportIdVO();
//			if (passportIdVO != null && StringUtils.isNotEmpty(passportIdVO.getIdNo())) {
//				if (passportIdVO.getId() != null) {
//					for (IdentityVO idVO : invoicePaxVO.getCustDetailsVO().getIdentityList()) {
//						if (StringUtils.equals(idVO.getIdType(), CommonConstant.LOOKUP_ITM_ID_PASSPRT) && passportIdVO.getId().equals(idVO.getId())) {
//							idVO.setIdNo(passportIdVO.getIdNo());
//							idVO.setIdentityDetailVO(passportIdVO.getIdentityDetailVO());
//							break;
//						}
//					}
//				} else {
//					IdentityVO idttyVO = new IdentityVO();
//					idttyVO.setIdType(CommonConstant.LOOKUP_ITM_ID_PASSPRT);
//					idttyVO.setIdNo(passportIdVO.getIdNo());
//					idttyVO.setIdentityDetailVO(passportIdVO.getIdentityDetailVO());
//					idttyVO.getIdentityDetailVO().setId(null);
//					idttyVO.getIdentityDetailVO().setPersonIdentityId(null);
//					invoicePaxVO.getCustDetailsVO().getIdentityList().add(idttyVO);
//				}
//			}
			
			// insert/update ref no
			if (invoicePaxVO.getId() != null) customerDAO.terminateInvoicePaxSubInfo("invoice_pax_ref_no", invoicePaxVO.getId());
			if (CollectionUtils.isNotEmpty(invoicePaxVO.getInvoicePaxRefNoList()) && invoicePaxVO.getId() != null) {
			    for (InvoicePaxRefNoVO refNoVO : invoicePaxVO.getInvoicePaxRefNoList()) {
			        refNoVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
			        if (refNoVO.getId() == null) {
			            refNoVO.setInvPaxId(invoicePaxVO.getId());
			            customerDAO.insert(refNoVO);
			        } else {
			            customerDAO.update(refNoVO);
			        }
			    }
			}

			if (invoicePaxVO.getCustId() == null) {
				CustomerVO custVO = new CustomerVO();
