				custVO.getPersonVO().setRace(invoicePaxVO.getCustDetailsVO().getRace());
				custVO.getPersonVO().setDob(invoicePaxVO.getCustDetailsVO().getDob());
				custVO.getPersonVO().setAge(invoicePaxVO.getCustDetailsVO().getAge());
