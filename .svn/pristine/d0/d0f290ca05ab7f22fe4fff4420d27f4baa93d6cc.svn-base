package com.bcs.zsg.history.vo;

public class TourDepHistoryViewVO extends TourDepHistoryVO {

	private static final long serialVersionUID = 1L;
	
	private String airlineCd;
	private Integer numDays;
	private Integer numNights;

	/**
	 * @return the airlineCd
	 */
	public String getAirlineCd() {
		return airlineCd;
	}

	/**
	 * @param airlineCd the airlineCd to set
	 */
	public void setAirlineCd(String airlineCd) {
		this.airlineCd = airlineCd;
	}

	/**
	 * @return the numDays
	 */
	public Integer getNumDays() {
		return numDays;
	}

	/**
	 * @param numDays the numDays to set
	 */
	public void setNumDays(Integer numDays) {
		this.numDays = numDays;
	}

	/**
	 * @return the numNights
	 */
	public Integer getNumNights() {
		return numNights;
	}

	/**
	 * @param numNights the numNights to set
	 */
	public void setNumNights(Integer numNights) {
		this.numNights = numNights;
	}
}
