table {
	text-align: left;
    width: 100%;
}

.txt_top {
	vertical-align: top;
}

.txt_center {
	text-align: center;
}

.tbl_col_min {
	width: 1pt;
}

.txt_right {
	text-align: right;
}

.txt_underline {
	text-decoration: underline;
}

.tbl_col_label {
	width: 100px;
}

.tbl_col_field {
	width: 150px;
}

.txt_xxsmall {
	font-size: xx-small;
}

.bterp_header {
	background-color: #243c78;
	color: #ede31a;
}

.info_title {
	width: 300px;
	font-weight: bold;
}

.required { color: #ff0000; }

.ui-panelgrid tr, .ui-panelgrid td {
	border:0 !important;
}

table tbody.ui-datatable-data tr:nth-child(even) {
	background: #fbf7df;
}
/*.ui-outputlabel .ui-outputlabel-rfi {
	color:red;
}*/

.nowrap {
	word-wrap: normal !important;
	text-wrap: nowrap !important;
}