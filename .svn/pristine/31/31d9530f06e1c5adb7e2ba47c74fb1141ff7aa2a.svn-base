/* =========================================================
   JOHOR
   ========================================================= */
UPDATE person_address
SET state = 'Johor'
WHERE UPPER(TRIM(state)) IN (
    'JOHOR',
    'JOHOR.',
    'JOHOR BAHRU',
    'JOHOR BAHRU,',
    'JOHOR BAHRU.',
    'JOHOR  BAHRU',
    'JOHOR BARU',
    'JOHOR BARU,',
    'JOHOR BHARU',
    'JOHOR BHARU.',
    'JOHOR BAHRY',
    'JOHOR DARUL TAKZIM',
    'JOHOR DARUL TA’ZIM',
    'JOHOR, MUAR',
    'JOHORE',
    'JOHON',
    'JOHOT',
    'JB',
    'BATU PAHAT',
    'MUAR',
    'MUAR JOHOR',
    'PONTIAN JOHOR',
	'JOHOR BAHRU, JOHOR.',
    'SEGAMAT',
    '81300',
    '83000'
);

