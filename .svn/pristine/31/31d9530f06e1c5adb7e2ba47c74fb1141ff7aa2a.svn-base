/* =========================================================
   W.P. LABUAN
   ========================================================= */
UPDATE person_address
SET state = 'W.P. Labuan'
WHERE UPPER(TRIM(state)) IN (
    'LABUAN',
    'W.P.LABUAN',
    'W.P. LABUAN',
    'WILAYAH PERSEKUTUAN LABUAN'
);

/* =========================================================
   W.P. PUTRAJAYA
   ========================================================= */
UPDATE person_address
SET state = 'W.P. Putrajaya'
WHERE UPPER(TRIM(state)) IN (
    'PUTRA JAYA',
    'PUTRAJAYA',
    'W.P. PUTRAJAYA',
    'W. PERSEKUTUAN (PUTRJAYA)'
);