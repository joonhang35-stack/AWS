    /*
     * (non-Javadoc)
     * @see com.bcs.zsg.product.dao.FeedbackDAO#getFeedbackStatus(java.lang.Long)
     */
    @Override
    public String getFeedbackStatus(Long idBooking) throws BusinessException {
        return getFeedbackStatus(idBooking, null);
    }

    @Override
    public String getFeedbackStatus(Long idBooking, Long idInvoice) throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("SELECT status ");
        sb.append("FROM feedback ");
        if (idInvoice != null) {
            sb.append("WHERE id_invoice = :id_invoice ");
        } else {
            sb.append("WHERE id_tour_booking = :id_tour_booking ");
        }
        sb.append("ORDER BY dt_created DESC ");

        Query query = createSQLQuery(sb.toString());
        if (idInvoice != null) {
            query.setLong("id_invoice", idInvoice);
        } else {
            query.setLong("id_tour_booking", idBooking);
        }
        query.setMaxResults(1);

        Object result = query.uniqueResult();

        return result != null ? result.toString() : null;
    }

    @SuppressWarnings("unchecked")
    @Override
    public List<FeedbackVO> getPendingFeedbackList() throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("SELECT ")
          .append("f.id AS feedback_id, ")
          .append("f.id_tour_pkg, ")
          .append("f.id_tour_dep, ")
          .append("f.id_invoice, ")
          .append("f.id_customer, ")
          .append("f.id_tour_booking, ")
          .append("f.email, ")
          .append("f.token_uuid, ")
          .append("f.status, ")
          .append("td.dt_dep, ")
          .append("td.code AS td_code, ")
          .append("p.salutation_cd, ")
          .append("p.title, ")
          .append("p.first_name, ")
          .append("p.middle_name, ")
          .append("p.last_name ")
          .append("FROM feedback f ")
          .append("LEFT JOIN tour_dep td ON f.id_tour_dep = td.id ")
          .append("LEFT JOIN customer c ON f.id_customer = c.id ")
          .append("LEFT JOIN person p ON c.id_pc = p.id ")
          .append("WHERE f.status = 'P' ");

        Query query = createSQLQuery(sb.toString());
        List<Object> results = query.list();
        List<FeedbackVO> feedbackList = new ArrayList<FeedbackVO>();
        FeedbackVO vo;

        for (Iterator<Object> it = results.iterator(); it.hasNext();) {
            Object[] row = (Object[]) it.next();
            vo = new FeedbackVO();

            if (row[0] != null) vo.setIdFeedback(((BigInteger) row[0]).longValue());
            if (row[1] != null) vo.setIdTourPkg(((BigInteger) row[1]).longValue());
            if (row[2] != null) vo.setIdTourDeparture(((BigInteger) row[2]).longValue());
            if (row[3] != null) vo.setInvId(((BigInteger) row[3]).longValue());
            if (row[4] != null) vo.setCustomerId(((BigInteger) row[4]).longValue());
            if (row[5] != null) {
                try {
                    vo.setTourBookingId(Long.parseLong(row[5].toString()));
                } catch (Exception e) {}
            }
            if (row[6] != null) vo.setCustomerEmail((String) row[6]);
            if (row[7] != null) vo.setTokenUuid((String) row[7]);
            if (row[8] != null) vo.setFeedbackStatus((String) row[8]);
            if (row[9] != null) vo.setDepartureDate((Date) row[9]);
            if (row[10] != null) vo.setTourCode((String) row[10]);

            String salutation = row[11] != null ? row[11].toString() : "";
            String title      = row[12] != null ? row[12].toString() : "";
            String firstName  = row[13] != null ? row[13].toString() : "";
            String middleName = row[14] != null ? row[14].toString() : "";
            String lastName   = row[15] != null ? row[15].toString() : "";

            String fullName = (StringUtils.isNotBlank(salutation) ? salutation + ". " : "")
                            + firstName
                            + (StringUtils.isNotBlank(middleName) ? " " + middleName : "")
                            + (StringUtils.isNotBlank(lastName)   ? " " + lastName   : "");
            vo.setCustomerName(fullName.trim());

            feedbackList.add(vo);
        }

        return feedbackList;
    }

    @Override
    public void updateFeedbackForEmailSent(Long idTourBooking, Long customerId, String tokenUuid, String status, String updBy) throws BusinessException {
        updateFeedbackForEmailSent(idTourBooking, customerId, null, tokenUuid, status, updBy);
    }

    @Override
    public void updateFeedbackForEmailSent(Long idTourBooking, Long customerId, Long idInvoice, String tokenUuid, String status, String updBy) throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("UPDATE feedback ")
          .append("SET status = :status, ")
          .append("    token_uuid = :tokenUuid, ")
          .append("    dt_upd = NOW(), ")
          .append("    upd_by = :updBy ")
          .append("WHERE id_tour_booking = :id_tour_booking ");
        if (idInvoice != null) {
            sb.append("  AND id_invoice = :id_invoice ");
        } else {
            sb.append("  AND id_customer = :id_customer ");
        }

        Query query = createSQLQuery(sb.toString());
        query.setString("status", status);
        query.setString("tokenUuid", tokenUuid);
        query.setString("updBy", updBy);
        query.setLong("id_tour_booking", idTourBooking);
        if (idInvoice != null) {
            query.setLong("id_invoice", idInvoice);
        } else {
            query.setLong("id_customer", customerId);
        }
        query.executeUpdate();
    }

    @Override
    public TourDepartureVO getFeedbackReportHeader(Long idTourDep) throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("SELECT td.id, td.code, td.dt_dep, tp.name_en, tp.name_zh, tp.name_other, ")
          .append("       ul.user_name AS tour_leader, ")
          .append("       ug.user_name AS tour_manager ")
          .append("FROM tour_dep td ")
          .append("JOIN tour_pkg tp ON tp.id = td.id_tour_pkg ")
          .append("LEFT JOIN employee el ON el.id = td.id_tour_leader ")
          .append("LEFT JOIN sec_user ul ON ul.uuid = el.u_sec_user ")
          .append("LEFT JOIN employee eg ON eg.id = td.id_tour_guide ")
          .append("LEFT JOIN sec_user ug ON ug.uuid = eg.u_sec_user ")
          .append("WHERE td.id = :idTourDep");

        Query query = createSQLQuery(sb.toString());
        query.setLong("idTourDep", idTourDep);
        List<Object[]> list = query.list();
        if (list != null && !list.isEmpty()) {
            Object[] row = list.get(0);
            com.bcs.zsg.product.vo.TourDepartureVO vo = new com.bcs.zsg.product.vo.TourDepartureVO();
            if (row[0] != null) vo.setId(((BigInteger) row[0]).longValue());
            if (row[1] != null) vo.setCode((String) row[1]);
            if (row[2] != null) vo.setDtDep((Date) row[2]);
            
            String nameEn = row[3] != null ? (String) row[3] : "";
            String nameZh = row[4] != null ? (String) row[4] : "";
            String nameOther = row[5] != null ? (String) row[5] : "";
            
            StringBuilder pkgName = new StringBuilder();
            if (StringUtils.isNotBlank(nameEn)) pkgName.append(nameEn);
            if (StringUtils.isNotBlank(nameZh)) {
                if (pkgName.length() > 0) pkgName.append(" ");
                pkgName.append(nameZh);
            }
            if (StringUtils.isNotBlank(nameOther)) {
                if (pkgName.length() > 0) pkgName.append(" ");
                pkgName.append(nameOther);
            }
            vo.setPackageName(pkgName.toString().trim());

            if (row[6] != null) vo.setTourLead((String) row[6]);
            if (row[7] != null) vo.setTourManager((String) row[7]);
            return vo;
        }
        return null;
    }

    @Override
    public void insertFeedbackCustAnswer(Long idFeedback, Long idQuestion, Long idAnswer, String answerText, String remarks) throws BusinessException {
        String sql = "INSERT INTO feedback_cust_answer (id_feedback, id_feedback_question, id_feedback_answer, answer_text, remarks, dt_created, created_by, dt_upd, upd_by) "
                   + "VALUES (:idFeedback, :idQuestion, :idAnswer, :answerText, :remarks, NOW(), :createdBy, NOW(), :updBy)";
        Query query = createSQLQuery(sql);
        query.setParameter("idFeedback", idFeedback);
        query.setParameter("idQuestion", idQuestion);
        query.setParameter("idAnswer", idAnswer);
        query.setParameter("answerText", answerText);
        query.setParameter("remarks", remarks);
        
        String createdBy = "SYSTEM";
        try {
            if (BaseContext.getUserFullName() != null) {
                createdBy = BaseContext.getUserFullName();
            } else if (BaseContext.getLoginId() != null) {
                createdBy = BaseContext.getLoginId();
            }
        } catch (Exception e) {}
        
        query.setParameter("createdBy", createdBy);
        query.setParameter("updBy", createdBy);
        query.executeUpdate();
    }

    @Override
    public void updateFeedbackComments(Long idFeedback, String comments, String attachment) throws BusinessException {
        String sql = "UPDATE feedback SET comments = :comments, dt_upd = NOW(), upd_by = :updBy WHERE id = :idFeedback";
        
        String updBy = "SYSTEM";
        try {
            if (BaseContext.getUserFullName() != null) {
                updBy = BaseContext.getUserFullName();
            } else if (BaseContext.getLoginId() != null) {
                updBy = BaseContext.getLoginId();
            }
        } catch (Exception e) {}
        
        Query query = createSQLQuery(sql);
        query.setParameter("comments", comments);
        query.setParameter("idFeedback", idFeedback);
        query.setParameter("updBy", updBy);
        query.executeUpdate();

        // Handle attachment in feedback_attachment table for HOS
        String deleteSql = "DELETE FROM feedback_attachment WHERE id_feedback = :idFeedback AND type = 'hos'";
        Query deleteQuery = createSQLQuery(deleteSql);
        deleteQuery.setParameter("idFeedback", idFeedback);
        deleteQuery.executeUpdate();

        if (StringUtils.isNotBlank(attachment)) {
            String insertSql = "INSERT INTO feedback_attachment (id_feedback, filename, type) "
                             + "VALUES (:idFeedback, :filename, 'hos')";
            Query insertQuery = createSQLQuery(insertSql);
            insertQuery.setParameter("idFeedback", idFeedback);
            String fileName = attachment;
            if (attachment.contains("/") || attachment.contains("\\")) {
                fileName = attachment.substring(Math.max(attachment.lastIndexOf("/"), attachment.lastIndexOf("\\")) + 1);
            }
            insertQuery.setParameter("filename", fileName);
            insertQuery.executeUpdate();
        }
    }

    @SuppressWarnings("unchecked")
    @Override
    public List<Object[]> getActiveQuestionsAndAnswers() throws BusinessException {
        String sql = "SELECT fq.id AS question_id, fq.seq_no, fq.section_type, fq.question_code, fq.question_text_en, fq.answer_type, "
                   + "       fa.id AS answer_id, fa.answer_label_en, fa.score_value "
                   + "FROM feedback_question fq "
                   + "LEFT JOIN feedback_lookup fl ON fl.code = fq.section_type "
                   + "LEFT JOIN feedback_answer fa ON fa.id_feedback_question = fq.id AND fa.is_active = 1 "
                   + "WHERE fq.is_active = 1 "
                   + "ORDER BY COALESCE(fl.id, 9999), fq.seq_no, fq.id, fa.seq_no";
        return createSQLQuery(sql).list();
    }

    @SuppressWarnings("unchecked")
    @Override
    public Map<String, String> getFeedbackLookupMap() throws BusinessException {
        String sql = "SELECT code, description FROM feedback_lookup";
        List<Object[]> list = createSQLQuery(sql).list();
        Map<String, String> map = new HashMap<String, String>();
        for (Object[] row : list) {
            if (row[0] != null && row[1] != null) {
                map.put(row[0].toString(), row[1].toString());
            }
        }
        return map;
    }

    @SuppressWarnings("unchecked")
    @Override
    public List<FeedbackVO> getAllFeedbacks() throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("SELECT ")
          .append("f.id AS feedback_id, ")
          .append("f.id_tour_pkg, ")
          .append("f.id_tour_dep, ")
          .append("f.id_invoice, ")
          .append("f.id_customer, ")
          .append("f.id_tour_booking, ")
          .append("f.email, ")
          .append("f.status, ")
          .append("td.code AS td_code, ")
          .append("i.code AS inv_code, ")
          .append("p.salutation_cd, ")
          .append("p.first_name, ")
          .append("p.last_name, ")
          .append("(SELECT SUM(fa.score_value) / (SELECT COUNT(*) FROM feedback_question WHERE answer_type = 'RATING') ")
          .append(" FROM feedback_cust_answer fca ")
          .append(" JOIN feedback_answer fa ON fa.id = fca.id_feedback_answer ")
          .append(" WHERE fca.id_feedback = f.id) AS score_value, ")
          .append("f.ps_no ")
          .append("FROM feedback f ")
          .append("LEFT JOIN tour_dep td ON f.id_tour_dep = td.id ")
          .append("LEFT JOIN invoice i ON f.id_invoice = i.id ")
          .append("LEFT JOIN customer c ON f.id_customer = c.id ")
          .append("LEFT JOIN person p ON c.id_pc = p.id ")
          .append("ORDER BY f.id DESC");

        Query query = createSQLQuery(sb.toString());
        List<Object> results = query.list();
        List<FeedbackVO> feedbackList = new ArrayList<FeedbackVO>();
        FeedbackVO vo;

        for (Iterator<Object> it = results.iterator(); it.hasNext();) {
            Object[] row = (Object[]) it.next();
            vo = new FeedbackVO();

            if (row[0] != null) vo.setIdFeedback(((BigInteger) row[0]).longValue());
            if (row[1] != null) vo.setIdTourPkg(((BigInteger) row[1]).longValue());
            if (row[2] != null) vo.setIdTourDeparture(((BigInteger) row[2]).longValue());
            if (row[3] != null) vo.setInvId(((BigInteger) row[3]).longValue());
            if (row[4] != null) vo.setCustomerId(((BigInteger) row[4]).longValue());
            if (row[5] != null) {
                try {
                    vo.setTourBookingId(Long.parseLong(row[5].toString().trim()));
                } catch (Exception e) {}
            }
            if (row[6] != null) vo.setCustomerEmail(row[6].toString());
            if (row[7] != null) vo.setFeedbackStatus(row[7].toString());
            if (row[8] != null) vo.setTourDepCode(row[8].toString());
            if (row[9] != null) vo.setInvCode(row[9].toString());

            String salutation = row[10] != null ? row[10].toString() : "";
            String firstName  = row[11] != null ? row[11].toString() : "";
            String lastName   = row[12] != null ? row[12].toString() : "";

            String fullName = (StringUtils.isNotBlank(salutation) ? salutation + ". " : "")
                            + firstName
                            + (StringUtils.isNotBlank(lastName)   ? " " + lastName   : "");
            vo.setCustomerName(fullName.trim());

            if (row[13] != null) vo.setOverallScore(Double.parseDouble(row[13].toString()));
            if (row[14] != null) vo.setPsNo(row[14].toString());

            feedbackList.add(vo);
        }
        return feedbackList;
    }

    @SuppressWarnings("unchecked")
    @Override
    public List<FeedbackVO> getFeedbackDetails(Long idFeedback) throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("SELECT ")
          .append("f.id AS feedback_id, f.id_tour_pkg, f.id_tour_dep, f.id_customer, f.status, f.comments, ")
          .append("(SELECT fa_cust.filename FROM feedback_attachment fa_cust WHERE fa_cust.id_feedback = f.id AND fa_cust.type = 'cust' LIMIT 1) AS attachment, ")
          .append("fq.id AS id_feedback_question, fq.seq_no, fq.section_type, fq.question_code, fq.question_text_en, ")
          .append("fq.answer_type, fq.is_required, fq.has_remark, fq.placeholder_en, ")
          .append("fa.id AS id_feedback_answer, fa.answer_label_en, fa.score_value, ")
          .append("fca.remarks, fca.answer_text, ")
          .append("td.num_nights, td.dt_dep, td.code AS tour_dep_code, td.op_pic, ")
          .append("p.id AS person_id, p.salutation_cd, p.first_name, p.last_name, p.email, ")
          .append("c.id AS customer_id, ")
          .append("(SELECT fa_hos.filename FROM feedback_attachment fa_hos WHERE fa_hos.id_feedback = f.id AND fa_hos.type = 'hos' LIMIT 1) AS attachment_hos, ")
          .append("f.comments_hos ")
          .append("FROM feedback f ")
          .append("LEFT JOIN feedback_cust_answer fca ON fca.id_feedback = f.id ")
          .append("LEFT JOIN feedback_question fq ON fq.id = fca.id_feedback_question ")
          .append("LEFT JOIN feedback_answer fa ON fa.id = fca.id_feedback_answer ")
          .append("JOIN tour_dep td ON td.id = f.id_tour_dep ")
          .append("JOIN customer c ON c.id = f.id_customer ")
          .append("JOIN person p ON p.id = c.id_pc ")
          .append("WHERE f.id = :idFeedback ")
          .append("ORDER BY fq.seq_no");

        Query query = createSQLQuery(sb.toString());
        query.setLong("idFeedback", idFeedback);

        List<Object> results = query.list();
        List<FeedbackVO> feedbackList = new ArrayList<FeedbackVO>();
        FeedbackVO vo;

        for (Iterator<Object> it = results.iterator(); it.hasNext();) {
            Object[] row = (Object[]) it.next();
            vo = new FeedbackVO();
            vo.setIdFeedback(row[0]  != null ? ((BigInteger) row[0]).longValue() : null);
            vo.setIdTourPkg(row[1]   != null ? ((BigInteger) row[1]).longValue() : null);
            vo.setIdTourDeparture(row[2] != null ? ((BigInteger) row[2]).longValue() : null);
            vo.setCustomerId(row[3]  != null ? ((BigInteger) row[3]).longValue() : null);
            vo.setFeedbackStatus(row[4]  != null ? row[4].toString() : null);
            vo.setComments(row[5]  != null ? row[5].toString() : null);
            vo.setAttachment(row[6]  != null ? row[6].toString() : null);
            vo.setIdFeedbackQuestion(row[7] != null ? ((BigInteger) row[7]).longValue() : null);
            vo.setSeqNo(row[8] != null ? row[8].toString() : null);
            vo.setSectionType(row[9]     != null ? row[9].toString() : null);
            vo.setQuestionCode(row[10]    != null ? row[10].toString() : null);
            vo.setQuestionTextEn(row[11] != null ? row[11].toString() : null);
            vo.setAnswerType(row[12]     != null ? row[12].toString() : null);
            vo.setIdFeedbackAnswer(row[16] != null ? ((BigInteger) row[16]).longValue() : null);
            vo.setAnswerLabelEn(row[17]  != null ? row[17].toString() : null);
            vo.setScoreValue(row[18]     != null ? Integer.parseInt(row[18].toString()) : 0);
            vo.setRemarks(row[19]        != null ? row[19].toString() : null);
            vo.setAnswerText(row[20]     != null ? row[20].toString() : null);
            vo.setNumNights(row[21]      != null ? ((Short) row[21]).intValue() : 0);
            vo.setTourCode(row[23]       != null ? row[23].toString() : null);
            vo.setCustomerEmail(row[29]  != null ? row[29].toString() : null);
            vo.setAttachmentHos(row[31]  != null ? row[31].toString() : null);
            vo.setCommentsHos(row[32]    != null ? row[32].toString() : null);

            String salutation = row[26] != null ? row[26].toString() : "";
            String firstName  = row[27] != null ? row[27].toString() : "";
            String lastName   = row[28] != null ? row[28].toString() : "";
            vo.setCustomerName(
                (StringUtils.isNotBlank(salutation) ? salutation + ". " : "")
                + firstName
                + (StringUtils.isNotBlank(lastName) ? " " + lastName : "")
            );

            feedbackList.add(vo);
        }
        return feedbackList;
    }

    @SuppressWarnings("unchecked")
    @Override
    public List<FeedbackVO> getAttachmentsByFeedbackId(Long idFeedback) throws BusinessException {
        String sql = "SELECT id, id_feedback, filename, type FROM feedback_attachment WHERE id_feedback = :idFeedback";
        Query query = createSQLQuery(sql);
        query.setParameter("idFeedback", idFeedback);
        List<Object[]> results = query.list();
        List<FeedbackVO> list = new ArrayList<FeedbackVO>();
        for (Object[] row : results) {
            FeedbackVO att = new FeedbackVO();
            if (row[0] != null) att.setIdAttachment(((BigInteger) row[0]).longValue());
            if (row[1] != null) att.setIdFeedback(((BigInteger) row[1]).longValue());
            if (row[2] != null) att.setFilename((String) row[2]);
            if (row[3] != null) att.setType((String) row[3]);
            list.add(att);
        }
        return list;
    }

    @SuppressWarnings("unchecked")
    @Override
    public void saveFeedbackEdits(Long idFeedback, String commentsHos, List<FeedbackVO> hosAttachments, List<Long> deletedAttachmentIds) throws BusinessException {
        // 1. Update HOS comments in feedback table
        String updateFeedbackSql = "UPDATE feedback SET comments_hos = :commentsHos, dt_upd = NOW(), upd_by = :updBy WHERE id = :idFeedback";
        String updBy = "SYSTEM";
        try {
            if (BaseContext.getUserFullName() != null) {
                updBy = BaseContext.getUserFullName();
            } else if (BaseContext.getLoginId() != null) {
                updBy = BaseContext.getLoginId();
            }
        } catch (Exception e) {}
        
        Query query = createSQLQuery(updateFeedbackSql);
        query.setParameter("commentsHos", commentsHos);
        query.setParameter("idFeedback", idFeedback);
        query.setParameter("updBy", updBy);
        query.executeUpdate();

        // 2. Delete the deleted attachments from database and physical disk
        if (deletedAttachmentIds != null && !deletedAttachmentIds.isEmpty()) {
            String selectSql = "SELECT filename FROM feedback_attachment WHERE id IN (:deletedIds)";
            Query selectQuery = createSQLQuery(selectSql);
            selectQuery.setParameterList("deletedIds", deletedAttachmentIds);
            List<String> filenames = selectQuery.list();

            String deleteSql = "DELETE FROM feedback_attachment WHERE id IN (:deletedIds)";
            Query deleteQuery = createSQLQuery(deleteSql);
            deleteQuery.setParameterList("deletedIds", deletedAttachmentIds);
            deleteQuery.executeUpdate();

            if (filenames != null) {
                for (String filename : filenames) {
                    if (filename != null) {
                        try {
                            File file = new File(AppConfigConstant.uploadPath + "/feedback/" + filename);
                            System.out.println("FeedbackDAOImpl: Deleting HOS attachment file at path: " + file.getAbsolutePath());
                            if (file.exists()) {
                                boolean deleted = file.delete();
                                System.out.println("FeedbackDAOImpl: File deletion result: " + deleted);
                            } else {
                                System.out.println("FeedbackDAOImpl: File does not exist at path: " + file.getAbsolutePath());
                            }
                        } catch (Exception ex) {
                            ex.printStackTrace();
                        }
                    }
                }
            }
        }

        // 3. Insert new attachments
        if (hosAttachments != null) {
            for (FeedbackVO att : hosAttachments) {
                if (att.getIdAttachment() == null) {
                    String insertSql = "INSERT INTO feedback_attachment (id_feedback, filename, type) "
                                     + "VALUES (:idFeedback, :filename, 'hos')";
                    Query insertQuery = createSQLQuery(insertSql);
                    insertQuery.setParameter("idFeedback", idFeedback);
                    insertQuery.setParameter("filename", att.getFilename());
                    insertQuery.executeUpdate();
                }
            }
        }
    }

    @SuppressWarnings("unchecked")
    @Override
    public List<FeedbackVO> getBookingsWithoutFeedback(Long idTourDep) throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("( ")
          .append("  SELECT ")
          .append("      ip.id_cust AS customer_id, ")
          .append("      p.salutation_cd, p.first_name, p.last_name, p.email, ")
          .append("      tb.id AS tb_id, ")
          .append("      i.id AS inv_id, i.code AS inv_code, i.ps_no AS ps_no, ")
          .append("      i.doc_type_cd AS doc_type_cd, ")
          .append("      td.id_tour_pkg ")
          .append("  FROM invoice i ")
          .append("  JOIN tour_booking tb ON (i.id_tour_booking = tb.id OR i.id_parent_inv_tour_booking = tb.id) ")
          .append("  JOIN invoice_pax ip ON ip.id_inv = i.id ")
          .append("  JOIN customer c ON ip.id_cust = c.id ")
          .append("  JOIN person p ON c.id_pc = p.id ")
          .append("  JOIN tour_dep td ON tb.id_tour_dep = td.id ")
          .append("  WHERE tb.id_tour_dep = :idTourDep ")
          .append("    AND ip.status_cd = 'A' ")
          .append("    AND i.status_cd NOT IN ('CC', 'VD') ")
          .append("    AND COALESCE(i.doc_type_status, '') NOT IN ('CV', 'SP', 'CL') ")
          .append(") ")
          .append("UNION ALL ")
          .append("( ")
          .append("  SELECT ")
          .append("      tb.id_cust AS customer_id, ")
          .append("      p.salutation_cd, p.first_name, p.last_name, p.email, ")
          .append("      tb.id AS tb_id, ")
          .append("      NULL AS inv_id, NULL AS inv_code, NULL AS ps_no, ")
          .append("      NULL AS doc_type_cd, ")
          .append("      td.id_tour_pkg ")
          .append("  FROM tour_booking tb ")
          .append("  JOIN customer c ON tb.id_cust = c.id ")
          .append("  JOIN person p ON c.id_pc = p.id ")
          .append("  JOIN tour_dep td ON tb.id_tour_dep = td.id ")
          .append("  WHERE tb.id_tour_dep = :idTourDep ")
          .append("    AND tb.status_cd NOT IN ('CC', 'VD') ")
          .append("    AND tb.id NOT IN ( ")
          .append("        SELECT DISTINCT tb2.id ")
          .append("        FROM invoice i2 ")
          .append("        JOIN tour_booking tb2 ON (i2.id_tour_booking = tb2.id OR i2.id_parent_inv_tour_booking = tb2.id) ")
          .append("        WHERE tb2.id_tour_dep = :idTourDep ")
          .append("          AND i2.status_cd NOT IN ('CC', 'VD') ")
          .append("          AND COALESCE(i2.doc_type_status, '') NOT IN ('CV', 'SP', 'CL') ")
          .append("    ) ")
          .append(") ");

        Query query = createSQLQuery(sb.toString());
        query.setLong("idTourDep", idTourDep);
        List<Object[]> results = query.list();
        List<FeedbackVO> list = new ArrayList<FeedbackVO>();
        for (Object[] row : results) {
            FeedbackVO vo = new FeedbackVO();
            if (row[0] != null) vo.setCustomerId(((Number) row[0]).longValue());
            
            String salutation = row[1] != null ? row[1].toString() : "";
            String firstName  = row[2] != null ? row[2].toString() : "";
            String lastName   = row[3] != null ? row[3].toString() : "";
            if (row[4] != null) vo.setCustomerEmail(row[4].toString());
            
            if (row[5] != null) vo.setTourBookingId(((Number) row[5]).longValue());
            if (row[6] != null) vo.setInvId(((Number) row[6]).longValue());
            if (row[7] != null) vo.setInvCode(row[7].toString());
            if (row[8] != null) vo.setPsNo(row[8].toString());
            if (row[9] != null) vo.setDocTypeCd(row[9].toString());
            if (row[10] != null) vo.setIdTourPkg(((Number) row[10]).longValue());

            String fullName = (StringUtils.isNotBlank(salutation) ? salutation + ". " : "")
                            + firstName
                            + (StringUtils.isNotBlank(lastName)   ? " " + lastName   : "");
            vo.setCustomerName(fullName.trim());
            
            list.add(vo);
        }
        return list;
    }

    @SuppressWarnings("unchecked")
    @Override
    public void saveCustomerFeedback(FeedbackVO vo, List<ManualQuestionAnswer> answers, List<FeedbackVO> attachments, List<Long> deletedAttachmentIds) throws BusinessException {
        Long idFeedback = vo.getIdFeedback();
        String updBy = "SYSTEM";
        try {
            if (BaseContext.getUserFullName() != null) {
                updBy = BaseContext.getUserFullName();
            } else if (BaseContext.getLoginId() != null) {
                updBy = BaseContext.getLoginId();
            }
        } catch (Exception e) {}

        if (idFeedback == null) {
            // 1. Insert new feedback record
            insertFeedback(vo);
            idFeedback = getFeedbackId(vo.getTourBookingId(), vo.getCustomerId(), vo.getInvId());
            if (idFeedback == null) {
                throw new BusinessException("Failed to locate created feedback ID.");
            }
            vo.setIdFeedback(idFeedback);
        } else {
            // 2. Update existing feedback record
            String updateSql = "UPDATE feedback SET status = :status, comments = :comments, dt_upd = NOW(), upd_by = :updBy WHERE id = :idFeedback";
            Query updateQuery = createSQLQuery(updateSql);
            updateQuery.setParameter("status", vo.getFeedbackStatus());
            updateQuery.setParameter("comments", vo.getComments());
            updateQuery.setParameter("updBy", updBy);
            updateQuery.setParameter("idFeedback", idFeedback);
            updateQuery.executeUpdate();

            // Delete existing customer answers to avoid duplicates
            String deleteAnswersSql = "DELETE FROM feedback_cust_answer WHERE id_feedback = :idFeedback";
            Query deleteAnswersQuery = createSQLQuery(deleteAnswersSql);
            deleteAnswersQuery.setParameter("idFeedback", idFeedback);
            deleteAnswersQuery.executeUpdate();
        }

        // 3. Insert customer answers
        if (answers != null) {
            for (ManualQuestionAnswer mq : answers) {
                if ("RATING".equalsIgnoreCase(mq.getAnswerType())) {
                    Long selectedAnsId = mq.getSelectedAnswerId();
                    if (selectedAnsId != null) {
                        insertFeedbackCustAnswer(idFeedback, mq.getQuestionId(), selectedAnsId, null, mq.getRemarks());
                    }
                } else if ("RADIO".equalsIgnoreCase(mq.getAnswerType())) {
                    Long selectedAnsId = mq.getSelectedAnswerId();
                    if (selectedAnsId != null) {
                        insertFeedbackCustAnswer(idFeedback, mq.getQuestionId(), selectedAnsId, null, null);
                    }
                } else if ("CHECKBOX".equalsIgnoreCase(mq.getAnswerType())) {
                    if (mq.getSelectedAnswerIds() != null) {
                        for (Long ansId : mq.getSelectedAnswerIds()) {
                            insertFeedbackCustAnswer(idFeedback, mq.getQuestionId(), ansId, null, null);
                        }
                    }
                } else if ("TEXT".equalsIgnoreCase(mq.getAnswerType()) || "TEXTAREA".equalsIgnoreCase(mq.getAnswerType())) {
                    if (StringUtils.isNotBlank(mq.getAnswerText())) {
                        insertFeedbackCustAnswer(idFeedback, mq.getQuestionId(), null, mq.getAnswerText(), null);
                    }
                }
            }
        }

        // 4. Delete deleted customer attachments from database and physical disk
        if (deletedAttachmentIds != null && !deletedAttachmentIds.isEmpty()) {
            String selectSql = "SELECT filename FROM feedback_attachment WHERE id IN (:deletedIds)";
            Query selectQuery = createSQLQuery(selectSql);
            selectQuery.setParameterList("deletedIds", deletedAttachmentIds);
            List<String> filenames = selectQuery.list();

            String deleteSql = "DELETE FROM feedback_attachment WHERE id IN (:deletedIds)";
            Query deleteQuery = createSQLQuery(deleteSql);
            deleteQuery.setParameterList("deletedIds", deletedAttachmentIds);
            deleteQuery.executeUpdate();

            if (filenames != null) {
                for (String filename : filenames) {
                    if (filename != null) {
                        try {
                            File file = new File(AppConfigConstant.uploadPath + "/feedback/" + filename);
                            System.out.println("FeedbackDAOImpl: Deleting customer attachment file at path: " + file.getAbsolutePath());
                            if (file.exists()) {
                                file.delete();
                            }
                        } catch (Exception ex) {
                            ex.printStackTrace();
                        }
                    }
                }
            }
        }

        // 5. Insert new customer attachments
        if (attachments != null) {
            for (FeedbackVO att : attachments) {
                if (att.getIdAttachment() == null) {
                    String insertSql = "INSERT INTO feedback_attachment (id_feedback, filename, type) "
                                     + "VALUES (:idFeedback, :filename, 'cust')";
                    Query insertQuery = createSQLQuery(insertSql);
                    insertQuery.setParameter("idFeedback", idFeedback);
                    insertQuery.setParameter("filename", att.getFilename());
                    insertQuery.executeUpdate();
                }
            }
        }
    }

    @SuppressWarnings("unchecked")
    @Override
    public List<FeedbackVO> getPaxListForFeedback(Long tourBookingId, String invCode, String psNo) throws BusinessException {
        List<FeedbackVO> list = new ArrayList<FeedbackVO>();
        
        // Query passengers from all active, non-voided, non-converted, non-split invoices/PSs associated with this booking
        StringBuilder sbPax = new StringBuilder();
        sbPax.append("SELECT ip.id_cust, p.salutation_cd, p.first_name, p.last_name, p.email, ")
             .append("       tb.id_tour_dep, td.id_tour_pkg, td.code AS td_code, tp.type_cd AS tp_type_cd, tp.code AS tp_code, ")
             .append("       f.status AS feedback_status, ")
             .append("       i.id AS inv_id, i.code AS inv_code, i.ps_no AS ps_no, i.doc_type_cd AS doc_type_cd, ")
             .append("       tb.id AS tb_id ")
             .append("FROM invoice i ")
             .append("JOIN tour_booking tb ON (i.id_tour_booking = tb.id OR i.id_parent_inv_tour_booking = tb.id) ")
             .append("JOIN invoice_pax ip ON ip.id_inv = i.id ")
             .append("JOIN customer c ON ip.id_cust = c.id ")
             .append("JOIN person p ON c.id_pc = p.id ")
             .append("LEFT JOIN tour_dep td ON tb.id_tour_dep = td.id ")
             .append("LEFT JOIN tour_pkg tp ON td.id_tour_pkg = tp.id ")
             .append("LEFT JOIN feedback f ON f.id_tour_booking = tb.id AND f.id_customer = ip.id_cust ")
             .append("WHERE 1=1 ");

        if (StringUtils.isNotBlank(invCode)) {
            sbPax.append("  AND i.code = :invCode ");
        } else if (StringUtils.isNotBlank(psNo)) {
            sbPax.append("  AND i.ps_no = :psNo ");
        } else {
            sbPax.append("  AND tb.id = :tourBookingId ");
        }

        sbPax.append("  AND ip.status_cd = :statusCd ")
             .append("  AND i.status_cd NOT IN ('CC', 'VD') ")
             .append("  AND COALESCE(i.doc_type_status, '') NOT IN ('CV', 'SP', 'CL') ");
        
        Query paxQuery = createSQLQuery(sbPax.toString());
        if (StringUtils.isNotBlank(invCode)) {
            paxQuery.setParameter("invCode", invCode);
        } else if (StringUtils.isNotBlank(psNo)) {
            paxQuery.setParameter("psNo", psNo);
        } else {
            paxQuery.setParameter("tourBookingId", tourBookingId);
        }
        paxQuery.setParameter("statusCd", "A"); // Active status
        List<Object[]> paxResults = paxQuery.list();
        
        for (Object[] row : paxResults) {
            FeedbackVO vo = new FeedbackVO();
            
            if (row[15] != null) {
                vo.setTourBookingId(((Number) row[15]).longValue());
            } else {
                vo.setTourBookingId(tourBookingId);
            }
            
            if (row[0] != null) vo.setCustomerId(((Number) row[0]).longValue());
            
            String salutation = row[1] != null ? row[1].toString() : "";
            String firstName  = row[2] != null ? row[2].toString() : "";
            String lastName   = row[3] != null ? row[3].toString() : "";
            if (row[4] != null) vo.setCustomerEmail(row[4].toString());
            
            String fullName = (StringUtils.isNotBlank(salutation) ? salutation + ". " : "")
                            + firstName
                            + (StringUtils.isNotBlank(lastName)   ? " " + lastName   : "");
            vo.setCustomerName(fullName.trim());
            
            if (row[5] != null) vo.setIdTourDeparture(((Number) row[5]).longValue());
            if (row[6] != null) vo.setIdTourPkg(((Number) row[6]).longValue());
            if (row[7] != null) vo.setTourDepCode(row[7].toString());
            if (row[8] != null) vo.setTourPkgTypeCd(row[8].toString());
            if (row[9] != null) vo.setTourPkgCode(row[9].toString());
            if (row[10] != null) vo.setFeedbackStatus(row[10].toString());
            if (row[11] != null) vo.setInvId(((Number) row[11]).longValue());
            if (row[12] != null) vo.setInvCode(row[12].toString());
            if (row[13] != null) vo.setPsNo(row[13].toString());
            if (row[14] != null) vo.setDocTypeCd(row[14].toString());
            
            list.add(vo);
        }
        
        if (list.isEmpty()) {
            StringBuilder sbFallback = new StringBuilder();
            sbFallback.append("SELECT tb.id_cust, p.salutation_cd, p.first_name, p.last_name, p.email, ")
                      .append("       tb.id_tour_dep, td.id_tour_pkg, td.code AS td_code, tp.type_cd AS tp_type_cd, tp.code AS tp_code, ")
                      .append("       f.status AS feedback_status ")
                      .append("FROM tour_booking tb ")
                      .append("JOIN customer c ON tb.id_cust = c.id ")
                      .append("JOIN person p ON c.id_pc = p.id ")
                      .append("LEFT JOIN tour_dep td ON tb.id_tour_dep = td.id ")
                      .append("LEFT JOIN tour_pkg tp ON td.id_tour_pkg = tp.id ")
                      .append("LEFT JOIN feedback f ON f.id_tour_booking = tb.id AND f.id_customer = tb.id_cust ")
                      .append("WHERE tb.id = :tourBookingId");
            Query fbQuery = createSQLQuery(sbFallback.toString());
            fbQuery.setParameter("tourBookingId", tourBookingId);
            List<Object[]> fbResults = fbQuery.list();
            for (Object[] row : fbResults) {
                FeedbackVO vo = new FeedbackVO();
                vo.setTourBookingId(tourBookingId);
                
                if (row[0] != null) vo.setCustomerId(((Number) row[0]).longValue());
                
                String salutation = row[1] != null ? row[1].toString() : "";
                String firstName  = row[2] != null ? row[2].toString() : "";
                String lastName   = row[3] != null ? row[3].toString() : "";
                if (row[4] != null) vo.setCustomerEmail(row[4].toString());
                
                String fullName = (StringUtils.isNotBlank(salutation) ? salutation + ". " : "")
                                + firstName
                                + (StringUtils.isNotBlank(lastName)   ? " " + lastName   : "");
                vo.setCustomerName(fullName.trim());
                
                if (row[5] != null) vo.setIdTourDeparture(((Number) row[5]).longValue());
                if (row[6] != null) vo.setIdTourPkg(((Number) row[6]).longValue());
                if (row[7] != null) vo.setTourDepCode(row[7].toString());
                if (row[8] != null) vo.setTourPkgTypeCd(row[8].toString());
                if (row[9] != null) vo.setTourPkgCode(row[9].toString());
                if (row[10] != null) vo.setFeedbackStatus(row[10].toString());
                
                list.add(vo);
            }
        }
        
        return list;
    }

    @Override
    public void updateTourDepLeaderAndGuide(Long idTourDep, Long idTourLeader, Long idTourGuide) throws BusinessException {
        String sql = "UPDATE tour_dep SET id_tour_leader = :idTourLeader, id_tour_guide = :idTourGuide, dt_upd = NOW(), upd_by = :updBy WHERE id = :idTourDep";
        Query query = createSQLQuery(sql);
        query.setParameter("idTourDep", idTourDep);
        query.setParameter("idTourLeader", idTourLeader);
        query.setParameter("idTourGuide", idTourGuide);
        
        String updBy = "SYSTEM";
        try {
            if (BaseContext.getUserFullName() != null) {
                updBy = BaseContext.getUserFullName();
            } else if (BaseContext.getLoginId() != null) {
                updBy = BaseContext.getLoginId();
            }
        } catch (Exception e) {}
        query.setParameter("updBy", updBy);
        
        query.executeUpdate();
    }
}