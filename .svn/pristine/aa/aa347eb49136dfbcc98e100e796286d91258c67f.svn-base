    public List<FeedbackVO> getInvoiceForFeedback() throws BusinessException {
        return getInvoiceForFeedback(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public List<FeedbackVO> getInvoiceForFeedback(Long idTourBooking) throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("SELECT ")
            .append("iv.id AS inv_id, ")
            .append("iv.id_parent_inv AS id_parent_inv, ")
            .append("iv.id_parent_inv_tour_booking AS id_parent_inv_tour_booking, ")
            .append("iv.code AS inv_code, ")
            .append("iv.ps_no AS ps_no, ")
            .append("iv.doc_type_cd AS doc_type_cd, ")
            .append("iv.doc_type_status AS doc_type_status, ")
            .append("iv.attn_to AS attn_to, ")
            // Tour Departure
            .append("td.id AS td_id, ")
            .append("td.num_nights, ")
            .append("td.dt_dep, ")
            .append("td.code AS td_code, ")
            .append("td.op_pic, ")
            .append("CASE ")
            .append("    WHEN iv.doc_type_cd = 'I' THEN CONCAT('AV', iv.code) ")
            .append("    WHEN iv.doc_type_cd = 'P' THEN CONCAT('PS', iv.ps_no) ")
            .append("    ELSE NULL ")
            .append("END AS doc_id, ")
            // Tour Package
            .append("tp.id AS tp_id, ")
            .append("tp.type_cd AS tp_type_cd, ")
            .append("tp.code AS tp_code, ")
            // Customer (priority: Invoice I > PS P > tour_booking)
            .append("c.id AS c_id, ")
            .append("c.id_pc, ")
            .append("c.id_corporate, ")
            .append("c.corporate_name, ")
            .append("c.status_cd AS c_status_cd, ")
            // Person (from prioritized customer)
            .append("p.id AS p_id, ")
            .append("p.salutation_cd, ")
            .append("p.title, ")
            .append("p.first_name, ")
            .append("p.middle_name, ")
            .append("p.last_name, ")
            .append("p.email, ")
            // Tour Booking
            .append("tb.id AS tb_id, ")
            .append("tb.type_cd AS tb_type_cd, ")
            .append("tb.pmnt_status_cd, ")
            .append("tb.status_cd AS tb_status_cd, ")
            // Op Pic Names
            .append("GROUP_CONCAT( ")
            .append("    DISTINCT su.user_name ")
            .append("    ORDER BY FIND_IN_SET(e.id, td.op_pic) ")
            .append("    SEPARATOR ', ' ")
            .append(") AS op_pic_names ")

            .append("FROM tour_booking tb ")
            .append("LEFT JOIN tour_dep td ON tb.id_tour_dep = td.id ")
            .append("LEFT JOIN tour_pkg tp ON td.id_tour_pkg = tp.id ")
            .append("LEFT JOIN invoice iv ON (iv.id_tour_booking = tb.id OR iv.id_parent_inv_tour_booking = tb.id) ")
            .append("    AND iv.status_cd NOT IN ('CC', 'VD') ")
            .append("    AND COALESCE(iv.doc_type_status, '') NOT IN ('SP', 'CV', 'CL') ")
            // Customer from priority: Invoice > tour_booking
            .append("JOIN customer c ON c.id = COALESCE(iv.id_customer, tb.id_cust) ")
            .append("JOIN person p ON c.id_pc = p.id ")
            .append("LEFT JOIN JSON_TABLE( ")
            .append("    CONCAT('[\"', REPLACE(COALESCE(NULLIF(td.op_pic, ''), '0'), ',', '\",\"'), '\"]'), ")
            .append("    '$[*]' COLUMNS (emp_id BIGINT PATH '$') ")
            .append(") AS jt ON jt.emp_id > 0 ")
            .append("LEFT JOIN employee e ON e.id = jt.emp_id ")
            .append("LEFT JOIN sec_user su ON su.uuid = e.u_sec_user ")

            .append("WHERE (jt.emp_id IS NULL OR jt.emp_id > 0) ")
            .append("AND tb.status_cd NOT IN ('"+CommonConstant.STATUS_CD_CANCELLED+"','"+ CommonConstant.STATUS_CD_VOID +"') ")
            .append("AND tb.pmnt_status_cd <> '"+SalesConstant.BOOKING_PMNT_STATUS_KIVEXP+"' ");

        if (idTourBooking != null) {
            sb.append("AND tb.id = :id_tour_booking ");
        } else {
            sb.append("AND DATE(DATE_ADD(td.dt_dep, INTERVAL td.num_nights DAY)) ")
              .append("  = DATE(DATE_ADD(CURDATE(), INTERVAL 1 DAY)) ");
        }

        sb.append("GROUP BY tb.id, iv.id ");

        Query query = createSQLQuery(sb.toString());
        if (idTourBooking != null) {
            query.setParameter("id_tour_booking", idTourBooking);
        }

        List<Object> results = query.list();
        List<FeedbackVO> feedbackList = new ArrayList<FeedbackVO>();
        FeedbackVO vo;

        for (Iterator<Object> it = results.iterator(); it.hasNext();) {
            Object[] row = (Object[]) it.next();
            vo = new FeedbackVO();

            // Invoice (priority resolved)
            if (row[0]  != null) vo.setInvId(((BigInteger) row[0]).longValue());
            if (row[1]  != null) vo.setParentInvId(((BigInteger) row[1]).longValue());
            if (row[2]  != null) vo.setParentInvTourBookingId(((BigInteger) row[2]).longValue());
            if (row[3]  != null) vo.setInvCode((String) row[3]);
            if (row[4]  != null) vo.setPsNo((String) row[4]);
            if (row[5]  != null) vo.setDocTypeCd((String) row[5]);
            if (row[6]  != null) vo.setDocTypeStatus((String) row[6]);
            if (row[7]  != null) vo.setAttnTo((String) row[7]);

            // Tour Departure
            if (row[8]  != null) vo.setIdTourDeparture(((BigInteger) row[8]).longValue());
            if (row[9]  != null) vo.setNumNights(((Short) row[9]).intValue());
            if (row[10] != null) vo.setDepartureDate((Date) row[10]);
            if (row[11] != null) vo.setTourDepCode((String) row[11]);
            if (row[12] != null) vo.setOpPic((String) row[12]);
            if (row[13] != null) vo.setDocId((String) row[13]);

            // Tour Package
            if (row[14] != null) vo.setIdTourPkg(((BigInteger) row[14]).longValue());
            if (row[15] != null) vo.setTourPkgTypeCd((String) row[15]);
            if (row[16] != null) vo.setTourPkgCode((String) row[16]);

            // Customer (from prioritized source)
            if (row[17] != null) vo.setCustomerId(((BigInteger) row[17]).longValue());
            if (row[18] != null) vo.setCustomerPersonId(((BigInteger) row[18]).longValue());
            if (row[19] != null) vo.setCustomerCorporateId(((BigInteger) row[19]).longValue());
            if (row[20] != null) vo.setCorporateName((String) row[20]);
            if (row[21] != null) vo.setCustomerStatusCode((String) row[21]);

            // Person
            if (row[22] != null) vo.setPersonId(((BigInteger) row[22]).longValue());
            String salutation = row[23] != null ? row[23].toString() : "";
            String title      = row[24] != null ? row[24].toString() : "";
            String firstName  = row[25] != null ? row[25].toString() : "";
            String middleName = row[26] != null ? row[26].toString() : "";
            String lastName   = row[27] != null ? row[27].toString() : "";
            if (row[28] != null) vo.setCustomerEmail((String) row[28]);

            vo.setSalutationCd(salutation);
            vo.setTitle(title);
            vo.setFirstName(firstName);
            vo.setMiddleName(middleName);
            vo.setLastName(lastName);

            String fullName = (StringUtils.isNotBlank(salutation) ? salutation + ". " : "")
                            + firstName
                            + (StringUtils.isNotBlank(middleName) ? " " + middleName : "")
                            + (StringUtils.isNotBlank(lastName)   ? " " + lastName   : "");
            vo.setCustomerName(fullName.trim());

            // Tour Booking
            if (row[29] != null) vo.setTourBookingId(((BigInteger) row[29]).longValue());
            if (row[30] != null) vo.setTourBookingTypeCd((String) row[30]);
            if (row[31] != null) vo.setPaymentStatusCode((String) row[31]);
            if (row[32] != null) vo.setBookingStatusCode((String) row[32]);

            // Op Pic Names
            if (row[33] != null) vo.setOpPicNames((String) row[33]);

            feedbackList.add(vo);
        }

        System.out.println("Records for feedback email: " + feedbackList.size());

        return feedbackList;
    }

    /*
     * (non-Javadoc)
     * @see com.bcs.zsg.product.dao.FeedbackDAO#insertFeedback(com.bcs.zsg.product.vo.FeedbackVO)
     */
    @Override
    public void insertFeedback(FeedbackVO feedbackVO) throws BusinessException {
        String sql = "INSERT INTO feedback "
                   + "(id_tour_pkg, id_tour_dep, id_invoice, ps_no, id_customer, id_tour_booking, email, token_uuid, status, comments, dt_created, created_by, dt_upd, upd_by) "
            + "VALUES (:id_tour_pkg, :id_tour_dep, :id_invoice, :ps_no, :id_customer, :id_tour_booking, :email, :token_uuid, :status, :comments, NOW(), :created_by, NOW(), :upd_by)";

        String createdBy = "SYSTEM";
        try {
            if (BaseContext.getUserFullName() != null) {
                createdBy = BaseContext.getUserFullName();
            } else if (BaseContext.getLoginId() != null) {
                createdBy = BaseContext.getLoginId();
            }
        } catch (Exception e) {
            // Ignore
        }

        Query query = createSQLQuery(sql);
        query.setParameter("id_tour_pkg",     feedbackVO.getIdTourPkg());
        query.setParameter("id_tour_dep",     feedbackVO.getIdTourDeparture());
        query.setParameter("id_invoice",      feedbackVO.getInvId());
        query.setParameter("ps_no",           feedbackVO.getPsNo());
        query.setParameter("id_customer",     feedbackVO.getCustomerId());
        query.setParameter("id_tour_booking", feedbackVO.getTourBookingId() != null ? String.valueOf(feedbackVO.getTourBookingId()) : null);
        query.setParameter("email",           feedbackVO.getCustomerEmail());
        query.setParameter("token_uuid",      feedbackVO.getTokenUuid());
        query.setParameter("status",          feedbackVO.getFeedbackStatus());
        query.setParameter("comments",        feedbackVO.getComments());
        query.setParameter("created_by",      createdBy);
        query.setParameter("upd_by",          createdBy);
        query.executeUpdate();
    }

    /*
     * (non-Javadoc)
     * @see com.bcs.zsg.product.dao.FeedbackDAO#getFeedbackListbyTourDepId(java.lang.Long)
     */
    @SuppressWarnings("unchecked")
    @Override
    public List<FeedbackVO> getFeedbackListbyTourDepId(Long idTourDep) throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("SELECT ")
          .append("f.id AS feedback_id, td.id_tour_pkg AS id_tour_pkg, td.id AS id_tour_dep, c.id AS id_customer, f.status, f.comments, ")
          .append("(SELECT fa_cust.filename FROM feedback_attachment fa_cust WHERE fa_cust.id_feedback = f.id AND fa_cust.type = 'cust' LIMIT 1) AS attachment, ")
          .append("fq.id AS id_feedback_question, fq.seq_no, fq.section_type, fq.question_code, fq.question_text_en, ")
          .append("fq.answer_type, fq.is_required, fq.has_remark, fq.placeholder_en, ")
          .append("fa.id AS id_feedback_answer, fa.answer_label_en, fa.score_value, ")
          .append("fca.remarks, fca.answer_text, ")
          .append("td.num_nights, td.dt_dep, td.code AS tour_dep_code, td.op_pic, ")
          .append("p.id AS person_id, p.salutation_cd, p.first_name, p.last_name, p.email, ")
          .append("c.id AS customer_id, ")
          .append("(SELECT fa_hos.filename FROM feedback_attachment fa_hos WHERE fa_hos.id_feedback = f.id AND fa_hos.type = 'hos' LIMIT 1) AS attachment_hos, ")
          .append("f.comments_hos, ")
          .append("f.id_tour_booking AS id_tour_booking, i.id AS inv_id, i.code AS inv_code, f.ps_no ")
          .append("FROM feedback f ")
          .append("JOIN customer c ON f.id_customer = c.id ")
          .append("JOIN person p ON c.id_pc = p.id ")
          .append("JOIN tour_dep td ON f.id_tour_dep = td.id ")
          .append("LEFT JOIN tour_booking tb ON f.id_tour_booking = tb.id ")
          .append("LEFT JOIN invoice i ON f.id_invoice = i.id ")
          .append("LEFT JOIN feedback_cust_answer fca ON fca.id_feedback = f.id ")
          .append("LEFT JOIN feedback_question fq ON fq.id = fca.id_feedback_question ")
          .append("LEFT JOIN feedback_answer fa ON fa.id = fca.id_feedback_answer ")
          .append("WHERE f.id_tour_dep = :idTourDep ")
          .append("ORDER BY f.id, fq.id");

        Query query = createSQLQuery(sb.toString());
        query.setLong("idTourDep", idTourDep);

        List<Object> results = query.list();
        List<FeedbackVO> feedbackList = new ArrayList<FeedbackVO>();
        FeedbackVO vo;

        for (Iterator<Object> it = results.iterator(); it.hasNext();) {
            Object[] row = (Object[]) it.next();
            vo = new FeedbackVO();
            vo.setIdFeedback(row[0]  != null ? ((BigInteger) row[0]).longValue() : null);
            vo.setIdTourPkg(row[1]   != null ? ((BigInteger) row[1]).longValue() : null);
            vo.setIdTourDeparture(row[2] != null ? ((BigInteger) row[2]).longValue() : null);
            vo.setCustomerId(row[3]  != null ? ((BigInteger) row[3]).longValue() : null);
            vo.setFeedbackStatus(row[4]  != null ? row[4].toString() : null);
            vo.setComments(row[5]  != null ? row[5].toString() : null);
            vo.setAttachment(row[6]  != null ? row[6].toString() : null);
            vo.setIdFeedbackQuestion(row[7] != null ? ((BigInteger) row[7]).longValue() : null);
            vo.setSectionType(row[9]     != null ? row[9].toString() : null);
            vo.setQuestionCode(row[10]    != null ? row[10].toString() : null);
            vo.setQuestionTextEn(row[11] != null ? row[11].toString() : null);
            vo.setAnswerType(row[12]     != null ? row[12].toString() : null);
            vo.setIdFeedbackAnswer(row[16] != null ? ((BigInteger) row[16]).longValue() : null);
            vo.setAnswerLabelEn(row[17]  != null ? row[17].toString() : null);
            vo.setScoreValue(row[18]     != null ? Integer.parseInt(row[18].toString()) : 0);
            vo.setRemarks(row[19]        != null ? row[19].toString() : null);
            vo.setAnswerText(row[20]     != null ? row[20].toString() : null);
            vo.setNumNights(row[21]      != null ? ((Short) row[21]).intValue() : 0);
            vo.setTourCode(row[23]       != null ? row[23].toString() : null);
            vo.setCustomerEmail(row[29]  != null ? row[29].toString() : null);
            vo.setAttachmentHos(row[31]  != null ? row[31].toString() : null);
            vo.setCommentsHos(row[32]    != null ? row[32].toString() : null);
            vo.setTourBookingId(row[33]  != null ? Long.valueOf(row[33].toString()) : null);
            vo.setInvId(row[34]          != null ? ((BigInteger) row[34]).longValue() : null);
            vo.setInvCode(row[35]        != null ? row[35].toString() : null);
            vo.setPsNo(row[36]           != null ? row[36].toString() : null);

            String salutation = row[26] != null ? row[26].toString() : "";
            String firstName  = row[27] != null ? row[27].toString() : "";
            String lastName   = row[28] != null ? row[28].toString() : "";
            vo.setCustomerName(
                (StringUtils.isNotBlank(salutation) ? salutation + ". " : "")
                + firstName
                + (StringUtils.isNotBlank(lastName) ? " " + lastName : "")
            );

            feedbackList.add(vo);
        }
        return feedbackList;
    }

    /*
     * (non-Javadoc)
     * @see com.bcs.zsg.product.dao.FeedbackDAO#updateFeedbackStatus(java.lang.Long, java.lang.String)
     */
    @Override
    public void updateFeedbackStatus(Long idInvoice, String status) throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("UPDATE feedback ")
          .append("SET status = :status ")
          .append("WHERE id_invoice = :id_invoice ");

        System.out.println(
            "UPDATE feedback SET status = '" + status +
            "' WHERE id_invoice = " + idInvoice
        );

        Query query = createSQLQuery(sb.toString());
        query.setString("status", status);
        query.setLong("id_invoice", idInvoice);
        query.executeUpdate();
    }
    
    @Override
    public Long getFeedbackIdByBookingId(Long idBooking) throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("SELECT id ")
          .append("FROM feedback ")
          .append("WHERE id_tour_booking = :id_tour_booking ")
          .append("ORDER BY dt_created DESC ");

        Query query = createSQLQuery(sb.toString());
        query.setLong("id_tour_booking", idBooking);
        query.setMaxResults(1);

        Object result = query.uniqueResult();

        return result != null ? ((BigInteger) result).longValue() : null;
    }

    @Override
    public Long getFeedbackIdByBookingIdAndCustomerId(Long idBooking, Long idCustomer) throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("SELECT id ")
          .append("FROM feedback ")
          .append("WHERE id_tour_booking = :id_tour_booking ")
          .append("  AND id_customer = :id_customer ")
          .append("ORDER BY dt_created DESC ");

        Query query = createSQLQuery(sb.toString());
        query.setLong("id_tour_booking", idBooking);
        query.setLong("id_customer", idCustomer);
        query.setMaxResults(1);

        Object result = query.uniqueResult();

        return result != null ? ((BigInteger) result).longValue() : null;
    }

    @Override
    public Long getFeedbackId(Long idBooking, Long idCustomer, Long idInvoice) throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("SELECT id ")
          .append("FROM feedback ")
          .append("WHERE id_tour_booking = :id_tour_booking ");
        if (idInvoice != null) {
            sb.append("  AND id_invoice = :id_invoice ");
        } else {
            sb.append("  AND id_customer = :id_customer ");
        }
        sb.append("ORDER BY id DESC ");

        Query query = createSQLQuery(sb.toString());
        query.setLong("id_tour_booking", idBooking);
        if (idInvoice != null) {
            query.setLong("id_invoice", idInvoice);
        } else {
            query.setLong("id_customer", idCustomer);
        }
        query.setMaxResults(1);

        Object result = query.uniqueResult();

        return result != null ? ((BigInteger) result).longValue() : null;
    }

    @Override
    public void updateFeedbackForResend(Long idFeedback, String tokenUuid, String status, String email, Long idInvoice, String psNo, String updBy) throws BusinessException {
        StringBuilder sb = new StringBuilder();
        sb.append("UPDATE feedback ")
          .append("SET token_uuid = :tokenUuid, ")
          .append("    status = :status, ")
          .append("    email = :email, ")
          .append("    id_invoice = :idInvoice, ")
          .append("    ps_no = :psNo, ")
          .append("    dt_upd = NOW(), ")
          .append("    upd_by = :updBy ")
          .append("WHERE id = :idFeedback ");

        Query query = createSQLQuery(sb.toString());
        query.setString("tokenUuid", tokenUuid);
        query.setString("status", status);
        query.setString("email", email);
        query.setParameter("idInvoice", idInvoice);
        query.setString("psNo", psNo);
        query.setString("updBy", updBy);
        query.setLong("idFeedback", idFeedback);
        query.executeUpdate();
    }

