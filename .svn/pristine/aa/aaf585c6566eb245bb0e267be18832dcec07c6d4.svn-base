<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.sales.vo">

    <class table="PERSON_IDENTITY_DETAIL" name="IdentityDetailVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="personIdentityId" type="long" column="ID_PERSON_IDENTITY"/>
        <property name="idCountry" type="long" column="ID_COUNTRY"/>
        <property name="typeCd" type="string" column="TYPE_CD"/>
        <property name="entryCd" type="string" column="ENTRY_CD"/>
        <property name="dtIssued" type="timestamp" column="DT_ISSUED"/>
        <property name="dtExpired" type="timestamp" column="DT_EXPIRED"/>
        <property name="scannedPath" type="string" column="SCANNED_PATH"/>
        <property name="filePath" type="string" column="FILE_PATH"/>
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>