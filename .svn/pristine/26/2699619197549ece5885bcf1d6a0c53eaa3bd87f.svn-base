package com.bcs.zsg.maintenance.vo;

import java.math.BigDecimal;

import com.bcs.zsg.core.vo.BaseVO;

public class IpayConfigVO extends BaseVO {
	
	private static final long serialVersionUID = 1L;
	
	private String merchantCode;
	private String merchantKey;
	private String comment;
	private BigDecimal adminChargesPercentage;
	private Long idAcct;
	private String acctCode;
	private String acctDesc;
	
	public String getMerchantCode() {
		return merchantCode;
	}
	
	public void setMerchantCode(String merchantCode) {
		this.merchantCode = merchantCode;
	}
	
	public String getMerchantKey() {
		return merchantKey;
	}
	
	public void setMerchantKey(String merchantKey) {
		this.merchantKey = merchantKey;
	}
	
	public String getComment() {
		return comment;
	}
	
	public void setComment(String comment) {
		this.comment = comment;
	}

	public BigDecimal getAdminChargesPercentage() {
		return adminChargesPercentage;
	}

	public void setAdminChargesPercentage(BigDecimal adminChargesPercentage) {
		this.adminChargesPercentage = adminChargesPercentage;
	}

	public Long getIdAcct() {
		return idAcct;
	}

	public void setIdAcct(Long idAcct) {
		this.idAcct = idAcct;
	}

	public String getAcctCode() {
		return acctCode;
	}

	public void setAcctCode(String acctCode) {
		this.acctCode = acctCode;
	}

	public String getAcctDesc() {
		return acctDesc;
	}

	public void setAcctDesc(String acctDesc) {
		this.acctDesc = acctDesc;
	}
	
}
