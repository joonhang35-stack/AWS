	/**
	 * Load filter tour departure
	 */
	public void handleFilterBookingTourDepList() {
		try {
			trackingLogUtils.startLogs();

			if (StringUtils.isNotBlank(searchTourDepFilter.getCode()) ||
				StringUtils.isNotBlank(searchTourDepFilter.getPackageDesc()) ||
				searchTourDepFilter.getFromDate() != null ||
				searchTourDepFilter.getToDate() != null ||
				CollectionUtils.isNotEmpty(searchTourDepFilter.getTourStatusList()) ||
				CollectionUtils.isNotEmpty(searchTourDepFilter.getTourLangList()) ||
				searchTourDepFilter.getPriceFrom() != null ||
				searchTourDepFilter.getPriceTo() != null ||
				searchTourDepFilter.getBalanceSeat() != null ||
				CollectionUtils.isNotEmpty(searchTourDepFilter.getSelectedSeason()) ||
				CollectionUtils.isNotEmpty(searchTourDepFilter.getDepartDateBadgeList()) ||
				CollectionUtils.isNotEmpty(searchTourDepFilter.getSectorTypeList()) ||
				CollectionUtils.isNotEmpty(searchTourDepFilter.getSectorList())) {
				if (isAgentViewOnly || isAgentBooking) {
					searchTourDepFilter.setAgent(true);
				}
				tourBookingFilterDepList = tourPkgBO.getFilterBookingTourDepList(searchTourDepFilter, getSessionInfoBean().getCompanyVO());
				tourItineraryListControl(tourBookingFilterDepList);

				privateTourChecking(tourBookingFilterDepList);

				accCodeStatusCdCheckingForAgent(tourBookingFilterDepList);
			}

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("LoadFilterBookingTourDepList");
		}
	}

	public void privateTourChecking(List<TourDepartureVO> privateTourDepList) {
		for (TourDepartureVO tourDepVO : privateTourDepList) {
			if (tourDepVO.getIsPrivateTour() != null && tourDepVO.getIsPrivateTour() == Boolean.TRUE) {
				tourDepVO.setIsPrivateBooking(Boolean.TRUE);
				if (StringUtils.isNotBlank(tourDepVO.getPrivatePic()) &&
						tourDepVO.getPrivatePic().concat(",").contains(getSessionInfoBean().getEmployeeVO().getId().toString().concat(","))) {
					tourDepVO.setIsPrivateBooking(Boolean.FALSE);
				}
			}
		}
	}
	
	// Use for department - B2B Agent user to show agent itinerary copy
	public void tourItineraryListControl(List<TourDepartureVO> tourDepList) {
		TourItineryVO custEnItinery = null;
		TourItineryVO agentEnItinery = null;
		
		for (TourDepartureVO tourDepVO : tourDepList) {
			if (CollectionUtils.isNotEmpty(tourDepVO.getTourItineryList())) {
				custEnItinery = null;
				agentEnItinery = null;
				
				for (TourItineryVO itineryVO : tourDepVO.getTourItineryList()) {
					if ("CUST".equals(itineryVO.getTypeCd()) && "EN".equals(itineryVO.getLangCd()))
						custEnItinery = itineryVO;
					if ("AGENT".equals(itineryVO.getTypeCd()) && "EN".equals(itineryVO.getLangCd()))
						agentEnItinery = itineryVO;
				}
				
				if (isB2BAgent && agentEnItinery != null) tourDepVO.getTourItineryList().remove(custEnItinery);
				else tourDepVO.getTourItineryList().remove(agentEnItinery);
			}
			
			if (tourDepVO.getTourPackageDailyItineraryVO() != null && tourDepVO.getTourPackageDailyItineraryVO().getPkgItineryMap() != null) {
				if (isB2BAgent && tourDepVO.getTourPackageDailyItineraryVO().getPkgItineryMap().get("DAILY_ITINERARY_AGENTEN") != null) tourDepVO.getTourPackageDailyItineraryVO().getPkgItineryMap().remove("DAILY_ITINERARY_CUSTEN");
				else tourDepVO.getTourPackageDailyItineraryVO().getPkgItineryMap().remove("DAILY_ITINERARY_AGENTEN");
			}
			
		}
	}

	public void accCodeStatusCdCheckingForAgent(List<TourDepartureVO> tourDepList) {
		// Remove tour dep that are pending
	    if (isAgentViewOnly || isAgentBooking) {
	    	if (CollectionUtils.isNotEmpty(tourDepList)) {
		        Iterator<TourDepartureVO> iterator = tourDepList.iterator();
		        while (iterator.hasNext()) {
		            TourDepartureVO tourDepVO = iterator.next();
		            if (tourDepVO.getAccCodeStatusCd().equals("N")) {
		                iterator.remove();  // Safely remove using iterator
		            }
		        }
	    	}
	    }
	}

	public void handleFilterClearAll() {
		try {
			searchTourDepFilter.setCode(null);
			searchTourDepFilter.setPackageDesc(null);
			searchTourDepFilter.setFromDate(null);
			searchTourDepFilter.setToDate(null);
			searchTourDepFilter.setTourStatusList(new ArrayList<String>());
			searchTourDepFilter.setTourLangList(new ArrayList<String>());
			searchTourDepFilter.setPriceFrom(null);
			searchTourDepFilter.setPriceTo(null);
			searchTourDepFilter.setBalanceSeat(null);
			searchTourDepFilter.setSelectedSeason(new ArrayList<String>());
			searchTourDepFilter.setDepartDateBadgeList(new ArrayList<String>());
			searchTourDepFilter.setSectorTypeList(new ArrayList<String>());
			searchTourDepFilter.setSectorList(new ArrayList<String>());
			searchTourDepFilter.setAgent(false);
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void printTourDepFindTourListRpt() {
		try {
			if (CollectionUtils.isEmpty(tourBookingFilterDepList)) throw new BusinessException("ERR_NO_RESULT");
			
			HashMap<String, Object> map = reportHeaderCompany();
			
			List<TourDepartureVO> tourDepartureList = new ArrayList<TourDepartureVO>();
			
			String depDesc = "";
			String pkgDesc = "";
			for (TourDepartureVO oriVO: tourBookingFilterDepList) {
				TourDepartureVO vo = new TourDepartureVO();
				vo = (TourDepartureVO) oriVO.clone();
				
				if ("F".equals(vo.getTourStatusCd())) vo.setTourStatusDesc("Full");
				else
					vo.setTourStatusDesc(LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_TOUR_STATUS, vo.getTourStatusCd()));
				
				pkgDesc = "";
				if (StringUtils.isNotEmpty(vo.getNameEn())) pkgDesc += vo.getNameEn();
				if (StringUtils.isNotEmpty(vo.getNameZh())) pkgDesc += vo.getNameZh();
				if (StringUtils.isNotEmpty(vo.getNameOther())) pkgDesc += vo.getNameOther();
				vo.setPackageDesc(pkgDesc);
				
				depDesc = "";
				if (vo.getIsDepositPaid() != null && Boolean.TRUE.equals(vo.getIsDepositPaid())) depDesc += "PD ";
				depDesc += vo.getNumDays() + "D/" + vo.getNumNights() + "N ";
				if (StringUtils.isNotEmpty(vo.getDesc())) depDesc += "[" + vo.getDesc() + "]";
				if (StringUtils.isNotEmpty(vo.getPrn())) depDesc += "[" + vo.getPrn() + "]";
				if (vo.getIsIssuedS() != null && Boolean.TRUE.equals(vo.getIsIssuedS())) depDesc += "[S]";
				if (vo.getIsIssuedF() != null && Boolean.TRUE.equals(vo.getIsIssuedF())) depDesc += "[F]";
				if (StringUtils.isNotEmpty(vo.getDailyCode())) depDesc += "[" + vo.getDailyCode() + "]";
				for (String badgeVO : vo.getDepartDateBadgeList()) {
					depDesc += "(" + badgeVO + ")";
				}
				vo.setDesc(depDesc);
				
				if (Double.compare(vo.getDiscount1(), 0D) > 0) vo.setDiscount1(vo.getDiscount1() * -1);
				if (Double.compare(vo.getDiscount2(), 0D) > 0) vo.setDiscount2(vo.getDiscount2() * -1);
				
				int totalSold = vo.getTfairPax() + vo.getAgentPax() + vo.getInHsePax() + vo.getKivPax() + vo.getOn9BookingPax();
				int balSeat = vo.getSeatAllot() - vo.getReservedSeat() - vo.getTourManagerPax() 
						- (vo.getTfairPax() + vo.getAgentPax() + vo.getInHsePax() + vo.getKivPax() + vo.getOn9BookingPax());
				
				vo.setTotalSold(totalSold);
				vo.setBalSeat(balSeat);
				
				tourDepartureList.add(vo);
			}
			
			String jasperFileName = CommonConstant.JAS_RPT_TOUR_DEP_FIND_TOUR_LIST;
			String reportName = CommonConstant.PDF_RPT_TOUR_DEP_FIND_TOUR_LIST;

			JasperPrint jasperPrint = ReportUtils.getJasperPrint(tourDepartureList, map, jasperFileName);
			//Convert cell type as report (eg: '350.00 to 350.00)
			jasperPrint.setProperty("net.sf.jasperreports.export.xls.detect.cell.type", "true");
			ReportUtils.printReportExcel(jasperPrint, reportName);
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	/**
	 * Report Header Company Detail
	 */
	public HashMap<String, Object> reportHeaderCompany() {
		HashMap<String, Object> map = new HashMap<String, Object>();
		try {
			CompanyVO companyVO = new CompanyVO();
			companyVO = corporateProfileBO.getCompanyDetails(getSessionInfoBean().getCompanyVO().getId());
			
			StringBuilder address = new StringBuilder();
			map.put("companyName", companyVO.getName());
			map.put("slogan", companyVO.getSlogan());
			
			if (!companyVO.getCompanyAddressVO().getAddress1().equals("")) address.append(companyVO.getCompanyAddressVO().getAddress1()).append(" ");
			if (!companyVO.getCompanyAddressVO().getAddress2().equals("")) address.append(companyVO.getCompanyAddressVO().getAddress2()).append(" ");
			if (!companyVO.getCompanyAddressVO().getAddress3().equals("")) address.append(companyVO.getCompanyAddressVO().getAddress3()).append(" ");
			if (!companyVO.getCompanyAddressVO().getCity().equals("")) address.append(companyVO.getCompanyAddressVO().getCity()).append(" ");
			if (!companyVO.getCompanyAddressVO().getState().equals("")) address.append(companyVO.getCompanyAddressVO().getState()).append(" ");
			if (!companyVO.getCompanyAddressVO().getPostcode().equals("")) address.append(companyVO.getCompanyAddressVO().getPostcode()).append(" ");
			String companyName = regionBO.getCountryById(companyVO.getCompanyAddressVO().getCountryid()).getCountry();
			if (!companyName.equals("")) address.append(companyName);
			map.put("address", address);
	
			String contact = "";
			for (CompanyContactVO vo : companyVO.getCompanyContactList()) {
				contact += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, vo.getTypecodecontact()) + ": " + vo.getNumber() + "  ";
			}
			if (!contact.equals("")) contact = "Tel: " + contact;
			map.put("contact", contact);
			
		} catch (Throwable t) {
			errorResult(t);
		}
		return map;
	}

	/**
	 * Make payment
	 */
	public void makePayment(BookingVO vo) {
		try {
			List<TourDepItemVO> tourDepItemVOList = tourPkgBO.getTourDepItemList(tourDepVO.getId(), getSessionInfoBean().getCompanyVO().getId());
			boolean isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), new Date());

			InvoiceVO invVO = new InvoiceVO();
			invVO.setInvoiceDt(new Date());
			invVO.setCustomerId(vo.getIdCust());
			invVO.setBookingId(vo.getId());
			invVO.setTourCd(tourDepVO.getCode());
			invVO.setTourDepId(tourDepVO.getId());
			invVO.setSubjLine(tourDepVO.getDesc());
			invVO.setDepartureDt(tourDepVO.getDtDep());
			invVO.setOrderCd(vo.getOrderTypeCd());
			if (ProductConstant.TYPE_CRUISE.equals(vo.getTypeCd())) {
				invVO.setCatCd(CommonConstant.LOOKUP_ITM_INV_CAT_CRUISE);
			} else {
				invVO.setCatCd(CommonConstant.LOOKUP_ITM_INV_CAT_TOUR);
			}
			invVO.setSalerId(vo.getIdEmployee());
			invVO.setSalerName(vo.getEmployeeViewVO().getUserVO().getName());
			StringBuilder sb = new StringBuilder();
			sb.append(tourDepVO.getNumDays() + "Days " + tourDepVO.getNumNights() + "Nights ");
			if (!StringUtils.isEmpty(tourPkgVO.getNameEn())) sb.append(tourPkgVO.getNameEn());
			if (!StringUtils.isEmpty(tourPkgVO.getNameZh())) sb.append(" " + tourPkgVO.getNameZh());
			if (!StringUtils.isEmpty(tourPkgVO.getNameOther())) sb.append(" " + tourPkgVO.getNameOther());
			if (!StringUtils.isEmpty(tourDepVO.getDesc())) sb.append(" [" + tourDepVO.getDesc() + "]");
			invVO.setSubjLine(sb.toString());
			if (StringUtils.isNotEmpty(tourDepVO.getLangCode())) {
				invVO.setSubjLine(invVO.getSubjLine() + " [" +
					LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_PRODUCT_LANG, tourDepVO.getLangCode()) +
				"]");
			}

			/*for (String orderType : SalesConstant.BOOKING_ORDER_TYPE_TFAIR_SP) {
				if (vo.getOrderTypeCd().startsWith(orderType)) {
					invVO.setTfairSalerId(vo.getIdSalerTfair());
					break;
				}
			}*/
			invVO.setTfairSalerId(vo.getIdSalerTfair());
			invVO.setInvoiceItemList(new ArrayList<InvoiceItemVO>());
			for (BookingChargeItemVO itemVO : vo.getBookingChargeItemList()) {

				if (ProductConstant.TYPE_CRUISE.equals(vo.getTypeCd())) {
					InvoiceItemVO invItemVO = new InvoiceItemVO();
					invItemVO.setAcctId(itemVO.getIdAcct());
					invItemVO.setInvEOItemId(itemVO.getIdInvEoItem());
					invItemVO.setInvItemCd(itemVO.getCode());
					invItemVO.setItemCode(itemVO.getCode());
					invItemVO.setDesc(itemVO.getDesc());
					invItemVO.setQty(itemVO.getQuantity());
					invItemVO.setUnitPrice(itemVO.getAmount());
					invItemVO.setAmount((new BigDecimal(String.valueOf(itemVO.getAmount())))
							.multiply(new BigDecimal(String.valueOf(itemVO.getQuantity()))).doubleValue());
					invItemVO.setTaxAmount(0.00);
					if (isGSTPeriod) {
						for (TourDepItemVO tourDepItemVO : tourDepItemVOList) {
							if (tourDepItemVO.getCode().equals(itemVO.getCode())) {
								invItemVO.setTaxCode(tourDepItemVO.getTaxCode());
								invItemVO.setTaxRate(tourDepItemVO.getTaxRate());
								tourDepItemVOList.remove(tourDepItemVO);
								break;
							}
						}
					} else {
						invItemVO.setTaxCode(null);
						invItemVO.setTaxRate(null);
					}

					if (itemVO.getCabinQty() > 0 && ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(itemVO.getTypeCd())) {
						InvoiceItemVO cabinItemVO = new InvoiceItemVO();
						if (itemVO.getQuantity() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_TWN);
							cabinItemVO.setQty(itemVO.getQuantity());
							cabinItemVO.setUnitPrice(itemVO.getAmount());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity3() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_3RD);
							cabinItemVO.setQty(itemVO.getQuantity3());
							cabinItemVO.setUnitPrice(itemVO.getAmount3());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity4() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_4TH);
							cabinItemVO.setQty(itemVO.getQuantity4());
							cabinItemVO.setUnitPrice(itemVO.getAmount4());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantitySgl() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_SGL);
							cabinItemVO.setQty(itemVO.getQuantitySgl());
							cabinItemVO.setUnitPrice(itemVO.getAmountSgl());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity3Chd() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_3RD_CHD);
							cabinItemVO.setQty(itemVO.getQuantity3Chd());
							cabinItemVO.setUnitPrice(itemVO.getAmount3Chd());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity4Chd() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_4TH_CHD);
							cabinItemVO.setQty(itemVO.getQuantity4Chd());
							cabinItemVO.setUnitPrice(itemVO.getAmount4Chd());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantityInf() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_INFT);
							cabinItemVO.setQty(itemVO.getQuantityInf());
							cabinItemVO.setUnitPrice(itemVO.getAmountInf());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
					} else if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0
							&& ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE.equals(itemVO.getTypeCd())) {
						CruiseScheduleVO vvvo = cruiseBO
								.getCruiseSchedule(tourPkgBO.getTourDepById(vo.getIdTourDep()));
						if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_PORT_CHARGES))
							invItemVO.setShowInInv(!vvvo.isSumAmtApt());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_APT_ADT))
							invItemVO.setShowInInv(!vvvo.isSumAmtApt());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_APT_CHD))
							invItemVO.setShowInInv(!vvvo.isSumAmtApt());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_FUEL_ADT))
							invItemVO.setShowInInv(!vvvo.isSumAmtFuel());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_FUEL_CHD))
							invItemVO.setShowInInv(!vvvo.isSumAmtFuel());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_DEVIATION))
							invItemVO.setShowInInv(!vvvo.isSumAmtDeviation());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_TRVL_INS))
							invItemVO.setShowInInv(!vvvo.isSumAmtTrvlIns());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_VISA))
							invItemVO.setShowInInv(!vvvo.isSumAmtVisa());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_AC))
							invItemVO.setShowInInv(!vvvo.isSumAmtAC());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_TIPPING))
							invItemVO.setShowInInv(!vvvo.isSumAmtTipping());
						else {
							TourDepItemVO tdi = tourPkgBO.getTourDepItem(vo.getIdTourDep(),
									itemVO.getCode(), getSessionInfoBean().getCompanyVO());
							if (tdi == null) {
								invItemVO.setShowInInv(false);
							} else {
								invItemVO.setShowInInv(tdi.isShowInInv());
							}
						}
						invVO.getInvoiceItemList().add(invItemVO);
					} else if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0
							&& ProductConstant.TOUR_DEP_ITM_TYPE_TOTAL_MISC_CHARGE.equals(itemVO.getTypeCd())) {
						CruiseScheduleVO vvvo = cruiseBO
								.getCruiseSchedule(tourPkgBO.getTourDepById(vo.getIdTourDep()));
						invItemVO.setDesc(vvvo.getGroupingChargeLabel());
						invItemVO.setShowInInv(true);
						invVO.getInvoiceItemList().add(invItemVO);
					}
				} else {
					if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0) {
						InvoiceItemVO invItemVO = new InvoiceItemVO();
						invItemVO.setAcctId(itemVO.getIdAcct());
						invItemVO.setInvEOItemId(itemVO.getIdInvEoItem());
						invItemVO.setInvItemCd(itemVO.getCode());
						invItemVO.setCode(itemVO.getCode());
						invItemVO.setDesc(itemVO.getDesc());
						if(itemVO.getIsLock() != null) invItemVO.setIsLock(itemVO.getIsLock()); else invItemVO.setIsLock(false);
						invItemVO.setQty(itemVO.getQuantity());
						invItemVO.setUnitPrice(itemVO.getAmount());
						invItemVO.setAirfare(itemVO.getAirfare());
						//invItemVO.setAmount(itemVO.getAmount() * itemVO.getQuantity());
						invItemVO.setAmount((new BigDecimal(String.valueOf(itemVO.getAmount()))).multiply(new BigDecimal(String.valueOf(itemVO.getQuantity()))).doubleValue());
						invItemVO.setTaxAmount(0.00);
						if (isGSTPeriod) {
							for (TourDepItemVO tourDepItemVO : tourDepItemVOList) {
								if (tourDepItemVO.getCode().equals(itemVO.getCode())) {
									invItemVO.setTaxCode(tourDepItemVO.getTaxCode());
									invItemVO.setTaxRate(tourDepItemVO.getTaxRate());
									tourDepItemVOList.remove(tourDepItemVO);
									break;
								}
							}
						} else {
							invItemVO.setTaxCode(null);
							invItemVO.setTaxRate(null);
						}

						invVO.getInvoiceItemList().add(invItemVO);
					}
				}
			}
			// send redirect
			sendRedirect("bookingId", vo.getId(), invVO, URL_SALES_INV);

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	/**
	 * Make payment
	 */
	public void makePayment_eInvoice(BookingVO vo) {
		try {
			List<TourDepItemVO> tourDepItemVOList = tourPkgBO.getTourDepItemList(tourDepVO.getId(), getSessionInfoBean().getCompanyVO().getId());
			boolean isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), new Date());

			InvoiceVO invVO = new InvoiceVO();
			invVO.setInvoiceDt(new Date());
			invVO.setCustomerId(vo.getIdCust());
			invVO.setBookingId(vo.getId());
			invVO.setTourCd(tourDepVO.getCode());
			invVO.setTourDepId(tourDepVO.getId());
			invVO.setSubjLine(tourDepVO.getDesc());
			invVO.setDepartureDt(tourDepVO.getDtDep());
			invVO.setOrderCd(vo.getOrderTypeCd());
			if (ProductConstant.TYPE_CRUISE.equals(vo.getTypeCd())) {
				invVO.setCatCd(CommonConstant.LOOKUP_ITM_INV_CAT_CRUISE);
			} else {
				invVO.setCatCd(CommonConstant.LOOKUP_ITM_INV_CAT_TOUR);
			}
			invVO.setSalerId(vo.getIdEmployee());
			invVO.setSalerName(vo.getEmployeeViewVO().getUserVO().getName());
			StringBuilder sb = new StringBuilder();
			sb.append(tourDepVO.getNumDays() + "Days " + tourDepVO.getNumNights() + "Nights ");
			if (!StringUtils.isEmpty(tourPkgVO.getNameEn())) sb.append(tourPkgVO.getNameEn());
			if (!StringUtils.isEmpty(tourPkgVO.getNameZh())) sb.append(" " + tourPkgVO.getNameZh());
			if (!StringUtils.isEmpty(tourPkgVO.getNameOther())) sb.append(" " + tourPkgVO.getNameOther());
			if (!StringUtils.isEmpty(tourDepVO.getDesc())) sb.append(" [" + tourDepVO.getDesc() + "]");
			invVO.setSubjLine(sb.toString());
			if (StringUtils.isNotEmpty(tourDepVO.getLangCode())) {
				invVO.setSubjLine(invVO.getSubjLine() + " [" +
					LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_PRODUCT_LANG, tourDepVO.getLangCode()) +
				"]");
			}

			/*for (String orderType : SalesConstant.BOOKING_ORDER_TYPE_TFAIR_SP) {
				if (vo.getOrderTypeCd().startsWith(orderType)) {
					invVO.setTfairSalerId(vo.getIdSalerTfair());
					break;
				}
			}*/
			invVO.setTfairSalerId(vo.getIdSalerTfair());
			invVO.setInvoiceItemList(new ArrayList<InvoiceItemVO>());
			for (BookingChargeItemVO itemVO : vo.getBookingChargeItemList()) {

				if (ProductConstant.TYPE_CRUISE.equals(vo.getTypeCd())) {
					InvoiceItemVO invItemVO = new InvoiceItemVO();
					invItemVO.setAcctId(itemVO.getIdAcct());
					invItemVO.setInvEOItemId(itemVO.getIdInvEoItem());
					invItemVO.setInvItemCd(itemVO.getCode());
					invItemVO.setItemCode(itemVO.getCode());
					invItemVO.setDesc(itemVO.getDesc());
					invItemVO.setQty(itemVO.getQuantity());
					invItemVO.setUnitPrice(itemVO.getAmount());
					invItemVO.setAmount((new BigDecimal(String.valueOf(itemVO.getAmount())))
							.multiply(new BigDecimal(String.valueOf(itemVO.getQuantity()))).doubleValue());
					invItemVO.setTaxAmount(0.00);
					if (isGSTPeriod) {
						for (TourDepItemVO tourDepItemVO : tourDepItemVOList) {
							if (tourDepItemVO.getCode().equals(itemVO.getCode())) {
								invItemVO.setTaxCode(tourDepItemVO.getTaxCode());
								invItemVO.setTaxRate(tourDepItemVO.getTaxRate());
								tourDepItemVOList.remove(tourDepItemVO);
								break;
							}
						}
					} else {
						invItemVO.setTaxCode(null);
						invItemVO.setTaxRate(null);
					}

					if (itemVO.getCabinQty() > 0 && ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(itemVO.getTypeCd())) {
						InvoiceItemVO cabinItemVO = new InvoiceItemVO();
						if (itemVO.getQuantity() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_TWN);
							cabinItemVO.setQty(itemVO.getQuantity());
							cabinItemVO.setUnitPrice(itemVO.getAmount());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity3() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_3RD);
							cabinItemVO.setQty(itemVO.getQuantity3());
							cabinItemVO.setUnitPrice(itemVO.getAmount3());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity4() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_4TH);
							cabinItemVO.setQty(itemVO.getQuantity4());
							cabinItemVO.setUnitPrice(itemVO.getAmount4());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantitySgl() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_SGL);
							cabinItemVO.setQty(itemVO.getQuantitySgl());
							cabinItemVO.setUnitPrice(itemVO.getAmountSgl());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity3Chd() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_3RD_CHD);
							cabinItemVO.setQty(itemVO.getQuantity3Chd());
							cabinItemVO.setUnitPrice(itemVO.getAmount3Chd());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity4Chd() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_4TH_CHD);
							cabinItemVO.setQty(itemVO.getQuantity4Chd());
							cabinItemVO.setUnitPrice(itemVO.getAmount4Chd());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantityInf() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_INFT);
							cabinItemVO.setQty(itemVO.getQuantityInf());
							cabinItemVO.setUnitPrice(itemVO.getAmountInf());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
					} else if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0
							&& ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE.equals(itemVO.getTypeCd())) {
						CruiseScheduleVO vvvo = cruiseBO
								.getCruiseSchedule(tourPkgBO.getTourDepById(vo.getIdTourDep()));
						if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_PORT_CHARGES))
							invItemVO.setShowInInv(!vvvo.isSumAmtApt());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_APT_ADT))
							invItemVO.setShowInInv(!vvvo.isSumAmtApt());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_APT_CHD))
							invItemVO.setShowInInv(!vvvo.isSumAmtApt());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_FUEL_ADT))
							invItemVO.setShowInInv(!vvvo.isSumAmtFuel());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_FUEL_CHD))
							invItemVO.setShowInInv(!vvvo.isSumAmtFuel());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_DEVIATION))
							invItemVO.setShowInInv(!vvvo.isSumAmtDeviation());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_TRVL_INS))
							invItemVO.setShowInInv(!vvvo.isSumAmtTrvlIns());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_VISA))
							invItemVO.setShowInInv(!vvvo.isSumAmtVisa());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_AC))
							invItemVO.setShowInInv(!vvvo.isSumAmtAC());
						else if (itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_TIPPING))
							invItemVO.setShowInInv(!vvvo.isSumAmtTipping());
						else {
							TourDepItemVO tdi = tourPkgBO.getTourDepItem(vo.getIdTourDep(),
									itemVO.getCode(), getSessionInfoBean().getCompanyVO());
							if (tdi == null) {
								invItemVO.setShowInInv(false);
							} else {
								invItemVO.setShowInInv(tdi.isShowInInv());
							}
						}
						invVO.getInvoiceItemList().add(invItemVO);
					} else if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0
							&& ProductConstant.TOUR_DEP_ITM_TYPE_TOTAL_MISC_CHARGE.equals(itemVO.getTypeCd())) {
						CruiseScheduleVO vvvo = cruiseBO
								.getCruiseSchedule(tourPkgBO.getTourDepById(vo.getIdTourDep()));
						invItemVO.setDesc(vvvo.getGroupingChargeLabel());
						invItemVO.setShowInInv(true);
						invVO.getInvoiceItemList().add(invItemVO);
					}
				} else {
					if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0) {
						InvoiceItemVO invItemVO = new InvoiceItemVO();
						invItemVO.setAcctId(itemVO.getIdAcct());
						invItemVO.setInvEOItemId(itemVO.getIdInvEoItem());
						invItemVO.setInvItemCd(itemVO.getCode());
						invItemVO.setCode(itemVO.getCode());
						invItemVO.setDesc(itemVO.getDesc());
						if(itemVO.getIsLock() != null) invItemVO.setIsLock(itemVO.getIsLock()); else invItemVO.setIsLock(false);
						invItemVO.setQty(itemVO.getQuantity());
						invItemVO.setUnitPrice(itemVO.getAmount());
						invItemVO.setAirfare(itemVO.getAirfare());
						//invItemVO.setAmount(itemVO.getAmount() * itemVO.getQuantity());
						invItemVO.setAmount((new BigDecimal(String.valueOf(itemVO.getAmount()))).multiply(new BigDecimal(String.valueOf(itemVO.getQuantity()))).doubleValue());
						invItemVO.setTaxAmount(0.00);
						if (isGSTPeriod) {
							for (TourDepItemVO tourDepItemVO : tourDepItemVOList) {
								if (tourDepItemVO.getCode().equals(itemVO.getCode())) {
									invItemVO.setTaxCode(tourDepItemVO.getTaxCode());
									invItemVO.setTaxRate(tourDepItemVO.getTaxRate());
									tourDepItemVOList.remove(tourDepItemVO);
									break;
								}
							}
						} else {
							invItemVO.setTaxCode(null);
							invItemVO.setTaxRate(null);
						}

						invVO.getInvoiceItemList().add(invItemVO);
					}
				}
			}

			// Booking search existed invoice if created date before 2025-01-01 go for invoice else pax statement
			InvoiceVO existedInvVO = invoiceBO.getInvoice(vo.getId());
			if (existedInvVO != null) {
		        if (DatesUtils.isDateLessOrEqual(existedInvVO.getCreatedDate(), sdf.parse("2024-12-31"))) {
		        	sendRedirect("bookingId", vo.getId(), invVO, URL_SALES_INV);
		        } else {
		        	sendRedirect("bookingId", vo.getId(), invVO, URL_SALES_PAX_STATEMENT);
		        }
			} else {
				sendRedirect("bookingId", vo.getId(), invVO, URL_SALES_PAX_STATEMENT);
			}

			// send redirect
//			sendRedirect("bookingId", vo.getId(), invVO, URL_SALES_PAX_STATEMENT);

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	/**
	 * Make payment at booking list
	 */
	public void makeBookingPayment(BookingViewVO vo) {

		try {
			BookingViewVO vvo = bookingBO.getBookingView(vo.getId());
			vvo.getTourDepViewVO().setTourDepItemList(tourPkgBO.getTourDepItemList(vvo.getTourDepViewVO().getId()));

			List<TourDepItemVO> tourDepItemVOList = tourPkgBO.getTourDepItemList(vvo.getTourDepViewVO().getId(), getSessionInfoBean().getCompanyVO().getId());
			boolean isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), new Date());

			InvoiceVO invVO = new InvoiceVO();
			invVO.setInvoiceDt(new Date());
			invVO.setCustomerId(vvo.getIdCust());
			invVO.setBookingId(vvo.getId());
			invVO.setTourCd(vvo.getTourDepViewVO().getCode());
			invVO.setTourDepId(vvo.getTourDepViewVO().getId());
			invVO.setSubjLine(vvo.getTourDepViewVO().getDesc());
			invVO.setDepartureDt(vvo.getTourDepViewVO().getDtDep());
			invVO.setOrderCd(vvo.getOrderTypeCd());
			if (ProductConstant.TYPE_CRUISE.equals(vvo.getTypeCd())) {
				invVO.setCatCd(CommonConstant.LOOKUP_ITM_INV_CAT_CRUISE);
			} else {
				invVO.setCatCd(CommonConstant.LOOKUP_ITM_INV_CAT_TOUR);
			}

			invVO.setSalerId(vvo.getEmployeeViewVO().getId());
			invVO.setSalerName(vvo.getEmployeeViewVO().getUserVO().getName());
