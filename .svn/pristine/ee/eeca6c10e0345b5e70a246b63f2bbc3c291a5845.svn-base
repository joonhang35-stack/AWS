	/**
	 * @return the bookingVO
	 */
	public BookingVO getBookingVO() {
		return bookingVO;
	}

	/**
	 * @param bookingVO the bookingVO to set
	 */
	public void setBookingVO(BookingVO vo) throws BusinessException {
		BookingViewVO bookingViewVO = bookingBO.getBookingView(vo.getId());
		bookingViewVO.setBookingChargeItemList(new ArrayList<BookingChargeItemVO>(bookingViewVO.getBookingChargeItemSet()));
		bookingViewVO.setInvoiceVO(invoiceBO.getInvoice(bookingViewVO.getId()));
		bookingViewVO.setCustomerVO(customerBO.getCustomer(bookingViewVO.getIdCust()));

		bookingVO = (BookingVO) bookingViewVO.clone();
		if (bookingVO.getIdEmployee() == null && bookingViewVO.getEmployeeViewVO() != null) {
			bookingVO.setIdEmployee(bookingViewVO.getEmployeeViewVO().getId());
		}
		bookingVO.setIdSurveyList(bookingBO.getSurveyList(bookingVO.getId()));

		tourDepVO = (TourDepartureVO) bookingViewVO.getTourDepViewVO().clone();
		tourPkgVO = (TourPackageVO) bookingViewVO.getTourDepViewVO().getTourPkgVO().clone();
		bookingVO.setTourDepVO(tourDepVO);

		setSalesPersonEmployeeView();

		StringBuilder name = new StringBuilder();

		if (tourPkgVO.getTypeCd().equals("CRUISE")) {
			if (StringUtils.isNotBlank(bookingVO.getCustomerVO().getPersonVO().getSalutation())) {
				name.append(LookupItemUtils.getLookupItemDesc("salutatn", bookingVO.getCustomerVO().getPersonVO().getSalutation()))
					.append(" ").append(bookingVO.getCustomerVO().getPersonVO().getLastName()).append(" ").append(bookingVO.getCustomerVO().getPersonVO().getGivenName());
			} else {
				name.append(bookingVO.getCustomerVO().getPersonVO().getLastName()).append(" ").append(bookingVO.getCustomerVO().getPersonVO().getGivenName());
			}

			tourPkgBO.setCruiseMiscAdtChd(tourDepVO, null, bookingVO);
		} else {
			name.append(LookupItemUtils.getLookupItemDesc("salutatn", bookingVO.getCustomerVO().getPersonVO().getSalutation())).append(" ").append(bookingVO.getCustomerVO().getPersonVO().getLastName() + " " + bookingVO.getCustomerVO().getPersonVO().getGivenName());

			tourPkgBO.setMiscAdtChd(tourDepVO, null, bookingVO);
		}

		int count = 1;
		for (BookingChargeItemVO itemVO : bookingVO.getBookingChargeItemList()) {
			if (StringUtils.equals(ProductConstant.TOUR_DEP_ITM_CD_DISC, itemVO.getCode())) {
				if (count == 1) {
					bookingVO.setDiscount1(itemVO.getAmount() < 0 ? (itemVO.getAmount() * -1) : itemVO.getAmount());
					bookingVO.setDiscountPax1(itemVO.getQuantity());
					count++;
				} else if (count == 2) {
					bookingVO.setDiscount2(itemVO.getAmount() < 0 ? (itemVO.getAmount() * -1) : itemVO.getAmount());
					bookingVO.setDiscountPax2(itemVO.getQuantity());
				}
			}
		}
		custDetailsVO = new CustDetailsVO();
		custDetailsVO.setContPersonName(name.toString());
		// keep previous booking pax
		bakBookingVO = (BookingVO) bookingVO.clone();
		bookBoolean.setUpd(true);
		// query employee list
		employeeList = userBO.getEmployeeViewList(getSessionInfoBean().getCompanyVO().getId(), null);
		setEnableBlackListed(false);
	}

