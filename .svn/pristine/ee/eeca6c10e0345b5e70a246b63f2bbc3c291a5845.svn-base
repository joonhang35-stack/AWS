	/**
	 * @return the bookingViewVO
	 */
	public BookingViewVO getBookingViewVO() {
		return bookingViewVO;
	}

	/**
	 * @param bookingViewVO the bookingViewVO to set
	 */
	public void setBookingViewVO(BookingViewVO bookingViewVO) {
		try {
			BookingViewVO vo = bookingBO.getBookingView(bookingViewVO.getId());
			vo.setBookingChargeItemList(new ArrayList<BookingChargeItemVO>(vo.getBookingChargeItemSet()));
			vo.setInvoiceVO(invoiceBO.getInvoice(vo.getId()));
			vo.setCustomerVO(customerBO.getCustomer(vo.getIdCust()));
			this.bookingViewVO = vo;
			bookingVO = (BookingVO) vo.clone();
			tourDepVO = (TourDepartureVO) vo.getTourDepViewVO().clone();
			tourPkgVO = (TourPackageVO) vo.getTourDepViewVO().getTourPkgVO().clone();

			bookingVO.setIdSurveyList(new ArrayList<String>(bookingBO.getSurveyList(bookingVO.getId())));
			int count = 1, totalDiscountPax = 0;
			for (BookingChargeItemVO itemVO : bookingVO.getBookingChargeItemList()) {
				if (itemVO.getCode().startsWith(ProductConstant.TOUR_DEP_ITM_CD_DISC)) {
					if (count == 1) {
						bookingVO.setDiscount1(itemVO.getAmount() < 0 ? (itemVO.getAmount() * -1) : itemVO.getAmount());
						bookingVO.setDiscountPax1(itemVO.getQuantity());
						totalDiscountPax += itemVO.getQuantity();
						count++;
					} else if (count == 2) {
						bookingVO.setDiscount2(itemVO.getAmount() < 0 ? (itemVO.getAmount() * -1) : itemVO.getAmount());
						bookingVO.setDiscountPax2(itemVO.getQuantity());
						totalDiscountPax += itemVO.getQuantity();
					}
				}
			}

			bookingVO.setNotEntitledDiscountPax(bookingVO.getQuantity() - totalDiscountPax);

			bookBoolean = new BooleanAddUpdDelVO(false, true, false);
			bakBookingVO = (BookingVO) bookingVO.clone();
			fromBookingPage = true;

			if (vo.getEmployeeViewVO() != null) {
				bookingVO.setIdEmployee(vo.getEmployeeViewVO().getId());
			}
			bookingVO.setIdTourDep(tourDepVO.getId());

			setSalesPersonEmployeeView();

			StringBuilder name = new StringBuilder();
			if (StringUtils.isNotBlank(bookingVO.getCustomerVO().getPersonVO().getSalutation()))
				name.append(LookupItemUtils.getLookupItemDesc("salutatn", bookingVO.getCustomerVO().getPersonVO().getSalutation()))
					.append(" ").append(bookingVO.getCustomerVO().getPersonVO().getLastName()).append(" ").append(bookingVO.getCustomerVO().getPersonVO().getGivenName());
			else
				name.append(bookingVO.getCustomerVO().getPersonVO().getLastName()).append(" ").append(bookingVO.getCustomerVO().getPersonVO().getGivenName());

			personContactVO = new PersonContactVO();
			identityVO = new IdentityVO();
			customerVO = new CustomerVO();
			customerVO.setPersonContactList(new ArrayList<PersonContactVO>());
			customerVO.setIdentityList(new ArrayList<IdentityVO>());
			customerVO.setPersonVO(new PersonVO());
			custDetailsVO = new CustDetailsVO();
			custDetailsVO.setContPersonName(name.toString());

			if (tourPkgVO.getTypeCd().equals("CRUISE")) {
				tourPkgBO.setCruiseMiscAdtChd(tourDepVO, null, bookingVO);
			} else {
				tourPkgBO.setMiscAdtChd(tourDepVO, null, bookingVO);
			}
			// query employee list
			employeeList = userBO.getEmployeeViewList(getSessionInfoBean().getCompanyVO().getId(), null);
			setEnableBlackListed(false);
		} catch (Throwable t) {
			errorResult(t);
		}
	}

	public void showBookingVO(BookingVO thisBookingVO) {
		try {
//			BookingViewVO vo = bookingBO.getBookingView(bookingViewVO.getId());
			bookingVO = bookingBO.getBooking(thisBookingVO.getId());

			bookingVO.setBookingChargeItemList(new ArrayList<BookingChargeItemVO>(bookingVO.getBookingChargeItemSet()));
			bookingVO.setInvoiceVO(invoiceBO.getInvoice(bookingVO.getId()));
			bookingVO.setCustomerVO(customerBO.getCustomer(bookingVO.getIdCust()));
			tourDepVO = tourPkgBO.getTourDepById(bookingVO.getIdTourDep());
			tourPkgVO = tourPkgBO.getTourPackageById(tourDepVO.getIdTourPkg());
			bookingVO.setTourDepVO(tourDepVO);
			bookingVO.setTourPkgVO(tourPkgVO);

			bookingVO.setIdSurveyList(new ArrayList<String>(bookingBO.getSurveyList(bookingVO.getId())));
			int count = 1, totalDiscountPax = 0;
			for (BookingChargeItemVO itemVO : bookingVO.getBookingChargeItemList()) {
				if (itemVO.getCode().startsWith(ProductConstant.TOUR_DEP_ITM_CD_DISC)) {
					if (count == 1) {
						bookingVO.setDiscount1(itemVO.getAmount() < 0 ? (itemVO.getAmount() * -1) : itemVO.getAmount());
						bookingVO.setDiscountPax1(itemVO.getQuantity());
						totalDiscountPax += itemVO.getQuantity();
						count++;
					} else if (count == 2) {
						bookingVO.setDiscount2(itemVO.getAmount() < 0 ? (itemVO.getAmount() * -1) : itemVO.getAmount());
						bookingVO.setDiscountPax2(itemVO.getQuantity());
						totalDiscountPax += itemVO.getQuantity();
					}
				}
			}

			bookingVO.setNotEntitledDiscountPax(bookingVO.getQuantity() - totalDiscountPax);

			bookBoolean = new BooleanAddUpdDelVO(false, true, false);
			bakBookingVO = (BookingVO) bookingVO.clone();
			fromBookingPage = true;

			bookingVO.setIdEmployee(bookingVO.getIdEmployee());
			bookingVO.setIdTourDep(tourDepVO.getId());

			setSalesPersonEmployeeView();

			StringBuilder name = new StringBuilder();
			if (StringUtils.isNotBlank(bookingVO.getCustomerVO().getPersonVO().getSalutation()))
				name.append(LookupItemUtils.getLookupItemDesc("salutatn", bookingVO.getCustomerVO().getPersonVO().getSalutation()))
					.append(" ").append(bookingVO.getCustomerVO().getPersonVO().getLastName()).append(" ").append(bookingVO.getCustomerVO().getPersonVO().getGivenName());
			else
				name.append(bookingVO.getCustomerVO().getPersonVO().getLastName()).append(" ").append(bookingVO.getCustomerVO().getPersonVO().getGivenName());

			personContactVO = new PersonContactVO();
			identityVO = new IdentityVO();
			customerVO = new CustomerVO();
			customerVO.setPersonContactList(new ArrayList<PersonContactVO>());
			customerVO.setIdentityList(new ArrayList<IdentityVO>());
			customerVO.setPersonVO(new PersonVO());
			custDetailsVO = new CustDetailsVO();
			custDetailsVO.setContPersonName(name.toString());

			if (tourPkgVO.getTypeCd().equals("CRUISE")) {
				tourPkgBO.setCruiseMiscAdtChd(tourDepVO, null, bookingVO);
			} else {
				tourPkgBO.setMiscAdtChd(tourDepVO, null, bookingVO);
			}
			// query employee list
			employeeList = userBO.getEmployeeViewList(getSessionInfoBean().getCompanyVO().getId(), null);

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

