	public void handleDepFromDateSelect() {
		Calendar cal = Calendar.getInstance();
		cal.setTime(searchTourDep.getFromDate());
		cal.set(Calendar.DATE, cal.getActualMaximum(Calendar.DAY_OF_MONTH));
		searchTourDep.setToDate(cal.getTime());
	}

	/**
	 * Get expired date
	 * @param date
	 * @return
	 */
	public Date getExpiredDate(BookingViewVO vo) {
		try {
			Calendar cal = Calendar.getInstance();
			cal.setTime(vo.getCreatedDate());
			if (SalesConstant.BOOKING_PMNT_STATUS_KIV.equals(vo.getPmntStatusCd()) || SalesConstant.BOOKING_PMNT_STATUS_KIVEXP.equals(vo.getPmntStatusCd())) {
				cal.add(Calendar.DAY_OF_MONTH, Integer.parseInt(LookupItemUtils.getGlobalConfigValue(MaintConstant.GLOBAL_CD_GLOBAL, MaintConstant.GLOBAL_CD_KIV_EXP)));
				return cal.getTime();

			} else if (SalesConstant.BOOKING_PMNT_STATUS_DEPOSIT.equals(vo.getPmntStatusCd())) {
				cal.add(Calendar.DAY_OF_MONTH, Integer.parseInt(LookupItemUtils.getGlobalConfigValue(MaintConstant.GLOBAL_CD_GLOBAL, MaintConstant.GLOBAL_CD_PAID_EXP)));
				return cal.getTime();

			} else return null;

		} catch (Throwable t) {
			errorResult(t);
		}
		return null;
	}

	public String getCalculatedAmount(TourDepartureVO vo) {
		double discountAmt = 0.0;
		int discountPax = 0;

		if (vo.getDiscountPax1() > 0) {
			discountAmt = vo.getDiscount1();
			discountPax = vo.getDiscountPax1();
		} else if (vo.getDiscountPax2() > 0) {
			discountAmt = vo.getDiscount2();
			discountPax = vo.getDiscountPax2();
		}

		StringBuilder totalAmtStr = new StringBuilder();
		totalAmtStr.append("TWN=");
		totalAmtStr.append(calculateFullTourAmt(vo.getFullTwn() + vo.getMiscAdt(), discountAmt));
		if (discountPax > 0) totalAmtStr.append(" (" + discountPax + ")");
		totalAmtStr.append("      ");

		totalAmtStr.append("SGL=");
		totalAmtStr.append(calculateFullTourAmt(vo.getFullSgl() + vo.getMiscAdt(), discountAmt));
		if (discountPax > 0) totalAmtStr.append(" (" + discountPax + ")");
		totalAmtStr.append("      ");

		totalAmtStr.append("CTW=");
		totalAmtStr.append(calculateFullTourAmt(vo.getFullCtw() + vo.getMiscChd(), discountAmt));
		if (discountPax > 0) totalAmtStr.append(" (" + discountPax + ")");
		totalAmtStr.append("\n");

		totalAmtStr.append("CWB=");
		totalAmtStr.append(calculateFullTourAmt(vo.getFullCeb() + vo.getMiscChd(), discountAmt));
		if (discountPax > 0) totalAmtStr.append(" (" + discountPax + ")");
		totalAmtStr.append("      ");

		totalAmtStr.append("CNB=");
		totalAmtStr.append(calculateFullTourAmt(vo.getFullCnb() + vo.getMiscChd(), discountAmt));
		if (discountPax > 0) totalAmtStr.append(" (" + discountPax + ")");
		return totalAmtStr.toString();
	}

	private String calculateFullTourAmt(Double fullTourAmt, Double discount) {
		String pattern = "";

		fullTourAmt = fullTourAmt - discount;

		if (fullTourAmt < 0) fullTourAmt = 0.0;

		if (fullTourAmt % 1 > 0) pattern = "#,##0.00";
		else pattern = "#,##0";

		return getDoubleDecimalFormat(pattern, fullTourAmt);
	}

	public void calQuoteAmt(InvoiceVO invVO, BookingVO bookingVO, boolean updateItemAmount) {
		try {

//			System.out.println("CYY bookingVO.getIdTourDep():" + bookingVO.getIdTourDep());
			if (updateItemAmount) {
				calculateBookingItemsAmount(bookingVO.getBookingChargeItemList());
				updateItemAmount = false;
			}

			if (invVO.getCatCd() != null && invVO.getCatCd().equals(CommonConstant.LOOKUP_ITM_INV_CAT_CRUISE)) {
				populateCruiseInvoiceItem(invVO, bookingVO);
			}
			else {
				populateInvoiceItem(invVO, bookingVO);
			}


			AmountCalcViewVO amtCalcViewVO = new AmountCalcViewVO();
			if (invVO.getIsIncludeSST()) {
				amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(new AmountCalcViewVO(), updateItemAmount,
						invVO.getInvoiceItemList(), invVO.getInvoicePaymentList(), false, 8.00);
			} else {
				amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(new AmountCalcViewVO(), updateItemAmount,
						invVO.getInvoiceItemList(), invVO.getInvoicePaymentList(), false);
			}

			invVO.setTaxAmt(amtCalcViewVO.getTotalTax().doubleValue());
			invVO.setTaxIncAmt(amtCalcViewVO.getTotalAmountIncludeTax().doubleValue());
			invVO.setRoundingAmt(amtCalcViewVO.getTotalRounding().doubleValue());
			invVO.setAmount(amtCalcViewVO.getTotalAmountAfterRounding().doubleValue());
			invVO.setAmtPaid(amtCalcViewVO.getTotalAmountPaid().doubleValue());
			invVO.setBalance(amtCalcViewVO.getTotalAmountAfterRounding().subtract(amtCalcViewVO.getTotalAmountPaid())
					.doubleValue());

			BigDecimal taxAmt = new BigDecimal(String.valueOf(invVO.getTaxAmt()));
			BigDecimal taxIncAmt = new BigDecimal(String.valueOf(invVO.getTaxIncAmt()));
			BigDecimal taxExcAmt = taxIncAmt.subtract(taxAmt);
			invVO.setTaxExcAmt(taxExcAmt.doubleValue());

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	private void calculateBookingItemsAmount(List<BookingChargeItemVO> bookingChargeItemList) throws BusinessException {
		// Manual update the item Amount here
		for (BookingChargeItemVO vo : bookingChargeItemList) {
			BigDecimal qty = new BigDecimal(String.valueOf(vo.getQuantity()));
			BigDecimal unitPrice = new BigDecimal(String.valueOf(vo.getAmount()));
			BigDecimal totalPriceIncGST = unitPrice.multiply(qty);
			vo.setTtlAmt(totalPriceIncGST.doubleValue());
			if (vo.getQuantity() == 0 || vo.getAmount() == 0.00) {
				vo.setAmount(0.00);
			}
		}
	}

	public void populateCruiseInvoiceItem(InvoiceVO invVO, BookingVO bookingVO) {

//		System.out.println("makeBookingPayment");

		try {
//			bookingVO.getTourDepViewVO().setTourDepItemList(tourPkgBO.getTourDepItemList(bookingVO.getTourDepViewVO().getId()));
//
			List<TourDepItemVO> tourDepItemVOList = new ArrayList<TourDepItemVO>() ;

			if (bookingVO.getIdTourDep() != null) {
				tourPkgBO.getTourDepItemList(bookingVO.getIdTourDep(), getSessionInfoBean().getCompanyVO().getId());
			}
			boolean isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), new Date());

//			List<InvoiceItemVO> invoiceItemList = new ArrayList<InvoiceItemVO>();

			invVO.setInvoiceItemList(new ArrayList<InvoiceItemVO>());
			for (BookingChargeItemVO itemVO : bookingVO.getBookingChargeItemList()) {
				if (ProductConstant.TYPE_CRUISE.equals(bookingVO.getTypeCd())) {
					InvoiceItemVO invItemVO = new InvoiceItemVO();
					invItemVO.setAcctId(itemVO.getIdAcct());
					invItemVO.setInvEOItemId(itemVO.getIdInvEoItem());
					invItemVO.setInvItemCd(itemVO.getCode());
					invItemVO.setItemCode(itemVO.getCode());
					invItemVO.setDesc(itemVO.getDesc());
					invItemVO.setQty(itemVO.getQuantity());
					invItemVO.setUnitPrice(itemVO.getAmount());
//					invItemVO.setPackageType(getInvoicePackageType(itemVO.getCode()));
					invItemVO.setAmount((new BigDecimal(String.valueOf(itemVO.getAmount())))
							.multiply(new BigDecimal(String.valueOf(itemVO.getQuantity()))).doubleValue());
					invItemVO.setTaxAmount(0.00);
					if (isGSTPeriod) {
						for (TourDepItemVO tourDepItemVO : tourDepItemVOList) {
							if (tourDepItemVO.getCode().equals(itemVO.getCode())) {
								invItemVO.setTaxCode(tourDepItemVO.getTaxCode());
								invItemVO.setTaxRate(tourDepItemVO.getTaxRate());
								tourDepItemVOList.remove(tourDepItemVO);
								break;
							}
						}
					} else {
						invItemVO.setTaxCode(null);
						invItemVO.setTaxRate(null);
					}

					if (itemVO.getCabinQty() > 0 && ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(itemVO.getTypeCd())) {
						InvoiceItemVO cabinItemVO = new InvoiceItemVO();
						if (itemVO.getQuantity() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_TWN);
							cabinItemVO.setQty(itemVO.getQuantity());
							cabinItemVO.setUnitPrice(itemVO.getAmount());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity3() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_3RD);
							cabinItemVO.setQty(itemVO.getQuantity3());
							cabinItemVO.setUnitPrice(itemVO.getAmount3());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity4() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_4TH);
							cabinItemVO.setQty(itemVO.getQuantity4());
							cabinItemVO.setUnitPrice(itemVO.getAmount4());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantitySgl() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_SGL);
							cabinItemVO.setQty(itemVO.getQuantitySgl());
							cabinItemVO.setUnitPrice(itemVO.getAmountSgl());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity3Chd() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_3RD_CHD);
							cabinItemVO.setQty(itemVO.getQuantity3Chd());
							cabinItemVO.setUnitPrice(itemVO.getAmount3Chd());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantity4Chd() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_4TH_CHD);
							cabinItemVO.setQty(itemVO.getQuantity4Chd());
							cabinItemVO.setUnitPrice(itemVO.getAmount4Chd());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
						if (itemVO.getQuantityInf() > 0) {
							cabinItemVO = (InvoiceItemVO) invItemVO.clone();
							cabinItemVO.setDesc(itemVO.getDesc() + " - " + ProductConstant.BOOKING_CHARGE_ITEM_PAX_INFT);
							cabinItemVO.setQty(itemVO.getQuantityInf());
							cabinItemVO.setUnitPrice(itemVO.getAmountInf());
							cabinItemVO.setAmount((new BigDecimal(String.valueOf(cabinItemVO.getUnitPrice())))
									.multiply(new BigDecimal(String.valueOf(cabinItemVO.getQty()))).doubleValue());
							cabinItemVO.setShowInInv(true);
							invVO.getInvoiceItemList().add(cabinItemVO);
						}
					} else if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0
							&& ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE.equals(itemVO.getTypeCd())) {
						CruiseScheduleVO vvvo = cruiseBO.getCruiseSchedule(tourPkgBO.getTourDepById(bookingVO.getIdTourDep()));
						if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_PORT_CHARGES))	invItemVO.setShowInInv(!vvvo.isSumAmtApt());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_APT_ADT))	invItemVO.setShowInInv(!vvvo.isSumAmtApt());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_APT_CHD))	invItemVO.setShowInInv(!vvvo.isSumAmtApt());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_FUEL_ADT))	invItemVO.setShowInInv(!vvvo.isSumAmtFuel());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_FUEL_CHD))	invItemVO.setShowInInv(!vvvo.isSumAmtFuel());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_DEVIATION))	invItemVO.setShowInInv(!vvvo.isSumAmtDeviation());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_TRVL_INS))	invItemVO.setShowInInv(!vvvo.isSumAmtTrvlIns());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_VISA))		invItemVO.setShowInInv(!vvvo.isSumAmtVisa());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_AC))			invItemVO.setShowInInv(!vvvo.isSumAmtAC());
						else if(itemVO.getCode().equals(ProductConstant.CRUISE_ITM_CD_TIPPING))	invItemVO.setShowInInv(!vvvo.isSumAmtTipping());
						else {
							// this is cruise extra charges item
							TourDepItemVO tdi = tourPkgBO.getTourDepItem(bookingVO.getIdTourDep(),
									itemVO.getCode(), getSessionInfoBean().getCompanyVO());
							if (tdi == null) {
								invItemVO.setShowInInv(false);
							} else {
								invItemVO.setShowInInv(tdi.isShowInInv());
							}
						}
						invVO.getInvoiceItemList().add(invItemVO);
					} else if (itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0
							&& ProductConstant.TOUR_DEP_ITM_TYPE_TOTAL_MISC_CHARGE.equals(itemVO.getTypeCd())) {
//						System.out.println("itemVO.getQuantity() > 0 && itemVO.getAmount().doubleValue() != 0 && ProductConstant.TOUR_DEP_ITM_TYPE_TOTAL_MISC_CHARGE.equals(itemVO.getTypeCd())");
//						System.out.println("invItemVO.isShowInInv(): " + invItemVO.isShowInInv());
