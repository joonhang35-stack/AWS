			if (!StringUtils.isEmpty(vvo.getTourDepViewVO().getTourPkgVO().getNameZh())) sb.append(" " + vvo.getTourDepViewVO().getTourPkgVO().getNameZh());
			if (!StringUtils.isEmpty(vvo.getTourDepViewVO().getTourPkgVO().getNameOther())) sb.append(" " + vvo.getTourDepViewVO().getTourPkgVO().getNameOther());
			if (!StringUtils.isEmpty(vvo.getTourDepViewVO().getDesc())) sb.append(" [" + vvo.getTourDepViewVO().getDesc() + "]");
			invVO.setSubjLine(sb.toString());
