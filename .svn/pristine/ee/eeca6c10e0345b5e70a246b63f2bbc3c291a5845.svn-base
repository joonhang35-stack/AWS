	/*
	 *
	 * @param i - 0 = add / 1 = update / 2 = delete
	 * @return
	 * @throws BusinessException
	 */
	private int checkBookingPaxBalance(int i) throws BusinessException {
		// check whether over seat to book
		if (tourDepVO.getSeatAllot() > 0) {
			int balance = 0;
			//int currBook = bookingVO.getFtAdt() + bookingVO.getFtChd() + bookingVO.getFtInft() + bookingVO.getGaAdt() + bookingVO.getGaChd() + bookingVO.getGaInft();
			/*int currBook = bookingVO.getPaxFullCeb() + bookingVO.getPaxFullCnb() + bookingVO.getPaxFullCtw() + bookingVO.getPaxFullInft() + bookingVO.getPaxFullSgl() + bookingVO.getPaxFullTwn() +
					bookingVO.getPaxGrndCeb() + bookingVO.getPaxGrndCnb() + bookingVO.getPaxGrndCtw() + bookingVO.getPaxGrndInft() + bookingVO.getPaxGrndSgl() + bookingVO.getPaxGrndTwn();*/
			int currBook = bookingVO.getPaxFullCeb() + bookingVO.getPaxFullCnb() + bookingVO.getPaxFullCtw() + bookingVO.getPaxFullSgl() + bookingVO.getPaxFullTwn();

			switch (i) {
			case 0:
				balance = tourDepVO.getSeatAllot() - (tourDepVO.getAgentPax() + tourDepVO.getTfairPax() + tourDepVO.getInHsePax() + tourDepVO.getKivPax()
					+ tourDepVO.getReservedSeat() + tourDepVO.getTourManagerPax() + tourDepVO.getOn9BookingPax());
				if (currBook > balance) throw new BusinessException(CommonErrConstant.ERR_BOOKING_OVER_SEAT_BALANCE);
				return balance - currBook;
			case 1:
				int prevBook = bakBookingVO.getPaxFullCeb() + bakBookingVO.getPaxFullCnb() + bakBookingVO.getPaxFullCtw() + bakBookingVO.getPaxFullSgl() + bakBookingVO.getPaxFullTwn();
				balance = (tourDepVO.getSeatAllot() - (tourDepVO.getAgentPax() + tourDepVO.getTfairPax() + tourDepVO.getInHsePax() + tourDepVO.getKivPax()
					+ tourDepVO.getReservedSeat() + tourDepVO.getTourManagerPax() + tourDepVO.getOn9BookingPax())) + prevBook - currBook;
				if (balance < 0) throw new BusinessException(CommonErrConstant.ERR_BOOKING_OVER_SEAT_BALANCE);
				return balance;
			case 2:
				balance = (tourDepVO.getSeatAllot() + currBook)
					- (tourDepVO.getAgentPax() + tourDepVO.getTfairPax() + tourDepVO.getInHsePax() + tourDepVO.getKivPax()
					+ tourDepVO.getReservedSeat() + tourDepVO.getTourManagerPax() + tourDepVO.getOn9BookingPax());
				return balance;
			}
		}
		return -1;
	}

