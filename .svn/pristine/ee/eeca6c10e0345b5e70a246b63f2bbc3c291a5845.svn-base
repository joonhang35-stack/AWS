	/**
	 * Initialization
	 */
	@SuppressWarnings("unchecked")
	public void init(boolean isReservePage) {
		try {
			trackingLogUtils = new TrackingLogUtils(this.getClass());
			// initial search param
			initSearchParam();
			initPrefixVal();
			resetForm();
			loadFilterContinentList();
			loadFilterCountryList();

			boolean roleAllowReactiveBooking = false;

			orderSourceList = LookupItemUtils.getLookupItemList(CommonConstant.LOOKUP_CAT_CD_ORDR_SORC);

			// query employee list
			employeeList = userBO.getEmployeeViewList(getSessionInfoBean().getCompanyVO().getId(), null);

			List<UserRoleViewVO> userRoleList = securityBO.getUserRoleListByUser(this.getSessionInfoBean().getUserVO().getUuid());
			if (CollectionUtils.isNotEmpty(userRoleList)) {
				for (UserRoleViewVO userRoleVO : userRoleList) {
					if (userRoleVO.getRoleCode().equals(SalesConstant.BOOKING_SALES_PERSON_ROLE)) {
						salesPersonAuth = true;
					}

					if (userRoleVO.getRoleCode().equals(SalesConstant.AGENT_VIEW_ONLY_ROLE)) {
						isAgentViewOnly = true;
					}

					if (userRoleVO.getRoleCode().equals(SalesConstant.AGENT_BOOKING_ROLE)) {
						isAgentBooking = true;
					}

					if (userRoleVO.getRoleCode().equals(SalesConstant.SALES_MANAGER_ROLE)) {
						isSalesManager = true;
					} else if (userRoleVO.getRoleCode().equals(SalesConstant.ACTION_REACTIVATE_BOOKING)) {
						roleAllowReactiveBooking = true;
					} else if (userRoleVO.getRoleCode().equalsIgnoreCase(SalesConstant.AGENT_CANCEL_BOOKING)) {
						agentCancelBooking = true;
					}

					if (userRoleVO.getRoleCode().equals(SalesConstant.ASST_SALES_MANAGER_ROLE)) {
						isAsstSalesManager = true;
					}
				}
			}

			if (getSessionInfoBean().getEmployeeVO().getDepartment().equalsIgnoreCase(SalesConstant.DEPARTMENT_ASIA_FREELANCE) ||
					getSessionInfoBean().getEmployeeVO().getDepartment().equalsIgnoreCase(SalesConstant.DEPARTMENT_WEST_FREELANCE) ||
					getSessionInfoBean().getEmployeeVO().getDepartment().equalsIgnoreCase(SalesConstant.DEPARTMENT_JPN_GUIDO)) {
				isAgentViewSeatAllotment = true;
			}

			if (getSessionInfoBean().getEmployeeVO().getDepartment().equalsIgnoreCase(SalesConstant.DEPARTMENT_SALE_AGENT) ||
					getSessionInfoBean().getEmployeeVO().getDepartment().equalsIgnoreCase(SalesConstant.DEPARTMENT_B2B_AGENT)) {
				isB2BAgent = true;
			}

			if (StringUtils.equals(getSessionInfoBean().getEmployeeVO().getRoleType(), ConstantUser.ROLE_TYPE_AGENT))
				isAgent = true;

			// get tour package > departure filter Y/N
			tourPkgDepFilter = appSettingBO.getAppSettingByCode(ConstantAppSetting.ADMIN_TOUR_PKG_DEP_LIST_FILTER_FUNC).getValue();
			
			// get tour departure list show seat allotment Y/N (For UWS and is B2B Agent)
			String agentShowSeatAllotment = appSettingBO.getAppSettingByCode(ConstantAppSetting.ADMIN_AGENT_DEP_LIST_SHOW_SEAT_ALLOTMENT).getValue();
			if (BaseConstant.YES.equals(agentShowSeatAllotment)) {
				if (SalesConstant.DEPARTMENT_SALE_AGENT.equalsIgnoreCase(getSessionInfoBean().getEmployeeVO().getDepartment()) ||
						SalesConstant.DEPARTMENT_B2B_AGENT.equalsIgnoreCase(getSessionInfoBean().getEmployeeVO().getDepartment()) ||
						SalesConstant.DEPARTMENT_SALE_UBINGO_FREELANCE.equalsIgnoreCase(getSessionInfoBean().getEmployeeVO().getDepartment())) {
					isAgentViewSeatAllotment = true;
				} else {
					isAgentViewSeatAllotment = false;
				}
			}

			if (roleAllowReactiveBooking && BaseConstant.YES.equals(
					appSettingBO.getAppSettingByCode(ConstantAppSetting.ADMIN_BOOKING_ALLOW_REACTIVATE).getValue())) {
				bookingAllowReactivate = true;
			}

			// booking reserve page
			if (isReservePage) {
				// for current status only focus tour package
				searchParamVO.setCompanyVO(getSessionInfoBean().getCompanyVO());

				resetBookingForm();
				searchParamVO.setObj1(ProductConstant.TYPE_TOUR);
				tourCatViewList = tourCatBO.getTourCatViewList(searchParamVO);

				// Gavin requested to hide TRC 1.0 on agent (View Only) - 20211119
				if (isAgentViewOnly || isAgentBooking) {
					for (int i = tourCatViewList.size() - 1 ; i >= 0 ; i--) {
						TourCatViewVO vo = tourCatViewList.get(i);
						if (vo.getId() == 31 || vo.getId() == 33 || vo.getId() == 35
								 || vo.getId() == 36 || vo.getId() == 37) {
							tourCatViewList.remove(i);
							continue;
						}
					}
				}

				// airline list
				loadAirlineList();
				loadCruiseList();
				// country list
				countryList = regionBO.getCountryList();
				refDataListSeason = LookupUtils.getReferenceDataList("SEASON");

			// booking list page
			} else {
				// show all booking list pmnt type
				searchParamVO.setObj1(SalesConstant.BOOKING_PMNT_STATUS_KIV);
				//searchParamVO.setObj1(SalesConstant.BOOKING_PMNT_STATUS_ALL);
				searchParamVO.setCompanyVO(getSessionInfoBean().getCompanyVO());
				// booking list
				loadBookingViewList();
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	private void checkAllowVoid(boolean bookingAllowVoid) {
		allowVoid = false;

		if (!isAgent) {
			if (bookingAllowVoid) {
				allowVoid = true;
			}
		} else {
			if (agentCancelBooking) {
				allowVoid = true;
			}
		}
	}

	/**
	 * Add tour booking
	 */
	public void addBooking() {
		try {
			trackingLogUtils.startLogs();

			// check booking pax balance
			checkBookingPaxBalance(0);

			// set expiry date
			String kivExp = null;
			if (getSessionInfoBean().getEmployeeVO().getDepartment().equalsIgnoreCase("sale-wholesale") ||
					StringUtils.equals(getSessionInfoBean().getEmployeeVO().getRoleType(), ConstantUser.ROLE_TYPE_AGENT))
				kivExp = LookupItemUtils.getGlobalConfigValue(MaintConstant.GLOBAL_CD_GLOBAL, MaintConstant.GLOBAL_CD_KIV_EXP_WHOLE_SALES);
			else kivExp = LookupItemUtils.getGlobalConfigValue(MaintConstant.GLOBAL_CD_GLOBAL, MaintConstant.GLOBAL_CD_KIV_EXP);
			Calendar cal = Calendar.getInstance();
			cal.setTime(new Date());
			cal.add(Calendar.DAY_OF_MONTH, Integer.parseInt(kivExp));
			bookingVO.setDtExp(cal.getTime());
			//setBooking Itinerary
			TourPackageItineryVO tourPkgItinerary = tourPkgBO.getTourPackageItineraryVOByCode(tourDepVO.getIdTourPkg(),tourDepVO.getTourPkgDailyCms());	
			if (tourPkgItinerary != null) {
				bookingVO.setBookedItinerary(tourPkgItinerary.getName());
			    bookingVO.setItineraryUpdBy(tourPkgItinerary.getUpdatedBy());
			}
			// add booking
			setSalesPersonEmployeeView();
			bookingBO.addBooking(bookingVO, tourDepVO);

			// insert booking history
			bookingBO.insertBookingHistory(bookingVO.getId(), CommonConstant.ACTION_CD_ADD, "");

			// get tour departure list
			if (isFromSearchFiltering) handleFilterBookingTourDepList();
			else {
				if (BaseConstant.YES.equals(tourPkgDepFilter) && searchTourDep != null
						&& (searchTourDep.getFromDate() != null || searchTourDep.getToDate() != null
						|| searchTourDep.getTourPkgDailyCms() != null || searchTourDep.getLangCode() != null
						|| CollectionUtils.isNotEmpty(searchTourDep.getDepartDateBadgeList())
						|| CollectionUtils.isNotEmpty(searchTourDep.getSelectedSeason()))) {
					reloadTourDepListBySearch();
				} else reloadTourDepList();
			}
			resetBookingForm();
			successResult();

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("addBooking");
		}
	}

	/**
	 * Update booking
	 */
	public void updBooking() {
		try {
			trackingLogUtils.startLogs();

			// check booking pax balance
			checkBookingPaxBalance(1);

			setSalesPersonEmployeeView();

			bookingBO.updBooking(bookingVO, bookItemAUDVO, tourDepVO);

			// for audit trial history purpose
			bookingBO.insertBookingHistory(bookingVO.getId(), CommonConstant.ACTION_CD_UPD, "");

			bookingList = bookingBO.getBookingList(tourDepVO);

			if (isFromSearchFiltering){
				handleFilterBookingTourDepList();
			} else {
				// get tour departure list
				if (BaseConstant.YES.equals(tourPkgDepFilter) && searchTourDep != null
						&& (searchTourDep.getFromDate() != null || searchTourDep.getToDate() != null
						|| searchTourDep.getTourPkgDailyCms() != null || searchTourDep.getLangCode() != null
						|| CollectionUtils.isNotEmpty(searchTourDep.getDepartDateBadgeList())
						|| CollectionUtils.isNotEmpty(searchTourDep.getSelectedSeason()))) {
					reloadTourDepListBySearch();
				} else reloadTourDepList();
				// reload tour departure
				for (TourDepartureVO vo : tourDepList) {
					if (tourDepVO.getId().longValue() == vo.getId().longValue()) {
						tourDepVO = vo;
						break;
					}
				}
			}
			resetBookingForm();
			successResult();

		} catch (Throwable t) {
			errorResult(t);
			t.printStackTrace();
		} finally {
			trackingLogUtils.endLogs("updBooking");
		}
	}

	/**
	 * Update booking from booking page
	 */
	public void updBooking2() {
		if (CollectionUtils.isNotEmpty(employeeList)) {
			for (EmployeeViewVO vo : employeeList) {
				if (bookingVO.getIdEmployee().equals(vo.getId())) {
					bookingVO.setEmployeeViewVO(vo);
					break;
				}
			}
		}
		updBooking();
		bookingSearch();
	}

	/**
	 * Cancel booking
	 */
	public void cancelBooking() {
		try {
			trackingLogUtils.startLogs();

			bookingBO.cancelBooking(bookingVO, tourDepVO);

			if (fromBookingPage) {
				loadBookingViewList();

			} else {
				bookingList = bookingBO.getBookingList(tourDepVO);
				// get tour departure list
				if(isFromSearchFiltering) handleFilterBookingTourDepList();
				else reloadTourDepList();
			}
			resetBookingForm();
			successResult();

		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("cancelBooking");
		}
	}

	/**
	 * Search Booking
	 */
	public void bookingSearch() {
		try {
			loadBookingViewList();

		} catch (Throwable t) {
			resetBookingSearchValues();
			errorResult(t);
		}
	}

	/**
	 * Add customer
	 */
	public void addCustomer() {
		try {
			trackingLogUtils.startLogs();

			customerVO.getPersonVO().setLastName(customerVO.getPersonVO().getLastName().toUpperCase().trim());
			customerVO.getPersonVO().setGivenName(customerVO.getPersonVO().getGivenName().toUpperCase().trim());
			customerVO.setPcTypeCd("P");
			customerVO.setCompanyId(getSessionInfoBean().getCompanyVO().getId());
			// add customer identity
			if (StringUtils.isNotEmpty(identityVO.getIdNo())) {
				if(identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_PASSPRT)) {
					IdentityDetailVO identityDetailVO = new IdentityDetailVO();
					identityDetailVO.setIdCountry(CommonConstant.DEF_COUNTRY_ID);
					identityDetailVO.setDtExpired(new Date());
					identityDetailVO.setDtIssued(new Date());
					identityVO.setIdentityDetailVO(identityDetailVO);
				} else if(identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_VISA)) {
					IdentityDetailVO identityDetailVO = new IdentityDetailVO();
					identityDetailVO.setIdCountry(CommonConstant.DEF_COUNTRY_ID);
					identityDetailVO.setDtExpired(new Date());
					identityDetailVO.setDtIssued(new Date());
					identityVO.setIdentityDetailVO(identityDetailVO);
				} else if(identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_NRIC)) {
					SimpleDateFormat sdf = new SimpleDateFormat("yyMMdd");
			        Date dob = sdf.parse(identityVO.getIdNo());
			        customerVO.getPersonVO().setDob(dob);

					Calendar dateOfBirth = Calendar.getInstance();
					dateOfBirth.setTime(customerVO.getPersonVO().getDob());
					Calendar today = Calendar.getInstance();

					Integer age = today.get(Calendar.YEAR) - dateOfBirth.get(Calendar.YEAR);

					if(today.get(Calendar.DAY_OF_YEAR) <= dateOfBirth.get(Calendar.DAY_OF_YEAR)) {
						age--;
					}

					//set the age variable
					customerVO.getPersonVO().setAge(age);
				}
				customerVO.getIdentityList().add(identityVO);
			}
			AddressVO addressVO = new AddressVO();
			addressVO.setCountryId(CommonConstant.DEF_COUNTRY_ID);
			addressVO.setAddr1("");
			addressVO.setAddrType(CommonConstant.BILL_ADDR);
			customerVO.setBillAddressVO(addressVO);
			customerVO.setMailAddressVO(null);
			// insert email into email list and set as primary
			if (StringUtils.isNotBlank(customerVO.getPersonVO().getEmail())) {
				PersonEmailVO vo = new PersonEmailVO();
				vo.setEmail(customerVO.getPersonVO().getEmail());
				vo.setIsPrimary(true);
//				if (customerVO.getPersonVO().getEmailList() == null) customerVO.getPersonVO().setEmailList(new ArrayList<PersonEmailVO>());
				customerVO.getPersonVO().setEmailList(new ArrayList<PersonEmailVO>());
				customerVO.getPersonVO().getEmailList().add(vo);
			}
			// check duplicate customer
			checkDuplicateCustomer(); // need to be after email to check email duplication
			// set contact
			personContactVO.setTypeCd(CommonConstant.LOOKUP_ITM_CNTC_TYPE_MOBILE);
			CountryVO mobileCountry = regionBO.getCountryById(personContactVO.getPerMobileCountryId());
			personContactVO.setIdCountryCd(personContactVO.getPerMobileCountryId());
			personContactVO.setCountryCd(mobileCountry.getCountryCd());
//			personContactVO.setNumber(personContactVO.getAreaCode() + "-" + personContactVO.getNumber());
			personContactVO.setNumber(personContactVO.getNumber());

			customerVO.getPersonContactList().add(personContactVO);
			if (StringUtils.isNotEmpty(personContactVO.getFaxNum())) {
				CountryVO faxCountry = regionBO.getCountryById(personContactVO.getPerFaxCountryId());
				PersonContactVO vo = new PersonContactVO();
				vo.setTypeCd(CommonConstant.LOOKUP_ITM_CNTC_TYPE_FAX);
				//vo.setNumber(personContactVO.getFaxNum());
				vo.setIdCountryCd(personContactVO.getPerFaxCountryId());
				vo.setCountryCd(faxCountry.getCountryCd());
				vo.setNumber(personContactVO.getFaxNum());
				vo.setFullPhoneNo(personContactVO.getFullPhoneNo());
				customerVO.getPersonContactList().add(vo); // add fax number
			}
			
			customerBO.insertCustomer(customerVO);
			if (customerVO.getPcTypeCd().equals("P")) customerPosting(customerVO);
			bookingVO.setIdCust(customerVO.getId());
			bookingVO.setCustomerVO(customerVO);
			StringBuilder name = new StringBuilder();
			name.append(LookupItemUtils.getLookupItemDesc("salutatn", customerVO.getPersonVO().getSalutation())).
				append(" ").append(customerVO.getPersonVO().getLastName()).append(" ").append(customerVO.getPersonVO().getGivenName());

			custDetailsVO = new CustDetailsVO();
			custDetailsVO.setContPersonName(name.toString());
			customerVO = new CustomerVO();
			customerVO.setPersonVO(new PersonVO());
			customerVO.setPersonContactList(new ArrayList<PersonContactVO>());
			customerVO.setIdentityList(new ArrayList<IdentityVO>());
			personContactVO = new PersonContactVO();
			identityVO = new IdentityVO();

			successResult();

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("addCustomer");
		}
	}

	public void onAddCust() {
		try {
			if (customerVO != null && customerVO.getPersonVO() != null) {
				if (customerVO.getPersonVO().getCountryId() == null) {
					customerVO.getPersonVO().setCountryId(CommonConstant.DEF_COUNTRY_ID);
