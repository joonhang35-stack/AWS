	/**
	 * Delete pax
	 */
	public void delPax(BookingItemVO vo) {
		try {
			if (bookingVO.getId() != null) {
				if (vo.getId() == null) bookItemAUDVO.getAddList().remove(vo);
				else bookItemAUDVO.getDelList().add(vo);
			}
			bookingVO.getBookingItemList().remove(vo);
			resetBookItemForm();

		} catch (Throwable t) {
			errorResult(t);
		}
	}

