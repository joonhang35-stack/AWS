	protected void loadSalesCommConfig(Long idSalesCommConf) throws BusinessException{
		salesCommConfigVO = salesCommConfigBO.getSalesCommConfigDetails(idSalesCommConf);

		if (tourDepVO != null && salesCommConfigVO != null) {
			if (CollectionUtils.isNotEmpty(salesCommConfigVO.getSalesCommConfigDetailList())) {
				boolean setFTComm = false;
				boolean setGAComm = false;
				for (SalesCommConfigDetailVO dtlVO : salesCommConfigVO.getSalesCommConfigDetailList()) {
					setFTComm = false;
					if (ProductConstant.TOUR_FARE_RANGE_TYPE_LT.equals(dtlVO.getFareRangetype()) && (Double.compare(tourDepVO.getFullTwn(), dtlVO.getFrAmt()) < 0 || Double.compare(tourDepVO.getFullTwn(), dtlVO.getFrAmt()) == 0)) {
						setFTComm = true;
					} else if (ProductConstant.TOUR_FARE_RANGE_TYPE_RG.equals(dtlVO.getFareRangetype()) &&
						((Double.compare(tourDepVO.getFullTwn(), dtlVO.getFrAmt()) > 0 || Double.compare(tourDepVO.getFullTwn(), dtlVO.getFrAmt()) == 0)  &&
						(Double.compare(tourDepVO.getFullTwn(), dtlVO.getToAmt()) < 0 || Double.compare(tourDepVO.getFullTwn(), dtlVO.getToAmt()) == 0))) {
						setFTComm = true;
					} else if (ProductConstant.TOUR_FARE_RANGE_TYPE_GT.equals(dtlVO.getFareRangetype()) && (Double.compare(tourDepVO.getFullTwn(), dtlVO.getFrAmt()) > 0 || Double.compare(tourDepVO.getFullTwn(), dtlVO.getFrAmt()) == 0)) {
						setFTComm = true;
					}

					if (setFTComm) {
						tourDepVO.setFullSpComm(dtlVO.getSpComm());
						tourDepVO.setFullRefSpComm(dtlVO.getRefSpComm());
						tourDepVO.setFullSsComm(dtlVO.getSsComm());
						tourDepVO.setFullHodComm(dtlVO.getHodComm());
						tourDepVO.setFullOpComm(dtlVO.getOpComm());
						break;
					}
				}

				for (SalesCommConfigDetailVO dtlVO : salesCommConfigVO.getSalesCommConfigDetailList()) {
					setGAComm = false;
					if (ProductConstant.TOUR_FARE_RANGE_TYPE_LT.equals(dtlVO.getFareRangetype()) && (Double.compare(tourDepVO.getGrndTwn(), dtlVO.getFrAmt()) < 0 || Double.compare(tourDepVO.getGrndTwn(), dtlVO.getFrAmt()) == 0)) {
						setGAComm = true;
					} else if (ProductConstant.TOUR_FARE_RANGE_TYPE_RG.equals(dtlVO.getFareRangetype()) &&
						((Double.compare(tourDepVO.getGrndTwn(), dtlVO.getFrAmt()) > 0 || Double.compare(tourDepVO.getGrndTwn(), dtlVO.getFrAmt()) == 0)  &&
						(Double.compare(tourDepVO.getGrndTwn(), dtlVO.getToAmt()) < 0 || Double.compare(tourDepVO.getGrndTwn(), dtlVO.getToAmt()) == 0))) {
						setGAComm = true;
					} else if (ProductConstant.TOUR_FARE_RANGE_TYPE_GT.equals(dtlVO.getFareRangetype()) && (Double.compare(tourDepVO.getGrndTwn(), dtlVO.getFrAmt()) > 0 || Double.compare(tourDepVO.getGrndTwn(), dtlVO.getFrAmt()) == 0)) {
						setGAComm = true;
					}

					if (setGAComm) {
						tourDepVO.setGrndSpComm(dtlVO.getSpComm());
						tourDepVO.setGrndRefSpComm(dtlVO.getRefSpComm());
						tourDepVO.setGrndSsComm(dtlVO.getSsComm());
						tourDepVO.setGrndHodComm(dtlVO.getHodComm());
						tourDepVO.setGrndOpComm(dtlVO.getOpComm());
						break;
					}
				}
			}
		}
	}

