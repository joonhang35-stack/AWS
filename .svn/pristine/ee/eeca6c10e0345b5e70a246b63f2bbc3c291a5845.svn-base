	/**
	 * Get airline info
	 * @param id
	 * @return
	 */
	public AirlineVO getAirlineInfo(long id) {
		if (CollectionUtils.isNotEmpty(airlineList)) {
			for (AirlineVO vo : airlineList) {
				if (vo.getId().longValue() == id) {
					return vo;
				}
			}
		}
		return null;
	}

	public CruiseVO getCruiseInfo(long id) {
		if (CollectionUtils.isNotEmpty(cruiseList)) {
			for (CruiseVO vo : cruiseList) {
				if (vo.getId().longValue() == id) {
					return vo;
				}
			}
		}
		return null;
	}

	public void handleOpPicShow() {
		try {
			tourDepVO.setOpPicName("");
			List<String>  opPicList = new ArrayList<String>();
			if (StringUtils.isNotEmpty(tourDepVO.getOpPic())) {
				opPicList = Arrays.asList(tourDepVO.getOpPic().replaceAll(",$", "").split(",", -1));
			}

			// query employee list
			if(CollectionUtils.isEmpty(employeeList)) employeeList = userBO.getEmployeeViewList(getSessionInfoBean().getCompanyVO().getId(), null);

			if (CollectionUtils.isNotEmpty(opPicList) && CollectionUtils.isNotEmpty(employeeList)) {
				for (String pic : opPicList) {
					for (EmployeeViewVO vo : employeeList) {
						if (vo.getId().longValue() == Long.parseLong(pic)) {
							if (StringUtils.isBlank(tourDepVO.getOpPicName())) {
								tourDepVO.setOpPicName(vo.getUserVO().getName());
							} else {
								tourDepVO.setOpPicName(tourDepVO.getOpPicName() + ", " + vo.getUserVO().getName());
							}
							break;
						}
					}
				}
			}

		} catch (Throwable t) {
			errorResult(t);
		}
	}

	/**
	 * Load tour departure
	 */
	public void reloadTourDepList() {
		try {

//			System.out.println("CCL at tourPkgVO.getTypeCd(): " + tourPkgVO.getTypeCd());
//			System.out.println("CCL at isAgentViewOnly: " + isAgentViewOnly);
//			System.out.println("CCL at isAgentBooking: " + isAgentBooking);
			if (isAgentViewOnly || isAgentBooking) {
				if (ProductConstant.TYPE_CRUISE.equals(tourPkgVO.getTypeCd())) {
					tourDepList = tourPkgBO.getAgentTourDepListCruise(tourPkgVO.getId(), getSessionInfoBean().getCompanyVO());
				} else {
					tourDepList = tourPkgBO.getAgentTourDepList(tourPkgVO.getId(), getSessionInfoBean().getCompanyVO());
					tourItineraryListControl(tourDepList);
				}

				accCodeStatusCdCheckingForAgent(tourDepList);
			} else {
				if (ProductConstant.TYPE_CRUISE.equals(tourPkgVO.getTypeCd())) {
					tourDepList = tourPkgBO.getTourDepListCruise(tourPkgVO.getId(), getSessionInfoBean().getCompanyVO());
				} else {
					tourDepList = tourPkgBO.getTourDepList(tourPkgVO.getId(), getSessionInfoBean().getCompanyVO());
					tourItineraryListControl(tourDepList);
				}
			}

			privateTourChecking(tourDepList);

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

