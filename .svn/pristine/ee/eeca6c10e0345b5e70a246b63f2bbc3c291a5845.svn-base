	/**
	 * Handle booking transfer
	 */
	public void handleTransfer(boolean isTransfer) {
		try {
			trackingLogUtils.startLogs();

			if (isTransfer) {
				if (availableTourDepVO == null || availableTourDepVO.getId() == null) throw new BusinessException(CommonErrConstant.ERR_BOOKING_NOT_TOUR_DEP_SELECTED);

				InvoiceVO invVO = bookingBO.transferBooking(bookingVO.getId(), bookingVO.getIdTourDep(), null, availableTourDepVO, false);

				// Transfer booking history log
				bookingBO.insertBookingHistory(invVO.getBookingId(), CommonConstant.ACTION_CD_XFER, "Transfer Booking No [" + bookingVO.getId() + "] to [" + invVO.getBookingId() + "]");

				if (fromBookingPage) {
					loadBookingViewList();

				} else {
					bookingList = bookingBO.getBookingList(tourDepVO);
					reloadTourDepList();
				}
				resetBookingForm();
				successResult();

			} else {
				if (bookingVO.getInvoiceVO() != null) throw new Exception(); //sendRedirect("bookingId", bookingVO.getId(), bookingVO.getInvoiceVO(), URL_SALES_INV);
				else availableTourDepList = tourPkgBO.getAvailableTourDepList(getSessionInfoBean().getCompanyVO().getId(), null);
			}
		} catch (Exception e) {
			try {
				sendRedirect("bookingId", bookingVO.getId(), bookingVO.getInvoiceVO(), URL_SALES_INV);
			} catch (Exception e1) {
				e1.printStackTrace();
			}
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("handleTransfer");
		}
	}

