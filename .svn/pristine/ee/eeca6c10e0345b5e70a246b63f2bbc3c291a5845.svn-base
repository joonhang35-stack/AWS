	public void handleSectorTypeChange() {
		try {
			filterFullCountryList = new ArrayList<CountryVO>();

			if(CollectionUtils.isNotEmpty(searchTourDepFilter.getSectorTypeList())) {
				for (String region : searchTourDepFilter.getSectorTypeList()){
					filterFullCountryList.addAll(tourPkgBO.getFullCountryList(Long.valueOf(region)));
				}
			} else {
				filterFullCountryList.addAll(tourPkgBO.getFullCountryList(null));
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public void setSalesPersonEmployeeView() {
		boolean isSalesPerson = (bookingVO.getIdEmployee() == null);
		boolean isReferralSP = (bookingVO.getIdSalerTfair() == null);
		if (CollectionUtils.isNotEmpty(employeeList)) {
			for (EmployeeViewVO vo : employeeList) {
				if (bookingVO.getIdEmployee() != null && bookingVO.getIdEmployee().equals(vo.getId())) {
					bookingVO.setEmployeeViewVO(vo);
					isSalesPerson = true;
				}
				if (bookingVO.getIdSalerTfair() != null && bookingVO.getIdSalerTfair().equals(vo.getId())) {
					bookingVO.setRefEmployeeViewVO(vo);
					isReferralSP = true;
				}
				if (isSalesPerson && isReferralSP) break;
			}
		}
		if (bookingVO != null && bookingVO.getIdEmployee() != null && (bookingVO.getEmployeeViewVO() == null || !bookingVO.getIdEmployee().equals(bookingVO.getEmployeeViewVO().getId()))) {
			EmployeeViewVO empVO = new EmployeeViewVO();
			empVO.setId(bookingVO.getIdEmployee());
			bookingVO.setEmployeeViewVO(empVO);
		}
	}

