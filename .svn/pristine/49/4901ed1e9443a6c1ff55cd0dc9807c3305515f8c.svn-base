<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
					xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">
  
  <p:growl id="msg"/>
	<script language="javascript" src="#{request.contextPath}/js/PFCustomExt.js"  />
	<script type="text/javascript" >
		//<![CDATA[
		$(document).ready(function() {
			pfCustExt.disableFocusCalendar();
		});
		
		function onValidation(xhr, status, args) {
			if (args.validationFailed) {
				varEditRefundDialog.show();
			} else {
				varEditRefundDialog.hide();
			}
		}
		//]]>
	</script>
<div style="height:500px;width:900px;overflow:auto;">
<p:panelGrid>
	<p:row>
	 	<p:column><h:outputLabel for="idNewNumber">Refund Number</h:outputLabel></p:column>
		<p:column><h:outputText id="idNewNumber" label="New Number" value="#{refundBean.prefixValue}-#{refundBean.cashBookVO.sysNo}"/></p:column>
	</p:row>
	<p:row>
		<p:column><h:outputLabel for="idBankAcct">Bank Account </h:outputLabel></p:column>
		<p:column><h:outputText label="idBankAcct" value="#{refundBean.cashBookVO.temp}"/></p:column>
		<p:column><h:outputLabel for="idCompanyCode">Company Code</h:outputLabel></p:column>
		<p:column><h:outputText id="idCompanyCode" label="idCompanyCode" value="#{refundBean.sessionInfoBean.companyVO.name}"/></p:column>
	</p:row>
	<p:row>
		<p:column><h:outputLabel for="idAddEODt">Date <span class="required">*</span></h:outputLabel></p:column>
		<p:column>
			<p:calendar pattern="dd-MMM-yyyy" id="idAddEODt" value="#{refundBean.cashBookVO.dtTrans}" navigator="true" showButtonPanel="true"
				mindate="#{refundBean.dateFormat(bterp:finPeriodLockVO(sessionInfoBean.companyVO.id).dtStart, 'dd-MMM-yyyy')}"
				maxdate="#{refundBean.dateFormat(bterp:finPeriodLockVO(sessionInfoBean.companyVO.id).dtEnd, 'dd-MMM-yyyy')}"
				required="true" disabled="#{refundBean.cashBookVO.dateInFinPeriodClosed}"/>
			<span style="font-style:italic; font-size:9px; color:#333333;">(dd-MMM-yyyy)</span>
		</p:column>
		<p:column><h:outputLabel for="idPayee">Pay<span class="required">*</span></h:outputLabel></p:column>
		<p:column>
			<p:inputText id="idPayee" label="Payee" value="#{refundBean.cashBookVO.payee}" required="true" readonly="#{not empty refundBean.cashBookVO.idCustomer}"/>&nbsp;
			<p:commandButton icon="ui-icon-search"  actionListener="#{refundBean.passangerEditSearch}" oncomplete="varCustListDialog.show()" update=":idCustListDialog" immediate="true"/>
			<p:commandButton icon="ui-icon-close" actionListener="#{refundBean.handlePassangerClear}" update="idEditRefund:idPayee,:idEditRefund:idCustomerNumber" process="@this"/>
		</p:column>
	</p:row>
	<p:row>
		<p:column><h:outputLabel for="idAmount">Amount <span class="required">*</span></h:outputLabel></p:column>
		<p:column>
			<p:inputText id="idAmount" label="Amount"  value="#{refundBean.cashBookVO.credit}" required="true"
				readonly="#{refundBean.cashBookVO.dateInFinPeriodClosed}">
				<f:convertNumber pattern="#,##0.00"/>
			</p:inputText>
		</p:column>
		
		<p:column><h:outputLabel for="idCustomerNumber">Customer Number</h:outputLabel></p:column>
		<p:column><h:outputText id="idCustomerNumber" label="CustomerNumber" value="#{refundBean.cashBookVO.custCode}"></h:outputText></p:column>
	</p:row>
	<p:row>
		<p:column><h:outputLabel for="idChequeNo">Cheque No</h:outputLabel></p:column>
		<p:column><p:inputText id="idChequeNo" label="Cheque No" value="#{refundBean.cashBookVO.refNo}" required="true" maxlength="30" style="width:230px"/></p:column>
		<p:column><h:outputLabel>Tour Code </h:outputLabel></p:column>
		<p:column>
	        <p:inputText id="idTourCd" label="Tour Code" value="#{refundBean.cashBookVO.tourCd}" readonly="true" size="30"/>&nbsp;
	        <p:commandButton icon="ui-icon-search" actionListener="#{refundBean.loadTour}" update=":idTourCodeList" oncomplete="varTourCodeList.show()" process="@this"/>
			<p:commandButton icon="ui-icon-close" actionListener="#{refundBean.clearTourCode}" update="idTourCd" process="@this"/>
		</p:column>
	</p:row>
	</p:panelGrid>
	<p:panelGrid>
	<p:row>
		<p:column><h:outputLabel for="idMemo">Memo</h:outputLabel></p:column>
		<p:column><p:inputTextarea id="idMemo" label="Memo" value="#{refundBean.cashBookVO.remarks}" required="true" rows="7" cols="90"/></p:column>
	</p:row>
</p:panelGrid>
<p:panelGrid>
	<p:row>
		<p:column>
			<p:commandButton value="Add Account Transaction" oncomplete="varAcctTransEditDialog.show()" immediate="true" actionListener="#{refundBean.onAddAcctTrans(0,refundBean.cashBookVO.credit)}"
				update=":idAcctTransEditDialog" disabled="#{refundBean.cashBookVO.dateInFinPeriodClosed}"/>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<p:dataTable id="idShowAcctTransList" value="#{refundBean.acctTransListView}" var="acctTransViewVO"  style="width:250px">
					<p:column headerText="Edit" style="width:50px;text-align:center;">
						<p:commandButton icon="ui-icon-pencil" actionListener="#{refundBean.onAcctTransSelectedInEdit(acctTransViewVO)}" oncomplete="varEditAcctTransDialogInEdit.show()"
							process="@this" update=":idEditAcctTransDialogInEdit" disabled="#{refundBean.cashBookVO.dateInFinPeriodClosed}"/>
					</p:column>
					<p:column headerText="Delete" style="width:50px; text-align:center;">
						<p:commandButton icon="ui-icon-close" actionListener="#{refundBean.delAcctTransListInEdit(acctTransViewVO)}" update="@form,:idEditRefund:idShowAcctTransList,:idEditAcctTransDialogInEdit"
							process="@this" disabled="#{refundBean.cashBookVO.dateInFinPeriodClosed}"/>
					</p:column>
					<p:column headerText="Account">
					  <h:outputText value="#{acctTransViewVO.acctViewVO.code}" rendered="#{empty acctTransViewVO.acctViewVO.subCode}"/>
					<h:outputText value="#{acctTransViewVO.acctViewVO.code}-#{acctTransViewVO.acctViewVO.subCode}" rendered="#{not empty acctTransViewVO.acctViewVO.subCode}"/>
					</p:column>
					<p:column headerText="Description">
						<h:outputText value="#{acctTransViewVO.desc}"/>
					</p:column>
					<p:column headerText="Amount">
						<h:outputText value="#{refundBean.getDoubleDecimalFormat('#,##0.00',acctTransViewVO.debit)}"/>
					</p:column>
					<p:columnGroup type="footer">
					<p:row>
						<p:column colspan="4" footerText="Totals:" style="text-align:right"/>
						<p:column colspan="5" footerText="#{refundBean.getDoubleDecimalFormat('#,##0.00', refundBean.totalBal)}"/>
					</p:row>
					</p:columnGroup>
			</p:dataTable>
		</p:column>
	</p:row>
	<p:row>
		<p:column><p:commandButton id="idAddTrans3" value="Add Invoice Payment" oncomplete="varInvTransDialog.show()" immediate="true" actionListener="#{refundBean.loadInvoicePayment}" update=":idInvTransDialog,:idInvListForm:idInvListTable"/></p:column>
	</p:row>
	<p:row>
		<p:column>
			<p:panel id ="idShowInv" style="border:none">
				<p:dataTable id="idShowInvList" value="#{refundBean.cashBookVO.invPymtList}" var="invTransViewVO">
					<p:column headerText="Delete" style="width:50px; text-align:center;">
					<p:commandButton icon="ui-icon-close"  actionListener="#{refundBean.delInvPmnt(invTransViewVO)}" update=":idEditRefund:idShowInvList" process="@this"/>
					</p:column> 
					<p:column headerText="Invoice No" style="width:80px; text-align:center;">
						<h:outputText rendered="#{invTransViewVO.invoiceDocTypeCd eq 'I'}" value="#{bterp:sysNumGenVO(sessionInfoBean.companyVO.id, 'invc').prefixid} #{invTransViewVO.invoiceNo}"  />
						<h:outputText rendered="#{invTransViewVO.invoiceDocTypeCd eq 'P'}" value="#{bterp:sysNumGenVO(sessionInfoBean.companyVO.id, 'pax_statement').prefixid} #{invTransViewVO.psNo}"  />
					</p:column>  
					<p:column headerText="Tour Code" style="width:150px; text-align:center;">
						<h:outputText value="#{invTransViewVO.tourCode}"/>  
					</p:column>
					<p:column headerText="Payment Date" style="width:100px; text-align:center;">
					  <h:outputText value="#{invTransViewVO.pmntDt}"   >
					<f:convertDateTime pattern="dd-MMM-yyyy"/>  
					</h:outputText>
					  </p:column> 
					<p:column headerText="Payment Ref No" style="width:100px; text-align:center;">
					  <h:outputText value="#{invTransViewVO.refNo}"  />
					  </p:column> 
					<p:column headerText="Received From" style="width:300px; text-align:center;">
					  <h:outputText value="#{invTransViewVO.recievedFr}"  />
					  </p:column> 
					<p:column headerText="Amount" style="width:100px; text-align:center;">
					  <h:outputText value="#{invTransViewVO.amount}"  />
					</p:column> 
				</p:dataTable>
			</p:panel>
		</p:column>
	</p:row>
</p:panelGrid>	
</div>
	<h:panelGrid id="idButtonGrid" columns="2" style="width:1px;margin:5px 0 0 6px;">
		<p:commandButton id="idBtnEditSubmit" actionListener="#{refundBean.editRefund}" value="#{msg['common.button.label.save']}" update="@form,:idForm:idPaymentTable" oncomplete="onValidation(xhr, status, args)"/>
		<p:commandButton id="idBtnEditCancel" value="#{msg['common.button.label.cancel']}" actionListener="#{refundBean.resetForm}" update="@form" process="@this" oncomplete="varEditRefundDialog.hide()">
			<pe:resetEditableValues for="idEditRefund"/>
		</p:commandButton>
	</h:panelGrid>
	<h:outputText/>
<br/>
<h:outputLabel><span class="required">*</span> - required field</h:outputLabel>

</ui:composition>