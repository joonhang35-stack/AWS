<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">
	<class table="tour_pkg_commision" name="TourPackageCommisionVO" polymorphism="explicit">
		<id name="id" type="long" column="id">
            <generator class="native"/>
        </id>
        
		<property name="idTourPkg" type="long" column="id_tour_pkg"/>
		<property name="cnaAdt" type="double" column="cna_adt"/>
		<property name="cpaAdt" type="double" column="cpa_adt"/>
		<property name="csiAdt" type="double" column="csi_adt"/>
		<property name="commisionPax" type="integer" column="commision_pax"/>
		
		<!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_update"/>
		<property name="updatedBy" type="string" column="updated_by"/>
	</class>
</hibernate-mapping>