	public void init(String cd) {
		try {
			eInvoiceDocumentList = new ArrayList<EInvoiceDocument>();
			
			if (cd.equals("L")) {
				// document listing page, load all e invoice docs from database
				loadEInvoiceDocumentList();
				loadEInvApiDailySnapshotList();
			}
			
			loadAuthority();
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void searchDocuments() {
		try {
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO);
//			String accessToken = EInvoiceUtils.getAccessToken("IG50676466040", false, getSessionInfoBean().getCompanyVO());
			String accessToken = eInvoiceUtils.getAccessToken(getSessionInfoBean().getCompanyVO(), false);
			
			int totalPages = getDocumentsTotalPages(accessToken);
			
			synchronized (this) {  // Acquire the lock on lockObject
	            this.wait(2200);       // Call wait() while holding the lock
	        }
			
			for (int page = 1; page <= totalPages; page++) {
				JSONObject response = getDocuments(page, accessToken);
				
				Gson gson = new Gson();
		        Type eInvoiceDocumentListType = new TypeToken<List<EInvoiceDocument>>() {}.getType();
		        List<EInvoiceDocument> eInvoiceDocumentList = gson.fromJson(response.getJSONArray("result").toString(), eInvoiceDocumentListType);

		        for (EInvoiceDocument eInvoiceDocument : eInvoiceDocumentList) {
//		        	System.out.println(eInvoiceDocument.getUuid());
		        	
		        	eInvoiceDocument.setDateTimeIssuedDt(Date.from(OffsetDateTime.parse(eInvoiceDocument.getDateTimeIssued()).toInstant()));
		        	eInvoiceDocument.setDateTimeReceivedDt(Date.from(OffsetDateTime.parse(eInvoiceDocument.getDateTimeReceived(), DateTimeFormatter.ISO_OFFSET_DATE_TIME).toInstant()));
		        	eInvoiceDocument.setDateTimeValidatedDt(Date.from(OffsetDateTime.parse(eInvoiceDocument.getDateTimeValidated(), DateTimeFormatter.ISO_OFFSET_DATE_TIME).toInstant()));
		        }
//		        System.out.println();
		        this.eInvoiceDocumentList.addAll(eInvoiceDocumentList);
		        
//		        System.out.println("Waiting...");
		        synchronized (this) {  
		            this.wait(2200);	// wait to avoid E-Invoice API request limit (1 per 2 sec)
		        }
//		        System.out.println("Wait done!\n");
			}
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public JSONObject getDocuments(int pageNo, String accessToken) throws ClientProtocolException, IOException, BusinessException, JSONException {
		SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'");
        sdf.setTimeZone(TimeZone.getTimeZone("UTC"));
        
		Calendar calendar = Calendar.getInstance();
		Date toDate = new Date();
		Date fromDate = calendar.getTime();
		calendar.add(Calendar.MONTH, -1);
		fromDate = calendar.getTime();
		
//		System.out.println("CYY sdf.format(fromDate): " + sdf.format(fromDate));
//		System.out.println("CYY sdf.format(toDate): " + sdf.format(toDate));
		
		String url = UriComponentsBuilder.fromHttpUrl(EInvoiceProperties.getSystemApiUrl() + "api/v1.0/documents/search")
                .queryParam("submissionDateFrom", sdf.format(fromDate))
                .queryParam("submissionDateTo", sdf.format(toDate))
                .queryParam("pageNo", pageNo)
                .build()
                .toUriString();
		
		HttpClient client = new DefaultHttpClient();
		HttpGet request = new HttpGet(url);
		
		request.addHeader("Accept", "application/json");
        request.addHeader("Accept-Language", "en");
        request.addHeader("Content-Type", "application/json");
        request.addHeader("Authorization", "Bearer " + accessToken);
        
        HttpResponse response = client.execute(request);
        
//        BufferedReader reader1 = new BufferedReader(new InputStreamReader(response.getEntity().getContent()));
//        StringBuilder responseString = new StringBuilder();
//        String line1;
//        while ((line1 = reader1.readLine()) != null) {
//            responseString.append(line1);
//        }
//        System.out.println(responseString);
        
        int statusCode = response.getStatusLine().getStatusCode();
        System.out.println("CYY statusCode: " + statusCode);
        
        JSONObject jsonResponse = new JSONObject(EntityUtils.toString(response.getEntity()));
        if (statusCode != 200) {
        	System.out.println(jsonResponse.toString(4));
        }
        return jsonResponse;
//        System.out.println(jsonResponse.toString(4));
	}
	
	public JSONObject getDocuments(String accessToken) throws ClientProtocolException, BusinessException, IOException, JSONException {
		return getDocuments(1, accessToken);
	}
	
	public int getDocumentsTotalPages(String accessToken) throws ClientProtocolException, BusinessException, IOException, JSONException {
		JSONObject jsonObject = getDocuments(accessToken);
		
		JSONObject metadata = jsonObject.getJSONObject("metadata");
		if (metadata == null) {
			throw new BusinessException(CommonErrConstant.ERR_GET_DOC_FAILED);
		}
		
		int totalPages = metadata.getInt("totalPages");
		return totalPages;
	}
	
