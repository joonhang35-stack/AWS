	public void updDocumentDetails(EInvoiceDocumentVO eInvoiceDocumentVO) {
		
		try {
			if (StringUtils.isBlank(eInvoiceDocumentVO.getDocumentUuid())) {
				// if no uuid, means didn't submit before, no need call API
				return;
//					throw new BusinessException(CommonErrConstant.ERR_DOC_NO_UUID);
			}
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO, invoiceBO);
			String accessToken = eInvoiceUtils.getAccessToken(getSessionInfoBean().getCompanyVO(), true);
			
			eInvoiceUtils.updDocumentDetails(eInvoiceDocumentVO.getDocumentUuid(), accessToken);
			
			loadEInvoiceDocumentList();
			
			successResult();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void getDocumentDetails(EInvoiceDocumentVO eInvoiceDocumentVO) {
		
		try {
			if (StringUtils.isBlank(eInvoiceDocumentVO.getDocumentUuid())) {
				// if no uuid, means didn't submit before, no need call API
				return;
//					throw new BusinessException(CommonErrConstant.ERR_DOC_NO_UUID);
			}
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO, invoiceBO);
//			String accessToken = EInvoiceUtils.getAccessToken(getSessionInfoBean().getCompanyVO().getTaxIdNo(), true, getSessionInfoBean().getCompanyVO());
			String accessToken = eInvoiceUtils.getAccessToken(getSessionInfoBean().getCompanyVO(), true);
			
//	        if (!EInvoiceUtils.validateTaxpayerTin(getSessionInfoBean().getCompanyVO().getTaxIdNo(), accessToken)) {
//	        	throw new BusinessException(CommonErrConstant.ERR_TAXPAYER_TIN_VALIDATION_FAILED);
//	        }
	        
			EInvoiceDocument eInvoiceDocument = EInvoiceUtils.getDocumentDetails(eInvoiceDocumentVO.getDocumentUuid(), accessToken);
			eInvoiceDocumentVO.setStatusCode(eInvoiceDocument.getStatus());
			eInvoiceDocumentVO.setLongId(eInvoiceDocument.getLongId());
			eInvoiceDocumentVO.setDocStatusReason(eInvoiceDocument.getDocumentStatusReason());
			
			if (eInvoiceDocumentVO.getStatusCode().equals(EInvoiceConstant.E_INV_STATUS_INVALID)) {
				for (EInvoiceValidationStepResult step : eInvoiceDocument.getValidationResults().getValidationSteps()) {
					if (step.getStatus().equals(EInvoiceConstant.E_INV_STATUS_INVALID)) {
						for (EInvoiceStandardError err : step.getError().getInnerError()) {
							if (StringUtils.isBlank(eInvoiceDocumentVO.getDocStatusReason())) {
								eInvoiceDocumentVO.setDocStatusReason(err.getError());
							} else {
								eInvoiceDocumentVO.setDocStatusReason(eInvoiceDocumentVO.getDocStatusReason() + "\n" + err.getError());
							}
						}
					}
				}
			}
			
			System.out.println("CYY eInvoiceVO.getSysDocType(): " + eInvoiceDocumentVO.getSysDocType());
			
			if (eInvoiceDocumentVO.getSysDocType().equals(CommonConstant.SYS_NUM_CD_INVC) || eInvoiceDocumentVO.getSysDocType().equals(CommonConstant.SYS_NUM_CD_PAX_STMT)) {
				InvoiceVO invoiceVO = invoiceBO.getInvoiceById(eInvoiceDocumentVO.getRefId());
				invoiceVO.seteInvoiceStatus(eInvoiceDocument.getStatus());
				chartOfAcctBO.updateVO(invoiceVO);
			}
			
			if (eInvoiceDocumentVO.getSysDocType().equals(CommonConstant.SYS_NUM_CD_PURC_BILL)) {
				ExOrderBillVO exOrderBillVO = billPymtBO.getEOBillById(eInvoiceDocumentVO.getRefId());
				exOrderBillVO.seteInvoiceStatus(eInvoiceDocument.getStatus());
				chartOfAcctBO.updateVO(exOrderBillVO);
			}
			
//			eInvoiceVO.setDtCancel(eInvoiceDocument.getCancelDateTimeDt());
			chartOfAcctBO.updateVO(eInvoiceDocumentVO);
			
			// refresh invoice e-Invoice data also
			
			loadEInvoiceDocumentList();
			successResult();
			
//	        invoiceVO.seteInvoiceDocument(eInvoiceDocument);
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	private void loadEInvoiceDocumentList() {
		eInvoiceList = eInvoiceBO.getEInvoiceList(getSessionInfoBean().getCompanyVO().getId());
	}

	public void loadConsolidateDetailsList(EInvoiceDocumentVO docVO) {
