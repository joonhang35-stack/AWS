	public void handleEInvoiceSelected(EInvoiceDocumentVO vo) {
		try {
			eInvoiceDocumentVO = eInvoiceBO.getEInvoiceByUUID(vo.getDocumentUuid());
			EInvoiceUtils.generateValidationQrCode(eInvoiceDocumentVO);
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void handleSnapshotSelected(EInvoiceApiDailySnapshotVO vo) {
		try {
			
			apiDocumentQueryResponseVO = new ApiDocumentQueryResponseVO();
			apiDocumentQueryResponseVO.setResult(new ArrayList<EInvoiceApiDailySnapshotTransVO>());
			
			List<EInvoiceApiDailySnapshotVO> list = eInvoiceBO.getApiDailySnapshotList(vo.getDtTrans());
			
			for (EInvoiceApiDailySnapshotVO snapshotVO : list) {
				JSONObject jsonResponse = new JSONObject(snapshotVO.getJsonResponse());
				
				Gson gson = FunctionUtils.getGsonDateConverter();
				ApiDocumentQueryResponseVO responseVO = gson.fromJson(jsonResponse.toString(), ApiDocumentQueryResponseVO.class);
				
//				System.out.println("CYY responseVO.getResult().size(): " + responseVO.getResult().size());
				apiDocumentQueryResponseVO.getResult().addAll(responseVO.getResult());
			}
			
			for (EInvoiceApiDailySnapshotTransVO document : apiDocumentQueryResponseVO.getResult()) {
//				String iso = document.getDateTimeReceived();
//				Instant instant = Instant.parse(iso);
//				Date date = Date.from(instant);
//				document.setDateTimeReceivedDt(date);
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
