package com.bcs.zsg.purchase.vo;

import com.bcs.zsg.core.vo.BaseVO;
import com.bcs.zsg.sales.vo.IdentityDetailVO;

public class IdentityVO  extends BaseVO {
	private static final long serialVersionUID = 1L;
	
	private String idType;
	private String idTypeName; // Identity Description
	private String idNo;
	private String uuid;
	private Long personId;
	
	private String uploadedFile;
	
	private IdentityDetailVO identityDetailVO;
	
	public String getIdType() {
		return idType;
	}
	public void setIdType(String idType) {
		this.idType = idType;
	}
	public String getIdNo() {
		return idNo;
	}
	public void setIdNo(String idNo) {
		this.idNo = idNo;
	}
	public Long getPersonId() {
		return personId;
	}
	public void setPersonId(Long personId) {
		this.personId = personId;
	}
	
	/**
	 * @return the identityDetailVO
	 */
	public IdentityDetailVO getIdentityDetailVO() {
		return identityDetailVO;
	}
	
	/**
	 * @param identityDetailVO the identityDetailVO to set
	 */
	public void setIdentityDetailVO(IdentityDetailVO identityDetailVO) {
		this.identityDetailVO = identityDetailVO;
	}
	/**
	 * @return the idTypeName
	 */
	public String getIdTypeName() {
		return idTypeName;
	}
	/**
	 * @param idTypeName the idTypeName to set
	 */
	public void setIdTypeName(String idTypeName) {
		this.idTypeName = idTypeName;
	}
	/**
	 * @return the uuid
	 */
	public String getUuid() {
		return uuid;
	}
	/**
	 * @param uuid the uuid to set
	 */
	public void setUuid(String uuid) {
		this.uuid = uuid;
	}
	public String getUploadedFile() {
		return uploadedFile;
	}
	public void setUploadedFile(String uploadedFile) {
		this.uploadedFile = uploadedFile;
	}
}
