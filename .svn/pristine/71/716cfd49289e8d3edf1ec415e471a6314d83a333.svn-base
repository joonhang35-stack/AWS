<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

<div>
<p:dataTable id="idBookingList" value="#{salesBean.bookingList}" var="vo" paginator="true" rows="10" 
	paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
	rowsPerPageTemplate="5,10,15" rowIndexVar="rowIndex">
	<p:columnGroup type="header">
		<p:row>
			<p:column rowspan="2" headerText="Edit" style="width:30px;"/>
			<p:column rowspan="2" headerText="Delete" style="width:30px;"/>
			<p:column rowspan="2" headerText="No." style="width:30px; font-size:10px;"/>
			<p:column rowspan="2" headerText="Customer" style="width:100px; font-size:10px;"/>
			<p:column rowspan="2" headerText="Contact" style="font-size:10px;"/>
			<p:column rowspan="2" headerText="Sales Person"/>
			<p:column rowspan="2" headerText="Booking ID" style="font-size:10px;"/>
			<p:column rowspan="2" headerText="Invoice No." style="font-size:10px;"/>
			<p:column colspan="6" headerText="Full Tour" style="font-size:10px;"/>
			<p:column colspan="6" headerText="Ground Only" style="font-size:10px;"/>
			<p:column rowspan="2" headerText="Payment&lt;br/&gt;Status" style="font-size:10px;"/>
			<p:column rowspan="2" headerText="Expiry" style="font-size:10px;"/>
			<p:column rowspan="2" headerText="Pay" style="font-size:10px;"/>
			<p:column rowspan="2" headerText="Mail" style="font-size:10px;"/>
		</p:row>
		<p:row>
			<p:column headerText="SGL" style="font-size:10px;"/>
			<p:column headerText="TWN" style="font-size:10px;"/>
			<p:column headerText="CTW" style="font-size:10px;"/>
			<p:column headerText="CWB" style="font-size:10px;"/>
			<p:column headerText="CNB" style="font-size:10px;"/>
			<p:column headerText="INFT" style="font-size:10px;"/>
			<p:column headerText="SGL" style="font-size:10px;"/>
			<p:column headerText="TWN" style="font-size:10px;"/>
			<p:column headerText="CTW" style="font-size:10px;"/>
			<p:column headerText="CWB" style="font-size:10px;"/>
			<p:column headerText="CNB" style="font-size:10px;"/>
			<p:column headerText="INFT" style="font-size:10px;"/>
		</p:row>
	</p:columnGroup>
	
	<p:column style="font-size:10px;">
		<p:commandButton icon="ui-icon-pencil" actionListener="#{salesBean.setBookingVO(vo)}" update=":idAddBookingDialog" oncomplete="varAddBookingDialog.show()" disabled="#{vo.pmntStatusCd eq 'KIVEXP' or vo.idCompany ne sessionInfoBean.companyVO.id or sessionInfoBean.employeeVO.department.contains('sale')}"/><!--  or vo.pmntStatusCd eq 'FULL' -->
	</p:column>
	<p:column style="font-size:10px; text-align:center;">
		<p:commandButton icon="ui-icon-close" actionListener="#{salesBean.setBookingVO(vo)}" oncomplete="varCancelBookingDialog.show()" disabled="#{vo.pmntStatusCd eq 'KIVEXP' or vo.idCompany ne sessionInfoBean.companyVO.id or sessionInfoBean.employeeVO.department.contains('sale')}"
			rendered="#{not salesBean.isAgent or (salesBean.isAgent and salesBean.agentCancelBooking)}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{rowIndex + 1}"/>
	</p:column>
	<p:column width="100" style="font-size:10px;">
		<p:commandLink actionListener="#{salesBean.handleBookingSelect(vo)}" update=":idBookingDetailsDialog" oncomplete="varBookingDetailsDialog.show()" style="color:#CC2EFA;">
			<h:outputText value="#{bterp:lookupItemDesc('salutatn', vo.customerVO.salutationCd)} #{vo.custName}" style="text-transform:uppercase;"/>
		</p:commandLink>
	</p:column>
	<p:column width="150" style="font-size:10px;">
        <ui:repeat value="#{vo.customerVO.perContacts.split(',')}" var="cntc" rendered="#{not empty vo.customerVO.perContacts}">
            <h:outputText value="#{salesBean.getContactStrWithCountryPair(cntc,vo.customerVO.countryCode)}"/><br/>
        </ui:repeat>
        <h:outputText value="Email: #{vo.customerVO.email}" rendered="#{not empty vo.customerVO.email}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.employeeViewVO.userVO.name}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.id}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{bterp:sysNumGenVO(vo.idCompany, 'invc').prefixid}#{vo.invCode}" rendered="#{not empty vo.invCode}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.paxFullSgl}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.paxFullTwn}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.paxFullCtw}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.paxFullCeb}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.paxFullCnb}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.paxFullInft}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.paxGrndSgl}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.paxGrndTwn}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.paxGrndCtw}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.paxGrndCeb}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.paxGrndCnb}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.paxGrndInft}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{zsg:referenceDataValue('BOOK_PMNT_STATUS', vo.pmntStatusCd)}"/>
	</p:column>
	<p:column style="text-align:center; font-size:10px;">
		<h:outputText value="#{vo.dtExp}" rendered="#{vo.pmntStatusCd eq 'KIV'}">
			<f:convertDateTime pattern="dd-MMM-yyyy"/>
		</h:outputText>
		<!--h:outputText value="" rendered="#{vo.pmntStatusCd eq 'FULL'}"/-->
	</p:column>
	<p:column>
		<p:commandButton value="Pay" actionListener="#{salesBean.makePayment_eInvoice(vo)}" disabled="#{vo.pmntStatusCd eq 'KIVEXP' or vo.pmntStatusCd eq 'FULL' or vo.idCompany ne sessionInfoBean.companyVO.id}"/>
	</p:column>
	<p:column style="font-size:10px; text-align:center;"><h:outputLink styleClass="ui-icon ui-icon-mail-closed" value="#{request.contextPath}/app/emailtmp/bookingemailtmp?tourDepId=#{vo.id}&amp;bookingId=#{vo.id}" target="_blank"/></p:column>
	
	<p:columnGroup type="footer" rendered="#{not empty salesBean.bookingList}">
		<p:row>
			<p:column colspan="8" footerText="Total" style="font-size:10px;"/>
			<p:column footerText="#{salesBean.bookingList.get(0).totPaxFullSgl}" style="font-size:10px;"/>
			<p:column footerText="#{salesBean.bookingList.get(0).totPaxFullTwn}" style="font-size:10px;"/>
			<p:column footerText="#{salesBean.bookingList.get(0).totPaxFullCtw}" style="font-size:10px;"/>
			<p:column footerText="#{salesBean.bookingList.get(0).totPaxFullCeb}" style="font-size:10px;"/>
			<p:column footerText="#{salesBean.bookingList.get(0).totPaxFullCnb}" style="font-size:10px;"/>
			<p:column footerText="#{salesBean.bookingList.get(0).totPaxFullInft}" style="font-size:10px;"/>
			<p:column footerText="#{salesBean.bookingList.get(0).totPaxGrndSgl}" style="font-size:10px;"/>
			<p:column footerText="#{salesBean.bookingList.get(0).totPaxGrndTwn}" style="font-size:10px;"/>
			<p:column footerText="#{salesBean.bookingList.get(0).totPaxGrndCtw}" style="font-size:10px;"/>
			<p:column footerText="#{salesBean.bookingList.get(0).totPaxGrndCeb}" style="font-size:10px;"/>
			<p:column footerText="#{salesBean.bookingList.get(0).totPaxGrndCnb}" style="font-size:10px;"/>
			<p:column footerText="#{salesBean.bookingList.get(0).totPaxGrndInft}" style="font-size:10px;"/>
			<p:column colspan="4"/>
		</p:row>
		<p:row>
			<p:column colspan="4" footerText="Travel Insurance Policy (Single)" style="font-size:10px;"/>
			<p:column colspan="20" footerText="#{salesBean.tourDepVO.travelInsPolicyS}" style="font-size:10px;"/>
		</p:row>
		<p:row>
			<p:column colspan="4" footerText="Travel Insurance Policy (Family)" style="font-size:10px;"/>
			<p:column colspan="20" footerText="#{salesBean.tourDepVO.travelInsPolicyF}" style="font-size:10px;"/>
		</p:row>
	</p:columnGroup>
</p:dataTable>
</div>
<h:panelGrid columns="1">
	<p:commandButton value="#{msg['common.button.label.cancel']}" onclick="varBookingListDialog.hide()"/>
</h:panelGrid>
</ui:composition>