package com.bcs.zsg.web.object;

public class objFlightSchedule {

	public int ID;
	public String type;
	public String flightCode;
	public String flightFrom;
	public String flightTo;
	public String estDeparture;
	public String estArrival;
	public String remarks;
	public String ASI;
	public String ASIseq;
	
	public void setID(int tempStr)
	{
		ID = tempStr;
	}
	
	public int getID()
	{
		return ID;
	}
	
	public String getType()
	{
		return 	type;
	}

	public void setType(String tempStr)
	{
		type = tempStr;
	}

	public String getFlightCode()
	{
		return 	flightCode;
	}

	public void setFlightCode(String tempStr)
	{
		flightCode = tempStr;
	}
	
	public String getFlightFrom()
	{
		return 	flightFrom;
	}

	public void setFlightFrom(String tempStr)
	{
		flightFrom = tempStr;
	}
	
	public String getFlightTo()
	{
		return 	flightTo;
	}

	public void setFlightTo(String tempStr)
	{
		flightTo = tempStr;
	}

	public String getEstDeparture()
	{
		return 	estDeparture;
	}

	public void setEstDeparture(String tempStr)
	{
		estDeparture = tempStr;
	}
	
	public String getEstArrival()
	{
		return 	estArrival;
	}

	public void setEstArrival(String tempStr)
	{
		estArrival = tempStr;
	}
	

	public String getRemarks()
	{
		return 	remarks;
	}

	public void setRemarks(String tempStr)
	{
		remarks = tempStr;
	}

	public String getASI() {
		return ASI;
	}

	public void setASI(String ASI) {
		this.ASI = ASI;
	}

	public String getASIseq() {
		return ASIseq;
	}

	public void setASIseq(String aSIseq) {
		ASIseq = aSIseq;
	}
}
