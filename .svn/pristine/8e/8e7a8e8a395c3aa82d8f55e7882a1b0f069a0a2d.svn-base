package com.bcs.zsg.web.object;

import java.util.Date;

public class objTicketing {
	public String airlineCode;
	public String airlineDesc;
	public String remark;
	public String destination;
	public String fareFrom;

	public Date bookDateStart;
	public Date bookDateEnd;
	public Date travelDateStart;
	public Date travelDateEnd;
	public String ticketDesc;
	
	public objTicketing()
	{
		
	}
	public void setAirlineCode(String tempStr)
	{
		airlineCode = tempStr;
	}
	
	public String getAirlineCode()
	{
		return airlineCode;
	}

	public void setAirlineDesc(String tempStr)
	{
		airlineDesc = tempStr;
	}
	
	public String getAirlineDesc()
	{
		return airlineDesc;
	}
	public void setRemark(String tempStr)
	{
		remark = tempStr;
	}
	
	public String getRemark()
	{
		return remark;
	}

	public void setDestination(String tempStr)
	{
		destination = tempStr;
	}
	
	public String getDestination()
	{
		return destination;
	}
	
	
	public void setFareFrom(String tempStr)
	{
		fareFrom = tempStr;
	}
	
	public String getFareFrom()
	{
		return fareFrom;
	}
	
	public void setBookDateStart(Date tempStr)
	{
		bookDateStart = tempStr;
	}
	
	public Date getBookDateStart()
	{
		return bookDateStart;
	}
	

	public void setBookDateEnd(Date tempStr)
	{
		bookDateEnd = tempStr;
	}
	
	public Date getBookDateEnd()
	{
		return bookDateEnd;
	}
	

	public void setTravelDateStart(Date tempStr)
	{
		travelDateStart = tempStr;
	}
	
	public Date getTravelDateStart()
	{
		return travelDateStart;
	}
	


	public void setTravelDateEnd(Date tempStr)
	{
		travelDateEnd = tempStr;
	}
	
	public Date getTravelDateEnd()
	{
		return travelDateEnd;
	}
	public String getTicketDesc() {
		return ticketDesc;
	}
	public void setTicketDesc(String ticketDesc) {
		this.ticketDesc = ticketDesc;
	}
}
