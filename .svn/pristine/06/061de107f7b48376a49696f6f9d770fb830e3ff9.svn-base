															<a target="_blank"
																href="https://aws.applevacations.my:2022/aws#{itineryVO.path}/#{bterpBean.urlEncoder(itineryVO.name)}"
																style="color: #0040FF;">Find out more</a>
															<c:if test="#{idx eq '0'}">
																<c:set var="idx" value="1" />
															</c:if>
														</c:if>
														<c:if
															test="#{itineryVO.typeCd eq 'CUST' and itineryVO.langCd eq 'ZH'}">
															<a target="_blank"
																href="https://aws.applevacations.my:2022/aws#{itineryVO.path}/#{bterpBean.urlEncoder(itineryVO.name)}"
																style="color: #0040FF;">Find out more</a>
															<c:if test="#{idx eq '0'}">
