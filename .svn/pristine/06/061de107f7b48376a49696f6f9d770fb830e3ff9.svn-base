															<td>Bill To:</td>
															<td><h:outputText
																	value="#{bterp:lookupItemDesc('salutatn', bterpBean.bookingViewVO.customerVO.personVO.salutation)} #{bterpBean.bookingViewVO.customerVO.personVO.lastName} #{bterpBean.bookingViewVO.customerVO.personVO.givenName}" /></td>
															<td>&nbsp;</td>
															<td>Payment Status:</td>
															<td><h:outputText value="Enquiry"
																	rendered="#{bterpBean.bookingViewVO.pmntStatusCd eq 'KIV'}" />
																<h:outputText value="Deposit Paid"
																	rendered="#{bterpBean.bookingViewVO.pmntStatusCd eq 'DEP'}" />
																<h:outputText value="Full Paid"
																	rendered="#{bterpBean.bookingViewVO.pmntStatusCd eq 'FULL'}" />
															</td>
														</tr>
														<tr>
															<td>Mobile No.:</td>
															<td><ui:repeat
																	value="#{bterpBean.bookingViewVO.customerVO.personContactList}"
																	var="tel">
																	<h:outputText value="#{tel.number}"
																		rendered="#{tel.typeCd eq 'mobile'}" />
																</ui:repeat> <ui:repeat
																	value="#{bterpBean.bookingViewVO.customerVO.corContactList}"
																	var="tel">
																	<h:outputText value="#{tel.contactNo}"
																		rendered="#{tel.contactType eq 'mobile'}" />
																</ui:repeat></td>
