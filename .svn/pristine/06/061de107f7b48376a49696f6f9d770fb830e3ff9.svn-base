<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:p="http://primefaces.org/ui"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

<c:set var="contextPath" value="${request.contextPath}" />
<f:view contentType="text/html" locale="#{localeBean.locale}">
	<h:head>
		<f:facet name="first">
			<meta http-equiv="X-UA-Compatible" content="EmulateIE8" />
			<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
			<title>Enquiry</title>
		</f:facet>
		<script type="text/javascript">
			/* window.onload = function(){
				var template = document.getElementById("body").innerHTML;
				document.getElementById("contentForm:hidContent").value = template;
				templateCommand();
				sendMessage();
			} */
		</script>
	</h:head>

<h:form id="contentForm">
	<p:outputPanel>
		<h:inputHidden value="#{bterpBean.template}" id="hidContent"></h:inputHidden>
		<p:remoteCommand name="templateCommand" process="contentForm:hidContent"></p:remoteCommand>
		<p:remoteCommand name="sendMessage" actionListener="#{bterpBean.sendMessage}"></p:remoteCommand>
	</p:outputPanel>
	</h:form>
<body id="body">
	<style type="text/css">
	body, tr, td {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 14px;
		margin-left: 0px;
		margin-top: 0px;
		margin-right: 0px;
		margin-bottom: 0px;
	}
	
	.font {
		/*font-family:"Times New Roman", Times, serif;
		font-style:italic;*/
		
	}
	
	.font-2 {
		font-weight: bold;
	}
	
	.font-corporate {
		font-weight: bold;
		color: #7c51a1
	}
	</style>
	
	<div id="template">
			<c:if test="#{empty bterpBean.bookingViewVO}">
				<table width="100%" height="100%" border="0" cellspacing="0"
					cellpadding="0">
					<tr>
						<td align="left" valign="top">Dear Sir / Madam,<br />Thank
							you for giving us an opportunity to serve you.<br />
						<br /> Attach here with the details of your requested tour for
							your kind reference:
							<table width="95%" border="0" cellspacing="10" cellpadding="0">
								<tbody>
									<tr>
										<td>
											<table width="100%" border="0" cellspacing="0"
												cellpadding="0">
												<tr>
													<td height="33" align="left" valign="top" class="font">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top" class="font-2">&nbsp;</td>
												</tr>
												<tr>
													<td width="15%" align="left" valign="top" class="font">Tour
														Name</td>
													<td width="2%" align="left" valign="top">:</td>
													<td width="83%" align="left" valign="top" class="font-2"><h:outputText
															value="#{bterpBean.tourDepVO.numDays}D#{bterpBean.tourDepVO.numNights}N  #{bterpBean.tourPkgVO.nameEn} #{bterpBean.tourPkgVO.nameZh} #{bterpBean.tourPkgVO.nameOther}" /></td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
												</tr>
												<tr>
													<td width="15%" align="left" valign="top" class="font">Tour
														Code</td>
													<td width="2%" align="left" valign="top">:</td>
													<td width="83%" align="left" valign="top" class="font-2"><h:outputText
															value="#{bterpBean.tourDepVO.code}" /></td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
												</tr>
												<tr>
													<td align="left" valign="top" class="font">Tour
														Itinerary</td>
													<td align="left" valign="top">:</td>
													<td align="left" valign="top"><c:set var="idx"
															value="0" /> <c:forEach
															items="#{bterpBean.tourDepVO.tourItineryList}"
															var="itineryVO">
															<c:if test="#{idx eq '1'}">
																<h:outputText value=" or " />
																<c:set var="idx" value="2" />
															</c:if>
															<c:if
																test="#{itineryVO.typeCd eq 'CUST' and itineryVO.langCd eq 'EN'}">
																<a target="_blank"
																	href="https://aws.applevacations.my:2022/aws#{itineryVO.path}/#{bterpBean.urlEncoder(itineryVO.name)}"
																	style="color: #0040FF;">Find out more</a>
																<c:if test="#{idx eq '0'}">
																	<c:set var="idx" value="1" />
																</c:if>
															</c:if>
															<c:if
																test="#{itineryVO.typeCd eq 'CUST' and itineryVO.langCd eq 'ZH'}">
																<a target="_blank"
																	href="https://aws.applevacations.my:2022/aws#{itineryVO.path}/#{bterpBean.urlEncoder(itineryVO.name)}"
																	style="color: #0040FF;">Find out more</a>
																<c:if test="#{idx eq '0'}">
																	<c:set var="idx" value="1" />
																</c:if>
															</c:if>
														</c:forEach></td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
												</tr>
												<tr>
													<td align="left" valign="top" class="font">Check-in
														Date</td>
													<td align="left" valign="top">:</td>
													<td align="left" valign="top" class="font-2"><h:outputText
															value="#{bterpBean.tourDepVO.dtDep}">
															<f:convertDateTime pattern="dd-MMM-yyyy" />
														</h:outputText></td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
												</tr>
												<tr>
													<td colspan="3" align="left" valign="top"><hr /></td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
												</tr>
												<tr>
													<td align="left" valign="top" class="font">Full tour
														fare/Per traveler</td>
													<td align="left" valign="top">:</td>
													<td align="left" valign="top">
														<table width="95%" border="1" cellspacing="0"
															cellpadding="2">
															<tr class="font-2">
																<td height="28" colspan="2" align="center"
																	valign="middle">ADULT</td>
																<td colspan="3" align="center" valign="middle">CHILD</td>
															</tr>
															<tr>
																<td width="20%" align="center" valign="middle">TWIN</td>
																<td width="20%" align="center" valign="middle">SINGLE</td>
																<td width="20%" align="center" valign="middle">CHILD
																	TWIN</td>
																<td width="20%" align="center" valign="middle">CHILD
																	WITH BED</td>
																<td width="20%" align="center" valign="middle">CHILD
																	NO BED</td>
															</tr>
															<tr class="font-2">
																<td align="center" valign="middle">RM <h:outputText
																		value="#{bterpBean.tourDepVO.fullTwn}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle">RM <h:outputText
																		value="#{bterpBean.tourDepVO.fullSgl}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle">RM <h:outputText
																		value="#{bterpBean.tourDepVO.fullCtw}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle">RM <h:outputText
																		value="#{bterpBean.tourDepVO.fullCeb}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle">RM <h:outputText
																		value="#{bterpBean.tourDepVO.fullCnb}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
															</tr>
														</table>
													</td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
												</tr>
												<tr>
													<td align="left" valign="top" class="font">Ground
														fare/Per traveler</td>
													<td align="left" valign="top">:</td>
													<td align="left" valign="top">
														<table width="95%" border="1" cellspacing="0"
															cellpadding="2">
															<tr class="font-2">
																<td height="28" colspan="2" align="center"
																	valign="middle">ADULT</td>
																<td colspan="3" align="center" valign="middle">CHILD</td>
															</tr>
															<tr>
																<td width="20%" align="center" valign="middle">TWIN</td>
																<td width="20%" align="center" valign="middle">SINGLE</td>
																<td width="20%" align="center" valign="middle">CHILD
																	TWIN</td>
																<td width="20%" align="center" valign="middle">CHILD
																	WITH BED</td>
																<td width="20%" align="center" valign="middle">CHILD
																	NO BED</td>
															</tr>
															<tr class="font-2">
																<td align="center" valign="middle">RM <h:outputText
																		value="#{bterpBean.tourDepVO.grndTwn}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle">RM <h:outputText
																		value="#{bterpBean.tourDepVO.grndSgl}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle">RM <h:outputText
																		value="#{bterpBean.tourDepVO.grndCtw}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle">RM <h:outputText
																		value="#{bterpBean.tourDepVO.grndCeb}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle">RM <h:outputText
																		value="#{bterpBean.tourDepVO.grndCnb}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
															</tr>
														</table>
													</td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
												</tr>
												<tr>
													<td align="left" valign="top"><span class="font">Miscellaneous
															Charges/Per traveler</span></td>
													<td align="left" valign="top">:</td>
													<td align="left" valign="top">
														<table width="95%" border="1" cellspacing="0"
															cellpadding="2">
															<tr class="font-2">
																<td width="5%" height="25" align="center"
																	valign="middle">VISA</td>
																<td width="5%" align="center" valign="middle">A/C</td>
																<td width="5%" align="center" valign="middle">TIPPING</td>
																<td width="9%" align="center" valign="middle">AIRPORT TAX<br />(ADULT / CHILD)</td>
																<td width="9%" align="center" valign="middle">YQ
																	&amp; FUEL<br />(ADULT / CHILD)
																</td>
																<td width="5%" align="center" valign="middle">TRAVEL
																	INSURANCE</td>
																<td width="5%" align="center" valign="middle">OTHERS</td>
																<td width="9%" align="center" valign="middle">TOTAL<br />(ADULT / CHILD)
																</td>
																<c:choose>
																	<c:when test="#{bterpBean.department eq 'wholesale'}">
																		<td width="3%" align="center" valign="middle">AC/SI</td>
																	</c:when>
																	<c:otherwise>
																		<td width="1%" align="center" valign="middle" rowspan="2"></td>
																		<td width="1%" align="center" valign="middle" rowspan="2"></td>
																		<td width="1%" align="center" valign="middle" rowspan="2"></td>
																	</c:otherwise>
																</c:choose>
																<td width="5%" align="center" valign="middle">DEVIATION</td>
																<td width="15%" align="center" valign="middle">REMARK</td>
															</tr>
															<tr>
																<td align="center" valign="middle"><h:outputText
																		value="#{bterpBean.tourDepVO.airlineVisa}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle"><h:outputText
																		value="#{bterpBean.tourDepVO.airlineAC}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle"><h:outputText
																		value="#{bterpBean.tourDepVO.airlineTipping}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle"><h:outputText
																		value="#{bterpBean.tourDepVO.airlineAptAdt}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText> / <h:outputText
																		value="#{bterpBean.tourDepVO.airlineAptChd}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle"><h:outputText
																		value="#{bterpBean.tourDepVO.airlineYqAdt}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText> / <h:outputText
																		value="#{bterpBean.tourDepVO.airlineYqChd}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle"><h:outputText
																		value="#{bterpBean.tourDepVO.airlineTrvlIns}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle"><h:outputText
																		value="#{bterpBean.tourDepVO.airlineExtra}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle" class="font-2"><h:outputText
																		value="#{bterpBean.tourDepVO.airlineTotAdt}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText> / <h:outputText
																		value="#{bterpBean.tourDepVO.airlineTotChd}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<c:if test="#{bterpBean.department eq 'wholesale'}">
																	<td align="center" valign="middle">
																		<h:outputText value="#{bterpBean.tourDepVO.cnaAdt}" rendered="#{bterpBean.tourDepVO.cnaAdt % 1 &gt; 0}">
																			<f:convertNumber pattern="#,##0.00" />
																		</h:outputText>
																		<h:outputText value="#{bterpBean.tourDepVO.cnaAdt}" rendered="#{bterpBean.tourDepVO.cnaAdt % 1 &lt;= 0}">
																			<f:convertNumber pattern="#,##0" />
																		</h:outputText>
																		<h:outputText value="/" />
																		<h:outputText value="#{bterpBean.tourDepVO.csiAdt}" rendered="#{bterpBean.tourDepVO.csiAdt % 1 &gt; 0}">
																			<f:convertNumber pattern="#,##0.00" />
																		</h:outputText>
																		<h:outputText value="#{bterpBean.tourDepVO.csiAdt}" rendered="#{bterpBean.tourDepVO.csiAdt % 1 &lt;= 0}">
																			<f:convertNumber pattern="#,##0" />
																		</h:outputText>
																	</td>
																</c:if>
																<td align="center" valign="middle"><h:outputText
																		value="#{bterpBean.tourDepVO.airlineDeviation}">
																		<f:convertNumber pattern="#,##0.00" />
																	</h:outputText></td>
																<td align="center" valign="middle"><h:outputText
																		value="#{bterpBean.tourDepVO.airlineScheduleVO.remarks}" /></td>
															</tr>
														</table>
													</td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
												</tr>
												<tr>
													<td align="left" valign="top"><span class="font">Total
															Full tour fare (Adult/per traveler)</span></td>
													<td align="left" valign="top">:</td>
													<td align="left" valign="top" class="font-2"><h:outputText
															value="#{bterpBean.tourDepVO.fullTwn + bterpBean.tourDepVO.airlineTotAdt}">
															<f:convertNumber pattern="RM #,##0.00" />
														</h:outputText> (ADULT TWIN + Miscellaneous TOTAL only)</td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">- <span class="font-2">Taxes
															and price are subjected to change</span>.
													</td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
												</tr>
												<tr>
													<td align="left" valign="top"><span class="font">Airline</span></td>
													<td align="left" valign="top">:</td>
													<td align="left" valign="top" class="font-2"><h:outputText
															value="#{bterpBean.tourDepVO.airlineVO.desc} " /></td>
												</tr>
												<tr>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
													<td align="left" valign="top">&nbsp;</td>
												</tr>
												<c:if test="#{bterpBean.tourDepVO.isShowAirline}">
													<tr>
														<td align="left" valign="top"><span class="font">Flight Schedule</span></td>
														<td align="left" valign="top">:</td>
														<td align="left" valign="top">
															<table width="95%" border="1" cellspacing="0"
																cellpadding="2">
																<tr class="font-2">
																	<td width="10%" height="25" align="center" valign="middle">TYPE</td>
																	<td width="10%" align="center" valign="middle">DEPT DT</td>
																	<td width="10%" align="center" valign="middle">ARR DT</td>
																	<td width="10%" align="center" valign="middle">CODE</td>
																	<td width="10%" align="center" valign="middle">FROM</td>
																	<td width="10%" align="center" valign="middle">TO</td>
																	<td width="10%" align="center" valign="middle">ETD</td>
																	<td width="10%" align="center" valign="middle">ETA</td>
																	<td width="30%" align="center" valign="middle">REMARK</td>
																</tr>
																<c:forEach
																	items="#{bterpBean.tourDepVO.airlineScheduleVO.airlineScheduleItemList}"
																	var="vo">
																	<tr>
																		<td align="center" valign="middle"><h:outputText
																				value="#{vo.typeCd}" /></td>
																		<td align="center" valign="middle"><h:outputText
																				value="#{vo.departureDate}" >
																				<f:convertDateTime pattern="dd-MMM-yyyy"/></h:outputText></td>
																		<td align="center" valign="middle"><h:outputText
																				value="#{vo.arrivalDate}" >
																				<f:convertDateTime pattern="dd-MMM-yyyy"/></h:outputText></td>
																		<td align="center" valign="middle"><h:outputText
																				value="#{vo.flightCd}" /></td>
																		<td align="center" valign="middle"><h:outputText
																				value="#{vo.fromAirportCd}" /></td>
																		<td align="center" valign="middle"><h:outputText
																				value="#{vo.toAirportCd}" /></td>
																		<td align="center" valign="middle"><h:outputText
																				value="#{vo.etd}" /></td>
																		<td align="center" valign="middle"><h:outputText
																				value="#{vo.eta}" /></td>
																		<td align="center" valign="middle"><h:outputText
																				value="#{vo.remarks}" /></td>
																	</tr>
																</c:forEach>
															</table>
														</td>
													</tr>
													<tr>
														<td align="left" valign="top">&nbsp;</td>
														<td align="left" valign="top">&nbsp;</td>
														<td align="left" valign="top">&nbsp;</td>
													</tr>
												</c:if>
												<tr>
													<td align="left" valign="top"><span class="font">Deposit/Per
															traveler</span></td>
													<td align="left" valign="top">:</td>
													<td align="left" valign="top" class="font-2"><h:outputText
															value="#{bterpBean.tourPkgVO.deposit}">
															<f:convertNumber pattern="RM #,##0.00" />
														</h:outputText></td>
												</tr>
