<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.sales.vo">

    <class table="tour_booking_charge_item" name="BookingChargeItemVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idBooking" type="long" column="id_tour_booking"/>
        <property name="idAcct" type="long" column="id_acct"/>
        <property name="idInvEoItem" type="long" column="id_inv_eo_item"/>
        <property name="code" type="string" column="code"/>
        <property name="desc" type="string" column="description"/>
        <property name="quantity" type="integer" column="quantity"/>
        <property name="amount" type="double" column="amount"/>
        <property name="airfare" type="double" column="airfare"/>
        <property name="typeCd" type="string" column="type_cd"/>
        <property name="isLock" type="boolean" column="is_lock"/>
        
        <property name="idTourCruiseCabin" type="long" column="id_tour_cruise_cabin"/>
        <property name="quantity3" type="integer" column="quantity_3"/>
        <property name="quantity4" type="integer" column="quantity_4"/>
        <property name="quantitySgl" type="integer" column="quantity_sgl"/>
        <property name="quantity3Chd" type="integer" column="quantity_3_chd"/>
        <property name="quantity4Chd" type="integer" column="quantity_4_chd"/>
        <property name="quantityInf" type="integer" column="quantity_inf"/>
        <property name="cabinQty" type="integer" column="cabin_qty"/>
        <property name="amount3" type="double" column="amount_3"/>
        <property name="amount4" type="double" column="amount_4"/>
        <property name="amountSgl" type="double" column="amount_sgl"/>
        <property name="amount3Chd" type="double" column="amount_3_chd"/>
        <property name="amount4Chd" type="double" column="amount_4_chd"/>
        <property name="amountInf" type="double" column="amount_inf"/>
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>