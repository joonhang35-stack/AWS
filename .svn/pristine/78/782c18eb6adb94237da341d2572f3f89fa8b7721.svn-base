	/**
	 * Handle account set field
	 */
	public void handleAcct(boolean addNewCountry) {
		try {
			if (searchParamVO.getObj2() == null) {
				tourThemeList = null;
				tourThemeVO.setIdTourCat(null);
				tourThemeVO.setIdAcct(null);
				tourThemeVO.setAcctCd(null);
				return;
			}
			tourThemeVO.setIdTourCat(Long.parseLong((String) searchParamVO.getObj2()));
			
			if (CollectionUtils.isNotEmpty(tourCatViewList)) {
				for (TourCatViewVO vo : tourCatViewList) {
					if (Long.parseLong((String) searchParamVO.getObj2()) == vo.getId()) {
						tourCatViewVO = vo;
						break;
					}
				}
			}
			if(addNewCountry) {
				specTourThemeList = tourPkgBO.getSpecTourThemeList(tourThemeVO);
			}else {
				specTourThemeList = new ArrayList<TourThemeVO>();
			}
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * 
	 * @param flag
	 */
	public void handleTourCatSelect(boolean flag) {
		try {
			trackingLogUtils.startLogs();
			tourPkgActiveIndex = 0;
			
			tourRoomTypeList = tourPkgBO.getRoomTypeList();
			
			if (flag) {
				if (searchParamVO.getObj2() != null) {
					tourThemeList = tourPkgBO.getTourThemeList(searchParamVO, 2);
					
					// get country list
					countryList = getCountryListByRegion(Long.parseLong((String) searchParamVO.getObj2()));
				}
				handleAcct(true);

			} else {
				if (tourThemeVO.getIdTourCat().equals(0L)) {
					tourThemeList = null;
					tourThemeVO.setIdTourCat(null);
					tourThemeVO.setIdAcct(null);
					tourThemeVO.setAcctCd(null);
					return;
				}
				// get country list
				countryList = getCountryListByRegion(tourThemeVO.getIdTourCat());
				// set account
				for (TourCatViewVO vo : tourCatViewList) {
					if (tourThemeVO.getIdTourCat().equals(vo.getId())) {
						tourCatViewVO = vo;
						break;
					}
				}
			}
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("handleTourCatSelect");
		}
	}
	
	public void handleTourCountrySelect(boolean flag) {
		try {
			trackingLogUtils.startLogs();
			if (flag) {
				if (searchParamVO.getObj2() != null) {
					tourCountryList = tourPkgBO.getTourThemeList(searchParamVO, 2);
					// get country list
				}
			} else {
				specTourThemeList = new ArrayList<>();
				specTourThemeList.addAll(tourPackageBO.getTourThemeList(new SearchParamVO(), Long.valueOf(tourPkgVO.getIdCountry())));
			}
		} catch(Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("handleTourCountrySelect");
		}
	}
	
	/**
	 * Handle tour theme selection
	 * @param vo
	 */
	public void handleTourThemeSelect(TourThemeVO vo) {
		try {
			tourThemeVO = (TourThemeVO) vo.clone();
			bakTourThemeVO = (TourThemeVO) vo.clone();
			
			tourThemeVO.setCountryList(tourPackageBO.getThemeCountryList(tourThemeVO.getId()));
			
			tourThemeVO.setSelectedCountries(new Long[tourThemeVO.getCountryList().size()]);
			for (int i = 0; i < tourThemeVO.getSelectedCountries().length; i++) {
				tourThemeVO.getSelectedCountries()[i] = tourThemeVO.getCountryList().get(i).getIdCountry();
			}
			
			specTourThemeList = tourPkgBO.getSpecTourThemeList(vo);
		
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("handleTourThemeSelect");
		}
	}
	
