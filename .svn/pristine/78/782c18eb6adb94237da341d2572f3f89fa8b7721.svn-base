	/**
	 * Initialization
	 * @param flag - 0 = TOUR / 1 = FNE / 2 = MICE
	 */
	@SuppressWarnings("unchecked")
	public void init(int flag) {
		try { 
			trackingLogUtils = new TrackingLogUtils(this.getClass());
			
			// initial search param
			initSearchParam();
			loadFilterContinentList();
			loadFilterCountryList();
			
			if (flag == 0) {
				searchParamVO.setObj1(ProductConstant.TYPE_TOUR);
				// get airline list
				//loadAirlineList();
			} else if (flag == 1) {
				searchParamVO.setObj1(ProductConstant.TYPE_FNE);
			} else if (flag == 4) {
				searchParamVO.setObj1(ProductConstant.TYPE_CRUISE);
				tourDepositByPercent = false;
				tourDiscountByPercent = false;
			}
			
			// reset form
			resetForm(); 
			
			List<UserRoleViewVO> userRoleList = securityBO.getUserRoleListByUser(this.getSessionInfoBean().getUserVO().getUuid());
			if (CollectionUtils.isNotEmpty(userRoleList)) {
				for (UserRoleViewVO userRoleVO : userRoleList) {
					if (userRoleVO.getRoleCode().equals(SalesConstant.SALES_MANAGER_ROLE)) {
						isSalesManager = true;
					}
					if (userRoleVO.getRoleCode().equals(SalesConstant.BOOKING_SALES_PERSON_ROLE)) {
						salesPersonAuth = true;
					}
					if (userRoleVO.getRoleCode().equals(SalesConstant.ASST_SALES_MANAGER_ROLE)) {
						isAsstSalesManager = true;
					}
				}
			}
			

			// get tour package > departure filter Y/N
			tourPkgDepFilter = appSettingBO.getAppSettingByCode(ConstantAppSetting.ADMIN_TOUR_PKG_DEP_LIST_FILTER_FUNC).getValue();
			// get company list
			companyList = corporateProfileBO.getCompanyList();
			// query employee list
			employeeList = userBO.getEmployeeViewList(getSessionInfoBean().getCompanyVO().getId(), null);
			// get category list
			tourCatViewList = tourCatBO.getTourCatViewList(searchParamVO);
			// get itinery path
			destinationPathFNEItinery = LookupItemUtils.getGlobalConfigValue(MaintConstant.GLOBAL_CD_GLOBAL, MaintConstant.GLOBAL_CD_PATH_FNE_ITITNERY);
			destinationPathTOURItinery = LookupItemUtils.getGlobalConfigValue(MaintConstant.GLOBAL_CD_GLOBAL, MaintConstant.GLOBAL_CD_PATH_TOUR_ITINERY);
			destinationPathTOURImage = LookupItemUtils.getGlobalConfigValue(MaintConstant.GLOBAL_CD_GLOBAL, MaintConstant.GLOBAL_CD_PATH_TOUR);
			destinationPathTOURDailyItinerary = "/upload/dailyitinerary/itinerary/tour";

			tourRemarksVO = new TourPackageRemarksVO();
			
			refDataListSeason = LookupUtils.getReferenceDataList("SEASON");
			
			yearList = new ArrayList<>();
			int maxYearRange = Integer.valueOf(SystemProperty.LISTING_YEAR_RANGE);
			SimpleDateFormat yearFormat = new SimpleDateFormat("yyyy");
			Calendar cal = Calendar.getInstance();
			cal.setTime(new Date());
			String currentYear = yearFormat.format(cal.getTime());
			yearList.add(currentYear);
			for (int i = 1; i < maxYearRange; i++) {
				cal.add(Calendar.YEAR, 1);
				String nextYear = yearFormat.format(cal.getTime());
				yearList.add(nextYear);
			}
			// Get Allowed Discount to add
			validateDiscountLimit();
			validateCommisionLimit();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
