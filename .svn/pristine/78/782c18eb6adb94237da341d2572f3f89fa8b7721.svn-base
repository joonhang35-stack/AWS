	public void handleOpPicChange(String type) {
		if ("PKG".equals(type)) {
			tourPkgVO.setOpPicName("");
			if (CollectionUtils.isNotEmpty(tourPkgVO.getOpPicList()) && CollectionUtils.isNotEmpty(employeeList)) {
				for (String pic : tourPkgVO.getOpPicList()) {
					for (EmployeeViewVO vo : employeeList) {
						if (vo.getId().longValue() == Long.parseLong(pic)) {
							if (StringUtils.isBlank(tourPkgVO.getOpPicName())) {
								tourPkgVO.setOpPicName(vo.getUserVO().getName());
							} else {
								tourPkgVO.setOpPicName(tourPkgVO.getOpPicName() + ", " + vo.getUserVO().getName());
							}
							break;
						}
					}
				}
				tourPkgVO.setOpPic(StringUtils.join(tourPkgVO.getOpPicList(), ','));
			} else {
				tourPkgVO.setOpPic(null);
			}
		} else {
			tourDepVO.setOpPicName("");
			if (CollectionUtils.isNotEmpty(tourDepVO.getOpPicList()) && CollectionUtils.isNotEmpty(employeeList)) {
				for (String pic : tourDepVO.getOpPicList()) {
					for (EmployeeViewVO vo : employeeList) {
						if (vo.getId().longValue() == Long.parseLong(pic)) {
							if (StringUtils.isBlank(tourDepVO.getOpPicName())) {
								tourDepVO.setOpPicName(vo.getUserVO().getName());
							} else {
								tourDepVO.setOpPicName(tourDepVO.getOpPicName() + ", " + vo.getUserVO().getName());
							}
							break;
						}
					}
				}
				tourDepVO.setOpPic(StringUtils.join(tourDepVO.getOpPicList(), ','));
			} else {
				tourDepVO.setOpPic(null);
			}
		}
	}
	
	public void handlePrivatePicChange(String type) { // "Param - String type" not using currently
		tourDepVO.setPrivatePicName("");
		if (CollectionUtils.isNotEmpty(tourDepVO.getPrivatePicList()) && CollectionUtils.isNotEmpty(employeeList)) {
			for (String pic : tourDepVO.getPrivatePicList()) {
				for (EmployeeViewVO vo : employeeList) {
					if (vo.getId().longValue() == Long.parseLong(pic)) {
						if (StringUtils.isBlank(tourDepVO.getPrivatePicName())) {
							tourDepVO.setPrivatePicName(vo.getUserVO().getName());
						} else {
							tourDepVO.setPrivatePicName(tourDepVO.getPrivatePicName() + ", " + vo.getUserVO().getName());
						}
						break;
					}
				}
			}
			tourDepVO.setPrivatePic(StringUtils.join(tourDepVO.getPrivatePicList(), ','));
		} else {
			tourDepVO.setPrivatePic(null);
		}
	}
	
	public void validateDiscountLimit() throws BusinessException {
		appSettingVO = appSettingBO.getAppSettingByCode(ConstantAppSetting.SALES_TOUR_DEPARTURE_DISCOUNT_LIMIT);
		
		if (appSettingVO != null) {
			discountLimit = Integer.parseInt(appSettingVO.getValue());
		}
	}
	
	public void validateCommisionLimit() throws BusinessException {
		appSettingVO = appSettingBO.getAppSettingByCode(ConstantAppSetting.SALES_TOUR_PACKAGE_COMMISION_LIMIT);
		
		if (appSettingVO != null) {
			commisionLimit = Integer.parseInt(appSettingVO.getValue());
		}
	}
	
