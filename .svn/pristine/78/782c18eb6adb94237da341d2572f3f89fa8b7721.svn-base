	protected void getAcctNItemList(long idCompany) throws Exception {
		acctViewList = chartOfAcctBO.getAcctViewList(idCompany, null);
	}
	
	/**
	 * 
	 * @return
	 */
	protected boolean checkTourDepItemValidation() {
		if (CollectionUtils.isNotEmpty(tourDepVO.getTourDepItemList())) {
			for (TourDepItemVO vo : tourDepVO.getTourDepItemList()) {
				if (vo.getIdInvEoItem() == null) { // Accepted user manually added items
					if (tourDepVO.getIdCompany().equals(vo.getCompanyVO().getId())) return true;
				}
			}
		}
		return false;
	}

