		} catch (BusinessException e) {
			errorResult(e);
		}
	}
	
	public void loadCityList() {
		try {
			fullCityList = tourPackageBO.getCityList(null);
		} catch(Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleContinentChange() {
		try {
			fullCountryList = new ArrayList<CountryVO>();
			if(StringUtils.isNotBlank(tourPkgVO.getTourPkgCountryVO().getRegionName())) {
				tourPkgVO.getTourPkgCountryVO().setRegionName("");
			}
			
			tourPkgVO.getTourPkgCountryVO().setIdCountryList(new ArrayList<String>());
			tourPkgVO.getTourPkgCountryVO().setCountryName("");
			tourPkgVO.getTourPkgCountryVO().setIdCityList(new ArrayList<String>());
			tourPkgVO.getTourPkgCountryVO().setCityName("");
			
			if(CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCountryVO().getIdRegionList())) {
				for (String region : tourPkgVO.getTourPkgCountryVO().getIdRegionList()){
					fullCountryList.addAll(tourPackageBO.getFullCountryList(Long.valueOf(region)));
				}
				for(RegionVO regionVO : fullRegionList) {
					for (String region : tourPkgVO.getTourPkgCountryVO().getIdRegionList()){
						if(regionVO.getId().equals(Long.valueOf(region))) {
							tourPkgVO.getTourPkgCountryVO().setRegionName(StringUtils.isBlank(tourPkgVO.getTourPkgCountryVO().getRegionName()) ? regionVO.getRegionname() : tourPkgVO.getTourPkgCountryVO().getRegionName() + ", " + regionVO.getRegionname()); 
						}
					}
				}
			} else {
				fullCountryList.addAll(tourPackageBO.getFullCountryList(null));
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleCountryChange() {
		try {
			fullCityList = new ArrayList<CityVO>();
			if(StringUtils.isNotBlank(tourPkgVO.getTourPkgCountryVO().getCountryName())) {
				tourPkgVO.getTourPkgCountryVO().setCountryName("");
			}
			
			tourPkgVO.getTourPkgCountryVO().setIdCityList(new ArrayList<String>());
			tourPkgVO.getTourPkgCountryVO().setCityName("");
			
			if(CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCountryVO().getIdCountryList())) {			
				for (String country : tourPkgVO.getTourPkgCountryVO().getIdCountryList()){
					fullCityList.addAll(tourPackageBO.getCityList(Long.valueOf(country)));
				}
				
				for(CountryVO countryVO : fullCountryList) {
					for (String country : tourPkgVO.getTourPkgCountryVO().getIdCountryList()){
						if(countryVO.getId().equals(Long.valueOf(country))) {
							tourPkgVO.getTourPkgCountryVO().setCountryName(StringUtils.isBlank(tourPkgVO.getTourPkgCountryVO().getCountryName()) ? countryVO.getCountry() : tourPkgVO.getTourPkgCountryVO().getCountryName() + ", " + countryVO.getCountry()); 
						}
					}
				}
			} else {
				fullCityList.addAll(tourPackageBO.getCityList(null));
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleCityChange() {
		try {
			if(StringUtils.isNotBlank(tourPkgVO.getTourPkgCountryVO().getCityName())) {
				tourPkgVO.getTourPkgCountryVO().setCityName("");
			}
			if(CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCountryVO().getIdCityList())) {
				for(CityVO cityVO : fullCityList) {
					for (String city : tourPkgVO.getTourPkgCountryVO().getIdCityList()){
						if(cityVO.getId().equals(Long.valueOf(city))) {
							tourPkgVO.getTourPkgCountryVO().setCityName(StringUtils.isBlank(tourPkgVO.getTourPkgCountryVO().getCityName()) ? cityVO.getName() : tourPkgVO.getTourPkgCountryVO().getCityName() + ", " + cityVO.getName()); 
						}
					}
				}
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleDepartDateBadgeChange(boolean isZh) {
		deptDateDesc = "";
		deptDateZhDesc = "";
		if (isZh) {
			for (String deptDateBadgeCode : tourDepVO.getDepartDateBadgeZhList()) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_DEPART_DATE_BADGE_ZH, deptDateBadgeCode);
				if (StringUtils.isBlank(deptDateZhDesc))
					deptDateZhDesc = tempDesc;
				else
					deptDateZhDesc = deptDateZhDesc + ", " + tempDesc;
			}
		} else {
			for (String deptDateBadgeCode : tourDepVO.getDepartDateBadgeList()) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_DEPART_DATE_BADGE, deptDateBadgeCode);
				if (StringUtils.isBlank(deptDateDesc))
					deptDateDesc = tempDesc;
				else
					deptDateDesc = deptDateDesc + ", " + tempDesc;
			}
		}
	}
	
	public void handleTourBadgeChange(boolean isZh) {
		tourBadgeDesc = "";
		tourBadgeZhDesc = "";
		if (isZh) {
			for (String tourBadgeCode : tourPkgVO.getTourBadgeTagZhList()) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE_ZH, tourBadgeCode);
				if (StringUtils.isBlank(tourBadgeZhDesc))
					tourBadgeZhDesc = tempDesc;
				else
					tourBadgeZhDesc = tourBadgeZhDesc + ", " + tempDesc;
			}
		} else {
			for (String tourBadgeCode : tourPkgVO.getTourBadgeTagList()) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE, tourBadgeCode);
				if (StringUtils.isBlank(tourBadgeDesc))
					tourBadgeDesc = tempDesc;
				else
					tourBadgeDesc = tourBadgeDesc + ", " + tempDesc;
			}
		}
	}
	
	public void handleTravelStyleChange(boolean isZh) {
