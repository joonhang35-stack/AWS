	/**
	 * Get country list by region
	 * @param idCategory 
	 * @param searchParamVO
	 * @return
	 */
	protected List<CountryVO> getCountryListByRegion(long idCategory) throws Exception {
		for (TourCatViewVO vo : tourCatViewList) {
			if (vo.getIdRegion() != null) {
				if (vo.getId().longValue() == idCategory) {
					return tourPkgBO.getCountryList(vo.getIdRegion());
				}
			}
		}
		return null;
	}
	
