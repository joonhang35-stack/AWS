	public void importTourPkgDailyItinerary() {
		try {
			trackingLogUtils.startLogs();
			
			this.importTPDailyItineraryVO.setPkgItineryMap(new HashMap<String, TourPackageItineryVO>());
			
			if (tourPkgVO.getTourPkgDailyItineraryVOList() == null)
				tourPkgVO.setTourPkgDailyItineraryVOList(new ArrayList<TourPackageDailyItineraryVO>());
			
			if (tourPkgVO.getTourPkgDailyItineraryAUDList() == null)
				tourPkgVO.setTourPkgDailyItineraryAUDList(new GenAddUpdDelVO<TourPackageDailyItineraryVO>());
			
			if (this.importTPDailyItineraryVO.getGenAUDDailyItineraryItemVOList() == null)
				this.importTPDailyItineraryVO.setGenAUDDailyItineraryItemVOList(new GenAddUpdDelVO<TourPackageDailyItineraryItemVO>());
			
			if (CollectionUtils.isNotEmpty(this.importTPDailyItineraryVO.getDailyItineraryItemEngVOList())) {
				for (TourPackageDailyItineraryItemVO engVO : new ArrayList<>(this.importTPDailyItineraryVO.getDailyItineraryItemEngVOList())) {
					engVO.setId(null);
					engVO.setIdTourPkgDailyItinerary(null);
					
					this.importTPDailyItineraryVO.getGenAUDDailyItineraryItemVOList().getAddList().add(engVO);
				}
			}
			
			if (CollectionUtils.isNotEmpty(this.importTPDailyItineraryVO.getDailyItineraryItemZhVOList())) {
				for (TourPackageDailyItineraryItemVO zhVO : new ArrayList<>(this.importTPDailyItineraryVO.getDailyItineraryItemZhVOList())) {
					zhVO.setId(null);
					zhVO.setIdTourPkgDailyItinerary(null);
					this.importTPDailyItineraryVO.getGenAUDDailyItineraryItemVOList().getAddList().add(zhVO);
				}
			}
			
			GenUpdateVOList.processAddUpdDelVO(tourPkgVO.getTourPkgDailyItineraryAUDList(), 
					tourPkgVO.getTourPkgDailyItineraryVOList(), 
					this.importTPDailyItineraryVO, 
					ConstantScreenAction.ADD);
			
			successResult();
			
			this.importTPDailyItineraryVO = null;
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("importTourPkgDailyItinerary");
		}
	}
	
	public void saveTourPkgDailyItineraryItem() {
		try {
			// This checking for prevent user inserted the -1000px casue the tour pkg edit page overlap or blank page
			if (tourPackageDailyItineraryItemVO.getDescription() != null && tourPackageDailyItineraryItemVO.getDescription().contains("-1000px"))
				throw new BusinessException(CommonErrConstant.ERR_TOUR_PKG_DAILY_ITRY_DESC_INVALID);
		
			GenUpdateVOList.processAddUpdDelVO(tourPackageDailyItineraryVO.getGenAUDDailyItineraryItemVOList(), 
					StringUtils.equals(langCd, ProductConstant.LANGUAGE_CD_ENG) ? tourPackageDailyItineraryVO.getDailyItineraryItemEngVOList() : tourPackageDailyItineraryVO.getDailyItineraryItemZhVOList(), 
					tourPackageDailyItineraryItemVO, 
					isAddNewTourPkgDailyItineryItem ? ConstantScreenAction.ADD : ConstantScreenAction.UPD);
			
			GenUpdateVOList.processAddUpdDelVO(tourPkgVO.getTourPkgDailyItineraryAUDList(), 
					tourPkgVO.getTourPkgDailyItineraryVOList(), 
					tourPackageDailyItineraryVO, 
					ConstantScreenAction.UPD);
			
			if (StringUtils.equals(langCd, ProductConstant.LANGUAGE_CD_ENG)) {
				Collections.sort(tourPackageDailyItineraryVO.getDailyItineraryItemEngVOList(), new Comparator<TourPackageDailyItineraryItemVO>() {
					@Override
					public int compare(TourPackageDailyItineraryItemVO u1, TourPackageDailyItineraryItemVO u2) {
						int count = 0;
						
						if (u1.getSeq() > u2.getSeq())
							count = 1;
						else if (u1.getSeq() < u2.getSeq())
							count = -1;
						
						return count;
					}
				});
			} else {
				Collections.sort(tourPackageDailyItineraryVO.getDailyItineraryItemZhVOList(), new Comparator<TourPackageDailyItineraryItemVO>() {
					@Override
					public int compare(TourPackageDailyItineraryItemVO u1, TourPackageDailyItineraryItemVO u2) {
						int count = 0;
						
						if (u1.getSeq() > u2.getSeq())
							count = 1;
						else if (u1.getSeq() < u2.getSeq())
							count = -1;
						
						return count;
					}
				});
			}
			
			if (isAddNewTourPkgDailyItineryItem)
				navToTourPkgDailyItineraryItem(tourPackageDailyItineraryVO, null, activeDailyItineryIndex);
			
			successResult();
		} catch (Exception e) {
			errorResult(e);
		}
	}
	
