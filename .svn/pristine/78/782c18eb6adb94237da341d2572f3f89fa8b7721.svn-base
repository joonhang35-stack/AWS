	private void reloadTourPackageDetail() {
		try {
			// Tour Package Itinerary
			tourPkgVO.setTourPkgItineryVOList(tourPkgBO.getTourPkgItineryList(tourPkgVO.getId()));
			tourPkgVO.setTourPkgItineryAUDList(new GenAddUpdDelVO<TourPackageItineryVO>());
			
			if (CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgItineryVOList())) {
				for (TourPackageItineryVO itineryVO : this.tourPkgVO.getTourPkgItineryVOList()) {
					pkgItineryMap.put(itineryVO.getTypeCd() + itineryVO.getLangCd(), itineryVO);
				}
			}
			
			// Tour Image
			tourPkgVO.setTourImageVOList(tourPkgBO.getTourImageList(tourPkgVO.getId()));
			tourPkgVO.setTourImageAUDList(new GenAddUpdDelVO<TourImageVO>());
			
			if (CollectionUtils.isNotEmpty(tourPkgVO.getTourImageVOList())) {
				for (TourImageVO imageVO : this.tourPkgVO.getTourImageVOList()) {
					tourImageMap.put("IMG", imageVO);
				}
			}
			
			tourPkgVO.setTourPkgCommisionVOList(tourPkgBO.getTourPackageCommisionList(tourPkgVO.getId()));
			tourPkgVO.setTourPkgCommisionAUDList(new GenAddUpdDelVO<TourPackageCommisionVO>());
			// Tour Package Daily Itinerary
			tourPkgVO.setTourPkgDailyItineraryVOList(tourPkgBO.getTourPkgDailyItineraryList(tourPkgVO.getId()));
			tourPkgVO.setTourPkgDailyItineraryAUDList(new GenAddUpdDelVO<TourPackageDailyItineraryVO>());
			
			if (CollectionUtils.isEmpty(tourPkgVO.getTourPkgDailyItineraryVOList()))
				tourPkgVO.setTourPkgDailyItineraryVOList(new ArrayList<TourPackageDailyItineraryVO>());
			
			tourPkgVO.setTourBadgeTagList(tourPkgBO.getPackageTagList(tourPkgVO.getId(), CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE));
			tourPkgVO.setTourBadgeTagZhList(tourPkgBO.getPackageTagList(tourPkgVO.getId(), CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE_ZH));
			tourPkgVO.setTravelStyleList(tourPkgBO.getPackageTagList(tourPkgVO.getId(), CommonConstant.LOOKUP_CAT_CD_TRAVEL_STYLE));
			tourPkgVO.setTravelStyleZhList(tourPkgBO.getPackageTagList(tourPkgVO.getId(), CommonConstant.LOOKUP_CAT_CD_TRAVEL_STYLE_ZH));
			tourPkgVO.getTourPkgCountryVO().setIdRegionList(tourPkgBO.getTourPackageCountryList(tourPkgVO.getId(), CommonConstant.TYPE_CD_REGION));
			tourPkgVO.getTourPkgCountryVO().setIdCountryList(tourPkgBO.getTourPackageCountryList(tourPkgVO.getId(), CommonConstant.TYPE_CD_COUNTRY));
			tourPkgVO.getTourPkgCountryVO().setIdCityList(tourPkgBO.getTourPackageCountryList(tourPkgVO.getId(), CommonConstant.TYPE_CD_CITY));
			
			// Tour Package Tags
			tourPkgVO.setTourPackageTagVOList(tourPkgBO.getTourPackageTagList(tourPkgVO.getId()));
			tourPkgVO.setDelTourPackageTagVOList(new ArrayList<TourPackageTagVO>());
		} catch (Throwable t) {
			errorResult(t);	
		}
	}
	
	/**
	 * Report Header Company Detail
	 */
	public HashMap<String, Object> reportHeaderCompany() {
		HashMap<String, Object> map = new HashMap<String, Object>();
		try {
			CompanyVO companyVO = new CompanyVO();
			companyVO = corporateProfileBO.getCompanyDetails(getSessionInfoBean().getCompanyVO().getId());
			
			StringBuilder address = new StringBuilder();
			map.put("companyName", companyVO.getName());
			map.put("slogan", companyVO.getSlogan());
			
			if (!companyVO.getCompanyAddressVO().getAddress1().equals("")) address.append(companyVO.getCompanyAddressVO().getAddress1()).append(" ");
			if (!companyVO.getCompanyAddressVO().getAddress2().equals("")) address.append(companyVO.getCompanyAddressVO().getAddress2()).append(" ");
			if (!companyVO.getCompanyAddressVO().getAddress3().equals("")) address.append(companyVO.getCompanyAddressVO().getAddress3()).append(" ");
			if (!companyVO.getCompanyAddressVO().getCity().equals("")) address.append(companyVO.getCompanyAddressVO().getCity()).append(" ");
			if (!companyVO.getCompanyAddressVO().getState().equals("")) address.append(companyVO.getCompanyAddressVO().getState()).append(" ");
			if (!companyVO.getCompanyAddressVO().getPostcode().equals("")) address.append(companyVO.getCompanyAddressVO().getPostcode()).append(" ");
			String companyName = regionBO.getCountryById(companyVO.getCompanyAddressVO().getCountryid()).getCountry();
			if (!companyName.equals("")) address.append(companyName);
			map.put("address", address);
	
			String contact = "";
			for (CompanyContactVO vo : companyVO.getCompanyContactList()) {
				contact += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, vo.getTypecodecontact()) + ": " + vo.getNumber() + "  ";
			}
			if (!contact.equals("")) contact = "Tel: " + contact;
			map.put("contact", contact);
			
		} catch (Throwable t) {
			errorResult(t);
		}
		return map;
	}
	
	public void loadTourPkgListCMS() {
		try {
			HashMap<String, Object> params = new HashMap<String, Object>();
			if (tourPkgListInactiveRecords == true) params.put("inactiveRecords", "Y");
			else params.put("inactiveRecords", "N");
			tourPkgListImportCMS = tourPackageBO.getTourPkgListForCMS(params);
		} catch (Throwable t) {
			errorResult(t);	
		}
	}
	
