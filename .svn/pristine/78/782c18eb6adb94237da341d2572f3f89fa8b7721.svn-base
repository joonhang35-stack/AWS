	private boolean checkIsValidDiscountPax(int totalDiscountPax) {
		for (TourDepartureDiscountVO discountVO : tourDepVO.getTourDepartureDiscountVOList()) {
			totalDiscountPax += discountVO.getDiscountPax();
		}
		
		int balSeat = tourDepVO.getSeatAllot() - tourDepVO.getReservedSeat() - tourDepVO.getTourManagerPax() 
				- (tourDepVO.getTfairPax() + tourDepVO.getAgentPax() + tourDepVO.getInHsePax() + tourDepVO.getKivPax() + tourDepVO.getOn9BookingPax());
		
		if (tourDepVO.getSeatAllot() > 0 && balSeat >= 0 && totalDiscountPax > balSeat) {
			FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_WARN, "Discount pax cannot exceed balance seat", "");
			FacesContext.getCurrentInstance().addMessage(null, msg);
			if (oriTourDepDiscountVO != null)
				tourDepDiscountVO.setDiscountPax(oriTourDepDiscountVO.getDiscountPax());
			return false;
		}
		
		return true;
	}
	
