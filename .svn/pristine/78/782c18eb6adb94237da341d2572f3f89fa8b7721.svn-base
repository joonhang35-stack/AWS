	/**
	 * Handle account selection
	 * @param event
	 */
	public void handleAcctSelect(SelectEvent event) {
		try {
			AcctViewVO acctViewVO = (AcctViewVO) event.getObject();
			tourDepItemVO.setAcctVO(acctViewVO);
			if (StringUtils.isEmpty(acctViewVO.getSubCode())) {
				tourDepItemVO.setAcctCd(acctViewVO.getCode());
				tourDepItemVO.setAcctDesc(acctViewVO.getDesc());
			} else {
				tourDepItemVO.setAcctCd(acctViewVO.getCode() + "-" + acctViewVO.getSubCode());
				tourDepItemVO.setAcctDesc(acctViewVO.getDesc() + ", " + acctViewVO.getSubDesc());
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
