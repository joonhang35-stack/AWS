	public void updTourDepBooking() throws BusinessException {
		bakBookingVO = SerializationUtils.clone(bookingVO);
		
		if (bookingVO.getDiscountPax1() + bookingVO.getDiscountPax2() + bookingVO.getNotEntitledDiscountPax() > bookingVO.getQuantity()) {
			FacesContext.getCurrentInstance().addMessage(null, new FacesMessage(FacesMessage.SEVERITY_ERROR, "Discount pax cannot exceed total booking quantity.", "Discount pax cannot exceed total booking quantity."));
			RequestContext.getCurrentInstance().addCallbackParam("isSuccess", false);
			return;
		}
		
		int count = 1;
		double discount1 = bookingVO.getDiscount1() > 0 ? (bookingVO.getDiscount1() * -1) : bookingVO.getDiscount1();
		double discount2 = bookingVO.getDiscount2() > 0 ? (bookingVO.getDiscount2() * -1) : bookingVO.getDiscount2();
		
		for (BookingChargeItemVO chargeItemVO : bookingVO.getBookingChargeItemList()) {
			if (StringUtils.equals(ProductConstant.TOUR_DEP_ITM_CD_DISC, chargeItemVO.getCode())) {
				if (count == 1) {
					chargeItemVO.setAmount(discount1);
					chargeItemVO.setQuantity(discount1 != 0 ? bookingVO.getDiscountPax1() : 0);
					count++;
				} else if (count == 2) {
					chargeItemVO.setAmount(discount2);
					chargeItemVO.setQuantity(discount2 != 0 ? bookingVO.getDiscountPax2() : 0);
					count++;
				}
			}
		}
		
		if (count < 3) {
			List<TourDepItemVO> tempVOList = tourPkgBO.getTourDepItemList(tourDepVO.getId(), getSessionInfoBean().getCompanyVO().getId());
			
			for (TourDepItemVO vo : tempVOList) {
				if (vo.getAcctId() != null) {
					if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(vo.getCode())) {
						BookingChargeItemVO itemVO = null;
						
						if (count == 1) {
							itemVO = populateChargeItemDetail(itemVO, vo);
							itemVO.setAmount(discount1);
							itemVO.setQuantity(discount1 != 0 ? bookingVO.getDiscountPax1() : 0);
							
							bookingVO.getBookingChargeItemList().add(itemVO);
							
							itemVO = populateChargeItemDetail(itemVO, vo);
							itemVO.setAmount(discount2);
							itemVO.setQuantity(discount2 != 0 ? bookingVO.getDiscountPax2() : 0);
							
							bookingVO.getBookingChargeItemList().add(itemVO);
						}
						
						if (count == 2) {
							itemVO = populateChargeItemDetail(itemVO, vo);
							itemVO.setAmount(discount2);
							itemVO.setQuantity(discount2 != 0 ? bookingVO.getDiscountPax2() : 0);
							
							bookingVO.getBookingChargeItemList().add(itemVO);
						}
					}
				}
			}
		}
		
		updBooking();
		
		RequestContext.getCurrentInstance().addCallbackParam("isSuccess", true);
	}
	
	private BookingChargeItemVO populateChargeItemDetail(BookingChargeItemVO itemVO, TourDepItemVO vo) {
		itemVO = new BookingChargeItemVO();
		itemVO.setIdBooking(bookingVO.getId());
		itemVO.setIdAcct(vo.getAcctId());
		itemVO.setIdInvEoItem(vo.getIdInvEoItem());
		itemVO.setCode(vo.getCode());
		itemVO.setDesc(vo.getDesc());
		itemVO.setAmount(vo.getAmount());
		itemVO.setTypeCd(vo.getTypeCd());
		
		return itemVO;
	}
	
