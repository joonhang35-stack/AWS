	public void addDiscount() {
		try {
			if (tourDepVO.getTourDepartureDiscountVOList() == null) 
				tourDepVO.setTourDepartureDiscountVOList(new ArrayList<TourDepartureDiscountVO>());
			
			if (discountLimit != 0 && tourDepVO.getTourDepartureDiscountVOList().size() == discountLimit) {
				FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_WARN, "Cannot add new discount as reach the allowed limit", "");
				FacesContext.getCurrentInstance().addMessage(null, msg);
				return;
			}
			
			if (!checkIsValidDiscountPax(tourDepDiscountVO.getDiscountPax()))
				return;
			
			GenUpdateVOList.processAddUpdDelVO(tourDepVO.getGenAUDTourDepDiscountVO(), tourDepVO.getTourDepartureDiscountVOList(), tourDepDiscountVO, ConstantScreenAction.ADD);
			
			resetDiscountForm();
			successResult();
		} catch (Exception e) {
			errorResult(e);
		}
	}
	
