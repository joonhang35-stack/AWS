	public void navToTourPkgDailyItineraryItem(TourPackageDailyItineraryVO diVO, TourPackageDailyItineraryItemVO vo, int activeDailyItineryIndex) {
		this.activeDailyItineryIndex = activeDailyItineryIndex;
		
		if (diVO != null) tourPackageDailyItineraryVO = diVO;
		else tourPackageDailyItineraryVO = new TourPackageDailyItineraryVO();
		
		this.langCd = diVO.getLangCd();
		
		if (vo != null) {
			isAddNewTourPkgDailyItineryItem = false;
			tourPackageDailyItineraryItemVO = vo;
		} else {
			isAddNewTourPkgDailyItineryItem = true;
			tourPackageDailyItineraryItemVO = new TourPackageDailyItineraryItemVO();
			tourPackageDailyItineraryItemVO.setLangCd(langCd);
		}
		
		if (tourPackageDailyItineraryVO.getGenAUDDailyItineraryItemVOList() == null)
			tourPackageDailyItineraryVO.setGenAUDDailyItineraryItemVOList(new GenAddUpdDelVO<TourPackageDailyItineraryItemVO>());
		
		if(CollectionUtils.isEmpty(tourPackageDailyItineraryVO.getDailyItineraryItemEngVOList()))
			tourPackageDailyItineraryVO.setDailyItineraryItemEngVOList(new ArrayList<TourPackageDailyItineraryItemVO>());
		
		if(CollectionUtils.isEmpty(tourPackageDailyItineraryVO.getDailyItineraryItemZhVOList()))
			tourPackageDailyItineraryVO.setDailyItineraryItemZhVOList(new ArrayList<TourPackageDailyItineraryItemVO>());
	}
	
	/**
	 * 
	 * @param document
	 */
	public void postProcessXLS(Object document) {
        HSSFWorkbook wb = (HSSFWorkbook) document;
        HSSFSheet sheet = wb.getSheetAt(0);
        sheet.shiftRows(0, sheet.getLastRowNum(), 2);
        HSSFRow header = sheet.createRow(0);
        HSSFCell cell = header.createCell(0);
        
        String cellValue = tourPkgVO.getNameEn();
        if (tourPkgVO.getNameZh() != null) {
        	cellValue += tourPkgVO.getNameZh();
        }
        if (tourPkgVO.getNameOther() != null) {
        	cellValue += tourPkgVO.getNameOther();
        }
        cell.setCellValue(cellValue);
    }
	
	public void printTourDepListRpt() {
		try {
			HashMap<String, Object> map = reportHeaderCompany();
			
			String packageTitle = tourPkgVO.getNameEn();
			if (StringUtils.isNotEmpty(tourPkgVO.getNameOther())) packageTitle += " " + tourPkgVO.getNameOther();
			if (StringUtils.isNotEmpty(tourPkgVO.getNameZh())) packageTitle += " " + tourPkgVO.getNameZh();
			map.put("packageTitle", packageTitle);
			map.put("deposit", tourPkgVO.getDeposit());
			
			String remarks = "";
			String pkgDesc = "";
			for (TourDepartureVO vo: tourDepList) {
				if ("F".equals(vo.getTourStatusCd())) vo.setTourStatusDesc("Full");
				else
					vo.setTourStatusDesc(LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_TOUR_STATUS, vo.getTourStatusCd()));
				
				remarks = "";
				if (StringUtils.isNotEmpty(vo.getDesc())) remarks += "[" + vo.getDesc() + "]";
				for (String str : vo.getDepartDateBadgeList()) {
					if (StringUtils.isEmpty(remarks)) remarks += "[" + str + "]";
					else remarks += " [" + str + "]";
				}
				if (StringUtils.isEmpty(remarks)) remarks += "[" + vo.getLangCode() + "]";
				else {
					if (StringUtils.isNotEmpty(vo.getLangCode())) remarks += " [" + vo.getLangCode() + "]";
				}
				vo.setRemarks(remarks);
				
				pkgDesc = "";
//				pkgDesc += vo.getDuration();
				if (vo.getIsDepositPaid()) pkgDesc += "PD ";
				pkgDesc += vo.getNumDays() + "D/" + vo.getNumNights() + "N ";
				if (StringUtils.isNotEmpty(vo.getDesc())) pkgDesc += "[" + vo.getDesc() + "]";
				if (StringUtils.isNotEmpty(vo.getPrn())) pkgDesc += "[" + vo.getPrn() + "]";
				if (vo.isTravelInsS()) pkgDesc += "[S]";
				if (vo.isTravelInsF()) pkgDesc += "[F]";
				if (StringUtils.isNotEmpty(vo.getDailyCode())) pkgDesc += "[" + vo.getDailyCode() + "]";
				vo.setPackageDesc(pkgDesc);
				if (Double.compare(vo.getDiscount1(), 0D) > 0) vo.setDiscount1(vo.getDiscount1() * -1);
				if (Double.compare(vo.getDiscount2(), 0D) > 0) vo.setDiscount2(vo.getDiscount2() * -1);
				
				int totalSold = vo.getTfairPax() + vo.getAgentPax() + vo.getInHsePax() + vo.getKivPax() + vo.getOn9BookingPax();
				int balSeat = vo.getSeatAllot() - vo.getReservedSeat() - vo.getTourManagerPax() 
						- (vo.getTfairPax() + vo.getAgentPax() + vo.getInHsePax() + vo.getKivPax() + vo.getOn9BookingPax());
				
				vo.setTotalSold(totalSold);
				vo.setBalSeat(balSeat);
				
				BigDecimal fullTwn = new BigDecimal(String.valueOf(vo.getFullTwn()));
				BigDecimal miscAdt = new BigDecimal(String.valueOf(vo.getMiscAdt()));
				
				vo.setAdultTwnMisc(fullTwn.add(miscAdt).doubleValue());
			}
			
			if (CollectionUtils.isEmpty(tourDepList)) throw new BusinessException("ERR_NO_RESULT");
			
			String jasperFileName = CommonConstant.JAS_RPT_TOUR_DEP_LIST;
			String reportName = CommonConstant.PDF_RPT_TOUR_DEP_LIST;

			JasperPrint jasperPrint = ReportUtils.getJasperPrint(tourDepList, map, jasperFileName);
			//Convert cell type as report (eg: '350.00 to 350.00)
			jasperPrint.setProperty("net.sf.jasperreports.export.xls.detect.cell.type", "true");
			ReportUtils.printReportExcel(jasperPrint, reportName);
			
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	/**
	 * Update tour departure
	 */
	public void updTourDep() {
		try {
			trackingLogUtils.startLogs();
			
			if (tourDepVO.getTourDepItemList() == null || tourDepVO.getTourDepItemList().isEmpty())
				throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_ITEM_EMPTY);
			
			// Check Valid discount seat -START-
			if (!checkIsValidDiscountPax(0)) {
				return;
			}
			// Check Valid discount seat -END-
			
			// Check Tour Departure Date Year is same as Tour Package Year
			SimpleDateFormat yearFormat = new SimpleDateFormat("yyyy");
	        String depYear = yearFormat.format(tourDepVO.getDtDep());
				        
	        if (!depYear.equals(tourPkgVO.getYear())) {
	        	throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_DEPARTURE_DATE_YEAR_NOT_EQUAL);
			}
			
			boolean isFirstTime = tourPkgBO.isTourDepFirstTimeUpd(tourDepVO.getId());
			// check if 1st time update
			if (isFirstTime) {
				// insert 1st time tour departure history
				if (tourDepVO.getVersion().intValue() == 1) {
					tourDepHistoryVO.setActionCd(CommonConstant.ACTION_CD_ADD);
					insertTourDepHistory(tourDepVO.getId(), tourDepHistoryVO.getActionCd(), "");
				}
				isFirstTime = false;
			}
			
			// Check when tour status change to Issued, lock all booking to disabled editing on remarks
			if (isTourStatusChanged && StringUtils.equals(tourDepVO.getTourStatusCd(), CommonConstant.LOOKUP_ITM_DEPT_TOUR_STATUS_ISSUED)) {
				bookingBO.updateBookingLockStatus(tourDepVO.getId(), true);
				isTourStatusChanged = false;
			
			// Check when tour status change other than Issued, unlock all booking
			} else if (isTourDepLockChanged && !StringUtils.equals(tourDepVO.getTourStatusCd(), CommonConstant.LOOKUP_ITM_DEPT_TOUR_STATUS_ISSUED)) {
				if (tourDepVO.getIsLock() == true) {
					bookingBO.updateBookingLockStatus(tourDepVO.getId(), true);
				} else {
					bookingBO.updateBookingLockStatus(tourDepVO.getId(), false);
				}
				isTourDepLockChanged = false;
				
			}
			
			// set remain tour code to true if depart date badge 'Guaranteed Departure' has chosen
			if (tourDepVO.getDepartDateBadgeList().contains("CFM ")) {
				tourDepVO.setIsRemainTc(true);
			}
			// set remain tour code to true if private tour true
			if (tourDepVO.getIsPrivateTour()) {
				tourDepVO.setIsRemainTc(true);
			}
			// update tour departure
			tourDepVO.setTourDepHistoryVO(tourDepHistoryVO);
			tourDepVO.setTourItineryList(new ArrayList<TourItineryVO>(itineryMap.values()));
			
			if (ProductConstant.TYPE_CRUISE.equals(searchParamVO.getObj1())) {
				tourDepVO.setTourTypeCode("CRUISE");
			}
			
			tourPkgBO.updTourDep(tourDepVO, itineryAUDVO, tourHotelAUDVO, tourDepItemAUDVO, remarksVOList, delTourDepItemList);
		 	// when available or limited tour status check the update to full
		 	// add itineries
			fileUploadUtils.uploadFile();
			
			// when customer made booking, add tour departure history
			if (!isFirstTime) {
				// insert tour departure history
				tourDepHistoryVO.setActionCd(CommonConstant.ACTION_CD_UPD);
				insertTourDepHistory(tourDepVO.getId(), tourDepHistoryVO.getActionCd(), tourDepVO.getReason());
			}
			// list tour departure
			if (getIsFromSearchFiltering()) handleFilterTourDepList();
			else reloadTourDepList();
			
			// reset form
			resetTourDepForm();
			successResult();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("updTourDep");
		}
	}
	
	/**
	 * Delete tour departure
	 */
	public void delTourDep() {
		try {
			trackingLogUtils.startLogs();
			
			tourDepVO.setTourItineryList(new ArrayList<TourItineryVO>(itineryMap.values()));
			tourPkgBO.delTourDep(tourDepVO);
			// insert history
			insertTourDepHistory(tourDepVO.getId(), CommonConstant.ACTION_CD_DEL, tourDepVO.getReason());

			// list tour departure
			if (BaseConstant.YES.equals(tourPkgDepFilter) && searchTourDep != null 
					&& (searchTourDep.getFromDate() != null || searchTourDep.getToDate() != null
					|| searchTourDep.getTourPkgDailyCms() != null || searchTourDep.getLangCode() != null
					|| CollectionUtils.isNotEmpty(searchTourDep.getDepartDateBadgeList())
					|| CollectionUtils.isNotEmpty(searchTourDep.getSelectedSeason()))) {
				reloadTourDepListBySearch();
			} else reloadTourDepList();
			resetTourDepForm();
			successResult();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("delTourDep");
		}
	}
	
