		}
	}
	
	/**
	 * Clone tour package
	 */
	public void cloneTourPkg() {
		try {
			trackingLogUtils.startLogs();
			
			// Reset Tour Itinery List
			tourPkgVO.setTourPkgItineryVOList(tourPkgBO.getTourPkgItineryList(tourPkgVO.getId()));
			
			tourPkgVO.setStatusCode(CommonConstant.STATUS_CD_ACTIVE);
			String tmp = "";
			tmp = tmp.concat("(" + counter++ + ")");
			tourPkgVO.setNameZh(tourPkgVO.getNameZh() + tmp);
			
			for (TourPackageDailyItineraryVO dailyItineraryVO : tourPkgVO.getTourPkgDailyItineraryVOList()) {
				dailyItineraryVO.setGenAUDDailyItineraryItemVOList(new GenAddUpdDelVO<TourPackageDailyItineraryItemVO>());
				dailyItineraryVO.getGenAUDDailyItineraryItemVOList().getAddList().addAll(dailyItineraryVO.getDailyItineraryItemEngVOList());
				dailyItineraryVO.getGenAUDDailyItineraryItemVOList().getAddList().addAll(dailyItineraryVO.getDailyItineraryItemZhVOList());
			}
			
			tourPkgBO.cloneTourPkg(tourPkgVO);
			
			// reset form 
			handleTourCatSelect(true);
			resetForm();
			successResult();
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("cloneTourPkg");
		}
	}

	/**
	 * Clone tour departure
	 */
	public void cloneTourDep() {
		try {
			trackingLogUtils.startLogs();
			
			handleTourDepSelect(tourDepVO);
			if (tourDepVO.getTourDepItemList() == null) tourDepVO.setTourDepItemList(tourPkgBO.getTourDepItemList(tourDepVO.getId()));
			
			// Reset Tour Itinery List
			tourDepVO.setTourItineryList(tourPkgBO.getTourItineryList(tourDepVO.getId()));
			
			tourDepVO.setStatusCode(CommonConstant.STATUS_CD_ACTIVE);
			tourPkgBO.cloneTourDep(tourDepVO);
			
			// reload tour departure
			if (BaseConstant.YES.equals(tourPkgDepFilter) && searchTourDep != null 
					&& (searchTourDep.getFromDate() != null || searchTourDep.getToDate() != null
					|| searchTourDep.getTourPkgDailyCms() != null || searchTourDep.getLangCode() != null
					|| CollectionUtils.isNotEmpty(searchTourDep.getDepartDateBadgeList())
					|| CollectionUtils.isNotEmpty(searchTourDep.getSelectedSeason()))) {
				reloadTourDepListBySearch();
			} else reloadTourDepList();
			
			// reset form
			resetTourDepForm(); 
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("cloneTourDep");
		}
	}
	
