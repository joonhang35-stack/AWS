	/**
	 * Handle twin sharing input
	 * @param flag
	 */
	public void handleTwnSharingInput(int flag) {
		try {
			if (flag == 0) { //full tour
				if (tourDepVO.getFullTwn().doubleValue() == 0) {
					tourDepVO.setFullSgl(0.0);
					tourDepVO.setFullCtw(0.0);
					tourDepVO.setFullCeb(0.0);
					tourDepVO.setFullCnb(0.0);
					
				} else {
					tourDepVO.setFullSgl(tourDepVO.getFullTwn() + tourPkgVO.getPriceDiffSgl());
					tourDepVO.setFullCtw(CalculationUtils.tourCalculate(tourDepVO.getFullTwn(), tourPkgVO.getPriceDiffCtw()));
					tourDepVO.setFullCeb(CalculationUtils.tourCalculate(tourDepVO.getFullTwn(), tourPkgVO.getPriceDiffCwb()));
					tourDepVO.setFullCnb(CalculationUtils.tourCalculate(tourDepVO.getFullTwn(), tourPkgVO.getPriceDiffCnb()));
				}
			} else { // ground only
				if (tourDepVO.getGrndTwn().doubleValue() == 0) {
					tourDepVO.setGrndSgl(0.0);
					tourDepVO.setGrndCtw(0.0);
					tourDepVO.setGrndCeb(0.0);
					tourDepVO.setGrndCnb(0.0);
					
				} else {
					tourDepVO.setGrndSgl(tourDepVO.getGrndTwn() + tourPkgVO.getGrndSgl());
					tourDepVO.setGrndCtw(CalculationUtils.tourCalculate(tourDepVO.getGrndTwn(), tourPkgVO.getGrndCtw()));
					tourDepVO.setGrndCeb(CalculationUtils.tourCalculate(tourDepVO.getGrndTwn(), tourPkgVO.getGrndCwb()));
					tourDepVO.setGrndCnb(CalculationUtils.tourCalculate(tourDepVO.getGrndTwn(), tourPkgVO.getGrndCnb()));
				}
			}
			loadSalesCommConfig(tourPkgVO.getIdSalesCommConf());
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleCalculateGrndInput() {
	    try {
	        if (tourDepVO.getFullTwn().doubleValue() != 0 && tourDepVO.getAirfareTwn().doubleValue() != 0) {
	            tourDepVO.setGrndTwn(CalculationUtils.bigDecimalSubstitution(tourDepVO.getFullTwn(), tourDepVO.getAirfareTwn()));
	        }

	        if (tourDepVO.getFullSgl().doubleValue() != 0 && tourDepVO.getAirfareSgl().doubleValue() != 0) {
	            tourDepVO.setGrndSgl(CalculationUtils.bigDecimalSubstitution(tourDepVO.getFullSgl(), tourDepVO.getAirfareSgl()));
	        }

	        if (tourDepVO.getFullCtw().doubleValue() != 0 && tourDepVO.getAirfareCtw().doubleValue() != 0) {
	            tourDepVO.setGrndCtw(CalculationUtils.bigDecimalSubstitution(tourDepVO.getFullCtw(), tourDepVO.getAirfareCtw()));
	        }

	        if (tourDepVO.getFullCeb().doubleValue() != 0 && tourDepVO.getAirfareCeb().doubleValue() != 0) {
	            tourDepVO.setGrndCeb(CalculationUtils.bigDecimalSubstitution(tourDepVO.getFullCeb(), tourDepVO.getAirfareCeb()));
	        }

	        if (tourDepVO.getFullCnb().doubleValue() != 0 && tourDepVO.getAirfareCnb().doubleValue() != 0) {
	            tourDepVO.setGrndCnb(CalculationUtils.bigDecimalSubstitution(tourDepVO.getFullCnb(), tourDepVO.getAirfareCnb()));
	        }
	    } catch (Throwable t) {
	        errorResult(t);
	    }
	}

	
	public void handleAirfareTwnSharingInputAndGrndCalculation() {
		try {
			if (tourDepVO.getAirfareTwn().doubleValue() != 0) {
				tourDepVO.setAirfareSgl(tourDepVO.getAirfareTwn());
				tourDepVO.setAirfareCtw(tourDepVO.getAirfareTwn());
				tourDepVO.setAirfareCeb(tourDepVO.getAirfareTwn());
				tourDepVO.setAirfareCnb(tourDepVO.getAirfareTwn());
				
				if (tourDepVO.getFullTwn().doubleValue() != 0) {
		            tourDepVO.setGrndTwn(CalculationUtils.bigDecimalSubstitution(tourDepVO.getFullTwn(), tourDepVO.getAirfareTwn()));
				}
	
		        if (tourDepVO.getFullSgl().doubleValue() != 0) {
		            tourDepVO.setGrndSgl(CalculationUtils.bigDecimalSubstitution(tourDepVO.getFullSgl(), tourDepVO.getAirfareSgl()));
		        }
	
		        if (tourDepVO.getFullCtw().doubleValue() != 0) {
		            tourDepVO.setGrndCtw(CalculationUtils.bigDecimalSubstitution(tourDepVO.getFullCtw(), tourDepVO.getAirfareCtw()));
		        }
	
		        if (tourDepVO.getFullCeb().doubleValue() != 0) {
		            tourDepVO.setGrndCeb(CalculationUtils.bigDecimalSubstitution(tourDepVO.getFullCeb(), tourDepVO.getAirfareCeb()));
		        }
	
		        if (tourDepVO.getFullCnb().doubleValue() != 0) {
		            tourDepVO.setGrndCnb(CalculationUtils.bigDecimalSubstitution(tourDepVO.getFullCnb(), tourDepVO.getAirfareCnb()));
		        }
			} else {
				tourDepVO.setAirfareSgl(0.0);
				tourDepVO.setAirfareCtw(0.0);
				tourDepVO.setAirfareCeb(0.0);
				tourDepVO.setAirfareCnb(0.0);
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Handle file upload
	 * @param event
	 */
	public void handleFileUpload(FileUploadEvent event) {
		try {
			trackingLogUtils.startLogs();
			
			// set uploaded file
			UploadedFile uploadedFile = event.getFile();
			// rename the valid file name
			String fileName = uploadedFile.getFileName().replace(" ", "-");
			
			// if type code not null
			if (tourItineryVO.getTypeCd() != null && !tourItineryVO.isSingleFile()) {
				// add file to map (cache)
				fileUploadUtils.getMap().put(tourItineryVO.getTypeCd() + tourItineryVO.getLangCd(), new FileUploadVO(uploadedFile, destinationPathTOURItinery, fileName));
				
				// set itinery info
				tourItineryVO.setName(fileName);
				tourItineryVO.setPath(destinationPathTOURItinery);
				tourItineryVO.setCreatedBy(getSessionInfo().getUserVO().getName());
				tourItineryVO.setCreatedDate(new Date());
				tourItineryVO.setUpdatedBy(getSessionInfo().getUserVO().getName());
				tourItineryVO.setUpdatedDate(new Date());
				tourItineryVO.setIsFromPkg(false);
				// add file to temp map for view purpose
				itineryMap.put(tourItineryVO.getTypeCd() + tourItineryVO.getLangCd(), tourItineryVO);
				// reset tour itinery form
				resetTourItineryForm();
				
			} else {
				// add file to map (cache)
				fileUploadUtils.getMap().put(fileName, new FileUploadVO(uploadedFile, destinationPathFNEItinery, fileName));
				
				// set itinery info
				tourItineryVO.setName(fileName);
				tourItineryVO.setPath(destinationPathFNEItinery);
				tourItineryVO.setLangCd("EN");
				tourItineryVO.setTypeCd(ProductConstant.TYPE_CUST);
				tourItineryVO.setSingleFile(true);
				tourItineryVO.setIsFromPkg(false);
			}
			
			// set itinery path to tour package reserved 1, only for FNE/CRUISES
			if (!StringUtils.equals((String) searchParamVO.getObj1(), ProductConstant.TYPE_TOUR)) tourPkgVO.setReserved1(tourItineryVO.getPath() + File.separator + tourItineryVO.getName());
			uploadedFile = null;
			
			FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_INFO, "Success! ", event.getFile().getFileName() + " is uploaded.");
			FacesContext.getCurrentInstance().addMessage(null, msg);
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("handleFileUpload");
		}
	}
	
