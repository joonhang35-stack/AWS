	/**
	 * 
	 * @param id
	 * @return
	 */
	public CompanyVO getCompanyInfo(long id) {
		if (CollectionUtils.isNotEmpty(companyList)) {
			for (CompanyVO vo : companyList) {
				if (vo.getId().longValue() == id) return vo;
			}
		}
		return null;
	}
	
	/**
	 * Show tour departure item list
	 */
	public void showTourDepItemList() {
		try {
			if (tourDepVO.getTourDepItemList() == null) tourDepVO.setTourDepItemList(tourPkgBO.getTourDepItemList(tourDepVO.getId()));
			tourDepItemList = new ArrayList<List<TourDepItemVO>>();
			List<InvoiceAndExchangeOrderViewVO> invEoItemList = invEoBO.getInvoiceAndExchangeOrderList();
			
			if (CollectionUtils.isNotEmpty(tourDepVO.getTourDepItemList())) {
				Map<Long, List<TourDepItemVO>> map = new HashMap<Long, List<TourDepItemVO>>();
				List<TourDepItemVO> list = new ArrayList<TourDepItemVO>();
				long companyId = 0;
				for (int i = 0 ; i < tourDepVO.getTourDepItemList().size() ; i++) {
					TourDepItemVO vo = tourDepVO.getTourDepItemList().get(i);
					if (i == 0) companyId = vo.getCompanyVO().getId();
					if (companyId != vo.getCompanyVO().getId().longValue()) {
						//tourDepItemList.add(list);
						if (map.containsKey(companyId)) map.get(companyId).addAll(list);
						else map.put(companyId, list);
						list = new ArrayList<TourDepItemVO>();
						companyId = vo.getCompanyVO().getId();
					}
					
					for (InvoiceAndExchangeOrderViewVO eoItem : invEoItemList) {
						if (eoItem.getCompanyVO().getId() == vo.getCompanyVO().getId().longValue() && eoItem.getCode().equals(vo.getCode())) {
							vo.setItemTypeCd(eoItem.getTypeCd());
							break;
						}
					}
					
					list.add(vo);
					if (i == tourDepVO.getTourDepItemList().size() - 1) {
						//tourDepItemList.add(list);
						if (map.containsKey(companyId)) map.get(companyId).addAll(list);
						else map.put(companyId, list);
					}
				}
				// set to tourDepItemList
				for (Iterator<Entry<Long, List<TourDepItemVO>>> i = map.entrySet().iterator() ; i.hasNext() ; ) {
					list = i.next().getValue();
					tourDepItemList.add(list);
				}
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Import tour departure items
	 */
	public void importDefaultInvoiceItems() {
		try {
			if (ProductConstant.TYPE_CRUISE.equals(searchParamVO.getObj1())) {
				tourDepVO.setTourTypeCode("CRUISE");
				tourDepVO.setIdCruise(tourPkgVO.getIdCruise());
				if (tourDepVO.getIdCruiseSchedule() == null || StringUtils.isEmpty(tourDepVO.getCruiseScheduleItems())) {
					throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_CRUISE_SCHEDULE_CANNOT_EMPTY);
				}
			}
			
			if (checkTourDepItemValidation()) throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_COMPANY_ITM_IMPORTED);
			List<TourDepItemVO> list = tourPkgBO.importDefaultInvoiceItems(tourDepVO, getCompanyInfo(tourDepVO.getIdCompany()));
			tourDepVO.getTourDepItemList().addAll(list);
			// if add items on edit status
			if (tourDepVO.getId() != null) {
				for (TourDepItemVO vo : list) {
					tourDepItemAUDVO.getAddList().add(vo);
				}
			}
			
			// Restore back user manually added items
			if (CollectionUtils.isNotEmpty(userAddTourDepItemList)) {
				for (TourDepItemVO vo : userAddTourDepItemList) {
					if (tourDepVO.getId() != null) tourDepItemAUDVO.getAddList().add(vo);
					tourDepVO.getTourDepItemList().add(vo);
				}
			}
			
			showTourDepItemList();
			successResult();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	/**
	 * 
	 * @param list
	 */
	public void deleteTourDepItemList(List<TourDepItemVO> list) {
		try {
			// Accepted user manually added items
			userAddTourDepItemList = new ArrayList<TourDepItemVO>();
			for (TourDepItemVO addVO : list) {
				if (addVO.getIdInvEoItem() != null) {
					userAddTourDepItemList.add((TourDepItemVO) addVO.clone());
				}
			}
			
			if (tourDepVO.getId() != null) {
				if (list.get(0).getId() != null) delTourDepItemList.add(list);
				else {
					// remove from additional list
					if (CollectionUtils.isNotEmpty(tourDepItemAUDVO.getAddList())) {
						for (int i = tourDepItemAUDVO.getAddList().size() - 1 ; i >= 0 ; i--) {
							TourDepItemVO vo = (TourDepItemVO) tourDepItemAUDVO.getAddList().get(i);
							if (vo.getCompanyVO().getId().longValue() == list.get(0).getCompanyVO().getId().longValue()) {
								tourDepItemAUDVO.getAddList().remove(i);
							}
						}
					}
				}
			}
			// remove from list
			for (int i = tourDepVO.getTourDepItemList().size() - 1 ; i >= 0  ; i--) {
				TourDepItemVO vo = tourDepVO.getTourDepItemList().get(i);
				if (vo.getCompanyVO().getId().longValue() == list.get(0).getCompanyVO().getId().longValue()) {
					tourDepVO.getTourDepItemList().remove(i);
				}
			}
			showTourDepItemList();
			//successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Load tour departure
	 */
	public void reloadTourDepList() {
		try {
			trackingLogUtils.startLogs();
			tourDepList = tourPkgBO.getTourDepList(tourPkgVO.getId(), null);
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("reloadTourDepList");
		}
	}
	
	/**
	 * Load filter tour departure
	 */
	public void handleFilterTourDepList() {
		try {
			trackingLogUtils.startLogs();
			
			if (StringUtils.isNotBlank(searchTourDepFilter.getCode()) ||
				StringUtils.isNotBlank(searchTourDepFilter.getPackageDesc()) || 
				searchTourDepFilter.getFromDate() != null || 
				searchTourDepFilter.getToDate() != null || 
				CollectionUtils.isNotEmpty(searchTourDepFilter.getTourStatusList()) || 
				CollectionUtils.isNotEmpty(searchTourDepFilter.getTourLangList()) || 
				searchTourDepFilter.getPriceFrom() != null ||
				searchTourDepFilter.getPriceTo() != null || 
				searchTourDepFilter.getBalanceSeat() != null || 
				CollectionUtils.isNotEmpty(searchTourDepFilter.getSelectedSeason()) || 
				CollectionUtils.isNotEmpty(searchTourDepFilter.getDepartDateBadgeList()) || 
				CollectionUtils.isNotEmpty(searchTourDepFilter.getSectorTypeList()) || 
				CollectionUtils.isNotEmpty(searchTourDepFilter.getSectorList())) {
				tourFilterDepList = tourPkgBO.getFilterTourDepList(searchTourDepFilter);
				//tourFilterDepList = tourPkgBO.getFilterTourDepList(filterDepDateFrom, filterDepDateTo, filterTourCode, filterTitle, filterInactiveRcrd, filterTourStatusCd);
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("LoadFilterTourDepList");
		}
	}
	
	public void handleFilterClearAll() {
		try {
			searchTourDepFilter.setCode(null);
			searchTourDepFilter.setPackageDesc(null);
			searchTourDepFilter.setFromDate(null);
			searchTourDepFilter.setToDate(null);
			searchTourDepFilter.setTourStatusList(new ArrayList<String>());
			searchTourDepFilter.setTourLangList(new ArrayList<String>());
			searchTourDepFilter.setPriceFrom(null);
			searchTourDepFilter.setPriceTo(null);
			searchTourDepFilter.setBalanceSeat(null);
			searchTourDepFilter.setSelectedSeason(new ArrayList<String>());
			searchTourDepFilter.setDepartDateBadgeList(new ArrayList<String>());
			searchTourDepFilter.setSectorTypeList(new ArrayList<String>());
			searchTourDepFilter.setSectorList(new ArrayList<String>());
			searchTourDepFilter.setInactiveRecord(false);
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void printTourDepFindTourListRpt() {
		try {
			if (CollectionUtils.isEmpty(tourFilterDepList)) throw new BusinessException("ERR_NO_RESULT");
			
			HashMap<String, Object> map = reportHeaderCompany();
			
			List<TourDepartureVO> tourDepartureList = new ArrayList<TourDepartureVO>();
			
			String depDesc = "";
			String pkgDesc = "";
			for (TourDepartureVO oriVO: tourFilterDepList) {
				TourDepartureVO vo = new TourDepartureVO();
				vo = (TourDepartureVO) oriVO.clone();
				
				if ("F".equals(vo.getTourStatusCd())) vo.setTourStatusDesc("Full");
				else
					vo.setTourStatusDesc(LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_TOUR_STATUS, vo.getTourStatusCd()));
				
				pkgDesc = "";
				if (StringUtils.isNotEmpty(vo.getNameEn())) pkgDesc += vo.getNameEn();
				if (StringUtils.isNotEmpty(vo.getNameZh())) pkgDesc += vo.getNameZh();
				if (StringUtils.isNotEmpty(vo.getNameOther())) pkgDesc += vo.getNameOther();
				vo.setPackageDesc(pkgDesc);
				
				depDesc = "";
				if (vo.getIsDepositPaid() != null && Boolean.TRUE.equals(vo.getIsDepositPaid())) depDesc += "PD ";
				depDesc += vo.getNumDays() + "D/" + vo.getNumNights() + "N ";
				if (StringUtils.isNotEmpty(vo.getDesc())) depDesc += "[" + vo.getDesc() + "]";
				if (StringUtils.isNotEmpty(vo.getPrn())) depDesc += "[" + vo.getPrn() + "]";
				if (vo.getIsIssuedS() != null && Boolean.TRUE.equals(vo.getIsIssuedS())) depDesc += "[S]";
				if (vo.getIsIssuedF() != null && Boolean.TRUE.equals(vo.getIsIssuedF())) depDesc += "[F]";
				if (StringUtils.isNotEmpty(vo.getDailyCode())) depDesc += "[" + vo.getDailyCode() + "]";
				for (String badgeVO : vo.getDepartDateBadgeList()) {
					depDesc += "(" + badgeVO + ")";
				}
				vo.setDesc(depDesc);
				if (Double.compare(vo.getDiscount1(), 0D) > 0) vo.setDiscount1(vo.getDiscount1() * -1);
				if (Double.compare(vo.getDiscount2(), 0D) > 0) vo.setDiscount2(vo.getDiscount2() * -1);
				
				int totalSold = vo.getTfairPax() + vo.getAgentPax() + vo.getInHsePax() + vo.getKivPax() + vo.getOn9BookingPax();
				int balSeat = vo.getSeatAllot() - vo.getReservedSeat() - vo.getTourManagerPax() 
						- (vo.getTfairPax() + vo.getAgentPax() + vo.getInHsePax() + vo.getKivPax() + vo.getOn9BookingPax());
				
				vo.setTotalSold(totalSold);
				vo.setBalSeat(balSeat);
				
				tourDepartureList.add(vo);
			}
			
			String jasperFileName = CommonConstant.JAS_RPT_TOUR_DEP_FIND_TOUR_LIST;
			String reportName = CommonConstant.PDF_RPT_TOUR_DEP_FIND_TOUR_LIST;

			JasperPrint jasperPrint = ReportUtils.getJasperPrint(tourDepartureList, map, jasperFileName);
			//Convert cell type as report (eg: '350.00 to 350.00)
			jasperPrint.setProperty("net.sf.jasperreports.export.xls.detect.cell.type", "true");
			ReportUtils.printReportExcel(jasperPrint, reportName);
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	/**
	 * Load indvidual and department list
	 */
	public void handleSendEmail(TourDepartureVO vo) {
		try {
			trackingLogUtils.startLogs();
			tourDepVO = tourPkgBO.getTourDepById(vo.getId());
			emailType = ProductConstant.SEND_EMAIL_BY_INDIVIDUAL;
			idvEmployeeList = invoiceBO.getEmployeeViewList(this.getSessionInfoBean().getCompanyVO().getId());
			resetEmailForm();
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("LoadEmployeeList");
		}
	}
	
	public void handleSendFeedbackEmail(BookingVO bookingVO) {
		try {
			System.out.println("handleSendFeedbackEmail() - bookingId: " + bookingVO.getId());  
			List<FeedbackVO> feedbackList = feedbackBO.getInvoiceForFeedback(bookingVO.getId());
			if (CollectionUtils.isNotEmpty(feedbackList)) {
				emailingBO.sendCustomerFeedbackEmail(feedbackList);
				FacesContext.getCurrentInstance().addMessage(null, 
						new FacesMessage(FacesMessage.SEVERITY_INFO, "Feedback email sending initiated successfully.", ""));
			} else {
				FacesContext.getCurrentInstance().addMessage(null, 
						new FacesMessage(FacesMessage.SEVERITY_WARN, "No eligible invoice found to send feedback for this booking.", ""));
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public void handleCheckboxNotApplicable() {
		if (tourDepVO.getIsGroundNotApplicable()) {
			tourDepVO.setGrndTwn(0.0);
            tourDepVO.setGrndSgl(0.0);
            tourDepVO.setGrndCtw(0.0);
            tourDepVO.setGrndCeb(0.0);
            tourDepVO.setGrndCnb(0.0);
		}
	}
	
	public void processSendEmail() {
		try {
			boolean isPass = true;
			if (StringUtils.equals(emailType, ProductConstant.SEND_EMAIL_BY_INDIVIDUAL) ) {
				if (CollectionUtils.isNotEmpty(fullEmployeeList)) {
					emailEmployeeList = new ArrayList<String>();
					for(EmployeeViewVO vo : idvEmployeeList){
						for(String id : fullEmployeeList) {
							if(StringUtils.equals(id, String.valueOf(vo.getId()))) {
								if(StringUtils.isNotBlank(vo.getUserVO().getEmailAddress()))
									emailEmployeeList.add(vo.getUserVO().getEmailAddress());
							}
						}
					}
					emailingBO.sendTourDepNOEmailByIndividual(tourDepVO, emailEmployeeList, emailRemarks, getSessionInfo().getUserVO());
					isPass = false;
				}
			} else {
				if(CollectionUtils.isNotEmpty(departmentList)) {
					emailingBO.sendTourDepNOEmailByDepartment(tourDepVO, departmentList, emailRemarks, this.getSessionInfoBean().getCompanyVO().getId(), getSessionInfo().getUserVO());
					isPass = false;
				}
			}
			
			resetEmailForm();
			
			if (!isPass) {
				FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_INFO, "Mail Sent Successfully", "");
				FacesContext.getCurrentInstance().addMessage(null, msg);
			}
			RequestContext.getCurrentInstance().addCallbackParam("isPass", isPass);
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void selectAllSeason(AjaxBehaviorEvent event) {
		//String arr = ((UIOutput) event.getSource()).getValue().toString();
		
		boolean isSelectedAll = false;
		if (!tourDepVO.getSelectedSeason().contains("ALL") && tourDepVO.getSelectedSeason().size() == refDataListSeason.size()-1) {
			isSelectedAll = true;
		} else if (tourDepVO.getSelectedSeason().contains("ALL")) {
			isSelectedAll = true;
		}
		
		if (isSelectedAll) {
			tourDepVO.getSelectedSeason().clear();
			tourDepVO.getSelectedSeason().add("ALL");
		}
	}
	
	/**
	 * @param tourPkgVO the tourPkgVO to set
	 */
	public void setTourPkgVO(TourPackageVO tourPkgVO, TourThemeVO vo) {
		try {
			activeDailyItineryIndex = 0;
			this.tourPkgVO = tourPkgVO;
			tourCountryList = tourPkgBO.getTourThemeList(searchParamVO, null);
			tourPkgVO.setIdCountry(vo.getId());
			specTourThemeList = tourPkgBO.getSpecTourThemeList(vo);
			// Get Sales Commission Configuration List
			salesCommConfigList = salesCommConfigBO.getSalesCommConfigList();
			tourPkgBO.getTourPackageAttributeList(tourPkgVO.getId());
			tourPkgVO.setTourPkgCountryVO(new TourPackageCountryVO());
			reloadTourPackageDetail();
			loadContinentList();
			loadCountryList();
			loadCityList();
			loadCruiseList();
			if(CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCountryVO().getIdRegionList())) {
				tourPkgVO.getTourPkgCountryVO().setRegionName("");
				for(RegionVO regionVO : fullRegionList) {
					for (String region : tourPkgVO.getTourPkgCountryVO().getIdRegionList()){
						if(regionVO.getId().equals(Long.valueOf(region))) {
							tourPkgVO.getTourPkgCountryVO().setRegionName(StringUtils.isBlank(tourPkgVO.getTourPkgCountryVO().getRegionName()) ? regionVO.getRegionname() : tourPkgVO.getTourPkgCountryVO().getRegionName() + ", " + regionVO.getRegionname()); 
						}
					}
				}
			}
			if(CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCountryVO().getIdCountryList())) {
				tourPkgVO.getTourPkgCountryVO().setCountryName("");
				for(CountryVO countryVO : fullCountryList) {
					for (String country : tourPkgVO.getTourPkgCountryVO().getIdCountryList()){
						if(countryVO.getId().equals(Long.valueOf(country))) {
							tourPkgVO.getTourPkgCountryVO().setCountryName(StringUtils.isBlank(tourPkgVO.getTourPkgCountryVO().getCountryName()) ? countryVO.getCountry() : tourPkgVO.getTourPkgCountryVO().getCountryName() + ", " + countryVO.getCountry()); 
						}
					}
				}
			}
			if(CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCountryVO().getIdCityList())) {
				tourPkgVO.getTourPkgCountryVO().setCityName("");
				for(CityVO cityVO : fullCityList) {
					for (String city : tourPkgVO.getTourPkgCountryVO().getIdCityList()){
						if(cityVO.getId().equals(Long.valueOf(city))) {
							tourPkgVO.getTourPkgCountryVO().setCityName(StringUtils.isBlank(tourPkgVO.getTourPkgCountryVO().getCityName()) ? cityVO.getName() : tourPkgVO.getTourPkgCountryVO().getCityName() + ", " + cityVO.getName()); 
						}
					}
				}
			}
			
			tourBadgeZhDesc = "";
			tourBadgeDesc = "";
			travelStyleZhDesc = "";
			travelStyleDesc = "";
			
			for (String tourBadgeCode : tourPkgVO.getTourBadgeTagZhList()) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE_ZH, tourBadgeCode);
				if (StringUtils.isBlank(tourBadgeZhDesc))
					tourBadgeZhDesc = tempDesc;
				else
					tourBadgeZhDesc = tourBadgeZhDesc + ", " + tempDesc;
			}
			
			for (String tourBadgeCode : tourPkgVO.getTourBadgeTagList()) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE, tourBadgeCode);
				if (StringUtils.isBlank(tourBadgeDesc))
					tourBadgeDesc = tempDesc;
				else
					tourBadgeDesc = tourBadgeDesc + ", " + tempDesc;
			}
			
			for (String travelStyleCode : tourPkgVO.getTravelStyleZhList()) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_TRAVEL_STYLE_ZH, travelStyleCode);
				if (StringUtils.isBlank(travelStyleZhDesc))
					travelStyleZhDesc = tempDesc;
				else
					travelStyleZhDesc = travelStyleZhDesc + ", " + tempDesc;
			}
		
			for (String travelStyleCode : tourPkgVO.getTravelStyleList()) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_TRAVEL_STYLE, travelStyleCode);
				if (StringUtils.isBlank(travelStyleDesc))
					travelStyleDesc = tempDesc;
				else
					travelStyleDesc = travelStyleDesc + ", " + tempDesc;
			}
			
			if (tourPkgVO.getOpPic() != null && tourPkgVO.getOpPic().length() > 0) {
				tourPkgVO.setOpPicList(Arrays.asList(tourPkgVO.getOpPic().replaceAll(",$", "").split(",", -1)));
			}
			handleOpPicChange("PKG");
			
			setTourPkgHistory(tourPkgVO);
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
