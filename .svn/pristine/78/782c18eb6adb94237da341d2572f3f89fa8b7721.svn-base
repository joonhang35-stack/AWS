	/**
	 * Add tour package
	 */
	public void addTourPkg() {
		try {
			trackingLogUtils.startLogs();
			
			// Update all daily itinerary
			tourPkgVO.getTourPkgDailyItineraryAUDList().getUpdList().addAll(tourPkgVO.getTourPkgDailyItineraryVOList());
			
			// insert tour image if exists
			tourPkgVO.setTourImageVOList(new ArrayList<TourImageVO>(tourImageMap.values()));
			
			tourPkgVO.setStatusCode(CommonConstant.STATUS_CD_ACTIVE);
			if (ProductConstant.TYPE_CRUISE.equals(searchParamVO.getObj1())) {
				tourPkgVO.setIdTourCat(Long.valueOf(searchParamVO.getObj2().toString()));	
			}
			tourPkgBO.addTourPkg(tourPkgVO);
			
			fileUploadUtils.uploadFile();
			
			successResult();
			
			if (CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgDailyItineraryVOList())) {
				for (TourPackageDailyItineraryVO vo : tourPkgVO.getTourPkgDailyItineraryVOList()) {
					vo.setGenAUDDailyItineraryItemVOList(new GenAddUpdDelVO<TourPackageDailyItineraryItemVO>());
				}
			}
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("addTourPkg");
		}
	}
	
	/**
	 * Update tour package
	 */
	public void updTourPkg() {
		try {
			trackingLogUtils.startLogs();
			
			// insert 1st time tour package history
			if (tourPkgVO.getVersion().intValue() == 1)
				insertTourPkgHistory(tourPkgVO.getId(), CommonConstant.ACTION_CD_ADD, "");
			
			// Update all daily itinerary
			tourPkgVO.getTourPkgDailyItineraryAUDList().getUpdList().addAll(tourPkgVO.getTourPkgDailyItineraryVOList());
			
			// insert tour itinery if exists
			tourPkgVO.setTourPkgItineryVOList(new ArrayList<TourPackageItineryVO>(pkgItineryMap.values()));
			// insert tour image if exists
			tourPkgVO.setTourImageVOList(new ArrayList<TourImageVO>(tourImageMap.values()));
			// set remain tour code to true if tour badge 'Chartered Flight' has chosen and tourDepList must be not empty
			List<TourDepartureVO> tourDepList = tourPkgBO.getTourDepList(tourPkgVO.getId(), null);
			if (CollectionUtils.isNotEmpty(tourDepList) && tourPkgVO.getTourBadgeTagList().contains(CommonConstant.LOOKUP_ITM_TOUR_BADGE_CHAR_FLIGHT)) {
				tourPkgBO.updateTourDepsRemainTc(tourPkgVO);
			}
			// update tour package
			tourPkgBO.updateTourPkg(tourPkgVO, tourPkgHistoryVO);
			// insert tour package history
			insertTourPkgHistory(tourPkgVO.getId(), CommonConstant.ACTION_CD_UPD, tourPkgVO.getReason());
			
			tourPkgVO.setReason("");
			fileUploadUtils.uploadFile();
			
			successResult();
			reloadTourPackageDetail();
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("updTourPkg");
		}
	}
	
	/**
	 * Delete tour package
	 */
	public void delTourPkg() {
		try {
			trackingLogUtils.startLogs();
			
			// update tour package to inactive
			tourPkgBO.delTourPkg(tourPkgVO);
			
			// insert tour package history
			insertTourPkgHistory(tourPkgVO.getId(), CommonConstant.ACTION_CD_DEL, tourPkgVO.getReason());
			
			handleTourCatSelect(true);
			resetForm();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("delTourPkg");
		}
	}
	
	/**
	 * Add tour departure
	 */
	public void addTourDep() {
		try {
			trackingLogUtils.startLogs();
			

			if (ProductConstant.TYPE_CRUISE.equals(searchParamVO.getObj1())) {
				// if airline schedule is empty
				if (tourDepVO.getIdCruiseSchedule() == null || StringUtils.isEmpty(tourDepVO.getCruiseScheduleItems()))
					throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_CRUISE_SCHEDULE_CANNOT_EMPTY);
			} else { 
				if (tourDepVO.getIdAirlineSchedule() == null || StringUtils.isEmpty(tourDepVO.getAirlineScheduleItems()))
					throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_AIRLINE_SCHEDULE_CANNOT_EMPTY);
			}
			
			// if tour departure item is empty
			if (tourDepVO.getTourDepItemList() == null || tourDepVO.getTourDepItemList().isEmpty())
				throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_ITEM_EMPTY);
			
			// Check Valid discount seat -START-
			if (!checkIsValidDiscountPax(0)) {
				return;
			}
			// Check Valid discount seat -END-
			
			// Check Tour Departure Date Year is same as Tour Package Year
			SimpleDateFormat yearFormat = new SimpleDateFormat("yyyy");
	        String depYear = yearFormat.format(tourDepVO.getDtDep());
	        
	        if (!depYear.equals(tourPkgVO.getYear())) {
                throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_DEPARTURE_DATE_YEAR_NOT_EQUAL);
            }
			
			// set itinery to list 
			tourDepVO.setTourItineryList(new ArrayList<TourItineryVO>(itineryMap.values()));  
			// set remain tour code to true if depart date badge 'Guaranteed Departure' has chosen
			if (tourDepVO.getDepartDateBadgeList().contains("CFM ")) {
				tourDepVO.setIsRemainTc(true);
			}
			// set remain tour code to true if private tour true
			if (tourDepVO.getIsPrivateTour()) {
				tourDepVO.setIsRemainTc(true);
			}			
			if (ProductConstant.TYPE_CRUISE.equals(searchParamVO.getObj1())) {
				tourDepVO.setTourTypeCode("CRUISE");
			}
			
			tourPkgBO.addTourDep(tourDepVO);
			// upload itinery 
			fileUploadUtils.uploadFile();
			// list tour departure 
			reloadTourDepList();
			// reset form 
			resetTourDepForm(); 
			handleAddTourDepSelect();
			successResult();
			
		} catch (Throwable t) { 
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("addTourDep");
		}
	}
	
