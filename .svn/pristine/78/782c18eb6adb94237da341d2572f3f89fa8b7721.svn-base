	/**
	 * Handle tour departure selection
	 * @param vo
	 */
	public void handleTourDepSelect(TourDepartureVO vo) {
		try {
			trackingLogUtils.startLogs();
			
			tourDepVO = tourPkgBO.getTourDepById(vo.getId());//(TourDepartureVO) vo.clone();//tourPkgBO.getTourDepById(vo.getId());
			tourDepVO.setDailyCmsTitle(vo.getDailyCmsTitle());
			tourDepVO.setDailyCode(vo.getDailyCode());
			tourDepVO.setTourPackageDailyItineraryVO(vo.getTourPackageDailyItineraryVO());
			tourDepVO.setAgentPax(vo.getAgentPax());
			tourDepVO.setInHsePax(vo.getInHsePax());
			tourDepVO.setTfairPax(vo.getTfairPax());
			tourDepVO.setOn9BookingPax(vo.getOn9BookingPax());
			tourDepVO.setKivPax(vo.getKivPax());
			tourDepVO.setSeqNo(vo.getSeqNo());
			// set tour departure history
			setTourDepHistory(tourDepVO);
			loadAirlineList();
			loadCruiseList();

			List<TourPackageRemarksVO> remarksList = tourPkgBO.getTourPackageRemarks(tourDepVO.getId());
			tourDepVO.setTourPackageRemarksList(remarksList); 
			
			List<TourDepartureDiscountVO> discountList = tourPkgBO.getTourDepDiscount(tourDepVO.getId());
			tourDepVO.setTourDepartureDiscountVOList(discountList);
			
			tourDepVO.setDepartDateBadgeList(tourPkgBO.getDepartureTagList(tourDepVO.getId(), CommonConstant.LOOKUP_CAT_CD_DEPART_DATE_BADGE));
			tourDepVO.setDepartDateBadgeZhList(tourPkgBO.getDepartureTagList(tourDepVO.getId(), CommonConstant.LOOKUP_CAT_CD_DEPART_DATE_BADGE_ZH));
			setDepartDateBadgeDesc();
			
			// set itineries
			tourDepVO.setTourItineryList(vo.getTourItineryList());
			// get tour itinery
			if (CollectionUtils.isNotEmpty(tourDepVO.getTourItineryList())) {
				for (TourItineryVO itineryVO : tourDepVO.getTourItineryList()) {
					itineryMap.put(itineryVO.getTypeCd() + itineryVO.getLangCd(), itineryVO);
				}
			}
			// get tour dep hotel list
			tourDepVO.setTourHotelList(tourPkgBO.getTourHotelList(tourDepVO.getId()));
			// set airline
			
			if (ProductConstant.TYPE_CRUISE.equals(searchParamVO.getObj1())) {
				tourDepVO.setCruiseVO(getCruiseInfo(tourDepVO.getIdCruise()));
			} else {
				tourDepVO.setAirlineVO(getAirlineInfo(tourDepVO.getIdAirline()));
			}
			
			// get tour dep remarks
			if (CollectionUtils.isNotEmpty(tourDepVO.getTourPackageRemarksList())) { 
				for (TourPackageRemarksVO tourRemarksVO : tourDepVO.getTourPackageRemarksList()) { 
					tourRemarksVO.setIdTourDep(tourDepVO.getId()); 
				}
			}
			
			// get tour dep season
			List<String> seasonList = tourPkgBO.getTourDepSeason(tourDepVO.getId());
			tourDepVO.setSelectedSeason(seasonList);
			selectAllSeason(null);
			
			// get tour dep items
			showTourDepItemList();
			
			if (ProductConstant.TYPE_CRUISE.equals(searchParamVO.getObj1())) {
				// set airline schedule
				tourDepVO.setCruiseScheduleVO(cruiseBO.getCruiseSchedule(tourDepVO));
				handleCruiseScheduleSelect(tourDepVO.getCruiseScheduleVO(), false);
			} else {
				// set airline schedule
				tourDepVO.setAirlineScheduleVO(airlineBO.getAirlineSchedule(tourDepVO));
				handleAirlineScheduleSelect(tourDepVO.getAirlineScheduleVO(), false);
			}
			
			// https://applevacationsmy.monday.com/boards/1957151896/pulses/2010746151
			// Request: Please make it not to show flight scheduled on website, aws and email if [Show Flight Schedule] = NO
			if (!tourDepVO.getIsShowAirline()) {
				if (tourDepVO.getAirlineScheduleVO() != null && CollectionUtils.isNotEmpty(tourDepVO.getAirlineScheduleVO().getAirlineScheduleItemList())) {
					tourDepVO.getAirlineScheduleVO().setAirlineScheduleItemList(new ArrayList<AirlineScheduleItemVO>());
				}
			}
			
			if (!tourDepVO.getIsShowCruise()) {
				if (tourDepVO.getCruiseScheduleVO() != null && CollectionUtils.isNotEmpty(tourDepVO.getCruiseScheduleVO().getCruiseScheduleItemList())) {
					tourDepVO.getCruiseScheduleVO().setCruiseScheduleItemList(new ArrayList<CruiseScheduleItemVO>());
				}
			}
			
			// set itinerary cms
			tourDepVO.setTourPkgDailyItineraryVOList(tourPkgBO.getTourPkgDailyItineraryList(tourDepVO.getIdTourPkg()));
			
			loadSalesCommConfig(tourPkgVO.getIdSalesCommConf());
			
			if (tourDepVO.getOpPic() != null && tourDepVO.getOpPic().length() > 0) {
				tourDepVO.setOpPicList(new ArrayList<String>(Arrays.asList(tourDepVO.getOpPic().replaceAll(",$", "").split(",", -1))));
			}
			handleOpPicChange("DEP");
			
			// Private PIC
			if (tourDepVO.getPrivatePic() != null && tourDepVO.getPrivatePic().length() > 0) {
				tourDepVO.setPrivatePicList(new ArrayList<String>(Arrays.asList(tourDepVO.getPrivatePic().replaceAll(",$", "").split(",", -1))));
			}
			handlePrivatePicChange("DEP");

			// handle date year restriction
			if (StringUtils.isNotBlank(tourPkgVO.getYear())) {
				String year = tourPkgVO.getYear();
				int yearInt = Integer.parseInt(year);
				Calendar minCal = Calendar.getInstance();
		        minCal.set(yearInt, 0, 1); // Set to first day of the specified year
		        minDate = minCal.getTime();
			    Calendar maxCal = Calendar.getInstance();
			    maxCal.set(yearInt, 11, 31); // Set to last day of the specified year
			    maxDate = maxCal.getTime();
			}
		    
		    isTourStatusChanged = false;
	        isTourDepLockChanged = false;
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("handleTourDepSelect");
		}
	}
	
	private void setDepartDateBadgeDesc() {
		deptDateDesc = "";
		deptDateZhDesc = "";
		for (String deptDateBadgeCode : tourDepVO.getDepartDateBadgeZhList()) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_DEPART_DATE_BADGE_ZH, deptDateBadgeCode);
				if (StringUtils.isBlank(deptDateZhDesc))
					deptDateZhDesc = tempDesc;
				else
					deptDateZhDesc = deptDateZhDesc + ", " + tempDesc;
		}
		for (String deptDateBadgeCode : tourDepVO.getDepartDateBadgeList()) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_DEPART_DATE_BADGE, deptDateBadgeCode);
				if (StringUtils.isBlank(deptDateDesc))
					deptDateDesc = tempDesc;
				else
					deptDateDesc = deptDateDesc + ", " + tempDesc;
		}		
	}

	/**
	 * Handle add tour departure
	 */
	public void handleAddTourDepSelect() {
		try {
			// set some parameters
			tourDepVO.setIdTourPkg(tourPkgVO.getId());
			tourDepVO.setCnaAdt(tourPkgVO.getCnaAdt());
			tourDepVO.setCpaAdt(tourPkgVO.getCpaAdt());
			tourDepVO.setCsiAdt(tourPkgVO.getCsiAdt());
			tourDepVO.setTfairDiscount(tourPkgVO.getTfairDiscount());
			tourDepVO.setNumDays(tourPkgVO.getNumDays());
			tourDepVO.setNumNights(tourPkgVO.getNumNights());
			tourDepVO.setTourPackageRemarksList(new ArrayList<TourPackageRemarksVO>());
			tourDepVO.setStatusCode(CommonConstant.STATUS_CD_ACTIVE);
			tourDepVO.setAccCodeStatusCd(ProductConstant.TOUR_DEP_STATUS_CD_PENDING);
			tourDepVO.setCode(tourPkgVO.getCode());
			tourDepVO.setLangCode(tourPkgVO.getLangCode());
			tourDepVO.setIsVisaRequired(tourPkgVO.getIsVisaRequired());
			tourDepVO.setDeadline(tourPkgVO.getDeadline());
			tourDepVO.setOpPic(tourPkgVO.getOpPic());
			if (tourDepVO.getOpPic() != null && tourDepVO.getOpPic().length() > 0) {
				tourDepVO.setOpPicList(new ArrayList<String>(Arrays.asList(tourDepVO.getOpPic().replaceAll(",$", "").split(",", -1))));
			}
			handleOpPicChange("DEP");
			
			tourDepVO.setTourDepartureDiscountVOList(new ArrayList<TourDepartureDiscountVO>());
			tourDepVO.setGenAUDTourDepDiscountVO(new GenAddUpdDelVO<TourDepartureDiscountVO>());
			tourDepVO.setTourPkgDailyItineraryVOList(tourPkgBO.getTourPkgDailyItineraryList(tourDepVO.getIdTourPkg()));
			
			if (tourPkgVO.getTfairDiscount() > 0) {
				TourDepartureDiscountVO discountVO = new TourDepartureDiscountVO();
				discountVO.setDiscountAmt(tourPkgVO.getTfairDiscount());
				discountVO.setDiscountPax(0);
				
				GenUpdateVOList.processAddUpdDelVO(tourDepVO.getGenAUDTourDepDiscountVO(), tourDepVO.getTourDepartureDiscountVOList(), discountVO, ConstantScreenAction.ADD);
			}

			if (ProductConstant.TYPE_CRUISE.equals(searchParamVO.getObj1())) {
				tourDepVO.setTourTypeCode("CRUISE");
				tourDepVO.setIdCruise(tourPkgVO.getIdCruise());
			}
			System.out.println("searchParamVO.getObj1(): " + searchParamVO.getObj1());
			System.out.println("tourPkgVO.getIdCruise(): " + tourPkgVO.getIdCruise());
			
			// set default Company Code
			if (checkTourDepItemValidation()) throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_COMPANY_ITM_IMPORTED);
			List<TourDepItemVO> list = tourPkgBO.importDefaultInvoiceItems(tourDepVO, getCompanyInfo(this.getSessionInfoBean().getCompanyVO().getId()));
			if (tourDepVO.getTourDepItemList() == null) { 
				tourDepVO.setTourDepItemList(tourPkgBO.getTourDepItemList(tourDepVO.getId()));
			}
			tourDepVO.getTourDepItemList().addAll(list);
			// if add items on edit status
			if (tourDepVO.getId() != null) {
				for (TourDepItemVO vo : list) {
					tourDepItemAUDVO.getAddList().add(vo);
				}
			}
			showTourDepItemList();
			
			// handle date year restriction
			String year = tourPkgVO.getYear();
	        int yearInt = Integer.parseInt(year);
	        Calendar minCal = Calendar.getInstance();
	        minCal.set(yearInt, 0, 1); // Set to first day of the specified year
	        minDate = minCal.getTime();
	        Calendar maxCal = Calendar.getInstance();
	        maxCal.set(yearInt, 11, 31); // Set to last day of the specified year
	        maxDate = maxCal.getTime();
	        
	        isTourStatusChanged = false;
	        isTourDepLockChanged = false;
			setRemarksAdd(true);
			tourRemarksVO = new TourPackageRemarksVO();
			loadAirlineList();
			loadCruiseList();
			
			loadSalesCommConfig(tourPkgVO.getIdSalesCommConf());
			
//			for (TourDepItemVO vo : tourDepVO.getTourDepItemList()) {
//				System.out.println(vo.getIdAcct());
//			}
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
