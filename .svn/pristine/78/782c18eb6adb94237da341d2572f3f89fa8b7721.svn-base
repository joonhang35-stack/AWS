	@Override
	public void resetForm() {
		tourThemeVO = new TourThemeVO();
		
		tourThemeVO.setStatusCode(CommonConstant.STATUS_CD_ACTIVE);
		if (searchParamVO.getObj2() != null) tourThemeVO.setIdTourCat(Long.parseLong((String) searchParamVO.getObj2()));
		tourPkgVO = new TourPackageVO();
		tourRemarksVO = new TourPackageRemarksVO();
		tourPkgVO.setAddEdit(true);
		
		resetTourDepForm();
		// set default value
		tourPkgVO.setTypeCd((String) searchParamVO.getObj1());
		setRemarksAdd(true);  
		tourPkgVO.setTourPackageRemarksList(new ArrayList<TourPackageRemarksVO>());
		
		searchTourDep = new TourDepartureVO();
		searchTourDepFilter = new TourDepartureVO();
	}
	
