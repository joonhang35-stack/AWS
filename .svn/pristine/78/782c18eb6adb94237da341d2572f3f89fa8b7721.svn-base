	/**
	 * Add airline schedule
	 */
	public void addAirlineSchedule() {
		try {
			if (airlineScheduleVO.getId() == null) throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_AIRLINE_SCHEDULE_CANNOT_EMPTY);
			
			tourDepVO.setIdAirlineSchedule(airlineScheduleVO.getId());
			tourDepVO.setAirlineScheduleVO(airlineScheduleVO);
			tourPkgBO.setMiscAdtChd(tourDepVO, airlineScheduleVO, null);

			if (airlineScheduleVO.getAirlineScheduleItemList() != null && airlineScheduleVO.getAirlineScheduleItemList().size() > 0) {
				StringBuilder sb = new StringBuilder();
				StringBuilder sb2 = new StringBuilder();
				StringBuilder sb3 = new StringBuilder();
				StringBuilder sb4 = new StringBuilder();
				StringBuilder sb5 = new StringBuilder();
				StringBuilder sb6 = new StringBuilder();
				StringBuilder sb7 = new StringBuilder();
				for (AirlineScheduleItemVO airlineSchdlItem : airlineScheduleVO.getAirlineScheduleItemList()) {
					sb.append(airlineSchdlItem.getId());
					sb.append(",");
					if (airlineSchdlItem.getSeq() != null && airlineSchdlItem.getSeq() > 0) {
						sb2.append(airlineSchdlItem.getSeq());		
						sb2.append(",");
					} else {
						sb2.append(" ");		
						sb2.append(",");
					}
					if (airlineSchdlItem.getEtd() != null) {
						sb3.append(airlineSchdlItem.getEtd());
						sb3.append(",");
					} else {
						sb3.append(" ");		
						sb3.append(",");
					}
					if (airlineSchdlItem.getEta() != null) {
						sb4.append(airlineSchdlItem.getEta());
						sb4.append(",");
					} else {
						sb4.append(" ");		
						sb4.append(",");
					}
					if (airlineSchdlItem.getDepartureDate() != null) {
						sb5.append(airlineSchdlItem.getDepartureDate());
						sb5.append(",");
					} else {
						sb5.append(" ");		
						sb5.append(",");
					}
					if (airlineSchdlItem.getArrivalDate() != null) {
						sb6.append(airlineSchdlItem.getArrivalDate());
						sb6.append(",");
					} else {
						sb6.append(" ");		
						sb6.append(",");
					}
					if (airlineSchdlItem.getRemarks() != null) {
						sb7.append(airlineSchdlItem.getRemarks());
						sb7.append(",");
					} else {
						sb7.append(" ");		
						sb7.append(",");
					}
				}
				tourDepVO.setAirlineScheduleItems(sb.toString());
				tourDepVO.setAirlineScheduleItemsBySeq(sb2.toString());
				tourDepVO.setAirlineScheduleItemsByEtd(sb3.toString());
				tourDepVO.setAirlineScheduleItemsByEta(sb4.toString());
				tourDepVO.setAirlineScheduleItemsByDepDt(sb5.toString());
				tourDepVO.setAirlineScheduleItemsByArrDt(sb6.toString());
				tourDepVO.setAirlineScheduleItemsByRemarks(sb7.toString());
			} else throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_AIRLINE_SCHEDULE_CANNOT_EMPTY);
			resetAirlineScheduleForm();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleCruiseSelect() {
		try {
			cruiseScheduleList = cruiseBO.getCruiseScheduleList(tourDepVO.getIdCruise());
			
			if (tourDepVO.getIdCruiseSchedule() != null) {
				if (CollectionUtils.isNotEmpty(cruiseScheduleList)) {
					for (CruiseScheduleVO scheduleVO : cruiseScheduleList) {
						if (tourDepVO.getIdCruiseSchedule().longValue() == scheduleVO.getId().longValue()) {
							cruiseScheduleVO = scheduleVO;
							
							// Move selected cruise scheule to top
							int index = cruiseScheduleList.indexOf(scheduleVO);
							cruiseScheduleList.remove(index);
							cruiseScheduleList.add(0, scheduleVO);
							
							if (StringUtils.isNotEmpty(tourDepVO.getCruiseScheduleItems()) && StringUtils.isNotEmpty(tourDepVO.getCruiseScheduleItemsBySeq())) {
								SimpleDateFormat sdf = new SimpleDateFormat("E MMM dd HH:mm:ss Z yyyy");
								
								String[] cruiseSchdlItems = tourDepVO.getCruiseScheduleItems().replaceAll(",$", "").split(",", -1);
								String[] cruiseSchdlItemSeq =  tourDepVO.getCruiseScheduleItemsBySeq().replaceAll(",$", "").split(",", -1);
								String[] cruiseSchdlItemEtd =  (StringUtils.isEmpty(tourDepVO.getCruiseScheduleItemsByEtd()) ? new String [] {} : tourDepVO.getCruiseScheduleItemsByEtd().replaceAll(",$", "").split(",", -1));
								String[] cruiseSchdlItemEta =  (StringUtils.isEmpty(tourDepVO.getCruiseScheduleItemsByEta()) ? new String [] {} : tourDepVO.getCruiseScheduleItemsByEta().replaceAll(",$", "").split(",", -1));
								String[] cruiseSchdlItemDepDt =  (StringUtils.isEmpty(tourDepVO.getCruiseScheduleItemsByDepDt()) ? new String [] {} : tourDepVO.getCruiseScheduleItemsByDepDt().replaceAll(",$", "").split(",", -1));
								String[] cruiseSchdlItemArrDt =  (StringUtils.isEmpty(tourDepVO.getCruiseScheduleItemsByArrDt()) ? new String [] {} : tourDepVO.getCruiseScheduleItemsByArrDt().replaceAll(",$", "").split(",", -1));
								String[] cruiseSchdlItemRemarks =  (StringUtils.isEmpty(tourDepVO.getCruiseScheduleItemsByRemarks()) ? new String [] {} : tourDepVO.getCruiseScheduleItemsByRemarks().replaceAll(",$", "").split(",", -1));
								
								Map<String, String> unsortMap = new HashMap<String, String>();
								Map<String, String> unsortMapEtd = new HashMap<String, String>();
								Map<String, String> unsortMapEta = new HashMap<String, String>();
								Map<String, String> unsortMapDepDt = new HashMap<String, String>();
								Map<String, String> unsortMapArrDt = new HashMap<String, String>();
								Map<String, String> unsortMapRemarks = new HashMap<String, String>();
								
							    for (int i = 0; i < cruiseSchdlItems.length; i++) {
							    	unsortMap.put(cruiseSchdlItems[i], StringUtils.isBlank(cruiseSchdlItemSeq[i]) ? "" : String.valueOf(cruiseSchdlItemSeq[i]));
							    	if(cruiseSchdlItemEtd.length > 0)	
							    		unsortMapEtd.put(cruiseSchdlItems[i], StringUtils.isBlank(cruiseSchdlItemEtd[i]) ? "" : cruiseSchdlItemEtd[i]);
							    	if(cruiseSchdlItemEta.length > 0)	
							    		unsortMapEta.put(cruiseSchdlItems[i], StringUtils.isBlank(cruiseSchdlItemEta[i]) ? "" : cruiseSchdlItemEta[i]);
							    	if(cruiseSchdlItemDepDt.length > 0)
							    		unsortMapDepDt.put(cruiseSchdlItems[i], StringUtils.isBlank(cruiseSchdlItemDepDt[i]) ? "" : cruiseSchdlItemDepDt[i]);
							    	if(cruiseSchdlItemArrDt.length > 0)	
							    		unsortMapArrDt.put(cruiseSchdlItems[i], StringUtils.isBlank(cruiseSchdlItemArrDt[i]) ? "" : cruiseSchdlItemArrDt[i]);
							    	if(cruiseSchdlItemRemarks.length > 0)	
							    		unsortMapRemarks.put(cruiseSchdlItems[i], StringUtils.isBlank(cruiseSchdlItemRemarks[i]) ? "" : cruiseSchdlItemRemarks[i]);
							    }
							    Map<String, String> cruiseScheduleItemsMap = new TreeMap<String, String>(unsortMap);
							    Map<String, String> cruiseScheduleItemsMapEtd = new TreeMap<String, String>(unsortMapEtd);
							    Map<String, String> cruiseScheduleItemsMapEta = new TreeMap<String, String>(unsortMapEta);
							    Map<String, String> cruiseScheduleItemsMapDepDt = new TreeMap<String, String>(unsortMapDepDt);
							    Map<String, String> cruiseScheduleItemsMapArrDt = new TreeMap<String, String>(unsortMapArrDt);
							    Map<String, String> cruiseScheduleItemsMapRemarks = new TreeMap<String, String>(unsortMapRemarks);
								scheduleVO.setSelectedScheduleItems(new CruiseScheduleItemVO[cruiseScheduleItemsMap.size()]);
							
								if (CollectionUtils.isNotEmpty(scheduleVO.getCruiseScheduleItemList())) {
									for (CruiseScheduleItemVO itemVO : scheduleVO.getCruiseScheduleItemList()) {
										for (Map.Entry<String, String> entry : cruiseScheduleItemsMap.entrySet()) {
											if (itemVO.getId().longValue() == Long.parseLong((String)entry.getKey())) {
												itemVO.setSeq(StringUtils.isEmpty(entry.getValue()) ? null : Integer.parseInt(entry.getValue()));
												//i++;
											}
										}
										for (Map.Entry<String, String> entry : cruiseScheduleItemsMapEtd.entrySet()) {
											if (itemVO.getId().longValue() == Long.parseLong((String)entry.getKey())) {
												itemVO.setEtd(StringUtils.isEmpty(entry.getValue()) ? "" : (String) entry.getValue());
												//i++;
											}
										}
										for (Map.Entry<String, String> entry : cruiseScheduleItemsMapEta.entrySet()) {
											if (itemVO.getId().longValue() == Long.parseLong((String)entry.getKey())) {
												itemVO.setEta(StringUtils.isEmpty(entry.getValue()) ? "" : (String) entry.getValue());
												//i++;
											}
										}
										for (Map.Entry<String, String> entry : cruiseScheduleItemsMapDepDt.entrySet()) {
											if (itemVO.getId().longValue() == Long.parseLong((String)entry.getKey())) {
												itemVO.setDepartureDate(StringUtils.isEmpty(entry.getValue()) ? null : sdf.parse(entry.getValue()));
												//i++;
											}
										}
										for (Map.Entry<String, String> entry : cruiseScheduleItemsMapArrDt.entrySet()) {
											if (itemVO.getId().longValue() == Long.parseLong((String)entry.getKey())) {
												itemVO.setArrivalDate(StringUtils.isEmpty(entry.getValue()) ? null : sdf.parse(entry.getValue()));
												//i++;
											}
										}
										for (Map.Entry<String, String> entry : cruiseScheduleItemsMapRemarks.entrySet()) {
											if (itemVO.getId().longValue() == Long.parseLong((String)entry.getKey())) {
												itemVO.setRemarks(StringUtils.isEmpty(entry.getValue()) ? "" : (String) entry.getValue());
											}
										}
									}
								}
							}
							break;
						}
					}
				}
			}
			
			if (StringUtils.isNotBlank(tourDepVO.getCode())) {
				SimpleDateFormat sdf = new SimpleDateFormat("yyMMdd");
				
				if (tourDepVO.getCode().contains("_clone")) {
					tourDepVO.setCode(tourDepVO.getCode().substring(0, tourDepVO.getCode().indexOf("_clone")));
				}
				
				List<String> strList = Arrays.asList(tourDepVO.getCode().split("-"));
				
				int count = 0;
				
				if (validateDateFormat(strList.get(strList.size() - 1)) ) {
					for (CruiseVO cruiseVO : cruiseList) {
						if (cruiseVO.getId().equals(tourDepVO.getIdCruise())) {
							tourDepVO.setCode(tourDepVO.getCode().concat("-").concat(cruiseVO.getCode()));
							break;
						}
					}
				} else {
					tourDepVO.setCode("");
					for (String string : strList) {
						if (count > 0)
							tourDepVO.setCode(tourDepVO.getCode().concat("-"));
						
						if (validateDateFormat(string)) {
							string = sdf.format(tourDepVO.getDtDep());
							tourDepVO.setCode(tourDepVO.getCode().concat(string));
						} else {
							if (strList.indexOf(string) == strList.size() - 1) {
								for (CruiseVO cruiseVO : cruiseList) {
									if (cruiseVO.getId().equals(tourDepVO.getIdCruise())) {
										tourDepVO.setCode(tourDepVO.getCode().concat(cruiseVO.getCode()));
										break;
									}
								}
							} else 
								tourDepVO.setCode(tourDepVO.getCode().concat(string));
						}
						count++;
					}
				}
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void addCruiseSchedule() {
		try {
			if (cruiseScheduleVO.getId() == null) throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_CRUISE_SCHEDULE_CANNOT_EMPTY);
			
			tourDepVO.setIdCruiseSchedule(cruiseScheduleVO.getId());
			tourDepVO.setCruiseScheduleVO(cruiseScheduleVO);
			tourPkgBO.setCruiseMiscAdtChd(tourDepVO, cruiseScheduleVO, null);

			if (cruiseScheduleVO.getCruiseScheduleItemList() != null && cruiseScheduleVO.getCruiseScheduleItemList().size() > 0) {
				StringBuilder sb = new StringBuilder();
				StringBuilder sb2 = new StringBuilder();
				StringBuilder sb3 = new StringBuilder();
				StringBuilder sb4 = new StringBuilder();
				StringBuilder sb5 = new StringBuilder();
				StringBuilder sb6 = new StringBuilder();
				StringBuilder sb7 = new StringBuilder();
				for (CruiseScheduleItemVO cruiseSchdlItem : cruiseScheduleVO.getCruiseScheduleItemList()) {
					sb.append(cruiseSchdlItem.getId());
					sb.append(",");
					if (cruiseSchdlItem.getSeq() != null && cruiseSchdlItem.getSeq() > 0) {
						sb2.append(cruiseSchdlItem.getSeq());		
						sb2.append(",");
					} else {
						sb2.append(" ");		
						sb2.append(",");
					}
					if (cruiseSchdlItem.getEtd() != null) {
						sb3.append(cruiseSchdlItem.getEtd());
						sb3.append(",");
					} else {
						sb3.append(" ");		
						sb3.append(",");
					}
					if (cruiseSchdlItem.getEta() != null) {
						sb4.append(cruiseSchdlItem.getEta());
						sb4.append(",");
					} else {
						sb4.append(" ");		
						sb4.append(",");
					}
					if (cruiseSchdlItem.getDepartureDate() != null) {
						sb5.append(cruiseSchdlItem.getDepartureDate());
						sb5.append(",");
					} else {
						sb5.append(" ");		
						sb5.append(",");
					}
					if (cruiseSchdlItem.getArrivalDate() != null) {
						sb6.append(cruiseSchdlItem.getArrivalDate());
						sb6.append(",");
					} else {
						sb6.append(" ");		
						sb6.append(",");
					}
					if (cruiseSchdlItem.getRemarks() != null) {
						sb7.append(cruiseSchdlItem.getRemarks());
						sb7.append(",");
					} else {
						sb7.append(" ");		
						sb7.append(",");
					}
				}
				tourDepVO.setCruiseScheduleItems(sb.toString());
				tourDepVO.setCruiseScheduleItemsBySeq(sb2.toString());
				tourDepVO.setCruiseScheduleItemsByEtd(sb3.toString());
				tourDepVO.setCruiseScheduleItemsByEta(sb4.toString());
				tourDepVO.setCruiseScheduleItemsByDepDt(sb5.toString());
				tourDepVO.setCruiseScheduleItemsByArrDt(sb6.toString());
				tourDepVO.setCruiseScheduleItemsByRemarks(sb7.toString());
			} else throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_CRUISE_SCHEDULE_CANNOT_EMPTY);
			resetCruiseScheduleForm();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
