			for (String deptDateBadgeCode : tourDepVO.getDepartDateBadgeZhList()) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE_ZH, deptDateBadgeCode);
