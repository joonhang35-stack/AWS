<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="bankacct_list">
	
	<!-- backing bean, extends com.bcs.zsg.component.common.web.swf.bean.AppBackingBean -->
	<var name="bankAcctBean" class="com.bcs.zsg.bank.web.bean.BankAcctBean"/>
	
	<view-state id="bankacct_list">
		<on-entry>
			<evaluate expression="bankAcctBean.init()"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>