<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp"
				template="/WEB-INF/views/layouts/main.xhtml">

<ui:define name="content">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        var filters = document.querySelectorAll('input.ui-column-filter');
        filters.forEach(function(filter) {
            filter.setAttribute('enterkeyhint', 'enter');
        });
    });
</script>
<p:panel header="Exchange Order" toggleable="true" toggleSpeed="500">
	<h:form>
		<p:messages id="idEntryMsg"/>
	</h:form>
	
	<h:form id="idShowExOrderForm">
		<p:panelGrid style="margin-top:5px; width: 1300px">
			<p:row>
				<p:column style="width: 45px">
					<p:commandButton value="Add" actionListener="#{purchaseEOBean.booleanAdd}" oncomplete="varAddFuncDialog.show()" process="@this" update=":idDetailsDialog"/>
				</p:column>
				<p:column style="width: 20px;">
					<p:separator style="width:2px;height:20px" />
				</p:column>
				<p:column>
					<p:commandButton id="toggler" value="Columns" style="float:left"
						icon="ui-icon-calculator"
						actionListener="#{purchaseEOBean.handleChangeColumnsViewClick}"
						oncomplete="varListingTableViewDialog.show();" process="@this"
						update=":idListingTableViewDialog" />
				</p:column>
				<p:column style="width:120px;"><h:outputLabel for="idDepDateFrom">Issued Date From</h:outputLabel></p:column>
				<p:column style="width:80px;">
					<p:calendar id="idInvDateFrom" value="#{purchaseEOBean.invDateFrom}" navigator="true" showButtonPanel="true" size="12" pattern="dd-MMM-yyyy">
						<p:ajax event="dateSelect" update="idInvDateTo" global="false"/>
					</p:calendar>
				</p:column>
				<p:column style="width:20px;"><h:outputLabel for="idInvDateTo">To</h:outputLabel></p:column>
				<p:column style="width:80px;">
					<p:calendar id="idInvDateTo" value="#{purchaseEOBean.invDateTo}" mindate="#{purchaseEOBean.invDateFrom}"
						navigator="true" showButtonPanel="true" size="12" pattern="dd-MMM-yyyy">
					</p:calendar>
				</p:column>
				<p:column style="width:130px;"><h:outputLabel for="idDepDateFrom">Departure Date From</h:outputLabel></p:column>
				<p:column style="width:80px;">
					<p:calendar id="idDepDateFrom" value="#{purchaseEOBean.depDateFrom}" navigator="true" showButtonPanel="true" size="12" pattern="dd-MMM-yyyy">
						<p:ajax event="dateSelect" update="idDepDateTo" global="false"/>
					</p:calendar>
				</p:column>
				<p:column style="width:20px;"><h:outputLabel for="idDepDateTo">To</h:outputLabel></p:column>
				<p:column style="width:80px;">
					<p:calendar id="idDepDateTo" value="#{purchaseEOBean.depDateTo}" mindate="#{purchaseEOBean.depDateFrom}"
						navigator="true" showButtonPanel="true" size="12" pattern="dd-MMM-yyyy">
					</p:calendar>
				</p:column>`
				<p:column>
					<p:commandButton icon="ui-icon-search" value="Search" actionListener="#{purchaseEOBean.search}" update=":idShowExOrderForm:idPurEOTable,@form"/>
				</p:column>
				<p:column>
					<p:commandButton icon="ui-icon-print" actionListener="#{purchaseEOBean.printExOrder()}" value="Export" ajax="false"/>
				</p:column>
			</p:row>
		</p:panelGrid>
		<p:panelGrid id="idSearchPanel" style="display: none;">
			<p:row>		
				<p:column style="width: 66px;">
					<p:outputLabel for="idValidFrom" value="Date From" />
				</p:column>
				<p:column style="width: 80px;">
					<p:calendar id="idValidFrom" navigator="true" showButtonPanel="true" size="12"
						pattern="dd-MMM-yyyy" value="#{purchaseEOBean.fromDate}">
					</p:calendar>
	
				</p:column>
				<p:column style="width: 52px;">
					<p:outputLabel value="Date To" for="idValidTo" />
				</p:column>
				<p:column style="width: 66px;">
					<p:calendar id="idValidTo" navigator="true" showButtonPanel="true" size="12"
						pattern="dd-MMM-yyyy" value="#{purchaseEOBean.toDate}">
					</p:calendar>
				</p:column>
				<p:column style="width: 10px;">
					<p:separator style="width:2px;height:20px" />
				</p:column>
				<p:column style="width: 94px;">
					<p:outputLabel value="EO From"
						for="idEoFrom" />
				</p:column>
				<p:column style="width: 180px;">
					<p:inputText id="idEoFrom" maxlength="8" value="#{purchaseEOBean.eoFrom}" />
					<pe:keyFilter for="idEoFrom" mask="num" /> 
				</p:column>
				<p:column style="width: 70px;">
					<p:outputLabel value="EO To"
						for="idEoTo" />
				</p:column>
				<p:column style="width: 180px;">
					<p:inputText id="idEoTo" maxlength="8" value="#{purchaseEOBean.eoTo}" />
					<pe:keyFilter for="idEoTo" mask="num" /> 
				</p:column>
				<p:column style="width: 10px;">
					<p:separator style="width:2px;height:20px" />
				</p:column>
				<p:column>
					<p:commandButton value="Search" actionListener="#{purchaseEOBean.handleFilterSource}" id="eoSearch" oncomplete="purEOTable.clearFilters()" update="@form">
						</p:commandButton>
					<p:defaultCommand target="eoSearch" scope="idSearchPanel"/>
				</p:column>
			</p:row>
		</p:panelGrid>
		<p:dataTable id="idPurEOTable" widgetVar="purEOTable" value="#{purchaseEOBean.ldmExOrder}" var="purEO" paginator="true" rows="20" 
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
			rowsPerPageTemplate="20, 30, 50, 100, 300, 500, 1000, 1500" emptyMessage="#{msg['cust.tbl.empty.message']}"
			lazy="true" filterEvent="enter">

			<p:column headerText="Edit" style="width:50px; text-align:center;" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(1)}">
				<p:commandButton icon="ui-icon-pencil" actionListener="#{purchaseEOBean.onEOSelected(purEO)}"
					update=":idDetailsDialog" oncomplete="varAddFuncDialog.show()"/>
			</p:column>
			<p:column headerText="Cancel" style="width:50px; text-align:center;" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(2)}">
				<p:commandButton icon="ui-icon-close" actionListener="#{purchaseEOBean.onEOSelected(purEO)}" oncomplete="varDelEODialog.show()" disabled="#{purEO.status eq 'Cancelled'}"/>
			</p:column>
			<p:column headerText="Supplier Name" sortBy="#{purEO.supplierName}" style="width: 80px;" styleClass="txt_center" filterBy="#{purEO.supplierName}" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(3)}">
				<h:outputText value="#{purEO.supplierName}" />
			</p:column>
			<p:column headerText="EO Number" sortBy="#{purEO.code}" style="width: 80px;" styleClass="txt_center" filterBy="#{purEO.code}" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(4)}">
				<h:outputText value="#{purEO.code}"/>
			</p:column>
			<p:column headerText="Ordered By" sortBy="#{purEO.orderBy}" style="width: 80px;" styleClass="txt_center" filterBy="#{purEO.orderBy}" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(5)}">
				<h:outputText value="#{purEO.orderBy}" />
			</p:column>
			<p:column headerText="EO Date" sortBy="#{purEO.eoDt}" style="width: 80px;" styleClass="txt_center" filterBy="#{purEO.eoDt}" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(6)}">
				<h:outputText value="#{purEO.eoDt}"> 
					<f:convertDateTime pattern="dd-MMM-yyyy"/>
				</h:outputText>
			</p:column>
			<p:column headerText="Due Date" sortBy="#{purEO.dueDt}" style="width: 80px;" styleClass="txt_center" filterBy="#{purEO.dueDt}" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(7)}">
				<h:outputText value="#{purEO.dueDt}">
					<f:convertDateTime pattern="dd-MMM-yyyy"/>
				</h:outputText>
			</p:column>
			<p:column headerText="Tour Code" sortBy="#{purEO.tourCode}" style="width: 80px;" styleClass="txt_center" filterBy="#{purEO.tourCode}" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(8)}">
				<h:outputText value="#{purEO.tourCode}"/>
			</p:column>
			<p:column headerText="Total Amount" sortBy="#{purEO.totalForeCurAmt}" style="width: 80px;" styleClass="txt_center" filterBy="#{purEO.totalForeCurAmt}" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(9)}">
				<h:outputText value="#{purEO.totalForeCurAmt}"/>
			</p:column>
			<p:column headerText="Amount Due" sortBy="#{purEO.amtDue}" style="width: 80px;" styleClass="txt_center" filterBy="#{purEO.amtDue}" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(10)}">
				<h:outputText label="Amount Due" value="#{purchaseEOBean.formatMyrCurrency(purEO.amtDue)}">
					<!-- <f:convertNumber pattern="#,##0.00"/> -->
				</h:outputText>
			</p:column>
			<p:column headerText="Status" sortBy="#{purEO.status}" style="width: 80px;" styleClass="txt_center" filterBy="#{purEO.status}" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(11)}">
				<h:outputText value="#{purEO.status}" />
			</p:column>
			<p:column headerText="Additional Remarks" style="width: 80px;" styleClass="txt_center" filterBy="#{purEO.eoComments}" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(12)}">
				<p:outputLabel id="idAdditionalRemarks" value="View"
					rendered="#{purEO.eoComments ne null and purEO.eoComments ne ''}">
					<i class="fa fa-info-circle" aria-hidden="true" />
				</p:outputLabel>
				<pe:tooltip for="idAdditionalRemarks" shared="true" showDelay="300" targetPosition="top left" position="bottom right"
					rendered="#{not empty purEO.eoComments}">
					<h:outputText value="#{purEO.eoComments}" escape="true" style="white-space: pre-wrap"/>
				</pe:tooltip>
			</p:column>
			<p:column headerText="Document No." sortBy="#{purEO.docList}" filterBy="#{purEO.docListFull}" style="width: 120px;" styleClass="txt_center" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(16)}">
			    <h:outputText id="idDocText" value="#{purEO.docList}" escape="false"/> 
			    <pe:tooltip for="idDocText" value="#{purEO.docListFull}" escape="false" rendered="#{not empty purEO.docListFull and purEO.docList.contains('......')}"/>
			</p:column>
			<p:column headerText="Internal Remarks" style="width: 80px;" styleClass="txt_center" filterBy="#{purEO.eoInternalComments}" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(13)}">
				<p:outputLabel id="idInternalRemarks" value="View"
					rendered="#{purEO.eoInternalComments ne null and purEO.eoInternalComments ne ''}">
					<i class="fa fa-info-circle" aria-hidden="true" />
				</p:outputLabel>
				<pe:tooltip for="idInternalRemarks" shared="true" showDelay="300" targetPosition="top left" position="bottom right"
					rendered="#{not empty purEO.eoInternalComments}">
					<h:outputText value="#{purEO.eoInternalComments}" escape="true" style="white-space: pre-wrap"/>
				</pe:tooltip>
			</p:column>
			<p:column headerText="Updated By" sortBy="#{purEO.updatedBy}" style="width: 80px;" styleClass="txt_center" filterBy="#{purEO.updatedBy}" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(14)}">
				<h:outputText value="#{purEO.updatedBy}" />
			</p:column>
			<p:column headerText="Updated Date" sortBy="#{purEO.updatedDate}" style="width: 80px;" styleClass="txt_center" filterBy="#{purEO.updatedDate}" rendered="#{purchaseEOBean.listingTableViewVO.verifyVisibility(15)}">
				<h:outputText value="#{purEO.updatedDate}">
					<f:convertDateTime pattern="dd-MMM-yyyy HH:mm:ss" />
				</h:outputText>
			</p:column>
		</p:dataTable>
		<h:panelGrid>
			<p:commandButton value="Add" actionListener="#{purchaseEOBean.booleanAdd}" oncomplete="varAddFuncDialog.show()" process="@this" update=":idDetailsDialog"/>
		</h:panelGrid>
	</h:form>
</p:panel>

<p:dialog id="idSuppOptDialog" widgetVar="varSuppOptDialog" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
		<f:facet name="header">
			<h:outputFormat value="Supplier/ Vendor" />
		</f:facet>
		<h:form id="idAddSupplierForm">
		<ui:include src="../../purchase/common/exchange_order/add_supplier.xhtml"/>
		</h:form>
</p:dialog>
	
<p:dialog id="idDetailsDialog" widgetVar="varAddFuncDialog" modal="true" resizable="false" dynamic="true" draggable="true" closable="false">
		<f:facet name="header">
			<h:outputFormat value="Add Exchange Order" />
		</f:facet>
		<h:form id="idAddExOrderForm">
		<ui:include src="../../purchase/common/exchange_order/add_exchange_order.xhtml"/>
		</h:form>
</p:dialog>


<p:dialog id="idEODetailsDialog" widgetVar="varAddDetailsDialog" modal="true" resizable="false" dynamic="true" draggable="true" closable="false">
		<f:facet name="header">
			<h:outputFormat value="Add Exchange Order Details" />
		</f:facet>
		<h:form id="idAddEODetailsForm">
		<ui:include src="../../purchase/common/exchange_order/add_eo_details.xhtml"/>
		</h:form>
</p:dialog>

<p:dialog id="idEOPaxNameDialog" widgetVar="varAddPaxNameDialog" modal="true" resizable="false" dynamic="true" draggable="true" closable="false">
		<f:facet name="header">
			<h:outputFormat value="Add Pax Name" />
		</f:facet>
		<h:form id="idAddEOPaxNameForm">
		<ui:include src="../../purchase/common/exchange_order/add_eo_paxname.xhtml"/>
		</h:form>
</p:dialog>

<p:dialog id="idEOAirlineDialog" widgetVar="varAddAirlineDialog" modal="true" resizable="false" dynamic="true" draggable="true" closable="false">
		<f:facet name="header">
			<h:outputFormat value="Add Airline Details" />
		</f:facet>
		<h:form id="idAddEOAirlineForm">
		<ui:include src="../../purchase/common/exchange_order/add_eo_airline.xhtml"/>
		</h:form>
</p:dialog>

<p:dialog id="idEOHotelTourDialog" widgetVar="varAddHotelTourDialog" modal="true" resizable="false" dynamic="true" draggable="true" closable="false">
		<f:facet name="header">
			<h:outputFormat value="Add Hotel and Tour Details" />
		</f:facet>
		<h:form id="idAddEOHotelTourForm">
		<ui:include src="../../purchase/common/exchange_order/add_eo_hoteltour.xhtml"/>
		</h:form>
</p:dialog>

<!--
	DIALOG - EXCHANGE ORDER LIST
-->
