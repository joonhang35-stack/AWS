<!--
	DIALOG - EXCHANGE ORDER LIST
-->
<p:dialog id="idInvNoDialog" header="Document List" widgetVar="varInvNoDialog" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
	<p:ajax event="close" update=":idInvNoDialog" oncomplete="varInvNoDialog.hide()"/>
	
	<h:form id="idInvNoListForm">
		<p:dataTable widgetVar="varInvNoTable" value="#{purchaseEOBean.lazyInvoiceDataModel}" var="vo" paginator="true" rows="20" 
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
			filterEvent="enter" lazy="true" rowKey="#{vo.id}" selectionMode="single">
			<p:ajax event="rowSelect" listener="#{purchaseEOBean.handleInvNoSelect}"
				update=":idInvNoDialog,:idAddExOrderForm:idEOInvListPanel"
				oncomplete="varInvNoDialog.hide()"/>
			
			<!-- sortBy removed -->
			<p:column headerText="Document No." 
				
				filterBy="#{vo.code}" 
				filterMatchMode="contains">
				<h:outputText rendered="#{vo.docTypeCd eq 'I'}" value="#{purchaseEOBean.invPrefixVal} #{vo.code}" /> 
				<h:outputText rendered="#{vo.docTypeCd eq 'P'}" value="#{purchaseEOBean.psPrefixVal} #{vo.psNo}" /> 
			</p:column>
<!-- 			<p:column headerText="Document No." 
				sortBy="#{vo.docTypeCd eq 'P' ? purchaseEOBean.invPrefixVal+vo.psNo : purchaseEOBean.invPrefixVal+vo.code}" 
				filterBy="#{vo.docTypeCd eq 'P' ? purchaseEOBean.invPrefixVal+vo.psNo : purchaseEOBean.invPrefixVal+vo.code}" 
				filterMatchMode="contains">
				<h:outputText rendered="#{vo.docTypeCd eq 'I'}" value="#{purchaseEOBean.invPrefixVal} #{vo.code}" /> 
				<h:outputText rendered="#{vo.docTypeCd eq 'P'}" value="#{purchaseEOBean.psPrefixVal} #{vo.psNo}" /> 
			</p:column> -->
			<p:column headerText="Document Date" sortBy="#{vo.invoiceDt}" filterBy="#{vo.invoiceDt}">
				<h:outputText value="#{vo.invoiceDt}">
				<f:convertDateTime pattern="dd-MMM-yyyy" />
				</h:outputText>
			</p:column>
			<p:column headerText="Customer No." sortBy="#{vo.custCd}" filterBy="#{vo.custCd}">
				<h:outputText value="#{vo.custCd}" />
			</p:column>
			<p:column headerText="Customer Name" sortBy="#{vo.custName}" filterBy="#{vo.custName}" filterMatchMode="contains">
				<h:outputText value="#{vo.custName}" />
			</p:column>
			<p:column headerText="Sales Amount" sortBy="#{vo.amount}" filterBy="#{vo.amount}">
				<h:outputText value="#{vo.amount}">
					<f:convertNumber pattern="#,##0.00"/>
				</h:outputText>
			</p:column>
			<p:column headerText="Issued By" sortBy="#{vo.issuedBy}" filterBy="#{vo.issuedBy}" filterMatchMode="contains">
				<h:outputText value="#{vo.issuedBy}" />
			</p:column>
		</p:dataTable>
		
		<h:panelGrid columns="1">
			<p:commandButton value="#{msg['common.button.label.cancel']}" update=":idInvNoDialog" oncomplete="varInvNoDialog.hide()"/>
		</h:panelGrid>
	</h:form>
</p:dialog>
	
<p:confirmDialog widgetVar="varDelEODialog" message="Are you sure want to delete this record?">
	<h:form>
		<p:commandButton value="Yes"
			actionListener="#{purchaseEOBean.deleteEO}"
			oncomplete="varDelEODialog.hide()"
			update="@form,:idShowExOrderForm" />
		<p:commandButton value="Cancel"
			actionListener="#{purchaseEOBean.resetForm}"
			oncomplete="varDelEODialog.hide()" />
	</h:form>
</p:confirmDialog>

<p:dialog id="idListingTableViewDialog" header="Listing Table View"
			widgetVar="varListingTableViewDialog" modal="true" resizable="false"
			dynamic="true" draggable="true" closable="false">
			<h:form id="idListingTableViewForm">
				<ui:include
					src="../../maintenance/listingtableview/listing_ex_table_view.xhtml" />
			</h:form>
		</p:dialog>
	 
<!--
	DIALOG - TOUR DEPARTURE LIST
-->
<p:dialog id="idTourCodeList" header="Tour List" widgetVar="varTourCodeList" modal="true" resizable="false" dynamic="true" draggable="true" closable="false">
	<div style="overflow:auto; width:800px !important; height:500px !important;">
	<h:form>
	<p:dataTable id="idTourDepList" value="#{purchaseEOBean.lazyDataModelTourDep}" var="vo" paginator="true" rows="20" lazy="true" 
			paginatorTemplate="#{bterp:pageTemplate()}" 
			rowsPerPageTemplate="20, 30, 40" rowKey="#{vo.id}" selectionMode="single" filterEvent="enter">
		
		<p:ajax event="rowSelect" listener="#{purchaseEOBean.handleTourCodeSelect}" oncomplete="varTourCodeList.hide()"  update=":idTourCodeList,:idAddExOrderForm:idTabExOrder,:idAddExOrderForm:idTourCode,:idAddExOrderForm:idAddDepDt,:idAddExOrderForm:idAddRemarks,:idAddExOrderForm:msg" />
		<p:column headerText="Tour Code" sortBy="#{vo.code}" filterBy="#{vo.code}" filterMatchMode="contains" style="width:200px;">
			<h:outputText value="#{vo.code}" />   
		</p:column>
		<p:column headerText="Departure Date" sortBy="#{vo.dtDep}" filterBy="#{vo.dtDep}" filterMatchMode="contains" style="width:60px;">
			<h:outputText value="#{vo.dtDep}">
				<f:convertDateTime pattern="dd-MMM-yyyy" />
			</h:outputText> 
		</p:column>
		
		<p:column headerText="Package" sortBy="#{vo.packageDesc}" filterBy="#{vo.packageDesc}" filterMatchMode="contains">
			<h:outputText value="#{vo.packageDesc}" />   
		</p:column>
	</p:dataTable>
	<h:panelGrid columns="1" style="width: 1px;">
		<p:commandButton value="#{msg['common.button.label.cancel']}" actionListener="#{purchaseEOBean.resetImportEO}" onclick="varTourCodeList.hide();"/>
	</h:panelGrid>
	</h:form>
	</div>
</p:dialog>

<p:dialog id="idAddEOAttachmentDialog" header="Invoice"
	widgetVar="varAddEOAttachmentDialog" modal="true"
	resizable="false" dynamic="true" closable="false" width="600">
	<h:form id="idAddEOAttachmentForm">
		<ui:include src="../../purchase/common/exchange_order/add_eo_attachment.xhtml" />
	</h:form>
</p:dialog>

<p:dialog id="idEORemarksLogDialog" header="Remark List"
	widgetVar="varEORemarksLogDialog" modal="true" resizable="false"
	dynamic="true" draggable="true" closable="true" height="600">
	<p:ajax event="close" oncomplete="varEORemarksLogDialog.hide()" />
	
	<h:form id="idEORemarksLogListForm">
		<p:dataTable widgetVar="varEORemarksLogTable"
			value="#{purchaseEOBean.eoHistoryList}" var="vo" paginator="true"
			rows="10"
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
			filterEvent="enter" lazy="true" rowKey="#{vo.id}"
			style="width: 1200px;">

			<p:column headerText="Remarks" style="width:500px;">
				<h:outputText value="#{vo.eoComments}" escape="true"
					style="white-space: pre-wrap" />
			</p:column>
			<p:column headerText="Internal Remarks" style="width:500px;">
				<h:outputText value="#{vo.eoInternalComments}" escape="true"
					style="white-space: pre-wrap" />
			</p:column>
			<p:column headerText="Updated Date" sortBy="#{vo.updatedDate}"
				filterBy="#{vo.updatedDate}" style="width:150px;">
				<h:outputText value="#{vo.updatedDate}">
					<f:convertDateTime pattern="dd-MMM-yyyy HH:mm:ss" />
				</h:outputText>
			</p:column>
			<p:column headerText="Updated By" sortBy="#{vo.updatedBy}"
				filterBy="#{vo.updatedBy}" style="width:150px;">
				<h:outputText value="#{vo.updatedBy}" />
			</p:column>
		</p:dataTable>

		<h:panelGrid columns="1">
			<p:commandButton value="#{msg['common.button.label.cancel']}" oncomplete="varEORemarksLogDialog.hide()" />
		</h:panelGrid>
	</h:form>
</p:dialog>

<!-- DIALOG - DELETE ATTACHMENT CONFIRMATION -->
<p:confirmDialog widgetVar="varDelAttachmentDialog" header="Confirmation" message="Are you sure want to delete this attachment permenently?"
	closable="false">
	<h:form>
		<p:growl id="msg" />
		<p:commandButton value="#{msg['common.button.label.yes']}" actionListener="#{purchaseEOBean.deleteInvAttachment}"
			update=":idAddExOrderForm:idEOAttachmentListPanel"
			oncomplete="if (args &amp;&amp; !args.validationFailed) varDelAttachmentDialog.hide()" />
		<p:commandButton value="#{msg['common.button.label.no']}" onclick="varDelAttachmentDialog.hide()" />
	</h:form>
</p:confirmDialog>

<p:confirmDialog widgetVar="varDelAttachmentScannedCopyDialog" message="Are you sure want to delete this scanned copy?">
	<h:form>
		<p:growl id="msg" />
		<p:commandButton value="Yes" actionListener="#{purchaseEOBean.delAttachmentScannedCopy}"
			update=":idAddEOAttachmentForm:idPanelAttachmentScannedCopy"
			oncomplete="varDelAttachmentScannedCopyDialog.hide()" />
		<p:commandButton value="Cancel" onclick="varDelAttachmentScannedCopyDialog.hide()" />
	</h:form>
</p:confirmDialog>

<!--
	DIALOG - SEND EMAIL
-->
<p:dialog id="idSendEmailDialog" widgetVar="varSendEmailDialog"
	modal="true" resizable="false" dynamic="true" draggable="true"
	closable="false">
	<f:facet name="header">
		<h:outputFormat value="Send Email" />
	</f:facet>
	<h:form id="idSendEmailForm">
		<div style="height: 270px; width:500px; overflow: auto;">
		<p:growl id="msg" />
		<p:panelGrid id="idTypeDetails">
			<!-- <p:row>
				<p:column>
					<h:outputLabel for="idEmailType">Choose Category<span
							class="required">*</span>
					</h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu id="idEmailType" label="Choose Category"
						value="#{salesBean.emailType}" required="true">
						<f:selectItem itemLabel="Individual" itemValue="IDV" />
						<f:selectItem itemLabel="Department" itemValue="DPT" />
						<p:ajax event="change" update=":idSendEmailForm:idTypeDetails" />
					</h:selectOneMenu>
				</p:column>
			</p:row> -->
			<p:row>
				<p:column style="width:120px; text-align: left; vertical-align: top;">
					<h:outputLabel for="idIndividualList">Specific Person</h:outputLabel>
				</p:column>
				<p:column>
					<p:selectCheckboxMenu id="idIndividualList" value="#{purchaseEOBean.fullEmployeeList}" label="Specific Person" filter="true" filterMatchMode="contains"
						onHide="executeSelectEmployeeOnhide();" style="display: flex;width: fit-content;">
						<f:selectItems value="#{purchaseEOBean.employeeList}" var="vo" itemValue="#{vo.id}" itemLabel="#{vo.userVO.name}" />
					</p:selectCheckboxMenu>
					<p:remoteCommand name="executeSelectEmployeeOnhide" actionListener="#{purchaseEOBean.handleNtfctItemChange(1)}"
						update="idTxtSelectedEmployee" global="false" process="@this idSendEmailForm:idIndividualList"/>
					<p:outputLabel id="idTxtSelectedEmployee" value="#{purchaseEOBean.selectedEmployee}" style="float:left;"/>
				</p:column>
			</p:row>
			<p:row>
				<p:column style="width:120px; text-align: left; vertical-align: top;">
					<h:outputLabel for="idDepartmentList">Department</h:outputLabel>
				</p:column>
				<p:column>
					<p:selectCheckboxMenu id="idDepartmentList" value="#{purchaseEOBean.departmentList}" label="Department" filter="true" filterMatchMode="contains"
						onHide="executeSelectDepartmentOnhide();" style="display: flex;width: fit-content;">
						<f:selectItems value="#{bterp:lookupItemList('dept_type')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description} - #{vo.remarks}" />
					</p:selectCheckboxMenu>
					<p:remoteCommand name="executeSelectDepartmentOnhide" actionListener="#{purchaseEOBean.handleNtfctItemChange(2)}"
						update="idTxtSelectedDepartment" global="false" process="@this idSendEmailForm:idDepartmentList"/>
					<p:outputLabel id="idTxtSelectedDepartment" value="#{purchaseEOBean.selectedDepartment}" style="float:left;"/>
				</p:column>
			</p:row>
			<!-- <p:row>
				<p:column style="width:120px; text-align: left; vertical-align: top;">
					<h:outputLabel for="idInvoiceChangesList">Invoice Changes <span class="required">*</span></h:outputLabel>
				</p:column>
				<p:column>
					<p:selectCheckboxMenu id="idInvoiceChangesList" value="#{salesBean.invoiceChangesList}" label="Invoice Changes"
						filter="true" filterMatchMode="contains" required="true"
						onHide="executeSelectChangesOnhide();" style="display: flex;width: fit-content;">
						<f:selectItems value="#{bterp:lookupItemList('inv_changes')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
					</p:selectCheckboxMenu>
					<p:remoteCommand name="executeSelectChangesOnhide" actionListener="#{salesBean.handleNtfctItemChange(3)}"
						update="idTxtSelectedChanges" global="false" process="@this idSendEmailForm:idInvoiceChangesList"/>
					<p:outputLabel id="idTxtSelectedChanges" value="#{salesBean.selectedChanges}" style="float:left;"/>
				</p:column>
			</p:row> -->
		</p:panelGrid>
		<p:panelGrid>
			<p:row>
				<p:column style="width:120px; text-align: left; vertical-align: top;">
					<h:outputLabel for="idRemarksType">Remarks</h:outputLabel>
				</p:column>
				<p:column>
					<p:inputTextarea id="idRemarksType" rows="10" cols="50"
						value="#{purchaseEOBean.otherTypeRemark}"></p:inputTextarea>
				</p:column>
			</p:row>
		</p:panelGrid>
		</div>

		<h:panelGrid columns="2" style="width: 10px;">
			<p:commandButton value="#{msg['common.button.label.send']}"
				actionListener="#{purchaseEOBean.processSendEmail}" update="@form"
				oncomplete="if (args &amp;&amp; !args.validationFailed) varSendEmailDialog.hide()" />
			<p:commandButton value="#{msg['common.button.label.cancel']}"
				actionListener="#{purchaseEOBean.resetEmailForm}" update="@form"
				process="@this" oncomplete="varSendEmailDialog.hide()"
				global="false">
				<pe:resetEditableValues for="idSendEmailForm" />
			</p:commandButton>
		</h:panelGrid>
	</h:form>
</p:dialog>

<p:dialog id="idEONoDialog" header="Exchange Order List"
	widgetVar="varEONoDialog" modal="true" resizable="false"
	dynamic="true" draggable="true" closable="true">
	<p:ajax event="close" update=":idEONoDialog"
		oncomplete="varEONoDialog.hide()" />

	<h:form id="idEONoListForm">
		<p:dataTable widgetVar="varEONoTable"
			value="#{purchaseEOBean.lazyEORefDataModel}" var="vo" paginator="true"
			rows="20"
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
			filterEvent="enter" lazy="true" rowKey="#{vo.id}"
			selectionMode="single">
			<p:ajax event="rowSelect" listener="#{purchaseEOBean.handleEONoSelect}"
				update=":idEONoDialog, :idAddExOrderForm:idTabExOrder,
					:idAddExOrderForm:msg"
				oncomplete="varEONoTable.clearFilters();varEONoDialog.hide()" />

			<p:column headerText="Supplier Name" sortBy="#{vo.supplierName}"
				filterBy="#{vo.supplierName}" filterMatchMode="contains">
				<h:outputText value="#{vo.supplierName}" />
			</p:column>
			<p:column headerText="EO Number" sortBy="#{vo.code}"
				filterBy="#{vo.code}" filterMatchMode="contains">
				<h:outputText value="#{vo.code}" />
			</p:column>
			<p:column headerText="Tour Code" sortBy="#{vo.tourCode}"
				filterBy="#{vo.tourCode}" filterMatchMode="contains">
				<h:outputText value="#{vo.tourCode}" />
			</p:column>
			<p:column headerText="EO Date" sortBy="#{vo.eoDt}"
				filterBy="#{vo.eoDt}" filterMatchMode="contains">
				<h:outputText value="#{vo.eoDt}"> 
					<f:convertDateTime pattern="dd-MMM-yyyy"/>
				</h:outputText>
			</p:column>
			<p:column headerText="Status" sortBy="#{vo.status}"
				filterBy="#{vo.status}" filterMatchMode="contains">
				<h:outputText value="#{vo.status}" />
			</p:column>
			<p:column headerText="Ordered By" sortBy="#{vo.orderBy}"
				filterBy="#{vo.orderBy}" filterMatchMode="contains">
				<h:outputText value="#{vo.orderBy}" />
			</p:column>
		</p:dataTable>

		<h:panelGrid columns="1">
			<p:commandButton value="#{msg['common.button.label.cancel']}"
				update=":idEONoDialog" oncomplete="varEONoDialog.hide()" />
		</h:panelGrid>
	</h:form>
</p:dialog>

<p:dialog id="idAddInvoiceRefDialog" header="Invoice"
	widgetVar="varAddInvoiceRefDialog" modal="true" resizable="false"
	dynamic="true" closable="true" styleClass="invoiceRefDialog">
	<h:form id="idAddInvoiceRefForm">
		<div style="height:550px;">
		<ui:include src="../../sales/inv/add_ref_invoice.xhtml" />
		</div>
	</h:form>
</p:dialog>
</ui:define>
</ui:composition>