	paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
	rowKey="#{vo.custId}" selectionMode="single" filterEvent="enter">
	<p:ajax event="rowSelect" listener="#{salesBean.handlePassangerSelect}" update=":idAddInvoicePaxForm:idPassangerNm" oncomplete="varPassangerListTable.clearFilters();varPassangerListDialog.hide();"/>
	
	<p:column headerText="Customer Id" sortBy="#{vo.codeLong}" filterBy="#{vo.codeLong}">
		<h:outputText value="#{vo.codeLong}"/>
	</p:column>
	<p:column headerText="Name" sortBy="#{vo.lastName} #{vo.firstName}" filterBy="#{vo.lastName} #{vo.firstName}" filterMatchMode="contains">
		<h:outputText value="#{vo.contPersonName}"/>
	</p:column>
	<p:column headerText="Company Name" sortBy="#{vo.companyName}" filterBy="#{vo.companyName}" filterMatchMode="contains">
		<h:outputText value="#{vo.companyName}"/>
	</p:column>
</p:dataTable-->

<p:dataTable widgetVar="varPassangerListTable" value="#{salesBean.lazyPassangerDataModel}" var="vo" paginator="true" rows="10" 
	paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
	rowKey="#{vo.id}" selectionMode="single" filterEvent="enter" lazy="true" rowStyleClass="#{(vo.classes.contains('BLACKLISTED') and !salesBean.enableBlackListed) ? 'disabled' : ''}">
	<p:ajax event="rowSelect" listener="#{salesBean.handlePassangerSelect}" update=":idAddInvoicePaxForm:idInvPaxPanel" oncomplete="varPassangerListTable.clearFilters();varPassangerListDialog.hide();"/>
	
	<p:column headerText="Customer No" sortBy="#{vo.code}" filterBy="#{vo.code}">
		<h:outputText value="#{vo.code}" />
	</p:column>
	
	<p:column headerText="Customer Name" sortBy="#{vo.custName}" filterBy="#{vo.custName}" filterMatchMode="contains">
		<h:outputText value="#{bterp:lookupItemDesc('salutatn', vo.salutationCd)} #{vo.custName}" style="#{vo.classes.contains('BLACKLISTED') ? 'color:red;font-weight:bold;': ''}"/>
		<p:outputLabel id="idRemarks" rendered="#{not empty vo.classes or not empty vo.remarks}">
			<i class="fa fa-info-circle" />
		</p:outputLabel>
		<pe:tooltip for="idRemarks">
		    <h:panelGrid>
		        <h:outputText value="Class: #{vo.classes}" />
		        <h:outputText value="Note: #{vo.remarks}" escape="false" style="white-space: pre-wrap;"/>
		    </h:panelGrid>
		</pe:tooltip>
	</p:column>
	
	<p:column headerText="NickName" sortBy="#{vo.nickName}" filterBy="#{vo.nickName}" filterMatchMode="contains">
		<h:outputText value="#{vo.nickName}" />
	</p:column>
	
	<!-- <p:column headerText="Company Name" sortBy="#{vo.corporateName}" filterBy="#{vo.corporateName}" filterMatchMode="contains">
		<h:outputText value="#{vo.corporateName}" />
	</p:column> -->
	
	<p:column headerText="Contact" sortBy="#{vo.fullPhoneNo}" filterBy="#{vo.fullPhoneNo}">
        <ui:repeat value="#{vo.fullPhoneNo.split(',')}" var="cntc" varStatus="status" rendered="#{not empty vo.fullPhoneNo}">
            <h:outputText value="#{custBean.getContactStr(cntc)}"/><br/>
        </ui:repeat>
	</p:column>
	
	<p:column headerText="Email" sortBy="#{vo.email}" filterBy="#{vo.email}">
		<h:outputText value="#{vo.email}"/>
	</p:column>
	
	<p:column headerText="Identity" sortBy="#{vo.identities}" filterBy="#{vo.identities}" filterMatchMode="contains">
        <ui:repeat value="#{vo.identities.split(',')}" var="identity" rendered="#{not empty vo.identities}">
            <h:outputText value="#{custBean.getIdentityStr(identity)}"/><br/>
        </ui:repeat>
	</p:column>
</p:dataTable>

<h:panelGrid columns="2" style="width:1px">
	<p:commandButton value="#{msg['common.button.label.cancel']}" oncomplete="varPassangerListDialog.hide();"/><!-- varPassangerListTable.clearFilters() -->
	<p:selectBooleanCheckbox itemLabel="Enable Blacklisted Customer" value="#{salesBean.enableBlackListed}" style="width:400px; margin-left:10px; margin-top:5px; display: flex; align-items: center; font-weight: bold;">
   		<p:ajax event="change" update="idPassangerListForm"/>	
	</p:selectBooleanCheckbox>
</h:panelGrid>
</ui:composition>