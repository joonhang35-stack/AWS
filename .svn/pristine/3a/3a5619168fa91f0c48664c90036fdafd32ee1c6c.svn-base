<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.maintenance.vo">
	<class table="company_name" name="CompanyNameVO" polymorphism="explicit">
		<id name="id" type="long" column="id">
            <generator class="identity"/>
        </id>
        <property name="idCompany" type="long" column="id_company"/>
		<property name="name" type="string" column="name"/>
		<property name="shortName" type="string" column="short_name"/>
        <property name="validFrom" type="date" column="valid_from"/>
		<property name="validTo" type="date" column="valid_to"/>
		<property name="letterHeadUrl" type="string" column="letter_head_url"/>
		
		<!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_update"/>
		<property name="updatedBy" type="string" column="updated_by"/>
		
	</class>
</hibernate-mapping>