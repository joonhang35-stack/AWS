	public List<ExOrderVO> getBillEOList(Long idCompany, String statusCode) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("select eo.id,c.name,eo.code,eo.dt_eo,d.code as tourCode,eo.amt_due,r.ref_value,eo.upd_by,eo.dt_due,p.last_name,p.first_name from ex_order eo ").
			append("left join supplier s on eo.id_supplier =  s.id ").
			append("left join corporate c on c.id_person = s.id_person ").
			append("left join tour_dep d on d.id = eo.id_tour ").
			append("left join com_ref_data r on r.cat_cd = 'EO_STATUS' and r.ref_cd = eo.status_cd ").
			append("left join person p on p.id = s.id_person ").
			append("where eo.id_company = :idCompany and eo.status_cd = :statusCode ").
			append("order by cast(eo.code as decimal) desc");
		
		Query query = createSQLQuery(sb.toString());
