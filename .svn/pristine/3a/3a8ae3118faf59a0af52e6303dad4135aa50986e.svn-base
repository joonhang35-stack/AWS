	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.purchase.dao.PurchaseEODAO#getExOrderList()
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<ExOrderVO> getExOrderList(Long companyId) {
		Criteria criteria = getSession().createCriteria(ExOrderVO.class);
		criteria.add(Restrictions.eq("companyId", companyId));
		criteria.addOrder(Order.desc("id"));
		return criteria.list();
	}
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.purchase.dao.PurchaseEODAO#getExOrderList()
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<ExOrderVO> getEOExOrderList(Long companyId) {
		String tempStr= "select eo.id,c.name,eo.code,eo.DT_EO,d.code as tourCode,eo.amt_due,eo.status_cd,eo.upd_by from EX_ORDER eo " +
		 		"left join supplier s on eo.id_supplier =  s.id left join corporate c on c.id_person = s.id_person left join tour_dep d on d.id = eo.id_tour " +
		 		"where eo.id_company = :idCompany order by cast(eo.code as decimal) desc";
		Query query = createSQLQuery(tempStr);
		query.setParameter("idCompany", companyId);
		List<Object> results = query.list(); 
		List<ExOrderVO> eoList = new ArrayList<ExOrderVO>();
		ExOrderVO vo;
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new ExOrderVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setSupplierName((String) row[1]);   
			vo.setCode((String) row[2]);   
			vo.setStrEODt(((Date) row[3]).toString().substring(0,10))	;  
			vo.setEoDt((Date) row[3])	;  
			vo.setTourCode((String) row[4]);   
			vo.setAmtDue(Double.parseDouble(row[5].toString()) );
			//vo.setStatusCode(row[6].toString());
			vo.setStatus(row[6].toString());
			vo.setUpdatedBy((String) row[7]); 
 
			eoList.add(vo);
		} 
		return eoList; 
	}
	
