	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.purchase.dao.PurchaseEODAO#terminateEOSubInfo(java.lang.String, java.lang.Long)
	 */
	@Override
	public void terminateEOSubInfo(String table, Long idEO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("UPDATE ").append(table).append(" SET status_cd = :statusCode WHERE id_eo = :idEO");
		
		Query query = createSQLQuery(sb.toString());
		query.setString("statusCode", BaseConstant.STATUS_DELETED);
		query.setLong("idEO", idEO);
		query.executeUpdate();
	}
	
	@Override
	public void updateExOrderCode(String uuid, String code) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("UPDATE ExOrderVO SET code = :code WHERE code = :uuid");
		
		Query query = createQuery(sb.toString());
		query.setString("code", code);
		query.setString("uuid", uuid);
		query.executeUpdate();
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<ExOrderVO> getExOrderHistoryList(Long id) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("select comments, internal_comments, dt_upd, upd_by from ex_order_log ").
			append("where id = :id ").
			append("order by dt_upd desc");
		
		Query query = createSQLQuery(sb.toString());
		query.setParameter("id", id);
		List<Object> results = query.list();
		List<ExOrderVO> eoList = new ArrayList<ExOrderVO>();
		ExOrderVO vo;
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new ExOrderVO();
			vo.setEoComments((String) row[0]);
			vo.setEoInternalComments((String) row[1]);
			vo.setUpdatedDate((Date) row[2]);
			vo.setUpdatedBy((String) row[3]);
			eoList.add(vo);
		}
		return eoList;
	}
	
