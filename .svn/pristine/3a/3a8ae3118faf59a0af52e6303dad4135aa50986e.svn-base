	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.purchase.dao.PurchaseEODAO#getEOListSize(java.util.Map)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public int getEOListSize(Map<String, Object> params) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("select count(distinct eo.id) from ex_order eo ").
			append("join (select id, id_person from supplier where id_company = :idCompany) s on eo.id_supplier = s.id ").
			append("left join corporate c on c.id_person = s.id_person ").
			append("left join tour_dep d on d.id = eo.id_tour ").
			append("left join (select ref_cd, ref_value from com_ref_data where cat_cd = 'EO_STATUS') r on r.ref_cd = eo.status_cd ").
			append("left join person p on p.id = s.id_person ").
			append("left join employee e on e.id = eo.id_orderer ").
			append("left join sec_user su on su.`UUID` = e.u_sec_user ").
			append("left join (select id_eo, sum(fore_cur_amt) as total_fore_cur_amt, max(id_currency) as id_total_currency from ex_order_item where status_cd != :deleted group by id_eo) eoi on eoi.id_eo = eo.id ").
			append("left join currency_ex ce on ce.id = eoi.id_total_currency ").
			append("LEFT JOIN (SELECT id_eo, GROUP_CONCAT(scanned_path SEPARATOR '<br>') AS scanned_paths FROM ex_order_attachment GROUP BY id_eo) eoa_agg ON eoa_agg.id_eo = eo.id ").
			append("where eo.id_company = :idCompany ");
		String status = params.get("status") == null ? null : (String) params.get("status");
		if (status != null) sb.append("and eo.status_cd = '").append(status).append("' ");
		if (params.get("fromDate") != null && params.get("toDate") != null) sb.append("and date(eo.dt_eo) BETWEEN date(:fromDate) and date(:toDate) ");
		
		if (params.get("fromDate") != null) sb.append("and date(eo.dt_eo) >= date(:fromDate) ");
		
		if (params.get("toDate") != null) sb.append("and date(eo.dt_eo) <= date(:toDate) ");
		
		if (params.get("eoFrom") != null && params.get("eoTo") != null) sb.append("and CAST(eo.code as signed) BETWEEN CAST(:eoFrom as signed) and CAST(:eoTo as signed) ");
		
		if (params.get("eoFrom") != null) sb.append("and CAST(eo.code as signed) >= CAST(:eoFrom as signed) ");
		
		if (params.get("eoTo") != null) sb.append("and CAST(eo.code as signed) <= CAST(:eoTo as signed) ");
		if (params.get("invDateFrom") != null && params.get("invDateTo") != null) sb.append(" AND date(eo.dt_eo) BETWEEN date(:invDateFrom) AND date(:invDateTo) ");
		if (params.get("invDateFrom") != null) sb.append(" AND date(eo.dt_eo) >= date(:invDateFrom) ");
		if (params.get("invDateTo") != null) sb.append(" AND date(eo.dt_eo) <= date(:invDateTo) ");
		if (params.get("depDateFrom") != null && params.get("depDateTo") != null) sb.append(" AND date(eo.dt_tour_dep) BETWEEN date(:depDateFrom) AND date(:depDateTo) ");
		if (params.get("depDateFrom") != null) sb.append(" AND date(eo.dt_tour_dep) >= date(:depDateFrom) ");
		if (params.get("depDateTo") != null) sb.append(" AND date(eo.dt_tour_dep) <= date(:depDateTo) ");
		if (params.get("notViewableCatCode") != null) {
			List<String> notViewableCatCodeList = (List<String>) params.get("notViewableCatCode");
			sb.append("and cat_cd not in (");
			for (int i = 0; i < notViewableCatCodeList.size(); i++) {
				if (i > 0) 
					sb.append(", ");
				
				sb.append("'" + notViewableCatCodeList.get(i) + "'");
			}
			sb.append(") ");
		}
		
		Map<String, String> filters = (Map<String, String>) params.get("filters");
		if (!filters.isEmpty()) {
			sb.append("and (");
			for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) {
				Entry<String, String> entry = it.next();
				if ("supplierName".equals(entry.getKey())) sb.append("c.name like '%").append(entry.getValue()).append("%'");
				else if ("code".equals(entry.getKey())) sb.append("eo.code like '%").append(entry.getValue()).append("%'");
				else if ("eoDt".equals(entry.getKey())) sb.append("date_format(eo.dt_eo, '%d-%b-%Y') like '%").append(entry.getValue()).append("%'");
				else if ("tourCode".equals(entry.getKey())) sb.append("d.code like '%").append(entry.getValue()).append("%'");
				else if ("amtDue".equals(entry.getKey())) sb.append("eo.amt_due like '%").append(entry.getValue()).append("%'");
				else if ("status".equals(entry.getKey())) sb.append("lower(r.ref_value) like lower('%").append(entry.getValue()).append("%')");
				else if ("updatedBy".equals(entry.getKey())) sb.append("eo.upd_by like '%").append(entry.getValue()).append("%'");
				else if ("dueDt".equals(entry.getKey())) sb.append("date_format(eo.dt_due, '%d-%b-%Y') like '%").append(entry.getValue()).append("%'");
				else if ("contactPerson".equals(entry.getKey())) sb.append("concat(p.last_name, ' ', p.first_name) like '%").append(entry.getValue()).append("%'");
				else if ("orderBy".equals(entry.getKey())) sb.append("su.user_name like '%").append(entry.getValue()).append("%'");
				else if ("totalForeCurAmt".equals(entry.getKey())) sb.append("concat(ce.code, ' ', eoi.total_fore_cur_amt) like '%").append(entry.getValue()).append("%'");
				else if ("eoComments".equals(entry.getKey())) sb.append("eo.comments like '%").append(entry.getValue()).append("%'");
				else if ("eoInternalComments".equals(entry.getKey())) sb.append("eo.internal_comments like '%").append(entry.getValue()).append("%'");
				else if ("updatedDate".equals(entry.getKey())) sb.append("date_format(eo.dt_upd, '%d-%b-%Y') like '%").append(entry.getValue()).append("%'");
				else if ("docListFull".equals(entry.getKey())) {
					sb.append("(SELECT GROUP_CONCAT(CASE WHEN inv.doc_type_cd = 'I' THEN CONCAT('AV ', inv.code) WHEN inv.doc_type_cd = 'P' THEN CONCAT('PS ', inv.ps_no) ")
						.append("ELSE inv.code END SEPARATOR '<br>') FROM ex_order_inv eoin3 JOIN invoice inv ON inv.id = eoin3.id_inv WHERE eoin3.id_eo = eo.id ORDER BY inv.id) like '%")
						.append(entry.getValue()).append("%'");
				}
				else if ("scannedPath".equals(entry.getKey())) sb.append("COALESCE(eoa_agg.scanned_paths, '') like '%").append(entry.getValue()).append("%'");
				if (filters.size() > 1 && it.hasNext()) sb.append(" and ");
			}
			sb.append(")");
		}
		Query query = createSQLQuery(sb.toString());
		query.setParameter("idCompany", params.get("companyId"));
		query.setParameter("deleted", BaseConstant.STATUS_DELETED);
		if (params.get("fromDate") != null && params.get("toDate") != null) {
			query.setParameter("fromDate", params.get("fromDate"));
			query.setParameter("toDate", params.get("toDate"));
		}
		if (params.get("fromDate") != null) query.setParameter("fromDate", params.get("fromDate"));
		if (params.get("toDate") != null) query.setParameter("toDate", params.get("toDate"));
		if (params.get("eoFrom") != null && params.get("eoTo") != null) {
			query.setParameter("eoFrom", params.get("eoFrom"));
			query.setParameter("eoTo", params.get("eoTo"));
		}
		if (params.get("eoFrom") != null) query.setParameter("eoFrom", params.get("eoFrom"));
		if (params.get("eoTo") != null) query.setParameter("eoTo", params.get("eoTo"));
		if (params.get("invDateFrom") != null) query.setParameter("invDateFrom", params.get("invDateFrom"));
		if (params.get("invDateTo") != null) query.setParameter("invDateTo", params.get("invDateTo"));
		if (params.get("depDateFrom") != null) query.setParameter("depDateFrom", params.get("depDateFrom"));
		if (params.get("depDateTo") != null) query.setParameter("depDateTo", params.get("depDateTo"));
		return ((BigInteger) query.uniqueResult()).intValue();
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.purchase.dao.PurchaseEODAO#getEOList(java.util.Map)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<ExOrderVO> getEOList(Map<String, Object> params) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("select distinct eo.id,c.name,eo.code,eo.dt_eo,d.code as tourCode,eo.amt_due,r.ref_value,eo.upd_by,eo.dt_due,p.last_name,p.first_name, su.user_name as order_by ").
			append(", format(eoi.total_fore_cur_amt, 2) as total_fore_cur_amt, ce.code as currency_code, eo.comments, eo.internal_comments, eo.dt_upd, ").
			append("(SELECT CONCAT(").
			append("CASE WHEN inv.doc_type_cd = 'I' THEN CONCAT('AV ', inv.code) ").
			append("WHEN inv.doc_type_cd = 'P' THEN CONCAT('PS ', inv.ps_no) ").
			append("ELSE inv.code END, ").
			append("CASE WHEN (SELECT COUNT(*) FROM ex_order_inv e2 WHERE e2.id_eo = eo.id) > 1 THEN '......' ELSE '' END) ").
			append("FROM ex_order_inv eoin2 ").
			append("JOIN invoice inv ON inv.id = eoin2.id_inv ").
			append("WHERE eoin2.id_eo = eo.id ").
			append("ORDER BY inv.id LIMIT 1) AS docList, "). 
			append("(SELECT GROUP_CONCAT(").
			append("CASE WHEN inv.doc_type_cd = 'I' THEN CONCAT('AV ', inv.code) ").
			append("WHEN inv.doc_type_cd = 'P' THEN CONCAT('PS ', inv.ps_no) ").
			append("ELSE inv.code END SEPARATOR '<br>') ").
			append("FROM ex_order_inv eoin3 ").
			append("JOIN invoice inv ON inv.id = eoin3.id_inv ").
		  	append("WHERE eoin3.id_eo = eo.id ").
		  	append("ORDER BY inv.id) AS docListFull ").
		  	append(", COALESCE(eoa_agg.scanned_paths, '') AS scannedPath ").
			append("from ex_order eo ").
			append("join (select id, id_person from supplier where id_company = :idCompany) s on eo.id_supplier = s.id ").
			append("left join corporate c on c.id_person = s.id_person ").
			append("left join tour_dep d on d.id = eo.id_tour ").
			append("left join (select ref_cd, ref_value from com_ref_data where cat_cd = 'EO_STATUS') r on r.ref_cd = eo.status_cd ").
			append("left join person p on p.id = s.id_person ").
			append("left join employee e on e.id = eo.id_orderer ").
			append("left join sec_user su on su.`UUID` = e.u_sec_user ").
			append("left join (select id_eo, sum(fore_cur_amt) as total_fore_cur_amt, max(id_currency) as id_total_currency from ex_order_item where status_cd != :deleted group by id_eo) eoi on eoi.id_eo = eo.id ").
			append("left join currency_ex ce on ce.id = eoi.id_total_currency ").
			append("LEFT JOIN (SELECT id_eo, GROUP_CONCAT(scanned_path SEPARATOR '<br>') AS scanned_paths FROM ex_order_attachment GROUP BY id_eo) eoa_agg ON eoa_agg.id_eo = eo.id ").
			append("where eo.id_company = :idCompany ");
		String status = params.get("status") == null ? null : (String) params.get("status");
		if (status != null) sb.append("and eo.status_cd = '").append(status).append("' ");
		
		if (params.get("fromDate") != null && params.get("toDate") != null) sb.append("and date(eo.dt_eo) BETWEEN date(:fromDate) and date(:toDate) ");
		
		if (params.get("fromDate") != null) sb.append("and date(eo.dt_eo) >= date(:fromDate) ");
		
		if (params.get("toDate") != null) sb.append("and date(eo.dt_eo) <= date(:toDate) ");
		
		if (params.get("eoFrom") != null && params.get("eoTo") != null) sb.append("and CAST(eo.code as signed) BETWEEN CAST(:eoFrom as signed) and CAST(:eoTo as signed) ");
		
		if (params.get("eoFrom") != null) sb.append("and CAST(eo.code as signed) >= CAST(:eoFrom as signed) ");
		
		if (params.get("eoTo") != null) sb.append("and CAST(eo.code as signed) <= CAST(:eoTo as signed) ");
		if (params.get("invDateFrom") != null && params.get("invDateTo") != null) sb.append(" AND date(eo.dt_eo) BETWEEN date(:invDateFrom) AND date(:invDateTo) ");
		if (params.get("invDateFrom") != null) sb.append(" AND date(eo.dt_eo) >= date(:invDateFrom) ");
		if (params.get("invDateTo") != null) sb.append(" AND date(eo.dt_eo) <= date(:invDateTo) ");
		if (params.get("depDateFrom") != null && params.get("depDateTo") != null) sb.append(" AND date(eo.dt_tour_dep) BETWEEN date(:depDateFrom) AND date(:depDateTo) ");
		if (params.get("depDateFrom") != null) sb.append(" AND date(eo.dt_tour_dep) >= date(:depDateFrom) ");
		if (params.get("depDateTo") != null) sb.append(" AND date(eo.dt_tour_dep) <= date(:depDateTo) ");
		if (params.get("notViewableCatCode") != null) {
			List<String> notViewableCatCodeList = (List<String>) params.get("notViewableCatCode");
			sb.append("and cat_cd not in (");
			for (int i = 0; i < notViewableCatCodeList.size(); i++) {
				if (i > 0) 
					sb.append(", ");
				
				sb.append("'" + notViewableCatCodeList.get(i) + "'");
			}
			sb.append(") ");
		}
		
		
		Map<String, String> filters = (Map<String, String>) params.get("filters");
		if (!filters.isEmpty()) {
			sb.append("and (");
			for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) {
				Entry<String, String> entry = it.next();
				if ("supplierName".equals(entry.getKey())) sb.append("c.name like '%").append(entry.getValue()).append("%'");
				else if ("code".equals(entry.getKey())) sb.append("eo.code like '%").append(entry.getValue()).append("%'");
				else if ("eoDt".equals(entry.getKey())) sb.append("date_format(eo.dt_eo, '%d-%b-%Y') like '%").append(entry.getValue()).append("%'");
				else if ("tourCode".equals(entry.getKey())) sb.append("d.code like '%").append(entry.getValue()).append("%'");
				else if ("amtDue".equals(entry.getKey())) sb.append("eo.amt_due like '%").append(entry.getValue()).append("%'");
				else if ("status".equals(entry.getKey())) sb.append("lower(r.ref_value) like lower('%").append(entry.getValue()).append("%')");
				else if ("updatedBy".equals(entry.getKey())) sb.append("eo.upd_by like '%").append(entry.getValue()).append("%'");
				else if ("dueDt".equals(entry.getKey())) sb.append("date_format(eo.dt_due, '%d-%b-%Y') like '%").append(entry.getValue()).append("%'");
				else if ("contactPerson".equals(entry.getKey())) sb.append("concat(p.last_name, ' ', p.first_name) like '%").append(entry.getValue()).append("%'");
				else if ("orderBy".equals(entry.getKey())) sb.append("su.user_name like '%").append(entry.getValue()).append("%'");
				else if ("totalForeCurAmt".equals(entry.getKey())) sb.append("concat(ce.code, ' ', eoi.total_fore_cur_amt) like '%").append(entry.getValue()).append("%'");
				else if ("eoComments".equals(entry.getKey())) sb.append("eo.comments like '%").append(entry.getValue()).append("%'");
				else if ("eoInternalComments".equals(entry.getKey())) sb.append("eo.internal_comments like '%").append(entry.getValue()).append("%'");
				else if ("updatedDate".equals(entry.getKey())) sb.append("date_format(eo.dt_upd, '%d-%b-%Y') like '%").append(entry.getValue()).append("%'");
				else if ("docListFull".equals(entry.getKey())) sb.append("(SELECT GROUP_CONCAT(CASE WHEN inv.doc_type_cd = 'I' THEN CONCAT('AV ', inv.code) WHEN inv.doc_type_cd = 'P' THEN CONCAT('PS ', inv.ps_no) ")
			    .append("ELSE inv.code END SEPARATOR '<br>') FROM ex_order_inv eoin3 JOIN invoice inv ON inv.id = eoin3.id_inv WHERE eoin3.id_eo = eo.id ORDER BY inv.id) like '%").append(entry.getValue()).append("%'");
				else if ("scannedPath".equals(entry.getKey())) sb.append("COALESCE(eoa_agg.scanned_paths, '') like '%").append(entry.getValue()).append("%'");
				if (filters.size() > 1 && it.hasNext()) sb.append(" and ");
			}
			sb.append(")");
		}
		sb.append("order by ");
		String sortField = (String) params.get("sortField");
		if (sortField == null) sb.append("cast(eo.code as decimal) desc");
		else {
			if ("supplierName".equals(sortField)) sb.append("c.name");
			else if ("code".equals(sortField)) sb.append("cast(eo.code as decimal)");
			else if ("eoDt".equals(sortField)) sb.append("eo.dt_eo");
			else if ("tourCode".equals(sortField)) sb.append("tourCode");
			else if ("amtDue".equals(sortField)) sb.append("eo.amt_due");
			else if ("status".equals(sortField)) sb.append("r.ref_value");
			else if ("updatedBy".equals(sortField)) sb.append("eo.upd_by");
			else if ("dueDt".equals(sortField)) sb.append("eo.dt_due");
			else if ("orderBy".equals(sortField)) sb.append("su.user_name");
			else if ("totalForeCurAmt".equals(sortField)) sb.append("concat(ce.code, ' ', eoi.total_fore_cur_amt)");
			else if ("eoComments".equals(sortField)) sb.append("eo.comments");
			else if ("eoInternalComments".equals(sortField)) sb.append("eo.internal_comments");
			else if ("docList".equals(sortField)) sb.append("docList");
			else if ("updatedDate".equals(sortField)) sb.append("eo.dt_upd");
			else if ("scannedPath".equals(sortField)) sb.append("COALESCE(eoa_agg.scanned_paths, '')");
			if (CommonConstant.SORT_ASC.equals(((SortOrder) params.get("sortOrder")).toString())) sb.append(" asc");
			else sb.append(" desc");
		}
		Query query = createSQLQuery(sb.toString());
		query.setParameter("idCompany", params.get("companyId"));
		query.setParameter("deleted", BaseConstant.STATUS_DELETED);
		if (params.get("fromDate") != null && params.get("toDate") != null) {
			query.setParameter("fromDate", params.get("fromDate"));
			query.setParameter("toDate", params.get("toDate"));
		}
		if (params.get("fromDate") != null) query.setParameter("fromDate", params.get("fromDate"));
		if (params.get("toDate") != null) query.setParameter("toDate", params.get("toDate"));
		if (params.get("eoFrom") != null && params.get("eoTo") != null) {
			query.setParameter("eoFrom", params.get("eoFrom"));
			query.setParameter("eoTo", params.get("eoTo"));
		}
		if (params.get("eoFrom") != null) query.setParameter("eoFrom", params.get("eoFrom"));
		if (params.get("eoTo") != null) query.setParameter("eoTo", params.get("eoTo"));
		if (params.get("invDateFrom") != null) query.setParameter("invDateFrom", params.get("invDateFrom"));
		if (params.get("invDateTo") != null) query.setParameter("invDateTo", params.get("invDateTo"));
		if (params.get("depDateFrom") != null) query.setParameter("depDateFrom", params.get("depDateFrom"));
		if (params.get("depDateTo") != null) query.setParameter("depDateTo", params.get("depDateTo"));
		query.setFirstResult((Integer) params.get("first"));
		query.setMaxResults((Integer) params.get("pageSize"));
		List<Object> results = query.list();
		List<ExOrderVO> eoList = new ArrayList<ExOrderVO>();
		ExOrderVO vo;
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			vo = new ExOrderVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setSupplierName((String) row[1]);
			vo.setCode((String) row[2]);
			vo.setEoDt((Date) row[3]);
			vo.setTourCode((String) row[4]);
			vo.setAmtDue(Double.parseDouble(row[5].toString()) );
			vo.setStatus(row[6].toString());
			vo.setUpdatedBy((String) row[7]);
			vo.setDueDt(row[8] == null ? null : (Date) row[8]);
			vo.setContactPerson(row[9] + " " + row[10]);
			vo.setOrderBy((String) row[11]);
			vo.setTotalForeCurAmt((row[13] == null && row[12] == null) ? "0.00" : row[13] + " " + row[12]);
			vo.setEoComments((row[14] != null) ? row[14].toString() : null);
			vo.setEoInternalComments((row[15] != null) ? row[15].toString() : null);
			vo.setUpdatedDate((Date) row[16]);
			vo.setDocList(row[17] != null ? ((String) row[17]) : null);
			vo.setDocListFull(row[18] != null ? ((String) row[18]) : null);
			vo.setScannedPath((String) row[19]);
			eoList.add(vo);
		}
		return eoList;
	}
	
	
	@SuppressWarnings("unchecked")
