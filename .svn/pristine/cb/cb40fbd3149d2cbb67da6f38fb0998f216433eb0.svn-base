<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">
<p:growl id="msg"/>

<script type="text/javascript">
	function onValidation(xhr, status, args) {
		if (args.isSuccess) {
			varBookingDetailsDialog.hide();
		}
	}
</script>

<p:panel style="border:0; width:800px;">
	<f:facet name="header">
		<h:outputText value="Booking ID : "/><h:outputFormat value="#{tourPkgBean.bookingVO.id}"/>
	</f:facet>
	<div style="height:500px; overflow:auto;">
	<p:panelGrid>
		<p:row>
			<p:column colspan="2"><h:outputText value="#{tourPkgBean.tourPkgVO.numDays}D/#{tourPkgBean.tourPkgVO.numNights}N #{tourPkgBean.tourPkgVO.nameEn} #{tourPkgBean.tourPkgVO.nameZh} #{tourPkgBean.tourPkgVO.nameOther}"/> <h:outputText value=" [#{tourPkgBean.tourDepVO.desc}]" style="color:#FF0000;" rendered="#{not empty tourPkgBean.tourDepVO.desc}"/></p:column>
		</p:row>
		<p:row>
			<p:column style="width:120px;"><h:outputText value="Departure Date"/></p:column>
			<p:column><h:outputText value="#{tourPkgBean.tourDepVO.dtDep}"><f:convertDateTime pattern="#{config['date.display.pattern2']}"/></h:outputText></p:column>
		</p:row>
		<p:row>
			<p:column><h:outputText value="Invoice No."/></p:column>
			<p:column><h:outputText value="#{bterp:sysNumGenVO(tourPkgBean.bookingVO.idCompany, 'invc').prefixid}#{tourPkgBean.bookingVO.invCode}" rendered="#{not empty tourPkgBean.bookingVO.invCode}"/></p:column>
		</p:row>
		<p:row>
			<p:column><h:outputText value="Bill To"/></p:column>
			<p:column><h:outputText value="#{bterp:lookupItemDesc('salutatn', tourPkgBean.bookingVO.customerVO.salutationCd)} #{tourPkgBean.bookingVO.custName}" style="text-transform:uppercase;"/></p:column>
		</p:row>
		<p:row>
			<p:column colspan="2">
				<!-- <p:dataTable value="#{tourPkgBean.bookingVO.customerVO.identityList}" var="vo">
					<f:facet name="header">ID</f:facet>
					<p:column headerText="ID Type" style="width:50%;"><h:outputText value="#{bterp:lookupItemDesc('id_type', vo.idType)}"/></p:column>
					<p:column headerText="Number"><h:outputText value="#{vo.idNo}"/></p:column>
				</p:dataTable> -->
				<p:dataTable value="#{tourPkgBean.bookingVO.customerVO.identities.split(',')}" var="s">
					<p:column headerText="Identities"><h:outputText value="#{tourPkgBean.getIdentityStr(s)}"/></p:column>
				</p:dataTable>
			</p:column>
		</p:row>
		<p:row>
			<p:column colspan="2">
				<!-- <p:dataTable value="#{tourPkgBean.bookingVO.customerVO.personContactList}" var="vo">
					<f:facet name="header">Contact</f:facet>
					<p:column headerText="ID Type" style="width:50%;"><h:outputText value="#{bterp:lookupItemDesc('cntc_type', vo.typeCd)}"/></p:column>
					<p:column headerText="Number"><h:outputText value="#{vo.number}"/></p:column>
				</p:dataTable> -->
				<p:dataTable value="#{tourPkgBean.bookingVO.customerVO.perContacts.split(',')}" var="s">
					<p:column headerText="Contacts"><h:outputText value="#{tourPkgBean.getContactStrWithCountryPair(s, tourPkgBean.bookingVO.customerVO.countryCode)}"/></p:column>
				</p:dataTable>
			</p:column>
		</p:row>
		<p:row>
			<p:column colspan="2">
				<!--p:dataTable value="#{tourPkgBean.bookingVO.bookingChargeItemList}" var="vo">
					<f:facet name="header">Pax</f:facet>
					<p:column headerText="No. of Pax" style="width:50%;"><h:outputText value="#{zsg:referenceDataValue('TOUR_DEP_ITM_CD', vo.code)}" rendered="#{vo.code.startsWith('FT') || vo.code.startsWith('GA')}"/></p:column>
					<p:column headerText="Qty"><h:outputText value="#{vo.quantity}" rendered="#{vo.code.startsWith('FT') || vo.code.startsWith('GA')}"/></p:column>
				</p:dataTable-->
				<h:outputText value="Booking Pax"/>
				<div class="ui-datatable ui-widget">
					<table>
						<thead>
							<tr>
								<th class="ui-state-default" width="30%" style="padding:5px;"><h:outputText value="No. of Pax"/></th>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="Qty"/></th>
							</tr>
						</thead>
						<tbody class="ui-datatable-data ui-widget-content">
							<c:forEach items="#{tourPkgBean.bookingVO.bookingChargeItemList}" var="vo">
								<c:if test="#{(vo.code.startsWith('FT') or vo.code.startsWith('GA')) and vo.quantity gt 0}">
								<tr>
									<td style="padding:5px;"><h:outputText value="#{zsg:referenceDataValue('TOUR_DEP_ITM_CD', vo.code)}"/></td>
									<td style="text-align:center;"><h:outputText value="#{vo.quantity}"/></td>
								</tr>
								</c:if>
							</c:forEach>
						</tbody>
					</table>
				</div>
			</p:column>
		</p:row>
		<p:row>
			<p:column colspan="2">
				<h:outputText value="Full Tour Price"/>
				<div class="ui-datatable ui-widget">
					<table>
						<thead>
							<tr>
								<th colspan="2" class="ui-state-default" style="padding:5px;"><h:outputText value="ADULT (RM)"/></th>
								<th colspan="3" class="ui-state-default" style="padding:5px;"><h:outputText value="CHILD (RM)"/></th>
							</tr>
							<tr>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="TWN"/></th>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="SGL"/></th>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="CTW"/></th>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="CWB"/></th>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="CNB"/></th>
							</tr>
						</thead>
						<tbody class="ui-datatable-data ui-widget-content">
							<tr>
								<td style="text-align:center; padding:5px;"><h:outputText value="#{tourPkgBean.bookingVO.amtFullTwn}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center; padding:5px;"><h:outputText value="#{tourPkgBean.bookingVO.amtFullSgl}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center; padding:5px;"><h:outputText value="#{tourPkgBean.bookingVO.amtFullCtw}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center; padding:5px;"><h:outputText value="#{tourPkgBean.bookingVO.amtFullCeb}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center; padding:5px;"><h:outputText value="#{tourPkgBean.bookingVO.amtFullCnb}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
							</tr>
						</tbody>
					</table>
				</div>
				<br/>
				<h:outputText value="Ground Only Price"/>
				<div class="ui-datatable ui-widget">
					<table>
						<thead>
							<tr>
								<th colspan="2" class="ui-state-default" style="padding:5px;"><h:outputText value="ADULT (RM)"/></th>
								<th colspan="3" class="ui-state-default" style="padding:5px;"><h:outputText value="CHILD (RM)"/></th>
							</tr>
							<tr>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="TWN"/></th>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="SGL"/></th>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="CTW"/></th>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="CWB"/></th>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="CNB"/></th>
							</tr>
						</thead>
						<tbody class="ui-datatable-data ui-widget-content">
							<tr>
								<td style="text-align:center; padding:5px;"><h:outputText value="#{tourPkgBean.bookingVO.amtGrndTwn}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center; padding:5px;"><h:outputText value="#{tourPkgBean.bookingVO.amtGrndSgl}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center; padding:5px;"><h:outputText value="#{tourPkgBean.bookingVO.amtGrndCtw}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center; padding:5px;"><h:outputText value="#{tourPkgBean.bookingVO.amtGrndCeb}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center; padding:5px;"><h:outputText value="#{tourPkgBean.bookingVO.amtGrndCnb}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
							</tr>
						</tbody>
					</table>
				</div>
			</p:column>
		</p:row>
		<p:row>
			<p:column><h:outputText value="Payment Status"/></p:column>
			<p:column><h:outputText value="#{zsg:referenceDataValue('BOOK_PMNT_STATUS', tourPkgBean.bookingVO.pmntStatusCd)}"/></p:column>
		</p:row>
		<p:row>
			<p:column><h:outputText value="Booking Expiry"/></p:column>
			<p:column><h:outputText value="#{tourPkgBean.bookingVO.dtExp}"><f:convertDateTime pattern="#{config['date.display.pattern2']}"/></h:outputText></p:column>
		</p:row>
		<p:row>
			<p:column style="width:150px;"><h:outputText value="Date Booking Made"/></p:column>
			<p:column><h:outputText value="#{tourPkgBean.bookingVO.createdDate}"><f:convertDateTime pattern="#{config['date.display.pattern2']}"/></h:outputText></p:column>
		</p:row>
		<p:row>
			<p:column style="width:150px;"><h:outputText value="Discount"/></p:column>
			<p:column>
				<div class="ui-datatable ui-widget" style="width: 280px;">
					<table>
						<thead>
							<tr>
								<th colspan="2" class="ui-state-default" style="padding:5px;"><h:outputText value="Level 1"/></th>
								<th colspan="2" class="ui-state-default" style="padding:5px;"><h:outputText value="Level 2"/></th>
								<th rowspan="2" class="ui-state-default" style="padding:5px;"><h:outputText value="Not Entitled"/></th>
							</tr>
							<tr>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="Amount"/></th>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="Seat"/></th>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="Amount"/></th>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="Seat"/></th>
							</tr>
						</thead>
						<tbody class="ui-datatable-data ui-widget-content">
							<tr>
								<td style="text-align:center; padding:5px;"><p:inputText label="Discount1" value="#{tourPkgBean.bookingVO.discount1}" size="8" maxlength="8" required="true" readonly="#{tourPkgBean.bookingVO.invCode != null}" style="background:#{tourPkgBean.bookingVO.invCode != null ? '#ccc' : ''}" ><f:convertNumber pattern="#,##0.00"/></p:inputText></td>
								<td style="text-align:center; padding:5px;"><p:inputText label="DiscountPax1" value="#{tourPkgBean.bookingVO.discountPax1}" size="3" maxlength="3" required="true" readonly="#{tourPkgBean.bookingVO.invCode != null}" style="background:#{tourPkgBean.bookingVO.invCode != null ? '#ccc' : ''}" /></td>
								<td style="text-align:center; padding:5px;"><p:inputText label="Discount2" value="#{tourPkgBean.bookingVO.discount2}" size="8" maxlength="8" required="true" readonly="#{tourPkgBean.bookingVO.invCode != null}" style="background:#{tourPkgBean.bookingVO.invCode != null ? '#ccc' : ''}" ><f:convertNumber pattern="#,##0.00"/></p:inputText></td>
								<td style="text-align:center; padding:5px;"><p:inputText label="DiscountPax2" value="#{tourPkgBean.bookingVO.discountPax2}" size="3" maxlength="3" required="true" readonly="#{tourPkgBean.bookingVO.invCode != null}" style="background:#{tourPkgBean.bookingVO.invCode != null ? '#ccc' : ''}" /></td>
								<td style="text-align:center; padding:5px;"><p:inputText label="Not Entitled Pax" value="#{tourPkgBean.bookingVO.notEntitledDiscountPax}" size="3" maxlength="3" required="true" readonly="#{tourPkgBean.bookingVO.invCode != null}" style="background:#{tourPkgBean.bookingVO.invCode != null ? '#ccc' : ''}"/></td>
							</tr>
						</tbody>
					</table>
				</div>
			</p:column>
		</p:row>
		<p:row>
			<p:column style="width:150px;"><h:outputText value="MISC"/></p:column>
			<p:column>
				(<h:outputText value="Visa : "/><h:outputText value="#{tourPkgBean.bookingVO.airlineVisa}"><f:convertNumber pattern="#,##0.00"/></h:outputText>
				<h:outputText value=", A/C : "/><h:outputText value="#{tourPkgBean.bookingVO.airlineAC}"><f:convertNumber pattern="#,##0.00"/></h:outputText>
				<h:outputText value=", Tipping : "/><h:outputText value="#{tourPkgBean.bookingVO.airlineTipping}"><f:convertNumber pattern="#,##0.00"/></h:outputText>
				<h:outputText value=", APT Tax (ADT/CHD : "/><h:outputText value="#{tourPkgBean.bookingVO.airlineAptAdt}"><f:convertNumber pattern="#,##0.00"/></h:outputText><h:outputText value="/"/><h:outputText value="#{tourPkgBean.bookingVO.airlineAptChd}"><f:convertNumber pattern="#,##0.00"/></h:outputText>
				<h:outputText value="), YQ &amp; Fuel Tax (ADT/CHD : "/><h:outputText value="#{tourPkgBean.bookingVO.airlineYqAdt}"><f:convertNumber pattern="#,##0.00"/></h:outputText><h:outputText value="/"/><h:outputText value="#{tourPkgBean.bookingVO.airlineYqChd}"><f:convertNumber pattern="#,##0.00"/></h:outputText>
				<h:outputText value="), Travel Insurance : "/><h:outputText value="#{tourPkgBean.bookingVO.airlineTrvlIns}"><f:convertNumber pattern="#,##0.00"/></h:outputText>
				<h:outputText value=", Others : "/><h:outputText value="#{tourPkgBean.bookingVO.airlineExtra}"><f:convertNumber pattern="#,##0.00"/></h:outputText>)
			</p:column>
		</p:row>
	</p:panelGrid>
	</div>
	<h:panelGrid columns="2" style="width: 1px;">
		<p:commandButton value="#{msg['common.button.label.save']}" disabled="#{tourPkgBean.bookingVO.invCode != null}" actionListener="#{tourPkgBean.updTourDepBooking}" update=":idBookingDetailsForm" oncomplete="onValidation(xhr, status, args)"/>
		<p:commandButton value="#{msg['common.button.label.cancel']}" actionListener="#{tourPkgBean.resetBookingForm}" onclick="varBookingDetailsDialog.hide()"/>
	</h:panelGrid>
</p:panel>
</ui:composition>