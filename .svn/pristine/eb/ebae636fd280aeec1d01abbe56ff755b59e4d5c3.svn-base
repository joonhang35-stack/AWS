package com.bcs.zsg.web;

import org.apache.commons.lang.StringUtils;

import com.bcs.zsg.core.helper.PropertiesLookup;

/**
 * 
 */
public final class SystemProperty {
	
	/**
	 * POS Upload
	 */
	public static String POS_UPLOAD_API_SEND_RECEIPTS = PropertiesLookup.getSystemProperty("sys.pos.upload.API.sendReceipts");
	public static String POS_UPLOAD_API_GET_RECEIPTS = PropertiesLookup.getSystemProperty("sys.pos.upload.API.getReceipts");
	public static String POS_UPLOAD_API_CLEAR_TEST_DATA = PropertiesLookup.getSystemProperty("sys.pos.upload.API.clearTestData");
	public static String POS_UPLOAD_API_REQUEST_HEADER_HOST = PropertiesLookup.getSystemProperty("sys.pos.upload.API.request.header.host");
	public static String POS_UPLOAD_API_REQUEST_HEADER_AUTHORIZATION = PropertiesLookup.getSystemProperty("sys.pos.upload.API.request.header.Authorization");
	public static String POS_UPLOAD_API_REQUEST_HEADER_CONTENT_TYPE = PropertiesLookup.getSystemProperty("sys.pos.upload.API.request.header.ContentType");
	
	/*
	 * CRM API
	 */
	public static String CUST_POINT_API_GET_CUSTOMER_LOYALTY_POINT = PropertiesLookup.getSystemProperty("sys.cust.point.API.getCustomerLoyaltyPoint");
	public static String CUST_POINT_API_GET_VOUCHER = PropertiesLookup.getSystemProperty("sys.cust.point.API.getVoucher");
	public static String CUST_POINT_API_REDEEM_VOUCHER = PropertiesLookup.getSystemProperty("sys.cust.point.API.redeemVoucher");
	public static String CUST_POINT_API_CONVERT_VOUCHER = PropertiesLookup.getSystemProperty("sys.cust.point.API.convertVoucher");
	public static String CRM_API_RECORD_SALES = PropertiesLookup.getSystemProperty("sys.crm.API.recordSales");
	
	public static String CUST_POINT_API_REQUEST_HEADER_HOST = PropertiesLookup.getSystemProperty("sys.cust.point.API.request.header.host");
	public static String CUST_POINT_REQUEST_HEADER_AUTHORIZATION = PropertiesLookup.getSystemProperty("sys.cust.point.API.request.header.Authorization");
	public static String CUST_POINT_API_REQUEST_HEADER_CONTENT_TYPE = PropertiesLookup.getSystemProperty("sys.cust.point.API.request.header.ContentType");
	
	/*
	 * Feedback
	 */
	public static String FEEDBACK_GET_ATTACHMENT = PropertiesLookup.getSystemProperty("sys.feedback.API.getFeedbackAttachment");
	
	/* 
	 * Scheduler
	 */
	public static String SCHEDULER_POS_STATE = PropertiesLookup.getSystemProperty("sys.schedule.pos.enable");
	public static String SCHUDULER_EMAILPAYMENT_STATE = PropertiesLookup.getSystemProperty("sys.schedule.emailpayment.expiry.enable");
	public static String SCHEDULER_MANAGER_TIME = PropertiesLookup.getSystemProperty("sys.schedule.ScheduleManager.timeMinute");
	public static String SCHEDULER_MANAGER_DAILY_TIME = PropertiesLookup.getSystemProperty("sys.schedule.ScheduleManager.dailyTime");
	public static String SCHEDULER_MANAGER_MONTHLY_TIME = PropertiesLookup.getSystemProperty("sys.schedule.ScheduleManager.monthlyTime");
	public static String SCHEDULER_MANAGER_YEARLY_TIME = PropertiesLookup.getSystemProperty("sys.schedule.ScheduleManager.yearlyTime");
	public static String SYSTEM_FEEDBACK_EMAIL_SENDING_SCHEDULER = PropertiesLookup.getSystemProperty("sys.schedule.emailfeedback.enable");
	
	
	/**
	 * Tour Package
	 */
	
	public static String LISTING_YEAR_RANGE = PropertiesLookup.getSystemProperty("sys.tour.package.Listing.YearRange");
	
	/**
	 * Ipay88 Config
	 */
	public static String IPAY_PAYMENT_TESTING = PropertiesLookup.getSystemProperty("sys.ipay.payment.testing");
	
	/**
	 * AWS API
	 */
	
	private static String SYSTEM_API_SANDBOX = PropertiesLookup.getSystemProperty("system.api.sandbox");
	private static String SYSTEM_API_PROD = PropertiesLookup.getSystemProperty("system.api.prod");
	
	public static String SYSTEM_REQUEST_HEADER_AUTHORIZATION = PropertiesLookup.getSystemProperty("system.api.request.header.authorization");
	public static String SYSTEM_API_REQUEST_HEADER_CONTENT_TYPE = PropertiesLookup.getSystemProperty("system.api.request.header.contenttype");
	
	public static String API_CRM_REDEEM_CATALOG = PropertiesLookup.getSystemProperty("api.crm.redeem.catalog");
	public static String API_CRM_REDEEM_CLAIM = PropertiesLookup.getSystemProperty("api.crm.redeem.claim");
	public static String API_CRM_REDEEM_CLAIMED = PropertiesLookup.getSystemProperty("api.crm.redeem.claimed");
	public static String API_CRM_REDEEM_HISTORY = PropertiesLookup.getSystemProperty("api.crm.redeem.history");
	public static String API_CRM_REDEEM_REDEEM = PropertiesLookup.getSystemProperty("api.crm.redeem.redeem");
	
	/**
	 * sandbox/prod
	 */
	private static String ENV = PropertiesLookup.getSystemProperty("env");
	
	public static String getSystemApiUrl() {
		if (ENV.equals("prod")) {
			return SYSTEM_API_PROD;
		} else {
			return SYSTEM_API_SANDBOX;
		}
	}
	
	public static boolean isProd() {
		return StringUtils.equalsIgnoreCase(ENV, "prod");
	}
		
	public static boolean isSandbox() {
		return !isProd();
	}
}
