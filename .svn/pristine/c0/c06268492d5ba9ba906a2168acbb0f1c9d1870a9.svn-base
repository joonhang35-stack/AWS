package com.bcs.zsg.maintenance.web.bean;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

import org.primefaces.json.JSONException;

import com.bcs.zsg.acct.helper.KeycloakProperties;
import com.bcs.zsg.common.helper.KeycloakUtils;
import com.bcs.zsg.common.web.bean.AppBackingBean;
import com.bcs.zsg.crm.sec.vo.KeycloakAccessTokenVO;
import com.bcs.zsg.crm.sec.vo.KeycloakUserVO;

public class KeycloakConfigBean extends AppBackingBean {
	
	private static final long serialVersionUID = 1L;
	
	private List<KeycloakUserVO> keycloakUserList;
	
	private KeycloakUserVO keycloakUserVO;
	
	@Override
	public void resetForm() {
		
	}
	
	public void init() {
		resetForm();
		
		System.out.println("CYY getKeycloakRegisterForm: " + getKeycloakRegisterForm());
	}
	
	private Map<String, Object> generateSearchParams() {
		Map<String, Object> params = new HashMap<String, Object>();
		
		params.put("idCompany", getSessionInfoBean().getCompanyVO().getId());
		
//		if (StringUtils.isNotBlank(orderSourceCode))	params.put("orderSourceCode", orderSourceCode);
//		if (ArrayUtils.isNotEmpty(paymentStatusList))	params.put("paymentStatusList", paymentStatusList);
//		if (ArrayUtils.isNotEmpty(eInvoiceStatusList))	params.put("eInvoiceStatusList", eInvoiceStatusList);
//		if (fromDate != null)							params.put("fromDate", fromDate);
//		if (toDate != null)								params.put("toDate", toDate);
//		if (departureDateFr != null)					params.put("departureDateFr", departureDateFr);
//		if (departureDateTo != null)					params.put("departureDateTo", departureDateTo);
		
		return params;
	}
	
	public void getAccessToken() throws JSONException {
		try {
			KeycloakAccessTokenVO tokenVO = KeycloakUtils.getAccessToken(getSessionInfoBean().getCompanyVO());
			System.out.println("CYY tokenVO.getAccessToken(): " + tokenVO.getAccessToken());
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}

	}
	
	public void getUsersList() throws JSONException {
		try {
			keycloakUserList = KeycloakUtils.getUsersList(getSessionInfoBean().getCompanyVO());
//			KeycloakAccessTokenVO tokenVO = KeycloakUtils.getAccessToken();
//			System.out.println("CYY tokenVO.getAccess_token(): " + tokenVO.getAccess_token());
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}

	}
	
	public void onAddKeycloakUser() {
		keycloakUserVO = new KeycloakUserVO();
	}
	
	public void addKeycloakUser() {
		try {
			KeycloakUtils.addKeycloakUser(keycloakUserVO, getSessionInfoBean().getCompanyVO());
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public String getKeycloakRegisterForm() {
		String keycloakRealm = "myrealm";
		String keycloakClientId = "myclient";
		
		StringBuilder url = new StringBuilder();

	    url.append(KeycloakProperties.ENV_BASE_URL_SANDBOX)
//	       .append("/realms/")
//	       .append(keycloakRealm)
//	       .append("/protocol/openid-connect/registrations")
	       .append(KeycloakProperties.API_REGISTER)
	       .append("?client_id=").append(keycloakClientId)
	       .append("&response_type=code")
	       .append("&scope=openid")
	       .append("&redirect_uri=").append(KeycloakUtils.getCallbackUrl());

	    return url.toString();
	}
	
	public KeycloakUserVO getKeycloakUserVO() {
		return keycloakUserVO;
	}

	public void setKeycloakUserVO(KeycloakUserVO keycloakUserVO) {
		this.keycloakUserVO = keycloakUserVO;
	}

	public List<KeycloakUserVO> getKeycloakUserList() {
		return keycloakUserList;
	}

	public void setKeycloakUserList(List<KeycloakUserVO> keycloakUserList) {
		this.keycloakUserList = keycloakUserList;
	}
}
