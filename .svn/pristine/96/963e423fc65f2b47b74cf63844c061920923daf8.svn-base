	<bean id="ipayConfigDAO" class="com.bcs.zsg.maintenance.dao.IpayConfigDAOImpl" parent="baseHibernateDAO"/>
	<bean id="onlineBookingConfigDAO" class="com.bcs.zsg.maintenance.dao.OnlineBookingConfigDAOImpl" parent="baseHibernateDAO"/>
	<bean id="depositMasterConfigDAO" class="com.bcs.zsg.maintenance.dao.DepositMasterConfigDAOImpl" parent="baseHibernateDAO"/>
	<bean id="MalaysiaStateDAO" class="com.bcs.zsg.maintenance.dao.MalaysiaStateDAOImpl" parent="baseHibernateDAO"/>
	<bean id="CustomerProfileUpdateDAO" class="com.bcs.zsg.maintenance.dao.CustomerProfileUpdateDAOImpl" parent="baseHibernateDAO"/>
