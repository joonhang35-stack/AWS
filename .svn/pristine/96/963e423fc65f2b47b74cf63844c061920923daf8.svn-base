	<bean id="CustomerProfileUpdateBO" class="com.bcs.zsg.maintenance.bo.CustomerProfileUpdateBOImpl"/>
	 
	<!-- Services -->
	<bean id="lookUpsService" class="com.bcs.zsg.maintenance.service.LookUpsServiceImpl"/>
	<bean id="systemNumberGenerationService" class="com.bcs.zsg.maintenance.service.SystemNumberGenerationServiceImpl"/>
	<bean id="corporateProfileService" class="com.bcs.zsg.maintenance.service.CorporateProfileServiceImpl"/>
	<bean id="regionService" class="com.bcs.zsg.maintenance.service.RegionServiceImpl"/>
	<bean id="globalConfigService" class="com.bcs.zsg.maintenance.service.GlobalConfigServiceImpl"/>
	<bean id="foreignExRateService" class="com.bcs.zsg.maintenance.service.ForeignExRateServiceImpl"/>
	<bean id="accountCodeService" class="com.bcs.zsg.maintenance.service.AccountCodeServiceImpl"/>
	<bean id="tmpMsgService" class="com.bcs.zsg.maintenance.service.TmpMessageServiceImpl"/>
	<bean id="visibleListingConfigService" class="com.bcs.zsg.maintenance.service.VisibleListingConfigServiceImpl"/>
	<bean id="listingTableViewService" class="com.bcs.zsg.maintenance.service.ListingTableViewServiceImpl"/>
	<bean id="appSettingService" class="com.bcs.zsg.maintenance.service.AppSettingServiceImpl"/>
	<bean id="posUploadSalesService" class="com.bcs.zsg.maintenance.service.POSUploadSalesServiceImpl"/>
	<bean id="custPointService" class="com.bcs.zsg.maintenance.service.CustPointServiceImpl"/>
	<bean id="ipayConfigService" class="com.bcs.zsg.maintenance.service.IpayConfigServiceImpl"/>
