	<!-- DAO -->
	<bean id="lookUpDAO" class="com.bcs.zsg.maintenance.dao.LookUpDAOImpl" parent="baseHibernateDAO"/>
	<bean id="systemNumberGenerationDAO" class="com.bcs.zsg.maintenance.dao.SystemNumberGenerationDAOImpl" parent="baseHibernateDAO"/>
	<bean id="corporateProfileDAO" class="com.bcs.zsg.maintenance.dao.CorporateProfileDAOImpl" parent="baseHibernateDAO"/>
