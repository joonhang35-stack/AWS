	<bean id="accountCodeBO" class="com.bcs.zsg.maintenance.bo.AccountCodeBOImpl"/>
	<bean id="tmpMsgBo" class="com.bcs.zsg.maintenance.bo.TmpMessageBOImpl"/>
	<bean id="visibleListingConfigBO" class="com.bcs.zsg.maintenance.bo.VisibleListingConfigBOImpl"/>
	<bean id="listingTableViewBO" class="com.bcs.zsg.maintenance.bo.ListingTableViewBOImpl"/>
	<bean id="appSettingBO" class="com.bcs.zsg.maintenance.bo.AppSettingBOImpl"/>
