<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.acct.vo">

    <class table="E_INVOICE_DOCUMENT" name="EInvoiceDocumentVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        
        <!-- E-Invoice API attributes -->
        <property name="documentUuid" type="string" column="document_uuid"/>
        <property name="submissionUid" type="string" column="submission_uid"/>
        <property name="longId" type="string" column="long_id"/>
        <property name="eInvoiceDocType" type="string" column="e_invoice_doc_type"/>
        <property name="dtIssued" type="timestamp" column="dt_issued"/>
        <property name="dtReceived" type="timestamp" column="dt_received"/>
        <property name="dtCancel" type="timestamp" column="dt_cancel"/>
        <property name="dtValidated" type="timestamp" column="dt_validated"/>
        <property name="dtReject" type="timestamp" column="dt_reject"/>
        <property name="eInvoiceInternalId" type="string" column="e_invoice_internal_id"/>
        <property name="docStatusReason" type="string" column="doc_status_reason"/>
        <property name="issuerName" type="string" column="issuer_name"/>
        <property name="issuerTin" type="string" column="issuer_tin"/>
        <property name="receiverName" type="string" column="receiver_name"/>
        <property name="receiverId" type="string" column="receiver_id"/>
        <property name="totalDiscount" type="double" column="total_discount"/>
        <property name="totalExcludingTax" type="double" column="total_excluding_tax"/>
        <property name="totalNetAmount" type="double" column="total_net_amount"/>
        <property name="totalPayableAmount" type="double" column="total_payable_amount"/>
        <property name="eInvoiceVersion" type="string" column="e_invoice_version"/>
        <property name="eInvoiceCreatedBy" type="string" column="e_invoice_created_by"/>
        
        <!-- system attributes -->
        <property name="idCompany" type="long" column="id_company"/>
        <property name="idCust" type="long" column="id_cust"/>
        <property name="idSupplier" type="long" column="id_supplier"/>
        <property name="idEInvoiceBuyer" type="long" column="id_e_invoice_buyer"/>
        <property name="idEInvoiceSupplier" type="long" column="id_e_invoice_supplier"/>
        <property name="idRefEInvDoc" type="long" column="id_ref_e_inv_doc"/>
        <property name="idRefDoc" type="long" column="id_ref_doc"/>
        <property name="originalEInvRef" type="string" column="original_e_inv_ref"/>
        <property name="eInvoiceDocTypeCd" type="string" column="e_invoice_doc_type_cd"/>
        <property name="sysDocType" type="string" column="sys_doc_type"/>
        <property name="sysPrefix" type="string" column="sys_prefix"/>
        <property name="refId" type="long" column="ref_id"/>
        <property name="refNo" type="string" column="ref_no"/>
        <property name="isConsolEInv" type="boolean" column="is_consol_e_inv"/>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>