<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

<style>
.tourDepListClass .ui-datatable th div.ui-dt-c,
.tourDepListClass .ui-datatable .ui-datatable-data td div.ui-dt-c {
	padding: 4px 0px; 
	font-size: 10px; 
	text-align: center;
}

.tourDepListClass .ui-state-highlight,
.tourDepListClass .ui-widget-content .ui-state-highlight {
	border: 3px solid red;
	background: #7ddbfe !important;
}

.ui-tooltip {
	max-width: 600px;
}
</style>

<h:panelGrid columns="1">
	<p:commandButton value="#{msg['common.button.label.cancel']}" onclick="varTourDepListDialog.hide()"/>
</h:panelGrid>
<div class="tourDepListClass">
<p:dataTable id="idTourDepList" value="#{salesBean.tourDepList}" var="vo" rowStyleClass="#{vo.groupColor eq 0 ? 'group-color-one' : 'group-color-two'}"
	rowKey="#{vo.id}" selectionMode="single">
	<f:facet name="header">
		<h:panelGrid columns="1">
			<h:outputText value="#{salesBean.tourPkgVO.nameEn}"/>
			<h:outputText value=" #{salesBean.tourPkgVO.nameOther}" rendered="#{not empty salesBean.tourPkgVO.nameOther}"/>
			<h:outputText value=" #{salesBean.tourPkgVO.nameZh}" rendered="#{not empty salesBean.tourPkgVO.nameZh}"/>
		</h:panelGrid>
	</f:facet>
	
	<p:columnGroup type="header">
		<p:row>
			<p:column rowspan="2" headerText="Date" style="width:80px;"/>
			<p:column rowspan="2" headerText="Status" style="width:60px;"/>
			<p:column rowspan="2" headerText="Tour Code" style="width:130px;"/>
			<p:column rowspan="2" headerText="Tour Package Name" style="width:160px;"/>
			<p:column rowspan="2" headerText="Airline" style="width:40px;"/>
			<p:column colspan="2" headerText="Discount Level"/>
			<p:column rowspan="2" headerText="BAL" rendered="#{not salesBean.isAgentViewSeatAllotment}"/>
			<p:column colspan="5" headerText="Seat Allotment" rendered="#{salesBean.isAgentViewSeatAllotment}"/>
			<p:column colspan="2" headerText="Adult Price (RM)"/>
			<p:column colspan="3" headerText="Child Price (RM)"/>
			<p:column rowspan="2" headerText="MISC Taxes&lt;br/&gt;ADT/CHD" style="width:80px;"/>
			<p:column rowspan="2" headerText="Normal&lt;br/&gt;AC/SI" style="width:70px;"/>
			<p:column rowspan="2" headerText="Itinerary" style="width:30px;"/>
			<p:column rowspan="2" headerText="More&lt;br/&gt;Info" style="width:30px;"/>
			<p:column rowspan="2" headerText="Mail" style="width:30px;"/>
		</p:row>
		<p:row>
			<p:column headerText="Level 1" style="width:50px;"/>
			<p:column headerText="Level 2" style="width:50px;"/>
			<p:column headerText="All" style="width:30px; font-size:10px;" rendered="#{salesBean.isAgentViewSeatAllotment}"/>
			<p:column headerText="Sold" style="width:30px; font-size:10px;" rendered="#{salesBean.isAgentViewSeatAllotment}"/>
			<p:column headerText="KIV" style="width:30px; font-size:10px;" rendered="#{salesBean.isAgentViewSeatAllotment}"/>
			<p:column headerText="Bal" style="width:30px; font-size:10px;" rendered="#{salesBean.isAgentViewSeatAllotment}"/>
			<p:column headerText="GA" style="width:30px; font-size:10px;" rendered="#{salesBean.isAgentViewSeatAllotment}"/>
			<p:column headerText="TWN" style="width:55px; font-size:10px;"/>
			<p:column headerText="SGL" style="width:55px; font-size:10px;"/>
			<p:column headerText="CTW" style="width:55px; font-size:10px;"/>
			<p:column headerText="CEB" style="width:55px; font-size:10px;"/>
			<p:column headerText="CNB" style="width:55px; font-size:10px;"/>
			<!-- <p:column headerText="EN" style="width:25px; font-size:10px;"/> -->
			<!-- <p:column headerText="CN" style="width:25px; font-size:10px;"/> -->
		</p:row>
	</p:columnGroup>
	
	<p:column style="width:80px; padding: 8px 0;"><h:outputText value="#{vo.dtDep}"><f:convertDateTime pattern="#{config['date.display.pattern2']}"/></h:outputText>
		<ui:repeat value="#{vo.departDateBadgeList}" var="badgeVO">
			<h:outputText id="idTooltipBadge" value="#{badgeVO}" style="display:inline-block; background:white; #{not empty vo.departDateBadgeList and vo.departDateBadgeList.contains('DISCx2') ? 'color:red; border:1px solid red;' : 'color:green; border:1px solid green;'} border-radius: 5px; padding:2px; margin:2px;"  rendered="#{not empty vo.departDateBadgeList}"/>
			<pe:tooltip for="idTooltipBadge" rendered="#{not empty badgeVO}">
				<h:outputText value="#{bterp:lookupItemDesc('depart_date_badge', badgeVO)}"/>
			</pe:tooltip>
		</ui:repeat>
		<h:outputText id="idTooltipLangCode" rendered="#{not empty vo.langCode}" style="display:inline-block; background:#{vo.langCode eq 'BM' ? 'green' : 'white'}; color:#{vo.langCode eq 'BM' ? 'white' : 'green'}; border:1px solid green; border-radius: 5px; padding:2px; margin:2px;"
			value="#{vo.langCode}"/>
		<pe:tooltip for="idTooltipLangCode" rendered="#{not empty vo.langCode}">
			<h:outputText value="#{bterp:lookupItemDesc('product_lang', vo.langCode)}"/>
		</pe:tooltip>
	</p:column>
	<p:column style="width:60px;">
		<p:commandLink id="idBookButton" actionListener="#{salesBean.handleTourDepSelect(vo)}" update=":idAddBookingDialog" oncomplete="varAddBookingDialog.show()" 
			rendered="#{not salesBean.isAgentViewOnly and (vo.accCodeStatusCd eq 'Y' and (vo.tourStatusCd eq 'A' or vo.tourStatusCd eq 'L' or vo.tourStatusCd eq 'C1')) and not vo.isPrivateBooking}">
			<p:graphicImage value="/img/book_button_a.png" rendered="#{vo.tourStatusCd eq 'A' or vo.tourStatusCd eq 'C1'}"/>
			<p:graphicImage value="/img/book_button_l.png" rendered="#{vo.tourStatusCd eq 'L'}"/>
			<pe:tooltip for="idBookButton" shared="true" showDelay="0" myPosition="left center" atPosition="right center">
				<!-- <p:outputLabel value="#{salesBean.getCalculatedAmount(vo)}" style="white-space: pre-wrap"/> -->
                TWN=<span style="font-weight: bold;">#{salesBean.getDoubleDecimalFormat(((vo.fullTwn + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullTwn + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullTwn + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullTwn + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
				<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
				&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                SGL=<span style="font-weight: bold;">#{salesBean.getDoubleDecimalFormat(((vo.fullSgl + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullSgl + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullSgl + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullSgl + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
				<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
				<br/>
                CTW=<span style="font-weight: bold;">#{salesBean.getDoubleDecimalFormat(((vo.fullCtw + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCtw + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullCtw + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCtw + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
				<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
				&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                CWB=<span style="font-weight: bold;">#{salesBean.getDoubleDecimalFormat(((vo.fullCeb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCeb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullCeb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCeb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
				<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
				&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                CNB=<span style="font-weight: bold;">#{salesBean.getDoubleDecimalFormat(((vo.fullCnb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCnb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullCnb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCnb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
				<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
				<br/><br/>
				<span style="font-weight: bold;">Deposit #{salesBean.getDoubleDecimalFormat('#,##0', vo.deposit)}</span> per pax 
				<h:outputLabel style="font-size:11px; color:#F00;" rendered="#{(vo.discountPax1 gt 0 and vo.discount1 gt 0) or (vo.discountPax2 gt 0 and vo.discount2 gt 0)}">
					<br/><br/>
					Noted: Above price is <b>Grand Total include Discount (If has)</b>
				</h:outputLabel>
			</pe:tooltip>
		</p:commandLink>
		
		<p:outputLabel id="idViewOnly" rendered="#{salesBean.isAgentViewOnly and (vo.accCodeStatusCd eq 'Y' and (vo.tourStatusCd eq 'A' or vo.tourStatusCd eq 'L' or vo.tourStatusCd eq 'C1')) and not vo.isPrivateBooking}">
			View
			<pe:tooltip for="idViewOnly" shared="true" showDelay="0" myPosition="left center" atPosition="right center">
				<!-- <p:outputLabel value="#{salesBean.getCalculatedAmount(vo)}" style="white-space: pre-wrap"/> -->
				TWN=<span style="font-weight: bold;">#{salesBean.getDoubleDecimalFormat(((vo.fullTwn + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullTwn + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullTwn + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullTwn + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
				<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
				&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                SGL=<span style="font-weight: bold;">#{salesBean.getDoubleDecimalFormat(((vo.fullSgl + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullSgl + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullSgl + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullSgl + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
				<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
				<br/>
                CTW=<span style="font-weight: bold;">#{salesBean.getDoubleDecimalFormat(((vo.fullCtw + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCtw + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullCtw + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCtw + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
				<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
				&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                CWB=<span style="font-weight: bold;">#{salesBean.getDoubleDecimalFormat(((vo.fullCeb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCeb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullCeb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCeb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
				<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
				&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                CNB=<span style="font-weight: bold;">#{salesBean.getDoubleDecimalFormat(((vo.fullCnb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCnb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullCnb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCnb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
				<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
				<br/><br/>
				<span style="font-weight: bold;">Deposit #{salesBean.getDoubleDecimalFormat('#,##0', vo.deposit)}</span> per pax 
				<h:outputLabel style="font-size:11px; color:#F00;" rendered="#{(vo.discountPax1 gt 0 and vo.discount1 gt 0) or (vo.discountPax2 gt 0 and vo.discount2 gt 0)}">
					<br/><br/>
					Noted: Above price is <b>Grand Total include Discount (If has)</b>
				</h:outputLabel>
			</pe:tooltip>
		</p:outputLabel>
		<!-- <h:outputText value="Not Ready" style="text-transform:uppercase; color:#F00;" rendered="#{vo.accCodeStatusCd eq 'N'}"/>
		<h:outputText value="#{bterp:lookupItemDesc('tour_status', vo.tourStatusCd)}" style="text-transform:uppercase; color:#F00;" rendered="#{vo.tourStatusCd ne 'F' and vo.tourStatusCd ne 'A' and vo.tourStatusCd ne 'L' and vo.tourStatusCd ne 'C1'}"/>
		<h:outputText value="Full" style="text-transform:uppercase; color:#F00;" rendered="#{vo.tourStatusCd eq 'F' and vo.tourStatusCd ne 'A' and vo.tourStatusCd ne 'L'}"/> -->
	</p:column>
	<p:column style="width:130px;"><h:outputText value="#{vo.code}"/></p:column>
	<p:column style="width:160px;">
		<h:outputText value="PD " rendered="#{vo.isDepositPaid}"/><h:outputText style="color:#CC2EFA;" value="#{vo.numDays}D/#{vo.numNights}N "/><h:outputText value=" [#{vo.desc}]" style="color:#FF0000;" rendered="#{not empty vo.desc}"/>
		<h:outputText value="[S]" style="color:#86B404;" rendered="#{vo.isIssuedS}"/><h:outputText value="[F]" style="color:#86B404;" rendered="#{vo.isIssuedF}"/><h:outputText value="[#{vo.dailyCode}]" rendered="#{not empty vo.dailyCode}"/>
		<p:graphicImage value="/img/push.gif" rendered="#{vo.isPush and (vo.tourStatusCd eq 'A' or vo.tourStatusCd eq 'L')}"/>
		<ui:repeat value="#{vo.departDateBadgeList}" var="badgeVO">
				<h:outputText value="(#{badgeVO})" style="color:brown;"  rendered="#{not empty vo.departDateBadgeList}"/>
			</ui:repeat>
	</p:column>
	<p:column style="width:40px;">
		<p:commandLink actionListener="#{salesBean.handleTourDepSelect(vo)}" oncomplete="varTourDepAirlineInfoDialog.show()" update=":idTourDepAirlineInfoDialog" style="color:#CC2EFA;" process="@this">
			<h:outputText value="#{vo.airlineCode}"/>
		</p:commandLink>
	</p:column>
	<p:column style="width:50px;">
		<h:outputText value="#{vo.discount1 gt 0 ? vo.discount1 * -1 : vo.discount1}" rendered="#{vo.discount1 % 1 &gt; 0}" style="#{not empty vo.departDateBadgeList and vo.departDateBadgeList.contains('DISCx2') ? 'color: red; font-weight:bold;' : ''}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.discount1 gt 0 ? vo.discount1 * -1 : vo.discount1}" rendered="#{vo.discount1 % 1 &lt;= 0}" style="#{not empty vo.departDateBadgeList and vo.departDateBadgeList.contains('DISCx2') ? 'color: red; font-weight:bold;' : ''}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
		<h:outputText value=" (#{vo.discountPax1})" style="color: red;"/>
	</p:column>
	<p:column style="width:50px;">
		<h:outputText value="#{vo.discount2 gt 0 ? vo.discount2 * -1 : vo.discount2}" rendered="#{vo.discount2 % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.discount2 gt 0 ? vo.discount2 * -1 : vo.discount2}" rendered="#{vo.discount2 % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
		<h:outputText value=" (#{vo.discountPax2})" style="color: red;"/>
	</p:column>
	
	<p:column style="width:30px;" rendered="#{salesBean.isAgentViewSeatAllotment}"><h:outputText value="#{vo.seatAllot}"/></p:column>
	<p:column style="width:30px;" rendered="#{salesBean.isAgentViewSeatAllotment}"><h:outputText value="#{vo.tfairPax + vo.agentPax + vo.inHsePax + vo.on9BookingPax}"/></p:column>
	<p:column style="width:30px;" rendered="#{salesBean.isAgentViewSeatAllotment}"><h:outputText value="#{vo.kivPax}"/></p:column>
	<p:column style="width:30px; font-size:10px; background:#00BFFF; text-align:center;"><h:outputText value="#{vo.seatAllot - vo.reservedSeat - vo.tourManagerPax - (vo.tfairPax + vo.agentPax + vo.inHsePax + vo.kivPax + vo.on9BookingPax)}" style="#{(vo.seatAllot - vo.reservedSeat - vo.tourManagerPax - (vo.tfairPax + vo.agentPax + vo.inHsePax + vo.kivPax + vo.on9BookingPax)) eq 0 ? 'color:#f00; font-weight:bold;' : ''}"/></p:column>
	<p:column style="width:30px;" rendered="#{salesBean.isAgentViewSeatAllotment}"><h:outputText value="#{vo.totalGA}"/></p:column>
	
	<p:column style="width:55px;">
		<h:outputText value="#{vo.fullTwn}" rendered="#{vo.fullTwn % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.fullTwn}" rendered="#{vo.fullTwn % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:55px;">
		<h:outputText value="#{vo.fullSgl}" rendered="#{vo.fullSgl % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.fullSgl}" rendered="#{vo.fullSgl % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:55px;">
		<h:outputText value="#{vo.fullCtw}" rendered="#{vo.fullCtw % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.fullCtw}" rendered="#{vo.fullCtw % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:55px;">
		<h:outputText value="#{vo.fullCeb}" rendered="#{vo.fullCeb % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.fullCeb}" rendered="#{vo.fullCeb % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:55px;">
		<h:outputText value="#{vo.fullCnb}" rendered="#{vo.fullCnb % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.fullCnb}" rendered="#{vo.fullCnb % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:80px;">
		<h:outputText value="#{vo.miscAdt}" rendered="#{vo.miscAdt % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/></h:outputText><h:outputText value="/" rendered="#{vo.miscAdt % 1 &gt; 0}"/><h:outputText value="#{vo.miscChd}" rendered="#{vo.miscChd % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.miscAdt}" rendered="#{vo.miscAdt % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/></h:outputText><h:outputText value="/" rendered="#{vo.miscAdt % 1 &lt;= 0}"/><h:outputText value="#{vo.miscChd}" rendered="#{vo.miscChd % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:70px;">
		<h:outputText value="#{vo.cnaAdt}" rendered="#{vo.cnaAdt % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText><h:outputText value="/" rendered="#{vo.cnaAdt % 1 &gt; 0}"/><h:outputText value="#{vo.csiAdt}" rendered="#{vo.csiAdt % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.cnaAdt}" rendered="#{vo.cnaAdt % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText><h:outputText value="/" rendered="#{vo.cnaAdt % 1 &lt;= 0}"/><h:outputText value="#{vo.csiAdt}" rendered="#{vo.csiAdt % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:30px;">
		<ui:repeat value="#{vo.tourItineryList}" var="itineryVO">
			<h:outputLink target="_blank" value="#{request.contextPath}#{itineryVO.path}/#{salesBean.urlEncoder(itineryVO.name)}" rendered="#{itineryVO.typeCd eq 'CUST' and itineryVO.langCd eq 'EN'}"><p:graphicImage value="/img/pdf.png"/></h:outputLink>
			<h:outputLink target="_blank" value="#{request.contextPath}#{itineryVO.path}/#{salesBean.urlEncoder(itineryVO.name)}" rendered="#{itineryVO.typeCd eq 'AGENT' and itineryVO.langCd eq 'EN'}"><p:graphicImage value="/img/pdf.png"/></h:outputLink>
		</ui:repeat>
	</p:column>
	<!-- <p:column style="width:25px;">
		<ui:repeat value="#{vo.tourItineryList}" var="itineryVO">
			<h:outputLink target="_blank" value="#{request.contextPath}#{itineryVO.path}/#{salesBean.urlEncoder(itineryVO.name)}" rendered="#{itineryVO.typeCd eq 'CUST' and itineryVO.langCd eq 'ZH'}"><p:graphicImage value="/img/pdf.png"/></h:outputLink>
		</ui:repeat>
	</p:column> -->
	<p:column style="width:30px;">
		<p:commandLink actionListener="#{salesBean.handleTourDepSelect(vo)}" oncomplete="varTourDepMoreInfoDialog.show()" update=":idTourDepMoreInfoDialog">
			<p:graphicImage value="/img/more.png"/>
		</p:commandLink>
	</p:column>
	<p:column style="width:30px;">
		<h:outputLink value="#{request.contextPath}/app/emailtmp/bookingemailtmp?tourDepId=#{vo.id}&amp;withOutPax=Y" target="_blank">
			<p:graphicImage value="/img/mail.png"/>
		</h:outputLink>
	</p:column>
</p:dataTable>
</div>
<h:panelGrid columns="1">
	<p:commandButton value="#{msg['common.button.label.cancel']}" onclick="varTourDepListDialog.hide()"/>
</h:panelGrid>
</ui:composition>