package com.bcs.zsg.history.vo;

public class InvoiceItemHistoryViewVO extends InvoiceItemHistoryVO {

	private static final long serialVersionUID = 1L;
	
	private String acctCd;
	private String subAcctCd;
	private String acctDesc;
	private String subAcctDesc;
	
	private String airlineDesc;
	
	/**
	 * @return the acctCd
	 */
	public String getAcctCd() {
		return acctCd;
	}
	/**
	 * @param acctCd the acctCd to set
	 */
	public void setAcctCd(String acctCd) {
		this.acctCd = acctCd;
	}
	/**
	 * @return the subAcctCd
	 */
	public String getSubAcctCd() {
		return subAcctCd;
	}
	/**
	 * @param subAcctCd the subAcctCd to set
	 */
	public void setSubAcctCd(String subAcctCd) {
		this.subAcctCd = subAcctCd;
	}
	/**
	 * @return the acctDesc
	 */
	public String getAcctDesc() {
		return acctDesc;
	}
	/**
	 * @param acctDesc the acctDesc to set
	 */
	public void setAcctDesc(String acctDesc) {
		this.acctDesc = acctDesc;
	}
	/**
	 * @return the subAcctDesc
	 */
	public String getSubAcctDesc() {
		return subAcctDesc;
	}
	/**
	 * @param subAcctDesc the subAcctDesc to set
	 */
	public void setSubAcctDesc(String subAcctDesc) {
		this.subAcctDesc = subAcctDesc;
	}
	/**
	 * @return the airlineDesc
	 */
	public String getAirlineDesc() {
		return airlineDesc;
	}
	/**
	 * @param airlineDesc the airlineDesc to set
	 */
	public void setAirlineDesc(String airlineDesc) {
		this.airlineDesc = airlineDesc;
	}
}
