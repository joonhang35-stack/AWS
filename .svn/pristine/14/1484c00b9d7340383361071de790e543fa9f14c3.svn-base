<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="room_config" name="RoomConfigVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="description" type="string" column="description"/>
        <property name="twnQty" type="integer" column="twn_qty"/>
        <property name="sglQty" type="integer" column="sgl_qty"/>
		<property name="ctwQty" type="integer" column="ctw_qty"/>
		<property name="cwbQty" type="integer" column="cwb_qty"/>
		<property name="cnbQty" type="integer" column="cnb_qty"/>
		<property name="inftQty" type="integer" column="inft_qty"/>
		<property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_update"/>
		<property name="updatedBy" type="string" column="updated_by"/>
    </class>
</hibernate-mapping>