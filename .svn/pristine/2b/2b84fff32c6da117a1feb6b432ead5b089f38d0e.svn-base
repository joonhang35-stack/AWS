<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="issuance_list">
	
	<!-- backing bean, extends com.bcs.zsg.component.common.web.swf.bean.AppBackingBean -->
	<var name="salesBean" class="com.bcs.zsg.sales.web.bean.CreditNoteBean"/>
	<var name="custBean" class="com.bcs.zsg.sales.web.bean.CustomerBean"/>
	<var name="salesInvBean" class="com.bcs.zsg.sales.web.bean.CreditNoteBean"/>
	<view-state id="issuance_list">
		<on-entry>
			<evaluate expression="salesBean.init('C')"/>
			<evaluate expression="custBean.init(1)"/>
			<evaluate expression="salesInvBean.init('C')"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>