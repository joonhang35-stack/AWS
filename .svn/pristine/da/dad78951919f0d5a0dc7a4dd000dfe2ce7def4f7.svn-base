	public void onLogin() {
		keycloakUserVO = new KeycloakUserVO();
	}
	
	public void login() {
		try {
			KeycloakAccessTokenVO tokenVO = KeycloakUtils.login(keycloakUserVO.getUsername(),
					keycloakUserVO.getPassword(), null, null, getSessionInfoBean().getCompanyVO());
			
			this.tokenVO = tokenVO; // temp testing code, to copy access token
			
			JwtVerifierService verifier =
			        new JwtVerifierService(
			        		KeycloakProperties.ENV_BASE_URL_SANDBOX + KeycloakProperties.API_CERT
			        );

			boolean valid = verifier.verifyToken(tokenVO.getAccessToken());
			
			System.out.println("CYY valid: " + valid);
			
			JWSObject jwsObject = JWSObject.parse(tokenVO.getAccessToken());

	        Map<String, Object> payload =
	                jwsObject.getPayload().toJSONObject();

	        JSONObject xJsonObject = new JSONObject(payload);
	        System.out.println(xJsonObject.toString(4));
	        
	        Gson gson = new GsonBuilder()
		            .setFieldNamingPolicy(FieldNamingPolicy.LOWER_CASE_WITH_UNDERSCORES)
		            .create();
	        KeycloakAccessTokenClaimVO keycloakAccessTokenClaimVO = gson.fromJson(xJsonObject.toString(), KeycloakAccessTokenClaimVO.class);
		    
			System.out.println("CYY claimVO.getExp(): " + keycloakAccessTokenClaimVO.getExp());
			System.out.println("CYY claimVO.getEmail(): " + keycloakAccessTokenClaimVO.getEmail());
			System.out.println("CYY claimVO.getFamilyName(): " + keycloakAccessTokenClaimVO.getFamilyName());
			System.out.println("CYY claimVO.getGivenName(): " + keycloakAccessTokenClaimVO.getGivenName());
	        
			KeycloakUserVO keycloakUserVO = KeycloakUtils.getUser(keycloakAccessTokenClaimVO.getSub(), getSessionInfoBean().getCompanyVO());
			System.out.println("CYY keycloakUserVO.getUsername(): " + keycloakUserVO.getUsername());
			
			successResult();
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void onForgetPassword() {
		keycloakUserVO = new KeycloakUserVO();
	}
	
	public void forgetPassword() {
		try {
			keycloakUserList = KeycloakUtils.getUsersByParam(keycloakUserVO, getSessionInfoBean().getCompanyVO());
			if (CollectionUtils.isNotEmpty(keycloakUserList) && keycloakUserList.size() == 1) {
				KeycloakUtils.forgetPassword(keycloakUserList.get(0).getId(), getSessionInfoBean().getCompanyVO());
				successResult();
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void loadCRMMembershipList() {
		try {
			lazyCRMMembershipDataModel = new LazyCRMMembershipDataModel();
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}

	}
	
	public void delCRMMembership(CRMMembershipVO vo) {
		try {
			crmMembershipBO.delCRMMembership(vo);
			loadCRMMembershipList();
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void unlinkCRMMembership(CRMMembershipVO vo) {
		try {
			crmMembershipBO.unlinkCRMMembership(vo);
			loadCRMMembershipList();
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	/**********************
	 * Lazy loading model *
	 **********************/
	class LazyCRMMembershipDataModel extends LazyDataModel<CRMMembershipVO> implements Serializable {
		private static final long serialVersionUID = 1L;
	
		@Override
		public List<CRMMembershipVO> load(int first, int pageSize, String sortField, SortOrder sortOrder, Map<String, String> filters) {
			try {
//				trackingLogUtils.startLogs();
				
				Map<String, Object> params = new HashMap<String, Object>();
				params.put("idCompany", getSessionInfoBean().getCompanyVO().getId());
				params.put("statusCd", BaseConstant.STATUS_ACTIVE);				
				params.put("first", first);
				params.put("pageSize", pageSize);
				params.put("sortField", sortField);
				params.put("sortOrder", sortOrder);
				params.put("filters", filters);
				
				int size = crmMembershipBO.getCRMMembershipListSize(params);
				setRowCount(size);
				
				if (0 < getRowCount()) {
					List<CRMMembershipVO> crmMembershipList = crmMembershipBO.getCRMMembershipList(params);
					return crmMembershipList;
				}
				
			} catch (Throwable t) {
				t.printStackTrace();
				errorResult(t);
			} finally {
//				trackingLogUtils.endLogs("LazyInvoiceDataModel");
			}
			return new ArrayList<CRMMembershipVO>();
		}
		
		@Override
		public void setRowIndex(int rowIndex) {
			/*
			 * The following is in ancestor (LazyDataModel):
			 * this.rowIndex = rowIndex == -1 ? rowIndex : (rowIndex % pageSize);
			 */
			if (rowIndex == -1 || getPageSize() == 0) {
				super.setRowIndex(-1);
			} else super.setRowIndex(rowIndex % getPageSize());
		}
		
	}
	
	public String getKeycloakRegisterForm() {
//		String keycloakRealm = "myrealm";
		String keycloakClientId = "myclient";
		
		StringBuilder url = new StringBuilder();

	    url.append(KeycloakProperties.ENV_BASE_URL_SANDBOX)
//	       .append("/realms/")
//	       .append(keycloakRealm)
//	       .append("/protocol/openid-connect/registrations")
	       .append(KeycloakProperties.API_REGISTER)
	       .append("?client_id=").append(keycloakClientId)
	       .append("&response_type=code")
	       .append("&scope=openid")
	       .append("&redirect_uri=").append(KeycloakUtils.getCallbackUrl());

	    return url.toString();
	}
	
