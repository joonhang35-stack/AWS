sec.max.user.concurrent.sessions=1
sec.login.url=/app/login
sec.session.timeout.url=${sec.login.url}?t=1
sec.login.processing.url=/app/doLogin
sec.logout.processing.url=/app/doLogout
sec.logout.success.url=${sec.login.url}?logout=1
sec.default.landing.page.url=/app/home
sec.login.failure.url=${sec.login.url}?err=1
sec.login.concurrent.url=${sec.session.timeout.url}&c=1
sec.login.default.password=1q2w3e$R
sec.max.session.uptime.mins=0
sec.session.registry.refreshlastrequest=false
sec.concurrent.login.check.ttl=5000
sec.login.captcha.flag=false

# implementations
sec.redirect.strategy.impl=com.bcs.zsg.component.security.web.JsfRedirectStrategy
