package com.bcs.zsg.history.vo;

public class InvoicePaxHistoryViewVO extends InvoicePaxHistoryVO {

	private static final long serialVersionUID = 1L;

	private String custType;
	private String coName;
	private String custSalutatnCd;
	private String custFName;
	private String custLName;
	
	/**
	 * @return the custType
	 */
	public String getCustType() {
		return custType;
	}
	/**
	 * @param custType the custType to set
	 */
	public void setCustType(String custType) {
		this.custType = custType;
	}
	/**
	 * @return the coName
	 */
	public String getCoName() {
		return coName;
	}
	/**
	 * @param coName the coName to set
	 */
	public void setCoName(String coName) {
		this.coName = coName;
	}
	/**
	 * @return the custSalutatnCd
	 */
	public String getCustSalutatnCd() {
		return custSalutatnCd;
	}
	/**
	 * @param custSalutatnCd the custSalutatnCd to set
	 */
	public void setCustSalutatnCd(String custSalutatnCd) {
		this.custSalutatnCd = custSalutatnCd;
	}
	/**
	 * @return the custFName
	 */
	public String getCustFName() {
		return custFName;
	}
	/**
	 * @param custFName the custFName to set
	 */
	public void setCustFName(String custFName) {
		this.custFName = custFName;
	}
	/**
	 * @return the custLName
	 */
	public String getCustLName() {
		return custLName;
	}
	/**
	 * @param custLName the custLName to set
	 */
	public void setCustLName(String custLName) {
		this.custLName = custLName;
	}
}
