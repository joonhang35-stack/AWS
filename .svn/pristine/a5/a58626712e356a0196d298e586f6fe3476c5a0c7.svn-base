<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.bank.vo">

    <class table="cash_book_sum" name="CashBookSumViewVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="groupNo" type="double" column="group_no"/>
        <property name="debitSum" type="double" column="debit_sum"/>
    </class>
</hibernate-mapping>