	@SuppressWarnings("unchecked")
	@Override
	public List<EInvoiceApiDailySnapshotVO> getApiDailySnapshotList(Date dtTrans) {
		Criteria criteria = createCriteria(EInvoiceApiDailySnapshotVO.class);
		criteria.add(Restrictions.eq("dtTrans", dtTrans));
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
		
		List<EInvoiceApiDailySnapshotVO> ls = criteria.list();
		
		return ls;
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<EInvoiceApiDailySnapshotVO> getApiDailySnapshotList(Map<String, Object> params) {
		StringBuilder sb = new StringBuilder();
		sb.append("select ss.id, ss.id_company, ss.dt_trans, ss.total_count, sum(ss.page_size) ")
			.append(" from e_invoice_api_daily_snapshot ss ")
			.append(" where ss.id_company = :idCompany ");
		
		if (params.get("statusCd") != null)	sb.append(" and ss.status_cd = :statusCd ");
		
		sb.append(" group by ss.dt_trans ");
		sb.append(" order by ss.dt_trans desc ");
		
		Query query = createSQLQuery(sb.toString());
		query.setParameter("idCompany", params.get("idCompany"));
		if (params.get("statusCd") != null)	query.setParameter("statusCd", params.get("statusCd"));

//		if (params.get("first") != null && (Integer) params.get("first") >= 0)	query.setFirstResult((Integer) params.get("first"));
//		if (params.get("pageSize") != null && (Integer) params.get("pageSize") >= 0)	query.setMaxResults((Integer) params.get("pageSize"));
		
		List<Object> results = query.list();
		List<EInvoiceApiDailySnapshotVO> apiDailySnapshotList = new ArrayList<EInvoiceApiDailySnapshotVO>();
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			EInvoiceApiDailySnapshotVO vo = new EInvoiceApiDailySnapshotVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setIdCompany(((BigInteger) row[1]).longValue());
			vo.setDtTrans((Date) row[2]);
			
			if(row[3] != null) vo.setTotalCount((Integer.parseInt(row[3].toString())));
			if(row[4] != null) vo.setPageSize((Integer.parseInt(row[4].toString())));

			apiDailySnapshotList.add(vo);
		}
		return apiDailySnapshotList;
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<EInvoiceApiDailySnapshotTransVO> getApiDailySnapshotTransList(Long idCompany, Date dtTrans) {
		Criteria criteria = createCriteria(EInvoiceApiDailySnapshotTransVO.class);
		criteria.add(Restrictions.eq("idCompany", idCompany));
		criteria.add(Restrictions.eq("dtTrans", dtTrans));
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
		
		List<EInvoiceApiDailySnapshotTransVO> ls = criteria.list();
		
		return ls;
	}
	
	@Override
	public void updateApiDailySnapshotTransStatus(Long idTrans, String existsInLocalStatus, String processStatus, String statusReason) {
		String updatedBy = BaseContext.getUserFullName();
		if (StringUtils.isBlank(updatedBy)) updatedBy = BaseContext.getLoginId();
		
		StringBuilder sb = new StringBuilder();
		
		sb.append(" update e_invoice_api_daily_snapshot_trans set ");
		if (StringUtils.isNotBlank(existsInLocalStatus))	sb.append(" exists_in_local_status = :existsInLocalStatus, ");
		if (StringUtils.isNotBlank(processStatus))			sb.append(" process_status = :processStatus, ");
		if (StringUtils.isNotBlank(statusReason))			sb.append(" status_reason = :statusReason, ");
		
		sb.append(" upd_by = :updatedBy, ");
		sb.append(" dt_upd = now() ");
		
		sb.append(" where id = :idTrans ");
		
//		System.out.println("CYY eInvoiceDocumentUuid: " + eInvoiceDocumentUuid);
		
		Query query = createSQLQuery(sb.toString());
		query.setParameter("idTrans", idTrans);
		if (StringUtils.isNotBlank(existsInLocalStatus))	query.setParameter("existsInLocalStatus", existsInLocalStatus);
		if (StringUtils.isNotBlank(processStatus))			query.setParameter("processStatus", processStatus);
		if (StringUtils.isNotBlank(statusReason))			query.setParameter("statusReason", statusReason);
		query.setParameter("updatedBy", updatedBy);
		query.executeUpdate();
	}
	
	@Override
	public List<EInvoiceSubmissionVO> getEInvoiceSubmissionByStatus(String[] statusList, Long idCompany) {
		Criteria criteria = createCriteria(EInvoiceSubmissionVO.class);
		criteria.add(Restrictions.eq("idCompany", idCompany));
		criteria.add(Restrictions.in("statusCode", statusList));
		List<EInvoiceSubmissionVO> ls = criteria.list();
		
		return ls;
	}
	
	@Override
	public EInvoiceSubmissionVO getEInvoiceSubmissionVO(String submissionUid) {
		Criteria criteria = createCriteria(EInvoiceSubmissionVO.class);
		criteria.add(Restrictions.eq("submissionUid", submissionUid));
		return (EInvoiceSubmissionVO) criteria.uniqueResult();
	}
