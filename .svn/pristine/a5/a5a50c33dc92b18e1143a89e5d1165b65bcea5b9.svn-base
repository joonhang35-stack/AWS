public class EInvoiceDAOImpl extends BaseHibernateDAO implements EInvoiceDAO {

	@Override
	public List<EInvoiceDocumentVO> getEInvoiceList(Long idCompany) {
		Criteria criteria = createCriteria(EInvoiceDocumentVO.class);
		criteria.add(Restrictions.eq("idCompany", idCompany));
		criteria.addOrder(Order.desc("createdDate"));
		criteria.addOrder(Order.desc("id"));
		List<EInvoiceDocumentVO> ls = criteria.list();
		
		return ls;
	}
	
	@Override
	public EInvoiceDocumentVO getEInvoiceByUuid(String uuid) {
		Criteria criteria = createCriteria(EInvoiceDocumentVO.class);
		criteria.add(Restrictions.eq("documentUuid", uuid));
		return (EInvoiceDocumentVO) criteria.uniqueResult();
	}
	
	@Override
	public EInvoiceConsolidateNumGenVO getEInvoiceConsolidateNumGenVO(Integer year, Integer month, String code, Long idCompany) {
		Criteria criteria = createCriteria(EInvoiceConsolidateNumGenVO.class);
		criteria.add(Restrictions.eq("year", year));
		criteria.add(Restrictions.eq("month", month));
		criteria.add(Restrictions.eq("code", code));
		criteria.add(Restrictions.eq("idCompany", idCompany));
		return (EInvoiceConsolidateNumGenVO) criteria.uniqueResult();
	}
	
	@Override
	public EInvoiceAccessTokenVO getValidAccessToken(Long idCompany) throws BusinessException {
		Criteria criteria = createCriteria(EInvoiceAccessTokenVO.class);
		criteria.add(Restrictions.eq("idCompany", idCompany));
		criteria.add(Restrictions.ge("dateValid", new Date()));
		criteria.addOrder(Order.desc("id"));
		criteria.setMaxResults(1);
		return (EInvoiceAccessTokenVO) criteria.uniqueResult();
	}
	
	@Override
	public List<EInvoiceConsolidateVO> getEInvoiceConsolidateList(String eInvoiceDocUuid) throws BusinessException {
		Criteria criteria = getSession().createCriteria(EInvoiceConsolidateVO.class);
		criteria.add(Restrictions.eq("documentUuid", eInvoiceDocUuid));
//		criteria.addOrder(Order.desc("id"));
		
		List<EInvoiceConsolidateVO> ls = criteria.list();
		return ls;
	}
	
	@Override
	public void updateEInvoiceConsolidate(String eInvoiceDocUuid, String longId, String status) throws BusinessException {
		String updatedBy = BaseContext.getUserFullName();
		if (StringUtils.isBlank(updatedBy)) updatedBy = BaseContext.getLoginId();
		
		StringBuilder sb = new StringBuilder();
		
		sb.append(" update e_invoice_consolidate set ");
		if (StringUtils.isNotBlank(longId))	sb.append(" long_id = :longId, ");
		if (StringUtils.isNotBlank(status))	sb.append(" status_cd = :statusCd, ");
		
		sb.append(" upd_by = :updatedBy, ");
		sb.append(" dt_upd = now() ");
		
		sb.append(" where document_uuid = :documentUuid ");
		
		Query query = createSQLQuery(sb.toString());
		if (StringUtils.isNotBlank(longId))	query.setParameter("longId", longId);
		if (StringUtils.isNotBlank(status))	query.setParameter("statusCd", status);
		query.setParameter("documentUuid", eInvoiceDocUuid);
		query.setParameter("updatedBy", updatedBy);
		query.executeUpdate();
	}
	
	/**
	 * update e inv status to corresponding table (variable table name)
	 * 
	 * @param eInvoiceDocumentUuid
	 * @param eInvoiceStatus
	 * @param table - table name to update
	 * @throws BusinessException
	 */
	@Override
	public void updateEInvoiceStatus(String eInvoiceDocumentUuid, String eInvoiceStatus, String table) throws BusinessException {
		String updatedBy = BaseContext.getUserFullName();
		if (StringUtils.isBlank(updatedBy)) updatedBy = BaseContext.getLoginId();
		
		StringBuilder sb = new StringBuilder();
		
		sb.append(" update ");
		sb.append(table);
		sb.append(" set ");
		if (StringUtils.isNotBlank(eInvoiceStatus))			sb.append(" e_invoice_status = :eInvoiceStatus, ");
		
		sb.append(" upd_by = :updatedBy, ");
		sb.append(" dt_upd = now() ");
		
		sb.append(" where e_invoice_document_uuid = :eInvoiceDocumentUuid ");
		
//		System.out.println("CYY eInvoiceDocumentUuid: " + eInvoiceDocumentUuid);
		
		Query query = createSQLQuery(sb.toString());
		if (StringUtils.isNotBlank(eInvoiceStatus))	query.setParameter("eInvoiceStatus", eInvoiceStatus);
		query.setParameter("eInvoiceDocumentUuid", eInvoiceDocumentUuid);
		query.setParameter("updatedBy", updatedBy);
		query.executeUpdate();
	}
	
	@Override
	public void updateEInvoiceParty(@Nonnull Long idEInvDoc, @Nullable Long idCust, @Nullable Long idSupplier, @Nullable Long idEInvoiceBuyer, @Nullable Long idEInvoiceSupplier) throws BusinessException {
		String updatedBy = StringUtils.defaultIfBlank(
		        BaseContext.getUserFullName(),
		        StringUtils.defaultIfBlank(BaseContext.getLoginId(), "SYSTEM")
		);

		StringBuilder sb = new StringBuilder();
		
		sb.append(" update e_invoice_document set ");
		if (idCust != null)				sb.append(" id_cust = :idCust, ");
		if (idSupplier != null)			sb.append(" id_supplier = :idSupplier, ");
		if (idEInvoiceBuyer != null)	sb.append(" id_e_invoice_buyer = :idEInvoiceBuyer, ");
		if (idEInvoiceSupplier != null)	sb.append(" id_e_invoice_supplier = :idEInvoiceSupplier, ");
		
		sb.append(" upd_by = :updatedBy, ");
		sb.append(" dt_upd = now() ");
		
		sb.append(" where id = :idEInvDoc ");
		
//		System.out.println("CYY idEInvDoc: " + idEInvDoc);
//		System.out.println("CYY idEInvoiceBuyer: " + idEInvoiceBuyer);
//		System.out.println("CYY idEInvoiceSupplier: " + idEInvoiceSupplier);
		
		Query query = createSQLQuery(sb.toString());
		
		if (idCust != null)				query.setParameter("idCust", idCust);
		if (idSupplier != null)			query.setParameter("idSupplier", idSupplier);
		if (idEInvoiceBuyer != null)	query.setParameter("idEInvoiceBuyer", idEInvoiceBuyer);
		if (idEInvoiceSupplier != null)	query.setParameter("idEInvoiceSupplier", idEInvoiceSupplier);
		query.setParameter("idEInvDoc", idEInvDoc);
		query.setParameter("updatedBy", updatedBy);
		
		query.executeUpdate();
	}
	
	@Override
	public void updateEInvoiceDocTypeCd(@Nonnull Long idEInvDoc, @Nullable String eInvoiceDocTypeCd) throws BusinessException {
		String updatedBy = StringUtils.defaultIfBlank(
		        BaseContext.getUserFullName(),
		        StringUtils.defaultIfBlank(BaseContext.getLoginId(), "SYSTEM")
		);
		
		StringBuilder sb = new StringBuilder();
		
		sb.append(" update e_invoice_document set ");
		if (StringUtils.isNotBlank(eInvoiceDocTypeCd))	sb.append(" e_invoice_doc_type_cd = :eInvoiceDocTypeCd, ");
		
		sb.append(" upd_by = :updatedBy, ");
		sb.append(" dt_upd = now() ");
		
		sb.append(" where id = :idEInvDoc ");
		
//		System.out.println("CYY idEInvDoc: " + idEInvDoc);
		
		Query query = createSQLQuery(sb.toString());
		
		if (StringUtils.isNotBlank(eInvoiceDocTypeCd))	query.setParameter("eInvoiceDocTypeCd", eInvoiceDocTypeCd);
		query.setParameter("idEInvDoc", idEInvDoc);
		query.setParameter("updatedBy", updatedBy);
		
		query.executeUpdate();
	}
	
