	 */
	@SuppressWarnings("unchecked")
	@Override
	public int getSupplierInBills(Long supplierId) {
		String sql = "select * from ex_order_bill where id_supplier ='" + supplierId + "' "; 
		int temp = 0;

		Query query = createSQLQuery(sql);

		List<Object> results = query.list(); 
		if(results.size() > 0){
			temp = 1;
		}
		return temp;
	}
	
