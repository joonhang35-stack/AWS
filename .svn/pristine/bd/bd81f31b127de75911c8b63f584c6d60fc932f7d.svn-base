	@Override
	public JournalVO insertReverseJournal(InvoiceVO paxStmtVO, InvoiceVO invoiceVO) throws BusinessException, QueueException {
		
		// reverse sales journal

		// preparation
		CompanyVO companyVO = corporateProfileDAO.getCompanyDetails(paxStmtVO.getCompanyId());
		AmountCalcViewVO amtCalcViewVO = new AmountCalcViewVO();
		amtCalcViewVO.setIdTaxAcct(companyVO.getIdAcctGST());
		amtCalcViewVO.setIdTaxNonClaimableAcct(companyVO.getIdAcctNonClaimableGST());

		SystemNumberGenerationVO psSNGVO = systemNumberGenerationDAO
				.getSystemNumberGeneration(CommonConstant.SYS_NUM_CD_PAX_STMT, paxStmtVO.getCompanyId());
		SystemNumberGenerationVO invSNGVO = systemNumberGenerationDAO
				.getSystemNumberGeneration(CommonConstant.SYS_NUM_CD_INVC, paxStmtVO.getCompanyId());
		
		BigDecimal totalCrdAmt = new BigDecimal("0.00"); // total credit amount
		BigDecimal totalDbtAmt = new BigDecimal("0.00"); // total debit amount

		// create journal
		JournalVO journalVO = new JournalVO();
		journalVO.setCompanyId(paxStmtVO.getCompanyId());
		journalVO.setReason("[Reverse Sales] Convert " + psSNGVO.getPrefixid() + paxStmtVO.getPsNo() + " To " + invSNGVO.getPrefixid()
				+ invoiceVO.getCode());
		journalVO.setJournalDt(invoiceVO.getInvoiceDt()); // use inv dt, not ps dt, cuz now inv dt follow conversion dt
		journalVO.setIdTourDep(invoiceVO.getTourDepId());
		journalVO.setIdDpt(MaintConstant.DEPT_TYPE_ACCT);
		journalVO.setIdInv(invoiceVO.getId());
		journalVO.setIdPs(paxStmtVO.getId());
		journalVO.setJournalCartList(new ArrayList<AcctTransVO>());
		
		// create journal items

		// main journal item (reverse trade debtor)
		AcctTransVO mainJournalItem = buildJourItem(paxStmtVO);
		journalVO.getJournalCartList().add(mainJournalItem);

		totalCrdAmt = totalCrdAmt.add(new BigDecimal(String.valueOf(mainJournalItem.getCredit())));
		totalDbtAmt = totalDbtAmt.add(new BigDecimal(String.valueOf(mainJournalItem.getDebit())));

		// journal items (invoice item)
		for (InvoiceItemVO itemVO : paxStmtVO.getInvoiceItemList()) {
			AcctTransVO journalItem = buildJourItem(itemVO, false);
			journalVO.getJournalCartList().add(journalItem);

			totalCrdAmt = totalCrdAmt.add(new BigDecimal(String.valueOf(journalItem.getCredit())));
			totalDbtAmt = totalDbtAmt.add(new BigDecimal(String.valueOf(journalItem.getDebit())));
		}
		
		// other journal item (tax/rounding)
		if (paxStmtVO.getIdAcctRounding() != null) {
			journalVO.getJournalCartList().add(buildTaxRoundingJourItem(paxStmtVO.getRoundingAmt(), CommonConstant.SYS_NUM_CD_ROUNDING, paxStmtVO.getIdAcctRounding()));
		}
		if (paxStmtVO.getIdAcctGST() != null) {
			journalVO.getJournalCartList().add(buildTaxRoundingJourItem(paxStmtVO.getTaxAmt(), CommonConstant.SYS_NUM_CD_TAX, paxStmtVO.getIdAcctGST()));
		}

//		System.out.println("CYY totalCrdAmt: " + totalCrdAmt);
//		System.out.println("CYY totalDbtAmt: " + totalDbtAmt);

		if (CollectionUtils.isEmpty(journalVO.getJournalCartList()))
			throw new BusinessException(CommonErrConstant.ERR_ACCT_JOURNAL_NO_ITEM);
		if (totalCrdAmt.doubleValue() == totalDbtAmt.doubleValue()) // && totalCrdAmt.doubleValue() != 0.00)
			journalVO.setTotalAmt(totalCrdAmt.doubleValue());
		else
			throw new BusinessException(CommonErrConstant.ERR_ACCT_CREDIT_DEBIT_NOT_EQUAL);

		journalVO.setAmountCalcViewVO(updateTaxableAmount(false, journalVO.getJournalCartList(), amtCalcViewVO));
		journalVO.setTypeCd(CommonConstant.JOURNAL_TYPE_SALES);

		insertJournal(journalVO, journalVO.getJournalCartList());
		
		return journalVO;
	}
	
	private AmountCalcViewVO updateTaxableAmount(boolean isCalGLItems, List<AcctTransVO> journalCartList, AmountCalcViewVO amtCalcViewVO) throws BusinessException {
		if (isCalGLItems) calculateGLItemsAmount(journalCartList);
		
		return AccountHelper.computeAmountTotalBasedItem(amtCalcViewVO, false, journalCartList, null, false);
	}
	
	private void calculateGLItemsAmount(List<AcctTransVO> list) throws BusinessException {
		for (AcctTransVO vo : list) {
			vo.setTaxAmount(vo.getAmount() < 0 ? -vo.getTaxAmount() : vo.getTaxAmount());
			
			BigDecimal amount = new BigDecimal(String.valueOf(vo.getAmount()));
			BigDecimal taxAmount = new BigDecimal(vo.getTaxAmount().toString());
			
			vo.setAmountIncludeTax(amount.add(taxAmount).doubleValue());
		}
	}
	
	private AcctTransVO buildJourItem(InvoiceVO paxStmtVO) throws BusinessException {
		paxStmtVO.setAcctVO(chartOfAcctDAO.getAcctVO(paxStmtVO.getAcctId()));

		if (paxStmtVO.getAcctVO().getSubCode().equals("")) {
//			mainJournalItem.setCode(paxStmtVO.getAcctVO().getCode());
//			mainJournalItem.setDesc(paxStmtVO.getAcctVO().getDesc());
			return buildJourItem(paxStmtVO.getAmount(), 0.0, 
					paxStmtVO.getAcctVO().getDesc(), 
					paxStmtVO.getAcctId(),
					paxStmtVO.getAcctVO().getCode());
		} else {
//			mainJournalItem.setCode(paxStmtVO.getAcctVO().getCode() + "-" + paxStmtVO.getAcctVO().getSubCode());
//			mainJournalItem.setDesc(paxStmtVO.getAcctVO().getDesc() + ", " + paxStmtVO.getAcctVO().getSubDesc());
			return buildJourItem(paxStmtVO.getAmount(), 0.0, 
					paxStmtVO.getAcctVO().getDesc() + ", " + paxStmtVO.getAcctVO().getSubDesc(), 
					paxStmtVO.getAcctId(),
					paxStmtVO.getAcctVO().getCode() + "-" + paxStmtVO.getAcctVO().getSubCode());
		}
		
	}
	
	/**
	 * reverse sales journal
	 * build journal item from invoice item
	 * @param itemVO
	 * @param accLoaded
	 * @return
	 * @throws BusinessException 
	 */
	private AcctTransVO buildJourItem(InvoiceItemVO itemVO, boolean accLoaded) throws BusinessException {
		if (!accLoaded) {
			// set account code if account not loaded
			AcctVO acctVO = chartOfAcctDAO.getAcctVO(itemVO.getAcctId());
			if (acctVO.getSubCode().equals("")) {
				itemVO.setSalesAcctCd(acctVO.getCode());
			} else {
				itemVO.setSalesAcctCd(acctVO.getCode() + "-" + acctVO.getSubCode());
			}
		}
		if (StringUtils.isNotBlank(itemVO.getSubDesc())) {
			itemVO.setDesc(itemVO.getDesc() + BaseConstant.PAD_SPACE + BaseConstant.PAD_SLASH + BaseConstant.PAD_SPACE + itemVO.getSubDesc());
		}
		return buildJourItem(0.0, itemVO.getAmount(), itemVO.getDesc(), itemVO.getAcctId(), itemVO.getSalesAcctCd());
	}
	
	/**
	 * reverse sales journal
	 * build tax or rounding journal item
	 * @param debit
	 * @param taxOrRounding
	 * @param idAcct
	 * @return
	 */
	private AcctTransVO buildTaxRoundingJourItem(Double debit, String taxOrRounding, Long idAcct) {
		return buildJourItem(0.0, debit, taxOrRounding, idAcct, taxOrRounding);
	}
	
	/**
	 * build journal item account trans
	 * @param credit
	 * @param debit
	 * @param desc
	 * @param idAcct
	 * @param code
	 * @return
	 */
	private AcctTransVO buildJourItem(Double credit, Double debit, String desc, Long idAcct, String code) {
		AcctTransVO journalItem = new AcctTransVO();
		journalItem.setCredit(credit);
		journalItem.setDebit(debit);
		journalItem.setDesc(desc);
		journalItem.setAcctId(idAcct);
		journalItem.setCode(code);
		return journalItem;
	}
	
