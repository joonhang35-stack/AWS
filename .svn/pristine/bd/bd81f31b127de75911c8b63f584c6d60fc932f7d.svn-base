	@Override
	public void insertJournal(JournalVO journalVO, List<AcctTransVO> journalCartList) throws BusinessException, QueueException {
		
		SystemNumberGenerationVO journalSysNumVO = new SystemNumberGenerationVO();
		journalSysNumVO.setCode(CommonConstant.SYS_NUM_CD_JRNL);
		journalSysNumVO.setIdCompany(journalVO.getCompanyId());
		journalSysNumVO = SysNumGenUtil.getSysNumber(SysNumGenUtil.getIdx(journalSysNumVO));
		
		Long journalId = journalSysNumVO.getNextnumber();
		
		journalVO.setSysNo(journalId.toString());
		
		if (StringUtils.isBlank(BaseContext.getUserFullName()) && StringUtils.isBlank(BaseContext.getLoginId())) {
			journalDAO.insert(journalVO, "SYSTEM");
		} else {
			journalDAO.insert(journalVO);
		}
		
		AcctTransVO journalMain = createMainAcctTransJournal(journalVO);
		
		// You Yuan 2026.1.23
		// long story short, this function will cause 
		// org.hibernate.exception.GenericJDBCException: Cannot open connection
		// Caused by: org.apache.tomcat.jdbc.pool.PoolExhaustedException: [http-nio-8080-exec-1] Timeout: Pool empty. Unable to fetch a connection in 10 seconds, none available[size:15; busy:15; idle:0; lastwait:10000].
		updateRoundingAndTax(journalVO.getAmountCalcViewVO(), journalMain, journalCartList); 
		
		addJournalItem(journalMain, journalCartList);
	}
	
	private void addJournalItem(AcctTransVO journalMain, List<AcctTransVO> journalCartList) throws BusinessException {

		for (AcctTransVO vo : journalCartList) {
			vo.setTransDt(journalMain.getTransDt());
			vo.setSysPrefix(journalMain.getSysPrefix());
			vo.setSysCode(journalMain.getSysCode());
			vo.setCompanyId(journalMain.getCompanyId());
			vo.setSysNo(journalMain.getSysNo());
			vo.setRefNo(journalMain.getRefNo());
			vo.setSource(journalMain.getSource());
			vo.setDestination(journalMain.getDestination());
			
			if (StringUtils.isBlank(BaseContext.getUserFullName()) && StringUtils.isBlank(BaseContext.getLoginId())) {
				accountService.auditAcctTransEmailPayment(CommonConstant.ACTION_CD_ADD, vo);
			} else {
				accountService.auditAcctTrans(CommonConstant.ACTION_CD_ADD, vo);
			}
			
		}
	}
	
	private String getDestination(JournalVO journalVO) {
		return journalVO.getReason() + (StringUtils.isNotBlank(journalVO.getReference()) ? "-" + journalVO.getReference() : "");
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public void updateJournal(JournalVO journalVO, List<AcctTransVO> journalCartList, AddUpdDelVO journalItemsVO) throws BusinessException, QueueException {

		AcctTransVO mainVO = createMainAcctTransJournal(journalVO);
		
		if (journalItemsVO.getAddList().size() > 0) {
			addJournalItem(mainVO, ((List<AcctTransVO>)((List<?>)journalItemsVO.getAddList())));
		}

		System.out.println("CYY journalItemsVO.getUpdList().size(): " + journalItemsVO.getUpdList().size());
		Set<Long> idList = new HashSet<Long>();
		if (journalItemsVO.getUpdList().size() > 0) {
			for (Object vo : journalItemsVO.getUpdList()) {
				AcctTransVO acctTransVO = (AcctTransVO) vo;
				acctTransVO.setTransDt(journalVO.getJournalDt());
				acctTransVO.setDestination(getDestination(journalVO));
				
				System.out.println("CYY acctTransVO.getId(): " + acctTransVO.getId());
				System.out.println("CYY DC: " + acctTransVO.getDebit() + ", " + acctTransVO.getCredit());
				
				idList.add(acctTransVO.getId());
				accountService.auditAcctTrans(CommonConstant.ACTION_CD_UPD, acctTransVO);
			}
		}
		
		if (journalItemsVO.getDelList().size() > 0) {
			for (Object vo : journalItemsVO.getDelList()) {
				AcctTransVO acctTransVO = (AcctTransVO) vo;
				idList.add(acctTransVO.getId());
				accountService.auditAcctTrans(CommonConstant.ACTION_CD_DEL, acctTransVO);
			}
		}
		
		JournalVO dbJournal = journalDAO.getJournal(journalVO);
		List<AcctTransVO> journalItemList = new ArrayList<AcctTransVO>();
		
		if(dbJournal.getJournalDt() != journalVO.getJournalDt() || 
				dbJournal.getReason() != journalVO.getReason() ) {
			//Get journal item not found in update and Update with latest data.
			
			Map<String, Object> params = generateAccountTranParam(journalVO, true);
			params.remove("transDt");
			
			journalItemList = accountService.getAccountTransListFilterID(params
													, idList.toArray(), false);
			
			if (journalItemList.size() > 0) {
				for (AcctTransVO acctTransVO : journalItemList) {
					acctTransVO.setTransDt(journalVO.getJournalDt());
					acctTransVO.setDestination(getDestination(journalVO));
					accountService.auditAcctTrans(CommonConstant.ACTION_CD_UPD, acctTransVO);
				}
			}
		}
		
		dbJournal.setJournalDt(journalVO.getJournalDt());
		dbJournal.setReason(journalVO.getReason());
		dbJournal.setReference(journalVO.getReference());
		dbJournal.setTotalAmt(journalVO.getTotalAmt());
		dbJournal.setIdTourDep(journalVO.getIdTourDep());
		dbJournal.setIdDpt(journalVO.getIdDpt());
		
		journalDAO.update(dbJournal);
		
		updateRoundingAndTax(journalVO.getAmountCalcViewVO(), mainVO, journalCartList);
		
	}
	
	@Override
	public void delJournal(JournalVO journalVO) throws BusinessException {
		
		// delete linking from bill to journal
		billPymtDAO.removeJournalFromBill(journalVO.getId());
		
		List<AcctTransVO> journalItems = accountService.getAccountTransList(generateAccountTranParam(journalVO, false));
		
		for(AcctTransVO vo : journalItems){
			accountService.auditAcctTrans(CommonConstant.ACTION_CD_DEL, vo);
		}
		journalDAO.delete(journalVO);
	}
	
