	@Override
	public List<AcctTransVO> getJournalItems(JournalVO journalVO) throws BusinessException {
		return accountService.getAccountTransList(generateAccountTranParam(journalVO, true));
	}

	private Map<String, Object> generateAccountTranParam(JournalVO journalVO, boolean includeRefNo) {
		Map<String, Object> params = new HashMap<String, Object>();
		params.put("companyId", journalVO.getCompanyId());
		params.put("sysCode", CommonConstant.SYS_NUM_CD_JRNL);
		params.put("transDt", journalVO.getJournalDt());
		params.put("sysNo", journalVO.getSysNo());
		
		//For account tax and rnd inclusion/exclude
		if(includeRefNo)
			params.put("refNo", journalVO.getId().toString());
		params.put("statusCode", BaseConstant.STATUS_ACTIVE);
		return params;
	}
	
	private AcctTransVO createMainAcctTransJournal(JournalVO journalVO) throws BusinessException {
		SystemNumberGenerationVO invSNGVO = systemNumberGenerationDAO.getSystemNumberGeneration(CommonConstant.SYS_NUM_CD_JRNL, journalVO.getCompanyId());

		AcctTransVO mainVO = new AcctTransVO();
		
		mainVO.setTransDt(journalVO.getJournalDt());
		mainVO.setSysPrefix(invSNGVO.getPrefixid());
		mainVO.setSysCode(CommonConstant.SYS_NUM_CD_JRNL);
		mainVO.setCompanyId(journalVO.getCompanyId());
		mainVO.setSysNo(journalVO.getSysNo());
		mainVO.setRefNo(journalVO.getId().toString());
		mainVO.setSource(invSNGVO.getPrefixid() + "-" + journalVO.getSysNo());
		mainVO.setDestination(getDestination(journalVO));

		return mainVO;
	}
	
	private AcctTransVO updateRoundingAndTax(AmountCalcViewVO amountCalcViewVO, AcctTransVO mainVO, List<AcctTransVO> journalCartList) throws BusinessException {
		List<String> nonClaimableTaxCode = gstDAO.getNonClaimableTaxList();
		
		BigDecimal ttlTaxDebit = new BigDecimal("0.00");
		BigDecimal ttlTaxCredit = new BigDecimal("0.00");
		BigDecimal ttlNCTaxDebit = new BigDecimal("0.00");
		BigDecimal ttlNCTaxCredit = new BigDecimal("0.00");
		
		for(AcctTransVO vo : journalCartList) {
			if (StringUtils.isNotEmpty(vo.getTaxCode()) && nonClaimableTaxCode.contains(vo.getTaxCode())) {
				if(vo.getCredit() != 0.00)
					ttlNCTaxCredit = ttlNCTaxCredit.add(new BigDecimal(String.valueOf(vo.getDTaxAmount())));
				else
					ttlNCTaxDebit = ttlNCTaxDebit.add(new BigDecimal(String.valueOf(vo.getDTaxAmount())));
			} else {
				if(vo.getCredit() != 0.00)
					ttlTaxCredit = ttlTaxCredit.add(new BigDecimal(String.valueOf(vo.getDTaxAmount())));
				else
					ttlTaxDebit = ttlTaxDebit.add(new BigDecimal(String.valueOf(vo.getDTaxAmount())));
			}
		}
		
		// You Yuan 2026.1.23
		// long story short, acctService.roundingAndTaxUpdateRfnd function will cause 
		// org.hibernate.exception.GenericJDBCException: Cannot open connection
		// Caused by: org.apache.tomcat.jdbc.pool.PoolExhaustedException: [http-nio-8080-exec-1] Timeout: Pool empty. Unable to fetch a connection in 10 seconds, none available[size:15; busy:15; idle:0; lastwait:10000].

		// Suspense GST
		AcctTransVO acctVO = new AcctTransVO();
		acctVO.setAcctId(amountCalcViewVO.getIdTaxAcct());
		acctVO.setType(CommonConstant.SYS_NUM_CD_TAX);
		acctVO.setDebit(ttlTaxDebit.doubleValue());
		acctVO.setCredit(ttlTaxCredit.doubleValue());
		acctService.roundingAndTaxUpdateRfnd(acctVO, mainVO);
		
		// Block/Non Claimable GST
		acctVO = new AcctTransVO();
		acctVO.setAcctId(amountCalcViewVO.getIdTaxNonClaimableAcct());
		acctVO.setType(CommonConstant.SYS_NUM_CD_NCT);
		acctVO.setDebit(ttlNCTaxDebit.doubleValue());
		acctVO.setCredit(ttlNCTaxCredit.doubleValue());
		acctService.roundingAndTaxUpdateRfnd(acctVO, mainVO);
		
		return mainVO;
	}
	
	@Override
