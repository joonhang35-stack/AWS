										<p:row rendered="#{empty custBean.passportIdVO.uploadedFile}">
											<p:column>
												<p:fileUpload id="idScannedCopy" fileUploadListener="#{custBean.handleFileUploadPassport}" mode="advanced" auto="true" sizeLimit="#{bterp:globalConfigValue('GLOBAL', 'PATH_PDF_FILE_SIZE')}" allowTypes="/(\.|\/)(pdf|jpg|jpeg|png)$/" description="*.pdf;*.jpg;*.jpeg" update="msg, :idEditCustForm:idPassportScannedCopy" oncomplete="varStatusDialog.hide()"/>
											</p:column>
										</p:row>
										<p:row rendered="#{not empty custBean.passportIdVO.uploadedFile}">
											<p:column style="width:15px;"><p:commandLink styleClass="ui-icon ui-icon-close" onclick="varDelScannedPassportDialog.show()"/></p:column>
											<p:column>
												<h:outputText value="#{custBean.passportIdVO.identityDetailVO.scannedPath}" rendered="#{empty custBean.passportIdVO.identityDetailVO.id}"/>
												<h:outputLink target="_blank" value="#{request.contextPath}#{custBean.destinationPassportPath}/#{custBean.passportIdVO.identityDetailVO.filePath}" rendered="#{not empty custBean.passportIdVO.identityDetailVO.id}">
													<h:outputText value="#{custBean.passportIdVO.identityDetailVO.scannedPath}"/>
												</h:outputLink>
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:column>
							</p:row>
							<p:row>
								<p:column>
									<p:commandButton value="Add ID"
										actionListener="#{custBean.setIdentityAdd(true)}"
										update=":idIDDialog" oncomplete="varIDDialog.show()"
										immediate="true" />
									<span class="required"> *</span>
								</p:column>
								<p:column colspan="3">
									<p:panel id="idIDListPanel" style="border:none">
										<p:dataTable id="idIDListTable"
											value="#{custBean.customerVO.identityList}" var="identityVO"
											rowKey="#{identityVO.idNo}" selectionMode="single"
											rendered="#{not empty custBean.customerVO.identityList}">
											<p:column headerText="Edit"
												style="width:50px; text-align:center;">
												<p:commandButton icon="ui-icon-pencil"
													actionListener="#{custBean.onIdentitySelected(identityVO)}"
													oncomplete="varIDDialog.show()" process="@this"
													update=":idIDDialog" rendered="#{identityVO.id eq null or not (custBean.passportIdVO.id eq identityVO.id or custBean.nricIdVO.id eq identityVO.id)}"/>
											</p:column>
											<p:column headerText="Delete"
												style="width:50px; text-align:center;">
												<p:commandButton icon="ui-icon-close"
													actionListener="#{custBean.deleteIdentity(identityVO)}"
													update=":idEditCustForm:idIDListPanel" process="@this"
													rendered="#{identityVO.id eq null or not (custBean.passportIdVO.id eq identityVO.id or custBean.nricIdVO.id eq identityVO.id)}"/>
											</p:column>
											<p:column headerText="ID Type">
												<h:outputText
													value="#{bterp:lookupItemDesc('id_type', identityVO.idType)}" />
											</p:column>
											<p:column headerText="ID No">
												<h:outputText value="#{identityVO.idNo}" />
											</p:column>
											<p:column headerText="Age" style="text-align:center;">
												<h:outputText value="#{custBean.calculateAgeByIdNo(identityVO.idNo)}" rendered="#{identityVO.idType == 'nric'}"/>
											</p:column>
											<p:column headerText="Expired Date" style="text-align:center;">
												<h:outputText value="#{identityVO.identityDetailVO.dtExpired}" rendered="#{not empty identityVO.identityDetailVO.dtExpired}">
													<f:convertDateTime pattern="dd-MMM-yyyy" />
												</h:outputText>
											</p:column>
											<p:column headerText="Attactment" style="width:80px; text-align:center;">
												<h:outputLink id="idTTIDAttachment" target="_blank" value="#{request.contextPath}#{identityVO.idType == 'visa' ? custBean.destinationVisaPath : custBean.destinationPassportPath}/#{identityVO.identityDetailVO.filePath}"
													style="color: #db3333;text-decoration: underline;"
													rendered="#{not empty identityVO.identityDetailVO.scannedPath and not empty identityVO.identityDetailVO.filePath}">
													<h:outputText value="View"/>
												</h:outputLink>
												<pe:tooltip for="idTTIDAttachment" shared="true" showDelay="3000"  position="top right"
													rendered="#{not empty identityVO.identityDetailVO.scannedPath and not empty identityVO.identityDetailVO.filePath}">
													<h:outputText value="#{identityVO.identityDetailVO.scannedPath}" escape="true" style="white-space: pre-wrap"/>
												</pe:tooltip>
											</p:column>
										</p:dataTable>
									</p:panel>
								</p:column>
							</p:row>
							
