<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui"
	xmlns:pe="http://primefaces.org/ui/extensions"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

	<p:growl id="msg" />
	<style>
	.phone-row {
	    display: flex;
	    align-items: center;
	    gap: 10px;
	}	
	</style>
	<script type="text/javascript">
		function onEditCustValidation(xhr, status, args) {
			if (!args.validationFailed) {
				varEditCustDialog.hide();
				varRefreshCustDetails.jq.click();
			}
		}
		function copyTextFromInput(paramValue) {
			var textToCopy = paramValue.split('[BR]').join('\n'); 
			//copy the text to the clipboard 
			navigator.clipboard.writeText(textToCopy);
		}
	</script>

	<div>
		<p:panelGrid id="idCustomerDetail">
			<p:row rendered="#{custBean.invPmntAuthVO.salesManager or custBean.invPmntAuthVO.operationsRole or custBean.invPmntAuthVO.asstSalesManager}">
				<p:column style="width:110px;">
					<h:outputLabel for="idCustLock"
						rendered="#{custBean.invPmntAuthVO.salesManager or salesBean.invPmntAuthVO.operationsRole or salesBean.invPmntAuthVO.asstSalesManager}">Customer Lock</h:outputLabel>
				</p:column>
				<p:column style="width:200px;">
					<p:selectBooleanButton label="Customer Lock" id="idCustLock" value="#{custBean.customerVO.isLock}"
						onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"
						rendered="#{salesBean.invPmntAuthVO.salesManager or salesBean.invPmntAuthVO.operationsRole or salesBean.invPmntAuthVO.asstSalesManager}"/>
					<pe:tooltip for="idCustLock">
						<h:outputText value="Lock or unlock customer information."/>
					</pe:tooltip>
				</p:column>
			</p:row>
			<p:row rendered="#{custBean.invPmntAuthVO.salesManager or custBean.invPmntAuthVO.operationsRole or custBean.invPmntAuthVO.asstSalesManager}">
				<p:column style="width:110px;">
					<h:outputLabel>Customer No</h:outputLabel>
				</p:column>
				<p:column style="width:200px;">
					<h:outputLabel value="#{custBean.customerVO.code}" style="font-weight:bold;"/>
				</p:column>
				<p:column style="width:110px;">
					<h:outputLabel rendered="#{custBean.customerPosting}">CRM Tier</h:outputLabel>
				</p:column>
				<p:column>
					<!-- <p:commandLink style="width:200px" rendered="#{custBean.customerPosting}" onclick="navigator.clipboard.writeText('#{custBean.customerVO.crmId}');" update="msg" actionListener="#{custBean.onCopyClick}">
						<h:outputLabel value="#{empty custBean.customerVO.crmId ? 'N/A' : custBean.customerVO.crmId}"/>
					</p:commandLink>
					<p:commandLink id="idCopyButton" rendered="#{custBean.customerPosting}" actionListener="#{custBean.onCopyClick}"
					onclick="navigator.clipboard.writeText('#{custBean.customerVO.crmId}');"
					update="msg" styleClass="ui-icon ui-icon-copy" global="false" style="display: inline-block;"
					process="@this"/> -->
					
					<h:outputLabel value="#{custBean.customerPointTierVO.tier}" rendered="#{custBean.customerPosting and not empty custBean.customerVO.crmId}"></h:outputLabel>
					<h:outputLabel value="N/A" rendered="#{custBean.customerPosting and empty custBean.customerVO.crmId}"></h:outputLabel>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idCustType">Customer Type <span
							class="required">*</span>
					</h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu id="idCustType" label="Customer Type"
						value="#{custBean.customerVO.pcTypeCd}" required="true"
						disabled="#{not custBean.customerVO.addEdit}">
						<f:selectItem itemLabel="Individual" itemValue="P" />
						<f:selectItem itemLabel="Corporate" itemValue="C" />
						<p:ajax event="change" listener="#{custBean.handleCustomerType}"
							update="idCustomerDetail,:idContactDialog" />
					</h:selectOneMenu>
				</p:column>
				<p:column rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
					<h:outputLabel for="idClassType">Class</h:outputLabel>
				</p:column>
				<p:column rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
					<p:selectCheckboxMenu id="idClassType"
						style="vertical-align:middle"
						value="#{custBean.customerVO.classList}" label="Class"
						filter="true" filterMatchMode="contains"
						onHide="executeOnClassOnhide();">
						<f:selectItems value="#{bterp:lookupItemList('cust_class')}"
							var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
					</p:selectCheckboxMenu>
					<p:remoteCommand name="executeOnClassOnhide"
						actionListener="#{custBean.handleClassChange}"
						update=":idEditCustForm:idClassName"
						process="@this, :idEditCustForm:idClassType" global="false" />
						
				</p:column>
				
				<p:column rendered="#{custBean.customerVO.pcTypeCd == 'C'}">
					<h:outputLabel for="idCompanyTIN">TIN <span
						class="required">*</span>
					</h:outputLabel>
				</p:column>
				<p:column rendered="#{custBean.customerVO.pcTypeCd == 'C'}">
					<p:inputText id="idCompanyTIN" label="TIN" required="true"
						value="#{custBean.customerVO.corporateVO.taxIdNo}" maxlength="20"
						disabled="#{not empty custBean.customerVO.corporateVO.taxIdNo and not custBean.customerVO.addEdit and custBean.customerVO.isLock}"
						validatorMessage="TIN shouldn't contain spaces.">
						<f:validateRegex pattern="^\S+$" />
						<p:ajax event="change" global="false"></p:ajax>
					</p:inputText>
				</p:column>
			</p:row>
			
			<p:row rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
				<p:column colspan="3">
					<h:outputLabel />
				</p:column>
				<p:column>
					<h:outputText id="idClassName" value="#{custBean.customerVO.className}" style="font-size:8px;"></h:outputText>
				</p:column>
			</p:row>
			
			<p:row rendered="#{custBean.customerVO.pcTypeCd == 'C'}">
				<p:column>
					<h:outputLabel for="idCompName">Company Name <span class="required">*</span>
					</h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<p:inputText id="idCompName" label="Company Name"
						value="#{custBean.customerVO.corporateName}" size="50" maxlength="255"
						required="true" disabled="#{not custBean.customerVO.addEdit and custBean.customerVO.isLock}">
						<p:ajax event="change" global="false"></p:ajax>
					</p:inputText>
				</p:column>
			</p:row>
	
			<p:row rendered="#{custBean.customerVO.pcTypeCd == 'C'}">
				<p:column>
					<h:outputLabel for="idRegNo">Registration No. (New) <span class="required">*</span></h:outputLabel>
				</p:column>
				<p:column>
					<p:inputText id="idRegNo" label="Registration No. (New)" required="true"
						value="#{custBean.customerVO.corporateVO.regNo}" maxlength="20"
						disabled="#{not empty custBean.customerVO.corporateVO.regNo and not custBean.customerVO.addEdit and custBean.customerVO.isLock}">
						<p:ajax event="change" global="false"></p:ajax>
					</p:inputText>
					
					&nbsp;
					<p:commandLink id="idFillNA" actionListener="#{custBean.corpRegNoFillNA(custBean.customerVO.corporateVO)}" 
						style="color: #db3333; text-decoration: underline;" update="idRegNo idCompanyTIN" process="@this">
						NA
					</p:commandLink>
					<pe:tooltip for="idFillNA" value="Click to autofill 'NA' into the Registration No. field" />
				</p:column>
				<p:column>
					<h:outputLabel for="idRegNoOld">Registration No. (Old)</h:outputLabel>
				</p:column>
				<p:column>
					<p:inputText id="idRegNoOld" label="Registration No. (Old)"
						value="#{custBean.customerVO.corporateVO.regNoOld}" maxlength="20"
						disabled="#{not empty custBean.customerVO.corporateVO.regNoOld and not custBean.customerVO.addEdit and custBean.customerVO.isLock}"/>
				</p:column>
			</p:row>
	
			<p:row rendered="#{custBean.customerVO.pcTypeCd == 'C'}">
				<p:column>
					<h:outputLabel for="idGstRegNo">GST Registration No.</h:outputLabel>
				</p:column>
				<p:column>
					<p:inputText id="idGstRegNo" label="GST Registration No." value="#{custBean.customerVO.corporateVO.gstRegNo}" maxlength="20"
						disabled="#{not empty custBean.customerVO.corporateVO.gstRegNo and not custBean.customerVO.addEdit and custBean.customerVO.isLock}"/>
				</p:column>
				<p:column>
					<h:outputLabel for="idSstRegNo">SST Registration No.</h:outputLabel>
				</p:column>
				<p:column>
					<p:inputText id="idSstRegNo" label="SST Registration No." value="#{custBean.customerVO.corporateVO.sstRegNo}"
						disabled="#{not empty custBean.customerVO.corporateVO.sstRegNo and not custBean.customerVO.addEdit and custBean.customerVO.isLock}"/>
				</p:column>
			</p:row>
			
			<p:row rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
				<p:column>
					<h:outputLabel for="idSalutate">Title <span class="required">*</span>
					</h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu id="idSalutate" label="Title" value="#{custBean.customerVO.personVO.salutation}" required="true"
						disabled="#{not empty custBean.customerVO.personVO.salutation and not custBean.customerVO.addEdit and custBean.customerVO.isLock}">
						<f:selectItem itemLabel="Select One" itemValue="" />
						<f:selectItems value="#{bterp:lookupItemList('salutatn2')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
					</h:selectOneMenu>
				</p:column>
				<p:column>
					<h:outputLabel for="idTitle">Honor</h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu id="idTitle" label="Honor" value="#{custBean.customerVO.personVO.title}">
						<f:selectItem itemLabel="Select One" itemValue="" />
						<f:selectItems value="#{bterp:lookupItemList('salutatn')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
					</h:selectOneMenu>
				</p:column>
			</p:row>
	
			<p:row rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
				<p:column>
					<h:outputLabel for="idLastName">SurName <span class="required">*</span>
					</h:outputLabel>
				</p:column>
				<p:column>
					<p:inputText id="idLastName" label="SurName" value="#{custBean.customerVO.personVO.lastName}" required="true"
						disabled="#{not empty custBean.customerVO.personVO.lastName and not custBean.customerVO.addEdit and custBean.customerVO.isLock}"
						validatorMessage="SurName cannot be empty or just spaces">
						<f:validateRegex pattern=".*\S.*" />
					</p:inputText>
				</p:column>
				<p:column>
					<h:outputLabel for="idGender">Gender</h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu id="idGender" label="Gender"
						value="#{custBean.customerVO.personVO.sex}">
						<f:selectItem itemLabel="Select One" itemValue="" />
						<f:selectItems value="#{bterp:lookupItemList('gender_type')}"
							var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}" />
					</h:selectOneMenu>
				</p:column>
			</p:row>
	
			<p:row rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
				<p:column>
					<h:outputLabel for="idGivenName">Given Name <span class="required">*</span></h:outputLabel>
				</p:column>
				<p:column>
					<p:inputText id="idGivenName" label="Given Name" value="#{custBean.customerVO.personVO.givenName}" required="true"
						disabled="#{not empty custBean.customerVO.personVO.givenName and not custBean.customerVO.addEdit and custBean.customerVO.isLock}"
						validatorMessage="Given Name cannot be empty or just spaces">
						<f:validateRegex pattern=".*\S.*" />
					</p:inputText>
				</p:column>
				<p:column>
					<h:outputLabel for="idNickName">NickName</h:outputLabel>
				</p:column>
				<p:column>
					<p:inputText id="idNickName" label="NickName" value="#{custBean.customerVO.personVO.nickName}" />
				</p:column>
			</p:row>
			
			<p:row rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
				<p:column>
					<h:outputLabel for="idNationality">Nationality <span class="required">*</span></h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu id="idNationality" label="Nationality"
						value="#{custBean.customerVO.personVO.countryId}" style="width:180px;" required="true">
						<p:ajax event="change" listener="#{custBean.handleNationalitySelected}" update="idTaxIdNo :idEditCustForm:idCity :idEditCustForm:idState" />
						<f:selectItem itemLabel="Select One" itemValue="" />
						<f:selectItems value="#{custBean.countryList}" var="vo"
							itemLabel="#{vo.country}" itemValue="#{vo.id}" />
					</h:selectOneMenu>
				</p:column>
				<p:column>
					<h:outputLabel for="idTaxIdNo">TIN</h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<p:inputText id="idTaxIdNo" label="TIN"
						value="#{custBean.customerVO.personVO.taxIdNo}" maxlength="20"
						disabled="#{not empty custBean.customerVO.personVO.taxIdNo and not custBean.customerVO.addEdit and custBean.customerVO.isLock}"
						validatorMessage="TIN shouldn't contain spaces.">
						<f:validateRegex pattern="^\S+$" />
					</p:inputText>
				</p:column>
			</p:row>
			
			<p:row rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
				<p:column>
					<h:outputLabel for="idNRIC">NRIC <span class="required">*</span></h:outputLabel>
				</p:column>
				<p:column>
					<p:inputMask id="idNRIC" label="NRIC" value="#{custBean.nricIdVO.idNo}" mask="999999-99-9999"
						disabled="#{not empty custBean.nricIdVO.idNo and not custBean.customerVO.addEdit and custBean.customerVO.isLock}">
						<p:ajax event="change" update=":idEditCustForm:idDOB,:idEditCustForm:idAge" listener="#{custBean.syncNRIC}"/>
					</p:inputMask>
				</p:column>
				<p:column>
					<h:outputLabel for="idPassportNo">Passport No <span class="required">*</span></h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<p:inputText id="idPassportNo" label="Passport No"
						value="#{custBean.passportIdVO.idNo}" maxlength="20" onkeypress="return rtnAlphaNumeric(event);"
						disabled="#{not empty custBean.passportIdVO.idNo and not custBean.customerVO.addEdit and custBean.customerVO.isLock}">
						<p:ajax event="change" update=":idEditCustForm:idPssprtNo" listener="#{custBean.syncPassportNo}"/>	
					</p:inputText>
				</p:column>
			</p:row>
	
			<p:row rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
				<p:column>
					<h:outputLabel for="idDOB">Date of Birth (DOB)</h:outputLabel>
				</p:column>
				<p:column>
					<p:calendar id="idDOB" label="Date of Birth"
						value="#{custBean.customerVO.personVO.dob}" navigator="true" showButtonPanel="true"
						yearRange="#{salesBean.yearRange}" pattern="dd-MMM-yyyy">
						<p:ajax event="dateSelect" listener="#{custBean.calculateAge}"
							update="idAge" global="false" />
					</p:calendar>
				</p:column>
				<p:column>
					<h:outputLabel for="idAge">Age</h:outputLabel>
				</p:column>
				<p:column>
					<p:inputText id="idAge" label="Age"
						value="#{custBean.customerVO.personVO.age}" size="3"
						readonly="true" />
				</p:column>
			</p:row>
	
			<p:row rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
				<p:column style="display:none">
					<h:outputLabel for="idUPoint">One Card Point</h:outputLabel>
				</p:column>
				<p:column style="display:none">
					<p:inputText id="idUPoint" label="One Card Point"
						value="#{custBean.customerVO.personVO.uPoint}" size="5" />
				</p:column>
				<p:column style="display:none">
					<h:outputLabel for="idApplePoint">Apple Voucher Point</h:outputLabel>
				</p:column>
				<p:column style="display:none">
					<p:inputText id="idApplePoint" label="Apple Voucher Point"
						value="#{custBean.customerVO.personVO.applePoint}" size="5" />
				</p:column>
			</p:row>
	
			<p:row rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
				<p:column>
					<h:outputLabel for="idSpokenLanguageList">Spoken Language</h:outputLabel>
				</p:column>
				<p:column>
					<p:selectCheckboxMenu id="idSpokenLanguageList"
						style="vertical-align:middle"
						value="#{custBean.customerVO.langCdList}" label="Spoken Language"
						filter="true" filterMatchMode="contains"
						onHide="executeOnLanguageOnhide();">
						<f:selectItems value="#{bterp:lookupItemList('lang_dilc')}"
							var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
					</p:selectCheckboxMenu>
					<p:remoteCommand name="executeOnLanguageOnhide"
						actionListener="#{custBean.handleLanguageChange}"
						update=":idEditCustForm:idLanguageName"
						process="@this, :idEditCustForm:idSpokenLanguageList"
						global="false" />
				</p:column>
				<p:column>
					<h:outputLabel for="idRace">Race</h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu id="idRace" label="Race"
						value="#{custBean.customerVO.personVO.race}">
						<f:selectItem itemLabel="Select One" itemValue="" />
						<f:selectItems value="#{bterp:lookupItemList('race_type')}"
							var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}" />
					</h:selectOneMenu>
				</p:column>
			</p:row>
	
			<p:row rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
				<p:column>
					<h:outputLabel />
				</p:column>
				<p:column>
					<h:outputText id="idLanguageName" value="#{custBean.customerVO.languageName}" style="font-size:8px;"></h:outputText>
				</p:column>
				<p:column>
					<h:outputLabel />
				</p:column>
				<p:column style="width:100px"></p:column>
			</p:row>
	
			<p:row rendered="#{custBean.customerVO.pcTypeCd == 'C'}">
				<p:column colspan="4">
					<p:panel id="idPanelPic" header="Person in Charge" toggleable="true">
						<p:panelGrid>
							<p:row>
								<p:column>
									<p:commandButton value="Add" actionListener="#{custBean.addPic}" update=":idEditCustForm:idPanelPic" process="@this" global="false"/>
								</p:column>
							</p:row>
							<p:row>
								<p:column>
									<p:fieldset id="idPicPrimary" legend="Primary PIC">
										<p:panelGrid>
											<p:row>
												<p:column>
													<h:outputLabel for="idSalutatePIC">Title <span class="required">*</span>
													</h:outputLabel>
												</p:column>
												<p:column>
													<h:selectOneMenu id="idSalutatePIC" label="Title" value="#{custBean.customerVO.personVO.salutation}" required="true">
														<p:ajax event="change" global="false"/>
														<f:selectItem itemLabel="Select One" itemValue="" />
														<f:selectItems value="#{bterp:lookupItemList('salutatn2')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
													</h:selectOneMenu>
												</p:column>
												<p:column>
													<h:outputLabel for="idTitlePIC">Honor</h:outputLabel>
												</p:column>
												<p:column>
													<h:selectOneMenu id="idTitlePIC" label="Honor" value="#{custBean.customerVO.personVO.title}">
														<p:ajax event="change" global="false"/>
														<f:selectItem itemLabel="Select One" itemValue="" />
														<f:selectItems value="#{bterp:lookupItemList('salutatn')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
													</h:selectOneMenu>
												</p:column>
											</p:row>
											<p:row>
												<p:column>
													<h:outputLabel for="idLastNamePIC">SurName <span class="required">*</span>
													</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idLastNamePIC" label="SurName" value="#{custBean.customerVO.personVO.lastName}" required="true" validatorMessage="SurName cannot be empty or just spaces">
														<p:ajax event="change" global="false"/>
														<f:validateRegex pattern=".*\S.*" />
													</p:inputText>
												</p:column>
												<p:column>
													<h:outputLabel for="idGenderPIC">Gender</h:outputLabel>
												</p:column>
												<p:column>
													<h:selectOneMenu id="idGenderPIC" label="Gender" value="#{custBean.customerVO.personVO.sex}">
														<p:ajax event="change" global="false"/>
														<f:selectItem itemLabel="Select One" itemValue="" />
														<f:selectItems value="#{bterp:lookupItemList('gender_type')}"
															var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}" />
													</h:selectOneMenu>
												</p:column>
											</p:row>
											<p:row>
												<p:column>
													<h:outputLabel for="idGivenNamePIC">Given Name <span class="required">*</span>
													</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idGivenNamePIC" label="Given Name" value="#{custBean.customerVO.personVO.givenName}" required="true" validatorMessage="Given Name cannot be empty or just spaces">
														<p:ajax event="change" global="false"/>
														<f:validateRegex pattern=".*\S.*" />
													</p:inputText>
												</p:column>
												<p:column>
													<h:outputLabel for="idNickNamePIC">NickName</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idNickNamePIC" label="NickName" value="#{custBean.customerVO.personVO.nickName}">
														<p:ajax event="change" global="false"/>
													</p:inputText>
												</p:column>
											</p:row>
										</p:panelGrid>
									</p:fieldset>
								</p:column>
							</p:row>
							<c:forEach var="picVO" items="#{custBean.customerVO.corPicList}" varStatus="loop">
								<p:row>
									<p:column>
										<p:fieldset id="idPic#{loop.index}" legend="PIC #{loop.index + 1}">
											<p:panelGrid>
												<p:row>
													<p:column>
														<h:outputLabel for="idSalutatePIC#{loop.index}">Title <span class="required">*</span></h:outputLabel>
													</p:column>
													<p:column>
														<h:selectOneMenu id="idSalutatePIC#{loop.index}" label="Title" value="#{picVO.salutation}" required="true">
															<p:ajax event="change" global="false"/>
															<f:selectItem itemLabel="Select One" itemValue="" />
															<f:selectItems value="#{bterp:lookupItemList('salutatn2')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
														</h:selectOneMenu>
														&nbsp;
														<p:commandButton icon="ui-icon-close" value="Remove" styleClass="ui-state-error" actionListener="#{custBean.deletePic(picVO)}" update=":idEditCustForm:idPanelPic" process="@this"/>
													</p:column>
													<p:column>
														<h:outputLabel for="idTitlePIC#{loop.index}">Honor</h:outputLabel>
													</p:column>
													<p:column>
														<h:selectOneMenu id="idTitlePIC#{loop.index}" label="Honor" value="#{picVO.title}">
															<p:ajax event="change" global="false"/>
															<f:selectItem itemLabel="Select One" itemValue="" />
															<f:selectItems value="#{bterp:lookupItemList('salutatn')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
														</h:selectOneMenu>
													</p:column>
												</p:row>
												<p:row>
													<p:column>
														<h:outputLabel for="idLastNamePIC#{loop.index}">SurName <span class="required">*</span>
														</h:outputLabel>
													</p:column>
													<p:column>
														<p:inputText id="idLastNamePIC#{loop.index}" label="SurName" value="#{picVO.lastName}" required="true">
															<p:ajax event="change" global="false"/>
														</p:inputText>
													</p:column>
													<p:column>
														<h:outputLabel for="idGenderPIC#{loop.index}">Gender</h:outputLabel>
													</p:column>
													<p:column>
														<h:selectOneMenu id="idGenderPIC#{loop.index}" label="Gender" value="#{picVO.sex}">
															<p:ajax event="change" global="false"/>
															<f:selectItem itemLabel="Select One" itemValue="" />
															<f:selectItems value="#{bterp:lookupItemList('gender_type')}"
																var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}" />
														</h:selectOneMenu>
													</p:column>
												</p:row>
												<p:row>
													<p:column>
														<h:outputLabel for="idGivenNamePIC#{loop.index}">Given Name <span class="required">*</span>
														</h:outputLabel>
													</p:column>
													<p:column>
														<p:inputText id="idGivenNamePIC#{loop.index}" label="Given Name" value="#{picVO.givenName}" required="true">
															<p:ajax event="change" global="false"/>
														</p:inputText>
													</p:column>
													<p:column>
														<h:outputLabel for="idNickNamePIC#{loop.index}">NickName</h:outputLabel>
													</p:column>
													<p:column>
														<p:inputText id="idNickNamePIC#{loop.index}" label="NickName" value="#{picVO.nickName}">
															<p:ajax event="change" global="false"/>
														</p:inputText>
													</p:column>
												</p:row>
												<p:row>
													<p:column>
														<h:outputLabel for="idOfficeNoPIC#{loop.index}">Office No</h:outputLabel>
													</p:column>
													<p:column colspan="3">
														<p:inputText id="idOfficeNoPIC#{loop.index}" label="Office No" value="#{picVO.officeNo}" maxlength="14" onkeypress="return rtnPhoneNo(event);">
															<p:ajax event="change" global="false"/>
															<p:watermark for="idOfficeNoPIC#{loop.index}" value="Number"/>
														</p:inputText>
														<h:outputLabel for="idOfficeExtPIC#{loop.index}">Ext </h:outputLabel>
														<p:inputText id="idOfficeExtPIC#{loop.index}" label="Office Extension" value="#{picVO.officeExt}" size="4" maxlength="4">
															<pe:keyFilter regEx="/[\d]/"/>
															<p:ajax event="change" global="false"/>
														</p:inputText>
													</p:column>
												</p:row>
												<p:row>
													<p:column>
														<h:outputLabel for="idEmailPIC#{loop.index}">Email Address</h:outputLabel>
													</p:column>
													<p:column>
														<p:inputText id="idEmailPIC#{loop.index}" label="Email Address" value="#{picVO.email}" maxlength="50" validatorMessage="Invalid email format">
															<p:ajax event="change" global="false"/>
															<f:validateRegex pattern="#{config['email.format.pattern']}" />
														</p:inputText>
													</p:column>
													<p:column>
														<h:outputLabel for="idMobileNoPIC#{loop.index}">Mobile No</h:outputLabel>
													</p:column>
													<p:column>
														<p:inputText id="idMobileNoPIC#{loop.index}" label="Mobile No" value="#{picVO.mobileNo}" maxlength="14" onkeypress="return rtnPhoneNo(event);">
															<p:ajax event="change" global="false"/>
															<p:watermark for="idMobileNoPIC#{loop.index}" value="Number"/>
														</p:inputText>
													</p:column>
												</p:row>
											</p:panelGrid>
										</p:fieldset>
									</p:column>
								</p:row>
							</c:forEach>
						</p:panelGrid>
					</p:panel>
				
				
