														value="#{custBean.personContactVO.perMobileNumber}"
														maxlength="14" size="20"
														onkeypress="return rtnPhoneNo(event);"
														validatorMessage="Contact number must contain only digits, and be at least 8 characters long.">
														<p:watermark for="idMobileNumber" value="Number" />
														<f:validateLength maximum="14" minimum="8"/>
														<f:validateRegex pattern="^[0-9]+$" />
													</p:inputText>
												</p:column>
											</p:row>
