													<f:validateLength maximum="5" />
												</p:inputText> -->
													<p:selectOneMenu id="idMobileCountry" value="#{custBean.personContactVO.perMobileCountryId}" style="width:120px" filter="true" filterMatchMode="contains">
												        
												        <f:selectItems value="#{custBean.countryList}"  var="c" itemValue="#{c.id}" itemLabel="#{c.countryCd} #{c.country}"/>
												    </p:selectOneMenu>
													<!-- <h:outputLabel> - </h:outputLabel> -->
