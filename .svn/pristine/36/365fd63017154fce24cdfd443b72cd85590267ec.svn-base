							<p:row>
								<p:column colspan="2">
									<p:panel id="idPanelEmail" header="Email" toggleable="true">
										<p:panelGrid>
											<p:row>
												<p:column>
													<h:outputLabel for="idEmail">Primary Email </h:outputLabel>
												</p:column>
												<p:column colspan="3">
													<p:inputText id="idEmail" label="Email"
														value="#{custBean.customerVO.personVO.email}" readonly="true"
														style="background:#ccc;" size="40" />	
												</p:column>
											</p:row>
						
											<p:row>
												<p:column>
													<p:commandButton value="Email List"
														actionListener="#{custBean.onAddEmail()}"
														oncomplete="varEmailDialog.show()"
														update=":idEmailDialog" process="@this" />
												</p:column>
												<p:column colspan="3">
													<p:panel id="idEmailListPanel" style="border:none">
														<p:dataTable id="idEmailListTable"
															value="#{custBean.customerVO.personVO.emailList}"
															var="emailVO"
															rendered="#{not empty custBean.customerVO.personVO.emailList}">
															<p:column headerText="Edit"
																style="width:50px; text-align:center;">
																<p:commandButton icon="ui-icon-pencil"
																	actionListener="#{custBean.onEmailSelected(emailVO)}"
																	oncomplete="varEmailDialog.show()" process="@this"
																	update=":idEmailDialog"
																	disabled="#{not custBean.customerVO.addEdit and custBean.customerVO.isLock and emailVO.isPrimary}"/>
															</p:column>
															<p:column headerText="Delete"
																style="width:50px; text-align:center;">
																<p:commandButton icon="ui-icon-close"
																	actionListener="#{custBean.deleteEmail(emailVO)}"
																	update=":idEditCustForm:idEmailListPanel,:idEditCustForm:idEmailListTable,:idEditCustForm:idEmail"
																	process="@this"
																	disabled="#{not custBean.customerVO.addEdit and custBean.customerVO.isLock and emailVO.isPrimary}"/>
															</p:column>
															<p:column headerText="Email">
																<h:outputText value="#{emailVO.email}" />
															</p:column>
															<p:column headerText="Primary Email" style="text-align:center;">
																<h:outputText value="Y" rendered="#{emailVO.isPrimary}" />
																<h:outputText value="N" rendered="#{not emailVO.isPrimary}" />
															</p:column>
														</p:dataTable>
													</p:panel>
												</p:column>
											</p:row>
										</p:panelGrid>
									</p:panel>
								</p:column>
							</p:row>
							
