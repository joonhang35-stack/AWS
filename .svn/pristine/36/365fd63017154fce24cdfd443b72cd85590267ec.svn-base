										<f:selectItems value="#{custBean.countryList}" var="vo" itemLabel="#{vo.country}" itemValue="#{vo.id}" />  
						            </h:selectOneMenu>
								</p:column>
							</p:row>
							<p:row>
								<p:column>
									<h:outputLabel>Scanned Copy</h:outputLabel>
								</p:column>
