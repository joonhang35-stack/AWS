												</p:column>
											</p:row>
											<p:row rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
												<p:column style="width:115px;">
													<h:outputLabel for="idRegister">Register</h:outputLabel>
												</p:column>
												<p:column>
													<p:selectBooleanButton id="idRegister" value="#{not empty custBean.crmMembershipVO.id}" onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close" disabled="true"/>
												</p:column>
											</p:row>
											<p:row rendered="#{not empty custBean.crmMembershipVO.id}">
												<p:column>
													<h:outputLabel for="idKeycloak">Keycloak ID</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idKeycloak" label="Keycloak" value="#{custBean.crmMembershipVO.keycloakId}"/>
												</p:column>
											</p:row>
											<p:row rendered="#{not empty custBean.crmMembershipVO.id}">
												<p:column>
													<h:outputLabel for="idKeycloakUserName">Keycloak User Name</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idKeycloakUserName" label="KeycloakUserName" value="#{custBean.crmMembershipVO.keycloakUsername}"/>
												</p:column>
											</p:row>
											<p:row rendered="#{not empty custBean.crmMembershipVO.id}">
												<p:column>
													<h:outputLabel for="idKeycloakEmail">Keycloak Email</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idKeycloakEmail" label="KeyCloakEmail" value="#{custBean.crmMembershipVO.email}"/>
												</p:column>
											</p:row>
											<p:row rendered="#{not empty custBean.crmMembershipVO.id}">
												<p:column>
													<h:outputLabel for="idKeycloakCreatedDate">Keycloak Created Date</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idKeycloakCreatedDate" label="KeycloakCreatedDate" value="#{custBean.crmMembershipVO.createdDate}">
														<f:convertDateTime pattern="dd-MM-yyyy HH:mm:ss"/>
													</p:inputText>
												</p:column>
											</p:row>
										</p:panelGrid>
									</p:panel>
								</p:column>
							</p:row>
						</p:panelGrid>
					</p:panel>
				</p:column>
			</p:row>
			<p:row rendered="#{custBean.customerVO.pcTypeCd != 'C' and !custBean.hideCRM}">
				<p:column colspan="4">
					<p:panel id="idPanelMemberPoint" header="Member Point Information" toggleable="true">
						<p:panelGrid>
							<p:row>
								<p:column colspan="2">
									<p:panel id="idPanelPoint" header="Point And Tier">
										<p:panelGrid>
											<p:row>
												<p:column>
													<h:outputLabel for="idPoint">Point</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idPoint" label="Point" readonly="true" style="background:#ccc;"
														value="#{custBean.customerPointTierVO.totalPointsBalance}" maxlength="50" />
												</p:column>
												<p:column>
													<h:outputLabel for="idTier">Tier </h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idTier" label="Tier" readonly="true" style="background:#ccc;"
														value="#{custBean.customerPointTierVO.tier}" maxlength="50" />
												</p:column>
											</p:row>
											<p:row>
												<p:column>
													<h:outputLabel for="idTargetSales">Target Sales</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idTargetSales" label="Target Sales" readonly="true" style="background:#ccc;"
														value="#{custBean.customerPointTierVO.targetSales}" maxlength="50" />
												</p:column>
											</p:row>
											<p:row>
												<p:column>
													<h:outputLabel for="idCurrentSales">Current Sales</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idCurrentSales" label="Current Sales" readonly="true" style="background:#ccc;"
														value="#{custBean.customerPointTierVO.currentSales}" maxlength="50" />
												</p:column>
												<p:column>
													<h:outputLabel for="idCurrentSales">Remaining Sales</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idRemainingSales" label="Remaining Sales" readonly="true" style="background:#ccc;"
														value="#{custBean.customerPointTierVO.remainingSales}" maxlength="50"/>
												</p:column>
											</p:row>
											<p:row>
												<p:column>
													<h:outputLabel for="idTierEF">Tier Effective From</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idTierEF" label="Tier Effective From" readonly="true" style="background:#ccc;"
														value="#{custBean.customerPointTierVO.tierEffectiveFrom}" maxlength="50"/>
												</p:column>
												<p:column>
													<h:outputLabel for="idTierET">Tier Effective To</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idTierET" label="Tier Effective To" readonly="true" style="background:#ccc;"
														value="#{custBean.customerPointTierVO.tierEffectiveTo}" maxlength="50"/>
												</p:column>
											</p:row>
											<p:row>
												<p:column>
													<h:outputLabel for="idPointE">Point Expiry Date</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputTextarea id="idPointE" value="#{custBean.pointExpiry}" readonly="true" style="background:#ccc; width:250px; resize:none;" rows="3"/>
												</p:column>
											</p:row>
											<p:row>
												<p:column>
													<p:commandButton icon="ui-icon-refresh" value="Refresh" action="#{custBean.handleCustomerPointTier(custBean.customerVO.id)}" update="idPanelMemberPoint" process="@this"/>
												</p:column>
											</p:row>
										</p:panelGrid>
									</p:panel>
								</p:column>
							</p:row>
							<p:row>
								<p:column colspan="2">
									<p:panel id="idPanelVoucher" header="Claimed Voucher">
										<p:commandButton value="Add Voucher" icon="ui-icon-plus" actionListener="#{custBean.handleVoucherCatalog}" update=":idVoucherCatalogForm" oncomplete="varVoucherCatalogDialog.show()"/>&nbsp;
										<p:commandButton value="History" icon="ui-icon-script" actionListener="#{custBean.handleCustomerVoucherHistory(custBean.customerVO.id)}" update=":idVoucherHistoryForm" oncomplete="varVoucherHistoryDialog.show()"/>
										<br/><br/>
										<p:dataTable id="idClaimedVoucherListTable" value="#{custBean.customerVO.claimedVoucherList}" var="voucherVO">
											
											<!-- <p:column headerText="Edit"
												style="width:50px; text-align:center;">
												<p:commandButton icon="ui-icon-pencil"
													actionListener="#{salesBean.onIdentitySelected(identityVO)}"
													oncomplete="varIDDialog.show()" process="@this"
													update=":idIDDialog" rendered="#{identityVO.id eq null or not (salesBean.passportIdVO.id eq identityVO.id or salesBean.nricIdVO.id eq identityVO.id)}"/>
											</p:column>
											<p:column headerText="Delete"
												style="width:50px; text-align:center;">
												<p:commandButton icon="ui-icon-close"
													actionListener="#{salesBean.deleteIdentity(identityVO)}"
													update=":idAddCustForm:idIDListPanel" process="@this"
													rendered="#{identityVO.id eq null or not (salesBean.passportIdVO.id eq identityVO.id or salesBean.nricIdVO.id eq identityVO.id)}"/>
											</p:column> -->
											<p:column headerText="Code">
												<p:outputLabel id="idVoucher">
						 							<i class="fa fa-info-circle" aria-hidden="true" />
						 						</p:outputLabel>
												<h:outputText value=" #{voucherVO.redemptionCode}" />
												<pe:tooltip for="idVoucher" shared="true" showDelay="300" targetPosition="top left" position="bottom right">
										        <h:panelGrid columns="2">
										            <h:outputText value="Name:" /><h:outputText value="#{voucherVO.redemptionType.name}" />
										            <h:outputText value="Redemption ID:" /><h:outputText value="#{voucherVO.redemptionType.redemptionId}" />
										            <h:outputText value="Category:" /><h:outputText value="#{voucherVO.redemptionType.categoryName}" />
										            <h:outputText value="Category Type:" /><h:outputText value="#{voucherVO.redemptionType.categoryType}" />
													<h:outputText value="Category Desc:" /><h:outputText value="#{voucherVO.redemptionType.categoryDesc}" />
										            <h:outputText value="Description:" /><h:outputText value="#{voucherVO.redemptionType.description}" />
													<h:outputText value="Min Points:" /><h:outputText value="#{voucherVO.redemptionType.minPoints}" />
													<h:outputText value="Max Points:" /><h:outputText value="#{voucherVO.redemptionType.maxPoints}" />
													<h:outputText value="Min Sales:" /><h:outputText value="#{voucherVO.redemptionType.minSales}" />
													<h:outputText value="Max Sales:" /><h:outputText value="#{voucherVO.redemptionType.maxSales}" />
													<h:outputText value="Conversion Points:" /><h:outputText value="#{voucherVO.redemptionType.conversionPoints}" />
													<h:outputText value="Conversion Rebate Amt:" /><h:outputText value="#{voucherVO.redemptionType.conversionRebateAmt}" />
													<h:outputText value="Discount Amt:" /><h:outputText value="#{voucherVO.redemptionType.discountAmt}" />
													<h:outputText value="Percentage:" /><h:outputText value="#{voucherVO.redemptionType.percentage}" />
													<h:outputText value="Max Discount Capped:" /><h:outputText value="#{voucherVO.redemptionType.maxDiscountCapped}" />
													<h:outputText value="Expiry Days:" /><h:outputText value="#{voucherVO.redemptionType.expiryDays}" />
													<h:outputText value="Expiry End of Month:" /><h:outputText value="#{voucherVO.redemptionType.isExpiryEndOfMonth ? 'Yes' : 'No'}" />
													<h:outputText value="Effective From:" /><h:outputText value="#{voucherVO.redemptionType.effectiveFrom}" />
													<h:outputText value="Effective Until:" /><h:outputText value="#{voucherVO.redemptionType.effectiveUntil}" />
													<h:outputText value="Currency:" /><h:outputText value="#{voucherVO.redemptionType.currency}" />
													<h:outputText value="Active:" /><h:outputText value="#{voucherVO.redemptionType.isActive ? 'Yes' : 'No'}" />
										        </h:panelGrid>				
										    </pe:tooltip>
											</p:column>
											<p:column headerText="Category">
												<h:outputText value="#{voucherVO.referenceType}" />
											</p:column>
											<p:column headerText="Value">
												<!-- Cash Voucher -->
												<h:outputText value="RM#{voucherVO.discountAmt}" rendered="#{voucherVO.referenceType eq 'Cash'}" />
												
												<!-- Discount Voucher -->
												<h:outputText value="-" rendered="#{voucherVO.referenceType eq 'Discount'}" />
												
												<!-- Merchandise Voucher -->
												<h:outputText value="-" rendered="#{voucherVO.referenceType eq 'Merchandise'}" />
												
												<!-- Rebate Voucher -->
												<h:outputText value="RM#{voucherVO.discountAmt}" rendered="#{voucherVO.referenceType eq 'Rebate'}" />
											</p:column>
											<p:column headerText="Expiry Date">
												<h:outputText value="#{voucherVO.expiryDate}" />
											</p:column>
											<p:column headerText="Redeemed Date">
												<h:outputText value="#{voucherVO.redeemedDateTime}" />
											</p:column>
											<p:column headerText="Remarks">
												<!-- Cash Voucher -->
												<h:outputText value="" rendered="#{voucherVO.referenceType eq 'Cash'}" />
												
												<!-- Discount Voucher -->
												<h:outputText value="" rendered="#{voucherVO.referenceType eq 'Discount'}" />
												
												<!-- Merchandise Voucher -->
												<h:outputText value="" rendered="#{voucherVO.referenceType eq 'Merchandise'}" />
												
												<!-- Rebate Voucher -->
												<h:outputText value="" rendered="#{voucherVO.referenceType eq 'Rebate'}" />
											</p:column>
										</p:dataTable>
									</p:panel>
								</p:column>
							</p:row>
						</p:panelGrid>
					</p:panel>
				</p:column>
			</p:row>
			<p:row>
				<p:column>
					<h:outputLabel for="idRemarks">Notes</h:outputLabel>
				</p:column>
				<p:column colspan="3">
					<p:inputTextarea id="idRemarks" rows="10" cols="50"
						value="#{custBean.remarksVO.remarksDetails}"></p:inputTextarea>
				</p:column>
			</p:row>
		</p:panelGrid>
	</div>

	<h:panelGrid columns="2" style="width: 1px;">
		<!--h:inputHidden id="idHiddenValue">
		<f:ajax event="change" listener="#{custBean.setCustDetailsVO(custBean.custDetailsVO)}"/>
	</h:inputHidden-->
		<p:commandButton value="#{msg['common.button.label.save']}"
			actionListener="#{custBean.addCustomer}"
			oncomplete="onEditCustValidation(xhr, status, args)" update="@form"
			rendered="#{empty custBean.customerVO.id}" />
		<p:commandButton value="#{msg['common.button.label.update']}"
			actionListener="#{custBean.updateCustomer}" update="@form"
			oncomplete="onEditCustValidation(xhr, status, args)"
			rendered="#{not empty custBean.customerVO.id}">
			<!--f:setPropertyActionListener target="#{custBean.setCustDetailsVO}" value="#{custBean.custDetailsVO}"/-->
		</p:commandButton>
		<p:commandButton value="#{msg['common.button.label.cancel']}"
			actionListener="#{custBean.resetForm}" update="@form" process="@this"
			oncomplete="varEditCustDialog.hide()" global="false">
			<pe:resetEditableValues for="idEditCustForm" />
		</p:commandButton>
	</h:panelGrid>

</ui:composition>