														value="#{custBean.customerVO.personVO.ecGivenName}" maxlength="50" />
												</p:column>
											</p:row>
											
											<p:row>
												<p:column>
													<h:outputLabel for="idNumber">Contact Number </h:outputLabel>
												</p:column>
												<p:column styleClass="phone-row">
													<p:selectOneMenu id="idECCountry" value="#{custBean.customerVO.personVO.ecIdCountryCd}" style="width:120px" filter="true" filterMatchMode="contains">
												        <f:selectItems value="#{custBean.countryList}"  var="c" itemValue="#{c.id}" itemLabel="#{c.countryCd} #{c.country}"/>
												    </p:selectOneMenu>
													<p:inputText id="idECContacts" label="Number" style="width:139px"
														value="#{custBean.customerVO.personVO.ecContacts}"
														maxlength="14" size="20"
														onkeypress="return rtnPhoneNo(event);"
														validatorMessage="Contact number must contain only digits, and be at least 8 characters long.">
														<p:watermark for="idECContacts" value="Number" />
														<f:validateLength maximum="14" />
														<f:validateRegex pattern="^[0-9]+$" />
													</p:inputText>
												</p:column>
												<p:column>
													<h:outputLabel for="idECRelationship">Relationship </h:outputLabel>
												</p:column>
												<p:column>
													<h:selectOneMenu id="idECRelationship" label="Emergency Contact Relationship"
														value="#{custBean.customerVO.personVO.ecRelationship}">
														<f:selectItem itemLabel="Select One" itemValue="" />
														<f:selectItems value="#{bterp:lookupItemList('emergency_relationship')}"
															var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}" />
													</h:selectOneMenu>
												</p:column>
											</p:row>
					
											<p:row>
												<p:column>
													<h:outputLabel for="idECEmail">Email </h:outputLabel>
												</p:column>
												<p:column colspan="3">
													<p:inputText id="idECEmail" label="Emergency Contact Email"
														value="#{custBean.customerVO.personVO.ecEmail}" maxlength="200" size="40" />
												</p:column>
											</p:row>
										</p:panelGrid>
									</p:panel>
								</p:column>
							</p:row>
						</p:panelGrid>
					</p:panel>
				</p:column>
			</p:row>
	
			<p:row rendered="#{custBean.customerVO.pcTypeCd != 'C'}">
