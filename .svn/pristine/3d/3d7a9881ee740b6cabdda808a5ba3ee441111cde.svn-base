<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
				xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">
	<p:tabView id="idTab">
		<p:tab id="idTabList" title="Package Info">
			<p:panel header="#{salesBean.tourPkgVO.numDays}D/#{salesBean.tourPkgVO.numNights}N #{salesBean.tourPkgVO.nameEn} #{salesBean.tourPkgVO.nameZh} #{salesBean.tourPkgVO.nameOther}" style="border:0;">
				<div style="width:100%; height:450px; overflow:auto;">
				<h:outputText value="#{fn:replace(salesBean.tourPkgVO.highLight, '\\n', '&lt;br/&gt;')}" escape="false"/>
				<br/>
				<h:outputText value="Full Tour Price" style="font-weight:bold;"/>
				<div class="ui-datatable ui-widget">
					<table>
						<thead>
							<tr>
								<th colspan="2" class="ui-state-default" style="padding:5px;"><h:outputText value="ADULT (RM)"/></th>
								<th colspan="3" class="ui-state-default"><h:outputText value="CHILD (RM)"/></th>
							</tr>
							<tr>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="TWN"/></th>
								<th class="ui-state-default"><h:outputText value="SGL"/></th>
								<th class="ui-state-default"><h:outputText value="CTW"/></th>
								<th class="ui-state-default"><h:outputText value="CWB"/></th>
								<th class="ui-state-default"><h:outputText value="CNB"/></th>
							</tr>
						</thead>
						<tbody class="ui-datatable-data ui-widget-content">
							<tr>
								<td style="text-align:center; padding:5px;"><h:outputText value="#{salesBean.tourDepVO.fullTwn}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.fullSgl}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.fullCtw}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.fullCeb}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.fullCnb}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
							</tr>
						</tbody>
					</table>
				</div>
				<h:outputText value="Full Remarks (Departure)" style="font-weight:bold;"/>
					<br/>
					<h:outputText
						value="#{fn:replace(salesBean.tourDepVO.fullRemarks, '\\n', '&lt;br/&gt;')}"
						escape="false" style="font-size:10px;"
						rendered="#{not empty salesBean.tourDepVO.fullRemarks}" />
					<br /><br />
					<h:outputText value="Full Remarks (Package)" style="font-weight:bold;"/>
					<br/>
					<h:outputText
						value="#{fn:replace(salesBean.tourPkgVO.fullRemarks, '\\n', '&lt;br/&gt;')}"
						escape="false" style="font-size:10px;"
						rendered="#{not empty salesBean.tourPkgVO.fullRemarks}" />
					<br /> <br />
				<h:outputText value="Ground Only Price" style="font-weight:bold;"/>
				<div class="ui-datatable ui-widget">
					<table>
						<thead>
							<tr>
								<th colspan="2" class="ui-state-default" style="padding:5px;"><h:outputText value="ADULT (RM)"/></th>
								<th colspan="3" class="ui-state-default"><h:outputText value="CHILD (RM)"/></th>
							</tr>
							<tr>
								<th class="ui-state-default" style="padding:5px;"><h:outputText value="TWN"/></th>
								<th class="ui-state-default"><h:outputText value="SGL"/></th>
								<th class="ui-state-default"><h:outputText value="CTW"/></th>
								<th class="ui-state-default"><h:outputText value="CWB"/></th>
								<th class="ui-state-default"><h:outputText value="CNB"/></th>
							</tr>
						</thead>
						<tbody class="ui-datatable-data ui-widget-content">
							<tr>
								<td style="text-align:center; padding:5px;"><h:outputText value="#{salesBean.tourDepVO.grndTwn}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.grndSgl}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.grndCtw}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.grndCeb}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.grndCnb}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
							</tr>
						</tbody>
					</table>
				</div>
				<h:outputText value="Ground Remarks (Departure)" style="font-weight:bold;"/>
					<br/>
					<h:outputText
						value="#{fn:replace(salesBean.tourDepVO.grndRemarks, '\\n', '&lt;br/&gt;')}"
						escape="false" style="font-size:10px;"
						rendered="#{not empty salesBean.tourDepVO.grndRemarks}" />
					<br /><br />
					<h:outputText value="Ground Remarks (Package)" style="font-weight:bold;"/>
					<br/>
					<h:outputText
						value="#{fn:replace(salesBean.tourPkgVO.grndRemarks, '\\n', '&lt;br/&gt;')}"
						escape="false" style="font-size:10px;"
						rendered="#{not empty salesBean.tourPkgVO.grndRemarks}" />
					<br /> <br />
				<h:outputText value="Airline" style="font-weight:bold;"/>
				<div class="ui-datatable ui-widget">
					<table>
						<thead>
							<tr>
								<th class="ui-state-default" style="padding:5px;">Airline</th>
								<th class="ui-state-default" style="padding:5px;">Visa</th>
								<th class="ui-state-default" style="padding:5px;">A/C</th>
								<th class="ui-state-default" style="padding:5px;">Tipping</th>
								<th class="ui-state-default" style="padding:5px;">**Others</th>
								<th class="ui-state-default" style="padding:5px;">APT Tax<br/>(Adult/Child)</th>
								<th class="ui-state-default" style="padding:5px;">YQ &amp; Fuel<br/>(Adult/Child)</th>
								<th class="ui-state-default" style="padding:5px;">Travel<br/>Insurance</th>
								<th class="ui-state-default" style="padding:5px;">Total(RM)<br/>(Adult/Child)</th>
								<th class="ui-state-default" style="padding:5px;">Grp Tkt<br/>Validity</th>
								<th class="ui-state-default" style="padding:5px;">Deviation</th>
							</tr>
						</thead>
						<tbody class="ui-datatable-data ui-widget-content">
							<tr>
								<td style="text-align:center; padding:5px;"><h:outputText value="#{salesBean.tourDepVO.airlineVO.code}"/></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.airlineVisa}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.airlineAC}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.airlineTipping}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.airlineExtra}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.airlineAptAdt}"><f:convertNumber pattern="#,##0.00"/></h:outputText>/<h:outputText value="#{salesBean.tourDepVO.airlineAptChd}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.airlineYqAdt}"><f:convertNumber pattern="#,##0.00"/></h:outputText>/<h:outputText value="#{salesBean.tourDepVO.airlineYqChd}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.airlineTrvlIns}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.airlineTotAdt}"><f:convertNumber pattern="#,##0.00"/></h:outputText>/<h:outputText value="#{salesBean.tourDepVO.airlineTotChd}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.tktValidity}"/></td>
								<td style="text-align:center;"><h:outputText value="#{salesBean.tourDepVO.airlineDeviation}"><f:convertNumber pattern="#,##0.00"/></h:outputText></td>
							</tr>
						</tbody>
					</table>
				</div>
				<h:outputText value="Airline Remarks:" style="font-size:11px; font-weight:bold;"/><br/>
				<h:outputText value="#{salesBean.tourDepVO.airlineScheduleVO.remarks}" style="font-size:11px;"/>
				<br/>
				<br/>
				<h:outputText value="**Others:" style="font-size:11px; font-weight:bold;"/>
				
				<br/>
				<p:panelGrid style="width:400px;">
				<c:if test="#{not empty salesBean.tourDepVO.airlineScheduleVO.extraItemChargeList}">
					<c:forEach items="#{salesBean.tourDepVO.airlineScheduleVO.extraItemChargeList}" var="chargeVO">
						<p:row>
							<p:column style="width:350px;"><h:outputText value="#{chargeVO.typeDesc}"/></p:column>
							<p:column style="width:50px;"><h:outputText value="#{chargeVO.amount}"><f:convertNumber pattern="#,##0.00"/></h:outputText></p:column>
						</p:row>
					</c:forEach>
				</c:if>
				<c:if test="#{not empty salesBean.tourDepVO.extraItemChargeList}">
					<c:forEach items="#{salesBean.tourDepVO.extraItemChargeList}" var="extraVO">
						<p:row>
							<p:column style="width:350px;"><h:outputText value="#{extraVO.desc}"/></p:column>
							<p:column style="width:50px;"><h:outputText value="#{extraVO.amount}"><f:convertNumber pattern="#,##0.00"/></h:outputText></p:column>
						</p:row>
					</c:forEach>
				</c:if>
				</p:panelGrid>
				<br/>
				<c:if test="#{salesBean.tourDepVO.isShowAirline ne null ? salesBean.tourDepVO.isShowAirline : false}">
				<h:outputText value="Flight Schedule (Subject to change)" style="font-weight:bold;"/>
				<br/>
				<h:outputText value="No flight schedule selected." style="color:#FF0000; font-size:10px;" rendered="#{empty salesBean.tourDepVO.airlineScheduleVO}"/>
				<p:dataTable value="#{salesBean.tourDepVO.airlineScheduleVO.airlineScheduleItemList}" var="itemVO" style="margin-bottom:5px;" rendered="#{not empty salesBean.tourDepVO.airlineScheduleVO}">
					<p:column headerText="Seq" style="width:50px"><h:outputText value="#{itemVO.seq}"/></p:column>
					<p:column headerText="Type" style="width:80px"><h:outputText value="#{itemVO.typeCd}"/></p:column>
					<p:column headerText="Dep Date" style="width:130px">
						<h:outputText value="#{itemVO.departureDate}">
							<f:convertDateTime pattern="#{config['date.display.pattern2']}"/>
						</h:outputText>
					</p:column>
					<p:column headerText="Arr Date" style="width:130px">
						<h:outputText value="#{itemVO.arrivalDate}" >
							<f:convertDateTime pattern="#{config['date.display.pattern2']}"/>
						</h:outputText>
					</p:column>
					<p:column headerText="Flight Code" style="width:80px"><h:outputText value="#{itemVO.flightCd}"/></p:column>
					<p:column headerText="From" style="width:80px"><h:outputText value="#{itemVO.fromAirportCd}"/></p:column>
					<p:column headerText="To" style="width:80px"><h:outputText value="#{itemVO.toAirportCd}"/></p:column>
					<p:column headerText="ETD" style="width:80px"><h:outputText value="#{itemVO.etd}"/></p:column>
					<p:column headerText="ETA" style="width:80px">
						<h:outputText value="#{itemVO.eta}" rendered="#{not itemVO.isNextDay}"/>
						<h:outputText value="#{itemVO.eta}+1" rendered="#{itemVO.isNextDay}"/>
					</p:column>
					<p:column headerText="Remarks" style="width:200px"><h:outputText value="Est #{itemVO.remarks}"/></p:column>
				</p:dataTable>
				<br/>
				<br/>
				</c:if>
				<h:outputText value="Hotel Stay" style="font-weight:bold;"/>
				<br/>
				<h:outputText value="No hotel selected." style="color:#FF0000; font-size:10px;" rendered="#{empty salesBean.tourDepVO.tourHotelList}"/>
				<p:dataTable value="#{salesBean.tourDepVO.tourHotelList}" var="vo" rendered="#{not empty salesBean.tourDepVO.tourHotelList}">
					<!--p:column headerText="No. of Nights" style="width:50px;"><h:outputText value="#{vo.nightNum}"/></p:column-->
					<p:column headerText="From Date" style="width:100px;"><h:outputText value="#{vo.fromDate}"><f:convertDateTime pattern="dd-MMM-yyyy"/></h:outputText></p:column>
					<p:column headerText="To Date" style="width:100px;"><h:outputText value="#{vo.toDate}"><f:convertDateTime pattern="dd-MMM-yyyy"/></h:outputText></p:column>
					<p:column headerText="Hotel Name"><h:outputText value="#{vo.hotelVO.name}"/></p:column>
					<p:column headerText="Stars"><h:outputText value="#{vo.hotelVO.starCd}"/></p:column>
					<p:column headerText="Website"><h:outputText value="#{vo.hotelVO.website}"/></p:column>
				</p:dataTable>
				<!--br/>
				<h:outputText value="Discount"/>&nbsp;&nbsp;
				<h:outputText value="#{salesBean.tourDepVO.tfairDiscount}"><f:convertNumber pattern="RM#,##0.00"/></h:outputText-->
				<br/><br/>
				<h:outputText value="Itinerary" style="font-weight:bold;"/>
				<p:panelGrid>
					<c:forEach items="#{salesBean.tourDepVO.tourItineryList}" var="itineryVO">
						<p:row>
							<p:column style="width:100px;">
								<h:outputText value="English" rendered="#{itineryVO.typeCd eq 'CUST' and itineryVO.langCd eq 'EN'}"/>
								<h:outputText value="English" rendered="#{itineryVO.typeCd eq 'AGENT' and itineryVO.langCd eq 'EN' and (empty salesBean.isB2BAgent or salesBean.isB2BAgent)}"/>
								<h:outputText value="Chinese/Malay" rendered="#{itineryVO.typeCd eq 'CUST' and itineryVO.langCd eq 'ZH'}"/>
							</p:column>
							<p:column>
								<h:outputLink target="_blank" value="#{request.contextPath}#{itineryVO.path}/#{salesBean.urlEncoder(itineryVO.name)}" rendered="#{itineryVO.typeCd eq 'CUST' and itineryVO.langCd eq 'EN'}" style="color:#0040FF;"><h:outputText value="#{itineryVO.name}"/></h:outputLink>
								<h:outputLink target="_blank" value="#{request.contextPath}#{itineryVO.path}/#{salesBean.urlEncoder(itineryVO.name)}" rendered="#{itineryVO.typeCd eq 'AGENT' and itineryVO.langCd eq 'EN' and (empty salesBean.isB2BAgent or salesBean.isB2BAgent)}" style="color:#0040FF;"><h:outputText value="#{itineryVO.name}"/></h:outputLink>
								<h:outputLink target="_blank" value="#{request.contextPath}#{itineryVO.path}/#{salesBean.urlEncoder(itineryVO.name)}" rendered="#{itineryVO.typeCd eq 'CUST' and itineryVO.langCd eq 'ZH'}" style="color:#0040FF;"><h:outputText value="#{itineryVO.name}"/></h:outputLink>
							</p:column>
						</p:row>
					</c:forEach>
				</p:panelGrid>
				</div>
				</p:panel>
		</p:tab>
		<p:tab id="idTabCms" title="Itinerary CMS" rendered="#{salesBean.tourDepVO.tourPackageDailyItineraryVO ne null}">
			<p:panel
				header="#{salesBean.tourDepVO.tourPackageDailyItineraryVO.title}"
				style="border:0;">
				<div style="width:900px; height:450px; overflow:auto;">
					<p:panelGrid id="idPanelDailyItineraryItem">
						<p:row>
							<p:column>
								<p:selectOneButton value="#{salesBean.tourDepVO.tourPackageDailyItineraryVO.langCd}">
									<f:selectItem itemLabel="ENGLISH" itemValue="ENG" />
									<f:selectItem itemLabel="CHINESE" itemValue="ZH" />
									<p:ajax global="false"
										update=":idTourDepMoreInfoForm:idTab:idTableDailyItineraryItem" />
								</p:selectOneButton>
							</p:column>
						</p:row>
					</p:panelGrid>
		
					<p:dataTable id="idTableDailyItineraryItem"
						value="#{salesBean.tourDepVO.tourPackageDailyItineraryVO.langCd eq 'ENG' ? salesBean.tourDepVO.tourPackageDailyItineraryVO.dailyItineraryItemEngVOList : salesBean.tourDepVO.tourPackageDailyItineraryVO.dailyItineraryItemZhVOList}"
						var="subVo" style="margin: 10px; width: 1100px;" rows="10" paginator="true"
						paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink} {RowsPerPageDropdown}"
						rowsPerPageTemplate="10,15,20">
						<p:column headerText="Seq" style="width:50px; text-align:center;">
							<h:outputText value="#{subVo.seq}" />
						</p:column>
						<p:column headerText="Title" style="width:200px;">
							<h:outputText value="#{subVo.title}" escape="false"/>
						</p:column>
						<p:column headerText="Hotel" style="width:200px;">
							<h:outputText value="#{subVo.hotel}" escape="true" style="white-space: pre-wrap"/>
						</p:column>
						<p:column headerText="Meals" style="width:200px;">
							<h:outputText value="#{subVo.meals}" escape="true" style="white-space: pre-wrap"/>
						</p:column>
						<p:column headerText="Description">
							<h:outputText value="#{subVo.description}" escape="false"/>
						</p:column>
						<p:column headerText="Remark" style="width:200px">
							<h:outputText value="#{subVo.remarks}" escape="true" style="white-space: pre-wrap"/>
						</p:column>
					</p:dataTable>
					
					<br />
					<br />
					<h:outputText value="Itinerary" />
					<p:panelGrid>
						<p:row>
							<p:column style="width:100px;">
								<h:outputText value="English" />
							</p:column>
							<p:column>
								<c:if test="#{not empty salesBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTEN'].name}">
									<h:outputLink target="_blank"
										value="#{request.contextPath}#{salesBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTEN'].path}/#{salesBean.urlEncoder(salesBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTEN'].name)}"
										style="color:#0040FF;">
										<h:outputText value="#{salesBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTEN'].name}" />
									</h:outputLink>
								</c:if>
								
								<c:if test="#{not empty salesBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_AGENTEN'].name and (empty salesBean.isB2BAgent or salesBean.isB2BAgent)}">
									<h:outputLink target="_blank"
										value="#{request.contextPath}#{salesBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_AGENTEN'].path}/#{salesBean.urlEncoder(salesBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_AGENTEN'].name)}"
										style="color:#0040FF;">
										<h:outputText value="#{salesBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_AGENTEN'].name}" />
									</h:outputLink>
								</c:if>
							</p:column>
						</p:row>
						<p:row>
							<p:column style="width:100px;">
								<h:outputText value="Chinese/Malay" />
							</p:column>
							<p:column>
								<c:if test="#{not empty salesBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTZH'].name}">
									<h:outputLink target="_blank"
										value="#{request.contextPath}#{salesBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTZH'].path}/#{salesBean.urlEncoder(salesBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTZH'].name)}"
										style="color:#0040FF;">
										<h:outputText value="#{salesBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTZH'].name}" />
									</h:outputLink>
								</c:if>
							</p:column>
						</p:row>
					</p:panelGrid>
				</div>
			</p:panel>
		</p:tab>
	</p:tabView>
	<h:panelGrid columns="1">
		<p:commandButton value="#{msg['common.button.label.cancel']}" actionListener="#{salesBean.resetForm}" onclick="varTourDepMoreInfoDialog.hide()"/>
	</h:panelGrid>
</ui:composition>