<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
				template="/WEB-INF/views/layouts/main.xhtml">

<ui:define name="content">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
<p:panel header="Posting Sales List" toggleable="true" toggleSpeed="500">
	<h:form id="idPostingSalesForm">
		<p:growl id="msg"/>
		<p:panelGrid>
			<p:row>
				<p:column style="width:80px;"><h:outputLabel for="idDateFrom">Date From</h:outputLabel></p:column>
				<p:column style="width:80px;">
					<p:calendar id="idDateFrom" value="#{postingSalesBean.searchParamVO.fromDate}" navigator="true" showButtonPanel="true" size="12" pattern="dd-MMM-yyyy">
						<p:ajax event="dateSelect" update="idDateTo" global="false"/>
					</p:calendar>
				</p:column>
				<p:column style="width:20px;"><h:outputLabel for="idDateTo">To</h:outputLabel></p:column>
				<p:column style="width:80px;">
					<p:calendar id="idDateTo" value="#{postingSalesBean.searchParamVO.toDate}" mindate="#{salesBean.searchParamVO.fromDate}"
						navigator="true" showButtonPanel="true" size="12" pattern="dd-MMM-yyyy">
					</p:calendar>
				</p:column>
				<p:column style="width:80px;"><h:outputLabel for="idInvoiceType">Invoice Type</h:outputLabel></p:column>
				<p:column style="width:220px;">
					<p:selectOneButton id="idInvoiceType" value="#{postingSalesBean.searchParamVO.obj1}">
						<f:selectItem itemLabel="All" itemValue="ALL"/>
			            <f:selectItem itemLabel="Invoice" itemValue="I"/>
			            <f:selectItem itemLabel="Pax Statement" itemValue="P"/>
			        </p:selectOneButton>
				</p:column>
				<p:column style="width:40px;"><h:outputLabel for="idPostingStatus">Posting Status</h:outputLabel></p:column>
				<p:column style="width:335px;">
					<p:selectOneButton id="idPostingStatus" value="#{postingSalesBean.searchParamVO.obj2}">
						<f:selectItem itemLabel="All" itemValue="ALL"/>
						<f:selectItem itemLabel="Incompleted" itemValue="I"/>
			            <f:selectItem itemLabel="Pending" itemValue="P"/>
			            <f:selectItem itemLabel="Failed" itemValue="F"/>
			            <f:selectItem itemLabel="Success" itemValue="S"/>
			        </p:selectOneButton>
				</p:column>
				<p:column style="width:60px;">
					<p:commandButton value="Search" actionListener="#{postingSalesBean.search}" update="@form"/>
				</p:column>
				<p:column>
					<p:commandButton value="Reset" actionListener="#{postingSalesBean.init}" update="@form"/>
				</p:column>
			</p:row>
		</p:panelGrid>
		
		<p:dataTable id="idPostingSalesList" value="#{postingSalesBean.lazyDataModel}" var="vo" paginator="true" rows="20" 
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
			rowsPerPageTemplate="20, 30, 50" emptyMessage="#{msg['cust.tbl.empty.message']}"
			lazy="true" filterEvent="enter">
			
			<p:column headerText="Tier" styleClass="txt_center">
				<p:commandButton icon="ui-icon-info" actionListener="#{postingSalesBean.onPostingSalesSelected(vo)}"
					update=":idInvoicePostingSalesItemDialog" oncomplete="varInvoicePostingSalesItemDialog.show()"/>
			</p:column>
			
			<p:column headerText="Invoice No." sortBy="#{vo.invNo}" filterBy="#{vo.invNo}">
				<h:outputText value="#{postingSalesBean.invPrefixVal} #{vo.invNo}" rendered="#{vo.docTypeCd eq 'I'}"/>
			</p:column>
			
			<p:column headerText="Pax Statement" sortBy="#{vo.psNo}" filterBy="#{vo.psNo}">
				<h:outputText value="#{postingSalesBean.psPrefixVal} #{vo.psNo}"/>
			</p:column>
			
			<p:column headerText="Booking No." sortBy="#{vo.idBooking}" filterBy="#{vo.idBooking}">
				<h:outputText value="#{vo.idBooking}"/>
			</p:column>
			
			<p:column headerText="Customer No" sortBy="#{vo.custCd}" filterBy="#{vo.custCd}">
				<h:outputText value="#{vo.custCd}" />
			</p:column>
			<p:column headerText="Customer Name" sortBy="#{vo.custName}" filterBy="#{vo.custName}" filterMatchMode="contains">
				<h:outputText value="#{bterp:lookupItemDesc('salutatn', vo.custSalutation)} #{vo.custName}" />
			</p:column>
			<p:column headerText="Company Name" sortBy="#{vo.coName}" filterBy="#{vo.coName}" filterMatchMode="contains">
				<h:outputText value="#{vo.coName}" />
			</p:column>
			
			<p:column headerText="Invoice Date" sortBy="#{vo.invoiceDt}" filterBy="#{vo.invoiceDt}" styleClass="txt_center">
				<h:outputText value="#{vo.invoiceDt}">
					<f:convertDateTime pattern="#{config['date.display.pattern']}" />
				</h:outputText>
			</p:column>
			
			<p:column headerText="Invoice Type" sortBy="#{vo.docTypeCd}" styleClass="txt_center">
				<h:outputText value="Invoice" rendered="#{vo.docTypeCd eq 'I'}"/>
				<h:outputText value="Pax Statement" rendered="#{vo.docTypeCd eq 'P'}"/>
				<h:outputText value="#{vo.docTypeCd}" rendered="#{vo.docTypeCd ne 'I' and vo.docTypeCd ne 'P'}"/>
			</p:column>
			
			<p:column headerText="Departure Date" sortBy="#{vo.departureDt}" filterBy="#{vo.departureDt}" styleClass="txt_center">
				<h:outputText value="#{vo.departureDt}">
					<f:convertDateTime pattern="#{config['date.display.pattern']}" />
				</h:outputText>
			</p:column>
			
			<p:column headerText="Amount" sortBy="#{vo.amount}" filterBy="#{vo.amount}" styleClass="txt_center">
				<h:outputText value="#{vo.amount}">
					<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
				</h:outputText>
			</p:column>
			
			<p:column headerText="Posting Status" sortBy="#{vo.postingStatus}" styleClass="txt_center">
				<h:outputText value="#{vo.postingStatus}"/>
			</p:column>
			
			<p:column headerText="Remarks" style="width:150px; text-align:center;">
			   <p:outputLabel id="idRemarks" value="View" rendered="#{not empty vo.remarks}">
			   <i class="fa fa-info-circle" aria-hidden="true" />
			   </p:outputLabel>
			   <pe:tooltip for="idRemarks" shared="true" showDelay="300" targetPosition="top left" position="bottom right" rendered="#{not empty vo.remarks}">
					<h:outputText value="#{vo.remarks}" escape="true" style="white-space: pre-wrap"/>
			   </pe:tooltip>
			</p:column>
			
			<p:column headerText="Created Date" sortBy="#{vo.createdDate}" style="width: 150px;" styleClass="txt_center" filterBy="#{vo.createdDate}">
				<h:outputText value="#{vo.createdDate}"><f:convertDateTime pattern="#{config['date.display.pattern']} HH:mm:ss"/></h:outputText>
			</p:column>
			
		</p:dataTable>
		
	</h:form>
</p:panel>

<!-- DIALOG - Invoice Posting Sales Item -->
<p:dialog id="idInvoicePostingSalesItemDialog" header="Posting Sales Invoice Item"
	widgetVar="varInvoicePostingSalesItemDialog" modal="true" resizable="false"
	dynamic="true" draggable="true" closable="true">
	<h:form id="idInvoicePostingSalesIteForm">
		<ui:include src="invoice_posting_sales_item.xhtml" />
	</h:form>
</p:dialog>

</ui:define>
</ui:composition>