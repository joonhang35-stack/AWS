<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
					template="/WEB-INF/views/layouts/main.xhtml"
					xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

<ui:define name="content">

<p:panel header="#{invoiceReportBean.invoiceType eq '1U' ? 'C/N' : 'Invoice'} Report" toggleable="true" toggleSpeed="500">
	<h:form id="idFormInvoiceReport">
		<p:growl id="msg"/>
		<p:panelGrid style="width:700px;">
			<p:row>
				<p:column style="width:150px;">
					<h:outputLabel for="idReportType">Report Type <span class="required">*</span></h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu id="idReportType" label="Report Type" value="#{invoiceReportBean.reportType}" effect="fade">
						<p:ajax event="change" listener="#{invoiceReportBean.handleSelectReportType}" update="idFormInvoiceReport" />
						<f:selectItem itemLabel="Select One" itemValue=""/>
						<f:selectItem itemLabel="#{invoiceReportBean.invoiceType eq '1U' ? 'C/N' : 'Invoice'} List By T/Code &amp; Sales Person" itemValue="A"/>
						<f:selectItem itemLabel="#{invoiceReportBean.invoiceType eq '1U' ? 'C/N' : 'Invoice'} List By Inv Date &amp; T/Code &amp; Dep Date" itemValue="B"/>
						<f:selectItem itemLabel="Sales Listing Report" itemValue="C"/>
					</h:selectOneMenu>
				</p:column>
				<p:column style="width:300px;">
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{invoiceReportBean.printInvoiceListARpt('PDF')}" ajax="false" rendered="#{invoiceReportBean.reportType == 'A'}"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{invoiceReportBean.printInvoiceListARpt('XLS')}" ajax="false" rendered="#{invoiceReportBean.reportType == 'A'}"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{invoiceReportBean.printInvoiceListBRpt('PDF')}" ajax="false" rendered="#{invoiceReportBean.reportType == 'B'}"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{invoiceReportBean.printInvoiceListBRpt('XLS')}" ajax="false" rendered="#{invoiceReportBean.reportType == 'B'}"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{invoiceReportBean.printSalesListingRpt('PDF')}" ajax="false" rendered="#{invoiceReportBean.reportType == 'C'}"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{invoiceReportBean.printSalesListingRpt('XLS')}" ajax="false" rendered="#{invoiceReportBean.reportType == 'C'}"/>
				</p:column>
			</p:row>
		</p:panelGrid>
		
		<p:panelGrid id="idSearchTypeA" style="width:550px;">
			<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
				<p:column style="width:100px;">
					<h:outputLabel>Print With</h:outputLabel>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column colspan="2">
				 	<p:selectOneButton id="idPrintType" value="#{invoiceReportBean.documentType}">
				 		<f:selectItem itemLabel="Both" itemValue="ALL"/>
			            <f:selectItem itemLabel="Pax Statement" itemValue="PS" />
			            <f:selectItem itemLabel="Invoice" itemValue="INV"/>
			        </p:selectOneButton>
				</p:column>
			</p:row>
			<p:row rendered="#{invoiceReportBean.reportType == 'A' || invoiceReportBean.reportType == 'B' || invoiceReportBean.reportType == 'C'}">
				<p:column style="width:100px;">
					<h:outputLabel>Invoice Date</h:outputLabel>
				</p:column>
				<p:column style="width:10px;">
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column style="width:80px;">
				 	<p:calendar id="idInvoiceDateFr" label="Invoice Date From" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{invoiceReportBean.searchParamVO.obj1}"/>
					<p:watermark for="idInvoiceDateFr" value="Invoice Date From" />
				</p:column>
				<p:column style="width:80px;">
					<p:calendar id="idInvoiceDateTo" label="Invoice Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{invoiceReportBean.searchParamVO.obj2}"/>
					<p:watermark for="idInvoiceDateTo" value="Invoice Date To" />
				</p:column>
			</p:row>
			<p:row rendered="#{invoiceReportBean.reportType == 'A' || invoiceReportBean.reportType == 'C'}">
				<p:column>
					<h:outputLabel>Departure Date</h:outputLabel>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column>
				 	<p:calendar id="idDepartureDateFr" label="Departure Date From" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{invoiceReportBean.searchParamVO.obj3}"/>
					<p:watermark for="idDepartureDateFr" value="Departure Date From" />
				</p:column>
				<p:column>
					<p:calendar id="idDepartureDateTo" label="Departure Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{invoiceReportBean.searchParamVO.obj4}"/>
					<p:watermark for="idDepartureDateTo" value="Departure Date To" />
				</p:column>
			</p:row>
			<p:row rendered="#{invoiceReportBean.reportType == 'A'}">
				<p:column>
					<h:outputLabel>Sales Person</h:outputLabel>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column>
				 	<h:selectOneMenu id="idSalesPerson" label="Sales Person" value="#{invoiceReportBean.searchParamVO.obj5}" effect="fade" >
						<f:selectItem itemLabel="All" itemValue=""/>
						<f:selectItems value="#{invoiceReportBean.employeeList}" var="vo" itemValue="#{vo.id}" itemLabel="#{vo.userVO.name}"/>
					</h:selectOneMenu>
				</p:column>
			</p:row>
			<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
				<p:column>
					<h:outputLabel>Sales Person</h:outputLabel>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column>
				 	<h:selectOneMenu id="idSalesListingPerson" label="Sales Person" value="#{invoiceReportBean.searchParamVO.obj5}" effect="fade" >
						<f:selectItem itemLabel="All" itemValue=""/>
						<f:selectItems value="#{invoiceReportBean.employeeList}" var="vo" itemValue="#{vo.id}" itemLabel="#{vo.userVO.name}"/>
					</h:selectOneMenu>
				</p:column>
			</p:row>
			<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
				<p:column>
					<h:outputLabel>Invoice Category</h:outputLabel>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column>
					<p:selectCheckboxMenu id="idSalesListingInvCat" value="#{invoiceReportBean.idInvCatList}"
						label="Invoice Category" filter="true" filterMatchMode="startsWith" style="display:block;">
				        <f:selectItems value="#{bterp:lookupItemList('inv_cat')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
				    </p:selectCheckboxMenu>
				</p:column>
			</p:row>
			<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
				<p:column>
					<h:outputLabel>Department</h:outputLabel>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column>
					<p:selectCheckboxMenu id="idSalesListingDepartment" value="#{invoiceReportBean.idDepartmentList}"
						label="Department" filter="true" filterMatchMode="startsWith" style="display:block;">
				        <f:selectItems value="#{bterp:lookupItemList('dept_type')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
				    </p:selectCheckboxMenu>
				</p:column>
			</p:row>
			<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
				<p:column>
					<h:outputLabel>Order Source</h:outputLabel>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column>
					<p:selectCheckboxMenu id="idSalesListingOS" value="#{invoiceReportBean.idOrderSourceList}"
						label="Order Source" filter="true" filterMatchMode="startsWith" style="display:block;">
				        <f:selectItems value="#{bterp:lookupItemList('ordr_sorc')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
				    </p:selectCheckboxMenu>
				</p:column>
			</p:row>
			<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
				<p:column>
					<h:outputLabel>Tour Code</h:outputLabel>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column colspan="2">
					<p:column style="width:150px;" colspan="2">
						<p:panel id="idTourCd">
							<p:inputText id="idSalesListingTC" label="Tour Code" value="#{invoiceReportBean.tourDepVO.code}" onkeydown="preventBackspace()" style="background:#ccc;" size="30" maxlength="0"/>
							&nbsp;
					        <p:commandButton icon="ui-icon-search" actionListener="#{invoiceReportBean.loadTour}" update=":idTourCodeList" oncomplete="varTourCodeList.show()" process="@this" rendered="#{empty invoiceReportBean.tourDepVO.id}"/>
							<p:commandButton icon="ui-icon-close" actionListener="#{invoiceReportBean.clearTourCode}" update=":idFormInvoiceReport:idTourCd" process="@this" rendered="#{not empty invoiceReportBean.tourDepVO.id}"/>
						</p:panel>
					</p:column>
				</p:column>
			</p:row>
			<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
				<p:column style="width:110px;">
					<p:outputLabel value="Region" />
				</p:column>
				<p:column style="width:10px;">
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column>
					<p:selectCheckboxMenu id="idRegion" value="#{invoiceReportBean.idRegionList}"
						label="Region List" filter="true" filterMatchMode="startsWith" style="display:block;">
				        <f:selectItems value="#{invoiceReportBean.tourCatViewVOList}" var="vo" itemValue="#{vo.id}" itemLabel="#{vo.desc}"/>
				    </p:selectCheckboxMenu>
				</p:column>
			</p:row>
			<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
				<p:column style="width:110px;">
					<p:outputLabel value="Country" />
				</p:column>
				<p:column style="width:10px;">
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column>
					<p:selectCheckboxMenu id="idCountry" value="#{invoiceReportBean.idCountryList}"
						label="Country List" filter="true" filterMatchMode="startsWith" onHide="executeOnOnhide();" style="display:block;">
				        <f:selectItems value="#{invoiceReportBean.tourCountryVOList}" var="vo" itemValue="#{vo.id}" itemLabel="#{vo.desc}"/>
				    </p:selectCheckboxMenu>
				    
				     <p:remoteCommand name="executeOnOnhide" actionListener="#{invoiceReportBean.handleCountryChange}"
				        update=":idFormInvoiceReport:idProduct" process="@this, :idFormInvoiceReport:idCountry" global="false"/>  
				</p:column>
			</p:row>
			<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
				<p:column>
					<p:outputLabel value="Product" />
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column>
					<p:selectCheckboxMenu id="idProduct" value="#{invoiceReportBean.idProductList}"
						label="Product List" filter="true" filterMatchMode="startsWith" style="display:block;">
				        <f:selectItems value="#{invoiceReportBean.tourThemeVOList}" var="vo" itemValue="#{vo.id}" itemLabel="#{vo.desc}"/>
				    </p:selectCheckboxMenu>
				</p:column>
			</p:row>
			
			<p:row rendered="#{invoiceReportBean.reportType == 'A' || invoiceReportBean.reportType == 'B' || invoiceReportBean.reportType == 'C'}">
				<p:column>
					<h:outputLabel>Status Included</h:outputLabel>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column colspan="2">
					<p:selectBooleanButton value="#{invoiceReportBean.includeCancelled}" onLabel="Cancelled" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"/>&nbsp;
					<p:selectBooleanButton value="#{invoiceReportBean.includeVoided}" onLabel="Voided" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"/>
	        	</p:column>
			</p:row>
			
			<!-- <p:row rendered="#{invoiceReportBean.reportType == 'C'}">
				<p:column>
					<h:outputLabel>UPoint Only</h:outputLabel>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column style="width:150px;" colspan="2">
					<p:selectBooleanButton value="#{invoiceReportBean.uPointOnly}" onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"/>
	        	</p:column>
			</p:row>
			<p:row rendered="#{invoiceReportBean.reportType == 'C'}">
				<p:column>
					<h:outputLabel>Apple Points Only</h:outputLabel>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column style="width:150px;" colspan="2">
					<p:selectBooleanButton value="#{invoiceReportBean.aPointOnly}" onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"/>
	        	</p:column>
			</p:row> -->
		</p:panelGrid>
	</h:form>
</p:panel>

<!--
		DIALOG - TOUR DEPARTURE LIST
	-->
	<p:dialog header="Tour Departure List" id="idTourCodeList" widgetVar="varTourCodeList" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
		<div style="overflow:auto; width:800px !important; height:500px !important;">
		<h:form id="idTourDepListForm">
			<p:dataTable value="#{invoiceReportBean.tourDepVOList}" var="vo" paginator="true" rows="20" 
				paginatorTemplate="#{bterp:pageTemplate()}" 
				rowsPerPageTemplate="10, 20, 30" rowKey="#{vo.id}" selectionMode="single" filterEvent="enter">
				<p:ajax event="rowSelect" listener="#{invoiceReportBean.handleTourCodeSelect}" oncomplete="varTourCodeList.hide()"  update=":idFormInvoiceReport:idTourCd" />
				<p:column headerText="Tour Code" sortBy="#{vo.code}" filterBy="#{vo.code}" filterMatchMode="contains" style="width:200px;">
					<h:outputText value="#{vo.code}" />   
				</p:column>
				<p:column headerText="Departure Date" sortBy="#{vo.dtDep}" filterBy="#{invoiceReportBean.dateFormat(vo.dtDep, 'dd-MMM-yyyy')}" filterMatchMode="contains" style="width:60px;">
					<h:outputText value="#{vo.dtDep}" >
						<f:convertDateTime pattern="#{config['date.display.pattern']}" />
					</h:outputText> 
				</p:column>
				<p:column headerText="Package" sortBy="#{vo.packageDesc}" filterBy="#{vo.packageDesc}" filterMatchMode="contains">
					<h:outputText value="#{vo.packageDesc}" />   
				</p:column>
			</p:dataTable> 
		</h:form>
		</div>
	</p:dialog>
	
</ui:define>
</ui:composition>