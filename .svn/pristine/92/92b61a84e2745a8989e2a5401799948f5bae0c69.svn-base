<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf">
	
	<script type="text/javascript">
			function onValidationItem(xhr, status, args, isAddNewItem) {
				if (args.validationFailed) {
					varJourItemDialog.show();
				} else {
					if(isAddNewItem != true) 
						varJourItemDialog.hide();
				}
			}
	</script>
	<p:growl id="msg"/>
	<p:panelGrid id="panelItemData">
		<p:row>
			<p:column><h:outputLabel for="idAccountNo">Account No <span class="required">*</span></h:outputLabel></p:column>
			<p:column>
				<p:autoComplete id="idAccountNo" label="Account No" value="#{journalBean.journalItem.code}" required="true"
					completeMethod="#{journalBean.acctAutoComplete}" validator="#{journalBean.isAcctValid}" requestDelay="1" 
					nothingLabel="No Account found" update=":idFormJournalItem:panelItemData">
	       			<p:ajax event="itemSelect" listener="#{journalBean.onAutoCompleteAcctSelect}" update=":idFormJournalItem:panelItemData"/>
	        		<pe:keyFilter for="idAccountNo" regEx="/[\d\-\.,]/" />
		    	</p:autoComplete>
	   		</p:column>
			<p:column><h:outputLabel for="idDesc">Description </h:outputLabel></p:column>
			<p:column>
				<p:inputText id="idDesc" label="Description" value="#{journalBean.journalItem.desc}" size="40"/> 
				<p:commandButton style="margin-left:10px;" icon="ui-icon-search" 
						oncomplete="typeof varJournalAcctSubCatList !== 'undefined' ? varJournalAcctSubCatList.show() : varAcctSubCatList.show();" update=":idAcctSubCatList,:idJournalAcctSubCatList" immediate="true" />
			</p:column>
		</p:row>
		<p:row rendered="#{journalBean.isGSTPeriod}">
			<p:column>
				<h:outputLabel for="idGSTCode">GST Code <span class="required">*</span></h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idGSTCode" label="GST Code" value="#{journalBean.journalItem.taxCode}" required="true" 
					maxlength="0" readonly="true" style="background:#ccc;"/>&nbsp;
				<p:commandButton icon="ui-icon-search" oncomplete="varGSTListDialog.show()" update=":idGSTListDialog" 
					process="@this" disabled="#{not journalBean.isGSTPeriod or empty journalBean.journalItem.code or empty journalBean.amtCalcViewVO.idTaxAcct}"/>
				<p:commandButton id="idClrBtn" icon="ui-icon-close" actionListener="#{journalBean.handleTaxCodeClear}" update=":idFormJournalItem" 
					process="@this" disabled="#{empty journalBean.journalItem.taxCode}"/>
			</p:column>
		</p:row>
		<p:row rendered="#{journalBean.isGSTPeriod}">
			<p:column>
				<h:outputLabel for="idGSTRate">GST Rate (%) <span class="required">*</span></h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idGSTRate" label="GST Rate (%)" value="#{journalBean.journalItem.taxRate}" required="true" 
						maxlength="0" readonly="true" style="background:#ccc;" styleClass="txt_right"/>
			</p:column>
		</p:row>
		<p:row>
			<p:column>
				<h:outputLabel> </h:outputLabel>
			</p:column>
			<p:column colspan="3">
				<h:outputText value="#{journalBean.journalItem.acctDesc}"/>
			</p:column>
		</p:row>
		<p:row id="idDebitCreditRow">
			<p:column>
				<h:outputLabel>Debit/Credit </h:outputLabel>
			</p:column>
			<p:column>
				<h:selectOneMenu value="#{journalBean.amtType}">  
          			<f:selectItem itemLabel="Debit" itemValue="Debit" />
          			<f:selectItem itemLabel="Credit" itemValue="Credit" />
	     		</h:selectOneMenu>  
			</p:column>
		</p:row>
		<p:row>
			<p:column>
				<h:outputLabel for="idAmount" >Amount <span class="required">*</span></h:outputLabel>
			</p:column>
			<p:column >
				<p:inputText id="idAmount" label="Amount" styleClass="AmountFormat txt_right" value="#{journalBean.journalItem.amount}" required="true" >
					<f:convertNumber pattern="#{config['amount.format.pattern']}" />
					<p:ajax event="change" update=":idFormJournalItem:idGSTAmt,:idFormJournalItem:idAmt" listener="#{journalBean.handleAmountChange}"/>
				</p:inputText>
				<pe:keyFilter for="idAmount" regEx="/[\d\.]/" ></pe:keyFilter>
			</p:column>
		</p:row>
		<p:row rendered="#{journalBean.isGSTPeriod}">
			<p:column>
				<h:outputLabel for="idGSTAmt">GST Amount</h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idGSTAmt" label="GST Amount" value="#{journalBean.journalItem.taxAmount}" 
					readonly="true" style="background:#ccc" styleClass="txt_right">
					<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
				</p:inputText>
			</p:column>
		</p:row>
		<p:row rendered="#{journalBean.isGSTPeriod}">
			<p:column>
				<h:outputLabel for="idAmt">Amount Inc. GST</h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idAmt" label="Amount Inc. GST" value="#{journalBean.journalItem.amountIncludeTax}" styleClass="txt_right">
					<f:convertNumber pattern="#{config['amount.format.pattern']}" />
					<p:ajax event="change" update=":idFormJournalItem:idGSTAmt,:idFormJournalItem:idAmount" listener="#{journalBean.handleAmountIncludeTaxChange}"/>
				</p:inputText>
			</p:column>
		</p:row>
	</p:panelGrid>
	
	<p:panelGrid columns="3" style="width: 1px;">
		<p:commandButton value="#{journalBean.isAddNewItem eq true ? msg['common.button.label.ok'] : msg['common.label.action.edit']}" 
										actionListener="#{journalBean.handleJournalItemSubmit}" 
										update="@form,:idJournalCartForm:idJournal" 
										oncomplete="onValidationItem(xhr, status, args, #{journalBean.isAddNewItem});" 
										rendered="#{empty billPymtBean}">
		</p:commandButton>
										
		<p:commandButton value="#{journalBean.isAddNewItem eq true ? msg['common.button.label.ok'] : msg['common.label.action.edit']}" 
										actionListener="#{journalBean.handleJournalItemSubmitFromBill}" 
										update="@form :idAddFuncForm:idJournalList :idJournalCartForm:idJournal" 
										oncomplete="onValidationItem(xhr, status, args, #{journalBean.isAddNewItem});" 
										rendered="#{not empty billPymtBean}">
		</p:commandButton>
		
		<p:commandButton value="#{msg['common.button.label.cancel']}" type="button" onclick="varJourItemDialog.hide()"/>
	</p:panelGrid>
	
</ui:composition>