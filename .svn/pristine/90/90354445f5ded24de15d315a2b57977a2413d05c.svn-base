				accountReportBean.reportType == 'G' ||
				accountReportBean.reportType == 'H' ||
				accountReportBean.reportType == 'I' ||
				accountReportBean.reportType == 'J' ||
				accountReportBean.reportType == 'M' ||
				accountReportBean.reportType == 'N' ||
				accountReportBean.reportType == 'O' ||
