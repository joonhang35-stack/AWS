<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
					template="/WEB-INF/views/layouts/main.xhtml"
					xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

<ui:define name="content">

<script type="text/javascript">
function monitorExporting(start, complete) {
	if (start) {
		start();
	}

	window.pdfExportingMonitor = setInterval(function() {
		var exportingComplete = $.cookie('cookie.pdf.exporting');

		if (exportingComplete === 'true') {
			if (complete) {
				complete();
			}
			$.cookie('cookie.pdf.exporting', null);
			clearInterval(window.pdfExportingMonitor);
		}
	}, 500);
}

function start() {
	statusDialog.show();
}

function stop() {
	statusDialog.hide();
}
</script>

<p:dialog modal="true" widgetVar="statusDialog" header="Report Loading"
        draggable="false" closable="false" resizable="false">
	<p:panelGrid columns="1">
		<h:outputLabel>Please wait while the report is being prepared...</h:outputLabel>
		<p:graphicImage value="/img/ajaxloadingbar.gif" />
	</p:panelGrid>
</p:dialog>

<p:panel header="Account Report" toggleable="true" toggleSpeed="500">
	<h:form id="idFormAccountReport">
		<p:growl id="msg"/>
		<p:panelGrid style="width:600px;">
			<p:row>
				<p:column style="width:100px;">
					<h:outputLabel for="idReportType">Report Type <span class="required">*</span></h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu id="idReportType" label="Report Type" value="#{accountReportBean.reportType}" effect="fade">
						<p:ajax event="change" listener="#{accountReportBean.handleSelectReportType}" update="idFormAccountReport" />
						<f:selectItem itemLabel="Select One" itemValue=""/>
						<f:selectItem itemLabel="Trading &amp; Profit &amp; Loss - Others" itemValue="A"/>
						<f:selectItem itemLabel="Trading &amp; Profit &amp; Loss - Audit" itemValue="N"/>
						<f:selectItem itemLabel="Trial Balance" itemValue="B"/>
						<f:selectItem itemLabel="Trial Balance - Year To Date" itemValue="C"/>
						<f:selectItem itemLabel="Balance Sheet - Audit" itemValue="D"/>
						<f:selectItem itemLabel="Balance Sheet - Others" itemValue="E"/>
						<f:selectItem itemLabel="Beginning Balance" itemValue="F"/>
						<f:selectItem itemLabel="Debtor Ledger - Audit" itemValue="O"/>
						<f:selectItem itemLabel="Debtor Ledger - Others" itemValue="G"/>
						<f:selectItem itemLabel="Debtor Summary" itemValue="H"/>
						<f:selectItem itemLabel="Creditor Ledger - Audit" itemValue="P"/>
						<f:selectItem itemLabel="Creditor Ledger - Others" itemValue="I"/>
						<f:selectItem itemLabel="Creditor Summary" itemValue="J"/>
						<f:selectItem itemLabel="Journal Printing" itemValue="M"/>
						<f:selectItem itemLabel="Sales In Advance" itemValue="Q"/>
						<f:selectItem itemLabel="Chart Of Account" itemValue="R"/>
					</h:selectOneMenu>
				</p:column>
				<p:column>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printProfitnLossRpt('PDF')}" ajax="false" rendered="#{accountReportBean.reportType == 'A'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printProfitnLossRpt('XLS')}" ajax="false" rendered="#{accountReportBean.reportType == 'A'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printTrialBalance('PDF')}" ajax="false" rendered="#{accountReportBean.reportType == 'B'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printTrialBalance('XLS')}" ajax="false" rendered="#{accountReportBean.reportType == 'B'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printTrialBalanceYearDate('PDF')}" ajax="false" rendered="#{accountReportBean.reportType == 'C'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printTrialBalanceYearDate('XLS')}" ajax="false" rendered="#{accountReportBean.reportType == 'C'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printBalanceSheetAudit('PDF')}" ajax="false" rendered="#{accountReportBean.reportType == 'D'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printBalanceSheetAudit('XLS')}" ajax="false" rendered="#{accountReportBean.reportType == 'D'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printBalanceSheetOthers('PDF')}" ajax="false" rendered="#{accountReportBean.reportType == 'E'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printBalanceSheetOthers('XLS')}" ajax="false" rendered="#{accountReportBean.reportType == 'E'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printBeginningBalance('PDF')}" ajax="false" rendered="#{accountReportBean.reportType == 'F'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printBeginningBalance('XLS')}" ajax="false" rendered="#{accountReportBean.reportType == 'F'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printDebtorLedger('PDF', 'others')}" ajax="false" rendered="#{accountReportBean.reportType == 'G'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printDebtorLedger('XLS', 'others')}" ajax="false" rendered="#{accountReportBean.reportType == 'G'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printDebtorSummary('PDF')}" ajax="false" rendered="#{accountReportBean.reportType == 'H'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printDebtorSummary('XLS')}" ajax="false" rendered="#{accountReportBean.reportType == 'H'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printCreditorLedger('PDF', 'others')}" ajax="false" rendered="#{accountReportBean.reportType == 'I'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printCreditorLedger('XLS', 'others')}" ajax="false" rendered="#{accountReportBean.reportType == 'I'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printCreditorSummary('PDF')}" ajax="false" rendered="#{accountReportBean.reportType == 'J'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printCreditorSummary('XLS')}" ajax="false" rendered="#{accountReportBean.reportType == 'J'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printJournal('PDF')}" ajax="false" rendered="#{accountReportBean.reportType == 'M'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printJournal('XLS')}" ajax="false" rendered="#{accountReportBean.reportType == 'M'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printProfitnLossAuditRpt('PDF')}" ajax="false" rendered="#{accountReportBean.reportType == 'N'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printProfitnLossAuditRpt('XLS')}" ajax="false" rendered="#{accountReportBean.reportType == 'N'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printDebtorLedger('PDF', 'audit')}" ajax="false" rendered="#{accountReportBean.reportType == 'O'}" onclick="monitorExporting(start,stop)"/>
