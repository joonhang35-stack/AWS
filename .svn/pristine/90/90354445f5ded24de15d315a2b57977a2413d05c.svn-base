					<p:selectBooleanButton value="#{accountReportBean.salesOnly}" onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"/>
	        	</p:column>
			</p:row>
			<!-- <p:row rendered="#{accountReportBean.reportType == 'Q'}">
				<p:column style="width:110px;">
					<h:outputLabel>&gt; Departure Date</h:outputLabel>
				</p:column>
				<p:column style="width:10px;">
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column style="width:150px;" colspan="2">
					<p:selectBooleanButton value="#{accountReportBean.gtDtDep}" onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"/>
	        	</p:column>
			</p:row> -->
			<p:row rendered="#{accountReportBean.reportType == 'I' ||
				accountReportBean.reportType == 'J' ||
				accountReportBean.reportType == 'P'}">
				<p:column>
					<h:outputLabel>Type of Supplier</h:outputLabel>
				</p:column>
				<p:column style="width:10px;">
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column style="width:150px;" colspan="3">
					<h:selectOneMenu label="Type of Supplier" value="#{accountReportBean.supplierVO.supplierType}">  
			            <f:selectItem itemLabel="All" itemValue="" />  
			            <f:selectItem itemLabel="Trade Creditors" itemValue="TC" /> 
			            <f:selectItem itemLabel="Sundry Creditors" itemValue="SC" />
			        </h:selectOneMenu>
	        	</p:column>
			</p:row>
			<p:row rendered="#{accountReportBean.reportType == 'I' ||
				accountReportBean.reportType == 'J' ||
				accountReportBean.reportType == 'P'}">
				<p:column style="width:110px;">
					<h:outputLabel>Supplier</h:outputLabel>
				</p:column>
				<p:column style="width:10px;">
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column style="width:150px;" colspan="3">
					<h:selectOneMenu Label="Supplier" value="#{accountReportBean.supplierVO.id}">                 
						<f:selectItem itemLabel="All" itemValue="" />   
			            <f:selectItems value="#{accountReportBean.supplierList}" var="vo" itemLabel="#{vo.fullName}" itemValue="#{vo.id}" /> 
				    </h:selectOneMenu>
				</p:column>
			</p:row>
			<!-- <p:row rendered="#{accountReportBean.reportType == 'L'}">
				<p:column style="width:110px;">
					<h:outputLabel>Bank Account</h:outputLabel>
				</p:column>
				<p:column style="width:10px;">
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column style="width:150px;" colspan="3">
					<h:selectOneMenu Label="Bank Account" value="#{accountReportBean.searchParamVO.obj4}">                 
						<f:selectItem itemLabel="All" itemValue="" />   
			            <f:selectItems value="#{accountReportBean.bankAcctViewList}" var="vo" itemLabel="#{vo.name}" itemValue="#{vo}" /> 
				    </h:selectOneMenu>
				</p:column>
			</p:row> -->
			<p:row rendered="#{accountReportBean.reportType == 'M'}">
				<p:column style="width:110px;">
					<h:outputLabel>Journal No.</h:outputLabel>
				</p:column>
				<p:column style="width:10px;">
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column style="width:150px;" colspan="3">
					<h:selectOneMenu Label="Journal No" value="#{accountReportBean.searchParamVO.obj4}">                 
						<f:selectItem itemLabel="All" itemValue="" />   
			            <f:selectItems value="#{accountReportBean.journalList}" var="vo" itemLabel="#{vo.sysNo}" itemValue="#{vo.sysNo}" /> 
				    </h:selectOneMenu>
				</p:column>
			</p:row>
			<!-- <p:row rendered="#{accountReportBean.reportType == 'G' ||
				accountReportBean.reportType == 'I' ||
				accountReportBean.reportType == 'O' ||
				accountReportBean.reportType == 'P'}">
				<p:column style="width:110px;">
					<h:outputLabel>Outstanding Only</h:outputLabel>
				</p:column>
				<p:column style="width:10px;">
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column style="width:150px;" colspan="3">
					<p:selectBooleanCheckbox value="#{accountReportBean.searchParamVO.obj5}"
						rendered="#{accountReportBean.reportType == 'G' || accountReportBean.reportType == 'O'}"/>
					<p:selectBooleanCheckbox value="#{accountReportBean.searchParamVO.obj6}"
						rendered="#{accountReportBean.reportType == 'I' || accountReportBean.reportType == 'P'}"/>
				</p:column>
			</p:row> -->
			<p:row rendered="#{accountReportBean.reportType == 'Q'}">
				<p:column style="width:110px;">
					<h:outputLabel>Group By</h:outputLabel>
				</p:column>
				<p:column style="width:10px;">
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column style="width:150px;" colspan="2">
					<h:selectOneMenu label="Group By" value="#{accountReportBean.groupType}">  
			            <f:selectItem itemLabel="Invoice Date" itemValue="I" /> 
			            <f:selectItem itemLabel="Departure Date" itemValue="D" />
			        </h:selectOneMenu>
	        	</p:column>
			</p:row>
			<p:row rendered="#{accountReportBean.reportType == 'B' || accountReportBean.reportType == 'C'}">
				<p:column>
					<h:outputLabel>Cross Year / Begining Balance Check</h:outputLabel>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column>
					<p:selectBooleanButton value="#{accountReportBean.crossYearCheck}" onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"/>&nbsp;
	        	</p:column>
			</p:row>
			<p:row rendered="#{accountReportBean.reportType == 'M'}">
				<p:column style="width:110px;">
					<h:outputLabel>Show Description</h:outputLabel>
				</p:column>
				<p:column style="width:10px;">
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column style="width:150px;" colspan="2">
					<p:selectBooleanButton value="#{accountReportBean.showDesc}" onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"/>
	        	</p:column>
			</p:row>
		</p:panelGrid>
	</h:form>
</p:panel>

<p:dialog id="idCustListDialog" header="Customer List" widgetVar="varCustListDialog" modal="true"
	resizable="false" dynamic="true" draggable="true" closable="false" onShow="initializeFilters()">
	<h:form id="idCustListForm">
		<ui:include src="customer_list.xhtml" />
	</h:form>
	<script type="text/javascript">
        function initializeFilters() {
            var filters = document.querySelectorAll('#idCustListDialog input.ui-column-filter');
            filters.forEach(function(filter) {
                filter.setAttribute('enterkeyhint', 'enter');
            });
        }
    </script>
</p:dialog>

<!--
	DIALOG - TOUR DEPARTURE LIST
-->
<p:dialog header="Tour Departure List" id="idTourCodeList" widgetVar="varTourCodeList" modal="true" resizable="false" dynamic="true" draggable="true" closable="true" onShow="initializeFilters()">
	<div style="overflow:auto; width:800px !important; height:500px !important;">
	<h:form id="idTourDepListForm">
		<p:dataTable value="#{accountReportBean.tourList}" var="vo" paginator="true" rows="20" 
			paginatorTemplate="#{bterp:pageTemplate()}" 
			rowsPerPageTemplate="10, 20, 30" rowKey="#{vo.id}" selectionMode="single" filterEvent="enter">
			<p:ajax event="rowSelect" listener="#{accountReportBean.handleTourCodeSelect}" oncomplete="varTourCodeList.hide()"  update=":idFormAccountReport:idTourCd" />
			<p:column headerText="Tour Code" sortBy="#{vo.code}" filterBy="#{vo.code}" filterMatchMode="contains" style="width:200px;">
				<h:outputText value="#{vo.code}" />   
			</p:column>
			<p:column headerText="Departure Date" sortBy="#{vo.dtDep}" filterBy="#{accountReportBean.dateFormat(vo.dtDep, 'dd-MMM-yyyy')}" filterMatchMode="contains" style="width:60px;">
				<h:outputText value="#{vo.dtDep}" >
					<f:convertDateTime pattern="#{config['date.display.pattern']}" />
				</h:outputText> 
			</p:column>
			<p:column headerText="Package" sortBy="#{vo.packageDesc}" filterBy="#{vo.packageDesc}" filterMatchMode="contains">
				<h:outputText value="#{vo.packageDesc}" />   
			</p:column>
		</p:dataTable> 
	</h:form>
	</div>
	<script type="text/javascript">
        function initializeFilters() {
            var filters = document.querySelectorAll('#idTourCodeList input.ui-column-filter');
            filters.forEach(function(filter) {
                filter.setAttribute('enterkeyhint', 'enter');
            });
        }
    </script>
</p:dialog>

<!-- DIALOG - TOUR HISTORY -->
<p:dialog id="idTourHistCustDialog" widgetVar="varTourHistCustDialog" modal="true" resizable="false" dynamic="true" draggable="true" hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Tour History"/>
	</f:facet>
	<h:form id="idTourHistCustForm">
		<ui:include src="../../../sales/common/tourHist_cust.xhtml">
			<ui:param name="salesBean" value="#{custBean}" />
		</ui:include>
	</h:form>
</p:dialog> 

<!-- DIALOG - TOUR DEPARTURE MORE INFO -->
<p:dialog widgetVar="varTourDepMoreInfoDialog" header="More Info" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false" style="width:100% !important;">
	<h:form id="idTourDepMoreInfoForm">
		<ui:include src="../../../sales/booking/reserve/more_info.xhtml">
			<ui:param name="salesBean" value="#{custBean}" />
		</ui:include>
	</h:form>
</p:dialog>

</ui:define>
</ui:composition>