					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printCreditorLedger('PDF', 'audit')}" ajax="false" rendered="#{accountReportBean.reportType == 'P'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printCreditorLedger('XLS', 'audit')}" ajax="false" rendered="#{accountReportBean.reportType == 'P'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printSalesInAdvanceRpt('PDF')}" ajax="false" rendered="#{accountReportBean.reportType == 'Q'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{accountReportBean.printSalesInAdvanceRpt('XLS')}" ajax="false" rendered="#{accountReportBean.reportType == 'Q'}" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{accountReportBean.printChartOfAccount('PDF')}" ajax="false" rendered="#{accountReportBean.reportType == 'R'}" onclick="monitorExporting(start,stop)"/>
