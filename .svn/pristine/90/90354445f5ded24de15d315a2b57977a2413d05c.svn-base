					<p:inputText id="idSoldToP" label="Customer Details" value="#{accountReportBean.custDetailsVO.contPersonName}" readonly="true" style="background:#ccc;" rendered="#{accountReportBean.custDetailsVO.custType != 'C'}"/>
					&nbsp;
					<p:commandButton icon="ui-icon-search" update=":idCustListForm" oncomplete="varCustListDialog.show()" process="@this" rendered="#{empty accountReportBean.custDetailsVO.custId}"/>
					<p:commandButton icon="ui-icon-close" actionListener="#{accountReportBean.custClear}" update=":idFormAccountReport:idCustDetails" process="@this" rendered="#{not empty accountReportBean.custDetailsVO.custId}"/>
				</p:panel>
				</p:column>
			</p:row>
			<p:row rendered="#{accountReportBean.reportType == 'Q'}">
				<p:column style="width:110px;">
					<h:outputLabel>Tour Code</h:outputLabel>
				</p:column>
				<p:column style="width:10px;">
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column style="width:150px;" colspan="2">
				<p:panel id="idTourCd">
					 <p:inputText label="Tour Code" value="#{accountReportBean.tourDepVO.code}" readonly="true" size="30"/>
					 &nbsp;
			        <p:commandButton icon="ui-icon-search" actionListener="#{accountReportBean.loadTour}" update=":idTourCodeList" oncomplete="varTourCodeList.show()" process="@this" rendered="#{empty accountReportBean.tourDepVO.id}"/>
					<p:commandButton icon="ui-icon-close" actionListener="#{accountReportBean.clearTourCode}" update=":idFormAccountReport:idTourCd" process="@this" rendered="#{not empty accountReportBean.tourDepVO.id}"/>
				</p:panel>
				</p:column>
			</p:row>
			<p:row rendered="#{accountReportBean.reportType == 'Q'}">
				<p:column style="width:110px;">
					<h:outputLabel>Exclude Account Code</h:outputLabel>
				</p:column>
