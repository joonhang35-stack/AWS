				<p:column style="width:150px;" colspan="2">
					<p:selectCheckboxMenu id="idSalesAccount" value="#{accountReportBean.selectedAcct}" label="Sales Account"
						filter="true" filterMatchMode="contains" panelStyle="width:550px">
						<f:selectItems value="#{accountReportBean.acctList}" var="vo" itemValue="#{vo.id}" itemLabel="#{vo.code} #{vo.desc}"/>
					</p:selectCheckboxMenu>
				</p:column>
			</p:row>
			<p:row rendered="#{accountReportBean.reportType == 'Q'}">
