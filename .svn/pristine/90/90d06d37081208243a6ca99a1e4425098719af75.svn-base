<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="tour_pkg" name="TourPackageVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idTourTheme" type="long" column="id_tour_theme"/>
        <property name="idTourCat" type="long" column="id_tour_cat"/>
        <property name="idCruise" type="long" column="id_cruise"/>
        <property name="idParent" type="long" column="id_parent"/>
        <property name="typeCd" type="string" column="type_cd"/>
        <property name="code" type="string" column="code"/>
        <property name="groupCd" type="string" column="group_cd"/>
        <property name="numDays" type="integer" column="num_days"/>
        <property name="numNights" type="integer" column="num_nights"/>
        <property name="nameEn" type="string" column="name_en"/>
        <property name="nameZh" type="string" column="name_zh"/>
        <property name="nameOther" type="string" column="name_other"/>
        <property name="nameOtherZh" type="string" column="name_other_zh"/>
        <property name="isMuslimPkg" type="boolean" column="is_muslim_pkg"/>
        <property name="isThemeTour" type="boolean" column="is_theme_tour"/>
        <property name="isTopPkg" type="boolean" column="is_top_pkg"/>
        <property name="isOptional" type="boolean" column="is_optional"/>
        <property name="isNew" type="boolean" column="is_new"/>
        <property name="isPromo" type="boolean" column="is_promo"/>
        <property name="isPushToOnline" type="boolean" column="is_push_to_online"/>
        <property name="isAllowBooking" type="boolean" column="is_allow_booking"/>
        <property name="isVisaRequired" type="boolean" column="is_visa_required"/>
        <property name="seasonCd" type="string" column="season_cd"/>
        <property name="year" type="string" column="year"/>
        <property name="langCode" type="string" column="lang_cd"/>
        <property name="deposit" type="double" column="deposit"/>
        <property name="bagDeduction" type="double" column="bag_deduction"/>
        <property name="tfairDiscount" type="double" column="tfair_discount"/>
        <property name="priceDiffSgl" type="double" column="price_diff_sgl"/>
        <property name="priceDiffCtw" type="double" column="price_diff_ctw"/>
        <property name="priceDiffCwb" type="double" column="price_diff_cwb"/>
        <property name="priceDiffCnb" type="double" column="price_diff_cnb"/>
        <property name="grndSgl" type="double" column="grnd_sgl"/>
        <property name="grndCtw" type="double" column="grnd_ctw"/>
        <property name="grndCwb" type="double" column="grnd_cwb"/>
        <property name="grndCnb" type="double" column="grnd_cnb"/>
        <property name="cnaAdt" type="double" column="cna_adt"/>
        <property name="cpaAdt" type="double" column="cpa_adt"/>
        <property name="csiAdt" type="double" column="csi_adt"/>
        <property name="priceFrom" type="double" column="price_from"/>
        <property name="priceTo" type="double" column="price_to"/>
        <property name="idSalesCommConf" type="long" column="id_sales_comm_conf"/>
        <property name="deadline" type="integer" column="deadline"/>
        <property name="highLight" type="string" column="high_light"/>
        <property name="highLightZh" type="string" column="high_light_zh"/>
        <property name="dtBookStart" type="timestamp" column="dt_book_start"/>
        <property name="dtBookEnd" type="timestamp" column="dt_book_end"/>
        <property name="dtTravelStart" type="timestamp" column="dt_travel_start"/>
        <property name="dtTravelEnd" type="timestamp" column="dt_travel_end"/>
        <property name="reserved1" type="string" column="reserved_1"/>
        <property name="reserved2" type="string" column="reserved_2"/>
        <property name="reserved3" type="string" column="reserved_3"/>
        <property name="regions" type="string" column="regions"/>
        <property name="countries" type="string" column="countries"/>
        <property name="seq" type="integer" column="seq"/>
        <property name="fullRemarks" type="string" column="full_remarks"/>
        <property name="fullRemarksZh" type="string" column="full_remarks_zh"/>
        <property name="grndRemarks" type="string" column="grnd_remarks"/>
        <property name="grndRemarksZh" type="string" column="grnd_remarks_zh"/>
        <property name="opPic" type="string" column="op_pic"/>
        
        <!-- BaseVO attributes -->
		<property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
		<property name="version" type="long" column="version"/>
    </class>
</hibernate-mapping>