<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="tour_dep" name="TourDepartureVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idTourPkg" type="long" column="id_tour_pkg"/>
        <property name="seqNo" type="integer" column="seq_no"/>
        <property name="idAirline" type="long" column="id_airline"/>
        <property name="idAirlineSchedule" type="long" column="id_airline_schedule"/>
        <property name="idTourOperator" type="long" column="id_tour_operator"/>
        <property name="idDepartment" type="string" column="id_dpt"/>
        <property name="dtDep" type="timestamp" column="dt_dep"/>
        <property name="numDays" type="integer" column="num_days"/>
        <property name="numNights" type="integer" column="num_nights"/>
        <property name="code" type="string" column="code"/>
        <property name="desc" type="string" column="description"/>
        <property name="descZh" type="string" column="description_zh"/>
        <property name="langCode" type="string" column="lang_cd"/>
        <property name="fullTwn" type="double" column="full_twn"/>
        <property name="fullSgl" type="double" column="full_sgl"/>
        <property name="fullCtw" type="double" column="full_ctw"/>
        <property name="fullCeb" type="double" column="full_ceb"/>
        <property name="fullCnb" type="double" column="full_cnb"/>
        <property name="grndTwn" type="double" column="grnd_twn"/>
        <property name="grndSgl" type="double" column="grnd_sgl"/>
        <property name="grndCtw" type="double" column="grnd_ctw"/>
        <property name="grndCeb" type="double" column="grnd_ceb"/>
        <property name="grndCnb" type="double" column="grnd_cnb"/>
        <property name="airfareTwn" type="double" column="airfare_twn"/>
        <property name="airfareSgl" type="double" column="airfare_sgl"/>
        <property name="airfareCtw" type="double" column="airfare_ctw"/>
        <property name="airfareCeb" type="double" column="airfare_ceb"/>
        <property name="airfareCnb" type="double" column="airfare_cnb"/>
        <property name="isGroundNotApplicable" type="boolean" column="is_ground_not_applicable"/>
        <property name="tourMgrCost" type="double" column="tour_mgr_cost"/>
        <property name="tfairDiscount" type="double" column="tfair_discount"/>
        <property name="cnaAdt" type="double" column="cna_adt"/>
        <property name="cpaAdt" type="double" column="cpa_adt"/>
        <property name="csiAdt" type="double" column="csi_adt"/>
        <property name="miscAdt" type="double" column="misc_adt"/>
        <property name="miscChd" type="double" column="misc_chd"/>
        <property name="fullRemarks" type="string" column="full_remarks"/>
        <property name="grndRemarks" type="string" column="grnd_remarks"/>
        <property name="prn" type="string" column="prn"/>
        <property name="tourManagerPax" type="integer" column="tour_mgr_pax"/>
        <property name="seatAllot" type="integer" column="seat_allotment"/>
        <property name="reservedSeat" type="integer" column="reserved_seat"/>
        <property name="reservedSeatReason" type="string" column="reserved_seat_reason"/>
        <property name="travelInsPolicyS" type="string" column="travel_ins_policy_s"/>
        <property name="travelInsPolicyF" type="string" column="travel_ins_policy_f"/>
        <property name="deadline" type="integer" column="deadline"/>
        <property name="isShowAirline" type="boolean" column="is_show_airline"/>
        <property name="isIssuedS" type="boolean" column="is_issued_s"/>
        <property name="isIssuedF" type="boolean" column="is_issued_f"/>
        <property name="isRemainTc" type="boolean" column="is_remain_tc"/>
        <property name="isDepositPaid" type="boolean" column="is_deposit_paid"/>
        <property name="isPush" type="boolean" column="is_push"/>
        <property name="isHotDeal" type="boolean" column="is_hot_deal"/>
        <property name="isPushToOnline" type="boolean" column="is_push_to_online"/>
        <property name="isVisaRequired" type="boolean" column="is_visa_required"/>
        <property name="isLock" type="boolean" column="is_lock"/>
        <property name="isPrivateTour" type="boolean" column="is_private_tour"/>
        <property name="invRemarks" type="string" column="inv_remarks"/>
        <property name="insuranceRemarks" type="string" column="insurance_remarks"/>
        <property name="opPic" type="string" column="op_pic"/>
        <property name="privatePic" type="string" column="private_pic"/>
        <property name="idTourLeader" type="long" column="id_tour_leader"/>
        <property name="idTourGuide" type="long" column="id_tour_guide"/>
        <property name="airlineScheduleItems" type="string" column="airline_schedule_items"/>
        <property name="airlineScheduleItemsBySeq" type="string" column="airline_schdl_itms_w_seq"/>
        <property name="airlineScheduleItemsByEtd" type="string" column="airline_schdl_itms_w_etd"/>
        <property name="airlineScheduleItemsByEta" type="string" column="airline_schdl_itms_w_eta"/>
        <property name="airlineScheduleItemsByDepDt" type="string" column="airline_schdl_itms_w_depDt"/>
        <property name="airlineScheduleItemsByArrDt" type="string" column="airline_schdl_itms_w_arrDt"/>
        <property name="airlineScheduleItemsByRemarks" type="string" column="airline_schdl_itms_w_remarks"/>
        <property name="tourStatusCd" type="string" column="tour_status_cd"/>
        <property name="tourStatusReason" type="string" column="tour_status_reason"/>
        <property name="tourPkgDailyCms" type="long" column="tour_pkg_daily_cms" />
        
        <property name="idCruise" type="long" column="id_cruise"/>
        <property name="idCruiseSchedule" type="long" column="id_cruise_schedule"/>
        <property name="isShowCruise" type="boolean" column="is_show_cruise"/>
        <property name="cruiseScheduleItems" type="string" column="cruise_schedule_items"/>
        <property name="cruiseScheduleItemsBySeq" type="string" column="cruise_schdl_itms_w_seq"/>
        <property name="cruiseScheduleItemsByEtd" type="string" column="cruise_schdl_itms_w_etd"/>
        <property name="cruiseScheduleItemsByEta" type="string" column="cruise_schdl_itms_w_eta"/>
        <property name="cruiseScheduleItemsByDepDt" type="string" column="cruise_schdl_itms_w_depDt"/>
        <property name="cruiseScheduleItemsByArrDt" type="string" column="cruise_schdl_itms_w_arrDt"/>
        <property name="cruiseScheduleItemsByRemarks" type="string" column="cruise_schdl_itms_w_remarks"/>
        
        <!-- BaseVO attributes -->
        <property name="version" type="long" column="version"/>
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>