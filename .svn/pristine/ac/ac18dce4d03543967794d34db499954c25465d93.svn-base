<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
				template="/WEB-INF/views/layouts/main.xhtml">

<ui:define name="content">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
<script type="text/javascript">
function onValidationBillList(xhr, status, args, tempX) {
	if (!args.validationFailed) {   
		if(!args.validateError)
			if (tempX == 1) varMultiPmntDialog.show();
			else varAttachPmntDialog.show();
	} 
	
}

function subTotalRecal() {
	var totalAmt=0;
	var totalPaid=0;
	var totalBal=0;
	var totalAllocate=0;
	var tbody = $(document.getElementById('idBillListForm:idPurBillPmntTable')).find('tbody');
	var tfoot = $(document.getElementById('idBillListForm:idPurBillPmntTable')).find('tfoot');
	
	if (tfoot.find('tr').eq(0).find('td').eq(1).find('div').text().indexOf("Sub Total:") == -1) {
		return true;
	}
	
	tbody.find('tr').each(function (key, val) {
		var totalSubBillAmt = tbody.find('tr').eq(key).find('td').eq(9).find('div').text();
		var totalSubAmtPaid = tbody.find('tr').eq(key).find('td').eq(10).find('div').text();
		var totalSubCurBal = tbody.find('tr').eq(key).find('td').eq(11).find('div').text();
		var totalSubAmtAllocate = tbody.find('tr').eq(key).find('td').eq(12).find('input').val();
		if (typeof totalSubAmtAllocate === 'undefined') {
			totalSubAmtAllocate = "0.0";
		}
		totalSubBillAmt = totalSubBillAmt.replace(",", "");
		totalSubAmtPaid = totalSubAmtPaid.replace(",", "");
		totalSubCurBal = totalSubCurBal.replace(",", "");
		totalSubAmtAllocate = totalSubAmtAllocate.replace(",", "");
		totalAmt += parseFloat(totalSubBillAmt);
		totalPaid += parseFloat(totalSubAmtPaid);
		totalBal += parseFloat(totalSubCurBal);
		totalAllocate += parseFloat(totalSubAmtAllocate);
    });
	var fmtTotal = 0;
	
	fmtTotal = formatNumber(totalAmt);
	tfoot.find('tr').eq(0).find('td').eq(2).find('div').text(fmtTotal);
	fmtTotal = formatNumber(totalPaid);
	tfoot.find('tr').eq(0).find('td').eq(3).find('div').text(fmtTotal);
	fmtTotal = formatNumber(totalBal);
	tfoot.find('tr').eq(0).find('td').eq(4).find('div').text(fmtTotal);
	fmtTotal = formatNumber(totalAllocate);
	tfoot.find('tr').eq(0).find('td').eq(5).find('div').text(fmtTotal);
}

function formatNumber(number) {
    number = number.toFixed(2) + '';
    x = number.split('.');
    x1 = x[0];
    x2 = x.length > 1 ? '.' + x[1] : '';
    var rgx = /(\d+)(\d{3})/;
    while (rgx.test(x1)) {
        x1 = x1.replace(rgx, '$1' + ',' + '$2');
    }
    return x1 + x2;
}

document.addEventListener('DOMContentLoaded', function() {
    var filters = document.querySelectorAll('input.ui-column-filter');
    filters.forEach(function(filter) {
        filter.setAttribute('enterkeyhint', 'enter');
    });
});
</script>

<p:panel header="Bill Payment" toggleable="true" toggleSpeed="500">
<h:form id="idBillListForm">
	<p:growl id="msg"/>
	<p:panelGrid columns="14" cellpadding="0" cellspacing="2" style="width:300px;">
		<p:commandButton value="Add" oncomplete="varAddFuncDialog.show()" update=":idDetailsDialog">
			<f:actionListener binding="#{billPymtBean.addBill()}"></f:actionListener>
			<f:actionListener binding="#{journalBean.handleJournalDetailAddNew()}"></f:actionListener>
		</p:commandButton>
		<p:separator style="width:2px;height:20px" />
		<p:commandButton value="Multiple Bills Payment" style="width:160px" actionListener="#{billPymtBean.onMultiBillsPymt}" process="@this" update="@form,:idMultiPmntForm,:idBillListForm:idPurBillPmntTable"/>
		<p:separator style="width:2px;height:20px" />
		<p:commandButton value="Multiple E-Invoice Submission" style="width:220px" styleClass="nowrap" oncomplete="varMulpEInvDialog.show()" update=":idMulpEInvDialog :idMulpEInvForm" process="@this" rendered="#{billPymtBean.invPmntAuthVO.eInvoice}"></p:commandButton>
		<p:separator style="width:2px;height:20px" />
		<p:commandButton value="Consolidate E-Invoice Submission" style="width:220px" styleClass="nowrap" oncomplete="varConsolEInvDialog.show()" update=":idConsolEInvDialog" process="@this" rendered="#{billPymtBean.invPmntAuthVO.eInvoice}"></p:commandButton>
		<p:separator style="width:2px;height:20px" />
	 	<p:calendar id="idBillDateFr" label="Bill Date From" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{billPymtBean.billFromDate}">
	 		<p:ajax event="dateSelect" listener="#{billPymtBean.handleBillDtChange}"
				oncomplete="purBillPmntTable.clearFilters()" update=":idBillListForm:idPurBillPmntTable :idBillListForm:msg"/>
	 	</p:calendar>
		<p:watermark for="idBillDateFr" value="Bill Date From" />
		<p:calendar id="idBillDateTo" label="Bill Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{billPymtBean.billToDate}">
	 		<p:ajax event="dateSelect" listener="#{billPymtBean.handleBillDtChange}"
				oncomplete="purBillPmntTable.clearFilters()" update=":idBillListForm:idPurBillPmntTable :idBillListForm:msg"/>
	 	</p:calendar>
		<p:watermark for="idBillDateTo" value="Bill Date To" />
		<p:separator style="width:2px;height:20px" />
		<p:selectOneButton id="idPrintType" value="#{billPymtBean.countryFilter}" style="display: flex" styleClass="nowrap">
	 		<f:selectItem itemLabel="Both" itemValue="ALL"/>
            <f:selectItem itemLabel="Foreign Supplier" itemValue="F" />
            <f:selectItem itemLabel="Local Supplier" itemValue="L"/>
            <p:ajax event="change" update="@form" listener="#{billPymtBean.loadBillList}"></p:ajax>
        </p:selectOneButton>
<!-- 		<p:commandButton value="Multiple Bills Payment" style="width:160px" actionListener="#{billPymtBean.onMultiBillsPymt}" process="@this" update="@form,:idMultiPmntForm,:idBillListForm:idPurBillPmntTable"/>
 -->		
		<!-- <p:commandButton id="toggler" value="Columns" style="float:left"
			icon="ui-icon-calculator"
			actionListener="#{billPymtBean.handleChangeColumnsViewClick}"
			oncomplete="varListingTableViewDialog.show();" process="@this"
			update=":idListingTableViewDialog" />
			<p:separator style="width:2px;height:20px" />
		<h:commandLink value="Export"
			styleClass="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-icon-left ui-button-text"
			style="padding: .5em 1em;">
			<p:dataExporter type="xls" target="idPurBillPmntTable"
				fileName="Exorder" postProcessor="#{billPymtBean.postProcessXLS}"/>
		</h:commandLink> -->
	</p:panelGrid>
	<p:panelGrid rendered="#{billPymtBean.blMultiPymt}" columns="7" cellpadding="0" cellspacing="2" style="width:990px;">
		<h:outputLabel>Supplier Type <span class="required">* </span></h:outputLabel>
		<p:selectOneButton id="idSuppType" value="#{billPymtBean.suppTypeFilter}" style="display: flex" styleClass="nowrap">
	 		<f:selectItem itemLabel="Both" itemValue="ALL"/>
            <f:selectItem itemLabel="TRADE CREDITOR" itemValue="TC" />
            <f:selectItem itemLabel="SUNDRY CREDITOR" itemValue="SC"/>
            <p:ajax event="change" update="@form, :idBillListForm:idShowSuppName"  listener="#{billPymtBean.handleSuppTypeSelecttion()}"  oncomplete="subTotalRecal()"></p:ajax>
        </p:selectOneButton>
		<h:outputLabel>Supplier <span class="required">* </span></h:outputLabel>
	    <p:selectCheckboxMenu id="idShowSuppName" label="Supplier" value="#{billPymtBean.idSupplierList}"
			filter="true" filterMatchMode="contains" style="width:150px; display:block;" onHide="executeOnOnhide();">
			<f:selectItems value="#{billPymtBean.multiSuppList}" var="vo" itemLabel="#{vo.fullName}" itemValue="#{vo.id}" /> 
		</p:selectCheckboxMenu>
	    <p:remoteCommand name="executeOnOnhide" actionListener="#{billPymtBean.handleSuppSelection()}" update=":idBillListForm:idPurBillPmntTable"
	    	oncomplete="subTotalRecal()"/>
	    
	    <p:commandButton value="Apply Payment" actionListener="#{billPymtBean.onMultiPmntClick}" oncomplete="onValidationBillList(xhr, status, args, 1)" process="@form" update="@form,:idMultiPmntForm,idPurBillPmntTable"/>
	    <p:commandButton value="Attach Payment" actionListener="#{billPymtBean.onAttachPmntClick}" oncomplete="onValidationBillList(xhr, status, args, 2)" process="@form" update="@form,:idAttachPmntDialog,:idAttachPmntForm" 
	    	rendered="#{billPymtBean.invPmntAuthVO.accountManager}"/>
	</p:panelGrid>
	
	<p:dataTable id="idPurBillPmntTable" widgetVar="purBillPmntTable" value="#{billPymtBean.lazyDataModel}" var="purBillPmnt" paginator="true" rows="20"  
		paginatorTemplate="#{bterp:pageTemplate()}" 
		rowsPerPageTemplate="10, 20, 30, 100, 300, 500, 1000, 1500" lazy="true" filterEvent="enter" rowStyleClass="#{purBillPmnt.amtAllocate ne 0 and billPymtBean.blMultiPymt ? 'group-color-one' : ''}"
		rowKey="#{purBillPmnt.id}" selectionMode="single">
		
		<p:ajax event="page" oncomplete="subTotalRecal()"/>
		<p:ajax event="sort" oncomplete="subTotalRecal()"/>
		<p:ajax event="filter" oncomplete="subTotalRecal()"/>
		
		<p:column headerText="Edit" style="width:40px; text-align:center;" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(1)}" exportable="false">
			<p:commandButton icon="ui-icon-pencil" actionListener="#{billPymtBean.onBillSelected(purBillPmnt.id)}" update=":idDetailsDialog :idAddFuncForm:idJournalList" oncomplete="varAddFuncDialog.show()">
				<!-- <f:actionListener binding="#{billPymtBean.onBillSelected(purBillPmnt.id)}"></f:actionListener> -->
				<!-- <f:actionListener binding="#{journalBean.onJournalSelected(billPymtBean.exOrderBillVO.idJournal)}"></f:actionListener> -->
			</p:commandButton>
		</p:column>
		<p:column headerText="Delete" style="width:50px; text-align:center;" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(2)}" exportable="false">
			<p:commandButton icon="ui-icon-close" actionListener="#{billPymtBean.onBillSelected(purBillPmnt.id)}" oncomplete="varDelEODialog.show()" 
				rendered="#{(purBillPmnt.status != 'CC' and purBillPmnt.status != 'VD')}" />
		</p:column>
		<p:column headerText="Pay" style="width:50px; text-align:center;" rendered="#{billPymtBean.blMultiPymt == true and billPymtBean.listingTableViewVO.verifyVisibility(3)}" exportable="false">
			<p:commandButton icon="ui-icon-plus" actionListener="#{billPymtBean.onBillPay(purBillPmnt, true)}" update="@form,idPurBillPmntTable" process="@this" 
							disabled="#{(purBillPmnt.status eq 'CC' or purBillPmnt.billAmt eq purBillPmnt.amtPaid)}" oncomplete="subTotalRecal()"/>
		</p:column>
		<p:column headerText="Bill Id" sortBy="#{purBillPmnt.code}" style="width:60px;" filterStyle="width:60px;" styleClass="txt_center" filterBy="#{purBillPmnt.code}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(4)}">
			<f:facet name="header"><h:outputText value="Bill Id" /></f:facet>
			<h:outputText value="#{purBillPmnt.code}" />
		</p:column>
		<p:column headerText="Supplier Name" sortBy="#{purBillPmnt.supplierName}" style="width: 80px;" styleClass="txt_center" filterBy="#{purBillPmnt.supplierName}" filterMatchMode="contains" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(5)}">
			<f:facet name="header"><h:outputText value="Supplier Name" /></f:facet>
			<h:outputText value="#{purBillPmnt.supplierName}" />
		</p:column>
		<!-- <p:column headerText="Payee" sortBy="#{purBillPmnt.supplierName}" style="width: 80px;" styleClass="txt_center" filterBy="#{purBillPmnt.supplierName}" filterMatchMode="contains" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(5)}"> -->
		<p:column headerText="Payee" style="width: 80px;" styleClass="txt_center" filterBy="#{purBillPmnt.payeeDisplayName}" filterMatchMode="contains" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(5)}">
			<f:facet name="header"><h:outputText value="Payee" /></f:facet>
			<!-- <h:outputText value="#{bterp:lookupItemDesc('salutatn', purBillPmnt.payeeSalutatn)} " />
			<h:outputText value="#{purBillPmnt.payee}" /> -->
			<h:outputText value="#{purBillPmnt.payeeDisplayName}"></h:outputText>
		</p:column>
		<p:column headerText="Bill Date" sortBy="#{purBillPmnt.billDt}" style="width: 80px;" styleClass="txt_center" filterBy="#{purBillPmnt.billDt}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(6)}">
			<f:facet name="header"><h:outputText value="Bill Date" /></f:facet>
			<h:outputText value="#{purBillPmnt.billDt}" >
				<f:convertDateTime pattern="#{config['date.display.pattern']}" />
			</h:outputText>
		</p:column>
		<p:column headerText="EO No" sortBy="#{purBillPmnt.eoCode}" style="width:60px;" filterStyle="width:60px;" styleClass="txt_center" filterBy="#{purBillPmnt.eoCode}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(7)}">
			<f:facet name="header"><h:outputText value="EO No" /></f:facet>
			<h:outputText value="#{purBillPmnt.eoCode}" />
		</p:column>
		<p:column headerText="Tax Code Applied" sortBy="#{purBillPmnt.taxCodeGroup}" style="width: 80px;" filterBy="#{purBillPmnt.taxCodeGroup}" filterMatchMode="contains" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(8)}">
			<f:facet name="header"><h:outputText value="Tax Code Applied" /></f:facet>
			<h:outputText value="#{purBillPmnt.taxCodeGroup}" />
		</p:column>
		<p:column headerText="Amount" sortBy="#{purBillPmnt.billAmt}" style="width: 80px;" styleClass="txt_center" filterBy="#{purBillPmnt.billAmt}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(9)}">
			<f:facet name="header"><h:outputText value="Amount" /></f:facet>
			<h:outputText value="#{purBillPmnt.billAmt}" >
				<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
			</h:outputText>
		</p:column>
		<p:column headerText="Payment Amount" sortBy="#{purBillPmnt.amtPaid}" style="width: 80px;" styleClass="txt_center" filterBy="#{purBillPmnt.amtPaid}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(10)}">
			<f:facet name="header"><h:outputText value="Payment Amount" /></f:facet>
			<h:outputText value="#{purBillPmnt.amtPaid}" >
				<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
			</h:outputText>
		</p:column>
		<p:column headerText="Current Balance" sortBy="#{purBillPmnt.curBal}" style="width: 80px;" styleClass="txt_center" filterBy="#{purBillPmnt.curBal}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(11)}">
			<f:facet name="header"><h:outputText value="Current Balance" /></f:facet>
			<h:outputText value="#{purBillPmnt.curBal}" >
				<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
			</h:outputText>
		</p:column>
		<p:column headerText="Amount to Allocate"  style="width: 80px;" styleClass="txt_center" rendered="#{billPymtBean.blMultiPymt == true and billPymtBean.listingTableViewVO.verifyVisibility(12)}">
			<f:facet name="header"><h:outputText value="Amount to Allocate" /></f:facet>
			<p:inputText id="idAmountToAllocate" colspan="3" label="Amount to Allocate" value="#{purBillPmnt.amtAllocate}" rendered="#{purBillPmnt.curBal!=0}">
				<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
				<p:ajax event="blur" listener="#{billPymtBean.onBillPay(purBillPmnt, false)}" update="idPurBillPmntTable" process="@this" oncomplete="subTotalRecal()"/>
			</p:inputText>
		</p:column>
		<p:column headerText="Reason for Expense" sortBy="#{purBillPmnt.exReason}" width="200" filterBy="#{purBillPmnt.exReason}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(17)}">
			<f:facet name="header"><h:outputText value="Reason for Expense" /></f:facet>
			<h:outputText value="#{purBillPmnt.exReason}" />
		</p:column>
		<p:column headerText="Due Date" sortBy="#{purBillPmnt.dueDt}" style="width: 70px;" filterStyle="width:70px;" styleClass="txt_center" filterBy="#{purBillPmnt.dueDt}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(13)}">
			<f:facet name="header"><h:outputText value="Due Date" /></f:facet>
			<h:outputText value="#{purBillPmnt.dueDt}" >
				<f:convertDateTime pattern="#{config['date.display.pattern']}" />
			</h:outputText>
		</p:column>
		<p:column headerText="Tour Code"  style="width: 80px;" styleClass="txt_center"   filterBy="#{purBillPmnt.tourCode}" filterMatchMode="contains" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(14)}">
			<f:facet name="header"><h:outputText value="Tour Code" /></f:facet>
			<h:outputText value="#{purBillPmnt.tourCode}" />
		</p:column>
		<p:column headerText="Invoice/CN No." sortBy="#{purBillPmnt.cnNumber}" style="width: 80px;" styleClass="txt_center" filterBy="#{purBillPmnt.cnNumber}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(15)}">
			<f:facet name="header"><h:outputText value="Invoice/CN No." /></f:facet>
			<h:outputText value="#{purBillPmnt.cnNumber}" />
		</p:column>
		<p:column headerText="AWS Invoice No." sortBy="#{purBillPmnt.invoices}" style="width: 80px;" styleClass="txt_center" filterBy="#{purBillPmnt.invoices}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(16)}">
			<f:facet name="header"><h:outputText value="AWS Invoice No." /></f:facet>
			<h:outputText value="#{purBillPmnt.invoices}" />
		</p:column>
		<!-- Joon Hang - show paymentNo in Table -->
		<p:column headerText="Payment No." width="180" styleClass="txt_center" filterBy="#{purBillPmnt.codePayment}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(16)}">
			<f:facet name="header"><h:outputText value="Payment No." /></f:facet>
			<h:outputText value="#{purBillPmnt.codePayment}" escape="false"/>
		    <p:commandLink actionListener="#{billPymtBean.viewPaymentForBillPayment(purBillPmnt.id)}" oncomplete="varPaymentDetailsDialog.show()" process="@this" update=":idPaymentDetailsDialog" rendered="#{not empty purBillPmnt.codePayment}">
		    	<i class="fa fa-info-circle" aria-hidden="true" />
		    </p:commandLink>
		</p:column>
		<p:column headerText="Comments" sortBy="#{purBillPmnt.comments}" width="200" filterBy="#{purBillPmnt.comments}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(18)}">
			<f:facet name="header"><h:outputText value="Comments" /></f:facet>
			<h:outputText value="#{purBillPmnt.comments}" />
		</p:column>
		<p:column headerText="Country" sortBy="#{purBillPmnt.countryVO.country}" style="width: 80px;" styleClass="txt_center" filterBy="#{purBillPmnt.countryVO.country}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(19)}">
			<f:facet name="header"><h:outputText value="Country" /></f:facet>
			<h:outputText value="#{purBillPmnt.countryVO.country}" />
		</p:column>
		<p:column headerText="Status" sortBy="#{purBillPmnt.status}" style="width: 80px;" styleClass="txt_center" filterBy="#{purBillPmnt.status}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(19)}">
			<f:facet name="header"><h:outputText value="Status" /></f:facet>
			<h:outputText value="#{zsg:referenceDataValue('BILL_STATUS', purBillPmnt.status)}" />
		</p:column>
		<p:column headerText="E-Invoice Status" sortBy="#{purBillPmnt.eInvoiceStatus}" style="width: 80px;" styleClass="txt_center" filterBy="#{purBillPmnt.eInvoiceStatus}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(19)}">
			<f:facet name="header"><h:outputText value="E-Invoice Status" /></f:facet>
			<h:outputText value="#{purBillPmnt.eInvoiceStatus}" />
		</p:column>
		<p:column headerText="Updated By" sortBy="#{purBillPmnt.updatedBy}" style="width: 70px;" filterStyle="width:70px;" styleClass="txt_center" filterBy="#{purBillPmnt.updatedBy}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(20)}">
			<f:facet name="header"><h:outputText value="Updated By" /></f:facet>
			<h:outputText value="#{purBillPmnt.updatedBy}" />
		</p:column>
		<p:column headerText="Updated Date" sortBy="#{purBillPmnt.updatedDate}" style="width: 70px;" filterStyle="width:70px;" styleClass="txt_center" filterBy="#{purBillPmnt.updatedDate}" rendered="#{billPymtBean.listingTableViewVO.verifyVisibility(21)}">
			<f:facet name="header"><h:outputText value="Updated Date" /></f:facet>
			<h:outputText value="#{purBillPmnt.updatedDate}"><f:convertDateTime pattern="#{config['date.display.pattern']} HH:mm:ss"/></h:outputText>
		</p:column>
		
		<p:columnGroup type="footer">
			<p:row rendered="#{billPymtBean.blMultiPymt}">
            	<p:column footerText="" colspan="7" rendered="#{billPymtBean.blMultiPymt != true}"/>
            	<p:column footerText="" colspan="8" rendered="#{billPymtBean.blMultiPymt == true}"/>
                <p:column footerText="Sub Total:"  style="text-align:right"  />
                <p:column footerText="#{billPymtBean.getDoubleDecimalFormat(config['amount.format.pattern'], billPymtBean.totalAmtMap['totalSubBillAmt'])}" />
                <p:column footerText="#{billPymtBean.getDoubleDecimalFormat(config['amount.format.pattern'], billPymtBean.totalAmtMap['totalSubAmtPaid'])}" />
                <p:column footerText="#{billPymtBean.getDoubleDecimalFormat(config['amount.format.pattern'], billPymtBean.totalAmtMap['totalSubCurBal'])}" />
            	<p:column footerText="#{billPymtBean.getDoubleDecimalFormat(config['amount.format.pattern'], billPymtBean.totalAmtMap['totalSubAmtAllocate'])}" rendered="#{billPymtBean.blMultiPymt}"/>
                <p:column footerText="" colspan="8" rendered="#{billPymtBean.blMultiPymt != true}"/>
            	<p:column footerText="" colspan="12" rendered="#{billPymtBean.blMultiPymt == true}"/>
			</p:row>
            <p:row>
            	<p:column footerText="" colspan="7"/>
            	<p:column footerText="" rendered="#{billPymtBean.blMultiPymt == true}"/>
                <p:column footerText="Grand Total:"  style="text-align:right"  />
                <p:column footerText="#{billPymtBean.getDoubleDecimalFormat(config['amount.format.pattern'], billPymtBean.totalAmtMap['totalBillAmt'])}" />
                <p:column footerText="#{billPymtBean.getDoubleDecimalFormat(config['amount.format.pattern'], billPymtBean.totalAmtMap['totalAmtPaid'])}" />
                <p:column footerText="#{billPymtBean.getDoubleDecimalFormat(config['amount.format.pattern'], billPymtBean.totalAmtMap['totalCurBal'])}" />
            	<!-- <p:column footerText="#{billPymtBean.getDoubleDecimalFormat(config['amount.format.pattern'], billPymtBean.totalAmtMap['totalAmtAllocate'])}" rendered="#{billPymtBean.blMultiPymt}"/> -->
                <p:column footerText="" colspan="13"/> 
            </p:row>  
		</p:columnGroup>
	</p:dataTable>
	
	<br/>
	<!-- <h:commandLink
		action="#{billPymtBean.validateAndExport}" >
		<p:graphicImage value="/img/excel.png" />
		<p:dataExporter type="dataSizeCheckingCSV" target="idPurBillPmntTable" fileName="L"/>
	</h:commandLink>
	<p:commandButton value="Export CSV" action="#{billPymtBean.validateAndExport}" update="msg">
    	<p:dataExporter type="csv" target="idPurBillPmntTable" fileName="L"/>
	</p:commandButton> -->
	
	<h:panelGrid columns="2" style="width: 10px">
		<p:commandButton value="Add" actionListener="#{billPymtBean.addBill}" oncomplete="varAddFuncDialog.show()" update=":idDetailsDialog"/>
		<p:commandButton value="Export" actionListener="#{billPymtBean.validateBillListExport}" update="msg" oncomplete="if (args &amp;&amp; !args.validationFailed) varExportDialog.show()"/>
	</h:panelGrid>
</h:form>
</p:panel>

