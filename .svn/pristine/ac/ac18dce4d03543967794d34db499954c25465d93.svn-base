<p:dialog id="idEmployeeListDialog" header="Employee List"
	widgetVar="varEmployeeListDialog" modal="true" resizable="false"
	dynamic="true" draggable="true" closable="false">
	<h:form id="idEmployeeListForm">
		<p:dataTable widgetVar="varEmployeeListTable"
			value="#{billPymtBean.employeeList}" var="vo" paginator="true"
			rows="10"
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
			rowsPerPageTemplate="10, 20, 30" rowKey="#{vo.id}"
			selectionMode="single" filterEvent="enter">
			<p:ajax event="rowSelect"
				listener="#{billPymtBean.handleEmployeeSelect}"
				update=":idAddFuncForm:idPayee,:idAddFuncForm:idEoBillPersonListTable"
				oncomplete="varEmployeeListTable.clearFilters();varEmployeeListDialog.hide();"
				process="@this" />

			<p:column headerText="Employee ID" sortBy="#{vo.id}"
				filterBy="#{vo.id}">
				<h:outputText value="#{vo.id}" />
			</p:column>
			<p:column headerText="User Name" sortBy="#{vo.userVO.name}"
				filterBy="#{vo.userVO.name}"
				style="font-size:10px; width:200px;">
				<h:outputText value="#{vo.userVO.name}" />
			</p:column>
			<p:column headerText="Name" sortBy="#{vo.fullName}" filterBy="#{vo.fullName}" style="font-size:10px; width:200px;">
				<h:outputText value="#{vo.fullName}" />
			</p:column>
		</p:dataTable>
		<h:panelGrid columns="1">
			<p:commandButton value="#{msg['common.button.label.cancel']}"
				onclick="varEmployeeListDialog.hide();varEmployeeListTable.clearFilters();" />
		</h:panelGrid>
	</h:form>
</p:dialog>

		<!-- DIALOG - POST JOURNAL - TOUR LIST -->
		<p:dialog id="idTourListDialog" header="Tour List"
			widgetVar="varTourListDialog" modal="true" resizable="false"
			dynamic="true" draggable="true" closable="false">
			<h:form id="idTourListForm">
				<p:dataTable widgetVar="varTourListTable"
					value="#{journalBean.lazyDataModelTourDep}" var="vo" paginator="true"
					rows="10" lazy="true"
					paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
					rowsPerPageTemplate="10, 20, 30" rowKey="#{vo.id}"
					selectionMode="single" filterEvent="enter">
					<p:ajax event="rowSelect"
						listener="#{journalBean.handleTourDepSelect}"
						update=":idJournalCartForm:idTour"
						oncomplete="varTourListTable.clearFilters();varTourListDialog.hide();"
						process="@this" />

					<p:column headerText="Tour Code" sortBy="#{vo.code}"
						filterBy="#{vo.code}">
						<h:outputText value="#{vo.code}" />
					</p:column>
					<p:column headerText="Departure Date" sortBy="#{vo.dtDep}">
						<h:outputText value="#{vo.dtDep}">
							<f:convertDateTime pattern="dd-MMM-yyyy" />
						</h:outputText>
					</p:column>
					<!-- <p:column headerText="Description"
						style="font-size:10px; width:650px;">
						<h:outputText value="#{vo.numDays}Days "
							rendered="#{vo.numDays != 0}" />
						<h:outputText value="#{vo.numNights}Nights "
							rendered="#{vo.numNights != 0}" />
						<h:outputText
							value="#{vo.tourPkgVO.nameEn} #{vo.tourPkgVO.nameOther} #{vo.tourPkgVO.nameZh}" />
						<h:outputText value=" [#{vo.desc}]" style="color:#FF0000;"
							rendered="#{not empty vo.desc}" />
					</p:column> -->
					<p:column headerText="Description" style="font-size:10px; width:650px;">
						<h:outputText value="#{vo.numDays}Days " rendered="#{vo.numDays != 0}" />
						<h:outputText value="#{vo.numNights}Nights " rendered="#{vo.numNights != 0}" />
						<h:outputText value="#{vo.nameEn} #{vo.nameOther} #{vo.nameZh}" />
						<h:outputText value=" [#{vo.desc}]" style="color:#FF0000;" rendered="#{not empty vo.desc}" />
					</p:column>
				</p:dataTable>
				<h:panelGrid columns="1">
					<p:commandButton value="#{msg['common.button.label.cancel']}"
						onclick="varTourListDialog.hide();varTourListTable.clearFilters();" />
				</h:panelGrid>
			</h:form>
		</p:dialog>

		<!-- DIALOG - POST JOURNAL - JOURNAL ITEM -->
		<p:dialog id="idJourItemDialog" widgetVar="varJourItemDialog"
			modal="true" resizable="false" dynamic="true" draggable="true"
			hideEffect="fade" showEffect="fade" style="top:10% !important">
			<f:facet name="header">
				<h:outputFormat value="Journal Entries Item" />
			</f:facet>
			<h:form id="idFormJournalItem">
				<ui:include src="../../journal/journal_items.xhtml" />
			</h:form>
		</p:dialog>
		
		<!-- DIALOG - POST JOURNAL - HIDDEN FORM -->
		<p:dialog id="idMainJournalDialog" widgetVar="varMainJournalDialog"
			modal="true" resizable="false" dynamic="true" draggable="true"
			hideEffect="fade" showEffect="fade" style="top:10% !important">
			<f:facet name="header">
				<!-- <h:outputFormat value="Journal Entries Item" /> -->
			</f:facet>
			<h:form id="idMainJournalForm">
				<!-- <ui:include src="../../journal/journal_items.xhtml" /> -->
			</h:form>
		</p:dialog>

		<!--
			DIALOG - ACCOUNT SUB CAT LIST
		-->
		<p:dialog id="idJournalAcctSubCatList" widgetVar="varJournalAcctSubCatList" header="Account List"
			modal="true" resizable="false" dynamic="true" draggable="true"
			hideEffect="fade" showEffect="fade" closable="true">
			<h:form id="idAccountList">
				<p:dataTable id="idAcctListTable" widgetVar="varAcctListTable"
					value="#{acctBean.lazyAcctDataModel}" var="vo" paginator="true"
					rows="20" paginatorTemplate="#{bterp:pageTemplate()}" lazy="true"
					rowsPerPageTemplate="10, 20, 30" rowKey="#{vo.id}"
					selectionMode="single" filterEvent="enter"
					filteredValue="#{journalBean.filteredObjList}">
					<p:ajax event="rowSelect"
						listener="#{journalBean.handleSubAcctSelect}"
						update=":idAccountList:idAcctListTable,:idFormJournalItem:panelItemData"
						oncomplete="varAcctListTable.clearFilters();varAcctListTable.unselectAllRows();varJournalAcctSubCatList.hide()" />

					<p:column headerText="Account No" sortBy="#{vo.code}"
						filterBy="#{vo.code}">
						<h:outputText
							value="#{vo.code.concat(empty vo.subCode ? '' : '-'.concat(vo.subCode))}" />
					</p:column>
					<p:column headerText="Description" sortBy="#{vo.desc}"
						filterBy="#{vo.desc}">
						<h:outputText
							value="#{vo.desc.concat(vo.subDesc eq '' ? '' : '-'.concat(vo.subDesc))}" />
					</p:column>
				</p:dataTable>
			</h:form>
			<p:ajax event="close" ajax="false" immediate="true"
				oncomplete="varAcctListTable.clearFilters();" />

		</p:dialog>

		<p:dialog id="idSuppOptDialog" widgetVar="varSuppOptDialog"
			modal="true" resizable="false" dynamic="true" draggable="true"
			closable="true">
			<f:facet name="header">
				<h:outputFormat value="Supplier/Vendor" />
			</f:facet>
			<h:form id="idAddSupplierForm">
				<ui:include src="../../../purchase/common/add_supplier.xhtml" />
			</h:form>
		</p:dialog>
		
		<p:dialog id="idContactDialog" widgetVar="varContactDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
				hideEffect="fade" showEffect="fade" closable="false">
				<f:facet name="header">
					<h:outputFormat value="Add Contact" />
				</f:facet>
				<h:form id="idAddContactForm">
					<ui:include src="../../../purchase/common/add_contact.xhtml"/>
				</h:form>
		</p:dialog>
		
		<p:dialog id="idRemarksDialog" widgetVar="varRemarksDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
				hideEffect="fade" showEffect="fade" closable="false">
				<f:facet name="header">
					<h:outputFormat value="Add Remarks" />
				</f:facet>
				<h:form id="idAddRemarksForm">
					<ui:include src="../../../purchase/common/add_remarks.xhtml"/>
				</h:form>
		</p:dialog>

		<!-- <p:dialog id="idEODetailsDialog" widgetVar="varAddFuncDialog"
			modal="true" resizable="false" dynamic="true" draggable="true"
			closable="false">
			<f:facet name="header">
				<h:outputFormat value="Add Exchange Order" />
			</f:facet>
			<h:form id="idAddExOrderForm">
				<ui:include
					src="../../purchase/common/exchange_order/add_exchange_order.xhtml" />
			</h:form>
		</p:dialog> -->
		
		<!-- DIALOG - MULTIPLE E-INVOICE SUBMIT RESPONSE -->
		<p:dialog id="idMultipleEInvSubmitRespDialog" header="Submit Response"
			widgetVar="varMultipleEInvSubmitRespDialog" modal="true" resizable="false"
			dynamic="true" draggable="true" closable="true">
			<h:form id="idMultipleEInvSubmitRespForm">
				<ui:include src="multiple_e_invoice_submit_response.xhtml" />
			</h:form>
		</p:dialog>
		
		<p:dialog id="idEditRemarksDialog" widgetVar="varEditRemarksDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
				hideEffect="fade" showEffect="fade" closable="false">
				<f:facet name="header">
					<h:outputFormat value="Edit Remarks" />
				</f:facet>
				<h:form id="idEditRemarksForm">
				<ui:include src="../../../purchase/common/edit_remarks.xhtml"/>
				</h:form>
		</p:dialog>
		
		<p:dialog id="idUserDialog" widgetVar="varUserDialog"  modal="true" resizable="false" dynamic="true" draggable="true" 
			hideEffect="fade" showEffect="fade" closable="false">
			<f:facet name="header">
				<h:outputFormat value="Add User" />
			</f:facet>
			<h:form id="idAddUserForm">
				<ui:include src="../../common/bill_payment/add_user.xhtml" />
			</h:form>
		</p:dialog>
		
		<!-- DIALOG - EXPORT CONFIRMATION -->
		<p:confirmDialog id="idExportDialog" widgetVar="varExportDialog"
			header="Confirmation"
			message="Which type of file do you want to export?" closable="false">
			<h:form>
				<p:growl id="msg" />
				<!-- <p:commandButton value="PDF"
					actionListener="#{billPymtBean.exportBillList('pdf')}" ajax="false">
					<p:dataExporter type="pdf"
						target=":idBillListForm:idPurBillPmntTable"
						fileName="Bill_Payment_List"
						preProcessor="#{billPymtBean.preProcessPDF}" />
				</p:commandButton> -->
				<p:commandButton value="Excel"
					actionListener="#{billPymtBean.exportBillList('csv')}" ajax="false" />
				<p:commandButton value="Cancel" onclick="varExportDialog.hide()" />
			</h:form>
		</p:confirmDialog>
		
		<p:dialog id="idViewPymtDialog" widgetVar="varViewPymtDialog" header="View Payment" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
			<h:form id="idViewPymtForm">
				<ui:include src="../../common/bill_payment/view_payment.xhtml"/>
			</h:form>	
		</p:dialog>
		
		<!-- DIALOG - PAYMENT DETAILS  -->
		<p:dialog id="idPaymentDetailsDialog" widgetVar="varPaymentDetailsDialog" modal="true" resizable="false" dynamic="true" draggable="false" 
			hideEffect="fade" showEffect="fade" header="Payment Details" closable="true">
			<h:form id="idPaymentDetailsForm">
				<p:dataTable id="idPaymentDetailsTable" value="#{billPymtBean.billPaymentList}" var="pmnt">
		            <p:column headerText="View">
		                <p:commandButton icon="ui-icon-search" actionListener="#{billPymtBean.onPymtSelected(pmnt)}"
						update=":idViewPymtDialog" process="@this" oncomplete="varViewPymtDialog.show()"/>
		            </p:column>
		            <p:column headerText="Payment No" style="width: 150px;" styleClass="txt_center">
		            	<h:outputText label="Payment No" value="BP-#{pmnt.code} "/>
					</p:column>
		            <p:column headerText="Transaction Date" style="width: 5px;" styleClass="txt_center">
			            <h:outputText label="Transaction Date" value="#{pmnt.pymtDt}">
			            <f:convertDateTime pattern="#{config['date.display.pattern']}" />
			            </h:outputText>
					</p:column>
		            <p:column headerText="Amount Paid" style="width: 150px;" styleClass="txt_center">
			            <h:outputText label="Amount Paid" value="#{pmnt.pmntAmount}">
			            	<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
			            </h:outputText>
					</p:column>
		        </p:dataTable>
		        <h:panelGrid column="5" style="width:1px; margin-top:4px" >
		        	<p:commandButton value="Cancel" oncomplete="varPaymentDetailsDialog.hide()"/>
		        </h:panelGrid>
			</h:form>
		</p:dialog>
		
		<p:dialog id="idCustListDialog" header="Add Customer" widgetVar="varCustListDialog" modal="true"
			resizable="false" dynamic="true" draggable="true">
			<h:form id="idCustListForm">
				<!-- <ui:include src="../common/customer_list.xhtml" /> -->
				<h:outputText value="Function is in development." style="font-weight: bold; color: #CC0000; padding: 20px; display: block;" />
			</h:form>
			<f:facet name="footer">
		        <p:commandButton value="Cancel" oncomplete="varCustListDialog.hide()" />
		    </f:facet>
		</p:dialog>
		
		<p:dialog id="idAddEOBillAttachmentDialog" header="Bill Payment Attachment"
			widgetVar="varAddEOBillAttachmentDialog" modal="true"
			resizable="false" dynamic="true" closable="false" width="600">
			<h:form id="idAddEOBillAttachmentForm">
				<ui:include src="../../../purchase/common/bill_payment/add_eo_bill_attachment.xhtml" />
			</h:form>
		</p:dialog>
		
		<p:confirmDialog widgetVar="varDelAttachmentScannedCopyDialog" message="Are you sure want to delete this scanned copy?">
			<h:form>
				<p:growl id="msg" />
				<p:commandButton value="Yes" actionListener="#{billPymtBean.delAttachmentScannedCopy}"
					update=":idAddEOBillAttachmentForm:idPanelAttachmentScannedCopy"
					oncomplete="varDelAttachmentScannedCopyDialog.hide()" />
				<p:commandButton value="Cancel" onclick="varDelAttachmentScannedCopyDialog.hide()" />
			</h:form>
		</p:confirmDialog>
		
		<!-- DIALOG - DELETE ATTACHMENT CONFIRMATION -->
		<p:confirmDialog widgetVar="varDelAttachmentDialog" header="Confirmation" message="Are you sure want to delete this attachment permenently?"
			closable="false">
			<h:form>
				<p:growl id="msg" />
				<p:commandButton value="#{msg['common.button.label.yes']}" actionListener="#{billPymtBean.deleteInvAttachment}"
					update=":idAddFuncForm:idEOBillAttachmentListPanel"
					oncomplete="if (args &amp;&amp; !args.validationFailed) varDelAttachmentDialog.hide()" />
				<p:commandButton value="#{msg['common.button.label.no']}" onclick="varDelAttachmentDialog.hide()" />
			</h:form>
		</p:confirmDialog>
		
	</ui:define>
</ui:composition>