<p:dialog id="idcreateBillDialog" widgetVar="varCreateBillDialog" header="Create Bills" modal="true" resizable="false" dynamic="true" draggable="true" closable="false">
	<p:panelGrid>
		<p:row>
			<p:column><h:outputLabel>Selected Period </h:outputLabel></p:column>
			<p:column><p:inputText label="Supplier Number" value=""/></p:column>
			<p:column><h:outputLabel>to </h:outputLabel></p:column>
			<p:column><p:inputText label="Supplier Number" value=""/></p:column>
		</p:row>
	</p:panelGrid>
	
	<p:dataTable id="idPurBillPmntTable2" widgetVar="purBillPmntTable2" value="" var="purBillPmnt" paginator="true" rows="20" 
		paginatorTemplate="#{bterp:pageTemplate()}" 
		rowsPerPageTemplate="20, 30, 50" emptyMessage="#{msg['cust.tbl.empty.message']}">
		<p:column headerText="Edit" style="width: 5px;" styleClass="txt_center">
			<p:commandButton value="Edit"/>
		</p:column>
		<p:column headerText="Supplier" style="width: 5px;" styleClass="txt_center">
			<h:outputText label="Supplier Number" value=""/>
		</p:column>
		<p:column headerText="Exchange Order No" style="width: 5px;" styleClass="txt_center">
			<h:outputText label="Supplier Number" value=""/>
		</p:column>
		<p:column headerText="Date" style="width: 5px;" styleClass="txt_center">
			<h:outputText label="Supplier Number" value=""/>
		</p:column>
		<p:column headerText="Exchange Order Amt" style="width: 5px;" styleClass="txt_center">
			<h:outputText label="Supplier Number" value=""/>
		</p:column>
	</p:dataTable>
	<p:panelGrid columns="3" >
		<p:commandButton value="Select All"/>
		<p:commandButton value="Create Bills for Selected Exchange Orders"/>
		<p:commandButton value="Done" onclick="varCreateBillDialog.hide()" process="@this" />
		<p:commandButton value="Delete"/>
	</p:panelGrid>
</p:dialog>

<!--
	DIALOG - EXCHANGE ORDER LIST
-->
<p:dialog id="idEOListDialog" widgetVar="varEOListDialog" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
	<h:form id="idExOrderList">
		<p:dataTable widgetVar="varEOList" value="#{billPymtBean.exOrderList}" var="vo" paginator="true" rows="10" paginatorTemplate="#{bterp:pageTemplate()}" 
			rowKey="#{vo.id}" selectionMode="single" filterEvent="enter" filteredValue="#{billPymtBean.filteredObjList}">
			
			<p:ajax event="rowSelect" listener="#{billPymtBean.handleEOSelect}" oncomplete="varEOListDialog.hide(),varEOList.clearFilters()"
				update=":idAddFuncForm:idShowEO,:idAddFuncForm:idSupplierType,:idAddFuncForm:idShowSuppName,:idAddFuncForm:idInvAmt,
					:idAddPymtForm:idAddPayTo,:idAddFuncForm:idInvAmt,:idAddFuncForm:idDueDt,:idAddFuncForm:idAddTourCd,:idAddFuncForm:idEOAmt,
					:idAddFuncForm:idPaymentTerm,:idAddFuncForm:idTtlAmt,:idAddFuncForm:idAmtDue,:idAddFuncForm:tabView:idAPAcct,
					:idAddFuncForm:idEOInvListTable,:idAddFuncForm:idViewEOButton,:idAddFuncForm:idViewSupplierButton,:idAddFuncForm:idAddTourCd,
					:idAddFuncForm:idDepDt"/>
			
			<p:column headerText="Exchange Order No" sortBy="#{vo.code}" filterBy="#{vo.code}" style="width:80px;" filterMatchMode="contains">
				<h:outputText value="#{vo.code}" />
			</p:column>
			<p:column headerText="Corporate Name" sortBy="#{vo.supplierName}" filterBy="#{vo.supplierName}" style="width:250px;" filterMatchMode="contains">
				<!--h:outputText value="#{vo.suppFullName}" /-->
				<h:outputText value="#{vo.supplierName}" />
			</p:column>
			<p:column headerText="Contact Person" sortBy="#{vo.contactPerson}" filterBy="#{vo.contactPerson}" style="width:150px;" filterMatchMode="contains">
				<h:outputText value="#{vo.contactPerson}" />
			</p:column>
		</p:dataTable>
	</h:form>
</p:dialog>

<!--
	DIALOG - ACCOUNT SUB CAT LIST
-->
<p:dialog id="idAcctSubCatList" widgetVar="varAcctSubCatList" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
	<h:form id="idAccSubCatListForm">
		<p:dataTable value="#{billPymtBean.acctList}" var="vo2" rowKey="#{vo2.id}" selectionMode="single" scrollable="true" scrollHeight="300" filterEvent="enter">
			<p:ajax event="rowSelect" listener="#{billPymtBean.handleSubAcctSelect}" oncomplete="varAcctSubCatList.hide()"
				update=":idAddAcctSubCatForm:idAccountNo,:idAddAcctSubCatForm:idDesc,:idAddAcctSubCatForm:idGSTSearchButton,:idAddAcctSubCatForm:idGSTClearButton,
					:idAddAcctSubCatForm:idGSTCode,:idAddAcctSubCatForm:idGSTRate,:idAddAcctSubCatForm:idGSTAmt,:idAddAcctSubCatForm:idAmt,
					:idEditAcctSubCatForm:idAccountNo,:idEditAcctSubCatForm:idDesc,:idEditAcctSubCatForm:idGSTSearchButton,
					:idEditAcctSubCatForm:idGSTCode,:idEditAcctSubCatForm:idGSTRate,:idEditAcctSubCatForm:idGSTAmt,:idEditAcctSubCatForm:idAmt"/>
		
			<p:column headerText="Account No" sortBy="#{vo2.code}-#{vo2.subCode}" filterBy="#{empty vo2.subCode ? vo2.code : vo2.code.concat('-').concat(vo2.subCode)}"  filterMatchMode="contains" width="100">
				<h:outputText value="#{vo2.code}" />  
				<h:outputText value="-#{vo2.subCode}" rendered="#{not empty vo2.subDesc}" />
			</p:column>
			<p:column headerText="Description" sortBy="#{vo2.desc}, #{vo2.subDesc}" filterBy="#{empty vo2.subDesc ? vo2.desc : vo2.desc.concat(',').concat(vo2.subDesc)}"  filterMatchMode="contains" width="200">
				<h:outputText value="#{vo2.desc}" />
				<h:outputText value=", #{vo2.subDesc}" rendered="#{not empty vo2.subDesc}" />
			</p:column>
		</p:dataTable>
	</h:form>
</p:dialog>
			 
<!--
	DIALOG - TOUR DEPARTURE LIST
-->
<p:dialog id="idTourCodeList" widgetVar="varTourCodeList" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
	<div style="overflow:auto; width:800px !important; height:500px !important;">
	<h:form id="idTourDepListForm">
		<p:dataTable id="idTourDepList" value="#{billPymtBean.lazyDataModelTourDep}" var="vo" paginator="true" rows="20" lazy="true" 
			paginatorTemplate="#{bterp:pageTemplate()}"
			rowsPerPageTemplate="20, 30, 40" rowKey="#{vo.id}" selectionMode="single"
			filterEvent="enter">
			
			<p:ajax event="rowSelect" listener="#{billPymtBean.handleTourCodeSelect}" oncomplete="varTourCodeList.hide()"  update=":idAddFuncForm:idAddTourCd :idAddFuncForm:idDepDt" />
			<p:column headerText="Tour Code" sortBy="#{vo.code}" filterBy="#{vo.code}" filterMatchMode="contains" style="width:200px;">
				<h:outputText value="#{vo.code}" />   
			</p:column>
			<p:column headerText="Departure Date" sortBy="#{vo.dtDep}" filterBy="#{vo.dtDep}" filterMatchMode="contains" style="width:60px;">
				<h:outputText value="#{vo.dtDep}" >
					<f:convertDateTime pattern="#{config['date.display.pattern']}" />
				</h:outputText> 
			</p:column>
			<p:column headerText="Package" sortBy="#{vo.packageDesc}" filterBy="#{vo.packageDesc}" filterMatchMode="contains">
				<h:outputText value="#{vo.packageDesc}" />   
			</p:column>
		</p:dataTable>
	</h:form>
	</div>
</p:dialog>
		
<!-- DIALOG - BANK LIST -->
<p:dialog id="idBankAcctDialog" widgetVar="varBankAcctListDialog" modal="true" resizable="false" dynamic="true" draggable="true" closable="true" header="Bank List">
	<h:form>
		<div style="max-height:300px;overflow:auto;">
			<p:dataTable id="idBankAcctTable" value="#{billPymtBean.bankAcctList}" var="vo" paginator="false" rows="20" filterEvent="enter"
				paginatorTemplate="#{bterp:pageTemplate()}" 
				rowsPerPageTemplate="10, 20, 30" rowKey="#{vo.id}" selectionMode="single">
				<p:ajax event="rowSelect" listener="#{billPymtBean.handleBankSelectUsingBank}" update=":idAddPymtForm:idAddBankAcc,:idAddPymtForm:idAddBankName,:idEditPymtForm:idEditBankAcc,:idEditPymtForm:idEditBankName,:idMultiPmntForm:idAddBankAcc,:idMultiPmntForm:idAddBankName" oncomplete="varBankAcctListDialog.hide()"/>
				
				<p:column headerText="GL Name" sortBy="#{vo.name}" filterBy="#{vo.name}">
					<h:outputText value="#{vo.name}"/>
				</p:column>
				  <p:column headerText="GL Account" sortBy="#{vo.acctViewVO.code}-#{vo.acctViewVO.subCode}" filterBy="#{vo.acctViewVO.code}-#{vo.acctViewVO.subCode}">
					<h:outputText value="#{vo.acctViewVO.code}"/>
					<h:outputText value="-#{vo.acctViewVO.subCode}" rendered="#{not empty vo.acctViewVO.subCode}"/>
				</p:column>	
			</p:dataTable>	
		</div>
		<div style="margin-top:5px">
			<p:commandButton value="Cancel" oncomplete="varBankAcctListDialog.hide();"/>	
		</div>		
	</h:form>
</p:dialog>

<p:dialog id="idGSTListDialog" widgetVar="varGSTListDialog" header="GST Tax Code" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
	<p:tabView >
    	<p:tab title="Input Tax" style="width:150px;">
			<p:dataTable id="idInputTaxCodeList" value="#{billPymtBean.inputTaxCodeVOList}" var="vo" rowKey="#{vo.id}" selectionMode="single">
				<p:ajax event="rowSelect" listener="#{billPymtBean.handleGSTSelect}" oncomplete="varGSTListDialog.hide()" 
					update=":idAddAcctSubCatForm:idGSTCode,:idAddAcctSubCatForm:idGSTRate,:idAddAcctSubCatForm:idGSTAmt,:idAddAcctSubCatForm:idAmt,
							:idEditAcctSubCatForm:idGSTCode,:idEditAcctSubCatForm:idGSTRate,:idEditAcctSubCatForm:idGSTAmt,:idEditAcctSubCatForm:idAmt"/>
				<p:column headerText="No." width="25" style="text-align:right;">
					<h:outputText value="#{vo.seqNo}"/>
				</p:column>
				<p:column headerText="Code" width="50">
					<h:outputText value="#{vo.code}" />
				</p:column>
				<p:column headerText="Description" >
					<h:outputText value="#{vo.description}" />
				</p:column>
				<p:column headerText="Rate (%)" width="50" style="text-align:right;">
					<h:outputText value="#{vo.rate}"/>
				</p:column>
			</p:dataTable>
		</p:tab>
		<p:tab title="Output Tax" style="width:150px;">
			<p:dataTable id="idOutputTaxCodeList" value="#{billPymtBean.outputTaxCodeVOList}" var="vo" rowKey="#{vo.id}" selectionMode="single">
				<p:ajax event="rowSelect" listener="#{billPymtBean.handleGSTSelect}" oncomplete="varGSTListDialog.hide()" 
					update=":idAddAcctSubCatForm:idGSTCode,:idAddAcctSubCatForm:idGSTRate,:idAddAcctSubCatForm:idGSTAmt,:idAddAcctSubCatForm:idAmt,
							:idEditAcctSubCatForm:idGSTCode,:idEditAcctSubCatForm:idGSTRate,:idEditAcctSubCatForm:idGSTAmt,:idEditAcctSubCatForm:idAmt"/>
				<p:column headerText="No." width="25" style="text-align:right;">
					<h:outputText value="#{vo.seqNo}"/>
				</p:column>
				<p:column headerText="Code" width="50">
					<h:outputText value="#{vo.code}" />
				</p:column>
				<p:column headerText="Description" >
					<h:outputText value="#{vo.description}" />
				</p:column>
				<p:column headerText="Rate (%)" width="50" style="text-align:right;">
					<h:outputText value="#{vo.rate}"/>
				</p:column>
			</p:dataTable>
		</p:tab>
	</p:tabView>
</p:dialog>

		<p:dialog id="idListingTableViewDialog" header="Listing Table View"
			widgetVar="varListingTableViewDialog" modal="true" resizable="false"
			dynamic="true" draggable="true" closable="false">
			<h:form id="idListingTableViewForm">
				<p:growl id="msg" />

				<p:dataTable widgetVar="varTableListingTableView"
					value="#{billPymtBean.listingTableViewVO.listingTableViewColumnsVOList}"
					var="vo" paginator="true" rows="10" rowIndexVar="rowIndex"
					paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
					rowsPerPageTemplate="10, 20, 30" style="width: 450px;">

					<p:column headerText="No" style="width: 60px;text-align:center;">
						<h:outputText value="#{rowIndex + 1}" />
					</p:column>
					<p:column headerText="Columns Name">
						<h:outputText value="#{vo.columnsName}" />
					</p:column>
					<p:column headerText="Visibility"
						style="width:70px;text-align:center;">
						<p:selectBooleanCheckbox value="#{vo.visible}" />
					</p:column>
				</p:dataTable>

				<p:panelGrid>
					<p:row>
						<p:column>
							<p:commandButton value="Confirm"
								actionListener="#{billPymtBean.updateListingTableView}"
								style="margin-right: 5px;" update=":idListingTableViewForm:msg" />
							<p:commandButton value="Cancel" process="@this"
								oncomplete="varListingTableViewDialog.hide();" update=":idBillListForm" />
						</p:column>
					</p:row>
				</p:panelGrid>
			</h:form>
		</p:dialog>

		<p:confirmDialog widgetVar="varDelEODialog" message="Are you sure want to delete this record?" closable="false">
	<h:form>
		<p:commandButton value="Yes" actionListener="#{billPymtBean.deleteBill}" oncomplete="varDelEODialog.hide()" update="@form,:idBillListForm" process="@this"/>
		<p:commandButton value="Cancel" actionListener="#{billPymtBean.resetForm}" oncomplete="varDelEODialog.hide()" process="@this"/>
	</h:form> 
</p:confirmDialog>

<p:confirmDialog widgetVar="varDelPaymentDialog" message="Are you sure want to delete this payment?" closable="false">
	<h:form>
		<p:commandButton value="Yes" actionListener="#{billPymtBean.delPymtList}" oncomplete="varDelPaymentDialog.hide()" process="@this"
			update="@form,:idAddFuncForm:tabView,:idAddFuncForm:tabView:idBillPmnt,:idEditPymtForm,:idAddFuncForm:msg,:idAddFuncForm:idEOAmt"/>
		<p:commandButton value="Cancel" actionListener="#{billPymtBean.resetPymtForm}" oncomplete="varDelPaymentDialog.hide()" process="@this"/>
	</h:form> 
</p:confirmDialog>

