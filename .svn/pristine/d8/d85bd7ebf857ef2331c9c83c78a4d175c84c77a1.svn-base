package com.bcs.zsg.crm.helper;

import org.apache.commons.lang.StringUtils;

import com.bcs.zsg.core.helper.PropertiesLookup;

public final class KeycloakProperties {
	public static String PROPERTYFILE = "keycloak.properties";
	
	public static String ENV_BASE_URL_SANDBOX = PropertiesLookup.getProperty(PROPERTYFILE, "envbaseurl.sandbox");
	public static String ENV_BASE_URL_ACTUAL = PropertiesLookup.getProperty(PROPERTYFILE, "envbaseurl.actual");
	
	public static String SYSTEM_API_SANDBOX = PropertiesLookup.getProperty(PROPERTYFILE, "system.api.sandbox");
	public static String SYSTEM_API_ACTUAL = PropertiesLookup.getProperty(PROPERTYFILE, "system.api.actual");
	
	public static String REALM = PropertiesLookup.getProperty(PROPERTYFILE, "realm");
	
	public static String API_LOGIN = PropertiesLookup.getProperty(PROPERTYFILE, "api.login");
	public static String API_REGISTER = PropertiesLookup.getProperty(PROPERTYFILE, "api.register");
	public static String API_CERT = PropertiesLookup.getProperty(PROPERTYFILE, "api.cert");
	public static String API_ADMIN_USERS = PropertiesLookup.getProperty(PROPERTYFILE, "api.admin.users");
	public static String API_ADMIN_USERS_RESET_PASSWORD = PropertiesLookup.getProperty(PROPERTYFILE, "api.admin.users.resetpassword");
	public static String API_ADMIN_USERS_EXEC_ACTIONS_EMAIL = PropertiesLookup.getProperty(PROPERTYFILE, "api.admin.users.executeactionsemail");
	
	public static String TESTING = PropertiesLookup.getProperty(PROPERTYFILE, "testing");
	
	public static String CALLBACK = PropertiesLookup.getProperty(PROPERTYFILE, "callback");
	
	public static String getEnvBaseUrl() {
		if (TESTING.equals("true")) {
			return ENV_BASE_URL_SANDBOX;
		} else {
			return ENV_BASE_URL_ACTUAL;
		}
	}
	
	public static String getSystemApiUrl() {
		if (TESTING.equals("true")) {
			return SYSTEM_API_SANDBOX;
		} else {
			return SYSTEM_API_ACTUAL;
		}
	}
		
	public static boolean isTesting() {
		return StringUtils.equalsIgnoreCase(TESTING, "true");
	}
	
	public static String getAdminUsersApi() {
	    return getAdminUsersApi(StringUtils.EMPTY);
	}
	
	public static String getAdminUsersApi(String userId) {
	    return API_ADMIN_USERS.replace("{realm}", REALM).replace("{userId}", userId);
	}
	
	public static String getAdminUsersResetPasswordApi(String userId) {
	    return API_ADMIN_USERS_RESET_PASSWORD.replace("{realm}", REALM).replace("{userId}", userId);
	}
	
	public static String getAdminUsersExecActionsEmailApi(String userId) {
	    return API_ADMIN_USERS_EXEC_ACTIONS_EMAIL.replace("{realm}", REALM).replace("{userId}", userId);
	}
}
