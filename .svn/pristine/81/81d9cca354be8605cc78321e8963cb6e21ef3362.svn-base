################
#	   EMAIL    #	
################

mail.url=https://aws.exampledomain.my:2030/aws
frontend.url.update.customer.person=https://exampledomain.my/einvoice/individual/index.php
frontend.url.update.customer.corporate=https://exampledomain.my/einvoice/corporate/index.php
frontend.url.update.supplier=https://exampledomain.my/einvoice/supplier/index.php
frontend.url.customer.feedback=https://applevacations.my/feedback/index.php


# Email Logo Path
mail.logo=https://applevacations.my/en/images/logo-white3.png

# SMTP/IMAP user
mail.user.name=Admin Notification - Apple Web System
mail.user.fromAddr=
mail.user.mail=
mail.user.password=

#SMTP setting
mail.smtp.transport.protocol=SMTP
mail.smtp.host=mail.exampledomain.my
mail.smtp.port=465
mail.smtp.useSSL=true
mail.smtp.socketFactory.port=465
mail.smtp.socketFactory.class=javax.net.ssl.SSLSocketFactory
mail.smtp.socketFactory.fallback=true
mail.smtp.auth=true

# Insurance Notification Email Recipient
mail.insurance.recipient=ins@applevacations.my
