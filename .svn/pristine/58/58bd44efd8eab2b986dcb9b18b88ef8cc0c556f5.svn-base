<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			template="/WEB-INF/views/layouts/main.xhtml">
	
<ui:define name="content">
<script type="text/javascript">
	document.addEventListener('DOMContentLoaded', function() {
        var filters = document.querySelectorAll('input.ui-column-filter');
        filters.forEach(function(filter) {
            filter.setAttribute('enterkeyhint', 'enter');
        });
    });
	
	function setEnterKeyHint() {
	    var filters = document.querySelectorAll('input.ui-column-filter');
	    filters.forEach(function(filter) {
	        filter.setAttribute('enterkeyhint', 'enter');
	    });
	}
</script>
	<p:panel header="LookUp">
    	<h:form id="idForm">
    	
			<p:growl id="msg"/>
				<h:panelGrid columns="3" cellpadding="0" cellspacing="2" style="margin-bottom:10px; width:400px">
				<h:outputLabel for="idLookUpCategorySearch">Lookup Category</h:outputLabel>
				<h:selectOneMenu id="idLookUpCategorySearch" label="Lookup Category" value="#{lookUpBean.lookupItemViewVO.lookupCategoryVO}" converter="#{lookUpBean.getLookupCategoryConverter()}">
					<f:selectItem itemLabel="All" itemValue="#{lookUpBean.searchParamVO.obj1}"/>
					<f:selectItems value="#{lookUpBean.lookupCategoryAllList}" var="lookupCategoryVO" itemLabel="#{lookupCategoryVO.description}" itemValue="#{lookupCategoryVO}"/>
					<p:ajax update=":idAddLookUpItem,:idForm:idAddLookUpItemduplicate"/>
				</h:selectOneMenu>
			
				<p:commandButton value="Search" type="submit" actionListener="#{lookUpBean.search}" update="@form" oncomplete="varLookUpCatList.clearFilters(),varLookUpItemList.clearFilters(); setEnterKeyHint();"/>
			 </h:panelGrid> 
			<h:panelGrid columns="2" style="margin-bottom:10px;width:200px">  
				<p:commandButton id="idAddLookUpCategory" 
					value="Add Category" update=":idAddLookUpDialog"
					oncomplete="varAddLookUpDialog.show()" 
					immediate="true"/>
				<p:commandButton id="idAddLookUpItem" update=":idAddLookUpItemDialog"
					value="Add Item" actionListener="#{lookUpBean.onSetSeqNo}"
					oncomplete="varAddLookUpItemDialog.show()"
					immediate="true" />	
			</h:panelGrid>
			
			<p:panel header="Lookup Category">
			 <p:dataTable id="idLookUpCategoryTable" 
				value="#{lookUpBean.lookupCategoryList}" widgetVar="varLookUpCatList"
				var="lookupCategoryVO" filteredValue="#{lookUpBean.filteredObjList}" filterEvent="enter">
				
				<!--   <p:column headerText="Edit" style="width:30px; text-align:center">
					<p:commandButton icon="ui-icon-pencil" 
						update="@form,:idEditLookUpForm"
						actionListener="#{lookUpBean.onLookUpSelected(lookupCategoryVO)}"
						oncomplete="varEditlookupDialog.show()" rendered="#{sessionInfoBean.userVO.roleList.get(0).roleCode eq 'SUPER_USER'}"/>
				</p:column>-->
				<p:column headerText="Delete" style="width:30px; text-align:center">
					<p:commandButton icon="ui-icon-close" 
						actionListener="#{lookUpBean.onLookUpSelected(lookupCategoryVO)}"
						oncomplete="varDellookupDialog.show()"/>
				</p:column>
				
				<p:column filterBy="#{lookupCategoryVO.description}" headerText="Category Description">
					  <h:outputText value="#{lookupCategoryVO.description}"/>
				</p:column>
				<p:column filterBy="#{lookupCategoryVO.code}" headerText="Category Code">
					  <h:outputText value="#{lookupCategoryVO.code}"/>
				</p:column>
				<p:column filterBy="#{lookupCategoryVO.remarks}" headerText="Category Remarks">
					  <h:outputText value="#{lookupCategoryVO.remarks}"/>
				</p:column>
			</p:dataTable>
		</p:panel>
		<p:panel header="Lookup Item">
			 <p:dataTable id="idLookUpListTable" value="#{lookUpBean.lookUpItemSearchList}" widgetVar="varLookUpItemList" var="lookupItemVO" 
			 	filteredValue="#{lookUpBean.filteredObjList}" filterEvent="enter">
				
				 <p:column headerText="Edit" style="width:30px; text-align:center">
					<p:commandButton icon="ui-icon-pencil" 
						update="@form,:idEditLookUpItemForm"
						actionListener="#{lookUpBean.onLookUpItemSelected(lookupItemVO)}"
						oncomplete="varEditlookupItemDialog.show()"/>
				</p:column>
				<p:column headerText="Delete" style="width:30px; text-align:center">
					<p:commandButton icon="ui-icon-close" 
						actionListener="#{lookUpBean.onLookUpItemSelected(lookupItemVO)}"
						oncomplete="varDellookupItemDialog.show()"/>
				</p:column>
				<p:column filterBy="#{lookupItemVO.catDesc}" headerText="Category Code">
					  <h:outputText value="#{lookupItemVO.catDesc}"/>
				</p:column>
				<p:column filterBy="#{lookupItemVO.seqNo}" headerText="Sequence Number">
					  <h:outputText value="#{lookupItemVO.seqNo}"/>
				</p:column>
				<p:column filterBy="#{lookupItemVO.code}" headerText="Item Code">
					  <h:outputText value="#{lookupItemVO.code}"/>
				</p:column>
				<p:column filterBy="#{lookupItemVO.description}" headerText="Item Description">
					  <h:outputText value="#{lookupItemVO.description}"/>
				</p:column>
				<p:column filterBy="#{lookupItemVO.remarks}" headerText="Item Remarks">
					  <h:outputText value="#{lookupItemVO.remarks}"/>
				</p:column>
		</p:dataTable>
		</p:panel>
		<h:panelGrid columns="2" style="margin-bottom:10px;width:200px">  
			<p:commandButton id="idAddLookUpCategoryduplicate" 
					value="Add Category" update=":idAddLookUpDialog"
					oncomplete="varAddLookUpDialog.show()" 
					immediate="true"/>
			<p:commandButton id="idAddLookUpItemduplicate" 
				update="@form,:idAddLookUpItemDialog"
					value="Add Item" actionListener="#{lookUpBean.onSetSeqNo}"
					oncomplete="varAddLookUpItemDialog.show()"
					immediate="true" />	
		</h:panelGrid>
	</h:form>		
	</p:panel>
	<!-- DIALOG - ADD BRANCH -->
	<p:dialog id="idAddLookUpDialog" header="Add Lookup Category" widgetVar="varAddLookUpDialog" modal="true" 
		resizable="false" dynamic="true" draggable="true" hideEffect="fade" showEffect="fade" closable="false">
		<h:form id="idAddLookUp">
			<ui:include src="add_lookupcat.xhtml"/>
		</h:form>
	</p:dialog>
	<p:dialog id="idAddLookUpItemDialog" header="Add Lookup Item" widgetVar="varAddLookUpItemDialog" modal="true" 
		resizable="false" dynamic="true" draggable="true" hideEffect="fade" showEffect="fade" closable="false">
		<h:form id="idAddLookUpItem">
			<ui:include src="add_lookupitem.xhtml"/>
		</h:form>
	</p:dialog>
	<!-- DIALOG - EDIT BRANCH -->
	  <p:dialog id="idEditLookUpDialog" header="Edit LookUp" widgetVar="varEditlookupDialog" modal="true" 
		resizable="false" dynamic="true" draggable="true" hideEffect="fade" showEffect="fade" closable="false">
		<h:form id="idEditLookUpForm">
			<ui:include src="editlookupcat.xhtml"/>
		</h:form>
	</p:dialog>
	 <p:dialog id="idEditLookUpItemDialog" header="Edit LookUp Item" widgetVar="varEditlookupItemDialog" modal="true" 
		resizable="false" dynamic="true" draggable="true" hideEffect="fade" showEffect="fade" closable="false">
		<h:form id="idEditLookUpItemForm">
			<ui:include src="edit_lookupitem.xhtml"/>
		</h:form>
	</p:dialog>
	
	 <p:confirmDialog widgetVar="varDellookupDialog" message="Are you sure want to delete this record?">
		<h:form>
			<p:commandButton value="Yes" actionListener="#{lookUpBean.deleteLookUp}" update="@form,:idForm:idLookUpCategoryTable,:idForm:idLookUpCategorySearch" oncomplete="varDellookupDialog.hide()"/>
			<p:commandButton value="Cancel" oncomplete="varDellookupDialog.hide()"/>
		</h:form>
	</p:confirmDialog>
	 <p:confirmDialog widgetVar="varDellookupItemDialog" message="Are you sure want to delete this record?">
		<h:form>
			<p:commandButton value="Yes" actionListener="#{lookUpBean.deleteLookUpItem}" update="@form,:idForm:idLookUpListTable,:idForm:idLookUpCategorySearch" oncomplete="varDellookupItemDialog.hide()"/>
			<p:commandButton value="Cancel" oncomplete="varDellookupItemDialog.hide()"/>
		</h:form>
	</p:confirmDialog>
	

</ui:define>
</ui:composition>