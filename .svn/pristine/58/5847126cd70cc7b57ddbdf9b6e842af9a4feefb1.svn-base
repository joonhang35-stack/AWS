<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			template="/WEB-INF/views/layouts/main.xhtml">
	
<ui:define name="content">
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        var filters = document.querySelectorAll('input.ui-column-filter');
        filters.forEach(function(filter) {
            filter.setAttribute('enterkeyhint', 'enter');
        });
    });
</script>
<p:panel header="Region And Countries">
   	<h:form id="idForm">
		<p:growl id="msg"/>
		<h:panelGrid columns="5" cellpadding="0" cellspacing="2" style="margin-bottom:10px; width:300px">
			<h:outputLabel for="idRegionId">Region Name</h:outputLabel>
			<h:selectOneMenu id="idRegionId" label="Region Name" value="#{regionAndCountriesBean.countryViewVO.regionVO}" converter="#{regionAndCountriesBean.getRegionConverter()}">
				<f:selectItem itemLabel="All"/>
				<f:selectItems value="#{regionAndCountriesBean.regionMainList}" var="regionVO" itemLabel="#{regionVO.regionname}" itemValue="#{regionVO}" />
			</h:selectOneMenu>
			 <p:commandButton value="Search" type="submit" actionListener="#{regionAndCountriesBean.search}" update="@form" oncomplete="varRegionList.clearFilters(),varCountryList.clearFilters(), varCityList.clearFilters()"/>
		</h:panelGrid>
		<h:panelGrid columns="3" style="width:220px">  
			<p:commandButton id="idAddRegion" style="width:101px"
				value="Add Region" update=":idAddRegionDialog"
				oncomplete="varAddRegionDialog.show()" 
				immediate="true"/>
			
			<p:commandButton id="idAddCountry" style="width:101px"
				value="Add Country" actionListener="#{regionAndCountriesBean.onCountry}" update="@form,:idAddCountryDialog"
				oncomplete="varAddCountryDialog.show()" 
				immediate="true"/>
			<p:commandButton id="idAddCity" style="width:101px"
				value="Add City" actionListener="#{regionAndCountriesBean.onCity}" update="@form,:idAddCityDialog"
				oncomplete="varAddCityDialog.show()" 
				immediate="true"/>
		</h:panelGrid>
		
		<p:panel header="Region" style="margin-bottom:5px;">
			<p:dataTable id="idRegionTable" widgetVar="varRegionList" value="#{regionAndCountriesBean.lazyRegionDataModel}" var="regionVO" 
				paginator="true" rows="20"  filteredValue="#{regionAndCountriesBean.filteredObjList}" lazy="true" filterEvent="enter">
			
				 <p:column headerText="Edit" style="width:30px; text-align:center">
					<p:commandButton icon="ui-icon-pencil" 
						update="@form,:idEditRegionDialog"
						actionListener="#{regionAndCountriesBean.onRegionSelected(regionVO)}"
						oncomplete="varEditRegionDialog.show()"/>
				</p:column>
				<p:column headerText="Delete" style="width:30px; text-align:center">
					<p:commandButton icon="ui-icon-close" 
						actionListener="#{regionAndCountriesBean.onRegionSelected(regionVO)}"
						oncomplete="varDelRegionDialog.show()"/>
				</p:column>
				<p:column filterBy="#{regionVO.regioncode}" sortBy="#{regionVO.regioncode}" headerText="Region Code">
					  <h:outputText value="#{regionVO.regioncode}"/>
				</p:column>
				<p:column filterBy="#{regionVO.regionname}" headerText="Region Name" sortBy="#{regionVO.regionname}">
					  <h:outputText value="#{regionVO.regionname}"/>
				</p:column>
			</p:dataTable>
		</p:panel>
		<p:panel header="Country" style="margin-bottom:5px;">
			 <p:dataTable id="idCountryTable" widgetVar="varCountryList" value="#{regionAndCountriesBean.lazyCountryDataModel}" var="countryVO"  paginator="true" rows="20" 
			 	filteredValue="#{regionAndCountriesBean.filteredObjList}" lazy="true" filterEvent="enter">
				 <p:column style="width:30px; text-align:center">
					<p:commandButton icon="ui-icon-pencil" 
						update="@form,:idEditCountryDialog"
						actionListener="#{regionAndCountriesBean.onCountrySelected(countryVO)}"
						oncomplete="varEditCountryDialog.show()"/>
				</p:column>
				<p:column style="width:30px; text-align:center">
					<p:commandButton icon="ui-icon-close" 
						actionListener="#{regionAndCountriesBean.onCountrySelected(countryVO)}"
						oncomplete="varDelCountryDialog.show()"/>
				</p:column>
				<p:column filterBy="#{countryVO.regionname}" sortBy="#{countryVO.regionname}" headerText="Region Name">
					  <h:outputText value="#{countryVO.regionname}" />
				</p:column>
				<p:column filterBy="#{countryVO.code}" sortBy="#{countryVO.code}" headerText="Country Code">
					  <h:outputText value="#{countryVO.code}"/>
				</p:column>
				<p:column filterBy="#{countryVO.threeLetterCode}" headerText="Three Letter Code">
					  <h:outputText value="#{countryVO.threeLetterCode}"/>
				</p:column>
				<p:column filterBy="#{countryVO.country}" sortBy="#{countryVO.country}" headerText="Country Name">
					  <h:outputText value="#{countryVO.country}"/>
				</p:column>
				<p:column filterBy="#{countryVO.isActualCountry}" filterMatchMode="exact"
					filterOptions="#{regionAndCountriesBean.booleanFilterOptions}" 
					headerText="Actual Country">
					<p:selectBooleanCheckbox value="#{countryVO.isActualCountry}">
						<p:ajax listener="#{regionAndCountriesBean.updateActualCountry(countryVO)}" process="@this" global="false"/>
					</p:selectBooleanCheckbox>
				</p:column>
			</p:dataTable>
		</p:panel>
		<p:panel header="City">
			 <p:dataTable id="idCityTable" widgetVar="varCityList" value="#{regionAndCountriesBean.lazyCityDataModel}" var="cityVO"  paginator="true" rows="20" 
			 	filteredValue="#{regionAndCountriesBean.filteredObjList}" lazy="true" filterEvent="enter">
				 <p:column style="width:30px; text-align:center">
					<p:commandButton icon="ui-icon-pencil" 
						update="@form,:idEditCityDialog"
						actionListener="#{regionAndCountriesBean.onCitySelected(cityVO)}"
						oncomplete="varEditCityDialog.show()"/>
				</p:column>
				<p:column style="width:30px; text-align:center">
					<p:commandButton icon="ui-icon-close" 
						actionListener="#{regionAndCountriesBean.onCitySelected(cityVO)}"
						oncomplete="varDelCityDialog.show()"/>
				</p:column>
				<p:column filterBy="#{cityVO.countryName}" sortBy="#{cityVO.countryName}" headerText="Country Name">
					  <h:outputText value="#{cityVO.countryName}"/>
				</p:column>
				<p:column filterBy="#{cityVO.code}" sortBy="#{cityVO.code}" headerText="City Code">
					  <h:outputText value="#{cityVO.code}"/>
				</p:column>
				<p:column filterBy="#{cityVO.name}" sortBy="#{cityVO.name}" headerText="City Name">
					  <h:outputText value="#{cityVO.name}"/>
				</p:column>
			</p:dataTable>
		</p:panel>
		<h:panelGrid columns="3" style="margin-bottom:10px;width:220px">  
			<p:commandButton id="idAddRegionDup" style="width:101px"
				value="Add Region" update=":idAddRegionDialog"
				oncomplete="varAddRegionDialog.show()" 
				immediate="true"/>
			
			<p:commandButton id="idAddCountryDup" style="width:101px"
				value="Add Country" actionListener="#{regionAndCountriesBean.onCountry}" update="@form,:idAddCountryDialog"
				oncomplete="varAddCountryDialog.show()" 
				immediate="true"/>
				
			<p:commandButton id="idAddCityDup" style="width:101px"
				value="Add City" actionListener="#{regionAndCountriesBean.onCity}" update="@form,:idAddCityDialog"
				oncomplete="varAddCityDialog.show()" 
				immediate="true"/>
		</h:panelGrid>
	</h:form>		
</p:panel>
	
	
	<p:dialog id="idAddRegionDialog" header="Add Region" widgetVar="varAddRegionDialog" modal="true" 
		resizable="false" dynamic="true" draggable="true" hideEffect="fade" showEffect="fade" closable="false">
		<h:form id="idAddRegion">
			<ui:include src="add_region.xhtml"/>
		</h:form>
	</p:dialog>
	
	<p:dialog id="idAddCountryDialog" header="Add Country" widgetVar="varAddCountryDialog" modal="true" 
		resizable="false" dynamic="true" draggable="true" hideEffect="fade" showEffect="fade" closable="false">
		<h:form id="idAddCountry">
			<ui:include src="add_country.xhtml"/>
		</h:form>
	</p:dialog>	
	
	<p:dialog id="idAddCityDialog" header="Add City" widgetVar="varAddCityDialog" modal="true" 
		resizable="false" dynamic="true" draggable="true" hideEffect="fade" showEffect="fade" closable="false">
		<h:form id="idAddCity">
			<ui:include src="add_city.xhtml"/>
		</h:form>
	</p:dialog>	
	
	  <p:dialog id="idEditRegionDialog" header="Edit Region" widgetVar="varEditRegionDialog" modal="true" 
		resizable="false" dynamic="true" draggable="true" hideEffect="fade" showEffect="fade" closable="false">
		<h:form id="idEditRegionForm">
			<ui:include src="edit_region.xhtml"/>
		</h:form>
	</p:dialog>
	
	<p:dialog id="idEditCountryDialog" header="Edit Country" widgetVar="varEditCountryDialog" modal="true" 
		resizable="false" dynamic="true" draggable="true" hideEffect="fade" showEffect="fade" closable="false" >
		<h:form id="idEditCountryForm">
			<ui:include src="edit_country.xhtml"/>
		</h:form>
		
		</p:dialog>
		
	<p:dialog id="idEditCityDialog" header="Edit City" widgetVar="varEditCityDialog" modal="true" 
		resizable="false" dynamic="true" draggable="true" hideEffect="fade" showEffect="fade" closable="false" >
		<h:form id="idEditCityForm">
			<ui:include src="edit_city.xhtml"/>
		</h:form>
		
		</p:dialog>
		
	<p:confirmDialog widgetVar="varDelRegionDialog" message="Are you sure want to delete this record?">
		<h:form>
			<p:commandButton value="Yes" actionListener="#{regionAndCountriesBean.deleteRegion}" update="@form,:idForm:idRegionTable" oncomplete="varDelRegionDialog.hide()"/>
			<p:commandButton value="Cancel" oncomplete="varDelRegionDialog.hide()"/>
		</h:form>
	</p:confirmDialog>
	

	<p:confirmDialog widgetVar="varDelCountryDialog" message="Are you sure want to delete this record?">
		<h:form>
			<p:commandButton value="Yes" actionListener="#{regionAndCountriesBean.deleteCountry}" update="@form,:idForm:idCountryTable" oncomplete="varDelCountryDialog.hide()"/>
			<p:commandButton value="Cancel" oncomplete="varDelCountryDialog.hide()"/>
		</h:form>
	</p:confirmDialog>
	
	<p:confirmDialog widgetVar="varDelCityDialog" message="Are you sure want to delete this record?">
		<h:form>
			<p:commandButton value="Yes" actionListener="#{regionAndCountriesBean.deleteCity}" update="@form,:idForm:idCityTable" oncomplete="varDelCityDialog.hide()"/>
			<p:commandButton value="Cancel" oncomplete="varDelCityDialog.hide()"/>
		</h:form>
	</p:confirmDialog>
	
</ui:define>
</ui:composition>