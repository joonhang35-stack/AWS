package com.bcs.zsg.common.helper;

import java.util.Calendar;
import java.util.Date;

public class EInvoiceConstant {

	// Malaysia Standard Industrial Classification (MSIC) Codes
	public static final String MSIC_CODE_NA = "00000";
	public static final String MSIC_CODE_TRVL_AGEN = "79110";
	public static final String MSIC_CODE_TRVL_AGEN_DESC = "Travel agency activities";

	// Classification Codes
	public static final String CLASS_CODE_CONSOL_E_INV = "004";		// 004 Consolidated e-Invoice
	public static final String CLASS_CODE_OTHERS = "022";			// 022 - Others
	public static final String CLASS_CODE_SELF_BILL_OTHERS = "036";	// 036 - Self-billed - Others
	public static final String CLASS_CODE_SELF_BILL_AGENT = "037";	// 036 - Self-billed - Self-billed - Monetary payment to agents, dealers or distributors
	public static final String CLASS_CODE_VOUCHER = "044";			// 044 - Vouchers, gift cards, loyalty points, etc

	// E-Invoice Types
	public static final String E_INV_TYPE_INVOICE = "01";			// Invoice
	public static final String E_INV_TYPE_CREDIT_NOTE = "02";		// Credit Note
	public static final String E_INV_TYPE_REFUND_NOTE = "04";		// Refund Note
	public static final String E_INV_TYPE_S_B_INVOICE = "11";		// Self-billed Invoice
	public static final String E_INV_TYPE_S_B_CREDIT_NOTE = "12";	// Self-billed Credit Note
	public static final String E_INV_TYPE_S_B_REFUND_NOTE = "14";	// Self-billed Refund Note

	// E-Invoice Items
	public static final String LINE_ITM_DESC_TOUR_FARE = "Non-Flight Related Expenses";
	public static final String LINE_ITM_DESC_AIR_TKT = "Flight Related Expenses";
	public static final String LINE_ITM_DESC_VOUCHER = "Travel Voucher / E-Voucher";

	// E-Invoice Identity
	public static final String E_INV_IDENTITY_TYPE_NRIC = "NRIC";
	public static final String E_INV_IDENTITY_TYPE_PASSPORT = "PASSPORT";
	public static final String E_INV_IDENTITY_TYPE_BRN = "BRN";
	public static final String E_INV_IDENTITY_TYPE_TIN = "TIN";
	public static final String E_INV_IDENTITY_TYPE_SST = "SST";

	public static final String NOT_APPLICABLE = "NA";
	
	// E-Invoice Document Status
	public final static String E_INV_STATUS_SUBMIT = "Submitted";
	public final static String E_INV_STATUS_VALID = "Valid";
	public final static String E_INV_STATUS_INVALID = "Invalid";
	public final static String E_INV_STATUS_CANCELLED = "Cancelled";
	public final static String E_INV_STATUS_NOT_SUBMIT = "Not Submitted";
	/**
	 * For documents that are rejected by E-Invoice.
	 * <p>Note: This is not an official E-Invoice submission status.
	 */
	public final static String E_INV_STATUS_REJECTED = "Rejected";
	
	// State Code
	public final static String STATE_CD_NA = "17";
	
	// E-Invoice General Tin
	public static final String E_INV_GNRL_TIN_PUBLIC = "EI00000000010";		// General Public's TIN
	public static final String E_INV_GNRL_TIN_F_BUYER = "EI00000000020";	// Foreign Buyer's TIN
	public static final String E_INV_GNRL_TIN_F_SUPL = "EI00000000030";		// Foreign Supplier's TIN
	public static final String E_INV_GNRL_TIN_GOV = "EI00000000040";		// Buyer's TIN for Government
	
	// E-Invoice Doc Type
	public final static String E_INV_DOC_TYPE_INVOICE = "Invoice";
	public final static String E_INV_DOC_TYPE_CREDIT_NOTE = "Credit Note";
	public final static String E_INV_DOC_TYPE_REFUND_NOTE = "Refund Note";
	public final static String E_INV_DOC_TYPE_SELF_BILLED_INVOICE = "Self-billed Invoice";
	public final static String E_INV_DOC_TYPE_SELF_BILLED_CREDIT_NOTE = "Self-billed Credit Note";
	
	// API Max Page Size
	public final static int MAX_PAGE_SIZE = 100;
	
	// EInvoiceApiDailySnapshotTransVO existsInLocalStatus
	public final static String EXISTS_STATUS_YES = "Y";
	public final static String EXISTS_STATUS_NO = "N";
	public final static String EXISTS_STATUS_PENDING = "P";
	
	public static final Date getEInvoiceStartDate() {
		Calendar cal = Calendar.getInstance();
		cal.set(2025, Calendar.JANUARY, 1, 0, 0, 0);
		cal.set(Calendar.MILLISECOND, 0);

		Date eInvoiceStartDate = cal.getTime();
		return eInvoiceStartDate;
	}
	
	public static final Date getEInvoiceSchedulerStartDate() {
		Calendar cal = Calendar.getInstance();
		cal.set(2025, Calendar.NOVEMBER, 1, 0, 0, 0);
		cal.set(Calendar.MILLISECOND, 0);

		Date eInvoiceStartDate = cal.getTime();
		return eInvoiceStartDate;
	}
}
