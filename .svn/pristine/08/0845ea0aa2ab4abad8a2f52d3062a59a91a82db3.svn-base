	/**
	 * Add Payment
	 */
	public void addPayment() {
		try {
			if (null == billPaymentList) billPaymentList = new ArrayList<BillPaymentVO>();
			BigDecimal totAmt = amtCalcViewVO.getTotalAmountPaid().add(new BigDecimal(billPaymentVO.getPmntAmount().toString()));
			
			if (billPaymentVO.getPmntAmount().doubleValue() == 0) {
				throw new BusinessException(CommonErrConstant.ERR_BILL_PMNT_NO_AMOUNT);
		        
			} else if (null != exOrderBillVO.getBillAmt() && (new BigDecimal(exOrderBillVO.getBillAmt().toString()).compareTo(totAmt)) < 0) {
				throw new BusinessException(CommonErrConstant.ERR_BILL_PMNT_AMOUNT_EXCEED);
		        
			} else {
				billPaymentVO.setChqAmount(billPaymentVO.getPmntAmount());
				billPaymentList.add(billPaymentVO);
				
				// calculate total amount
				updateTaxableAmount(false);
				
				resetPymtForm();
				billPaymentVO.setPayee(billPaymentList.get(0).getPayee());
				billPaymentVO.setPymtDt(billPaymentList.get(0).getPymtDt());
				billPaymentVO.setPmntAmount(new BigDecimal(exOrderBillVO.getBillAmt().toString()).subtract(amtCalcViewVO.getTotalAmountPaid()).doubleValue());
				successResult();
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Edit Payment
	 */
	public void editPayment() {
		try {
			if (billPaymentVO.getPmntAmount().doubleValue() == 0) throw new BusinessException(CommonErrConstant.ERR_BILL_PMNT_NO_AMOUNT);
			
			billPaymentVO.setChqAmount(billPaymentVO.getPmntAmount());
			// calculate total amount
			updateTaxableAmount(false);
			
			if (null != exOrderBillVO.getBillAmt() && (new BigDecimal(exOrderBillVO.getBillAmt().toString()).compareTo(amtCalcViewVO.getTotalAmountPaid())) < 0)
				throw new BusinessException(CommonErrConstant.ERR_BILL_PMNT_AMOUNT_EXCEED);
			
			resetPymtForm();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
