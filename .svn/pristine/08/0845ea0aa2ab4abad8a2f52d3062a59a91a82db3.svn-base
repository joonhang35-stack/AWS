	public void exportBillList(String type) {
		System.out.println("BillPymtBean.export()");
		
		try {
			FacesContext context = FacesContext.getCurrentInstance();
			DataTable table = (DataTable) context.getViewRoot().findComponent(":idBillListForm:idPurBillPmntTable");
			table.setLazy(false);
			
			if ("csv".equalsIgnoreCase(type)) {
				CSVExporter csvExporter = new CSVExporter();
				csvExporter.export(context, table, ReportUtils.generateReportFileName("Bill_Payment_List"), false, false, "UTF-8", null, null);
			}
				
			context.responseComplete();
			table.setLazy(true);
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	//create PDF
	public void preProcessPDF(Object document) {
	    try {
	        Document pdf = (Document) document;
	        pdf.setPageSize(PageSize.A2.rotate()); 
	        pdf.setMargins(0, 0, 0, 0);
	        pdf.open();

	        Font titleFont = new Font(Font.HELVETICA, 14, Font.BOLD);
	        Paragraph title = new Paragraph("Bill Payment List", titleFont);
	        title.setAlignment(Element.ALIGN_CENTER);
	        pdf.add(title);
	        pdf.add(new Paragraph(" "));
	        
	        PdfPTable table = new PdfPTable(1);
	        table.setWidthPercentage(100);
	        table.getDefaultCell().setNoWrap(false);
	        table.getDefaultCell().setPadding(5);
	        
	        Font tableFont = new Font(Font.HELVETICA, 7);
	        
	    } catch (Exception e) {
	        e.printStackTrace();
	    }
	}
	
	/****************
	 * Lazy loading *
	 ****************/
	
	class LazyBillPmntDataModel extends LazyDataModel<ExOrderBillVO> implements Serializable {
		private static final long serialVersionUID = 1L;
		
		private Date billFromDate;
		private Date billToDate;
		private Boolean isConsol = false; // indicate the list is load for consol or not
		
		// for main listing searching
		public LazyBillPmntDataModel(Date billFromDate, Date billToDate) {
			super();
			this.billFromDate = billFromDate;
			this.billToDate = billToDate;
		}
		
		public LazyBillPmntDataModel(Date billFromDate, Date billToDate, Boolean isConsol) {
			super();
			this.billFromDate = billFromDate;
			this.billToDate = billToDate;
			this.isConsol = isConsol;
		}

		public LazyBillPmntDataModel() {
			super();
		}

		/*
		 * (non-Javadoc)
		 * @see org.primefaces.model.LazyDataModel#load(int, int, java.lang.String, org.primefaces.model.SortOrder, java.util.Map)
		 */
		@Override
		public List<ExOrderBillVO> load(int first, int pageSize, String sortField, SortOrder sortOrder, Map<String, String> filters) {
			try {
				trackingLogUtils.startLogs();
				
				BillPymtBean.this.filters = filters;
				
				Map<String, Object> params = new HashMap<String, Object>();
				params.put("first", first);
				params.put("pageSize", pageSize);
				params.put("sortField", sortField);
				params.put("sortOrder", sortOrder);
				params.put("filters", filters);
				params.put("psPrefixVal", psPrefixVal);
				if (fromDate != null) params.put("fromDate", fromDate);
				if (toDate != null) params.put("toDate", toDate);
				if (StringUtils.isNotBlank(billFrom)) params.put("billFrom", billFrom);
				if (StringUtils.isNotBlank(billTo)) params.put("billTo", billTo);
				if (StringUtils.isNotBlank(countryFilter)) params.put("countryFilter", countryFilter);
				if (StringUtils.isNotBlank(suppTypeFilter)) params.put("suppType", suppTypeFilter);
				if (idSupplierList != null && idSupplierList.size() > 0) params.put("idSupplierList", idSupplierList);
				
				// for consol e inv
				if (billFromDate != null) params.put("fromDate", billFromDate);
				if (billToDate != null) params.put("toDate", billToDate);
				params.put("isConsol", isConsol);
				
				int size = billPymtBO.getBillListSize(first, pageSize, filters, getSessionInfoBean().getCompanyVO().getId(), isSupplier ? idSupplier : null, params);
				//int size = billPymtBO.getBillListSize(first, pageSize, filters, (isSupplier) ? null : getSessionInfoBean().getCompanyVO().getId(), idSupplier);
				setRowCount(size);
				if (size > 0) billList = billPymtBO.getBillList(first, pageSize, sortField, sortOrder, filters, getSessionInfoBean().getCompanyVO().getId(), isSupplier ? idSupplier : null, params);
				//if (size > 0) billList = billPymtBO.getBillList(first, pageSize, sortField, sortOrder, filters, (isSupplier) ? null : getSessionInfoBean().getCompanyVO().getId(), idSupplier);
				else billList = new ArrayList<ExOrderBillVO>();
				
//				if (idSupplier == null && blMultiPymt == true) {
				if ("ALL".equals(suppTypeFilter) && blMultiPymt == true) {
					totalAmtMap = new HashMap<String, Double>();
					totalAmtMap.put("totalBillAmt", (Double) 0.0);
					totalAmtMap.put("totalAmtPaid", (Double) 0.0);
				} else {
					totalAmtMap = billPymtBO.getTotalAmt(getSessionInfoBean().getCompanyVO().getId(), idSupplier);
				}
				BigDecimal totalBillAmt = new BigDecimal(totalAmtMap.get("totalBillAmt").toString());
				BigDecimal totalAmtPaid = new BigDecimal(totalAmtMap.get("totalAmtPaid").toString());
				totalAmtMap.put("totalCurBal", totalBillAmt.subtract(totalAmtPaid).doubleValue());
				
//				if (idSupplier != null) {
				if (!"ALL".equals(suppTypeFilter)) {
					for(int i = 0; i < billList.size(); i++) {
						for (int j = 0 ; j < billPmntList.size() ; j++) {
							if (billList.get(i).getId().equals(billPmntList.get(j).getId())) {
								billList.get(i).setAmtAllocate(billPmntList.get(j).getAmtAllocate());
								break;
							}
						}
					}
					
				}
			} catch (Throwable t) {
				t.printStackTrace();
			} finally {
				trackingLogUtils.endLogs("LazyBillPmntDataModel");
			}
			return billList;
		}
		
		/*
		 * (non-Javadoc)
		 * @see org.primefaces.model.LazyDataModel#setRowIndex(int)
		 */
		@Override
		public void setRowIndex(int rowIndex) {
			if (rowIndex == -1 || getPageSize() == 0) super.setRowIndex(-1);
			else super.setRowIndex(rowIndex % getPageSize());
		}
	}
	
	/**
	 * Get country name
	 */
	public String getCountryName(Long id) {
		try {
			CountryVO vo = regionBO.getCountryById(id);
			if (vo == null) return "";
			else return vo.getCountry();
			
		} catch (Throwable t) {
			errorResult(t);
		}
		return "";
	}
	
	/**
	 * Get employee name
	 */
	public String getUserName(Long id) {
		try {
			if (id != null) {
				for (EmployeeViewVO vo : employeeList) {
					if (vo.getId().longValue() == id.longValue()) {
						String name = vo.getUserVO().getName();
						if (StringUtils.isNotEmpty(vo.getFullName())) {
							name += " (" + vo.getFullName() + ")";
						}
						return name;
					}
				}
			}
		} catch (Throwable t) {
			errorResult(t);
		}
		return "";
	}
	
