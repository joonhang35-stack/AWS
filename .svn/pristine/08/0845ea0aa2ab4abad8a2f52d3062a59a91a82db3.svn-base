	public ExOrderBillVO[] getSelectedBillList() {
		return selectedBillList;
	}

	public void setSelectedBillList(ExOrderBillVO[] selectedBillList) {
//		this.selectedBillList = selectedBillList;
		
//		System.out.println("\nBillPymtBean.setSelectedBillList()");
//		System.out.println("CYY selectedBillList.length: " + selectedBillList.length);
//		for (ExOrderBillVO vo : selectedBillList) {
//			System.out.print(vo.getCode() + ", ");
//		}
//		System.out.println();
		
		if (savedSelectedBillList == null) savedSelectedBillList = new ArrayList<ExOrderBillVO>();
    	if (selectedBillList != null) {
    		boolean existed = false;
    		for (Object obj : selectedBillList) {
    			ExOrderBillVO custVO = (ExOrderBillVO) obj;
        		existed = false;
        		for (ExOrderBillVO selectedVO : savedSelectedBillList) {
        			if (selectedVO.getId().equals(custVO.getId())) {
        				existed = true;
        				break;
        			}
        		}
        		if (!existed) savedSelectedBillList.add(custVO);
        	}
    	}
    	
    	if (lazyConsolDataModel == null)	return;
    	
    	List<ExOrderBillVO> dataList = (List<ExOrderBillVO>) lazyConsolDataModel.getWrappedData();
//    	System.out.println("CYY dataList.size(): " + dataList.size());
//    	for (InvoiceVO vo : dataList) {
//    		System.out.print(vo.getPsNo() + ", ");
//		}
//    	System.out.println();
    	if (dataList != null && dataList.size() > 0 && selectedBillList != null) {
    		List<ExOrderBillVO> removeList = new ArrayList<ExOrderBillVO>();
    		for (ExOrderBillVO data : dataList) {
    			for (Object obj : selectedBillList) {
    				ExOrderBillVO custVO = (ExOrderBillVO) obj;
    	    		if (data.getId().equals(custVO.getId())) {
    	    			removeList.add(data);
    	    			break;
    	    		}
    	    	}
    		}
    		if(removeList.size() > 0) dataList.removeAll(removeList);
    		removeList = new ArrayList<ExOrderBillVO>();
    		for (ExOrderBillVO data : dataList) {
    			for (ExOrderBillVO selectedVO : savedSelectedBillList) {
    	    		if (data.getId().equals(selectedVO.getId())) {
    	    			removeList.add(selectedVO);
    	    			break;
    	    		}
    	    	}
    		}
    		if(removeList.size() > 0) savedSelectedBillList.removeAll(removeList);
    	}
    	
    	this.selectedBillList = savedSelectedBillList.toArray(new ExOrderBillVO[savedSelectedBillList.size()]);
    	
    	Collections.sort(savedSelectedBillList, new Comparator<ExOrderBillVO>() {
    		@Override
            public int compare(ExOrderBillVO a, ExOrderBillVO b) {
                return b.getId().compareTo(a.getId()); // reverse order
            }
		});
    	
//    	System.out.println("CYY savedSelectedBillList.size(): " + savedSelectedBillList.size());
	}
	
