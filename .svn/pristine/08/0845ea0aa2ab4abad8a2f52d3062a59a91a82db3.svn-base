	public void submitEInvoice() {
		try {
			
			// reset err
			exOrderBillVO.seteInvoiceErr(null);
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO, regionBO, malaysiaStateBO, corporateProfileBO, billPymtBO, purchaseEOBO, chartOfAcctBO);
			CompanyVO companyVO = corporateProfileBO.getCompanyDetails(exOrderBillVO.getCompanyId());
			JSONObject submitResponse = eInvoiceUtils.submitSelfBilledInvoice(exOrderBillVO, supplierVO, supplierList, acctTransVO, companyVO);
			eInvoiceUtils.processSubmitResponse(submitResponse, exOrderBillVO);
			
			successResult();
			
		} catch (Throwable t) {
			
			// display err on interface, instead as err popup
			BusinessException be = (BusinessException) t;
			if (t instanceof BusinessException) {
				String message = messageSource.getMessage(be.getErrorCode(), be.getParameters(), "System error", getLocale());
				exOrderBillVO.seteInvoiceErr(message);
			}
						
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void onCancelEInvoice() {
		
	}
	
	public void cancelEInvoice(String cancellationReason) {
		try {
			
			if (StringUtils.isBlank(exOrderBillVO.geteInvoiceDocumentUuid())) {
				throw new BusinessException(CommonErrConstant.ERR_DOC_NO_UUID);
			}
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO);
			CompanyVO companyVO = corporateProfileBO.getCompanyDetails(exOrderBillVO.getCompanyId());
			JSONObject cancelResponse = eInvoiceUtils.cancelDocument(cancellationReason, exOrderBillVO.geteInvoiceDocumentUuid(), companyVO);
			eInvoiceUtils.processCancelResponse(cancelResponse);
			
			// update sys doc e inv status
			exOrderBillVO.seteInvoiceStatus(EInvoiceConstant.E_INV_STATUS_CANCELLED);
            
            successResult();
            
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	
	public void submitConsolEInvoice() {
		try {
			for (ExOrderBillVO vo : savedSelectedBillList) {
				System.out.println(vo.getCode());
			}
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO, invoiceBO, null, regionBO, malaysiaStateBO, chartOfAcctBO);

			CompanyVO companyVO = corporateProfileBO.getCompanyDetails(getSessionInfoBean().getCompanyVO().getId());
			InvoiceType consolidateInvoiceType = eInvoiceUtils.generateConsolidateSelfBilledInvoiceType(savedSelectedBillList, companyVO);
			JSONObject submitResponse = eInvoiceUtils.submitConsolidateInvoice(consolidateInvoiceType, companyVO);
			eInvoiceUtils.processConsolSubmitResponse2(submitResponse, savedSelectedBillList, consolidateInvoiceType.getIDValue(), companyVO, consolidateInvoiceType);
		
			successResult();
			reloadConsolBillPymtList();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			consolEInvActiveTabIndex = 0;
		}
	}
	
	public void getEInvoiceDocStatus() {
		try {
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO, regionBO, malaysiaStateBO, corporateProfileBO, billPymtBO, purchaseEOBO, chartOfAcctBO);

			if (StringUtils.isBlank(exOrderBillVO.geteInvoiceDocumentUuid())) {
				throw new BusinessException(CommonErrConstant.ERR_DOC_NO_UUID);
			}

			String accessToken = eInvoiceUtils.getAccessToken(getSessionInfoBean().getCompanyVO(), true);
			EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceUtils
					.updDocumentDetails(exOrderBillVO.geteInvoiceDocumentUuid(), accessToken);

			// update existing exOrderBillVO to show result
			if (StringUtils.isNotBlank(eInvoiceDocumentVO.getStatusCode()))	exOrderBillVO.seteInvoiceStatus(eInvoiceDocumentVO.getStatusCode());
			exOrderBillVO.seteInvoiceDocumentVO(eInvoiceDocumentVO);
			if (eInvoiceDocumentVO != null) exOrderBillVO.seteInvoiceDocument(eInvoiceDocumentVO.geteInvoiceDocument());

			successResult();
					
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void printEInvoice() {
		try {
			HashMap<String, Object> map = corporateProfileBO.getReportTitle(getSessionInfoBean().getCompanyVO());
			
			EInvoiceDocumentVO eInvoiceDocumentVO = eInvoiceBO.getEInvoiceByUUID(exOrderBillVO.geteInvoiceDocumentUuid());
			eInvoiceBO.getEInvoiceDetails(eInvoiceDocumentVO);
			EInvoiceUtils.printEInvoice(eInvoiceDocumentVO, map);
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void submitMultipleEInvoice() {
//		TrackingLogUtils trackingLogUtils = new TrackingLogUtils(getClass());
		trackingLogUtils.startLogs();
		try {
			
			if (savedSelectedBillList.size() > CommonConstant.E_INV_MAX_DOC_CNT) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null,
						new String[] { "Maximum document count in a submission is 15."
								+ savedSelectedBillList.size() + " is selected." });
			}
			
			loadSupplier();
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO, regionBO, malaysiaStateBO, corporateProfileBO, billPymtBO, purchaseEOBO, chartOfAcctBO);
			eInvoiceUtils.setMessageSource(messageSource);
			CompanyVO companyVO = corporateProfileBO.getCompanyDetails(getSessionInfoBean().getCompanyVO().getId());
			
			JSONObject submitResponse = eInvoiceUtils.submitSelfBilledInvoices(savedSelectedBillList, companyVO.getId(), supplierList);
			eInvoiceUtils.processSubmitResponseSelfBilledInvoices(submitResponse, savedSelectedBillList, companyVO.getId());
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			mulpEInvActiveTabIndex = 0;
		}
		
		mulpInvSubmRespList = new ArrayList<ExOrderBillVO>(savedSelectedBillList);		
		savedSelectedBillList.clear();
		selectedBillList = new ExOrderBillVO[1];
		
		trackingLogUtils.endLogs("submitMultipleEInvoice");
	}
	
