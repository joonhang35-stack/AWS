	public void resetMultiBillsForm() {
		BigDecimal totCurBal = new BigDecimal("0.0");
		for(int i = 0; i < billList.size(); i++){
			totCurBal = totCurBal.add(new BigDecimal(billList.get(i).getCurBal().toString()));
		}
		totalCurBal = totCurBal.doubleValue();
		cashBookVO = new CashBookVO();
	}
	
