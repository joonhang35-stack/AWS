	/*
	 * Insert single bill
	 */
	private void insertSingleBill( ExOrderVO exOrderVO2, ExOrderBillVO exOrderBillVO, AcctTransVO acctTransVO, List<BillPaymentVO> billPaymentList, Long companyId) throws BusinessException, QueueException {
		updateTaxableAmount(false);
		exOrderBillVO.setAmountCalcViewVO(amtCalcViewVO);
		exOrderBillVO.getAmountCalcViewVO().setIdTaxAcct(getSessionInfoBean().getCompanyVO().getIdAcctGST());
		exOrderBillVO.getAmountCalcViewVO().setIdTaxNonClaimableAcct(getSessionInfoBean().getCompanyVO().getIdAcctNonClaimableGST());
		billPymtBO.insertSingleBill(exOrderVO2, exOrderBillVO, acctTransVO, billPaymentList, companyId, supplierVO);
	}
	
	/*
	 * Update Single Bill
	 */
	private void updateSingleBill(Long oldExOrderID2,ExOrderVO exOrderVO,ExOrderBillVO exOrderBillVO, AcctTransVO acctTransVO, List<AcctTransVO> acctTransViewList,
			List<BillPaymentVO> billPaymentList, List<BillPaymentVO> billPaymentViewList) throws BusinessException, QueueException{
		updateTaxableAmount(false);
		exOrderBillVO.setAmountCalcViewVO(amtCalcViewVO);
		exOrderBillVO.getAmountCalcViewVO().setIdTaxAcct(getSessionInfoBean().getCompanyVO().getIdAcctGST());
		exOrderBillVO.getAmountCalcViewVO().setIdTaxNonClaimableAcct(getSessionInfoBean().getCompanyVO().getIdAcctNonClaimableGST());
		billPymtBO.updateSingleBill(oldExOrderID2,exOrderVO,exOrderBillVO, acctTransVO, acctTransViewList, billPaymentList, billPymtBO.getBillPymtList(exOrderBillVO.getId()), supplierVO);	
	}
	
