	/**
	 * On G/L Account selected
	 * @param event
	 */
	public void onMultiBillSelected() {
		try {
			
			trackingLogUtils.startLogs();
			
			double tempDouble = 0;
			List<ExOrderBillVO> billList2 = new ArrayList<ExOrderBillVO>();
			
			for (ExOrderBillVO exOrderBillVO : billPmntList) {
				if (exOrderBillVO.getAmtAllocate() != 0) {
					tempDouble +=  exOrderBillVO.getAmtAllocate();
					billList2.add(exOrderBillVO);
				}
			}
			
			if (tempDouble > 0) {
				SystemNumberGenerationVO bankPymtVO = new SystemNumberGenerationVO();
				bankPymtVO.setCode(CommonConstant.SYS_NUM_CD_BANK_PMNT);
				bankPymtVO.setIdCompany(getSessionInfoBean().getCompanyVO().getId());
				bankPymtVO = SysNumGenUtil.getSysNumber(SysNumGenUtil.getIdx(bankPymtVO));
				billPymtBO.billPaymentMultipleV2(billList2, cashBookVO, bankPymtVO, tempDouble);
			}
			billPmntList = new ArrayList<ExOrderBillVO>();
			initSingleBill();
			successResult();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("onMultiBillSelected");
		}
	}
	
	/**
	 * On G/L Account selected
	 * @param event
	 */
	public void onMultiPmntSelected() {
		try {
			Date dtTrans = new Date();
			totalCurBal = 0.00;
			
			for(ExOrderBillVO exOrderBillVO : billList){
				if(exOrderBillVO.isSelect() == true){
					totalCurBal = totalCurBal + exOrderBillVO.getCurBal();
				}
			}

			if (totalCurBal.doubleValue() == 0) throw new BusinessException(CommonErrConstant.ERR_PURCHASE_BILL_NO_SELECTION);
			
			bankAcctList = bankAcctBO.getBankAcctList(getSessionInfoBean().getCompanyVO().getId());
			for(BankAcctVO bankAcctVO : bankAcctList){
				acctVO = billPymtBO.getGLByBank(bankAcctVO.getIdAcct());
				glListByBank.add(acctVO);
			}

			cashBookVO.setDtTrans(dtTrans);
			cashBookVO.setPayee(supplierVO.getBeneficiaryName());
			cashBookVO.setCredit(totalCurBal);
			successResult();
			
		}catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void onMultiPmntClick() {
		try {
			double totalAmountPaid = 0.00;
			totalCurBal = 0.00;
			String payee = "";
			
			for(ExOrderBillVO exOrderBillVO : billPmntList){
				totalCurBal += exOrderBillVO.getCurBal();
				totalAmountPaid += exOrderBillVO.getAmtAllocate();
				if (StringUtils.isEmpty(payee)) payee = exOrderBillVO.getBeneficiaryName();
			}
			
			bankAcctList = bankAcctBO.getBankAcctList(getSessionInfoBean().getCompanyVO().getId());
			for(BankAcctVO bankAcctVO : bankAcctList) {
				acctVO = billPymtBO.getGLByBank(bankAcctVO.getIdAcct());
				glListByBank.add(acctVO);
			}

			cashBookVO.setDtTrans(new Date());
			cashBookVO.setPayee(payee); 
			cashBookVO.setCredit(totalAmountPaid);
			
			if(totalAmountPaid <= 0) {	
				FacesMessage msg  = new FacesMessage(FacesMessage.SEVERITY_ERROR, "Amount to allocate not provided or contra amount is negative", "");
				if (msg != null) FacesContext.getCurrentInstance().addMessage(null, msg);
		        RequestContext.getCurrentInstance().addCallbackParam("validateError", true);
			}
		}catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * On G/L Account selected
	 * @param event
	 */
	public void onMultiBillsPymt() {
		try {
			billPmntList = new ArrayList<ExOrderBillVO>();
			
			if (!blMultiPymt) {
				blMultiPymt = true;
				blSelect = false;
//				loadSupplier();
				isSupplier = true;
				loadMultiSupplier();
				
			} else {
				blMultiPymt = false;
				blSelect = false;
				isSupplier = false;
				idSupplier = null;
				supplierVO = new SupplierVO();
			}
			
			BigDecimal totAmt = new BigDecimal("0.0");
			BigDecimal totPmntAmt = new BigDecimal("0.0");
			BigDecimal totCurBal = new BigDecimal("0.0");
			for(int i = 0; i < billList.size(); i++){
				totAmt = totAmt.add(new BigDecimal(billList.get(i).getBillAmt().toString()));
				totPmntAmt = totPmntAmt.add(new BigDecimal(billList.get(i).getAmtPaid().toString()));
				totCurBal = totCurBal.add(new BigDecimal(billList.get(i).getCurBal().toString()));
			}
			totalAmt = totAmt.doubleValue();
			totalPymtAmt = totPmntAmt.doubleValue();
			totalCurBal = totCurBal.doubleValue();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Print PaymentVoucher
	 */
	public void printPV(BillPaymentVO vo) {
		try {
			SimpleDateFormat ft = new SimpleDateFormat("yyyyMMdd'_'HHmmss");
			CompanyVO company = corporateProfileBO.getCompanyDetails(getSessionInfoBean().getCompanyVO().getId());
			HashMap map = new HashMap();
			map.put("companyName", company.getName());
			map.put("slogan", company.getSlogan());
			map.put("address1", company.getCompanyAddressVO().getAddress1());
			map.put("address2", company.getCompanyAddressVO().getAddress2());
			map.put("address3", company.getCompanyAddressVO().getAddress3());
			map.put("city", company.getCompanyAddressVO().getCity());
			map.put("state", company.getCompanyAddressVO().getState());
			map.put("postcode", company.getCompanyAddressVO().getPostcode());
			map.put("countryName",getCountryName(company.getCompanyAddressVO().getCountryid()));
			map.put("date", new SimpleDateFormat("dd/MM/yyyy").format(vo.getPymtDt()));
			map.put("voucherNo", vo.getCode());
			map.put("chequeNo", vo.getRefNum());
			map.put("contPersonName", vo.getPayee());
			//map.put("vAmount", vo.getPmntAmount());
			map.put("vAmount", vo.getChqAmount());
			map.put("vAmountWord", EnglishNumberToWords.withCents(vo.getChqAmount().doubleValue()));
			map.put("memo", vo.getRemarks());
			map.put("voucherName","PAYMENT VOUCHER");
			map.put("bankAcctName",vo.getBankName());
			
			String contact = ""; 
			for (CompanyContactVO contactVO : company.getCompanyContactList()) {
				contact += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, contactVO.getTypecodecontact()) + ": " + contactVO.getNumber() + "  ";
			}
			map.put("contact", contact);
			JasperPrint jasperPrint = ReportUtils.getJasperPrint(map, CommonConstant.JAS_RPT_PMNT_VOU);
			ReportUtils.printReport(jasperPrint, CommonConstant.PDF_RPT_PV);
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
