	/**********
	 * HELPER *
	 **********/
	
	private void updateTaxableAmount(boolean isCalGLItems) throws BusinessException {
		if (isCalGLItems) calculateGLItemsAmount(acctTransVO.getAcctTransList());
		
		amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(amtCalcViewVO, false, acctTransVO.getAcctTransList(), billPaymentList, false);
		exOrderBillVO.setAmtPaid(amtCalcViewVO.getTotalAmountPaid().doubleValue());
		exOrderBillVO.setCurBal(amtCalcViewVO.getTotalBalance().doubleValue());
	}
	
	private void handleTaxCodeSelection(String taxCode, Double taxRate) throws BusinessException {
		if(getSessionInfoBean().getCompanyVO().getIdAcctGST() != null && taxCode != null) {
			isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), exOrderBillVO.getBillDt());
			
			if(isGSTPeriod) {
				if(taxCode != null && taxRate == null) {
					TaxCodeVO taxCodeVO = gstBO.getTaxCode(taxCode);
					acctTransViewVO.setTaxCode(taxCodeVO.getCode());
					acctTransViewVO.setTaxRate(taxCodeVO.getRate());
					
				} else {
					acctTransViewVO.setTaxCode(taxCode);
					acctTransViewVO.setTaxRate(taxRate.floatValue());
				}
				
				handleAmountChange();
			}
		} else {
			acctTransViewVO.setTaxCode(null);
			acctTransViewVO.setTaxRate(null);
			acctTransViewVO.setTaxAmount(0.00);
			acctTransViewVO.setAmountIncludeTax(acctTransViewVO.getAmount());
		}
	}
	
	private void calculateGLItemsAmount(List<AcctTransVO> list) throws BusinessException {
		for (AcctTransVO vo : list) {
			vo.setTaxAmount(vo.getAmount() < 0 ? -vo.getTaxAmount() : vo.getTaxAmount());
			
			BigDecimal amount = new BigDecimal(String.valueOf(vo.getAmount()));
			BigDecimal taxAmount = new BigDecimal(vo.getTaxAmount().toString());
			
			vo.setAmountIncludeTax(amount.add(taxAmount).doubleValue());
		}
	}
	
	private void generateBillRemarks() throws BusinessException {
		if (CollectionUtils.isNotEmpty(exOrderBillVO.getEoBillPersonList())) {
			StringBuilder result = new StringBuilder();
			StringBuilder personList = new StringBuilder();
			String startWords = "[Person List - Start]";
			String endWords = "[Person List - End]";
			
			if (exOrderBillVO.getExReason() != null) {
				String[] lines = exOrderBillVO.getExReason().split("\\R"); // \R matches any line break (cross-platform)
			    int lineNumber = 1;
			    int removeLine = 0;
			    for (String line : lines) {
			    	if (line.contains(startWords) || line.contains(endWords)) {
			    		removeLine = 1;
			    	}
			    	if (removeLine == 0) {
			    		result.append(line).append("\n");
			    	}
			    	if (line.contains(endWords)) {
			    		removeLine = 0;
			    	}
			    	System.out.println("Found at line " + lineNumber + ": " + line);
			        lineNumber++;
			    }
			}
			
			personList.append(startWords + "\n");
			for (ExOrderBillPersonVO vo : exOrderBillVO.getEoBillPersonList()) {
				personList.append(getUserName(vo.getIdUser()) + " - " + new DecimalFormat("#,##0.##").format(vo.getAmount()) + "\n");
			}
			personList.append(endWords + "\n");
			
			result.append(personList);
			
			exOrderBillVO.setExReason(result.toString());
		}
	}
	
	
	public String generateReportFileName(String reportName) {
		String fileName = "";
		if (reportName != null) {
			fileName = reportName +  ReportUtils.ft.format(new Date());
		} else {
			fileName = "Report" +  ReportUtils.ft.format(new Date());
		}
        return fileName;
    }
	
