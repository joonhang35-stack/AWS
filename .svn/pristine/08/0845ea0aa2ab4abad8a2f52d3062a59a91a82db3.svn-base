	public void onNameChange() {
		try {
			if (StringUtils.isNotEmpty(employeeVO.getFullName())) {
				String input = employeeVO.getFullName();
					employeeVO.getUserVO().setName(input.length() > 50 ? input.substring(0, 50) : input);
					
					String login = input.replaceAll("\\s+", "").toLowerCase();
					employeeVO.getUserVO().setLoginId(login.length() > 20 ? login.substring(0, 20) : login);
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void addUser() {
		try {
			employeeVO.setCompanyId(getSessionInfoBean().getCompanyVO().getId());
			employeeVO.setIsDefaultComp(Boolean.TRUE);
			employeeVO.getUserVO().setLoginPassword("A12345678@123");
			UserVO vo = securityBO.addNewUser(employeeVO.getUserVO());
			
			// get user assigned role list
			RoleVO roleVO  = securityService.getDefaultUserRole();
			String[] selectedRoles = {roleVO.getUuid()};
			
			securityBO.updateUserRoles(vo.getUuid(), selectedRoles);
			
			employeeVO.setSecUser(vo.getUuid());
			userBO.insertEmployee(employeeVO);
			
			loadEmployeeList();
			// Set payee name
			exOrderBillVO.setIdPayee(employeeVO.getId());
			exOrderBillVO.setPayee(getUserName(exOrderBillVO.getIdPayee()));
			
			resetUserForm();
			successResult();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void resetUserForm() {
		try {
			employeeVO = new EmployeeViewVO();
			employeeVO.setUserVO(new UserVO());
		} catch (Throwable t) {
			errorResult(t);
		}
	}

	/**
	 * Handle payment term
	 */
	@SuppressWarnings("unchecked")
	public void handlePaymentTerm() { 
		try {
			List<LookupItemVO> lookupList = LookupItemUtils.getLookupItemList("pymt_term");
			for (LookupItemVO vo : lookupList) {
				if (vo.getCode().equals(exOrderBillVO.getPaymentTerm())) {
					Date newDate = DateUtils.addDays(exOrderBillVO.getBillDt(), Integer.parseInt(vo.getRemarks()));
					exOrderBillVO.setDueDt(newDate);
					break;
				}
			}
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
