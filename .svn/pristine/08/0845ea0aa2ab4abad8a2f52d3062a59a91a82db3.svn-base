	/**
	 * On G/L Account selected
	 * @param event
	 */
	public void onBillSelected(Long idBill) {
		try {
			trackingLogUtils.startLogs();
			
			exOrderBillVO = billPymtBO.getEOBillById(idBill);
			// set origin vo
			setOriObj(exOrderBillVO.clone());
			oldExOrderID = exOrderBillVO.getEoId();
			
			isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), exOrderBillVO.getBillDt());
			
			loadSupplier();
			loadExpenAsset();
			
			supplierVO = billPymtBO.getSupplier(exOrderBillVO.getSupplierId(), getSessionInfoBean().getCompanyVO().getId());
			if (supplierVO.getSupplierType().equals(CommonConstant.DEF_ACCT_TYPE_TC))
				supplierVO.setSupplierTypeStr(CommonConstant.DEF_ACCT_TRADE_CREDITOR);
			else supplierVO.setSupplierTypeStr(CommonConstant.DEF_ACCT_SUNDRY_CREDITOR);
			billPaymentVO.setPayee(supplierVO.getBeneficiaryName());
			
			// Set payee name
			exOrderBillVO.setPayee(getUserName(exOrderBillVO.getIdPayee()));
			
			if(exOrderBillVO.getEoId() != null){
				exOrderVO = billPymtBO.getEOById(exOrderBillVO.getEoId(), getSessionInfoBean().getCompanyVO().getId());
				exOrderBillVO.setEoCode(exOrderVO.getCode());
				
				exOrderVO.setEoInvList(purchaseEOBO.getEOInvList(exOrderBillVO.getEoId()));
				InvoiceVO tempInvoiceVO;
				for (int i = 0 ; i < exOrderVO.getEoInvList().size() ; i++) {
					tempInvoiceVO = invoiceBO.getInvoiceById(exOrderVO.getEoInvList().get(i).getInvId());
					invoiceBO.getInvoiceDetails(tempInvoiceVO);
					exOrderVO.getEoInvList().get(i).setInvDate(tempInvoiceVO.getInvoiceDt().toString());
					exOrderVO.getEoInvList().get(i).setInvDateView(tempInvoiceVO.getInvoiceDt());
					exOrderVO.getEoInvList().get(i).setCustomerID(tempInvoiceVO.getCustDetailsVO().getCode()); 
					exOrderVO.getEoInvList().get(i).setCustomerName(tempInvoiceVO.getCustDetailsVO().getContPersonName()); 
					exOrderVO.getEoInvList().get(i).setSalesAmount(tempInvoiceVO.getAmount());
					exOrderVO.getEoInvList().get(i).setCode(tempInvoiceVO.getCode());
					if (tempInvoiceVO.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_PAX_STMT)) {
						exOrderVO.getEoInvList().get(i).setCode(tempInvoiceVO.getPsNo());
					} else {
						exOrderVO.getEoInvList().get(i).setCode(tempInvoiceVO.getCode());
					}
					exOrderVO.getEoInvList().get(i).setDocTypeCd(tempInvoiceVO.getDocTypeCd());
				}
			}
			
			loadAcctTrans((exOrderBillVO.getCode()).toString());
			loadAcctTransList((exOrderBillVO.getCode()).toString());
			loadBillPymtList(exOrderBillVO.getId());
			loadEoBillPersonList(exOrderBillVO.getId());
			loadJournal(exOrderBillVO);
			
			if(exOrderBillVO.getTourId() != null && exOrderBillVO.getTourId() != 0) {
//				for (TourDepartureVO vo : tourList) {
//					if (exOrderBillVO.getTourId().equals(vo.getId())) {
//						exOrderBillVO.setTourCode(vo.getCode());
//						exOrderBillVO.setTourDesc(vo.getPackageDesc());
//						break;
//					}
//				}
				TourDepartureVO tourDepVO = tourPkgBO.getTourDepById(exOrderBillVO.getTourId());
				if (tourDepVO != null) {
					exOrderBillVO.setTourCode(tourDepVO.getCode());
					//exOrderBillVO.setDepDt(tourDepVO.getDtDep());	allow to store new departure date without follow the tourcode
				}
			}
			
			if (CommonConstant.STATUS_CD_CANCELLED.equals(exOrderBillVO.getStatus()) || CommonConstant.STATUS_CD_VOID.equals(exOrderBillVO.getStatus())) {
				double tmpTotAmt = 0;
				for (int i = 0 ; i < acctTransVO.getAcctTransList().size() ; i++) {
					tmpTotAmt += acctTransVO.getAcctTransList().get(i).getAmount();
					if (exOrderBillVO.getBillAmt().doubleValue() > 0) {
						if (tmpTotAmt <= exOrderBillVO.getBillAmt().doubleValue()) totalAmt = tmpTotAmt;
						if (tmpTotAmt > exOrderBillVO.getBillAmt().doubleValue()) acctTransVO.getAcctTransList().remove(i);
						
					} else {
						if (tmpTotAmt >= exOrderBillVO.getBillAmt().doubleValue()) totalAmt = tmpTotAmt;
						if (tmpTotAmt < exOrderBillVO.getBillAmt().doubleValue()) acctTransVO.getAcctTransList().remove(i);
					}
				}
			} else {
				BigDecimal totAmt = new BigDecimal("0.0");
				for (int i = acctTransVO.getAcctTransList().size() - 1 ; i >= 0 ; i--) {
					if (acctTransVO.getAcctTransList().get(i).getStatusCode().equals(BaseConstant.STATUS_TERMINATED)) {
						acctTransVO.getAcctTransList().remove(i);
						continue;
					}
					totAmt = totAmt.add(new BigDecimal(String.valueOf(acctTransVO.getAcctTransList().get(i).getAmount())));
				}
				totalAmt = totAmt.doubleValue();
			}
			
			if (CollectionUtils.isNotEmpty(billPaymentList)) {
				for (BillPaymentVO billPmntVO : billPaymentList) {
					totalPymtAmt += billPmntVO.getPmntAmount();
					if (CommonConstant.BILL_PMNT_TYPE_MUL.equals(billPmntVO.getPmntType())) isMultiple = true;
				}
			}
			
			// Check Financial Period Closed
			getFinPeriodClosedStatus();
			acctTransViewList.addAll(acctTransVO.getAcctTransList());
			// GST Amount
			updateTaxableAmount(true);
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("onBillSelected");
		}
	}
	

	/**
	 * On Payment selected selected
	 * @param event
	 */
	public void onBillPay(ExOrderBillVO vo, boolean isButton) {
		try {
			if ("ALL".equals(suppTypeFilter)) throw new BusinessException(CommonErrConstant.ERR_BILL_PMNT_SUPP_TYPE_NO_SLCT);
			
			if (isButton) {
				if (vo.getAmtAllocate() != 0) {
					for (int i = billPmntList.size() - 1 ; i >= 0 ; i--) {
						if (vo.getId().equals(billPmntList.get(i).getId())) {
							if (vo.getAmtAllocate() != billPmntList.get(i).getCurBal().doubleValue()) 
								billPmntList.get(i).setAmtAllocate(billPmntList.get(i).getCurBal());
							else billPmntList.remove(i);
							break;
						}
					}
				} else {
					vo.setAmtAllocate(vo.getCurBal());
					billPmntList.add(vo);
				}
			} else {
				if (vo.getAmtAllocate() != 0) {
					boolean flag = true;
					for (int i = 0 ; i < billPmntList.size() ; i++) {
						if (vo.getId().equals(billPmntList.get(i).getId())) {
							billPmntList.get(i).setAmtAllocate(vo.getAmtAllocate());
							flag = false;
							break;
						}
					}
					// if not existed
					if (flag) billPmntList.add(vo);
				} else {
					for (int i = billPmntList.size() - 1 ; i >= 0 ; i--) {
						if (vo.getId().equals(billPmntList.get(i).getId())) {
							billPmntList.remove(i);
							break;
						}
					}
				}
			}
		 } catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void onBillPersonCalc() {
		try {
			if (CollectionUtils.isNotEmpty(exOrderBillVO.getEoBillPersonList())) {
				BigDecimal totAmt = new BigDecimal("0.0");
				for (ExOrderBillPersonVO sumVO : exOrderBillVO.getEoBillPersonList()) {
					totAmt = totAmt.add(new BigDecimal(sumVO.getAmount().toString()));
				}
				totalAmtPerson = totAmt.doubleValue();
			}
		 } catch (Throwable t) {
			errorResult(t);
		}
	}
	
