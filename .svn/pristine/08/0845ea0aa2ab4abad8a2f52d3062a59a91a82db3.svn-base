	/**
	 * Forward GST calculation
	 */
	public void handleAmountChange() {
		try {
			acctTransViewVO = (AcctTransVO) AccountHelper.calcTaxableAmount(acctTransViewVO, false, 0, 0);
			amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(amtCalcViewVO, false, acctTransVO.getAcctTransList(), billPaymentList, false);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * GST + Amount
	 */
	public void handleGSTAmtChange() {
		try {
			BigDecimal amount = new BigDecimal(String.valueOf(acctTransViewVO.getAmount()));
			BigDecimal taxAmount = new BigDecimal(acctTransViewVO.getTaxAmount().toString());
			
			acctTransViewVO.setAmountIncludeTax(amount.add(taxAmount).doubleValue());
			amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(amtCalcViewVO, false, acctTransVO.getAcctTransList(), billPaymentList, false);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Reverse GST calculation
	 */
	public void handleAmountInclTaxChange() {
		try {
			acctTransViewVO = (AcctTransVO) AccountHelper.calcAmountBaseOnTotalTaxableAmount(acctTransViewVO);
			amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(amtCalcViewVO, false, acctTransVO.getAcctTransList(), billPaymentList, false);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}

