	/**
	 * tour code selected
	 * @param event
	 */
	public void handleTourCodeSelect(SelectEvent event){
		try{
			TourDepartureVO tourDepVO = (TourDepartureVO) event.getObject();  
			
			exOrderBillVO.setTourId(tourDepVO.getId());
			exOrderBillVO.setTourCode(tourDepVO.getCode());
			exOrderBillVO.setTourDesc(tourDepVO.getPackageDesc());
//			exOrderBillVO.setDepDt(tourDepVO.getDtDep());
			
			if (ProductConstant.TYPE_TICKETING.equals(tourDepVO.getTourPkgTypeCd())) {
				exOrderBillVO.setDepDt(new Date());
			} else { // Type: MICE and TOUR
				exOrderBillVO.setDepDt(tourDepVO.getDtDep());
			}
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
