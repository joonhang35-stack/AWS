	public void saveAttachPayment() {
		try {
			BigDecimal tempDouble = new BigDecimal("0.00");
			List<ExOrderBillVO> billList2 = new ArrayList<ExOrderBillVO>();
			
			for (ExOrderBillVO exOrderBillVO : billPmntList) {
				if (exOrderBillVO.getAmtAllocate() != 0) {
					tempDouble = tempDouble.add(new BigDecimal(String.valueOf(exOrderBillVO.getAmtAllocate())));
					billList2.add(exOrderBillVO);
				}
