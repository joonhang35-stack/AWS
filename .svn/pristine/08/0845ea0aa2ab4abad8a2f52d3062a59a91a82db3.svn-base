	/**
	 * Handle Exchange Order selection
	 */
	public void handleEOSelect(SelectEvent event) {
		try {
		
			Double totalAmt = 0.00;
			Double totalEOAmt = 0.00;
			ExOrderVO exOrderViewVO = (ExOrderVO) event.getObject();
			eoDetailsList = purchaseEOBO.getEODetailsList(exOrderViewVO.getId());
			
			for(ExOrderDetailsVO vo : eoDetailsList){
				totalEOAmt = totalEOAmt + vo.getAmount();
			}
			
			exOrderVO = billPymtBO.getEOById(exOrderViewVO.getId(), getSessionInfoBean().getCompanyVO().getId());
			supplierVO = billPymtBO.getSupplier(exOrderVO.getSupplierId(), getSessionInfoBean().getCompanyVO().getId());
			if (supplierVO.getSupplierType().equals(CommonConstant.DEF_ACCT_TYPE_TC))
				supplierVO.setSupplierTypeStr(CommonConstant.DEF_ACCT_TRADE_CREDITOR);
			else supplierVO.setSupplierTypeStr(CommonConstant.DEF_ACCT_SUNDRY_CREDITOR);
			acctTransVO.setAcctId(supplierVO.getAccountId());
			cashBookVO.setPayee(supplierVO.getFullName());
			exOrderDetailsList = billPymtBO.getEODetailsList(exOrderViewVO.getId());
			exOrderVO.setSupplierId(supplierVO.getId());
			exOrderVO.setCode(exOrderViewVO.getCode());
			exOrderVO.setId(exOrderViewVO.getId());
			exOrderVO.setStatus(CommonConstant.STATUS_CD_BILLED);
			
			exOrderBillVO.setEoId(exOrderVO.getId());
			exOrderBillVO.setEoCode(exOrderVO.getCode());
			exOrderBillVO.setDueDt(exOrderViewVO.getDueDt());
			exOrderBillVO.setBillAmt(totalEOAmt);
			exOrderBillVO.setTourId(exOrderVO.getTourId());
			exOrderBillVO.setPaymentTerm(exOrderVO.getPaymentTerm());
			exOrderBillVO.setTourCode(exOrderVO.getTourDepVO().getCode());
			exOrderBillVO.setTourDesc(exOrderVO.getTourDepVO().getPackageDesc());
			if(exOrderVO.getTourDepVO().getDtDep() != null) {
				if (ProductConstant.TYPE_TICKETING.equals(exOrderVO.getTourDepVO().getTourPkgTypeCd())) {
					exOrderBillVO.setDepDt(new Date());
				} else { // Type: MICE and TOUR
					exOrderBillVO.setDepDt(exOrderVO.getTourDepVO().getDtDep());
				}
			}
			if(exOrderVO.getTourDepVO() != null) tourCodeDesc = exOrderVO.getTourDepVO().getCode();
			else tourCodeDesc = "";
			acctTransViewVO.setDebit(exOrderBillVO.getBillAmt());
			
			if(CollectionUtils.isNotEmpty(exOrderDetailsList)){
				for(int i = 0; i < exOrderDetailsList.size(); i++) {
					totalAmt = totalAmt + exOrderDetailsList.get(i).getAmount();
				}
				exOrderDetailsVO.setTotalAmt(totalAmt);
				
			} else exOrderDetailsVO.setTotalAmt(totalAmt);
			exOrderBillVO.setAmtPaid(totalPymtAmt);
			exOrderBillVO.setCurBal(exOrderBillVO.getBillAmt() - exOrderBillVO.getAmtPaid());
			
			// set eo invoice list
			exOrderVO.setEoInvList(purchaseEOBO.getEOInvList(exOrderVO.getId()));
			InvoiceVO tempInvoiceVO;
			for (int i = 0 ; i < exOrderVO.getEoInvList().size() ; i++) {
				tempInvoiceVO = invoiceBO.getInvoiceById(exOrderVO.getEoInvList().get(i).getInvId());
				invoiceBO.getInvoiceDetails(tempInvoiceVO);
				exOrderVO.getEoInvList().get(i).setInvDate(tempInvoiceVO.getInvoiceDt().toString());
				exOrderVO.getEoInvList().get(i).setInvDateView(tempInvoiceVO.getInvoiceDt());
				exOrderVO.getEoInvList().get(i).setCustomerID(tempInvoiceVO.getCustDetailsVO().getCode()); 
				exOrderVO.getEoInvList().get(i).setCustomerName(tempInvoiceVO.getCustDetailsVO().getContPersonName()); 
				exOrderVO.getEoInvList().get(i).setSalesAmount(tempInvoiceVO.getAmount());
				if (tempInvoiceVO.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_PAX_STMT)) {
					exOrderVO.getEoInvList().get(i).setCode(tempInvoiceVO.getPsNo());
				} else {
					exOrderVO.getEoInvList().get(i).setCode(tempInvoiceVO.getCode());
				}
				exOrderVO.getEoInvList().get(i).setDocTypeCd(tempInvoiceVO.getDocTypeCd());
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	/**
	 * Handle Exchange Order selection
	 */
	public void handleSubAcctSelect(SelectEvent event) {
		try {
			AcctVO acctViewVO = (AcctVO) event.getObject();
			acctTransViewVO.setAcctId(acctViewVO.getId());
			acctTransViewVO.setCode(acctViewVO.getCode() + (StringUtils.isNotEmpty(acctViewVO.getSubCode()) ? "-" + acctViewVO.getSubCode() : ""));
			acctTransViewVO.setDesc(acctViewVO.getDesc() + (StringUtils.isNotEmpty(acctViewVO.getSubDesc()) ? ", " + acctViewVO.getSubDesc() : ""));
			
			handleTaxCodeSelection(acctViewVO.getTaxCode(), acctViewVO.getTaxRate() == null ? null : (double) acctViewVO.getTaxRate());
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleAccountCodeKeyUp() {
		AcctVO tempAcctVO = null;
		String strTemp;
		try{ 
			if(StringUtils.isNotEmpty(acctTransViewVO.getCode())) {
				String tempCode = null;
				String tempSubCode = null;
				if (acctTransViewVO.getCode().indexOf("-") > 0) {
					tempCode = acctTransViewVO.getCode().substring(0, acctTransViewVO.getCode().indexOf("-"));
					tempSubCode = acctTransViewVO.getCode().substring(acctTransViewVO.getCode().indexOf("-") + 1, acctTransViewVO.getCode().length());
				} else tempCode = acctTransViewVO.getCode();
				
				for (AcctVO vo : acctList) {
					if (vo.getCode().equals(tempCode)) {
						if (tempSubCode != null) {
							if(vo.getSubCode().equals(tempSubCode)) {
								tempAcctVO = vo;
								break;
							} else continue;
						} else {
							tempAcctVO = vo;
							break;
						}
					}
				}
				
				if(tempAcctVO != null) {
					strTemp= tempAcctVO.getDesc();
					if(StringUtils.isNotEmpty(tempAcctVO.getSubDesc())) strTemp += ", " + tempAcctVO.getSubDesc();
					
					acctTransViewVO.setDesc(strTemp);
					acctTransViewVO.setAcctId(tempAcctVO.getId());
					// populate GST code and rate]
					handleTaxCodeSelection(tempAcctVO.getTaxCode(), tempAcctVO.getTaxRate() == null ? null : (double) tempAcctVO.getTaxRate());
					
				} else acctTransViewVO.setDesc("<font color='red'>No data found !</font>");
			}
		} catch(Exception e) {
			e.printStackTrace();
		}
	}
	
