	public void onToggle(AjaxBehaviorEvent e) {
		try {
			
			List<ExOrderBillVO> dataList = (List<ExOrderBillVO>) lazyConsolDataModel.getWrappedData();
			
//			for (int j = 0; j < selectedBillList.length; j++) {
//				System.out.println(selectedBillList[j].getCode());
//            }
			
//			for (int j = 0; j < dataList.size(); j++) {
//				System.out.println(dataList.get(j).getCode());
//            }
			
			if (selectedBillList.length > 0) {
				System.out.println("Select All");
//				savedSelectedBillList= new ArrayList<ExOrderBillVO>();
				
				List<ExOrderBillVO> addList = new ArrayList<ExOrderBillVO>();
				
				for (ExOrderBillVO selectedBillVO : dataList) {
					boolean found = false;
					for (ExOrderBillVO savedBillVO : savedSelectedBillList) {
						if (savedBillVO.getId().equals(selectedBillVO.getId())) {
							found = true;
							break;
						}
					}
					
					if (!found) {
						addList.add(selectedBillVO);
					}
				}
//				List <ExOrderBillVO> list =  lazyConsolDataModel.load(-1, -1, null, null, filters);
				savedSelectedBillList.addAll(addList);
			} else {
				System.out.println("Unselect All");
				
				List<ExOrderBillVO> removeList = new ArrayList<ExOrderBillVO>();
				
				for (ExOrderBillVO selectedBillVO : dataList) {
					for (ExOrderBillVO savedBillVO : savedSelectedBillList) {
						if (savedBillVO.getId().equals(selectedBillVO.getId())) {
							removeList.add(savedBillVO);
							break;
						}
					}
				}
//				List <ExOrderBillVO> list =  lazyConsolDataModel.load(-1, -1, null, null, filters);
				savedSelectedBillList.removeAll(removeList);
			}
			
			System.out.println("BillPymtBean.onToggle()");
			for (ExOrderBillVO vo : savedSelectedBillList) {
//				System.out.println(vo.getCode());
			}
		
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
