	public void initSingleBill() {
		try {
			isMultiple = false;
			isDateInFinPeriodClosed = false;
			exOrderVO = new ExOrderVO();
			exOrderDetailsVO = new ExOrderDetailsVO();
			
			expenditureVO = new AcctCatVO();
			assetVO = new AcctCatVO();
			acctVO = new AcctVO();
			acctTransVO = new AcctTransVO();
			acctTransViewVO = new AcctTransVO();
			exOrderBillVO = new ExOrderBillVO();
			cashBookVO = new CashBookVO();
			identityVO = new IdentityVO();
			contactVO = new ContactVO();
			remarksVO = new RemarksVO();
			
			exOrderList = new ArrayList<ExOrderVO>();
			exOrderDetailsList = new ArrayList<ExOrderDetailsVO>();
		 
		 	companyList = new ArrayList<CompanyVO>();
		 	liabilityList = new ArrayList<AcctVO>();
		 	acctTransList = new ArrayList<AcctTransVO>();
		 	acctTransViewList = new ArrayList<AcctTransVO>();
		 	bankAcctList = new ArrayList<BankAcctViewVO>();
		 	cashBookViewList = new ArrayList<CashBookVO>();
		 	glListByBank = new ArrayList<AcctVO>();
		 	pymtTermList = new ArrayList<LookupItemVO>();
		 	tourList = new ArrayList<TourDepartureVO>();
		 	eoDetailsList = new ArrayList<ExOrderDetailsVO>();
		 	
		 	billPaymentVO = new BillPaymentVO();
		 	billPaymentList = new ArrayList<BillPaymentVO>();
		 	billPaymentViewList = new ArrayList<BillPaymentVO>();
		 	
			if (!blMultiPymt) {
				supplierVO = new SupplierVO();
				supplierList = new ArrayList<SupplierVO>();
				multiSuppList = new ArrayList<SupplierVO>();
				isSupplier = false;
				idSupplier = null;
				
			} else { 
				isSupplier = true;
			}
			
		 	pymtTermList = purchaseBO.getPymtTermList("pymt_type");
		 	countryList = regionBO.getActualCountryList();
		 	supplierVO.setCountryId(CommonConstant.DEF_COUNTRY_ID);
		 	
		 	totalAmt = 0.00;
		 	totalPymtAmt = 0.00;
		 	totalCurBal = 0.00;
		 	totalAmtPerson = 0.00D;
			
			// get user assigned role list
			List<UserRoleViewVO> userRoleList = securityBO.getUserRoleListByUser(this.getSessionInfoBean().getUserVO().getUuid());
			authVO = new AuthVO();
			invPmntAuthVO = new InvPmntAuthVO();
			if (CollectionUtils.isNotEmpty(userRoleList)) {
				for (UserRoleViewVO userRoleVO : userRoleList) { 
					if (userRoleVO.getRoleCode().equals(SalesConstant.BILL_PMNT_ROLE_DEL)) {
						authVO.setBillPmntDel(true);
					} else if (userRoleVO.getRoleCode().equalsIgnoreCase(SalesConstant.ACCT_MANAGER_ROLE)) {
						invPmntAuthVO.setAccountManager(true);
					} else if (userRoleVO.getRoleCode().equals(SalesConstant.GST_FT_ROLE)) {
						invPmntAuthVO.setGstFreeText(true);
					} else if (StringUtils.equalsIgnoreCase(userRoleVO.getRoleCode(), SalesConstant.SUPER_USER_ROLE)
							|| StringUtils.equalsIgnoreCase(userRoleVO.getRoleCode(), SalesConstant.E_INV_SUBMIT)) {
						invPmntAuthVO.seteInvoice(true);
					}
				}
			}
			EmployeeVO employeeVO = getSessionInfoBean().getEmployeeVO();
			String department = employeeVO.getDepartment();
			
			if (StringUtils.equals(department, MaintConstant.DEPT_TYPE_ACCT) || StringUtils.equals(department, MaintConstant.DEPT_TYPE_FINANCE)) {
				invPmntAuthVO.seteInvoice(true);
			}
			
			loadLiability();
			// GST List
			inputTaxCodeVOList = gstBO.getTaxCodeList(GSTType.INPUT);
			outputTaxCodeVOList = gstBO.getTaxCodeList(GSTType.OUTPUT);
			
			setOriObj(null);
			
		} catch(Exception e) {
			e.printStackTrace();
		}
	}
	
	/**
	 * Add Bill
	 */
	public void addBill() {
		try {
			totalAmt = 0.00;
		 	totalPymtAmt = 0.00;

			resetForm();
			loadSupplier();
			loadExpenAsset();
			
			exOrderBillVO.setStatus("Draft"); 
			exOrderBillVO.setBillDt(new Date());
			exOrderBillVO.setInvoiceDt(exOrderBillVO.getBillDt());
			exOrderBillVO.setIsEInvoice(true);
			tourCodeDesc = "";
			
			if (supplierVO != null && supplierVO.getId() != null) {
				handleSupplierChange();
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public List<String> complete(String query) {
		List<String> results = new ArrayList<String>();
        try{
        	String tempStr;
        	for (int i = 0 ; i < acctList.size() ; i++) {
        		tempStr = acctList.get(i).getCode() + ((StringUtils.isEmpty(acctList.get(i).getSubCode())) ? "" : "-" + acctList.get(i).getSubCode());
        		if (tempStr.startsWith(query)) {
        			results.add(tempStr);
        		}
        	}
        } catch(Exception e) {
        	e.printStackTrace() ; 
        }
        return results;  
    }
	
