	/**
	 * Add Single Bill
	 */
	public void addSingleBill() {
		try {
			trackingLogUtils.startLogs();
			
			// check financial closed / gst submitted
			checkFinGSTClosed(CommonConstant.ACTION_CD_ADD, null, exOrderBillVO.getBillDt(), invPmntAuthVO.isAccountManager());
			if (exOrderBillVO.getBillAmt().doubleValue() <= 0 && CollectionUtils.isNotEmpty(billPaymentList)) throw new BusinessException(CommonErrConstant.ERR_BILL_PMNT_NEGATIVE);
			
			acctTransVO.setCompanyId(getSessionInfoBean().getCompanyVO().getId());
			if (CollectionUtils.isNotEmpty(acctTransVO.getAcctTransList())) {
				/*if ((amtCalcViewVO.getTotalAmountIncludeTax().compareTo(new BigDecimal(exOrderBillVO.getBillAmt().toString()))) == 0) {
					if (CollectionUtils.isEmpty(billPaymentList)) {
						exOrderBillVO.setStatus(CommonConstant.STATUS_CD_BILLED);
						exOrderVO.setStatus(CommonConstant.STATUS_CD_BILLED);
					} else {
						if(totalPymtAmt.doubleValue() == exOrderBillVO.getBillAmt().doubleValue()){
							exOrderBillVO.setStatus(CommonConstant.STATUS_CD_PAID);
							exOrderVO.setStatus(CommonConstant.STATUS_CD_PAID);
							
						} else if(totalPymtAmt.doubleValue() < exOrderBillVO.getBillAmt().doubleValue()){
							exOrderBillVO.setStatus(CommonConstant.STATUS_CD_PAID);
							exOrderVO.setStatus(CommonConstant.STATUS_CD_PAID);
						}
						//exOrderVO.setAmtDue(exOrderVO.getTotalAmt() - totalPymtAmt);
						exOrderVO.setAmtDue(new BigDecimal(exOrderVO.getTotalAmt()).subtract(amtCalcViewVO.getTotalAmountPaid()).doubleValue());
					}
				} else throw new BusinessException(CommonErrConstant.ERR_BANK_PAYMENT_NOT_EQUAL);*/
				if ((amtCalcViewVO.getTotalAmountIncludeTax().compareTo(new BigDecimal(exOrderBillVO.getBillAmt().toString()))) != 0) {
					throw new BusinessException(CommonErrConstant.ERR_BANK_PAYMENT_NOT_EQUAL);
				}
			} else throw new BusinessException(CommonErrConstant.ERR_BANK_PAYMENT_NOT_EQUAL);
			
			if (CollectionUtils.isEmpty(billPaymentList)) {
				exOrderBillVO.setStatus(CommonConstant.STATUS_CD_BILLED);
				exOrderVO.setStatus(CommonConstant.STATUS_CD_BILLED);
			} else {
				exOrderBillVO.setStatus(CommonConstant.STATUS_CD_PAID);
				exOrderVO.setStatus(CommonConstant.STATUS_CD_PAID);
				exOrderVO.setAmtDue(new BigDecimal(exOrderVO.getTotalAmt()).subtract(amtCalcViewVO.getTotalAmountPaid()).doubleValue());
			}
			
			exOrderBillVO.setSupplierId(supplierVO.getId());
			exOrderBillVO.setSupplierType(supplierVO.getSupplierType());
			exOrderBillVO.setSupplierName(supplierVO.getFullName());
			exOrderBillVO.setAcctId(supplierVO.getAccountId());
			insertSingleBill(exOrderVO, exOrderBillVO, acctTransVO, billPaymentList, getSessionInfoBean().getCompanyVO().getId());
			onBillSelected(exOrderBillVO.getId());
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("addSingleBill");
		}
	}
	
	/**
	 * Edit Single Bill
	 */
	public void editSingleBill() {
		try {
			trackingLogUtils.startLogs();
			
			// check financial closed / gst submitted
			ExOrderBillVO oriVO = (ExOrderBillVO) getOriObj();
			checkFinGSTClosed(CommonConstant.ACTION_CD_UPD, oriVO.getBillDt(), exOrderBillVO.getBillDt(), invPmntAuthVO.isAccountManager());
			
			if (exOrderBillVO.getBillAmt().doubleValue() <= 0 && CollectionUtils.isNotEmpty(billPaymentList) && !isMultiple) throw new BusinessException(CommonErrConstant.ERR_BILL_PMNT_NEGATIVE);
			
			if (CollectionUtils.isNotEmpty(exOrderBillVO.getEoBillPersonList()) && exOrderBillVO.getBillAmt().doubleValue() != totalAmtPerson) throw new BusinessException(CommonErrConstant.ERR_BILL_PMNT_PERSON_LIST_NOT_TALLY);
			
			if (CollectionUtils.isNotEmpty(acctTransVO.getAcctTransList())) {
				/*if ((amtCalcViewVO.getTotalAmountIncludeTax().compareTo(new BigDecimal(exOrderBillVO.getBillAmt().toString()))) == 0) {
					if (CollectionUtils.isEmpty(billPaymentList)) {
						exOrderBillVO.setStatus(CommonConstant.STATUS_CD_BILLED);
						exOrderVO.setAmtDue(exOrderVO.getTotalAmt());
						exOrderVO.setStatus(CommonConstant.STATUS_CD_BILLED);
						
					} else {
						if(totalPymtAmt.doubleValue() == exOrderBillVO.getBillAmt().doubleValue()) {
							exOrderBillVO.setStatus(CommonConstant.STATUS_CD_PAID);
							exOrderVO.setStatus(CommonConstant.STATUS_CD_PAID);
							
						} else if(totalPymtAmt.doubleValue() < exOrderBillVO.getBillAmt().doubleValue()){
							exOrderBillVO.setStatus(CommonConstant.STATUS_CD_PAID);
							exOrderVO.setStatus(CommonConstant.STATUS_CD_PAID);
						}
						exOrderVO.setAmtDue(new BigDecimal(exOrderVO.getTotalAmt()).subtract(amtCalcViewVO.getTotalAmountPaid()).doubleValue());
					}
				} else throw new BusinessException(CommonErrConstant.ERR_BANK_PAYMENT_NOT_EQUAL);*/
				if ((amtCalcViewVO.getTotalAmountIncludeTax().compareTo(new BigDecimal(exOrderBillVO.getBillAmt().toString()))) != 0) {
					throw new BusinessException(CommonErrConstant.ERR_BANK_PAYMENT_NOT_EQUAL);
				}
			} else throw new BusinessException(CommonErrConstant.ERR_BANK_PAYMENT_NOT_EQUAL);
			
			journalBO.validateJournalTotalAgainstBill(exOrderBillVO);
			
			if (CollectionUtils.isEmpty(billPaymentList)) {
				exOrderBillVO.setStatus(CommonConstant.STATUS_CD_BILLED);
				exOrderVO.setAmtDue(exOrderVO.getTotalAmt());
				exOrderVO.setStatus(CommonConstant.STATUS_CD_BILLED);
				
			} else {
				exOrderBillVO.setStatus(CommonConstant.STATUS_CD_PAID);
				exOrderVO.setStatus(CommonConstant.STATUS_CD_PAID);
				exOrderVO.setAmtDue(new BigDecimal(exOrderVO.getTotalAmt()).subtract(amtCalcViewVO.getTotalAmountPaid()).doubleValue());
			}
			
			generateBillRemarks();
			
			for (JournalVO journalVO : exOrderBillVO.getJournalList()) {
				saveJournalCart(journalVO, exOrderBillVO.getId());
			}

			exOrderBillVO.setSupplierId(supplierVO.getId());
			exOrderBillVO.setSupplierType(supplierVO.getSupplierType());
			exOrderBillVO.setSupplierName(supplierVO.getFullName());
			exOrderBillVO.setAcctId(supplierVO.getAccountId());
			updateSingleBill(oldExOrderID, exOrderVO, exOrderBillVO, acctTransVO, acctTransViewList, billPaymentList, billPaymentViewList);
			onBillSelected(exOrderBillVO.getId());
			successResult();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("editSingleBill");
		}
	}
	
	/**
	 * Delete Bill
	 */
	public void deleteBill() {
		try {
			trackingLogUtils.startLogs();
			
			// Unable to delete this record due to financial period closed.
			if (isDateInFinPeriodClosed()) throw new BusinessException(CommonErrConstant.ERR_ACCT_FIN_PERIOD_CLOSED_CANNOT_DEL);
			
			billPymtBO.delBill(exOrderVO, exOrderBillVO, acctTransVO, billPaymentList);
			resetForm();
			initSingleBill();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("deleteBill");
		}
	}
	
	/**
	 * 
	 */
	public void onAddGLAcct() {
		if (null == exOrderBillVO.getBillAmt()) acctTransViewVO.setDebit(0.0);
		else acctTransViewVO.setDebit(exOrderBillVO.getBillAmt());
		
		if (CollectionUtils.isNotEmpty(acctTransVO.getAcctTransList())) {
			for (AcctTransVO vo : acctTransVO.getAcctTransList()) {
				acctTransViewVO.setDebit(new BigDecimal(acctTransViewVO.getDebit().toString()).
						subtract(new BigDecimal(String.valueOf(vo.getDAmountIncludeTax()))).doubleValue());
			}
		}
		acctTransViewVO.setAmount(acctTransViewVO.getDebit());
		acctTransViewVO.seteInvoiceClassCode(EInvoiceConstant.CLASS_CODE_SELF_BILL_OTHERS);
	}
	
	/**
	 * Add G/L Account
	 */
	public void addGLAcct() {
		try {
			if(null == acctTransVO.getAcctTransList()) acctTransVO.setAcctTransList(new ArrayList<AcctTransVO>());
			
			if (acctTransViewVO.getAmount() < 0) {
				acctTransViewVO.setCredit(-acctTransViewVO.getAmount());
				acctTransViewVO.setDebit(0.0);
			} else {
				acctTransViewVO.setCredit(0.0);
				acctTransViewVO.setDebit(acctTransViewVO.getAmount());
			}
			acctTransVO.getAcctTransList().add(acctTransViewVO);
			
			updateTaxableAmount(false);
			resetGLAcctForm();
			onAddGLAcct();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Edit G/L Account
	 */
	public void editGLAcct() {
		try {
			if (acctTransViewVO.getAmount() < 0) {
				acctTransViewVO.setCredit(-acctTransViewVO.getAmount());
				acctTransViewVO.setDebit(0.0);
			} else {
				acctTransViewVO.setCredit(0.0);
				acctTransViewVO.setDebit(acctTransViewVO.getAmount());
			}
			updateTaxableAmount(false);
			resetGLAcctForm();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
