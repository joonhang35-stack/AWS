<!-- Password Reset Title Banner Section (Connects directly under top logo) -->
<table class="row" style="width:100%; border-collapse:collapse; border-spacing:0; background-color: #7c51a1; text-align: center; margin:0; padding:0;">
  <tbody>
    <tr>
      <td style="padding: 0px 30px 35px 30px; text-align: center;">
        <table role="presentation" align="center" cellpadding="0" cellspacing="0" style="margin: 0 auto;">
          <tr>
            <td style="background-color: rgba(255, 255, 255, 0.2); border-radius: 50%; width: 44px; height: 44px; text-align: center; vertical-align: middle;">
              <span style="font-size: 22px; line-height: 44px;">🔑</span>
            </td>
            <td style="padding-left: 14px; font-size: 26px; font-weight: bold; color: #ffffff; font-family: Helvetica, Arial, sans-serif; vertical-align: middle;">
              Password Reset
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </tbody>
</table>

<!-- Main Content Area -->
<table class="row" style="width:100%; border-collapse:collapse; border-spacing:0; background-color: #ffffff; font-family: Helvetica, Arial, sans-serif; margin:0; padding:0;">
  <tbody>
    <tr>
      <td style="padding: 35px 40px 30px 40px;">
        
        <!-- Greeting with Left Purple Accent Border -->
        <div style="border-left: 3px solid #7c51a1; padding-left: 14px; margin-bottom: 25px;">
          <p style="margin: 0 0 10px 0; font-size: 16px; color: #333333; font-family: Helvetica, Arial, sans-serif;">
            Dear <strong>${(userName)!''}</strong> (${(userId)!''}),
          </p>
          <p style="margin: 0; font-size: 15px; color: #555555; line-height: 1.5; font-family: Helvetica, Arial, sans-serif;">
            A request was made to reset/update the password on your ERP/AWS account. Please click the button below to proceed.
          </p>
        </div>

        <!-- Reset Password Pill Button -->
        <table role="presentation" align="center" cellpadding="0" cellspacing="0" style="margin: 30px auto 35px auto;">
          <tr>
            <td align="center" style="border-radius: 25px; background-color: #7c51a1;">
              <a href="${(url)!''}" target="_blank" style="font-size: 16px; font-family: Helvetica, Arial, sans-serif; color: #ffffff; text-decoration: none; border-radius: 25px; padding: 14px 40px; border: 1px solid #7c51a1; display: inline-block; font-weight: bold; letter-spacing: 0.5px;">
                RESET PASSWORD
              </a>
            </td>
          </tr>
        </table>

        <!-- Important Notice (White Background, Full Width of Content Area) -->
        <div style="background-color: #ffffff; margin-top: 25px; margin-bottom: 10px;">
          <p style="margin: 0; font-size: 14px; color: #666666; font-family: Helvetica, Arial, sans-serif; line-height: 1.6;">
            <span style="background-color: #fff2b8; color: #333333; font-weight: bold; padding: 2px 6px; border-radius: 3px; font-size: 13.5px;">Important: This link will expire in 24 hours.</span>
            If you did not request a password reset, no action is needed — your account remains secure.
          </p>
        </div>

      </td>
    </tr>
  </tbody>
</table>

<!-- Full Width Bottom Footer (Fits 100% width at the bottom of the template) -->
<table class="row" style="width:100%; border-collapse:collapse; border-spacing:0; background-color: #f8f8f8; font-family: Helvetica, Arial, sans-serif; margin:0; padding:0; border-top: 1px solid #eeeeee;">
  <tbody>
    <tr>
      <td style="padding: 20px 40px; text-align: center;">
        <p style="margin: 0; font-size: 13px; color: #888888; font-family: Helvetica, Arial, sans-serif; line-height: 1.5;">
          This is an automated message — please do not reply.
        </p>
        <p style="margin: 4px 0 0 0; font-size: 13px; color: #888888; font-family: Helvetica, Arial, sans-serif; line-height: 1.5;">
          Need help? Please contact IT Support
        </p>
      </td>
    </tr>
  </tbody>
</table>
