<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui">
	
<f:view contentType="text/html" locale="#{localeBean.locale}" >
    <h:head>
		<link rel="shortcut icon" href="#{contextPath}/img/apple_logo_v2.ico" />
    	<f:facet name="first">
            <meta http-equiv="X-UA-Compatible" content="EmulateIE8" />
            <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
            <title><h:outputFormat value="#{msg['common.title']}"/></title>
        </f:facet>
	    
		<style type="text/css">
			body {
				padding:0px !important;
				margin:0px !important;
			}
			html, body
			{
			    height: 100%;
			}
		</style>
		
	</h:head>
	
    <h:body style="height:100">
    <p:media value="/pdf/gst/#{ request.getParameter('file')}.pdf" 
    		player="pdf" width="100%" height="100%" />
 	</h:body>

</f:view>
</html>