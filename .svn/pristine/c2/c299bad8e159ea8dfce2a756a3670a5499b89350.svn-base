<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:p="http://primefaces.org/ui"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">
	
<c:set var="contextPath" value="${request.contextPath}"/>
<c:set var="isLoggedIn" value="${not empty sessionInfoBean.userVO.loginId}"/>

<f:view contentType="text/html" locale="#{localeBean.locale}">
    <h:head>
 <!--     <meta http-equiv="X-UA-Compatible" content="IE=8"></meta>
      -->
    	<link rel="shortcut icon" href="#{contextPath}/img/aws/favicon.png" />
    	<f:facet name="first">
            <meta http-equiv="X-UA-Compatible" content="EmulateIE8" />
            <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
            <title><h:outputFormat value="#{msg['common.title']}"/></title>
        </f:facet>
    
		<link type="text/css" rel="stylesheet" href="#{request.contextPath}/css/default.css" />
        <link type="text/css" rel="stylesheet" href="#{request.contextPath}/css/syntaxhighlighter.css" />
        <link type="text/css" rel="stylesheet" href="#{request.contextPath}/css/style.css" />
        <script language="javascript" src="#{contextPath}/js/script.js"/>
        <ui:insert name="headIncludes"/>
        
        <script type="text/javascript">
	        function preventBackspace(e) {
				var evt = e || window.event;
				if (evt) {
					var keyCode = evt.charCode || evt.keyCode;
					if (keyCode === 8) {
						if (evt.preventDefault) {
							evt.preventDefault();
						} else {
							evt.returnValue = false;
						}
					}
				}
			}
		</script>
		
		<style>
			#idTourDepListDialog.ui-dialog,
			#idAddInvoiceDialog.ui-dialog,
			#idDetailsDialog.ui-dialog,
			#idEditAccCodeDialog.ui-dialog,
			#idInvoiceHistoryListDialog.ui-dialog,
			#idTourDepHistoryListDialog.ui-dialog {
				width: 100% !important;
				height: 100% !important;
				overflow: auto;
			}
			#idMulpEInvDialog.ui-dialog,
			#idConsolEInvDialog.ui-dialog {
				/*width: 95% !important;
				height: 95% !important;*/
				width: 95vw !important;
				height: 95vh !important;
				
			}
			#idBookingListDialog.ui-dialog {
				width: 100% !important;
				height: 100% !important;
				overflow: auto;
			}
		</style>
    </h:head>
    <h:body>
    	<p:ajaxStatus onstart="varStatusDialog.show();" onsuccess="varStatusDialog.hide();" onerror="varStatusDialog.hide(); varErrorDialog.show();"/>
              
		<p:dialog modal="true" widgetVar="varStatusDialog" header="Loading..." draggable="false" closable="false">
		    <p:graphicImage value="/img/ajaxloadingbar.gif"/>
		</p:dialog>
		
		<!--p:ajaxStatus style="width:64px;height:64px;position:fixed;right:5px;bottom:5px">  
			<f:facet name="start">  
				<p:graphicImage value="/img/loading.gif" />  
			</f:facet>
			<f:facet name="complete">  
				<h:outputText value="" />  
			</f:facet>  
		</p:ajaxStatus-->
		
		<p:dialog modal="true" widgetVar="varErrorDialog" header="Error" draggable="false" closable="true">
			<p:hotkey bind="esc" handler="varErrorDialog.hide()"/>
			<div class="ui-messages ui-widget">
				<div class="ui-messages-fatal ui-corner-all">
					<span class="ui-messages-fatal-icon"></span>
					<ul><li><span class="ui-messages-fatal-summary"><h:outputText value="#{err['ERR_GENERAL_EXCEPTION']}"/></span></li></ul>
				</div>
			</div>
		</p:dialog>
		
		<table class="tbl_layout" cellpadding="0" cellspacing="0" style="width: 100%">
			<tr class="ui-widget ui-widget-main-header">
				<td style="padding:10px 0 0 20px;">
					<p:graphicImage value="/img/aws/header_logo.png"/>
				</td>
				<td style="padding:5px; text-align:right; width:300px; font-size:11px; font-weight:normal;">
					<c:if test="#{isLoggedIn}">
						<table>
							<tr><td style="width:75px;">Company</td><td style="width:5px;">:</td><td><h:outputText id="idLoginCompany" value="#{sessionInfoBean.companyVO.name}"/></td></tr>
							<tr><td>Login ID</td><td style="width:5px;">:</td><td><h:outputText value="#{sessionInfoBean.userVO.loginId}"/></td></tr>
							<tr><td>Username</td><td style="width:5px;">:</td><td><h:outputText value="#{sessionInfoBean.userVO.name}"/></td></tr>
							<!-- <tr>
								<td colspan="3">
									<br/>
									<c:if test="#{bterp:isNotificationAvailable()}">
										<a href="#{contextPath}/app/home" style="color:#FFFF00;"><span style="text-decoration:blink;">Notification available</span></a>
									</c:if>
								</td>
							</tr> -->
						</table>
					</c:if>
				</td>
			</tr>
			<c:if test="${not empty menuBean.menuModel}">
			<tr>
				<td colspan="100%">
					<p:menubar model="#{menuBean.menuModel}" autoDisplay="#{not request.getHeader('user-agent').contains('Mobile')}"/>
				</td>
			</tr>
			</c:if>
		</table>
		<br/>
    	<table cellpadding="0" cellspacing="0">
    		<colgroup>
    			<col width="1%"/>
    			<col width="98%"/>
    			<col width="1%"/>
    		</colgroup>
    		<c:if test="${not empty menuBean.breadCrumbModel}">
			<tr>
				<td>&nbsp;</td>
				<td><p:breadCrumb model="#{menuBean.breadCrumbModel}"/></td>
				<td>&nbsp;</td>
			</tr>
			</c:if>
			<tr>
				<td>&nbsp;</td>
				<td style="padding-top:10px"><ui:insert name="content"/></td>
				<td>&nbsp;</td>
			</tr>
			<tr>
				<td>&nbsp;</td>
				<td colspan="2"><ui:insert name="footerNotes"/></td>
				<td>&nbsp;</td>
			</tr>
		</table>
        <table class="tbl_layout" cellpadding="0" cellspacing="0">
			<colgroup>
				<col width="1%"/>
				<col width="98%"/>
				<col width="1%"/>
			</colgroup>
			<tr>
				<td>&nbsp;</td>
				<td class="txt_center">
					<ui:insert name="footer">
						<c:if test="${not empty appVersion}"><br/>v${appVersion}</c:if>
						<br/><h:outputText styleClass="ui-widget" value="#{msg['common.app.version']} &copy; #{msg['common.year.begin']}-Present #{msg['common.company.name']} Your usage of this system indicates that you agree to be bound by Employees PDPA &amp; CNDA Agreement"/><br/><br/>
					</ui:insert>
				</td>
				<td>&nbsp;</td>
			</tr>
		</table>
        
    </h:body>
</f:view>
</html>
