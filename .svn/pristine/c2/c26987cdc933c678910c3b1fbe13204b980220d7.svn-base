package com.bcs.zsg.purchase.vo;

import java.util.List;

import com.bcs.zsg.core.vo.BaseVO;

public class SuppMaintVO  extends BaseVO{
	private static final long serialVersionUID = 1L;

	private SupplierVO supplierVO;
	private PersonVO personVO;
	private ContactVO contactVO;
	private AddressVO addressVO;
	private IdentityVO identityVO;
	private RemarksVO remarksVO;
	
	private boolean addEdit;
	private List<IdentityVO> identityList;
	private List<ContactVO> contactList;
	private List<RemarksVO> remarksList;
	
	public SupplierVO getSupplierVO() {
		return supplierVO;
	}
	public void setSupplierVO(SupplierVO supplierVO) {
		this.supplierVO = supplierVO;
	}
	public PersonVO getPersonVO() {
		return personVO;
	}
	public void setPersonVO(PersonVO personVO) {
		this.personVO = personVO;
	}
	public ContactVO getContactVO() {
		return contactVO;
	}
	public void setContactVO(ContactVO contactVO) {
		this.contactVO = contactVO;
	}
	public AddressVO getAddressVO() {
		return addressVO;
	}
	public void setAddressVO(AddressVO addressVO) {
		this.addressVO = addressVO;
	}
	public IdentityVO getIdentityVO() {
		return identityVO;
	}
	public void setIdentityVO(IdentityVO identityVO) {
		this.identityVO = identityVO;
	}
	public boolean isAddEdit() {
		return addEdit;
	}
	public void setAddEdit(boolean addEdit) {
		this.addEdit = addEdit;
	}
	public List<IdentityVO> getIdentityList() {
		return identityList;
	}
	public void setIdentityList(List<IdentityVO> identityList) {
		this.identityList = identityList;
	}
	public List<ContactVO> getContactList() {
		return contactList;
	}
	public void setContactList(List<ContactVO> contactList) {
		this.contactList = contactList;
	}
	public List<RemarksVO> getRemarksList() {
		return remarksList;
	}
	public void setRemarksList(List<RemarksVO> remarksList) {
		this.remarksList = remarksList;
	}
	public RemarksVO getRemarksVO() {
		return remarksVO;
	}
	public void setRemarksVO(RemarksVO remarksVO) {
		this.remarksVO = remarksVO;
	}
	
}
