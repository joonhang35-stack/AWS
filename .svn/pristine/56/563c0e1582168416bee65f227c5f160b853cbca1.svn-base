<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.acct.vo">

    <class table="financial_period" name="FinancialPeriodVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idCompany" type="long" column="id_company"/>
        <property name="year" type="string" column="year"/>
        <property name="seqNo" type="integer" column="seq_no"/>
        <property name="desc" type="string" column="description"/>
        <property name="dtStart" type="timestamp" column="dt_start"/>
        <property name="dtEnd" type="timestamp" column="dt_end"/>
        <property name="status" type="integer" column="status"/>
        <property name="periodType" type="integer" column="period_type"/>
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>