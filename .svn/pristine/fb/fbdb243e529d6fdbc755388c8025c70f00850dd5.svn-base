package com.bcs.zsg.common.vo;

import java.io.Serializable;

public class BooleanAddUpdDelVO implements Serializable {

	private static final long serialVersionUID = 1L;
	private boolean isAdd;
	private boolean isUpd;
	private boolean isDel;
	
	/**
	 * 
	 * @param isAdd
	 * @param isUpd
	 * @param isDel
	 */
	public BooleanAddUpdDelVO(boolean isAdd, boolean isUpd, boolean isDel) {
		this.isAdd = isAdd;
		this.isUpd = isUpd;
		this.isDel = isDel;
	}

	/**
	 * @return the isAdd
	 */
	public boolean isAdd() {
		return isAdd;
	}

	/**
	 * @param isAdd the isAdd to set
	 */
	public void setAdd(boolean isAdd) {
		this.isAdd = isAdd;
	}

	/**
	 * @return the isUpd
	 */
	public boolean isUpd() {
		return isUpd;
	}

	/**
	 * @param isUpd the isUpd to set
	 */
	public void setUpd(boolean isUpd) {
		this.isUpd = isUpd;
	}

	/**
	 * @return the isDel
	 */
	public boolean isDel() {
		return isDel;
	}

	/**
	 * @param isDel the isDel to set
	 */
	public void setDel(boolean isDel) {
		this.isDel = isDel;
	}
}
