package com.bcs.zsg.purchase.vo;

import java.util.Date;

import com.bcs.zsg.core.vo.BaseVO;

public class AirLineDetailsVO  extends BaseVO{
	private static final long serialVersionUID = 1L;
	
	private String point;
	private String flightNo;
	private String airClass;
	private String status;
	private String airLinePnr;
	private String time;
	private String strAirLineDt;
	private Date airLineDt;
	private Integer airLineNo;
	private Long exOrderId;
	private Integer seq;
	
	public String getPoint() {
		return point;
	}
	public void setPoint(String point) {
		this.point = point;
	}
	public String getFlightNo() {
		return flightNo;
	}
	public void setFlightNo(String flightNo) {
		this.flightNo = flightNo;
	}
	public String getAirClass() {
		return airClass;
	}
	public void setAirClass(String airClass) {
		this.airClass = airClass;
	}
	public String getStatus() {
		return status;
	}
	public void setStatus(String status) {
		this.status = status;
	}
	public String getAirLinePnr() {
		return airLinePnr;
	}
	public void setAirLinePnr(String airLinePnr) {
		this.airLinePnr = airLinePnr;
	}
	public String getTime() {
		return time;
	}
	public void setTime(String time) {
		this.time = time;
	}
	public Date getAirLineDt() {
		return airLineDt;
	}
	public void setAirLineDt(Date airLineDt) {
		this.airLineDt = airLineDt;
	}
	public Integer getAirLineNo() {
		return airLineNo;
	}
	public void setAirLineNo(Integer airLineNo) {
		this.airLineNo = airLineNo;
	}
	public String getStrAirLineDt() {
		return strAirLineDt;
	}
	public void setStrAirLineDt(String strAirLineDt) {
		this.strAirLineDt = strAirLineDt;
	}
	public Long getExOrderId() {
		return exOrderId;
	}
	public void setExOrderId(Long exOrderId) {
		this.exOrderId = exOrderId;
	}
	public Integer getSeq() {
		return seq;
	}
	public void setSeq(Integer seq) {
		this.seq = seq;
	}

}
