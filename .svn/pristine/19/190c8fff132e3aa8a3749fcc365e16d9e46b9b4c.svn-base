<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

<p:growl id="msg"/>

<script type="text/javascript">
	function onValidation(xhr, status, args) {
		if (args.validationFailed) {
			varLangDialog.show();
		} else {
			varLangDialog.hide();
		}
	}
</script>

<p:panelGrid>
	<p:row>
		<p:column>
			<h:outputLabel for="idLangType">Spoken Language <span class="required">*</span></h:outputLabel>
		</p:column>
		<p:column>
			<h:selectOneMenu id="idLangType" label="Spoken Language" value="#{custBean.personLangVO.langCd}" required="true">  
	            <f:selectItem itemLabel="Select One" itemValue=""/>
	            <f:selectItems value="#{bterp:lookupItemList('lang_dilc')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
	        </h:selectOneMenu>
        </p:column>
	</p:row>
</p:panelGrid>

<h:panelGrid columns="2" style="width: 1px;">
	<p:commandButton value="#{msg['common.button.label.save']}" actionListener="#{custBean.addLanguage}" update="@form,:idEditCustForm:idLangListPanel" rendered="#{custBean.languageAdd}"/>
	<p:commandButton value="#{msg['common.button.label.update']}" actionListener="#{custBean.updateLanguage}" update="@form,:idEditCustForm:idLangListTable" oncomplete="onValidation(xhr, status, args)" rendered="#{not custBean.languageAdd}"/>
	<p:commandButton value="#{msg['common.button.label.cancel']}" actionListener="#{custBean.resetLanguageForm}" update="@form" process="@this" oncomplete="varLangDialog.hide()" global="false">
		<pe:resetEditableValues for="idLangForm"/>
	</p:commandButton>
</h:panelGrid>

</ui:composition>