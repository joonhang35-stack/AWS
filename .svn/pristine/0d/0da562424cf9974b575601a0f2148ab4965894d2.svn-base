<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="forgot_password_form">
	
	<!-- backing bean, extends com.bcs.zsg.component.common.web.swf.bean.AppBackingBean -->
	<var name="forgotPasswordBean" class="com.bcs.zsg.cfg.sec.web.bean.ForgotPasswordBean"/>
	
	<on-start>
		<evaluate expression="forgotPasswordBean.init()" />
	</on-start>
	
	<view-state id="forgot_password_form">
	</view-state>
	
	<end-state id="finish" />
	
</flow>