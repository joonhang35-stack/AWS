<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf">

	<p:growl id="msg"/>
	<p:panelGrid>
		<p:row>
			<p:column><h:outputLabel for="idViewBankName">Bank Name </h:outputLabel></p:column>
			<p:column>
				<p:inputText id="idViewBankName" label="GL Account" value="#{billPymtBean.billPaymentVO.bankName}" required="true"  readonly="true" disabled="#{billPymtBean.billPaymentVO.dateInPeriodClosed}"/>
			</p:column>
			<p:column><h:outputLabel for="idViewBankAcc">GL Account </h:outputLabel></p:column>
			<p:column>
				<p:inputText id="idViewBankAcc" label="GL Account" value="#{billPymtBean.billPaymentVO.bankAcct}" required="true" readonly="true" disabled="#{billPymtBean.billPaymentVO.dateInPeriodClosed}"/>
			</p:column>
		</p:row>
		<p:row>
			<p:column><h:outputLabel for="idViewDate">Date </h:outputLabel></p:column>
			<p:column>
				<p:calendar pattern="dd-MMM-yyyy" id="idViewDate" label="Date" 
					mindate="#{bterp:finPeriodLockVO(sessionInfoBean.companyVO.id).dtStart}" 
					maxdate="#{bterp:finPeriodLockVO(sessionInfoBean.companyVO.id).dtEnd}" navigator="true" showButtonPanel="true"
					value="#{billPymtBean.billPaymentVO.pymtDt}" readonlyInput="true" disabled="#{billPymtBean.billPaymentVO.dateInPeriodClosed}"/>
				</p:column>
			<p:column><h:outputLabel for="idViewChequeNo">Cheque No </h:outputLabel></p:column>
			<p:column><p:inputText id="idViewChequeNo" label="Cheque No" value="#{billPymtBean.billPaymentVO.refNum}" required="true" disabled="#{billPymtBean.billPaymentVO.dateInPeriodClosed}" maxlength="25" /></p:column>
		</p:row>
		<p:row>
			<p:column><h:outputLabel for="idViewPayTo">Pay to </h:outputLabel></p:column>
			<p:column>
				<p:inputText id="idViewPayTo" label="Pay to" value="#{billPymtBean.billPaymentVO.payee}" required="true" disabled="#{billPymtBean.billPaymentVO.dateInPeriodClosed}"/>  
			</p:column>
		</p:row>
		<p:row>
			<p:column><h:outputLabel for="idViewAmtPaid">Amount Paid </h:outputLabel></p:column>
			<p:column>
				<p:inputText id="idViewAmtPaid" label="Amount Paid" value="#{billPymtBean.billPaymentVO.pmntAmount}" readonly="#{billPymtBean.billPaymentVO.pmntType eq 'M'}" disabled="#{billPymtBean.billPaymentVO.dateInPeriodClosed}">
					<f:convertNumber pattern="#,##0.00"/>
				</p:inputText>
			</p:column>
			<p:column><h:outputLabel for="idViewMemoTextBox">Memo Text Box </h:outputLabel></p:column>
			<p:column><p:inputTextarea id="idViewMemoTextBox" label="Memo Text Box" value="#{billPymtBean.billPaymentVO.remarks}"/></p:column>
		</p:row>
	</p:panelGrid>
	
	<p:panelGrid columns="3" style="width: 1px;">
		<p:commandButton value="Cancel" actionListener="#{billPymtBean.resetPymtForm}" oncomplete="varViewPymtDialog.hide()" update="@form" process="@this">
			<pe:resetEditableValues for="idViewPymtForm"/>
		</p:commandButton>
	</p:panelGrid>
</ui:composition>