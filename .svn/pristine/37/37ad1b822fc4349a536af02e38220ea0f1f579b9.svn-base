<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf">
	<p:panelGrid>
		<p:row>
			<p:column>
				<p:fieldset legend="Print Report ">
					<p:panelGrid>
						<p:row>
						<p:column>
							<h:outputLabel for="idAddLastName">Supplier Statement </h:outputLabel>
						</p:column>
						<p:column>
							<p:selectBooleanCheckbox value="" /> 
					    </p:column>
						<p:column>
							<h:outputLabel for="idAddLastName">Unpaid Bills By Supplier </h:outputLabel>
						</p:column>
						<p:column>
							<p:selectBooleanCheckbox value="" /> 
					    </p:column>
						</p:row>
					</p:panelGrid>
				</p:fieldset>
			</p:column>
		</p:row>
		<p:row>
			<p:column>
				<p:fieldset legend="Print Choices ">
					<p:panelGrid>
						<p:row>
							<p:column>
							<p:selectOneRadio value="">  
					            <f:selectItem itemLabel="Print Current Supplier" itemValue="1" />  
					            <f:selectItem itemLabel="Print All" itemValue="2" /> 
				        	</p:selectOneRadio>  
				        	</p:column>
						</p:row>
					</p:panelGrid>
				</p:fieldset>
				<p:fieldset legend="Date Range ">
					<p:panelGrid>
						<p:row>
							<p:column>
								<h:outputLabel for="idAddLastName">From </h:outputLabel>
							</p:column>
							<p:column>
								<p:calendar value="#{purchaseBean.date}" id="popupCal" navigator="true" showButtonPanel="true" />
						    </p:column>
						</p:row>
						<p:row>
							<p:column>
								<h:outputLabel for="idAddLastName">To </h:outputLabel>
							</p:column>
							<p:column>
								<p:calendar value="#{purchaseBean.date}" id="popupCal2" navigator="true" showButtonPanel="true" />
						    </p:column>
						</p:row>
					</p:panelGrid>
				</p:fieldset>
			</p:column>
		</p:row>
		<p:row>
			<p:column>
				<p:commandButton value="Print"/>
				<p:commandButton value="Cancel" onclick="varPrintDialog.hide()" process="@this" />
			</p:column>
		</p:row>
	</p:panelGrid>
</ui:composition>