<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
				template="/WEB-INF/views/layouts/main.xhtml">

<ui:define name="content">

	<h:form id="idForm">
		<p:growl id="msg"/>
		<p:tabView >
    			<p:tab title="Input Tax" style="width:150px;">
				<p:dataTable id="idInputTaxCodeList" value="#{gstBean.inputTaxCodeVOList}" var="vo">
					<p:column headerText="No." sortBy="#{vo.seqNo}" width="25" style="text-align:right;">
						<h:outputText value="#{vo.seqNo}"/>
					</p:column>
					<p:column headerText="Code" sortBy="#{vo.code}" width="50">
						<h:outputText value="#{vo.code}" />
					</p:column>
					<p:column headerText="Description" >
						<h:outputText value="#{vo.description}" />
					</p:column>
					<p:column headerText="Rate (%)" width="50" style="text-align:right;" sortBy="#{vo.rate}" >
						<h:outputText value="#{vo.rate}">
							<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
						</h:outputText>
					</p:column>
				</p:dataTable>
			</p:tab>
    			<p:tab title="Output Tax" style="width:150px;">
				<p:dataTable id="idOutputTaxCodeList" value="#{gstBean.outputTaxCodeVOList}" var="vo">
					<p:column headerText="No." sortBy="#{vo.seqNo}" width="25" style="text-align:right;">
						<h:outputText value="#{vo.seqNo}"/>
					</p:column>
					<p:column headerText="Code" sortBy="#{vo.code}" width="50">
						<h:outputText value="#{vo.code}" />
					</p:column>
					<p:column headerText="Description" >
						<h:outputText value="#{vo.description}" />
					</p:column>
					<p:column headerText="Rate (%)" width="50" style="text-align:right;" sortBy="#{vo.rate}" >
						<h:outputText value="#{vo.rate}">
							<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
						</h:outputText>
					</p:column>
				</p:dataTable>
			</p:tab>
		</p:tabView>
	</h:form>
	
</ui:define>
</ui:composition>