<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.sales.vo">

    <class table="online_booking_passenger" name="OnlineBookingPassengerVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="idBooking" column="id_booking"/>
        <property name="roomNo" column="room_no"/>
		<property name="salutationCd" column="salutation_cd"/>
		<property name="titleCd" column="title_cd"/>
		<property name="surname" column="surname"/>
		<property name="givenName" column="given_name"/>
		<property name="nickName" column="nick_name"/>
		<property name="taxIdNo" column="tax_id_no"/>
		<property name="sexCd" column="sex_cd"/>
		<property name="icNo" column="ic_no"/>
		<property name="dob" column="dob"/>
		<property name="passportNo" column="passport_no"/>
		<property name="dtExpiry" column="dt_expiry"/>
		<property name="idCountry" column="id_country"/>
		<property name="isBillingPerson" column="is_billing_person"/>
		<property name="idCustomer" column="id_customer"/>

        <!-- BaseVO attributes -->
        <property name="remarks" type="string" column="remarks"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>