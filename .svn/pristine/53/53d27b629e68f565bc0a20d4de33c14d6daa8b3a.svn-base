	/**
	 * Journal init
	 */
	public void init() {
		this.trackingLogUtils = new TrackingLogUtils(getClass());
//		TrackingLogUtils trackingLogUtils = new TrackingLogUtils(getClass());
		try {
			
//			trackingLogUtils.startLogs();
			
			initSearchParam();
			resetForm();
			loadJournalDateRange();
			loadSupplier();
			
			// Get user assigned role list
			List<UserRoleViewVO> userRoleList = securityBO.getUserRoleListByUser(this.getSessionInfoBean().getUserVO().getUuid());
			// User Authorize
			invPmntAuthVO = new InvPmntAuthVO();
			if (CollectionUtils.isNotEmpty(userRoleList)) {
				for (UserRoleViewVO userRoleVO : userRoleList) {
					if (userRoleVO.getRoleCode().equalsIgnoreCase(SalesConstant.ACCT_MANAGER_ROLE)) {
						invPmntAuthVO.setAccountManager(true);
						break; // Take "break" out if more then 1
					}
				}
			}
			// GST Code
			setInputTaxCodeVOList(gstBO.getTaxCodeList(GSTType.INPUT));
			setOutputTaxCodeVOList(gstBO.getTaxCodeList(GSTType.OUTPUT));
			acctViewList = chartOfAcctBO.getAcctViewList(getSessionInfoBean().getCompanyVO().getId(), null);
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
//			trackingLogUtils.endLogs("JournalBean.init");
		}
	}
	
	private void calcJourItemTotal(boolean isCalGLItems) {
		totalCrdAmt = new BigDecimal("0.00");
		totalDbtAmt = new BigDecimal("0.00");
		
		for(AcctTransVO journalItem : journalCartList){
			if(journalItem.getCredit() != 0.00) {
				journalItem.setAmount(journalItem.getCredit());
				totalCrdAmt = totalCrdAmt.add(new BigDecimal(String.valueOf(journalItem.getCredit()))
												.add(new BigDecimal(String.valueOf(journalItem.getDTaxAmount()))) );
				
			} else {
				journalItem.setAmount(journalItem.getDebit());
				totalDbtAmt = totalDbtAmt.add(new BigDecimal(String.valueOf(journalItem.getDebit()))
												.add(new BigDecimal(String.valueOf(journalItem.getDTaxAmount()))) );
				
			}
		}
		
		try {
			updateTaxableAmount(isCalGLItems);
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	private void updateTaxableAmount(boolean isCalGLItems) throws BusinessException {
		if (isCalGLItems) calculateGLItemsAmount(journalCartList);
		
		amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(amtCalcViewVO, false, journalCartList, null, false);
	}
	
	private void calculateGLItemsAmount(List<AcctTransVO> list) throws BusinessException {
		for (AcctTransVO vo : list) {
			vo.setTaxAmount(vo.getAmount() < 0 ? -vo.getTaxAmount() : vo.getTaxAmount());
			
			BigDecimal amount = new BigDecimal(String.valueOf(vo.getAmount()));
			BigDecimal taxAmount = new BigDecimal(vo.getTaxAmount().toString());
			
			vo.setAmountIncludeTax(amount.add(taxAmount).doubleValue());
		}
	}
	
	public void delJournal() throws BusinessException{
		try {
			// Unable to delete this record due to financial period closed.
			if (isDateInFinPeriodClosed()) throw new BusinessException(CommonErrConstant.ERR_ACCT_FIN_PERIOD_CLOSED_CANNOT_DEL);
			
			journalBO.delJournal(journalVO);
			
			init();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	@SuppressWarnings("unchecked")
	private boolean updateJournaItemList() {
		
		double initialAmount = journalItem.getAmount();
		
		if (this.getAmtType().equals("Debit")) {
			journalItem.setDebit(journalItem.getAmount());
			journalItem.setCredit(0.0);
			
		} else if (this.getAmtType().equals("Credit")) {
			journalItem.setCredit(journalItem.getAmount());
			journalItem.setDebit(0.0);
		}
		
		//this handling to prevent AcctTransVO override amount value in SETCREDIT method
		journalItem.setAmount(initialAmount);
		
		if(getIsAddNewItem()) {
			//New item add to journal chart list.
			journalCartList.add((AcctTransVO) journalItem.clone());
			
			if(!getIsAddNewDetail())
				journalItemsVO.getAddList().add(journalItem.clone());
		} else {

			if(journalItem.getId() != null) {
				boolean isInUpdList = replaceJournalItemInList(((List<AcctTransVO>)((List<?>)journalItemsVO.getUpdList())), 
																prevJournalItem);
				
				//To cater case where the item is loaded and edited but not found in UpdList yet.
				if(!isInUpdList)
					journalItemsVO.getUpdList().add(journalItem.clone());
			} else {
				//For NON-NEW journal detail, new added item, updated again before saving to DB.
				if(!getIsAddNewDetail())
					replaceJournalItemInList(((List<AcctTransVO>)((List<?>)journalItemsVO.getAddList())), 
												prevJournalItem);
			}
			
			//journalCartList Item Being Edited again
			replaceJournalItemInList(journalCartList, prevJournalItem);
			
			prevJournalItem = null;
		}
		calcJourItemTotal(false);
		
		handleJourItemSelect(null);
		return true;
	}
	
	private boolean isSameItemVO(AcctTransVO originalVO, AcctTransVO comparedVO) {
		if(originalVO.getId() == comparedVO.getId() &&
			originalVO.getDesc().equals(comparedVO.getDesc()) &&
			originalVO.getCode().equals(comparedVO.getCode()) &&
			originalVO.getDebit().equals(comparedVO.getDebit()) &&
			originalVO.getCredit().equals(comparedVO.getCredit())) 
			return true;
		else
			return false;
	}
	
	private boolean replaceJournalItemInList(List<AcctTransVO> journalViewList, AcctTransVO prevJourItem) {

		boolean isPrevJourItemFoundInList = false;
		for(int i = 0; i < journalViewList.size(); i++) {
			AcctTransVO tmpVO = journalViewList.get(i);
			
			if(isSameItemVO(tmpVO, prevJourItem)) {
				journalViewList.set(i, (AcctTransVO) journalItem.clone());
				isPrevJourItemFoundInList = true;
				break;
			}
		}
		return isPrevJourItemFoundInList;
	}
	
	public void saveJournalCart() {
		trackingLogUtils.startLogs();
		trackingLogUtils.endLogs("saveJournalCart");
		saveJournalCart(null);
	}
	
	public void saveJournalCartFromBill() {
		trackingLogUtils.startLogs();
		trackingLogUtils.endLogs("saveJournalCartFromBill");
		if (journalVO != null && journalVO.getId() != null)	saveJournalCart(null);
	}
	
	/**
	 * @param idBill - null when calling from journal listing page, not null when calling from bill page posting to journal
	 */
	public void saveJournalCart(ExOrderBillVO exOrderBillVO) {
		try {
			
			trackingLogUtils.startLogs();
			// check financial closed / GST submitted
			if (getOriObj() == null) checkFinGSTClosed(CommonConstant.ACTION_CD_ADD, null, journalVO.getJournalDt(), invPmntAuthVO.isAccountManager());
			else {
				JournalVO oriVO = (JournalVO) getOriObj();
				checkFinGSTClosed(CommonConstant.ACTION_CD_UPD, oriVO.getJournalDt(), journalVO.getJournalDt(), invPmntAuthVO.isAccountManager());
			}
			if (journalCartList.size() == 0)
				throw new BusinessException(CommonErrConstant.ERR_ACCT_JOURNAL_NO_ITEM); 
			if (totalCrdAmt.doubleValue() == totalDbtAmt.doubleValue() && totalCrdAmt.doubleValue() != 0.00 ) {
				journalVO.setTotalAmt(totalCrdAmt.doubleValue());
				
				if (exOrderBillVO != null) {
					journalBO.validateJournalTotalAgainstBill(exOrderBillVO, journalVO.getTotalAmt(), true);
				}
				
				journalVO.setAmountCalcViewVO(amtCalcViewVO);
				if (journalVO.getIdBill() == null && exOrderBillVO != null)	journalVO.setIdBill(exOrderBillVO.getId());				
				if (journalVO.getId() == null){
					journalBO.insertJournal(journalVO, journalCartList);
					// now bill to journal relationship is one to many, ex_order_bill.id_journal is not used already
//					if (exOrderBillVO != null) {
//						billPymtBO.updateJournalToBill(exOrderBillVO.getId(), journalVO.getId());
//					}
				} else {
					journalBO.updateJournal(journalVO, journalCartList, journalItemsVO);
				}
			} else 
				throw new BusinessException(CommonErrConstant.ERR_ACCT_CREDIT_DEBIT_NOT_EQUAL); 
			init();
			successResult();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("saveJournalCart(ExOrderBillVO exOrderBillVO)");
		}
	}
	
	/**
	 * 
	 *  Delete Single Journal
	 */
	public void delSingleJournal(AcctTransVO vo) {
		try {
			// remove in New Add List if exists
			for (int i = 0; i < journalItemsVO.getAddList().size(); i++) {
				AcctTransVO tmpVO = (AcctTransVO) journalItemsVO.getAddList().get(i);
				
				if(isSameItemVO(tmpVO, vo)) {
					journalItemsVO.getAddList().remove(i);
					break;
				}
			}
			
			// remove in Update List if exists
			for (int i = 0; i < journalItemsVO.getUpdList().size(); i++) {
				AcctTransVO tmpVO = (AcctTransVO) journalItemsVO.getUpdList().get(i);
				
				if(tmpVO.getId().equals(vo.getId())) {
					journalItemsVO.getUpdList().remove(i);
					break;
				}
			}

			if (vo.getId() != null) {
				journalItemsVO.getDelList().add(vo);
			}
			
			journalCartList.remove(vo);
			calcJourItemTotal(false);
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void delSingleJournal(AcctTransVO vo, JournalVO journalVO) {
		setJournalVO(journalVO);
		setJournalCartList(journalVO.getJournalCartList());
		journalItemsVO = journalVO.getJournalItemsVO();
		delSingleJournal(vo);
		journalVO.setAmountCalcViewVO(amtCalcViewVO);
		journalVO.setTotalCrdAmt(totalCrdAmt);
		journalVO.setTotalDbtAmt(totalDbtAmt);
	}
	
	public void resetCart() {
		try {
			journalCartList = new ArrayList<AcctTransVO>();
			
			calcJourItemTotal(true);
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
