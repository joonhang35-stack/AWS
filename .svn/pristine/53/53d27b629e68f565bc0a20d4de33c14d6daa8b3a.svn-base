	}
	
	public List<String> acctAutoComplete(String query) {  
        List<String> results = new ArrayList<String>();
    	/*List<AcctVO> acctAutoCompleteList;
    	acctListMap = new HashMap<String, AcctVO>();
    	
    	if( strAcctInputValue == "")
			return results;
		
        try { 
        	acctAutoCompleteList = journalBO.getAcctAutoCompleteList(getSessionInfoBean().getCompanyVO().getId(), strAcctInputValue);
        	
        	if(acctAutoCompleteList != null) {
	        	for (int i = 0; i < acctAutoCompleteList.size(); i++) {
	        		String value = acctAutoCompleteList.get(i).getCode() + (acctAutoCompleteList.get(i).getSubCode().isEmpty() ?
        					 		"" : "-" + acctAutoCompleteList.get(i).getSubCode());
	        		results.add(value);
	        		acctListMap.put(value, acctAutoCompleteList.get(i));
	        	}
        	}
        } catch(Exception e) {
        	e.printStackTrace() ;
        }*/
        
        try {
        	String tempStr;
        	for (int i = 0 ; i < acctViewList.size() ; i++) {
        		tempStr = acctViewList.get(i).getCode() + ((StringUtils.isEmpty(acctViewList.get(i).getSubCode())) ? "" : "-" + acctViewList.get(i).getSubCode());
        		if (tempStr.startsWith(query)) {
        			results.add(tempStr);
        		}
        	}
        } catch (Throwable t) {
        	errorResult(t);
        }
        return results;  
    }
	
	public void onAutoCompleteAcctSelect(SelectEvent event) {
		//updateJournalItemAccount(event.getObject().toString());
		try {
			String acctNo = event.getObject().toString();
			
			for (AcctViewVO vo : acctViewList) {
				if (acctNo.equals(vo.getCode())) {
					journalItem.setDesc(vo.getDesc());
					//journalItem.setAcctViewVO(vo);
					journalItem.setAcctId(vo.getId());
					journalItem.setTaxCode(vo.getTaxCode());
					journalItem.setTaxRate(vo.getTaxRate());
					journalItem.setAcctDesc(vo.getCode() + " : " + vo.getDesc());
					break;
					
				} else if (acctNo.equalsIgnoreCase(vo.getCode() + "-" + vo.getSubCode())) {
					journalItem.setDesc(vo.getDesc() + "," + vo.getSubDesc());
					//journalItem.setAcctViewVO(vo);
					journalItem.setAcctId(vo.getId());
					journalItem.setTaxCode(vo.getTaxCode());
					journalItem.setTaxRate(vo.getTaxRate());
					journalItem.setAcctDesc(vo.getCode() + "-" + vo.getSubCode()+ " : " + vo.getDesc() + ", " + vo.getSubDesc());
					break;
				}
			}
			
			if (journalItem.getAcctId() != null) {
				// populate GST code and rate
				handleTaxCodeSelection(journalItem.getTaxCode(), journalItem.getTaxRate() == null ? null : (double) journalItem.getTaxRate());
				
			} else resetJournalItemAccount();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	private void updateJournalItemAccount(String acctNo) {
		//Generate the list of AcctVO to ensure contains data
		if(acctListMap.size() == 0) {
			acctAutoComplete(acctNo);
		} 
		
		AcctVO acctVO = (AcctVO) acctListMap.get(acctNo);
		
		if(acctVO != null) {
			journalItem.setCode(acctNo);
			journalItem.setDesc(acctVO.getDesc() + (acctVO.getSubDesc().equals("") ? "" : "-" + acctVO.getSubDesc()));
			journalItem.setAcctId(acctVO.getId());
			journalItem.setTaxCode(acctVO.getTaxCode());
			
			try {
				handleTaxCodeSelection(journalItem.getTaxCode(), null);
			} catch (Throwable t) {
				errorResult(t);
			}
		} else {
			//Might be from accountList
			resetJournalItemAccount();
		}
	}
	
	private void resetJournalItemAccount() {
		journalItem = new AcctTransVO();
		journalItem.setDebit(0.00);
		journalItem.setCredit(0.00);
		journalItem.setTaxCode(null);
		journalItem.setTaxRate(null);
		journalItem.setAmount(0.00);
	}
	
