	public void onPostJournal(ExOrderBillVO exOrderBillVO, ArrayList<AcctTransVO> acctTransList) {
		
		TrackingLogUtils trackingLogUtils = new TrackingLogUtils(getClass());
		trackingLogUtils.startLogs();
		
		try {
			
			journalBO.validateJournalTotalAgainstBill(exOrderBillVO, false);
			
			init();
			handleJournalDetailAddNew();
			
			journalVO.setIdDpt(MaintConstant.DEPT_TYPE_ACCT);
			journalVO.setIdTourDep(exOrderBillVO.getTourId());
			journalVO.setTourCd(exOrderBillVO.getTourCode());
			journalVO.setJournalDt(new Date());
			journalVO.setTypeCd(CommonConstant.JOURNAL_TYPE_BILL);	
			
			for (AcctTransVO vo : acctTransList) {
//				System.out.println(vo.getDesc());
//				System.out.println(vo.getAmount());
				handleJourItemAddNew();
				journalItem.setAmount(vo.getAmount());
				journalItem.setDesc(vo.getDesc());
				
				journalItem.setCode(vo.getCode());
				journalItem.setAcctId(vo.getAcctId());
//				journalItem.setTaxCode(vo.getTaxCode());
//				journalItem.setAcctDesc(acctViewVO.getCode() + (acctViewVO.getSubCode().isEmpty() ? "" : "-" + acctViewVO.getSubCode()) + " : " +
//						acctViewVO.getDesc() + (acctViewVO.getSubDesc().equals("") ? "" : ", " + acctViewVO.getSubDesc()));
				
				calcJourItemAmount(acctTransList, exOrderBillVO, journalItem);
				
				updateJournaItemList();
				
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("onPostJournal");
		}
	}
	
	public void onProcessReversePastInvoice() {
		Calendar cal = Calendar.getInstance();

        cal.set(2025, Calendar.JANUARY, 1);  // Month is 0-based
        dtFrom = cal.getTime();

        cal.set(2025, Calendar.JANUARY, 31);
        dtTo = cal.getTime();
	}
	
	/**
	 * one time used
	 * to reverse pax statement sales before implemented reverse sales journal
	 */
	public void processReversePastInvoice() {
		trackingLogUtils.startLogs();
		try {
			
			Map<String, Object> params = new HashMap<String, Object>();
			params.put("invDtFrom", dtFrom);
			params.put("invDtTo", dtTo);
			params.put("docTypeCdList", FunctionUtils.generateArrayFromStr(SalesConstant.DOC_TYPE_CD_PAX_STMT));
			params.put("docTypeStatusList", FunctionUtils.generateArrayFromStr(ProductConstant.PAX_STMT_STATUS_CONVERTED));
			
			List<InvoiceVO> convertedPaxStatementList = invoiceBO.getInvoiceList(params, getSessionInfoBean().getCompanyVO().getId());
//			List<InvoiceVO> invList = new ArrayList<InvoiceVO>();
			
			int cnt = 0;
			for (InvoiceVO psVO : convertedPaxStatementList) {

				invoiceBO.processReversePsSales(psVO);
				
//				if (cnt++ > 2)	break;
			}
			
//			for (InvoiceVO vo : invoiceBO.getInvoiceList(getSessionInfoBean().getCompanyVO().getId(), SalesConstant.DOC_TYPE_CD_PAX_STMT)) {
//				if (!StringUtils.equals(vo.getPsNo(), vo.getCode()) && StringUtils.equals(vo.getDocTypeStatus(), ProductConstant.PAX_STMT_STATUS_CONVERTED)) {
//					invList.add(vo);
//				}
//			}
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("processReversePastInvoice");
		}
	}
	
	public void calcJourItemAmount(List<AcctTransVO> billAcctTransList, ExOrderBillVO exOrderBillVO, AcctTransVO journalItem) {
		if (billAcctTransList.size() == 1) {
			if (CollectionUtils.isNotEmpty(exOrderBillVO.getJournalList())) {
				for (JournalVO journalVO : exOrderBillVO.getJournalList()) {
					journalItem.setAmount(journalItem.getAmount() - journalVO.getTotalAmt());
				}
			}
		}
	}

	/**********************
	 * Lazy loading model *
	 **********************/
	class LazyJournalListDataModel extends LazyDataModel<JournalVO> implements Serializable {
		private static final long serialVersionUID = 1L;
		
		private String[] typeCdList;
		
		public LazyJournalListDataModel(String ...typeCdList) {
			this.typeCdList = typeCdList;
		}

		/*
		 * (non-Javadoc)
		 * @see org.primefaces.model.LazyDataModel#load(int, int, java.lang.String, org.primefaces.model.SortOrder, java.util.Map)
		 */
		@SuppressWarnings("unchecked")
		@Override
		public List<JournalVO> load(int first, int pageSize, String sortField, SortOrder sortOrder, Map<String, String> filters) {
			TrackingLogUtils trackingLogUtils = new TrackingLogUtils(getClass());
			trackingLogUtils.startLogs();
			try {

				Map<String, Object> params = new HashMap<String, Object>();
				params.put("first", first);
				params.put("pageSize", pageSize);
				params.put("sortField", sortField);
				params.put("sortOrder", sortOrder);
				params.put("filters", new HashMap<String, String>(filters));
				params.put("idCompany", getSessionInfoBean().getCompanyVO().getId());
				params.put("typeCdList", typeCdList);
				
				setRowCount(journalBO.getJournalListSize(params));
				
				if (getRowCount() > 0) 
					return (List<JournalVO>) journalBO.getJournalList(params);
				
			} catch (Throwable t) {
				t.printStackTrace();
				errorResult(t);
			}
			
			trackingLogUtils.endLogs("LazyJournalListDataModel");
			return new ArrayList<JournalVO>();
		}
		
		@Override
		public void setRowIndex(int rowIndex) {
			/*
			 * The following is in ancestor (LazyDataModel):
			 * this.rowIndex = rowIndex == -1 ? rowIndex : (rowIndex % pageSize);
			 */
			if (rowIndex == -1 || getPageSize() == 0) {
				super.setRowIndex(-1);
			} else super.setRowIndex(rowIndex % getPageSize());
		}
	}
	
