	private void loadSupplierName(List<ExOrderBillVO> billList) {
		if (CollectionUtils.isNotEmpty(billList) && CollectionUtils.isNotEmpty(supplierList)) {
			for (ExOrderBillVO billVO : billList) {
				for (SupplierVO supplierVO : supplierList) {
					if (billVO.getSupplierId().equals(supplierVO.getId())) {
						
						billVO.setSupplierName(supplierVO.getFullName());
					}
				}
				
			}
		}
	}
	
	public void handleSubAcctSelect(SelectEvent event) {
		try {
			
			AcctVO acctViewVO = (AcctVO) event.getObject();
			journalItem.setCode(acctViewVO.getCode() + (acctViewVO.getSubCode().isEmpty() ? "" : "-" + acctViewVO.getSubCode()));
			journalItem.setDesc(acctViewVO.getDesc() + (acctViewVO.getSubDesc().equals("") ? "" : "-" + acctViewVO.getSubDesc()));
			journalItem.setAcctId(acctViewVO.getId());
			journalItem.setTaxCode(acctViewVO.getTaxCode());
			journalItem.setAcctDesc(acctViewVO.getCode() + (acctViewVO.getSubCode().isEmpty() ? "" : "-" + acctViewVO.getSubCode()) + " : " +
					acctViewVO.getDesc() + (acctViewVO.getSubDesc().equals("") ? "" : ", " + acctViewVO.getSubDesc()));
			
			handleTaxCodeSelection(journalItem.getTaxCode(), acctViewVO.getTaxRate() == null ? null : (double) acctViewVO.getTaxRate());
			
			acctListMap.clear();
			acctListMap.put(journalItem.getCode(), acctViewVO);
		} catch (Throwable t) {
			errorResult(t);
		}
	}

	public void handleJournalDetailAddNew() {
		
		trackingLogUtils.startLogs();
		
		setIsAddNewDetail(true);
		resetCart();
		journalVO = new JournalVO();
		journalVO.setJournalDt(new Date());
		journalVO.setCompanyId(getSessionInfoBean().getCompanyVO().getId());
		journalVO.setTypeCd(CommonConstant.JOURNAL_TYPE_GNRL);
		isDateInFinPeriodClosed = false;
		
		trackingLogUtils.endLogs("handleJournalDetailAddNew");
		
		try {
			isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), journalVO.getJournalDt());
		 
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void cloneJournalDetail(JournalVO vo) {
		try {
			handleJournalDetailAddNew();
			
			JournalVO journalCloneVO = (JournalVO) vo.clone();
			List<AcctTransVO> journalCartCloneList = new ArrayList<AcctTransVO>();
			
			journalCloneVO.setId(null);
			
			List<AcctTransVO> journalItemList = journalBO.getJournalItems(vo);
			
			Double debit = 0D;
			Double credit = 0D;
			for (AcctTransVO acctTransVO : journalItemList) {
				acctTransVO.setId(null);
				debit = acctTransVO.getDebit();
				credit = acctTransVO.getCredit();
				acctTransVO.setDebit(credit);
				acctTransVO.setCredit(debit);
				journalCartCloneList.add((AcctTransVO) acctTransVO.clone());
			}
			
			journalVO = journalCloneVO;
			journalCartList = journalCartCloneList;
			
			calcJourItemTotal(true);
		 
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleJournalDetailSelect(JournalVO vo) {
		setIsAddNewDetail(false);
		try {
			journalVO = (JournalVO) vo.clone();
			setOriObj(vo.clone());
			// Check Financial Period Closed
			getFinPeriodClosedStatus();
			isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), journalVO.getJournalDt());
			
//			loadJournalItems(vo);
			journalVO = journalBO.getJournalDetails(journalVO);
			journalCartList = journalVO.getJournalCartList();
			if (vo.getExOrderBillVO() != null && StringUtils.isNotBlank(vo.getExOrderBillVO().getSupplierName())) {
				if (journalVO.getExOrderBillVO() == null)	journalVO.setExOrderBillVO(new ExOrderBillVO());
				journalVO.getExOrderBillVO().setSupplierName(vo.getExOrderBillVO().getSupplierName());
			}
			calcJourItemTotal(true);
//			journalVO.setBillList(billPymtBO.getBillListByJournalId(journalVO.getId()));
			loadSupplierName(journalVO.getBillList());
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	/**
	 * Author - You Yuan
	 * 
	 * @param idJournal
	 */
	public void onJournalSelected(Long idJournal) {
		
		setIsAddNewDetail(false);
		try {
			if (idJournal == null) {
				resetForm();
				return; // might be null cuz can call from bill_list.xhtml
			}
			
			journalVO = journalBO.getJournalById(idJournal, getSessionInfoBean().getCompanyVO().getId());
			// Check Financial Period Closed
			getFinPeriodClosedStatus();
			isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), journalVO.getJournalDt());
			
			// cannot load data at bean level, cuz will fetch cache data
//			loadJournalItems(journalVO);
			journalBO.getJournalDetails(journalVO);
			journalCartList = journalVO.getJournalCartList();
			calcJourItemTotal(true);
//			journalVO.setBillList(billPymtBO.getBillListByJournalId(journalVO.getId()));
			loadSupplierName(journalVO.getBillList());
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
		
	}

	public void handleJournalItemSubmit() {
		try {
			journalItem.setAmount(Double.valueOf(new DecimalFormat("#0.00").format(journalItem.getAmount())));
			
			if(journalItem.getAcctId() == null)
				throw new BusinessException(CommonErrConstant.ERR_ACCT_NOT_VALID); 
			
			if(journalItem.getAmount() < 0 || journalItem.getDAmountIncludeTax() < 0)
				throw new BusinessException(CommonErrConstant.ERR_AMOUNT_GREATER_ZERO);
			
			if(journalItem.getAmount() == 0)
				throw new BusinessException(CommonErrConstant.ERR_AMOUNT_NON_ZERO); 
			
			if(journalItem.getAmount() == 0)
				throw new BusinessException(CommonErrConstant.ERR_AMOUNT_NON_ZERO); 
			
			updateJournaItemList();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	/**
	 * handle add new journal item (from bill payment page)
	 */
	public void handleJournalItemSubmitFromBill() {
		handleJournalItemSubmit();
		journalVO.setAmountCalcViewVO(amtCalcViewVO);
		journalVO.setTotalCrdAmt(totalCrdAmt);
		journalVO.setTotalDbtAmt(totalDbtAmt);
	}
	
	/**
	 * on add new journal item (from bill payment page)
	 * @param journalVO
	 */
	public void handleJourItemAddNew(JournalVO journalVO) {
		setJournalVO(journalVO);
		setJournalCartList(journalVO.getJournalCartList());
		journalItemsVO = journalVO.getJournalItemsVO();
		handleJourItemAddNew();
	}

	/**
	 * On Journal Item selected
	 * @param event
	 */
	public void handleJourItemAddNew() {
		handleJourItemSelect(null);
	}
	
	public void handleJourItemSelect(AcctTransVO vo) {

		RequestContext.getCurrentInstance().reset("idFormJournalItem");
		if(vo == null)  {
			setIsAddNewItem(true);
			amtType = "Debit";
			resetJournalItemAccount();
		} else {
			try {
				setIsAddNewItem(false);
				
				prevJournalItem = (AcctTransVO) vo.clone();
				journalItem = (AcctTransVO) vo.clone();
				
				if(vo.getCredit().doubleValue() == 0) {
					journalItem.setAmount(vo.getDebit());
					amtType = "Debit";
				} else {
					journalItem.setAmount(vo.getCredit());
					amtType = "Credit";
				}
				
				if (journalItem.getAcctId() != null) {
					for (AcctViewVO acctVO : acctViewList) {
						if (acctVO.getId().equals(journalItem.getAcctId())) {
							journalItem.setAcctDesc(acctVO.getCode() + (acctVO.getSubCode().isEmpty() ? "" : "-" + acctVO.getSubCode()) + " : " +
									acctVO.getDesc() + (acctVO.getSubDesc().equals("") ? "" : ", " + acctVO.getSubDesc()));
							break;
						}
					}
				}
				
			} catch (Throwable t) {
				errorResult(t);
			}
		}

		acctListMap.clear();
	}
	
	/**
	 * on journal item selected (from bill payment page)
	 * @param vo
	 * @param journalVO
	 */
	public void handleJourItemSelect(AcctTransVO vo, JournalVO journalVO) {
		setJournalVO(journalVO);
		setJournalCartList(journalVO.getJournalCartList());
		journalItemsVO = journalVO.getJournalItemsVO();
		handleJourItemSelect(vo);
	}

	public void handleGSTSelect(SelectEvent event) {
		try {
			TaxCodeVO taxCodeVO = (TaxCodeVO) event.getObject();
			handleTaxCodeSelection(taxCodeVO.getCode(), (double) taxCodeVO.getRate());
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}

	public void handleAmountChange() {
		try {
			journalItem = (AcctTransVO) AccountHelper.calcTaxableAmount(journalItem, false, 0, 0);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleAmountIncludeTaxChange() {
		try {
			journalItem = (AcctTransVO) AccountHelper.calcAmountBaseOnTotalTaxableAmount(journalItem);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}

	private void handleTaxCodeSelection(String taxCode, Double taxRate) throws BusinessException {
		
		if(getSessionInfoBean().getCompanyVO().getIdAcctGST() != null && taxCode != null && isGSTPeriod) {
		
			if(taxCode != null && taxRate == null) {
				//journalItem = (AcctTransVO) GSTHelper.getInstance().updateAcctTrans(journalItem, taxCode);
				TaxCodeVO taxCodeVO = gstBO.getTaxCode(taxCode);
				journalItem.setTaxCode(taxCodeVO.getCode());
				journalItem.setTaxRate(taxCodeVO.getRate());
				
			} else {
				journalItem.setTaxCode(taxCode);
				journalItem.setTaxRate(taxRate.floatValue());
			}
			
			//This handling to ensure the amount input by user is the actual amount without tax
			if(journalItem.getTaxRate() > 0.00)
				handleAmountIncludeTaxChange();
			else
				handleAmountChange();
		
		} else {
			journalItem.setTaxCode(null);
			journalItem.setTaxRate(null);
			
			handleAmountChange();
		}
		
	}
	
	public void handleDateChange(DateSelectEvent event) {
		
		try {
			isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), journalVO.getJournalDt());
			
			if(!isGSTPeriod) {
				//Reset all account trans with null taxCode
				for (int i = 0 ; i < journalCartList.size() ; i++) {
					journalCartList.get(i).setTaxCode(null);
					journalCartList.get(i).setTaxRate(null);
				}
			}
			
			updateTaxableAmount(true);
			
		}  catch (Throwable t) {
			errorResult(t);
		}
	}
	
	private boolean validateAccount(String acctNo) throws BusinessException {
		if( acctNo == null || acctNo == "" ) 
			return true;

		String code = null, subCode = "";
		if(acctNo.contains("-")) {
			code = acctNo.split("-")[0];
			subCode = acctNo.split("-")[1];
		} else 
			code = acctNo;
		
		//Ensure Account is VALID in database
		AcctVO tmpAcctVO = new AcctVO();
		tmpAcctVO.setIdCompany(getSessionInfoBean().getCompanyVO().getId());
		tmpAcctVO.setCode(code);
		tmpAcctVO.setSubCode(subCode);
		
		return journalBO.isAccountValid(tmpAcctVO);
	}
	
	public void isAcctValid(FacesContext ctx, UIComponent component, Object value) 
			throws BusinessException {
		String acctNo = value.toString();
		
		if(!validateAccount(acctNo)) {
			RequestContext.getCurrentInstance().reset("idFormJournalItem");
			journalItem.setCode(acctNo);
			throw new ValidatorException(new FacesMessage(FacesMessage.SEVERITY_ERROR, 
					messageSource.getMessage(CommonErrConstant.ERR_ACCT_NOT_VALID, null, getLocale()), ""));
			
		}
	}
	
