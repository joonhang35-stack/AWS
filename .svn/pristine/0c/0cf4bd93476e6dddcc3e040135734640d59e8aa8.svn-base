<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

 
<script type="text/javascript">
	function onAcctTransValidation(xhr, status, args) {
		if (!args.validationFailed) {
			varAccountTransactionDialog.hide();
		}
	}
</script>
<p:growl id="msg"/>
<p:panelGrid>
		<p:row>
			<p:column><h:outputLabel for="idAcct">Account <span class="required">*</span></h:outputLabel></p:column>
			<p:column>
				<p:autoComplete id="idAcct" label="Account" value="#{depositBean.acctTransViewVO.code}" completeMethod="#{depositBean.complete}" required="true">  
					<p:ajax event="itemSelect" listener="#{depositBean.changeDesc}" update="@form"/> 
	     		</p:autoComplete>
				&nbsp;<p:commandButton icon="ui-icon-search" oncomplete="varAcctListDialog.show()" update=":idAcctListDialog" process="@this"/>
			</p:column> 
		</p:row>
		<p:row>
	        <p:column><h:outputLabel for="idAddDescription">Description</h:outputLabel></p:column>
			<p:column><h:outputText id="idAddDescription" label="Description" value="#{depositBean.acctTransViewVO.desc}" required="true"/></p:column>
		</p:row>
		
		<p:row rendered="#{depositBean.GSTPeriod}">
			<p:column>
				<h:outputLabel for="idGSTCode">GST Code</h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idGSTCode" label="GST Code" value="#{depositBean.acctTransViewVO.taxCode}" maxlength="0" readonly="true" 
					style="background:#ccc;" styleClass="txt_right"/>&nbsp;
				<p:commandButton icon="ui-icon-search" oncomplete="varGSTListDialog.show()" update=":idGSTListDialog" 
					process="@this" disabled="#{ empty depositBean.acctTransViewVO.code or empty depositBean.amtCalcViewVO.idTaxAcct}"/>
				<p:commandButton icon="ui-icon-close" actionListener="#{depositBean.handleTaxCodeClear}" update=":idAddAcctTrans" 
					process="@this" disabled="#{empty depositBean.acctTransViewVO.code or empty depositBean.amtCalcViewVO.idTaxAcct}"/>
			</p:column>
		</p:row>
		<p:row rendered="#{depositBean.GSTPeriod}">
			<p:column>
				<h:outputLabel for="idGSTRate">GST Rate (%)</h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idGSTRate" label="GST Rate (%)" value="#{depositBean.acctTransViewVO.taxRate}"
						maxlength="0" readonly="true" style="background:#ccc;" styleClass="txt_right"/>
			</p:column>
		</p:row>
		
		<p:row>
			<p:column><h:outputLabel for="idAddAmount">Amount <span class="required">*</span></h:outputLabel></p:column>
			<p:column>
				<!-- <p:inputText id="idAddAmount" label="Amountttt" value="#{depositBean.acctTransViewVO.amount}" required="true"><f:convertNumber pattern="#,##0.00"/></p:inputText> -->
				<p:inputText id="idAddAmount" label="Amount" value="#{depositBean.acctTransViewVO.amount}" required="true" styleClass="txt_right">
					<f:convertNumber pattern="#,##0.00"/>
					<p:ajax event="change" listener="#{depositBean.handleAmountChange}" update="idGSTAmt,idAmt"/>
				</p:inputText>
			</p:column>
		</p:row>
		
		<p:row rendered="#{depositBean.GSTPeriod}">
			<p:column>
				<h:outputLabel for="idGSTAmt">GST Amount</h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idGSTAmt" label="GST Amount" value="#{depositBean.acctTransViewVO.taxAmount}" styleClass="txt_right">
					<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
					<p:ajax event="change" listener="#{depositBean.handleGSTAmtChange}" update="idAmt"/>
				</p:inputText>
			</p:column>
		</p:row>
		<p:row rendered="#{depositBean.GSTPeriod}">
			<p:column>
				<h:outputLabel for="idAmt">Amount Inc. GST</h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idAmt" label="Amount Inc. GST" value="#{depositBean.acctTransViewVO.amountIncludeTax}" styleClass="txt_right">
					<f:convertNumber pattern="#{config['amount.format.pattern']}" />
					<p:ajax event="change" listener="#{depositBean.handleAmountInclTaxChange}" update="idGSTAmt,idAddAmount"/>
				</p:inputText>
			</p:column>
		</p:row>
	</p:panelGrid>
	<p:panelGrid columns="3" style="width:1px;">
		<p:commandButton value="#{msg['common.button.label.ok']}" actionListener="#{depositBean.addAcctTrans}" update="@form,:idAddDeposit:idShowAcctTrans,:idAddDeposit:idTaxableSection" disabled="#{depositBean.acctTransViewVO.amount eq 0}" rendered="#{depositBean.addAcctTrans}"/>
		<p:commandButton value="#{msg['common.button.label.ok']}" actionListener="#{depositBean.editAcctTrans}" update="@form,:idAddDeposit:idShowAcctTrans,:idAddDeposit:idTaxableSection" oncomplete="onAcctTransValidation(xhr,status,args)" rendered="#{not depositBean.addAcctTrans}"/>
		<p:commandButton id="idBtnAddCancel" value="#{msg['common.button.label.cancel']}" actionListener="#{depositBean.resetAcctTransViewForm}" update="@form" process="@this" oncomplete="varAccountTransactionDialog.hide()">
			<pe:resetEditableValues for="idAddAcctTrans"/>
		</p:commandButton>
	</p:panelGrid>
</ui:composition>