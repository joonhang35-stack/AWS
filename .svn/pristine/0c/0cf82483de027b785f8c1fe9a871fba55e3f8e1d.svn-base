	/**
	 * GenralLedger init
	 */
	public void init() {
		try {
			trackingLogUtils = new TrackingLogUtils(this.getClass());
			
			initSearchParam();
			generalLedgerList = new ArrayList<AcctTransViewVO>();
			generalLedgerTransList = new ArrayList<AcctTransViewVO>();
			acctCatList = new ArrayList<AcctCatVO>();
			loadAccCatList();
			// Initialize year list
			String year = YEAR_FORMAT.format(new Date());
			yearList = getCurrentYearList(year);
			String periodYear = chartOfAcctBO.getFinPeriodYear(getSessionInfoBean().getCompanyVO().getId());
			if (StringUtils.isNotEmpty(periodYear)) {
				searchParamVO.setObj2(periodYear);
			} else {
				searchParamVO.setObj2(year);
			}
			finPeriodSearchVO = new SearchParamVO();
			
			List<FinancialPeriodVO> finPeriodList = finPeriodBO.getFinPeriodList(getSessionInfoBean().getCompanyVO().getId(), (String) searchParamVO.getObj2());
			if (CollectionUtils.isNotEmpty(finPeriodList)) {
				dtFrom = finPeriodList.get(0).getDtStart();
				dtTo = finPeriodList.get(finPeriodList.size()-1).getDtEnd();
			} else {
				dtFrom = null;
				dtTo = null;
			}
			
			acctViewList = chartOfAcctBO.getAcctViewList(getSessionInfoBean().getCompanyVO().getId(), null);
			lazyLedgerDataModel = new LazyLedgerDataModel();

		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Search GL
	 * @param flag - 0 = all months / 1 = selected months
	 */
	public void searchGL(Long flag) {
		try {
			trackingLogUtils.startLogs();
			
			if(acctViewVO == null)
				throw new BusinessException(CommonErrConstant.ERR_ACCT_NOT_VALID); 

			//////////////// Financial Period Checking ////////////////
			finPeriodList = finPeriodBO.getFinPeriodList(getSessionInfoBean().getCompanyVO().getId(), (String) searchParamVO.getObj2());
			
			if (CollectionUtils.isEmpty(finPeriodList)) throw new BusinessException(CommonErrConstant.ERR_ACCT_CHART_NOT_FIN_PERIOD);
			
			// Whole Financial Date
			searchParamVO.setFromDate(DatesUtils.getDayTimeStart(finPeriodList.get(0).getDtStart()).getTime());
			searchParamVO.setToDate(DatesUtils.getDayTimeEnd(finPeriodList.get(finPeriodList.size()-1).getDtEnd()).getTime());
			finPeriodSearchVO.setFromDate(DatesUtils.getDayTimeStart(finPeriodList.get(0).getDtStart()).getTime());
			finPeriodSearchVO.setToDate(DatesUtils.getDayTimeEnd(finPeriodList.get(finPeriodList.size()-1).getDtEnd()).getTime());
			
			/*if (!chartOfAcctBO.isAcctBeginBalExisted(getSessionInfoBean().getCompanyVO().getId(), finPeriodSearchVO)) {
				throw new BusinessException(CommonErrConstant.ERR_ACCT_CHART_NOT_BEGIN_BAL);
			}*/
			////////////////Financial Period Checking ////////////////
			
			generalLedgerList = new ArrayList<AcctTransViewVO>();
			
			// Search All
			if (flag==0) {
				searchParamVO.setObj3(null);
				searchParamVO.setObj4(null);
			} else {
				searchParamVO.setObj3(DatesUtils.getDayTimeStart(dtFrom).getTime());
				searchParamVO.setObj4(DatesUtils.getDayTimeEnd(dtTo).getTime());
			}
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("searchGL");
		}
	}
	
	private void loadAccCatList() throws BusinessException {
		acctCatList = chartOfAcctBO.getAcctCatList(getSessionInfoBean().getCompanyVO().getId(), searchParamVO);
	}
	/**
	 * 
	 * @param event
	 */
	public void handleAcctSelect(SelectEvent event) {
		try {
			AcctVO acctVO = (AcctVO) event.getObject();
			String codeView = "";
			String code = acctVO.getCode();
			if (StringUtils.isNotEmpty(acctVO.getSubCode())) code += "-" + acctVO.getSubCode();
			
			for (AcctViewVO vo : acctViewList) {
				codeView = vo.getCode();
				if (StringUtils.isNotEmpty(vo.getSubCode())) codeView += "-" + vo.getSubCode();
				
				if (code.equals(codeView)) {
					acctViewVO = vo;
					break;
				}
			}
			
			if (StringUtils.isEmpty(acctViewVO.getSubCode())) searchParamVO.setObj1(acctViewVO.getCode());
			else searchParamVO.setObj1(acctViewVO.getCode() + "-" + acctViewVO.getSubCode());
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Handle record selection
	 * @param event
	 */
	public void handleRecordSelect(SelectEvent event) {
		try {
			AcctTransViewVO acctTransViewVO = (AcctTransViewVO) event.getObject();
			generalLedgerTransList = generalLedgerBO.getGeneralLedgerTransactionList(getSessionInfoBean().getCompanyVO().getId(), acctTransViewVO);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Load Account List
	 */
	public void loadAcctList() {
		try {
			acctViewList = chartOfAcctBO.getAcctViewList(getSessionInfoBean().getCompanyVO().getId(), null);
			lazyAcctDataModel = new LazyAccountDataModel();
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * 
	 * @param query
	 * @return
	 */
	public List<String> complete(String query) { 
		List<String> results = new ArrayList<String>();
		if(query.length() == 0)
			return results;
		
		try {
			loadAcctList();
        	acctAutoCompleteList = paymentBO.getAcctList(getSessionInfoBean().getCompanyVO().getId(),query);
        	if (CollectionUtils.isNotEmpty(acctAutoCompleteList)) {
        		for (int i = 0; i <acctAutoCompleteList.size(); i++) {
    				if(acctAutoCompleteList.get(i).getSubCode().isEmpty()) results.add(acctAutoCompleteList.get(i).getCode());
    				else results.add(acctAutoCompleteList.get(i).getCode() + "-" + acctAutoCompleteList.get(i).getSubCode() );  
    			}
        	}
        } catch(Exception e) {
        	e.printStackTrace() ;
        }
        return results;  
    }
	
	/**
	 * 
	 */
	public void changeDesc() {
		try {
			String code = null;
			for(AcctViewVO vo : acctViewList) {
				code = vo.getCode();
				if (StringUtils.isNotEmpty(vo.getSubCode())) code += "-" + vo.getSubCode();
				
				if (searchParamVO.getObj1().toString().equals(code)) {
					acctViewVO = vo;
					break;
				}
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Report Type select event
