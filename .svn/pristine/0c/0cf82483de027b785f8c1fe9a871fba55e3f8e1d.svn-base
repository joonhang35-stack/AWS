	public void handleSelectYear() {
		try {
			List<FinancialPeriodVO> finPeriodList = finPeriodBO.getFinPeriodList(getSessionInfoBean().getCompanyVO().getId(), (String) searchParamVO.getObj2());
			if (CollectionUtils.isNotEmpty(finPeriodList)) {
				dtFrom = finPeriodList.get(0).getDtStart();
				dtTo = finPeriodList.get(finPeriodList.size()-1).getDtEnd();
			} else {
				dtFrom = null;
				dtTo = null;
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * 
	 * @author Kent
	 *
	 */
	class LazyAccountDataModel extends LazyDataModel<AcctVO> implements Serializable {
		private static final long serialVersionUID = 1L;

		/*
		 * (non-Javadoc)
		 * @see org.primefaces.model.LazyDataModel#load(int, int, java.lang.String, org.primefaces.model.SortOrder, java.util.Map)
		 */
		@Override
		public List<AcctVO> load(int first, int pageSize, String sortField, SortOrder sortOrder, Map<String, String> filters) {
			try {
				Map<String, Object> params = new HashMap<String, Object>();
				params.put("idCompany", getSessionInfoBean().getCompanyVO().getId());
				params.put("first", first);
				params.put("pageSize", pageSize);
				params.put("sortField", (sortField == null) ? "code" : sortField);
				params.put("sortOrder", sortOrder);
				params.put("filters", filters);
				
				int size = acctBO.getAccountListSize(params);
				setRowCount(size);
				if (size > 0) return acctBO.getAccountList(params);
				
			} catch (Throwable t) {
				errorResult(t);
			}
			return null;
		}
		
		@Override
		public void setRowIndex(int rowIndex) {
			/*
			 * The following is in ancestor (LazyDataModel):
			 * this.rowIndex = rowIndex == -1 ? rowIndex : (rowIndex % pageSize);
			 */
			if (rowIndex == -1 || getPageSize() == 0) {
				super.setRowIndex(-1);
			} else super.setRowIndex(rowIndex % getPageSize());
		}
	}
	
	/**
	 * 
	 * @author Kent
	 *
	 */
	class LazyLedgerDataModel extends LazyDataModel<AcctTransViewVO> implements Serializable {
		private static final long serialVersionUID = 1L;
		
		/*
		 * (non-Javadoc)
		 * @see org.primefaces.model.LazyDataModel#load(int, int, java.lang.String, org.primefaces.model.SortOrder, java.util.Map)
		 */
		@Override
		public List<AcctTransViewVO> load(int first, int pageSize, String sortField, SortOrder sortOrder, Map<String, String> filters) {
			try {
				trackingLogUtils.startLogs();
				
				if(acctViewVO == null) return null;
				////////////////Financial Period Checking ////////////////
				if (CollectionUtils.isEmpty(finPeriodList)) return null;
				//if (!chartOfAcctBO.isAcctBeginBalExisted(getSessionInfoBean().getCompanyVO().getId(), finPeriodSearchVO)) return null;
				
				acctViewVO.setAcctBalVO(new AcctBalVO());
				acctViewVO.getAcctBalVO().setDebitBeginBal(0.0);
				acctViewVO.getAcctBalVO().setCreditBeginBal(0.0);
				acctViewVO.getAcctBalVO().setDebitCloseBal(0.0);
				acctViewVO.getAcctBalVO().setCreditCloseBal(0.0);
				acctViewVO.getAcctBalVO().setDebitCurrentBal(0.0);
				acctViewVO.getAcctBalVO().setCreditCurrentBal(0.0);
				////////////////Financial Period Checking ////////////////
				
				Map<String, Object> params = new HashMap<String, Object>();
				params.put("idCompany", getSessionInfoBean().getCompanyVO().getId());
				params.put("first", first);
				params.put("pageSize", pageSize);
				params.put("sortField", sortField);
				params.put("sortOrder", sortOrder);
				params.put("filters", filters);
				
				params.put("searchParamVO", searchParamVO);
				params.put("acctViewVO", acctViewVO);
				
				if (acctViewVO != null) {
					int size = generalLedgerBO.getGeneralLedgerListSize(params);
					setRowCount(size);
					
					generalLedgerList = generalLedgerBO.getGeneralLedgerList(params);
				}
				
				return generalLedgerList;
				
			} catch (Throwable t) {
				errorResult(t);
			} finally {
				trackingLogUtils.endLogs("LazyLedgerDataModel");
			}
			return null;
		}
		
		@Override
		public void setRowIndex(int rowIndex) {
			/*
			 * The following is in ancestor (LazyDataModel):
			 * this.rowIndex = rowIndex == -1 ? rowIndex : (rowIndex % pageSize);
			 */
			if (rowIndex == -1 || getPageSize() == 0) {
				super.setRowIndex(-1);
			} else super.setRowIndex(rowIndex % getPageSize());
		}
	}
	
	public void printType(String printDocType) {
			setPrintDocType(printDocType);
	}
	
	public void printGLAll() {
		printGL(printDocType, "All");
	}
	
	/**
	 * Printing General Ledger - By Acct or All Account
	 */
	
	public void printGL(String xlsOrPDf, String type) {
		try {
			
			trackingLogUtils.startLogs();
		//	xlsOrPDf = getPrintDocType();
			long start = System.currentTimeMillis();
			getFinancialPeriod();
			
			HashMap<String, Object> map = reportTitle();
			map.put("fromDate", DatesUtils.getDayTimeStart(dtFrom).getTime());
			map.put("toDate", DatesUtils.getDayTimeEnd(dtTo).getTime());
			map.put("isShowSource", isShowSource);
			if (xlsOrPDf.equals("PDF")) map.put("showColumnType", "");
			else map.put("showColumnType", showColumnType);
			map.put("isShowQty", isShowQty);
//			map.put("IS_IGNORE_PAGINATION", true);
			
			searchParamVO.setObj6(isShowRevenueDtl);
			searchParamVO.setObj8(isShowQty);
			searchParamVO.setObj9(showColumnType);
			searchParamVO.setObj10(null);
			searchParamVO.setObj11(null);
		
			////////////////Financial Period Checking ////////////////
			finPeriodList = finPeriodBO.getFinPeriodList(getSessionInfoBean().getCompanyVO().getId(), (String) searchParamVO.getObj2());
			
			if (CollectionUtils.isEmpty(finPeriodList)) throw new BusinessException(CommonErrConstant.ERR_ACCT_CHART_NOT_FIN_PERIOD);
			
			// Whole Financial Date
			searchParamVO.setFromDate(DatesUtils.getDayTimeStart(finPeriodList.get(0).getDtStart()).getTime());
			searchParamVO.setToDate(DatesUtils.getDayTimeEnd(finPeriodList.get(finPeriodList.size()-1).getDtEnd()).getTime());
			finPeriodSearchVO.setFromDate(DatesUtils.getDayTimeStart(finPeriodList.get(0).getDtStart()).getTime());
			finPeriodSearchVO.setToDate(DatesUtils.getDayTimeEnd(finPeriodList.get(finPeriodList.size()-1).getDtEnd()).getTime());
			
			/*if (!chartOfAcctBO.isAcctBeginBalExisted(getSessionInfoBean().getCompanyVO().getId(), finPeriodSearchVO)) {
				throw new BusinessException(CommonErrConstant.ERR_ACCT_CHART_NOT_BEGIN_BAL);
			}*/
			////////////////Financial Period Checking ////////////////
			
			String jasperFileName = CommonConstant.JAS_RPT_GL;
			String reportName = CommonConstant.PDF_RPT_GL;
			
			if (type.equalsIgnoreCase("All")) {
				//searchParamVO.setObj3(null);
				//searchParamVO.setObj4(null);
				searchParamVO.setObj3(DatesUtils.getDayTimeStart(dtFrom).getTime());
				searchParamVO.setObj4(DatesUtils.getDayTimeEnd(dtTo).getTime());
				// Account Id
				searchParamVO.setObj5(null);
				
				boolean isAsset = false;
				if (searchParamVO.getObj7() == null) {
					reportName += "_All";
				} else {
					for (AcctCatVO vo : acctCatList) {
						if (vo.getId().toString().equals(searchParamVO.getObj7())) {
							reportName += "_" + vo.getDesc().replaceAll(" ", "");
							if ("A".equals(vo.getCode())) isAsset = true;
							break;
						}
					}
				}
				
				if (isAsset && StringUtils.isNotEmpty(showAssetType)) {
					searchParamVO.setObj10(showAssetType);
					
					String acctTradeDebtor = "";
					for (AcctViewVO vo : acctViewList) {
						if ("TRADE DEBTOR".equals(vo.getDesc())) {
							if (acctTradeDebtor.equals("")) acctTradeDebtor = acctTradeDebtor + vo.getId();
							else acctTradeDebtor = acctTradeDebtor + "," + vo.getId();
						}
					}
					searchParamVO.setObj11(acctTradeDebtor);
				} else {
					searchParamVO.setObj10(null);
					searchParamVO.setObj11(null);
				}
				
				if (isShowPagination()) map.put("IS_IGNORE_PAGINATION", true);
			} else {
				if(acctViewVO == null) {
					throw new BusinessException(CommonErrConstant.ERR_ACCT_NOT_VALID); 
				} else {
					searchParamVO.setObj5(acctViewVO.getId());
				}
				searchParamVO.setObj3(DatesUtils.getDayTimeStart(dtFrom).getTime());
				searchParamVO.setObj4(DatesUtils.getDayTimeEnd(dtTo).getTime());
				// Account Categories
				searchParamVO.setObj7(null);
			}
			
			List<AcctViewVO> glList = generalLedgerBO.getGLBalanceList(getSessionInfoBean().getCompanyVO().getId(), searchParamVO);
			
			if (CollectionUtils.isEmpty(glList)) throw new BusinessException("ERR_NO_RESULT");

			JasperPrint jasperPrint = ReportUtils.getJasperPrint(glList, map, jasperFileName);
			if (xlsOrPDf.equals("PDF")) {
				ReportUtils.printReport(jasperPrint, reportName);
			} else {
				ReportUtils.printReportExcel(jasperPrint, reportName);
			}
			
			FacesContext.getCurrentInstance().getExternalContext().addResponseCookie(
					"cookie.pdf.exporting", "true", Collections.<String, Object>emptyMap());
			
			System.out.println("Total timestamp = " + (System.currentTimeMillis() - start));
		
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("printGL: " + xlsOrPDf + " - " + type);
		}
	}
	
	public void print(String xlsOrPDf, boolean isSummary) {
		try {
			
			trackingLogUtils.startLogs();
		//	xlsOrPDf = getPrintDocType();
			long start = System.currentTimeMillis();
			getFinancialPeriod();
			
			HashMap<String, Object> map = reportTitle();
			map.put("fromDate", DatesUtils.getDayTimeStart(dtFrom).getTime());
			map.put("toDate", DatesUtils.getDayTimeEnd(dtTo).getTime());
			map.put("isShowSource", isShowSource);
//			if (xlsOrPDf.equals("PDF")) map.put("isShowDesc", false);
//			else map.put("isShowDesc", isShowDesc);
			
			////////////////Financial Period Checking ////////////////
			finPeriodList = finPeriodBO.getFinPeriodList(getSessionInfoBean().getCompanyVO().getId(), (String) searchParamVO.getObj2());
			
			if (CollectionUtils.isEmpty(finPeriodList)) throw new BusinessException(CommonErrConstant.ERR_ACCT_CHART_NOT_FIN_PERIOD);
			
			// Whole Financial Date
			searchParamVO.setFromDate(DatesUtils.getDayTimeStart(finPeriodList.get(0).getDtStart()).getTime());
			searchParamVO.setToDate(DatesUtils.getDayTimeEnd(finPeriodList.get(finPeriodList.size()-1).getDtEnd()).getTime());
			finPeriodSearchVO.setFromDate(DatesUtils.getDayTimeStart(finPeriodList.get(0).getDtStart()).getTime());
			finPeriodSearchVO.setToDate(DatesUtils.getDayTimeEnd(finPeriodList.get(finPeriodList.size()-1).getDtEnd()).getTime());
			
			/*if (!chartOfAcctBO.isAcctBeginBalExisted(getSessionInfoBean().getCompanyVO().getId(), finPeriodSearchVO)) {
				throw new BusinessException(CommonErrConstant.ERR_ACCT_CHART_NOT_BEGIN_BAL);
			}*/
			////////////////Financial Period Checking ////////////////
			String jasperFileName;
			String reportName;
			if(isSummary) {
				jasperFileName = CommonConstant.JAS_RPT_SMMY_GL;
				reportName = CommonConstant.PDF_RPT_GL_SMMY;
			}
			else {
				jasperFileName = CommonConstant.JAS_RPT_EXTD_GL;
				reportName = CommonConstant.PDF_RPT_GL_EXTD;
			}
			
				if(acctViewVO == null) {
					throw new BusinessException(CommonErrConstant.ERR_ACCT_NOT_VALID); 
				} else {
					searchParamVO.setObj5(acctViewVO.getId());
				}
				searchParamVO.setObj3(DatesUtils.getDayTimeStart(dtFrom).getTime());
				searchParamVO.setObj4(DatesUtils.getDayTimeEnd(dtTo).getTime());
				// Account Categories
				searchParamVO.setObj7(null);
			
			List<AcctViewVO> glList = generalLedgerBO.getGLBalanceSmmyExtdList(getSessionInfoBean().getCompanyVO().getId(), searchParamVO);
			
			if (CollectionUtils.isEmpty(glList)) throw new BusinessException("ERR_NO_RESULT");

			JasperPrint jasperPrint = ReportUtils.getJasperPrint(glList, map, jasperFileName);
			if (xlsOrPDf.equals("PDF")) {
				ReportUtils.printReport(jasperPrint, reportName);
			} else {
				ReportUtils.printReportExcel(jasperPrint, reportName);
			}
			
			FacesContext.getCurrentInstance().getExternalContext().addResponseCookie(
					"cookie.pdf.exporting", "true", Collections.<String, Object>emptyMap());
			
			System.out.println("Total timestamp = " + (System.currentTimeMillis() - start));
		
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("printGL: " + xlsOrPDf);
		}
	}
	
	/**********
	 * HELPER *
	 **********/
	/**
	 * Checking In Financial Period
	 */
	public void getFinancialPeriod() throws BusinessException {
		List<FinancialPeriodVO> finPeriodList = finPeriodBO.getFinPeriodList(getSessionInfoBean().getCompanyVO().getId(), (String) searchParamVO.getObj2());
		
		if (CollectionUtils.isEmpty(finPeriodList)) throw new BusinessException(CommonErrConstant.ERR_ACCT_CHART_NOT_FIN_PERIOD);
		
		Date startDate = finPeriodList.get(0).getDtStart();
		Date endDate = finPeriodList.get(finPeriodList.size()-1).getDtEnd();
		
		Date fromDateSlted = (Date) dtFrom;
		Date toDateSlted = (Date) dtTo;
		
		searchParamVO.setFromDate(startDate);
		searchParamVO.setToDate(endDate);
		
		/*if (!chartOfAcctBO.isAcctBeginBalExisted(getSessionInfoBean().getCompanyVO().getId(), searchParamVO)) {
			throw new BusinessException(CommonErrConstant.ERR_ACCT_CHART_NOT_BEGIN_BAL);
		}
		
		if(fromDateSlted.after(toDateSlted)) {
			throw new BusinessException(CommonErrConstant.ERR_ACCT_CHART_DT_GREATER);
		} else if(fromDateSlted.before(startDate)) {
			throw new BusinessException(CommonErrConstant.ERR_ACCT_CHART_DT_FR_NOT_IN_RANGE);
		} else if(fromDateSlted.after(endDate)) {
			throw new BusinessException(CommonErrConstant.ERR_ACCT_CHART_DT_FR_NOT_IN_RANGE);
		} else if(toDateSlted.before(startDate)) {
			throw new BusinessException(CommonErrConstant.ERR_ACCT_CHART_DT_TO_NOT_IN_RANGE);
		} else if(toDateSlted.after(endDate)) {
			throw new BusinessException(CommonErrConstant.ERR_ACCT_CHART_DT_TO_NOT_IN_RANGE);
		}*/
		
		//return startDate;
	}
	
	/**
	 * Printing Trial Balance
	 */
	public HashMap<String, Object> reportTitle() {
		HashMap<String, Object> map = new HashMap<String, Object>();
		try {
			CompanyVO companyVO = new CompanyVO();
			companyVO = corporateProfileBO.getCompanyDetails(getSessionInfoBean().getCompanyVO().getId());
			
			StringBuilder address = new StringBuilder();
			map.put("companyName", companyVO.getName());
			map.put("slogan", companyVO.getSlogan());
			
			if (!companyVO.getCompanyAddressVO().getAddress1().equals("")) address.append(companyVO.getCompanyAddressVO().getAddress1()).append(" ");
			if (!companyVO.getCompanyAddressVO().getAddress2().equals("")) address.append(companyVO.getCompanyAddressVO().getAddress2()).append(" ");
			if (!companyVO.getCompanyAddressVO().getAddress3().equals("")) address.append(companyVO.getCompanyAddressVO().getAddress3()).append(" ");
			if (!companyVO.getCompanyAddressVO().getCity().equals("")) address.append(companyVO.getCompanyAddressVO().getCity()).append(" ");
			if (!companyVO.getCompanyAddressVO().getState().equals("")) address.append(companyVO.getCompanyAddressVO().getState()).append(" ");
			if (!companyVO.getCompanyAddressVO().getPostcode().equals("")) address.append(companyVO.getCompanyAddressVO().getPostcode()).append(" ");
			String companyName = regionBO.getCountryById(companyVO.getCompanyAddressVO().getCountryid()).getCountry();
			if (!companyName.equals("")) address.append(companyName);
			map.put("address", address);
	
			String contact = "";
			for (CompanyContactVO vo : companyVO.getCompanyContactList()) {
				contact += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, vo.getTypecodecontact()) + ": " + vo.getNumber() + "  ";
			}
			if (!contact.equals("")) contact = "Tel: " + contact;
			map.put("contact", contact);
			
		} catch (Throwable t) {
			errorResult(t);
		}
		return map;
	}
	
	/**
	 * 
	 * @param year 
	 * @param date
	 * @return
	 */
	private List<String> getCurrentYearList(String year) {
		yearList = new ArrayList<String>();
		
		int y = Integer.parseInt(year);
		for (int i = YEAR_PERIOD ; i > 0 ; i--) {
			yearList.add(String.valueOf(y - i));
		}
		for (int i = 0 ; i <= 3 ; i++) {
			yearList.add(String.valueOf(y + i));
		}
		return yearList;
	}
	
