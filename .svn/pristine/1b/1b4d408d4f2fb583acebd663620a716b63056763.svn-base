	/**
	 * Handler tour code selected
	 * @param event
	 */
	public void handleTourCodeSelect(SelectEvent event){
		try {
			TourDepartureVO tourDepVO = (TourDepartureVO) event.getObject();
			
			if (isFromImportHotelAndTourFromTourDep) {
				HotelTourVO hotelTourVO = new HotelTourVO();
				// Check in date
				if (tourDepVO.getDtDep() != null) {
					hotelTourVO.setCheckInDt(tourDepVO.getDtDep());
					SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy");
			        String strCheckInDt = sdf.format(tourDepVO.getDtDep());
			        hotelTourVO.setStrChkInDt(strCheckInDt);
				}
				
				// Check out date
				Calendar calendar = Calendar.getInstance();
				if (tourDepVO.getDtDep() != null && tourDepVO.getNumDays() != null) { 
					calendar.setTime(tourDepVO.getDtDep());
					calendar.add(Calendar.DAY_OF_MONTH, tourDepVO.getNumDays() - 1);
					Date checkOutDate = calendar.getTime();
					hotelTourVO.setCheckOutDt(checkOutDate);
					SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy");
			        String strCheckOutDt = sdf.format(checkOutDate);
			        hotelTourVO.setStrChkOutDt(strCheckOutDt);
				}
				
				// Total Nights
				if (tourDepVO.getDtDep() != null) hotelTourVO.setTotalNight(tourDepVO.getNumNights());
				
				/**** Arrival Flight and Departure Flight ****/
				AirlineScheduleVO airlineScheduleVO = new AirlineScheduleVO();
				if (tourDepVO.getIdAirlineSchedule() != null) {
				    airlineScheduleVO = airlineBO.getAirlineSchedule(tourDepVO);
				}
				List<AirlineScheduleItemVO> airlineScheduleItemList = new ArrayList<AirlineScheduleItemVO>();
				if (tourDepVO.getIdAirlineSchedule() != null) {
				    airlineScheduleItemList = airlineScheduleVO.getAirlineScheduleItemList();
				}

				String arrivalFlight = "";
				String departureFlight = "";

				// Variables to track minimum and maximum seqs and their corresponding flights
				Integer minSeq = null;
				Integer maxSeq = null;
				AirlineScheduleItemVO minDepartVO = null;
				AirlineScheduleItemVO maxReturnVO = null;

				// Single pass to find min and max seqs and capture flight details
				for (AirlineScheduleItemVO vo : airlineScheduleItemList) {
				    if (vo != null && (vo.getSeq() != null && vo.getTypeCd().equals("Depart"))) {
				        if (minSeq == null || vo.getSeq() < minSeq) {
				            minSeq = vo.getSeq();
				            minDepartVO = vo;
				        }
				    }
				    if (vo != null && (vo.getSeq() != null && vo.getTypeCd().equals("Return"))) {
				        if (maxSeq == null || vo.getSeq() > maxSeq) {
				            maxSeq = vo.getSeq();
				            maxReturnVO = vo;
				        }
				    }
				}

				// Append the details for the min Depart and max Return flights
				if (minDepartVO != null) {
				    arrivalFlight += minDepartVO.getFlightCd() + " " + minDepartVO.getFromAirportCd() + "/" + minDepartVO.getToAirportCd() + " " + minDepartVO.getEtd() + "/" + minDepartVO.getEta();
				}
				if (maxReturnVO != null) {
				    departureFlight += maxReturnVO.getFlightCd() + " " + maxReturnVO.getFromAirportCd() + "/" + maxReturnVO.getToAirportCd() + " " + maxReturnVO.getEtd() + "/" + maxReturnVO.getEta();
				}

				hotelTourVO.setArrFlight(arrivalFlight);
				hotelTourVO.setDepFlight(departureFlight);
				
				/**** Arrival Flight and Departure Flight ****/
				
				// Num of Pax
				hotelTourVO.setNoOfPax(Integer.toString(tourDepVO.getTotalAdult()) + "ADT + " + Integer.toString(tourDepVO.getTotalChild()) + "CHD + " + Integer.toString(tourDepVO.getTotalInf()) + "INF");
				
				// Meal Provide
				hotelTourVO.setMealProvide("AS PER ITINERARY");
				
				// Type of Rooms
				hotelTourVO.setTypeOfRoom("");
				
				// Hotel Resort Usage
				hotelTourVO.setHotelUsage("AS PER ITINERARY");
				
				exOrderVO.getHotelTourList().add(hotelTourVO);
				
			} else if (isFromImportAirlineFromTourDep) {
				AirlineScheduleVO airlineScheduleVO = new AirlineScheduleVO();
				if (tourDepVO.getIdAirlineSchedule() != null) {
				    airlineScheduleVO = airlineBO.getAirlineSchedule(tourDepVO);
				}
				List<AirlineScheduleItemVO> airlineScheduleItemList = new ArrayList<AirlineScheduleItemVO>();
				if (tourDepVO.getIdAirlineSchedule() != null) {
				    airlineScheduleItemList = airlineScheduleVO.getAirlineScheduleItemList();
				}

				// Process and add airline details
				SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy");
				if (CollectionUtils.isNotEmpty(airlineScheduleItemList)) {
					for (AirlineScheduleItemVO vo : airlineScheduleItemList) {
						if (vo.getSeq() != null) {
							AirLineDetailsVO airlineDetailsVO = new AirLineDetailsVO();
							airlineDetailsVO.setPoint(vo.getFromAirportCd() + "/" + vo.getToAirportCd());
							airlineDetailsVO.setFlightNo(vo.getFlightCd());
							if(vo.getDepartureDate() != null) airlineDetailsVO.setAirLineDt(vo.getDepartureDate());
							String strAirLineDt = (airlineDetailsVO.getAirLineDt() != null) ? sdf.format(airlineDetailsVO.getAirLineDt()) : "";
							airlineDetailsVO.setStrAirLineDt(strAirLineDt);
							airlineDetailsVO.setTime(vo.getEtd() + "/" + vo.getEta());
							airlineDetailsVO.setAirClass("");
							airlineDetailsVO.setStatus("");
							airlineDetailsVO.setAirLinePnr("");

							exOrderVO.getAirlineList().add(airlineDetailsVO);
						}			     
					}
				}

			}
			else {
				exOrderVO.setTourId(tourDepVO.getId());
				exOrderVO.setReference(tourDepVO.getPackageDesc());  
				tourCodeDesc = tourDepVO.getCode();
				exOrderVO.setTourId(tourDepVO.getId());
				exOrderVO.setTourDepDt(tourDepVO.getDtDep());
				
				if(StringUtils.equals(exOrderVO.getCategory(), CommonConstant.LOOKUP_ITM_INV_CAT_TOUR)) {
					TourDepartureVO vo = tourPkgBO.getTourDepById(exOrderVO.getTourId());
					exOrderVO.setIdDepartment(vo.getIdDepartment());
				}
			}
			resetImportEO();
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
		
	}
	
	public void handleCategoryCodeChange() {
		try {
			if(StringUtils.equals(exOrderVO.getCategory(), CommonConstant.LOOKUP_ITM_INV_CAT_TOUR)) {
				if (exOrderVO.getTourId() != null) {
					TourDepartureVO vo = tourPkgBO.getTourDepById(exOrderVO.getTourId());
					exOrderVO.setIdDepartment(vo.getIdDepartment());
				}
			}else {
				List<EmployeeViewVO> fullEmployeeList = invoiceBO.getFullEmployeeViewList(this.getSessionInfoBean().getCompanyVO().getId());
				for(EmployeeViewVO vo : fullEmployeeList) {
					if(employeeVO.getId().equals(vo.getId())) {
						exOrderVO.setIdDepartment(vo.getDepartment());
						break;
					}
				}
			}
		} catch(Throwable t) {
			errorResult(t);
		}
	}
	
