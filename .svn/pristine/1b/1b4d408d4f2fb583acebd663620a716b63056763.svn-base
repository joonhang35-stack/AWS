	@SuppressWarnings("unchecked")
	public void handlePaymentTerm() {
		try {
			List<LookupItemVO> lookupList = LookupItemUtils.getLookupItemList("pymt_term");
			for (LookupItemVO vo : lookupList) {
				if (vo.getCode().equals(exOrderVO.getPaymentTerm())) {
					Date newDate = DateUtils.addDays(exOrderVO.getEoDt(), Integer.parseInt(vo.getRemarks()));
					exOrderVO.setDueDt(newDate);
					break;
				}
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Handle Invoice and Exchange Order selection
	 */
	public void handleInvEOSelect(SelectEvent event) {
		try {
			InvoiceAndExchangeOrderVO invoiceAndExchangeOrderVO = (InvoiceAndExchangeOrderVO) event.getObject();
			exOrderDetailsViewVO.setDesc(invoiceAndExchangeOrderVO.getDescription());
			exOrderDetailsViewVO.setPrice(invoiceAndExchangeOrderVO.getAmount());
			calAmt();
			
		} catch (Throwable t) {
