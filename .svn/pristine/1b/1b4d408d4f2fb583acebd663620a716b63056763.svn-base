			} else super.setRowIndex(rowIndex % getPageSize());
		}
	}
	
	/**********************
	 * Lazy loading model *
	 **********************/
	class LazyEORefDataModel extends LazyDataModel<ExOrderVO> implements Serializable {
		private static final long serialVersionUID = 1L;
		private boolean clearFilter;
		
		public LazyEORefDataModel(boolean clearFilter) {
			this.clearFilter = clearFilter;
		}

		/*
		 * (non-Javadoc)
		 * @see org.primefaces.model.LazyDataModel#load(int, int, java.lang.String, org.primefaces.model.SortOrder, java.util.Map)
		 */
		@Override
		public List<ExOrderVO> load(int first, int pageSize, String sortField, SortOrder sortOrder, Map<String, String> filters) {
			try {
				if (clearFilter) filters.clear();
				
				Map<String, Object> params = new HashMap<String, Object>();
				params.put("companyId", getSessionInfoBean().getCompanyVO().getId());
				params.put("first", first);
				params.put("pageSize", pageSize);
				params.put("sortField", sortField);
				params.put("sortOrder", sortOrder);
				params.put("filters", filters);
				params.put("type", "I");
				setRowCount(purchaseEOBO.getEOListSize(params));
				if (0 < getRowCount()) return purchaseEOBO.getEOList(params);
				
			} catch (Throwable t) {
				t.printStackTrace();
				errorResult(t);
			} finally {
				clearFilter = false;
			}
			return null;
		}
		
		@Override
		public void setRowIndex(int rowIndex) {
			/*
			 * The following is in ancestor (LazyDataModel):
			 * this.rowIndex = rowIndex == -1 ? rowIndex : (rowIndex % pageSize);
			 */
			if (rowIndex == -1 || getPageSize() == 0) {
				super.setRowIndex(-1);
			} else super.setRowIndex(rowIndex % getPageSize());
		}
		
	}
	
