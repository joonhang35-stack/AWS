	/**
	 * Exchange Order Initialized
	 * @throws BusinessException 
	 */
	public void initEO(String status) throws BusinessException {
		if (status == null) {
			supplierDisabled = "true";
			setPrefixValue("");

			eoList = new ArrayList<ExOrderVO>();
			tourList = new ArrayList<TourDepartureVO>();
			pymtTermList = new ArrayList<LookupItemVO>();
			invoiceList = new ArrayList<InvoiceVO>();
			employeeVO = new EmployeeVO();
			foreignExRateVO = new ForeignExRateVO();
			eoInvoiceVO = new EOInvoiceVO();
			lazyInvoiceDataModel = new LazyInvoiceDataModel();
			foreignExRateList = foreignExRateBO.getForeignExRateList();
	
			resetForm();
			loadListingTableView();

			SystemNumberGenerationVO invSNGVO = systemNumberGenerationBO.getSystemNumberGeneration(CommonConstant.SYS_NUM_CD_INVC, this.getSessionInfoBean().getCompanyVO().getId());
			setPrefixValue(invSNGVO.getPrefixid());
		}
		try{
			loadEO(status);
			if (status == null) countryList = purchaseBO.getCountryList();
			
			// Load Visible Config
			Map<String, Object> params = new HashMap<>();
			params.put("listingType", CommonConstant.LISTING_TYPE_EO_CAT);
			visibleConfigList = visibleListingConfigBO.getVisibleListingConfigListGroupByCatCdListingtype(params);
			
			// load prefix value (for inv & ps)
			initPrefixVal();
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void search() throws BusinessException {
        loadEO(null);
    }
	
	public void initEOPopUp(String status) {
		try {
			if (status == null) {
				SystemNumberGenerationVO invSNGVO = systemNumberGenerationBO.getSystemNumberGeneration(CommonConstant.SYS_NUM_CD_INVC, this.getSessionInfoBean().getCompanyVO().getId());
				setPrefixValue(invSNGVO.getPrefixid());
			}
			// load prefix value (for inv & ps)
			initPrefixVal();
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
