	/**
	 * On Exchange Order selected
	 * @param event
	 */
	public void onEOSelected(ExOrderVO eoVO) {
		try {
			isEditEOItemSeq = false;
			isEditEOPaxSeq = false;
			isEditEOAirlineSeq = false;
			isEditEOHotelSeq = false;
			
			exOrderVO = purchaseEOBO.getExOrderById(((ExOrderVO) eoVO).getId());
			loadSupplier();
			loadPymtTerm();
			
			totalAmt = 0.00;
			amtPaid = 0.00;
			amtDue = 0.00;
			Double totalAmt = 0.00;
			Double totalForeCurAmt = 0.00;
			DateFormat dtformat = new SimpleDateFormat("dd-MMM-yyyy");
			 
			exOrderVO.setTourDepVO(tourPkgBO.getTourDepById( exOrderVO.getTourId()));
			supplierVO = purchaseEOBO.getEOSupplier(exOrderVO.getSupplierId());
			exOrderVO.setPersonId(supplierVO.getPersonId());
			exOrderVO.setAddEdit(true);

			if(exOrderVO.getStatus().equals("PE")) supplierDisabled = "false";
			
			TourDepartureVO tourDepVO = (TourDepartureVO) exOrderVO.getTourDepVO();
			exOrderVO.setTourId(tourDepVO.getId());
				
			tourCodeDesc = tourDepVO.getCode();
			depDt = tourDepVO.getDtDep();
			tourCodeDesc = exOrderVO.getTourDepVO().getCode();
			
			supplierVO = purchaseEOBO.getSupplier(exOrderVO.getPersonId());
			
			exOrderVO.setEoDetailsList(purchaseEOBO.getEODetailsList(eoVO.getId()));
			exOrderVO.setPaxNameList(purchaseEOBO.getPaxNameList(eoVO.getId()));
			exOrderVO.setAirlineList(purchaseEOBO.getAirLineList(eoVO.getId()));
			exOrderVO.setHotelTourList(purchaseEOBO.getHotelTourList(eoVO.getId()));
			exOrderVO.setEoInvList(purchaseEOBO.getEOInvList(eoVO.getId()));
			exOrderVO.setExOrderAttachmentList(purchaseEOBO.getEOAttachmentList(eoVO.getId()));
			
			employeeVO = purchaseEOBO.getEmployee(exOrderVO.getOrderedId());
			
			InvoiceVO tempInvoiceVO = new InvoiceVO();
			for (int i = 0 ; i < exOrderVO.getEoInvList().size() ; i++) {
				tempInvoiceVO = invoiceBO.getInvoiceById(exOrderVO.getEoInvList().get(i).getInvId());
				invoiceBO.getInvoiceDetails(tempInvoiceVO);
				exOrderVO.getEoInvList().get(i).setInvDate(tempInvoiceVO.getInvoiceDt().toString());
				exOrderVO.getEoInvList().get(i).setInvDateView(tempInvoiceVO.getInvoiceDt());
				exOrderVO.getEoInvList().get(i).setCustomerID(tempInvoiceVO.getCustDetailsVO().getCode()); 
				exOrderVO.getEoInvList().get(i).setCustomerName(tempInvoiceVO.getCustDetailsVO().getContPersonName()); 
				exOrderVO.getEoInvList().get(i).setSalesAmount(tempInvoiceVO.getAmount());
				if (tempInvoiceVO.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_PAX_STMT)) {
					exOrderVO.getEoInvList().get(i).setCode(tempInvoiceVO.getPsNo());
					if(tempInvoiceVO.getDocTypeStatus().equals("CV") && StringUtils.isNotBlank(tempInvoiceVO.getCode())) {
						exOrderVO.getEoInvList().get(i).setRefCode(invPrefixVal + " " + tempInvoiceVO.getCode());
					}
				} else {
					exOrderVO.getEoInvList().get(i).setCode(tempInvoiceVO.getCode());
					if(StringUtils.isNotBlank(tempInvoiceVO.getPsNo())) {
						exOrderVO.getEoInvList().get(i).setRefCode(psPrefixVal + " " + tempInvoiceVO.getPsNo());
					}
				}
				exOrderVO.getEoInvList().get(i).setDocTypeCd(tempInvoiceVO.getDocTypeCd());
			}
			
			eoBillVO = billPymtBO.getEOBillByEOId(eoVO.getId());
			if (eoBillVO != null && CollectionUtils.isNotEmpty(eoBillVO.getBillPmntList())) {
				for (BillPaymentVO vo : eoBillVO.getBillPmntList()) {
					amtPaid += vo.getPmntAmount();
				}
			}
			
			for (int i = 0 ; i < exOrderVO.getEoDetailsList().size() ; i++) {
				foreignExRateVO = purchaseEOBO.getExRate(exOrderVO.getEoDetailsList().get(i).getCurrencyId());
				exOrderVO.getEoDetailsList().get(i).setCurrency(foreignExRateVO.getCode());
				totalAmt += exOrderVO.getEoDetailsList().get(i).getAmount();
				totalForeCurAmt += exOrderVO.getEoDetailsList().get(i).getForeCurAmt();
			}
			
			for(int i = 0; i < exOrderVO.getAirlineList().size(); i++) {
				if (exOrderVO.getAirlineList().get(i).getAirLineDt() != null) exOrderVO.getAirlineList().get(i).setStrAirLineDt(dtformat.format(exOrderVO.getAirlineList().get(i).getAirLineDt()));
			}
			
			for(int i = 0; i < exOrderVO.getHotelTourList().size(); i++) {
				exOrderVO.getHotelTourList().get(i).setStrChkInDt(dtformat.format(exOrderVO.getHotelTourList().get(i).getCheckInDt()));
				exOrderVO.getHotelTourList().get(i).setStrChkOutDt(dtformat.format(exOrderVO.getHotelTourList().get(i).getCheckOutDt()));
			}
			if (exOrderDetailsVO == null) exOrderDetailsVO = new ExOrderDetailsVO();
			exOrderDetailsVO.setTotalAmt(totalAmt);
			exOrderDetailsVO.setTotalForeCurAmt(totalForeCurAmt);
			//invoiceAndEOList = invoiceAndExchangeOrderBO.getInvoiceAndExchangeOrderList(getSessionInfoBean().getCompanyVO().getId());
			
			loadPymtTerm();
			
			this.totalAmt = totalAmt;
			amtDue = this.totalAmt - amtPaid;
			exOrderVO.setAmtDue(amtDue);
			exOrderVO.setTotalAmt(this.totalAmt);
			
			loadEmployeeList();
			
			initPrefixVal(); // for bill payment view EO, initEO not called
			
			resetFileUploadForm();

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	} 
	 
