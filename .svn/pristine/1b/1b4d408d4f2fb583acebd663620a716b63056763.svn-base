	public void resetEmailForm() {
		emailType = ProductConstant.SEND_EMAIL_BY_INDIVIDUAL;
		fullEmployeeList = new ArrayList<String>();
		eoChangesList = new ArrayList<String>();
		departmentList = new ArrayList<String>();
		otherTypeRemark = "";
		selectedEmployee = "";
		selectedDepartment = "";
		selectedChanges = "";
	}
	
	public void resetImportEO() {
		isFromImportEODetails = false;
		isFromImportAirline = false;
		isFromImportHotelAndTour = false;
		isFromImportAirlineFromTourDep = false;
		isFromImportHotelAndTourFromTourDep = false;
	}
	
	public void processSendEmail() {
		try {
			boolean isPersonSent = false;
			boolean isDeptSent = false;
			
			if (CollectionUtils.isEmpty(fullEmployeeList) && CollectionUtils.isEmpty(departmentList)) {
				FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_ERROR, "Specific Person and Department must be select either one.", "");
				FacesContext.getCurrentInstance().addMessage(null, msg);
				return;
			}
			
			if (CollectionUtils.isNotEmpty(fullEmployeeList)) {
				emailList = new ArrayList<String>();
				for(EmployeeViewVO vo : employeeList){
					for(String id : fullEmployeeList) {
						if(StringUtils.equals(id, String.valueOf(vo.getId()))) {
							if(StringUtils.isNotBlank(vo.getUserVO().getEmailAddress())) {
								emailList.add(vo.getUserVO().getEmailAddress());
							}
						}
					}
				}
				emailingBO.sendEOChangesBySpecificPerson(exOrderVO, prefixValue, emailList, eoChangesList, otherTypeRemark, getSessionInfo().getUserVO());
				isPersonSent = true;
			}
			
			if (isPersonSent) {
				FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_INFO, "Specific Person - Mail Sent Successfully", "");
				FacesContext.getCurrentInstance().addMessage(null, msg);
			}
			
			if(CollectionUtils.isNotEmpty(departmentList)) {
				List<LookupItemVO> dptmtList = LookupItemUtils.getLookupItemList(CommonConstant.LOOKUP_CAT_CD_DEPARTMENT);
				
				List<String> emailList = new ArrayList<String>();
				for (String selectedDptmt : departmentList) {
					for (LookupItemVO liVO : dptmtList) {
						if (selectedDptmt.equals(liVO.getCode())) {
							if (liVO.getRemarks() != null && liVO.getRemarks().toLowerCase().startsWith("email:"))
							emailList.add(liVO.getRemarks().replaceAll("(?i)email:", "").trim());
						}
					}
				}
				
				if(CollectionUtils.isNotEmpty(emailList)) {
					emailingBO.sendEOChangesByDepartment(exOrderVO, prefixValue, emailList, eoChangesList, otherTypeRemark, this.getSessionInfoBean().getCompanyVO().getId(), getSessionInfo().getUserVO());
					isDeptSent = true;
				} else {
					isDeptSent = false;
				}
			}
			
			if (isDeptSent) {
				FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_INFO, "Department - Mail Sent Successfully", "");
				FacesContext.getCurrentInstance().addMessage(null, msg);
			} else {
				FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_WARN, "Department - Mail Sent Unsuccessfully", "");
				FacesContext.getCurrentInstance().addMessage(null, msg);
			}
			
			resetEmailForm();
//			RequestContext.getCurrentInstance().addCallbackParam("isPass", isPass);
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleNtfctItemChange(int flag) {
		if (flag == 1) {
			selectedEmployee = "";
			for (String emp : fullEmployeeList) {
				for (EmployeeViewVO vo : employeeList) {
					if (Long.parseLong(emp) == vo.getId()) {
						if (StringUtils.isBlank(selectedEmployee))
							selectedEmployee = vo.getUserVO().getName();
						else
							selectedEmployee = selectedEmployee + ", " + vo.getUserVO().getName();
						break;
					}
				}
			}
		} else if (flag == 2) {
			selectedDepartment = "";
			for (String dep : departmentList) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_DEPARTMENT, dep);
				if (StringUtils.isBlank(selectedDepartment))
					selectedDepartment = tempDesc;
				else
					selectedDepartment = selectedDepartment + ", " + tempDesc;
			}
		} else if (flag == 3) {
			selectedChanges = "";
			for (String chgs : eoChangesList) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_INV_CHANGES, chgs);
				if (StringUtils.isBlank(selectedChanges))
					selectedChanges = tempDesc;
				else
					selectedChanges = selectedChanges + ", " + tempDesc;
			}
		}
	}
	
	public void handleEORefNoClick(ExOrderVO eoVO) {
		try {
			exOrderRefVO = purchaseEOBO.getExOrderById(((ExOrderVO) eoVO).getId());
			supplierRefList = purchaseBO.getSupplierList(getSessionInfoBean().getCompanyVO().getId(), true);
			pymtTermRefList = purchaseBO.getPymtTermList("pymt_term");
			
			totalAmtRef = 0.00;
			amtPaidRef = 0.00;
			amtDueRef = 0.00;
			Double totalAmt = 0.00;
			Double totalForeCurAmt = 0.00;
			DateFormat dtformat = new SimpleDateFormat("dd-MMM-yyyy");
			 
			exOrderRefVO.setTourDepVO(tourPkgBO.getTourDepById( exOrderRefVO.getTourId()));
			supplierRefVO = purchaseEOBO.getEOSupplier(exOrderRefVO.getSupplierId());
			exOrderRefVO.setPersonId(supplierRefVO.getPersonId());
			exOrderRefVO.setAddEdit(true);

//			if(exOrderRefVO.getStatus().equals("PE")) supplierDisabled = "false";
			
			TourDepartureVO tourDepVO = (TourDepartureVO) exOrderRefVO.getTourDepVO();
			exOrderRefVO.setTourId(tourDepVO.getId());
				
			tourCodeDescRef = tourDepVO.getCode();
			depDtRef = tourDepVO.getDtDep();
			tourCodeDescRef = exOrderRefVO.getTourDepVO().getCode();
			
			supplierRefVO = purchaseEOBO.getSupplier(exOrderRefVO.getPersonId());
			
			exOrderRefVO.setEoDetailsList(purchaseEOBO.getEODetailsList(eoVO.getId()));
			exOrderRefVO.setPaxNameList(purchaseEOBO.getPaxNameList(eoVO.getId()));
			exOrderRefVO.setAirlineList(purchaseEOBO.getAirLineList(eoVO.getId()));
			exOrderRefVO.setHotelTourList(purchaseEOBO.getHotelTourList(eoVO.getId()));
			exOrderRefVO.setEoInvList(purchaseEOBO.getEOInvList(eoVO.getId()));
			exOrderRefVO.setExOrderAttachmentList(purchaseEOBO.getEOAttachmentList(eoVO.getId()));
			
			employeeRefVO = purchaseEOBO.getEmployee(exOrderRefVO.getOrderedId());
			
			InvoiceVO tempInvoiceVO = new InvoiceVO();
			for (int i = 0 ; i < exOrderRefVO.getEoInvList().size() ; i++) {
				tempInvoiceVO = invoiceBO.getInvoiceById(exOrderRefVO.getEoInvList().get(i).getInvId());
				invoiceBO.getInvoiceDetails(tempInvoiceVO);
				exOrderRefVO.getEoInvList().get(i).setInvDate(tempInvoiceVO.getInvoiceDt().toString());
				exOrderRefVO.getEoInvList().get(i).setInvDateView(tempInvoiceVO.getInvoiceDt());
				exOrderRefVO.getEoInvList().get(i).setCustomerID(tempInvoiceVO.getCustDetailsVO().getCode()); 
				exOrderRefVO.getEoInvList().get(i).setCustomerName(tempInvoiceVO.getCustDetailsVO().getContPersonName()); 
				exOrderRefVO.getEoInvList().get(i).setSalesAmount(tempInvoiceVO.getAmount());
				exOrderRefVO.getEoInvList().get(i).setCode(tempInvoiceVO.getCode());
			}
			
			eoBillRefVO = billPymtBO.getEOBillByEOId(eoVO.getId());
			if (eoBillRefVO != null && CollectionUtils.isNotEmpty(eoBillRefVO.getBillPmntList())) {
				for (BillPaymentVO vo : eoBillRefVO.getBillPmntList()) {
					amtPaidRef += vo.getPmntAmount();
				}
			}
			
			for (int i = 0 ; i < exOrderRefVO.getEoDetailsList().size() ; i++) {
				foreignExRateRefVO = purchaseEOBO.getExRate(exOrderRefVO.getEoDetailsList().get(i).getCurrencyId());
				exOrderRefVO.getEoDetailsList().get(i).setCurrency(foreignExRateRefVO.getCode());
				totalAmt += exOrderRefVO.getEoDetailsList().get(i).getAmount();
				totalForeCurAmt += exOrderRefVO.getEoDetailsList().get(i).getForeCurAmt();
			}
			
			for(int i = 0; i < exOrderRefVO.getAirlineList().size(); i++) {
				exOrderRefVO.getAirlineList().get(i).setStrAirLineDt(dtformat.format(exOrderRefVO.getAirlineList().get(i).getAirLineDt()));
			}
			
			for(int i = 0; i < exOrderRefVO.getHotelTourList().size(); i++) {
				exOrderRefVO.getHotelTourList().get(i).setStrChkInDt(dtformat.format(exOrderRefVO.getHotelTourList().get(i).getCheckInDt()));
				exOrderRefVO.getHotelTourList().get(i).setStrChkOutDt(dtformat.format(exOrderRefVO.getHotelTourList().get(i).getCheckOutDt()));
			}
			if (exOrderDetailsRefVO == null) exOrderDetailsRefVO = new ExOrderDetailsVO();
			exOrderDetailsRefVO.setTotalAmt(totalAmt);
			exOrderDetailsRefVO.setTotalForeCurAmt(totalForeCurAmt);
			//invoiceAndEOList = invoiceAndExchangeOrderBO.getInvoiceAndExchangeOrderList(getSessionInfoBean().getCompanyVO().getId());
			
			pymtTermRefList = purchaseBO.getPymtTermList("pymt_term");
			
			this.totalAmtRef = totalAmt;
			amtDueRef = this.totalAmtRef - amtPaidRef;
			exOrderRefVO.setAmtDue(amtDueRef);
			exOrderRefVO.setTotalAmt(this.totalAmtRef);

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	} 
	
	public void eoSendEmail() {
		resetEmailForm();
	}
	
	public String formatMyrCurrency(double amtDue) {
	    if (amtDue == 0.0) {
	        return "0.00";
	    }
	    return "MYR " + new DecimalFormat("#,##0.00").format(amtDue);
	}
	
	public void handleEONoSelect(SelectEvent event) {
		try {
			ExOrderVO vo = (ExOrderVO) event.getObject();
			
			if (isFromImportEODetails) {
				List<ExOrderDetailsVO> eoDetailsList = purchaseEOBO.getEODetailsList(vo.getId());
				for (ExOrderDetailsVO eoDetailsVO : eoDetailsList) {
					eoDetailsVO.setExOrderId(null);
					eoDetailsVO.setId(null);
					exOrderVO.getEoDetailsList().add(eoDetailsVO);
				}
			}
			
			if (isFromImportAirline) {
				List<AirLineDetailsVO> airlineDetailsList = purchaseEOBO.getAirLineList(vo.getId());
				for (AirLineDetailsVO airlineDetailsVO : airlineDetailsList) {
					airlineDetailsVO.setExOrderId(null);
					airlineDetailsVO.setId(null);
					exOrderVO.getAirlineList().add(airlineDetailsVO);
				}
			}
			
			if (isFromImportHotelAndTour) {
				List<HotelTourVO> hotelTourList = purchaseEOBO.getHotelTourList(vo.getId());
				for (HotelTourVO hotelTourVO : hotelTourList) {
					hotelTourVO.setExOrderId(null);
					hotelTourVO.setId(null);
					SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy");
			        String strCheckInDt = sdf.format(hotelTourVO.getCheckInDt());
			        hotelTourVO.setStrChkInDt(strCheckInDt);
			        String strCheckOutDt = sdf.format(hotelTourVO.getCheckOutDt());
			        hotelTourVO.setStrChkOutDt(strCheckOutDt);
					exOrderVO.getHotelTourList().add(hotelTourVO);
				}
			}
			
			resetImportEO();
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void printExOrder() {
		try {
	        Map<String, Object> params = new HashMap<>();
	        List<String> notViewableCatCode = new ArrayList<>();
			if (CollectionUtils.isNotEmpty(visibleConfigList)) {
				boolean isVisible = false;
				for (VisibleListingConfigVO vo : visibleConfigList) {
					isVisible = false;
					
					if (vo.getIdRoleList() != null) {
						for (String idRole : vo.getIdRoleList()) {
							for (UserRoleViewVO roleVO : getSessionInfo().getUserVO().getRoleList()) {
								if (roleVO.getRoleUUID().equals(idRole)) {
									isVisible = true;
									break;
								}
							}
						}
					}
					
					if (vo.getDepartmentList() != null) {
						for (String dept : vo.getDepartmentList()) {
							if (getSessionInfoBean().getEmployeeVO().getDepartment().equalsIgnoreCase(dept)) {
								isVisible = true;
								break;
							}
						}
					}
					
					if (!isVisible) {
						notViewableCatCode.add(vo.getCatCd());
					}
				}
			}
			
			params.put("companyId", getSessionInfoBean().getCompanyVO().getId());
	        params.put("sortField", null);
	        params.put("sortOrder", null);
	        params.put("filters", lastFilters);
	        params.put("status", null);
	        params.put("first", 0);
	        params.put("pageSize", Integer.MAX_VALUE);
			if (CollectionUtils.isNotEmpty(notViewableCatCode)) params.put("notViewableCatCode", notViewableCatCode);
	        if (invDateFrom != null) params.put("invDateFrom", invDateFrom);
	        if (invDateTo != null) params.put("invDateTo", invDateTo);
	        if (depDateFrom != null) params.put("depDateFrom", depDateFrom);
	        if (depDateTo != null) params.put("depDateTo", depDateTo);
	        if (fromDate != null) params.put("fromDate", fromDate);
	        if (toDate != null) params.put("toDate", toDate);
	        if (StringUtils.isNotBlank(eoFrom)) params.put("eoFrom", eoFrom);
	        if (StringUtils.isNotBlank(eoTo)) params.put("eoTo", eoTo);
	        
	        eoList = purchaseEOBO.getEOList(params);
	        
	        		
	    	HashMap<String, Object> map = new HashMap<String, Object>();
	    	
	    	
	    	if (CollectionUtils.isEmpty(eoList)) throw new BusinessException(CommonErrConstant.ERR_NO_RESULT);
	    	map.put("list", eoList);
	    	
	        String jasperFileName = CommonConstant.JAS_RPT_EXORDER_LIST;
	        String reportName = CommonConstant.PDF_RPT_EXORDER_LIST;
	        
	        JasperPrint jasperPrint = ReportUtils.getJasperPrint(eoList, map, jasperFileName);
	        ReportUtils.printReportExcel(jasperPrint, reportName);
	                
	    } catch (Throwable t) {
	        t.printStackTrace();
	        errorResult(t);
	    } 

	}
	/**
	 * Load EO List
	 */
	public void loadEORefList(boolean importEODetails, boolean importAirline, boolean importHotelAndTour) {
		try {
			isFromImportEODetails = importEODetails;
			isFromImportAirline = importAirline;
			isFromImportHotelAndTour = importHotelAndTour;
			
			lazyEORefDataModel = new LazyEORefDataModel(true);
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void loadTourDepRefList(boolean importAirlineFromTourDep, boolean importHotelAndTourFromTourDep) {
		try {
			isFromImportAirlineFromTourDep = importAirlineFromTourDep;
			isFromImportHotelAndTourFromTourDep = importHotelAndTourFromTourDep;
			loadTour();
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**********************
	 * Lazy loading model *
	 **********************/
	
	class LazyEODataModel extends LazyDataModel<ExOrderVO> implements Serializable {
		private static final long serialVersionUID = 1L;
		
		private String status;
		
		public LazyEODataModel(String status) {
			this.status = status;
		}

		/*
		 * (non-Javadoc)
		 * @see org.primefaces.model.LazyDataModel#load(int, int, java.lang.String, org.primefaces.model.SortOrder, java.util.Map)
		 */
		@Override
		public List<ExOrderVO> load(int first, int pageSize, String sortField, SortOrder sortOrder, Map<String, String> filters) {
			try {
				// Config of Role that allow to view certain list by category code
				List<String> notViewableCatCode = new ArrayList<>();
				if (CollectionUtils.isNotEmpty(visibleConfigList)) {
					boolean isVisible = false;
					for (VisibleListingConfigVO vo : visibleConfigList) {
						isVisible = false;
						
						if (vo.getIdRoleList() != null) {
							for (String idRole : vo.getIdRoleList()) {
								for (UserRoleViewVO roleVO : getSessionInfo().getUserVO().getRoleList()) {
									if (roleVO.getRoleUUID().equals(idRole)) {
										isVisible = true;
										break;
									}
								}
							}
						}
						
						if (vo.getDepartmentList() != null) {
							for (String dept : vo.getDepartmentList()) {
								if (getSessionInfoBean().getEmployeeVO().getDepartment().equalsIgnoreCase(dept)) {
									isVisible = true;
									break;
								}
							}
						}
						
						if (!isVisible) {
							notViewableCatCode.add(vo.getCatCd());
						}
					}
				}
				Map<String, Object> params = new HashMap<String, Object>();
				params.put("companyId", getSessionInfoBean().getCompanyVO().getId());
				params.put("first", first);
				params.put("pageSize", pageSize);
				params.put("sortField", sortField);
				params.put("sortOrder", sortOrder);
				params.put("filters", filters);
				lastFilters = filters;
				if (CollectionUtils.isNotEmpty(notViewableCatCode)) params.put("notViewableCatCode", notViewableCatCode);
				if (invDateFrom != null) params.put("invDateFrom", invDateFrom);
	            if (invDateTo != null) params.put("invDateTo", invDateTo);
	            if (depDateFrom != null) params.put("depDateFrom", depDateFrom);
	            if (depDateTo != null) params.put("depDateTo", depDateTo);
				if (fromDate != null) params.put("fromDate", fromDate);
				if (toDate != null) params.put("toDate", toDate);
				if (StringUtils.isNotBlank(eoFrom)) params.put("eoFrom", eoFrom);
				if (StringUtils.isNotBlank(eoTo)) params.put("eoTo", eoTo);
				if (CollectionUtils.isNotEmpty(notViewableCatCode)) params.put("notViewableCatCode", notViewableCatCode);
				params.put("status", status);
				setRowCount(purchaseEOBO.getEOListSize(params));
				if (0 < getRowCount()) return purchaseEOBO.getEOList(params);
				
			} catch (Throwable t) {
				t.printStackTrace();
				errorResult(t);
			}
			return null;
		}
		
		@Override
		public void setRowIndex(int rowIndex) {
			/*
			 * The following is in ancestor (LazyDataModel):
			 * this.rowIndex = rowIndex == -1 ? rowIndex : (rowIndex % pageSize);
			 */
			if (rowIndex == -1 || getPageSize() == 0) {
				super.setRowIndex(-1);
			} else super.setRowIndex(rowIndex % getPageSize());
		}
		
	}
	
