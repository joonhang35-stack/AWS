	/**
	 * Edit Exchange Order Details
	 */
	public void editEODetails() {
		try {
			Double totalAmt = 0.00;
			Double totalForeCurAmt = 0.00;
			
			exOrderDetailsVO.setDesc(exOrderDetailsViewVO.getDesc());
			exOrderDetailsVO.setPrice(exOrderDetailsViewVO.getPrice());
			exOrderDetailsVO.setQty(exOrderDetailsViewVO.getQty());
			exOrderDetailsVO.setExRate(exOrderDetailsViewVO.getExRate());
			exOrderDetailsVO.setCurrencyId(exOrderDetailsViewVO.getCurrencyId());
			exOrderDetailsVO.setForeCurAmt(exOrderDetailsViewVO.getForeCurAmt());
			exOrderDetailsVO.setAmount(exOrderDetailsViewVO.getAmount());
			foreignExRateVO = purchaseEOBO.getExRate(exOrderDetailsViewVO.getCurrencyId());
			exOrderDetailsVO.setCurrency(foreignExRateVO.getCode());
			
			for (int i = 0 ; i < exOrderVO.getEoDetailsList().size() ; i++) {
				totalAmt += exOrderVO.getEoDetailsList().get(i).getAmount();
				totalForeCurAmt += exOrderVO.getEoDetailsList().get(i).getForeCurAmt();
			}
			
			resetEODetailsForm();
			exOrderDetailsVO.setTotalAmt(totalAmt);
			exOrderDetailsVO.setTotalForeCurAmt(totalForeCurAmt);
			exOrderDetailsViewVO.setCurrencyId(CommonConstant.DEF_CURRENCY_ID);
			exOrderDetailsViewVO.setExRate(1.00);
			this.totalAmt = totalAmt;
			exOrderVO.setTotalAmt(this.totalAmt);
			
			if (eoBillVO != null && CollectionUtils.isNotEmpty(eoBillVO.getBillPmntList())) {
				BigDecimal tmpAmtPaid = new BigDecimal("0.0");
				BigDecimal tmpBillPmnt;
				for (int i = 0 ; i < eoBillVO.getBillPmntList().size() ; i++) {
					tmpBillPmnt = new BigDecimal(eoBillVO.getBillPmntList().get(i).getPmntAmount().toString());
					tmpAmtPaid = tmpAmtPaid.add(tmpBillPmnt);
				}
				amtPaid = tmpAmtPaid.doubleValue();
				exOrderVO.setAmtDue(new BigDecimal(exOrderVO.getTotalAmt().toString()).subtract(tmpAmtPaid).doubleValue());
				
			} else {
				exOrderVO.setAmtDue(this.totalAmt);
			}
			this.amtDue = exOrderVO.getAmtDue();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
