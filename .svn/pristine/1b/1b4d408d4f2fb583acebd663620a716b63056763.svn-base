	/**
	 * Handle Invoice selection
	 */
	public void handleInvNoSelect(SelectEvent event) {
		try {
			InvoiceVO invoiceVO = (InvoiceVO) event.getObject(); 
			exOrderVO.setCnNumber(invoiceVO.getId().toString()); 
			exOrderVO.setSuppInvoiceDt(invoiceVO.getInvoiceDt()); 
			eoInvoiceVO = new EOInvoiceVO(); 
			eoInvoiceVO.setEoId(exOrderVO.getId()); 
			eoInvoiceVO.setInvId(invoiceVO.getId()); 
			
			
			if (invoiceVO.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_PAX_STMT)) {
				eoInvoiceVO.setCode(invoiceVO.getPsNo());
				if(invoiceVO.getDocTypeStatus().equals("CV") && StringUtils.isNotBlank(invoiceVO.getCode())) {
					eoInvoiceVO.setRefCode(invPrefixVal + " " + invoiceVO.getCode());
				}
			}
			if (invoiceVO.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_INVC)) {
				eoInvoiceVO.setCode(invoiceVO.getCode());
				if(StringUtils.isNotBlank(invoiceVO.getPsNo())) {
					eoInvoiceVO.setRefCode(psPrefixVal + " " + invoiceVO.getPsNo());
				}
			}
//			eoInvoiceVO.setCode(invoiceVO.getCode());
			eoInvoiceVO.setDocTypeCd(invoiceVO.getDocTypeCd());
			eoInvoiceVO.setInvDate(invoiceVO.getInvoiceDt().toString()); 
			eoInvoiceVO.setInvDateView(invoiceVO.getInvoiceDt()); 
			eoInvoiceVO.setCustomerID(invoiceVO.getCustomerId().toString()); 
			eoInvoiceVO.setCustomerName(invoiceVO.getCustName());
			eoInvoiceVO.setSalesAmount(invoiceVO.getAmount());
 
			boolean found = false;
			for(int i = 0; i < exOrderVO.getEoInvList().size(); i++){
				if( exOrderVO.getEoInvList().get(i).getInvId().toString().equals(eoInvoiceVO.getInvId().toString())) {
					found = true;
				}
			}
			
			if (!found) { 
				exOrderVO.getEoInvList().add(eoInvoiceVO);
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/*
	 * Amount Calculation
	 */
	public void calAmt() {
		try {
			if(exOrderDetailsViewVO.getQty() == null) exOrderDetailsViewVO.setQty(1);
//			exOrderDetailsViewVO.setForeCurAmt(exOrderDetailsViewVO.getQty() * exOrderDetailsViewVO.getPrice());
			exOrderDetailsViewVO.setForeCurAmt(
					new BigDecimal(exOrderDetailsViewVO.getQty())
					.multiply(new BigDecimal(exOrderDetailsViewVO.getPrice()))
					.doubleValue()
					);
//			exOrderDetailsViewVO.setAmount(exOrderDetailsViewVO.getForeCurAmt() * exOrderDetailsViewVO.getExRate());
			exOrderDetailsViewVO.setAmount(
					new BigDecimal(exOrderDetailsViewVO.getForeCurAmt())
					.multiply(new BigDecimal(exOrderDetailsViewVO.getExRate()))
					.doubleValue()
					);
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void onChgExchgRate() {
		try {
			foreignExRateVO = purchaseEOBO.getExRate(exOrderDetailsViewVO.getCurrencyId());
			exOrderDetailsViewVO.setExRate(foreignExRateVO.getExchangeRate());
			calAmt();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void addExOrderAttachment() {
		try {
			if (StringUtils.isBlank(exOrderAttachmentVO.getScannedPath())) {
				FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_ERROR, "Scanned Copy is required.", "");
				FacesContext.getCurrentInstance().addMessage(null, msg);
				return;
			}
			
			if (attachmentUploadedFile != null) {
				fileUploadUtils.uploadSingleFile(attachmentUploadedFile, destinationAttachmentPath, exOrderAttachmentVO.getFilePath(), null, null, false);
			}
			
			if (exOrderAttachmentVO.getId() != null) {
				purchaseEOBO.addDeleteEOAttachment(exOrderAttachmentVO, false);
			} else {
				exOrderAttachmentVO.setEoId(exOrderVO.getId());
				purchaseEOBO.addDeleteEOAttachment(exOrderAttachmentVO, false);
				exOrderVO.getExOrderAttachmentList().add(exOrderAttachmentVO);
			}
			
			if (StringUtils.isNotBlank(deletedFilePath)) {
				fileUploadUtils.deleteFile(destinationAttachmentPath, deletedFilePath);
			}
			
			resetAttachmentForm();
			successResult();
		} catch (Exception e) {
			e.printStackTrace();
			errorResult(e);
		}
	}
	
	public void delAttachmentScannedCopy() {
		try {
			deletedFilePath = exOrderAttachmentOriVO.getFilePath();
			exOrderAttachmentVO.setScannedPath(null);
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void deleteInvAttachment() {
		try {
			fileUploadUtils.deleteFile(destinationAttachmentPath, exOrderAttachmentVO.getFilePath());
			purchaseEOBO.addDeleteEOAttachment(exOrderAttachmentVO, true);
			exOrderVO.getExOrderAttachmentList().remove(exOrderAttachmentVO);
			successResult();
			
		} catch (Exception e) {
			errorResult(e);
		}
	}
	
	public void cancelAttachmentChange() {
		try {
			deletedFilePath = ""; 
			exOrderAttachmentVO.setScannedPath(exOrderAttachmentOriVO.getScannedPath());
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleAttachmentFileUpload(FileUploadEvent event) {
		try {
			// rename the valid file name
			fileName = event.getFile().getFileName();
			fileName = fileName.replace(" ", "_");
			SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMddHHmmss");
			fileName = sdf.format(new Date()) + "_" + fileName;
			
			exOrderAttachmentVO.setName(fileName);
			exOrderAttachmentVO.setFilePath(UUID.randomUUID().toString() + "." + FilenameUtils.getExtension(fileName));
			
			attachmentUploadedFile = event.getFile();
			
			exOrderAttachmentVO.setScannedPath(fileName);
			
			FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_INFO, "Success! ", event.getFile().getFileName() + " is uploaded.");
			FacesContext.getCurrentInstance().addMessage(null, msg);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
