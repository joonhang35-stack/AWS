			resetRemarksForm();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Add Exchange Order
	 */
	public void addExOrder() {
		try {
			exOrderVO.setApproverId(employeeVO.getId());
			exOrderVO.setOrderedId(employeeVO.getId());
			exOrderVO.setCompanyId(getSessionInfoBean().getCompanyVO().getId());
			
			if(CollectionUtils.isNotEmpty(exOrderVO.getEoDetailsList()) ){
				purchaseEOBO.insertExOrder(supplierVO, exOrderVO, null, null, null, null, null);
				onEOSelected(exOrderVO);
				successResult();
				
			} else throw new BusinessException(CommonErrConstant.ERR_EXCHANGE_ORDER_DETAIL_EMPTY);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Update Exchange Order
	 */
	public void updateExOrder() {
		try {
			String eoStatus = purchaseEOBO.getEOStatus(exOrderVO.getId());
			if (!StringUtils.equals(eoStatus, CommonConstant.STATUS_CD_CANCELLED)) {
				purchaseEOBO.updateExOrder(supplierVO, exOrderVO, null, null, null, null, null);
				onEOSelected(exOrderVO);
				successResult();
				
			} else {
				FacesMessage msg  = new FacesMessage(FacesMessage.SEVERITY_ERROR, "Unable to Save Cancelled Exchange Order", "");
				if (msg != null) FacesContext.getCurrentInstance().addMessage(null, msg);
		        RequestContext.getCurrentInstance().addCallbackParam("validateError", true);
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Delete Exchange Order
	 */
	public void deleteEO() {
		try {
			//purchaseEOBO.delEO(supplierVO, exOrderVO, eoDetailsList, paxNameList, airLineList, hotelTourList);
			purchaseEOBO.delEO(supplierVO, exOrderVO, null, null, null, null);
			initEO(null);
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Retrieve Forex Currency
	 */
	public void addEODetails() {
		try {
			exOrderDetailsViewVO.setCurrencyId(CommonConstant.DEF_CURRENCY_ID);
			exOrderDetailsViewVO.setExRate(1.00);
			isAdd = true;
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}

	/**
	 * Add Exchange Order Details
	 */
	public void addExOrderDetails() {
		try {
			exOrderDetailsVO.setDesc(exOrderDetailsViewVO.getDesc());
			exOrderDetailsVO.setPrice(exOrderDetailsViewVO.getPrice());
			exOrderDetailsVO.setQty(exOrderDetailsViewVO.getQty());
			exOrderDetailsVO.setExRate(exOrderDetailsViewVO.getExRate());
			exOrderDetailsVO.setCurrencyId(exOrderDetailsViewVO.getCurrencyId());
			exOrderDetailsVO.setForeCurAmt(exOrderDetailsViewVO.getForeCurAmt());
			exOrderDetailsVO.setAmount(exOrderDetailsViewVO.getAmount());
			foreignExRateVO = purchaseEOBO.getExRate(exOrderDetailsViewVO.getCurrencyId());
			exOrderDetailsVO.setCurrency(foreignExRateVO.getCode());
			
			Double totalAmt = 0.00;
			Double totalForeCurAmt = 0.00;
			
			if (null == exOrderVO.getEoDetailsList()) exOrderVO.setEoDetailsList(new ArrayList<ExOrderDetailsVO>());
			exOrderVO.getEoDetailsList().add(exOrderDetailsVO);
			
			for (int i = 0 ; i < exOrderVO.getEoDetailsList().size() ; i++) {
				totalAmt += exOrderVO.getEoDetailsList().get(i).getAmount();
				totalForeCurAmt += exOrderVO.getEoDetailsList().get(i).getForeCurAmt();
			}
			
			resetEODetailsForm();
			exOrderDetailsVO.setTotalAmt(totalAmt);
			exOrderDetailsVO.setTotalForeCurAmt(totalForeCurAmt);
			exOrderDetailsViewVO.setCurrencyId(CommonConstant.DEF_CURRENCY_ID);
			exOrderDetailsViewVO.setExRate(1.00);
			this.totalAmt = totalAmt;
			exOrderVO.setTotalAmt(this.totalAmt);
			
			if (eoBillVO != null && CollectionUtils.isNotEmpty(eoBillVO.getBillPmntList())) {
				BigDecimal tmpAmtPaid = new BigDecimal("0.0");
				BigDecimal tmpBillPmnt;
				for (int i = 0 ; i < eoBillVO.getBillPmntList().size() ; i++) {
					tmpBillPmnt = new BigDecimal(eoBillVO.getBillPmntList().get(i).getPmntAmount().toString());
					tmpAmtPaid = tmpAmtPaid.add(tmpBillPmnt);
				}
				amtPaid = tmpAmtPaid.doubleValue();
				exOrderVO.setAmtDue(new BigDecimal(exOrderVO.getTotalAmt().toString()).subtract(tmpAmtPaid).doubleValue());
				
			} else {
				exOrderVO.setAmtDue(this.totalAmt);
			}
			
			this.amtDue = exOrderVO.getAmtDue();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Add Pax Name
	 */
	public void addPaxName() {
		try {
			if (null == exOrderVO.getPaxNameList()) exOrderVO.setPaxNameList(new ArrayList<PaxNameVO>());
