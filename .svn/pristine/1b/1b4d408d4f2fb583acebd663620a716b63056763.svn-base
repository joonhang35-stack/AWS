	/**
	 * Print Exchange
	 */
	
	public void printReport(String printType) {
		try {
			List<ExOrderVO> eoList = new ArrayList<ExOrderVO>();
			
			if (printType.equalsIgnoreCase("EO")) {
				Map<String, Object> map = new HashMap<>();
				
				String supplierNm = "";
				for (SupplierVO vo : supplierList) {
					if (vo.getPersonId().longValue() == supplierVO.getPersonId().longValue()) {
						supplierNm = vo.getFullName();
					}
				}
				map.put("supplierNm", supplierNm);
				map.put("add1", supplierVO.getAdd1());
				map.put("add2", supplierVO.getAdd2());
				map.put("add3", supplierVO.getAdd3());
				map.put("city", supplierVO.getCity());
				map.put("state", supplierVO.getState());
				map.put("postcode", supplierVO.getPostcode());
				map.put("country", supplierVO.getCountry());
				// Set contact
//				String contact = "";
//				if (supplierVO.getCode().equals("P")) {
//					if (CollectionUtils.isNotEmpty(supplierVO.getContactList())) {
//						for (ContactVO vo : supplierVO.getContactList()) {
//							contact += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, vo.getContactType()) + ": " + vo.getContactNo() + "\n";
//						}
//					}
//				} else {
//					if (CollectionUtils.isNotEmpty(supplierVO.getCorContactList())) {
//						for (CorContactVO vo : supplierVO.getCorContactList()) {
//							contact += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, vo.getContactType()) + ": " + vo.getContactNo() + "\n";
//						}
//					}
//				}
				map.put("contact", supplierVO.getContactNo());
				map.put("exOrderNo", exOrderVO.getCode());
				map.put("eoDt", exOrderVO.getEoDt());
				map.put("orderedBy", employeeVO.getEmployeeName());
				map.put("supplierNo", supplierVO.getSysNo());
				map.put("tourCd", tourCodeDesc);
				String invoiceNo = "";
				String prefix = "";
				for(int i = 0; i < exOrderVO.getEoInvList().size(); i++){
					if ("I".equals(exOrderVO.getEoInvList().get(i).getDocTypeCd())) prefix = invPrefixVal;
					else if ("P".equals(exOrderVO.getEoInvList().get(i).getDocTypeCd())) prefix = psPrefixVal;
					else prefix = "";
					
					if (i == 0) {
						invoiceNo += prefix + exOrderVO.getEoInvList().get(i).getCode();
					} else {
						invoiceNo += ", " + prefix + exOrderVO.getEoInvList().get(i).getCode();
					}
				}
				
				map.put("invoiceNo", invoiceNo);
				map.put("attn", exOrderVO.getAttn());
				map.put("reference", exOrderVO.getReference());
				
				map.put("eoDetailsList", exOrderVO.getEoDetailsList());
				map.put("paxNameList", exOrderVO.getPaxNameList());
				map.put("airLineList", exOrderVO.getAirlineList());
				map.put("hotelTourList", exOrderVO.getHotelTourList());
				
				map.put("totalForeCurAmt", exOrderDetailsVO.getTotalForeCurAmt());
				map.put("totalAmt", exOrderDetailsVO.getTotalAmt());
				map.put("amtPaid", amtPaid);
				map.put("eoComments", exOrderVO.getEoComments());
				map.put("userName", getSessionInfoBean().getUserVO().getName());
				
				eoList.add(exOrderVO);
				if (CollectionUtils.isEmpty(eoList)) throw new BusinessException("No result.");

				String jasperFileName = CommonConstant.JAS_RPT_EO;
				String reportName = "EO" + StringUtils.leftPad(exOrderVO.getCode(), 6, "0") + "_";
				
				if (isPrintLetterHead) {
					jasperFileName = CommonConstant.JAS_RPT_EO_LETTERHEAD;
					
					CompanyVO companyVO = corporateProfileBO.getCompanyDetails(exOrderVO.getCompanyId());
					map.put("companyCode", companyVO != null ? companyVO.getCode() : "");
					
					map.put("letterHeadUrl", "../img/letter-head-header.png");
					if (companyVO != null) {
						validateEffectiveCompanyName(companyVO, exOrderVO.getEoDt());
						map.put("letterHeadUrl", companyVO.getLetterHeadUrl());
					}
				} 
				
				JasperPrint jasperPrint1 = ReportUtils.getJasperPrint(eoList, map, jasperFileName);
				ReportUtils.printReport(jasperPrint1, reportName);

			} else if (printType.equalsIgnoreCase("Receipt")) {

			}

		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
