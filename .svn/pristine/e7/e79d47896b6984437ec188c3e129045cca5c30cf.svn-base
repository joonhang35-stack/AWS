package com.bcs.zsg.maintenance.vo;

import com.bcs.zsg.core.vo.BaseVO;

public class DepositMasterConfigVO extends BaseVO {
	
	private static final long serialVersionUID = 1L;
	
	private String pmntTypeCode;
	private Long idBank;
	
	private String pmntTypeDesc;
	
	/**
	 * @return the pmntTypeCode
	 */
	public String getPmntTypeCode() {
		return pmntTypeCode;
	}

	/**
	 * @param pmntTypeCode the pmntTypeCode to set
	 */
	public void setPmntTypeCode(String pmntTypeCode) {
		this.pmntTypeCode = pmntTypeCode;
	}

	/**
	 * @return the idBank
	 */
	public Long getIdBank() {
		return idBank;
	}

	/**
	 * @param idBank the idBank to set
	 */
	public void setIdBank(Long idBank) {
		this.idBank = idBank;
	}

	/**
	 * @return the pmntTypeDesc
	 */
	public String getPmntTypeDesc() {
		return pmntTypeDesc;
	}

	/**
	 * @param pmntTypeDesc the pmntTypeDesc to set
	 */
	public void setPmntTypeDesc(String pmntTypeDesc) {
		this.pmntTypeDesc = pmntTypeDesc;
	}
}
