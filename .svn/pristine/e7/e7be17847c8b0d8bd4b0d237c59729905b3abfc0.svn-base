package com.bcs.zsg.maintenance.vo;


import com.bcs.zsg.core.vo.BaseVO;

public class AccountCodeVO extends BaseVO {

	private static final long serialVersionUID = 1L;

	private String code;
	private  Double exchangeRate;
	private String description;
	
	
	//View Purpose
	
	private String tempCountryCode;
	
	public String getCode() {
		return code;
	}
	public void setCode(String code) {
		this.code = code;
	}
	public Double getExchangeRate() {
		return exchangeRate;
	}
	public void setExchangeRate(Double exchangeRate) {
		this.exchangeRate = exchangeRate;
	}
	
	public String getTempCountryCode() {
		return tempCountryCode;
	}
	public void setTempCountryCode(String tempCountryCode) {
		this.tempCountryCode = tempCountryCode;
	}
	public String getDescription() {
		return description;
	}
	public void setDescription(String description) {
		this.description = description;
	}

	
	
}
