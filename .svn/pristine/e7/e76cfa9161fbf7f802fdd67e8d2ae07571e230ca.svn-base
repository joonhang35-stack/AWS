<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
				template="/WEB-INF/views/layouts/main.xhtml">

<ui:define name="content">
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        var filters = document.querySelectorAll('input.ui-column-filter');
        filters.forEach(function(filter) {
            filter.setAttribute('enterkeyhint', 'enter');
        });
    });
</script>
<p:panel header="Hotels" toggleable="true" toggleSpeed="500">
	<h:form id="idHotelForm">
		<p:panelGrid columns="2" style="width:1px;">
			<p:commandButton value="Add" oncomplete="varAddHotelDialog.show()" update=":idAddHotelDialog"/>
		</p:panelGrid>
		
		<p:dataTable id="idHotelList" value="#{hotelBean.hotelList}" var="hotelVO" paginator="true" rows="20" 
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
			rowsPerPageTemplate="20, 30, 50" filterEvent="enter">
			<p:columnGroup type="header">
				<p:row>
					<p:column rowspan="2" headerText="Edit" style="width:50px"/>
					<p:column rowspan="2" headerText="Delete" style="width:50px"/>
					<p:column rowspan="2" headerText="Name" style="width:150px" sortBy="#{hotelVO.name}" filterBy="#{hotelVO.name}" filterMatchMode="contains"/>
					<p:column rowspan="2" headerText="No. Star" style="width:100px" sortBy="#{hotelVO.starCd}" filterBy="#{hotelVO.starCd}" filterMatchMode="contains"/>
					<p:column rowspan="2" headerText="Country" style="width:100px" sortBy="#{hotelVO.hotelAddrCountrySet.iterator().next().getCountryViewVO().getCountry()}" filterBy="#{hotelVO.hotelAddrCountrySet.iterator().next().getCountryViewVO().getCountry()}" filterMatchMode="contains"/>
					<p:column rowspan="2" headerText="Region" sortBy="#{hotelVO.hotelAddrRegionSet.iterator().next().getCountryViewVO().getRegionVO().getRegionname()}" filterBy="#{hotelVO.hotelAddrRegionSet.iterator().next().getCountryViewVO().getRegionVO().getRegionname()}" filterMatchMode="contains"/>
				</p:row>
			</p:columnGroup>
			<p:column styleClass="txt_center">
				<p:commandButton icon="ui-icon-pencil" actionListener="#{hotelBean.handleHotelSelect(hotelVO)}" update=":idEditHotelDialog" oncomplete="varEditHotelDialog.show()"/>
			</p:column>
			<p:column styleClass="txt_center">
				<p:commandButton icon="ui-icon-close" actionListener="#{hotelBean.handleHotelSelect(hotelVO)}" oncomplete="varDelHotelDialog.show()"/>
			</p:column>
			<p:column styleClass="txt_center">
				<h:outputText value="#{hotelVO.name}"/>
			</p:column>
			<p:column styleClass="txt_center">
				<h:outputText value="#{hotelVO.starCd}"/>
			</p:column>
			<p:column styleClass="txt_center">
				<h:outputText value="#{hotelVO.hotelAddrCountrySet.iterator().next().getCountryViewVO().getCountry()}"/>
			</p:column>
			<p:column styleClass="txt_center">
				<h:outputText value="#{hotelVO.hotelAddrRegionSet.iterator().next().getCountryViewVO().getRegionVO().getRegionname()}"/>
			</p:column>
		</p:dataTable>
		
		<p:panelGrid columns="2" style="width:1px;">
			<p:commandButton value="Add" oncomplete="varAddHotelDialog.show()" update=":idAddHotelDialog"/>
		</p:panelGrid>
	</h:form>
</p:panel>

<!--
	DIALOG - ADD HOTEL
-->
<p:dialog id="idAddHotelDialog" widgetVar="varAddHotelDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Add Hotel" />
	</f:facet>
	
	<h:form id="idAddHotelForm">
		<ui:include src="add_hotel.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - EDIT HOTEL
-->
<p:dialog id="idEditHotelDialog" widgetVar="varEditHotelDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Edit Hotel" />
	</f:facet>
	
	<h:form id="idEditHotelForm">
		<ui:include src="add_hotel.xhtml" />
	</h:form>
</p:dialog>
	
<!--
	DIALOG - DELETE HOTEL
-->
<p:confirmDialog header="Delete Hotel" widgetVar="varDelHotelDialog" message="Are you sure want to delete this record?" closable="false">
	<h:form>
		<p:growl id="msg"/>
		<p:commandButton value="#{msg['common.button.label.yes']}" actionListener="#{hotelBean.delHotel}" update="@form,:idHotelForm:idHotelList" oncomplete="varDelHotelDialog.hide()"/>
		<p:commandButton value="#{msg['common.button.label.no']}" actionListener="#{hotelBean.resetForm}" oncomplete="varDelHotelDialog.hide()"/>
	</h:form>
</p:confirmDialog>

<!--
	DIALOG - ADD CONTACT
-->
<p:dialog id="idAddContactDialog" widgetVar="varAddContactDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Add Contact" />
	</f:facet>
	
	<h:form id="idAddContactForm">
		<ui:include src="add_contact.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - EDIT CONTACT
-->
<p:dialog id="idEditContactDialog" widgetVar="varEditContactDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Edit Contact" />
	</f:facet>
	
	<h:form id="idEditContactForm">
		<ui:include src="add_contact.xhtml" />
	</h:form>
</p:dialog>
</ui:define>
</ui:composition>