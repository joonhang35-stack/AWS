<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.purchase.vo">

    <class table="EX_ORDER_HOTEL" name="HotelTourVO" polymorphism="explicit">
        <id name="Id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="exOrderId" type="long" column="ID_EO"/>
        <property name="checkInDt" type="timestamp" column="DT_CHK_IN"/>
        <property name="checkOutDt" type="timestamp" column="DT_CHK_OUT"/>
        <property name="totalNight" type="integer" column="TOTAL_NIGHT"/>
        <property name="arrFlight" type="string" column="FLIGHT_ARRIVAL"/>
        <property name="depFlight" type="string" column="FLIGHT_DEP"/>
        <property name="noOfPax" type="string" column="PAX_NO"/>
        <property name="typeOfRoom" type="string" column="ROOM_TYPE"/>
        <property name="mealProvide" type="string" column="MEAL_PROVIDE"/>
        <property name="hotelUsage" type="string" column="HOTEL_USAGE"/>
        <property name="seq" type="integer" column="seq"/>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="STATUS_CD"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>