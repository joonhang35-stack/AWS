<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="bill_list">
	
	<!-- backing bean, extends com.bcs.zsg.component.common.web.swf.bean.AppBackingBean -->
	<var name="billPymtBean" class="com.bcs.zsg.purchase.web.bean.BillPymtBean"/>
	<var name="purchaseEOBean" class="com.bcs.zsg.purchase.web.bean.PurchaseEOBean"/>
	<var name="purchaseBean" class="com.bcs.zsg.purchase.web.bean.PurchaseBean"/>
	<var name="salesBean" class="com.bcs.zsg.sales.web.bean.InvoiceBean"/>
	<var name="journalBean" class="com.bcs.zsg.acct.web.bean.JournalBean"/>
	<var name="acctBean" class="com.bcs.zsg.acct.web.bean.AccountBean"/>
	<var name="salesInvBean" class="com.bcs.zsg.sales.web.bean.InvoiceBean"/>
	
	<view-state id="bill_list">
		<on-entry>
			<evaluate expression="billPymtBean.init()"/>
			<!-- <evaluate expression="purchaseEOBean.initEO('PE')"/> -->
			<evaluate expression="purchaseBean.init(0)"/>
			<evaluate expression="journalBean.init()"/>
			<evaluate expression="acctBean.init(1, false)"/>
			<evaluate expression="salesInvBean.initPopUp()"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>