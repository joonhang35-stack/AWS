<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
				xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">  			

<style>
.tourDepListClass .ui-datatable th div.ui-dt-c,
.tourDepListClass .ui-datatable .ui-datatable-data td div.ui-dt-c {
	padding: 4px 0px; 
	font-size: 10px; 
	text-align: center;
}

.tourDepListClass .ui-state-highlight,
.tourDepListClass .ui-widget-content .ui-state-highlight {
	border: 3px solid red;
	background: #7ddbfe !important;
}

.tourDepSearchClass .ui-panelgrid td {
    padding: 4px 4px;
}

.ui-tooltip {
	max-width: 600px;
}
</style>

<h:panelGrid columns="3" style="width:1px;">
	<!-- <p:commandButton value="Add" actionListener="#{tourPkgBean.handleAddTourDepSelect}" update=":idAddTourDepDialog" action="REDIRECT_TO_DEP_DETAIL" process="@this"/> -->
	<p:commandButton value="Add" actionListener="#{tourPkgBean.handleAddTourDepSelect}" update=":idAddTourDepDialog" oncomplete="varAddTourDepDialog.show()" process="@this"/>
	<p:commandButton value="Cancel" onclick="varTourDepListDialog.hide()" rendered="#{tourPkgBean.tourPkgDepFilter eq 'N'}" process="@this"/>
	<p:commandButton value="Cancel" actionListener="#{tourPkgBean.resetForm}" oncomplete="varTourDepListDialog.hide()" process="@this" update="idTourDepListForm"
		rendered="#{tourPkgBean.tourPkgDepFilter eq 'Y'}">
		<pe:resetEditableValues for="idTourDepListForm" />
	</p:commandButton>
	<!-- <h:commandLink value="Export" styleClass="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-icon-left ui-button-text" style="padding: .5em 1em;">  
        <p:dataExporter type="xls" target="idTourDepList" fileName="TourDeparture" postProcessor="#{tourPkgBean.postProcessXLS}"/>  
    </h:commandLink> -->
    <p:commandButton icon="ui-icon-print" value="Export" actionListener="#{tourPkgBean.printTourDepListRpt}" ajax="false"/>
</h:panelGrid>
<div class="tourDepSearchClass">
<p:panelGrid id="idTourDepSearch" rendered="#{tourPkgBean.tourPkgDepFilter eq 'Y'}" style="width: 1300px;">
	<p:row>
		<p:column style="width:65px;"><p:outputLabel style="display:block;">From Date</p:outputLabel></p:column>
		<p:column style="width:130px;">
			<p:calendar value="#{tourPkgBean.searchTourDep.fromDate}" pattern="#{config['date.display.pattern']}" readonlyInput="true"
		    	navigator="true" display="inline" size="10" mindate="today" showOn="button">
		    	<p:ajax event="dateSelect" listener="#{tourPkgBean.handleDepFromDateSelect}" process="@this" update="idSearchToDate" global="false" />
		    </p:calendar>
		</p:column>
		<p:column style="width:50px;"><p:outputLabel style="display:block;">To Date</p:outputLabel></p:column>
		<p:column style="width:130px;">
		    <p:calendar id="idSearchToDate" value="#{tourPkgBean.searchTourDep.toDate}" pattern="#{config['date.display.pattern']}" readonlyInput="true"
		    	navigator="true" display="inline" size="10" mindate="today" showOn="button">
		    </p:calendar>
		</p:column>
		<p:column style="width:120px;">
			<p:selectOneMenu id="idSearchTourPkgDailyCms" value="#{tourPkgBean.searchTourDep.tourPkgDailyCms}" style="width:120px;">
				<f:selectItem itemLabel="Select Itinerary" />
				<f:selectItems value="#{tourPkgBean.tourPkgVO.tourPkgDailyItineraryVOList}"
					var="ivo" itemValue="#{ivo.id}" itemLabel="#{ivo.code} - #{ivo.title}" />
			</p:selectOneMenu>
		</p:column>
		<p:column style="width:150px;">
			<p:selectCheckboxMenu value="#{tourPkgBean.searchTourDep.departDateBadgeList}" label="Depart date badge" style="width:150px; display:block;" >
				<f:selectItems value="#{bterp:lookupItemList('depart_date_badge')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
			</p:selectCheckboxMenu>
		</p:column>
		<p:column style="width:100px;">
			<p:selectCheckboxMenu value="#{tourPkgBean.searchTourDep.selectedSeason}" label="Season" style="width:100px; display:block;" >
				<f:selectItems value="#{tourPkgBean.refDataListSeason}" var="vo" itemLabel="#{vo.value}" itemValue="#{vo.code}" />
			</p:selectCheckboxMenu>
		</p:column>
		<p:column style="width:120px;">
			<p:selectOneMenu id="idSearchLangCode" value="#{tourPkgBean.searchTourDep.langCode}">
				<f:selectItem itemLabel="Select Language" />
				<f:selectItems value="#{bterp:lookupItemList('product_lang')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
			</p:selectOneMenu>
		</p:column>
		<p:column style="width:120px;">
			<p:selectOneMenu id="idTourStatusCode" value="#{tourPkgBean.searchTourDep.tourStatusCd}">
				<f:selectItem itemLabel="Select Status" />
				<f:selectItems value="#{bterp:lookupItemList('tour_status')}" var="statusVO" itemValue="#{statusVO.code}" itemLabel="#{statusVO.description}"/>
			</p:selectOneMenu>
		</p:column>
		<p:column>
			<p:commandButton value="Search" actionListener="#{tourPkgBean.reloadTourDepListBySearch}" update="idTourDepList"/>
			<p:commandButton value="Clear" actionListener="#{tourPkgBean.resetSearchTourDepForm}" process="@this" update="@form">
				<pe:resetEditableValues for="idTourDepListForm" />
			</p:commandButton>
		</p:column>
	</p:row>
</p:panelGrid>
</div>
<div class="tourDepListClass">
<p:dataTable id="idTourDepList" value="#{tourPkgBean.tourDepList}" var="vo" rowStyleClass="#{vo.groupColor eq 0 ? 'group-color-one' : 'group-color-two'}"
	rowKey="#{vo.id}" selectionMode="single">
	<f:facet name="header">
		<h:panelGrid columns="1">
			<h:outputText value="#{tourPkgBean.tourPkgVO.nameEn}"/>
			<h:outputText value="#{tourPkgBean.tourPkgVO.nameOther}" rendered="#{not empty tourPkgBean.tourPkgVO.nameOther}"/>
			<h:outputText value="#{tourPkgBean.tourPkgVO.nameZh}" rendered="#{not empty tourPkgBean.tourPkgVO.nameZh}"/>
			<h:panelGroup layout="block">
				<h:outputText value="Sector Type: #{tourPkgBean.tourPkgVO.tourPkgCountryVO.regionName} / " rendered="#{not empty tourPkgBean.tourPkgVO.tourPkgCountryVO.regionName}"/>
				<h:outputText value="Sector: #{tourPkgBean.tourPkgVO.tourPkgCountryVO.countryName} / " rendered="#{not empty tourPkgBean.tourPkgVO.tourPkgCountryVO.countryName}"/>
				<h:outputText value="Location Tag: #{tourPkgBean.tourPkgVO.tourPkgCountryVO.cityName}" rendered="#{not empty tourPkgBean.tourPkgVO.tourPkgCountryVO.cityName}"/>
			</h:panelGroup>
		</h:panelGrid>
	</f:facet>
	
	<p:columnGroup type="header">
		<p:row>
			<p:column rowspan="2" headerText="Function" style="width:60px;"/>
			<!-- <p:column rowspan="2" headerText="Seq No" style="width:40px;"/> -->
			<p:column rowspan="2" headerText="Dep Date" style="width:100px;"/>
			<p:column rowspan="2" headerText="Status" style="width:60px;"/>
			<p:column rowspan="2" headerText="Tour Code" style="width:130px;"/>
			<p:column rowspan="2" headerText="Tour Package Name" style="width:160px;"/>
			<p:column rowspan="2" headerText="Airline" style="width:40px;"/>
			<p:column colspan="2" headerText="Discount Level"/>
			<p:column colspan="9" headerText="Seat Allotment"/>
			<p:column colspan="2" headerText="Adult (RM)"/>
			<p:column colspan="3" headerText="Child (RM)"/>
			<p:column rowspan="2" headerText="Misc&lt;br/&gt;Adt/Chd" style="width:80px;"/>
			<p:column rowspan="2" headerText="Normal&lt;br/&gt;AC/SI" style="width:70px;"/>
			<p:column rowspan="2" headerText="More&lt;br/&gt;Info" style="width:30px;"/>
		</p:row>
		<p:row>
			<p:column headerText="Level 1" style="width:50px;"/>
			<p:column headerText="Level 2" style="width:50px;"/>
			<p:column headerText="HK&lt;br/&gt;Seat" style="width:30px;"/>
			<p:column headerText="TFair&lt;br/&gt;Pax" style="width:30px;"/>
			<p:column headerText="AGT&lt;br/&gt;Pax" style="width:30px;"/>
			<p:column headerText="In-Hs&lt;br/&gt;Pax" style="width:30px;"/>
			<p:column headerText="On9&lt;br/&gt;Pax" style="width:30px;"/>
			<p:column headerText="KIV&lt;br/&gt;Pax" style="width:30px;"/>
			<p:column headerText="Total&lt;br/&gt;Sold" style="width:30px;"/>
			<p:column headerText="Bal&lt;br/&gt;Seat" style="width:30px;"/>
			<p:column headerText="GA" style="width:30px;"/>
			<p:column headerText="TWN" style="width:55px;"/>
			<p:column headerText="SGL" style="width:55px;"/>
			<p:column headerText="CTW" style="width:55px;"/>
			<p:column headerText="CWB" style="width:55px;"/>
			<p:column headerText="CNB" style="width:55px;"/>
		</p:row>
	</p:columnGroup>
	
	<p:column style="width:60px;">
		<p:splitButton icon="ui-icon-pencil" actionListener="#{tourPkgBean.handleTourDepSelect(vo)}" update=":idEditTourDepDialog" oncomplete="varEditTourDepDialog.show()" process="@this">
			<p:menuitem value="Clone" icon="ui-icon-plus" actionListener="#{tourPkgBean.setTourDepVO(vo)}" oncomplete="varCloneTourDepDialog.show()" process="@this"/>
			<p:menuitem value="Delete" icon="ui-icon-close" actionListener="#{tourPkgBean.setTourDepVO(vo)}" oncomplete="varDelTourDepDialog.show()" process="@this"/>
			<p:menuitem value="Send Email" icon="ui-icon-mail-closed" actionListener="#{tourPkgBean.handleSendEmail(vo)}" oncomplete="varSendEmailDialog.show()" process="@this" rendered="#{vo.tourStatusCd eq 'N'}"/>
		</p:splitButton>
		<p:outputPanel style="vertical-align:middle; display:inline-block;" rendered="#{not vo.isPushToOnline}">
			<p:graphicImage id="idTooltipOffline" value="/img/offline.png" width="20" height="20"/>
			<pe:tooltip for="idTooltipOffline" rendered="#{not vo.isPushToOnline}">
				<h:outputText value="Offline"/>
			</pe:tooltip>
		</p:outputPanel>
	</p:column>
	<!-- <p:column style="width:40px;">
		<h:outputText value="#{vo.seqNo}"/>
	</p:column> -->
	<p:column style="width:100px;">
		<h:outputText value="#{vo.dtDep}"><f:convertDateTime pattern="#{config['date.display.pattern2']}"/></h:outputText>
		<ui:repeat value="#{vo.departDateBadgeList}" var="badgeVO">
			<h:outputText id="idTooltipBadge" value="#{badgeVO}"
				style="display:inline-block; background:white; #{not empty vo.departDateBadgeList and vo.departDateBadgeList.contains('DISCx2') ? 'color:red; border:1px solid red;' : 'color:green; border:1px solid green;'} border-radius: 5px; padding:2px; margin:2px;"
				rendered="#{not empty vo.departDateBadgeList}"/>
			<pe:tooltip for="idTooltipBadge" rendered="#{not empty badgeVO}">
				<h:outputText value="#{bterp:lookupItemDesc('depart_date_badge', badgeVO)}"/>
			</pe:tooltip>
		</ui:repeat>
		<h:outputText id="idTooltipLangCode" rendered="#{not empty vo.langCode}" style="display:inline-block; background:#{vo.langCode eq 'BM' ? 'green' : 'white'}; color:#{vo.langCode eq 'BM' ? 'white' : 'green'}; border:1px solid green; border-radius: 5px; padding:2px; margin:2px;"
			value="#{vo.langCode}"/>
		<pe:tooltip for="idTooltipLangCode" rendered="#{not empty vo.langCode}">
			<h:outputText value="#{bterp:lookupItemDesc('product_lang', vo.langCode)}"/>
		</pe:tooltip>
	</p:column>
	<p:column style="width:60px;">
		<p:outputPanel layout="block">
			<h:outputText id="idTooltipPricing" value="#{bterp:lookupItemDesc('tour_status', vo.tourStatusCd)}" rendered="#{vo.tourStatusCd eq 'A' or vo.tourStatusCd eq 'L'}"/>
			<h:outputText value="Full" style="text-transform:uppercase; color:#F00;" rendered="#{vo.tourStatusCd eq 'F'}"/>
			<h:outputText value="#{bterp:lookupItemDesc('tour_status', vo.tourStatusCd)}" style="text-transform:uppercase; color:#F00;"
				rendered="#{vo.tourStatusCd eq 'I' or vo.tourStatusCd eq 'C' or vo.tourStatusCd eq 'N' or vo.tourStatusCd eq 'R' or vo.tourStatusCd eq 'C1'}"/>
			<h:outputText value="#{bterp:lookupItemDesc('tour_status', vo.tourStatusCd)}"
			 	style="text-transform:uppercase; color:#F00;"
				rendered="#{vo.tourStatusCd ne 'A' and vo.tourStatusCd ne 'L' and vo.tourStatusCd ne 'F'
						and vo.tourStatusCd ne 'I' and vo.tourStatusCd ne 'C' and vo.tourStatusCd ne 'N'
						and vo.tourStatusCd ne 'R' and vo.tourStatusCd ne 'C1'}"/>
			<p:graphicImage id="idTooltipStatusReason" value="/img/more.png" width="11" style="margin-left: 3px;" rendered="#{not empty vo.tourStatusReason}"/>
		</p:outputPanel>
		<pe:tooltip for="idTooltipStatusReason" shared="true" showDelay="0" myPosition="left center" atPosition="right center"
			rendered="#{not empty vo.tourStatusReason}">
			<h:outputText value="#{vo.tourStatusReason}" escape="true" style="white-space: pre-wrap"/>
		</pe:tooltip>
		<pe:tooltip for="idTooltipPricing" shared="true" showDelay="0" myPosition="left center" atPosition="right center">
			<!-- <p:outputLabel value="#{salesBean.getCalculatedAmount(vo)}" style="white-space: pre-wrap"/> -->
            TWN=<span style="font-weight: bold;">#{tourPkgBean.getDoubleDecimalFormat(((vo.fullTwn + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullTwn + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullTwn + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullTwn + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
			<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
			&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            SGL=<span style="font-weight: bold;">#{tourPkgBean.getDoubleDecimalFormat(((vo.fullSgl + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullSgl + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullSgl + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullSgl + vo.miscAdt - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
			<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
			<br/>
            CTW=<span style="font-weight: bold;">#{tourPkgBean.getDoubleDecimalFormat(((vo.fullCtw + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCtw + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullCtw + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCtw + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
			<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
			&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            CWB=<span style="font-weight: bold;">#{tourPkgBean.getDoubleDecimalFormat(((vo.fullCeb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCeb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullCeb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCeb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
			<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
			&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            CNB=<span style="font-weight: bold;">#{tourPkgBean.getDoubleDecimalFormat(((vo.fullCnb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCnb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) % 1 &gt; 0 ? '#,##0.00' : '#,##0', ((vo.fullCnb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))) lt 0) ? 0 : (vo.fullCnb + vo.miscChd - (vo.discountPax1 > 0 ? vo.discount1 : (vo.discountPax2 > 0 ? vo.discount2 : 0))))}</span>
			<span style="color:#F00;">#{(vo.discountPax1 > 0 or vo.discountPax2 > 0) ? (vo.discountPax1 > 0 ? '('.concat(vo.discountPax1).concat(')') : '('.concat(vo.discountPax2).concat(')')) : ''}</span>
			<br/><br/>
			<span style="font-weight: bold;">Deposit #{tourPkgBean.getDoubleDecimalFormat('#,##0', vo.deposit)}</span> per pax 
			<h:outputLabel style="font-size:11px; color:#F00;" rendered="#{(vo.discountPax1 gt 0 and vo.discount1 gt 0) or (vo.discountPax2 gt 0 and vo.discount2 gt 0)}">
				<br/><br/>
				Noted: Above price is <b>Grand Total include Discount (If has)</b>
			</h:outputLabel>
		</pe:tooltip>
	</p:column>
	<p:column style="width:130px;">
		<p:commandLink actionListener="#{tourPkgBean.handleShowEOList(vo)}" update=":idEODetailsDialog" oncomplete="varEODetailsDialog.show()" style="color:#CC2EFA;" process="@this">
			<h:outputText value="#{vo.code} "/>
		</p:commandLink>
		<h:outputText id="idTooltipLock" class="fa fa-lock" rendered="#{vo.isLock}" style="margin-left: 3px;"/>
		<pe:tooltip for="idTooltipLock" rendered="#{vo.isLock}">
			<h:outputText value="Invoice Locked"/>
		</pe:tooltip>
		<h:outputText id="idTooltipPrivate" class="fa fa-user" rendered="#{vo.isPrivateTour}" style="margin-left: 3px;"/>
		<pe:tooltip for="idTooltipPrivate" rendered="#{vo.isPrivateTour}">
			<h:outputText value="Private Tour"/>
		</pe:tooltip>
	</p:column>
	<p:column style="width:160px;">
		<p:commandLink actionListener="#{tourPkgBean.handleShowBookingList(vo)}" oncomplete="varBookingListDialog.show()" update=":idBookingListDialog" style="color:#CC2EFA;" process="@this">
			<h:outputText value="#{vo.duration}" rendered="false"/>
			<h:outputText value="PD " rendered="#{vo.isDepositPaid}"/><h:outputText value="#{vo.numDays}D/#{vo.numNights}N "/><h:outputText value="[#{vo.desc}]" style="color:#FF0000;" rendered="#{not empty vo.desc}"/>
			<h:outputText value="[#{vo.prn}]" style="color:#0040FF;" rendered="#{not empty vo.prn}"/><h:outputText value="[S]" style="font-weight:bold; color:#{vo.isIssuedS ? '#FF0000' : '#638604'}" rendered="#{vo.travelInsS}"/><h:outputText value="[F]" style="font-weight:bold; color:#{vo.isIssuedF ? '#FF0000' : '#638604'}" rendered="#{vo.travelInsF}"/><h:outputText value="[#{vo.dailyCode}]" style="color:#000000;"  rendered="#{not empty vo.dailyCode}"/>
			<p:graphicImage value="/img/push.gif" rendered="#{vo.isPush and (vo.tourStatusCd eq 'A' or vo.tourStatusCd eq 'L')}"/>
		</p:commandLink>
	</p:column>
	<p:column style="width:40px;">
		<p:commandLink actionListener="#{tourPkgBean.handleTourDepSelect(vo)}" oncomplete="varTourDepAirlineInfoDialog.show()" update=":idTourDepAirlineInfoDialog" style="color:#CC2EFA;" process="@this">
			<h:outputText value="#{vo.airlineCode}"/>
		</p:commandLink>
	</p:column>
	<p:column style="width:50px;">
		<h:outputText value="#{vo.discount1 gt 0 ? vo.discount1 * -1 : vo.discount1}" rendered="#{vo.discount1 % 1 &gt; 0}" style="#{not empty vo.departDateBadgeList and vo.departDateBadgeList.contains('DISCx2') ? 'color: red; font-weight:bold;' : ''}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.discount1 gt 0 ? vo.discount1 * -1 : vo.discount1}" rendered="#{vo.discount1 % 1 &lt;= 0}" style="#{not empty vo.departDateBadgeList and vo.departDateBadgeList.contains('DISCx2') ? 'color: red; font-weight:bold;' : ''}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
		<h:outputText value=" (#{vo.discountPax1})" style="color: red;"/>
	</p:column>
	<p:column style="width:50px;">
		<h:outputText value="#{vo.discount2 gt 0 ? vo.discount2 * -1 : vo.discount2}" rendered="#{vo.discount2 % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.discount2 gt 0 ? vo.discount2 * -1 : vo.discount2}" rendered="#{vo.discount2 % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
		<h:outputText value=" (#{vo.discountPax2})" style="color: red;"/>
	</p:column>
	<p:column style="width:30px;">
		<h:outputText value="#{vo.seatAllot}"/>
	</p:column>
	<p:column style="width:30px;">
		<h:outputText value="#{vo.tfairPax}"/>
	</p:column>
	<p:column style="width:30px;">
		<h:outputText value="#{vo.agentPax}"/>
	</p:column>
	<p:column style="width:30px;">
		<h:outputText value="#{vo.inHsePax}"/>
	</p:column>
	<p:column style="width:30px;">
		<h:outputText value="#{vo.on9BookingPax}"/>
	</p:column>
	<p:column style="width:30px;">
		<h:outputText value="#{vo.kivPax}"/>
	</p:column>
	<p:column style="width:30px; font-size:10px; background:#00BFFF; text-align:center;">
		<h:outputText value="#{vo.tfairPax + vo.agentPax + vo.inHsePax + vo.kivPax + vo.on9BookingPax}"/>
	</p:column>
	<p:column style="width:30px;">
		<h:outputText value="#{vo.seatAllot - vo.reservedSeat - vo.tourManagerPax - (vo.tfairPax + vo.agentPax + vo.inHsePax + vo.kivPax + vo.on9BookingPax)}" style="#{(vo.seatAllot - vo.reservedSeat - vo.tourManagerPax - (vo.tfairPax + vo.agentPax + vo.inHsePax + vo.kivPax + vo.on9BookingPax)) eq 0 ? 'color:#f00; font-weight:bold;' : ''}"/>
	</p:column>
	<p:column style="width:30px;">
		<h:outputText value="#{vo.totalGA}"/>
	</p:column>
	<p:column style="width:55px;">
		<h:outputText value="#{vo.fullTwn}" rendered="#{vo.fullTwn % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.fullTwn}" rendered="#{vo.fullTwn % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:55px;">
		<h:outputText value="#{vo.fullSgl}" rendered="#{vo.fullSgl % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.fullSgl}" rendered="#{vo.fullSgl % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:55px;">
		<h:outputText value="#{vo.fullCtw}" rendered="#{vo.fullCtw % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.fullCtw}" rendered="#{vo.fullCtw % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:55px;">
		<h:outputText value="#{vo.fullCeb}" rendered="#{vo.fullCeb % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.fullCeb}" rendered="#{vo.fullCeb % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:55px;">
		<h:outputText value="#{vo.fullCnb}" rendered="#{vo.fullCnb % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.fullCnb}" rendered="#{vo.fullCnb % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:80px;">
		<h:outputText value="#{vo.miscAdt}" rendered="#{vo.miscAdt % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/></h:outputText><h:outputText value="/" rendered="#{vo.miscAdt % 1 &gt; 0}"/><h:outputText value="#{vo.miscChd}" rendered="#{vo.miscChd % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.miscAdt}" rendered="#{vo.miscAdt % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/></h:outputText><h:outputText value="/" rendered="#{vo.miscAdt % 1 &lt;= 0}"/><h:outputText value="#{vo.miscChd}" rendered="#{vo.miscChd % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:70px;">
		<h:outputText value="#{vo.cnaAdt}" rendered="#{vo.cnaAdt % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText><h:outputText value="/" rendered="#{vo.cnaAdt % 1 &gt; 0}"/><h:outputText value="#{vo.csiAdt}" rendered="#{vo.csiAdt % 1 &gt; 0}"> <f:convertNumber pattern="#,##0.00"/> </h:outputText>
		<h:outputText value="#{vo.cnaAdt}" rendered="#{vo.cnaAdt % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText><h:outputText value="/" rendered="#{vo.cnaAdt % 1 &lt;= 0}"/><h:outputText value="#{vo.csiAdt}" rendered="#{vo.csiAdt % 1 &lt;= 0}"> <f:convertNumber pattern="#,##0"/> </h:outputText>
	</p:column>
	<p:column style="width:30px;">
		<p:commandLink actionListener="#{tourPkgBean.handleTourDepSelect(vo)}" oncomplete="varTourDepMoreInfoDialog.show()" update=":idTourDepMoreInfoDialog" process="@this">
			<p:graphicImage value="/img/more.png"/>
		</p:commandLink>
	</p:column>
</p:dataTable>
<!--/div-->
</div>
<h:panelGrid columns="3" style="width:1px;">
	<p:commandButton value="Add" actionListener="#{tourPkgBean.handleAddTourDepSelect}" update=":idAddTourDepForm" oncomplete="varAddTourDepDialog.show()" process="@this"/>
	<p:commandButton value="Cancel" onclick="varTourDepListDialog.hide()" rendered="#{tourPkgBean.tourPkgDepFilter eq 'N'}" process="@this"/>
	<p:commandButton value="Cancel" actionListener="#{tourPkgBean.resetForm}" oncomplete="varTourDepListDialog.hide()" process="@this" update="idTourDepListForm"
		rendered="#{tourPkgBean.tourPkgDepFilter eq 'Y'}">
		<pe:resetEditableValues for="idTourDepListForm" />
	</p:commandButton>
	<!-- <h:commandLink value="Export" styleClass="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-icon-left ui-button-text" style="padding: .5em 1em;">  
        <p:dataExporter type="xls" target="idTourDepList" fileName="TourDeparture" excludeColumns="0,1,2" postProcessor="#{tourPkgBean.postProcessXLS}"/>  
    </h:commandLink>  -->
    <p:commandButton icon="ui-icon-print" value="Export" actionListener="#{tourPkgBean.printTourDepListRpt}" ajax="false"/>
</h:panelGrid>


</ui:composition>