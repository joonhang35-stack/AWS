	public String getSurveyDesc() {
		String surveyDesc = "";
		if (CollectionUtils.isEmpty(this.idSurveyList)) {
			return surveyDesc;
		}

		int i = 0;
		for (String idSurvey : idSurveyList) {
			if (i != 0)
				surveyDesc = surveyDesc + ", ";

			surveyDesc = surveyDesc + idSurvey;
			i++;
		}

		return surveyDesc;
	}

