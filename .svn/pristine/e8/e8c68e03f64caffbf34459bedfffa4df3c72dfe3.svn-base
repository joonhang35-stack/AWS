	/**
	 * Printing Trial Balance
	 */
	public void printTrialBalance(String xlsOrPDf) {
		try {
			trackingLogUtils.startLogs();
			
			getFinancialPeriod();
			
			HashMap<String, Object> map = reportTitle();
			map.put("fromDate", (Date) searchParamVO.getObj2());
			map.put("toDate", (Date) searchParamVO.getObj3());
			
			List<AcctViewVO> trialBalanceList = chartOfAcctBO.getTrialBalanceList(getSessionInfoBean().getCompanyVO().getId(), searchParamVO);
			
			BigDecimal amt = new BigDecimal("0.00");
			for (AcctViewVO vo : trialBalanceList) {
				amt = new BigDecimal(vo.getDebitCurrBal().toString()).subtract(new BigDecimal(vo.getCreditCurrBal().toString()));
				if (amt.compareTo(BigDecimal.ZERO) < 0) {
					vo.setDebitCurrBal(0.0);
					vo.setCreditCurrBal(-1 * amt.doubleValue());
				} else {
					vo.setDebitCurrBal(amt.doubleValue());
					vo.setCreditCurrBal(0.0);
				}
			}
			
			String jasperFileName = CommonConstant.JAS_RPT_TRL_BAL;
			String reportName = CommonConstant.PDF_RPT_TRL_BAL;

			JasperPrint jasperPrint = ReportUtils.getJasperPrint(trialBalanceList, map, jasperFileName);
			if (xlsOrPDf.equals("PDF")) {
				ReportUtils.printReport(jasperPrint, reportName);
			} else {
				ReportUtils.printReportExcel(jasperPrint, reportName);
			}
			
			FacesContext.getCurrentInstance().getExternalContext().addResponseCookie(
					"cookie.pdf.exporting", "true", Collections.<String, Object>emptyMap());
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("printTrialBalance");
		}
	}
	
	/**
	 * Printing Trial Balance - Year To Date
	 */
	public void printTrialBalanceYearDate(String xlsOrPDf) {
		try {
			trackingLogUtils.startLogs();
			
			getFinancialPeriod();
			
			HashMap<String, Object> map = reportTitle();
			map.put("fromDate", (Date) searchParamVO.getObj2());
			map.put("toDate", (Date) searchParamVO.getObj3());
			
			List<AcctViewVO> trialBalanceList = chartOfAcctBO.getTrialBalanceListYear(getSessionInfoBean().getCompanyVO().getId(), searchParamVO);
			
			BigDecimal amtSlted = new BigDecimal("0.00");
			BigDecimal amtYear = new BigDecimal("0.00");
			for (AcctViewVO vo : trialBalanceList) {
				amtSlted = new BigDecimal(vo.getDebitCurrBal().toString()).subtract(new BigDecimal(vo.getCreditCurrBal().toString()));
				if (amtSlted.compareTo(BigDecimal.ZERO) < 0) {
					vo.setDebitCurrBal(0.0);
					vo.setCreditCurrBal(-1 * amtSlted.doubleValue());
				} else {
					vo.setDebitCurrBal(amtSlted.doubleValue());
					vo.setCreditCurrBal(0.0);
				}
				amtYear = new BigDecimal(vo.getDebitBeginBal().toString()).subtract(new BigDecimal(vo.getCreditBeginBal().toString()));
				if (amtYear.compareTo(BigDecimal.ZERO) < 0) {
					vo.setDebitBeginBal(0.0);
					vo.setCreditBeginBal(-1 * amtYear.doubleValue());
				} else {
					vo.setDebitBeginBal(amtYear.doubleValue());
					vo.setCreditBeginBal(0.0);
				}
			}
			
			String jasperFileName = CommonConstant.JAS_RPT_TRL_BAL_YR_TO_DT;
			String reportName = CommonConstant.PDF_RPT_TRL_BAL_YR_TO_DT;

			JasperPrint jasperPrint = ReportUtils.getJasperPrint(trialBalanceList, map, jasperFileName);
			if (xlsOrPDf.equals("PDF")) {
				ReportUtils.printReport(jasperPrint, reportName);
			} else {
				ReportUtils.printReportExcel(jasperPrint, reportName);
			}
			
			FacesContext.getCurrentInstance().getExternalContext().addResponseCookie(
					"cookie.pdf.exporting", "true", Collections.<String, Object>emptyMap());
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("printTrialBalanceYearDate");
		}
	}
	
	/**
	 * Printing Balance Sheet - Audit
	 */
	public void printBalanceSheetAudit(String xlsOrPDf) {
		try {
			trackingLogUtils.startLogs();
			
			getFinancialPeriod();
			
			HashMap<String, Object> mapBS = reportTitle();
			mapBS.put("fromDate", (Date) searchParamVO.getObj2());
			mapBS.put("toDate", (Date) searchParamVO.getObj3());
			
			List<AcctViewVO> balanceSheetList = chartOfAcctBO.getBalanceSheetList(getSessionInfoBean().getCompanyVO().getId(), searchParamVO);
			
			BigDecimal assets = new BigDecimal("0.00");
			BigDecimal currAssets = new BigDecimal("0.00");
			BigDecimal liabilities = new BigDecimal("0.00");
			BigDecimal equity = new BigDecimal("0.00");
			BigDecimal netCrrAssetsLiabilities = new BigDecimal("0.00");
			BigDecimal assetsLessLiabilities = new BigDecimal("0.00");
			for (AcctViewVO vo : balanceSheetList) {
				if (vo.getAcctCatCode().equals("L") || vo.getAcctCatCode().equals("E")) {
					if (new BigDecimal(vo.getDebitCurrBal()).compareTo(BigDecimal.ZERO) != 0) {
						vo.setDebitCurrBal(-1 * vo.getDebitCurrBal());
					}
					if (vo.getAcctCatCode().equals("L")) {
						liabilities = liabilities.add(new BigDecimal(new DecimalFormat("#0.00").format(vo.getDebitCurrBal())));
					} else {
						equity = equity.add(new BigDecimal(new DecimalFormat("#0.00").format(vo.getDebitCurrBal())));
					}
				}
				if (vo.getAcctCatCode().equals("A")) {
					if (new BigDecimal(vo.getCreditCurrBal()).compareTo(BigDecimal.ZERO) != 0) {
						vo.setCreditCurrBal(-1 * vo.getCreditCurrBal());
					}
					assets = assets.add(new BigDecimal(new DecimalFormat("#0.00").format(vo.getDebitCurrBal())));
					assets = assets.subtract(new BigDecimal(new DecimalFormat("#0.00").format(vo.getCreditCurrBal())));
					if (vo.getAcctSubCatCode().equals("CA")) {
						currAssets = currAssets.add(new BigDecimal(new DecimalFormat("#0.00").format(vo.getDebitCurrBal())));
					}
				}
			}
			netCrrAssetsLiabilities = currAssets.subtract(liabilities);
			assetsLessLiabilities = assets.subtract(liabilities);
			mapBS.put("netCrrAssetsLiabilities", netCrrAssetsLiabilities);
			mapBS.put("assetsLessLiabilities", assetsLessLiabilities);
			
			HashMap<String, Object> mapDTLs = reportTitle();
			mapDTLs.put("fromDate", (Date) searchParamVO.getObj2());
			mapDTLs.put("toDate", (Date) searchParamVO.getObj3());
			
			List<AcctViewVO> trialBalanceDetailsList = chartOfAcctBO.getBalanceSheetDetailsList(getSessionInfoBean().getCompanyVO().getId(), searchParamVO);
			
			assets = new BigDecimal("0.00");
			liabilities = new BigDecimal("0.00");
			equity = new BigDecimal("0.00");
			assetsLessLiabilities = new BigDecimal("0.00");
			AcctViewVO equityVO = new AcctViewVO();
			int count = 0;
			for (AcctViewVO vo : trialBalanceDetailsList) {
				if (vo.getAcctCatCode().equals("L") || vo.getAcctCatCode().equals("E")) {
					if (new BigDecimal(vo.getDebitCurrBal()).compareTo(BigDecimal.ZERO) != 0) {
						vo.setDebitCurrBal(-1 * vo.getDebitCurrBal());
					}
					if (vo.getAcctCatCode().equals("L")) {
						liabilities = liabilities.add(new BigDecimal(new DecimalFormat("#0.00").format(vo.getDebitCurrBal())));
					} else {
						equity = equity.add(new BigDecimal(new DecimalFormat("#0.00").format(vo.getDebitCurrBal())));
					}
				}
				if (vo.getAcctCatCode().equals("A")) {
					assets = assets.add(new BigDecimal(new DecimalFormat("#0.00").format(vo.getDebitCurrBal())));
				}
				if (vo.getAcctCatCode().equals("E")) {
					if (count == 0) {
						equityVO.setIdCompany(vo.getIdCompany());
						equityVO.setIdAcctCat(vo.getIdAcctCat());
						equityVO.setAcctCatDesc(vo.getAcctCatDesc());
						equityVO.setAcctCatCode(vo.getAcctCatCode());
						equityVO.setIdAcctSubCat(vo.getIdAcctSubCat());
						equityVO.setAcctSubCatDesc(vo.getAcctSubCatDesc());
						equityVO.setCode(vo.getCode());
						equityVO.setSubCode("");
						equityVO.setDesc(vo.getDesc());
						equityVO.setSubDesc("");
						equityVO.setDebitCurrBal(0.00);
						equityVO.setGroup(vo.getGroup());
						equityVO.setStatusCode(vo.getStatusCode());
						count++;
					}
				}
			}
			
			assetsLessLiabilities = assets.subtract(liabilities);
			mapDTLs.put("assetsLessLiabilities", assetsLessLiabilities);
			
			List<AcctViewVO> trdgPftLssList = chartOfAcctBO.getTrdgPftLssList(getSessionInfoBean().getCompanyVO().getId(), searchParamVO);
			
			BigDecimal expanses = new BigDecimal("0.00");
			BigDecimal grossMargin = new BigDecimal("0.00");
			BigDecimal netProfitLoss = new BigDecimal("0.00");
			for (AcctViewVO vo : trdgPftLssList) {
				if (vo.getAcctCatCode().equals("I") || vo.getAcctCatCode().equals("OI")) {
					if (new BigDecimal(vo.getDebitCurrBal()).compareTo(BigDecimal.ZERO) != 0) {
						vo.setDebitCurrBal(-1 * vo.getDebitCurrBal());
					}
					grossMargin = grossMargin.add(new BigDecimal(new DecimalFormat("#0.00").format(vo.getDebitCurrBal())));
				} else if (vo.getAcctCatCode().equals("P")) {
					grossMargin = grossMargin.subtract(new BigDecimal(new DecimalFormat("#0.00").format(vo.getDebitCurrBal())));
				}
				if (vo.getAcctCatCode().equals("X")) {
					expanses = expanses.add(new BigDecimal(new DecimalFormat("#0.00").format(vo.getDebitCurrBal())));
				}
			}
			netProfitLoss = grossMargin.subtract(expanses);
			equityVO.setDebitCurrBal(netProfitLoss.doubleValue());
			
			// Net Profit for Details
			equityVO.setIdAcctSubCat(new Long(9999));
			equityVO.setAcctSubCatDesc("UNDISTRIBUTED INCOME");
			equityVO.setCode("XXXX");
			equityVO.setSubCode("XXXX");
			equityVO.setDesc("NET PROFIT / (LOSS) FOR THE PERIOD");
			equityVO.setSubDesc("");
			balanceSheetList.add(equityVO);
			
			String jasperFileNameBS = CommonConstant.JAS_RPT_BAL_SHEET_AUDIT;
			String reportNameBS = CommonConstant.PDF_RPT_BAL_SHEET_AUDIT;
			
			JasperPrint jasperPrintBS = ReportUtils.getJasperPrint(balanceSheetList, mapBS, jasperFileNameBS);
			if (xlsOrPDf.equals("PDF")) {
				ReportUtils.printReport(jasperPrintBS, reportNameBS);
			} else {
				ReportUtils.printReportExcel(jasperPrintBS, reportNameBS);
			}
			
			FacesContext.getCurrentInstance().getExternalContext().addResponseCookie(
					"cookie.pdf.exporting", "true", Collections.<String, Object>emptyMap());
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
