	/**
	 * Printing Journal
	 */
	public void printJournal(String xlsOrPDf) {
		try {
			trackingLogUtils.startLogs();
			
			HashMap<String, Object> map = reportTitle();
			map.put("fromDate", (Date) searchParamVO.getObj2());
			map.put("toDate", (Date) searchParamVO.getObj3());
			
			// Get Journal System prefix
			SystemNumberGenerationVO invSNGVO = systemNumberGenerationBO.getSystemNumberGeneration(CommonConstant.SYS_NUM_CD_JRNL, this.getSessionInfoBean().getCompanyVO().getId());
			map.put("sysPrefix", invSNGVO.getPrefixid());
			
			List<JournalVO> journalRptList = chartOfAcctBO.getJournalEntryList(getSessionInfoBean().getCompanyVO().getId(), searchParamVO);
			
			if (CollectionUtils.isEmpty(journalRptList)) throw new BusinessException(CommonErrConstant.ERR_NO_RESULT);
			
			String jasperFileName = CommonConstant.JAS_RPT_JRNL_ETRY;
			String reportName = CommonConstant.PDF_RPT_JRNL_ETRY;

			JasperPrint jasperPrint = ReportUtils.getJasperPrint(journalRptList, map, jasperFileName);
			if (xlsOrPDf.equals("PDF")) {
				ReportUtils.printReport(jasperPrint, reportName);
			} else {
				ReportUtils.printReportExcel(jasperPrint, reportName);
			}
			
			FacesContext.getCurrentInstance().getExternalContext().addResponseCookie(
					"cookie.pdf.exporting", "true", Collections.<String, Object>emptyMap());
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("printJournal");
		}
	}
	
	/**
	 * Printing Sales In Advance Report
	 */
	public void printSalesInAdvanceRpt(String xlsOrPDf) {
		try {
			trackingLogUtils.startLogs();
			
			//getFinancialPeriod();
			
			HashMap<String, Object> map = reportTitle();
			map.put("fromDate", (Date) searchParamVO.getObj2());
			map.put("toDate", (Date) searchParamVO.getObj3());
			
			if (tourDepVO != null) {
				searchParamVO.setObj4(tourDepVO.getId());
				map.put("tourCd", tourDepVO.getCode());
			} else {
				searchParamVO.setObj4(null);
				map.put("tourCd", null);
			}
			searchParamVO.setObj5(groupType); // Invoice Date or Departure Date
			map.put("groupType", groupType);
			
			
			if (selectedAcct.length > 0) {
				searchParamVO.setObj6(StringUtils.join(selectedAcct, ","));
			} else {
				searchParamVO.setObj6(null);
			}
			searchParamVO.setObj7(salesOnly);
			searchParamVO.setObj8(gtDtDep);
			
			List<AcctViewVO> salesInAdvanceList = chartOfAcctBO.getSalesInAdvanceList(getSessionInfoBean().getCompanyVO().getId(), searchParamVO);
			
			if (CollectionUtils.isEmpty(salesInAdvanceList)) throw new BusinessException(CommonErrConstant.ERR_NO_RESULT);
			
			String jasperFileName = CommonConstant.JAS_RPT_SALES_ADV;
			String reportName = CommonConstant.PDF_RPT_SALES_ADV;

			JasperPrint jasperPrint = ReportUtils.getJasperPrint(salesInAdvanceList, map, jasperFileName);
			if (xlsOrPDf.equals("PDF")) {
				ReportUtils.printReport(jasperPrint, reportName);
			} else {
				ReportUtils.printReportExcel(jasperPrint, reportName);
			}
			
			FacesContext.getCurrentInstance().getExternalContext().addResponseCookie(
					"cookie.pdf.exporting", "true", Collections.<String, Object>emptyMap());
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("printSalesInAdvanceRpt");
		}
	}
	
