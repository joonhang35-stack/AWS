<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

<script type="text/javascript">
	function onAddCustValidation(xhr, status, args) {
		if (!args.validationFailed) {
			varAddCustDialog.hide();
		}
	}
</script>

<p:growl id="msg"/>
<p:panelGrid>
	<p:row>
		<p:column style="width:120px;"><h:outputLabel>Salutation</h:outputLabel></p:column>
		<p:column style="width:220px;">
			<h:selectOneMenu value="#{tourPkgBean.customerVO.personVO.salutation}" effect="fade">
				<f:selectItems value="#{bterp:lookupItemList('salutatn2')}" var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}"/>
			</h:selectOneMenu>
		</p:column>
	</p:row>
	<p:row>
		<p:column><h:outputLabel>Title</h:outputLabel></p:column>
		<p:column>
			<h:selectOneMenu value="#{tourPkgBean.customerVO.personVO.title}" effect="fade">
				<f:selectItem itemLabel="Select One" itemValue="" />
				<f:selectItems value="#{bterp:lookupItemList('salutatn')}" var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}"/>
			</h:selectOneMenu>
		</p:column>
	</p:row>
	<p:row>
		<p:column><h:outputLabel>Customer Name <span class="required">*</span></h:outputLabel></p:column>
		<p:column>
			<p:inputText id="idLastName" label="Surname" value="#{tourPkgBean.customerVO.personVO.lastName}" required="true"/>
			<p:watermark for="idLastName" value="Surname" />
		</p:column>
		<p:column>
			<p:inputText id="idGivenName" label="Given Name" value="#{tourPkgBean.customerVO.personVO.givenName}" required="true"/>
			<p:watermark for="idGivenName" value="Given Name" />
		</p:column>
	</p:row>
	<p:row>
		<p:column><h:outputLabel>NickName</h:outputLabel></p:column>
		<p:column>
			<p:inputText id="idNickName" label="NickName" value="#{tourPkgBean.customerVO.personVO.nickName}"/>
			<p:watermark for="idNickName" value="NickName" />
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idNationality">Nationality <span class="required">*</span></h:outputLabel>
		</p:column>
		<p:column>
			<h:selectOneMenu id="idNationality" label="Nationality" value="#{tourPkgBean.customerVO.personVO.countryId}"
				style="width:180px;" required="true">  
				<p:ajax event="change" update="idIdDetail" listener="#{tourPkgBean.onNationalityChg}"/>	
				<f:selectItem itemLabel="Select One" itemValue="" />  
				<f:selectItems value="#{tourPkgBean.countryList}" var="vo" itemLabel="#{vo.country}" itemValue="#{vo.id}" />  
	           </h:selectOneMenu>
		</p:column>
	</p:row>
	<p:row>
	    <p:column><h:outputLabel>Contact <span class="required">*</span></h:outputLabel></p:column>
	    <p:column>
	        <!-- Mobile Row -->
	        <div class="phone-row" style="display:flex; align-items:center; margin-bottom:6px;">
	            <p:selectOneMenu id="idContactMobileCountry" value="#{tourPkgBean.personContactVO.perMobileCountryId}" style="width:120px" filter="true" filterMatchMode="contains">
	                <f:selectItems value="#{custBean.countryList}" var="c" itemValue="#{c.id}" itemLabel="#{c.countryCd} #{c.country}"/>
	            </p:selectOneMenu>
	            <h:outputLabel style="margin:0 4px;"> - </h:outputLabel>
	            <p:inputText id="idContactNumber" label="Mobile No." value="#{tourPkgBean.personContactVO.number}" required="true" maxlength="14" size="17"
	                onkeypress="return rtnPhoneNo(event);"
	                validatorMessage="Contact number must contain only digits.">
	                <p:watermark for="idContactNumber" value="Mobile No. (required)"/>
	                <f:validateLength maximum="14"/>
	                <f:validateRegex pattern="^[0-9]+$" />
	            </p:inputText>
	        </div>
	        <!-- Fax Row -->
	        <div class="phone-row" style="display:flex; align-items:center;">
	            <p:selectOneMenu id="idContactFaxCountry" value="#{tourPkgBean.personContactVO.perFaxCountryId}" style="width:120px" filter="true" filterMatchMode="contains">
	                <f:selectItems value="#{custBean.countryList}" var="c" itemValue="#{c.id}" itemLabel="#{c.countryCd} #{c.country}"/>
	            </p:selectOneMenu>
	            <h:outputLabel style="margin:0 4px;"> - </h:outputLabel>
	            <p:inputText id="idContactFaxNumber" label="Fax No." value="#{tourPkgBean.personContactVO.faxNum}" maxlength="14" size="17"
	                onkeypress="return rtnPhoneNo(event);"
	                validatorMessage="Contact number must contain only digits.">
	                <p:watermark for="idContactFaxNumber" value="Fax No. (optional)"/>
	                <f:validateLength maximum="14"/>
	                <f:validateRegex pattern="^[0-9]+$" />
	            </p:inputText>
	        </div>
	    </p:column>
	</p:row>
</p:panelGrid>

<p:panelGrid id="idIdDetail">
	<p:row>
		<p:column style="width:120px;"><h:outputLabel>Identity <span class="required">*</span></h:outputLabel></p:column>
		<p:column style="width:220px;">
			<h:selectOneMenu id="idIdType" label="ID Type" value="#{tourPkgBean.identityVO.idType}" effect="fade" style="width:150px;" required="true">
            	<f:selectItems value="#{bterp:lookupItemList('id_type')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
            	<p:ajax event="change" update="idIdDetail"/>
        	</h:selectOneMenu>
		</p:column>
		<p:column>
			<p:inputMask id="idID1" label="ID No." value="#{tourPkgBean.identityVO.idNo}" mask="999999-99-9999" required="true"
				rendered="#{tourPkgBean.identityVO.idType == 'nric' or tourPkgBean.identityVO.idType == null}"/>
			<p:inputText id="idID2" label="ID No." value="#{tourPkgBean.identityVO.idNo}" onkeypress="return rtnAlphaNumeric(event);" required="true"
				rendered="#{tourPkgBean.identityVO.idType != 'nric' and tourPkgBean.identityVO.idType != null}"/>
		</p:column>
	</p:row>
</p:panelGrid>

<p:panelGrid>
	<p:row>
		<p:column style="width:120px;"><h:outputLabel>Email Address</h:outputLabel></p:column>
		<p:column>
			<p:inputText id="idEmail" label="Email" value="#{tourPkgBean.customerVO.personVO.email}" validatorMessage="Invalid email format">
				<f:validateRegex pattern="#{config['email.format.pattern']}" />
			</p:inputText>
		</p:column>
	</p:row>
</p:panelGrid>

<h:panelGrid columns="2" style="width:1px;">
	<p:commandButton value="#{msg['common.button.label.save']}" actionListener="#{tourPkgBean.addCustomer}" update="@form,:idAddInvoiceForm:idCustDetails" oncomplete="onAddCustValidation(xhr, status, args)"/>
	<p:commandButton value="#{msg['common.button.label.cancel']}" actionListener="#{tourPkgBean.resetForm}" update="@form" process="@this" oncomplete="varAddCustDialog.hide()">
		<pe:resetEditableValues for="idAddCustForm"/>
	</p:commandButton>
</h:panelGrid>
</ui:composition>