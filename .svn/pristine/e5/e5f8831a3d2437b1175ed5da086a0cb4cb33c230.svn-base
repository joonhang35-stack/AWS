	@Override
	public void rejectOnlineCustProfUpdReq(OnlineCustomerProfileUpdateVO reqVO, Long idCust) throws BusinessException {
		reqVO.setUpdateStatus(CommonConstant.EMAIL_PMNT_FAILED);
		customerDAO.update(reqVO);
	}
	
	@Override
	public void applyOnlineCustProfUpdReq(OnlineCustomerProfileUpdateVO reqVO, Long idCust) throws BusinessException {
		CustomerVO customerVO = customerDAO.getCustomer(idCust);
		PersonVO personVO = customerDAO.getPersonById(customerVO.getPersCorpId());
		Long idPerson = personVO.getId();
		
		// General
		personVO.setSalutation(reqVO.getSalutationCd());
		personVO.setTitle(reqVO.getTitleCd());
		personVO.setSex(reqVO.getGender());
		personVO.setLastName(reqVO.getSurname());
		personVO.setGivenName(reqVO.getGivenName());
		personVO.setNickName(reqVO.getNickName());
		personVO.setTaxIdNo(reqVO.getTaxIdNo());
		personVO.setCountryId(reqVO.getIdCountry());
		
		// NRIC
		applyOnlineCustProfUpdReqIdentity(reqVO.getNric(), CommonConstant.LOOKUP_ITM_ID_NRIC, idPerson);
		
		personVO.setDob(reqVO.getDtBirth());
		
		// Mobile No.
		PersonContactVO mobileContactVO = customerDAO.getContactVO(idPerson, CommonConstant.LOOKUP_ITM_CNTC_TYPE_MOBILE);
		if (mobileContactVO == null)	mobileContactVO = new PersonContactVO(idPerson, CommonConstant.LOOKUP_ITM_CNTC_TYPE_MOBILE);
		mobileContactVO.setNumber(reqVO.getMobileNo());
		mobileContactVO.setIdCountryCd(reqVO.getIdMobileNoCountryCd());
		mobileContactVO.setCountryCd(regionDAO.getCountryById(reqVO.getIdMobileNoCountryCd()).getCountryCd());
		
		// Office No.
		PersonContactVO officeContactVO = customerDAO.getContactVO(idPerson, CommonConstant.LOOKUP_ITM_CNTC_TYPE_OFFICE);
		if (officeContactVO == null)	officeContactVO = new PersonContactVO(idPerson, CommonConstant.LOOKUP_ITM_CNTC_TYPE_OFFICE);
		officeContactVO.setNumber(reqVO.getOfficeNo());
		officeContactVO.setIdCountryCd(reqVO.getIdOfficeNoCountryCd());
		officeContactVO.setCountryCd(regionDAO.getCountryById(reqVO.getIdOfficeNoCountryCd()).getCountryCd());
		
		// TODO Email
		
		personVO.setRace(reqVO.getRaceCd());
		
		// Travel Document
		IdentityVO passportIdVO = applyOnlineCustProfUpdReqIdentity(reqVO.getPassportNo(), CommonConstant.LOOKUP_ITM_ID_PASSPRT, idPerson);
		
		IdentityDetailVO passportIdentityDetailVO = customerDAO.getIdentityDetail(passportIdVO.getId());
		if (passportIdentityDetailVO == null) {
			passportIdentityDetailVO = new IdentityDetailVO();
			passportIdentityDetailVO.setPersonIdentityId(passportIdVO.getId());
			passportIdentityDetailVO.setTypeCd(CommonConstant.LOOKUP_ITM_ID_PASSPRT);
		}
		passportIdentityDetailVO.setDtExpired(reqVO.getDtPssprtExpiry());
		passportIdentityDetailVO.setIdCountry(reqVO.getIdPssprtCountry());
		
		// Billing Address
		applyOnlineCustProfUpdReqBillingAddress(reqVO, idPerson);
		
		// Mailing Address
		applyOnlineCustProfUpdReqMailingAddress(reqVO, idPerson);
		
		// Emergency Contact
		applyOnlineCustProfUpdReqEc(reqVO, personVO);
		
		customerDAO.update(personVO);
//		customerDAO.update(mobileContactVO);
		if (mobileContactVO.getId() != null) customerDAO.update(mobileContactVO); else customerDAO.insert(mobileContactVO);
//		customerDAO.update(officeContactVO);
		if (officeContactVO.getId() != null) customerDAO.update(officeContactVO); else customerDAO.insert(officeContactVO);
		
//		customerDAO.update(passportIdentityDetailVO);
		if (passportIdentityDetailVO.getId() != null) customerDAO.update(passportIdentityDetailVO); else customerDAO.insert(passportIdentityDetailVO);
		
		// Language
		applyOnlineCustProfUpdReqLang(reqVO, idPerson);
		
		// Complication
		applyOnlineCustProfUpdReqComplication(reqVO, idPerson);
		
		// Meal
		applyOnlineCustProfUpdReqMeal(reqVO, idPerson);
		
		reqVO.setUpdateStatus(CommonConstant.EMAIL_PMNT_SUCCESS);
		customerDAO.update(reqVO);
	}
	
	private AddressVO applyOnlineCustProfUpdReqBillingAddress(OnlineCustomerProfileUpdateVO reqVO, Long idPerson) throws BusinessException {
		AddressVO billAddressVO = customerDAO.getAddressVO(idPerson, CommonConstant.BILL_ADDR);
		if (billAddressVO == null)	billAddressVO = new AddressVO(idPerson, CommonConstant.BILL_ADDR);
		billAddressVO.setAddr1(reqVO.getBillAddr1());
		billAddressVO.setAddr2(reqVO.getBillAddr2());
		billAddressVO.setAddr3(reqVO.getBillAddr3());
		billAddressVO.setCity(reqVO.getBillAddrCity());
		
		MalaysiaStateVO stateVO = malaysiaStateDAO.getStateByStateCode(reqVO.getBillAddrState());
		billAddressVO.setState(stateVO != null ? stateVO.getName() : ""); 
		billAddressVO.setPostcode(reqVO.getBillAddrPostcode());
		billAddressVO.setCountryId(reqVO.getIdBillAddrCountry());
		
		if (billAddressVO.getId() != null) customerDAO.update(billAddressVO); else customerDAO.insert(billAddressVO);
		return billAddressVO;
	}
	
	private AddressVO applyOnlineCustProfUpdReqMailingAddress(OnlineCustomerProfileUpdateVO reqVO, Long idPerson) throws BusinessException {
		AddressVO mailAddressVO = customerDAO.getAddressVO(idPerson, CommonConstant.MAIL_ADDR);
		if (mailAddressVO == null)	mailAddressVO = new AddressVO(idPerson, CommonConstant.MAIL_ADDR);
		mailAddressVO.setAddr1(StringUtils.defaultString(reqVO.getMailAddr1())); // Caused by: java.sql.BatchUpdateException: Column 'addr_1' cannot be null
		mailAddressVO.setAddr2(reqVO.getMailAddr2());
		mailAddressVO.setAddr3(reqVO.getMailAddr3());
		mailAddressVO.setCity(reqVO.getMailAddrCity());
		
		MalaysiaStateVO stateVO = malaysiaStateDAO.getStateByStateCode(reqVO.getMailAddrState());
		mailAddressVO.setState(stateVO != null ? stateVO.getName() : ""); 
		mailAddressVO.setPostcode(reqVO.getMailAddrPostcode());
		mailAddressVO.setCountryId(reqVO.getIdMailAddrCountry());
		
		if (mailAddressVO.getId() != null) customerDAO.update(mailAddressVO); else customerDAO.insert(mailAddressVO);
		return mailAddressVO;
	}
	
	private IdentityVO applyOnlineCustProfUpdReqIdentity(String onlineCustomerProfileUpdateVal, String identityTypeCd, Long idPerson) throws BusinessException {
		List<IdentityVO> identityList = customerDAO.getIdentityList(idPerson, identityTypeCd);
		if (CollectionUtils.isNotEmpty(identityList) && identityList.size() > 1) {
			if (StringUtils.equals(identityTypeCd, CommonConstant.LOOKUP_ITM_ID_NRIC)) throw new BusinessException(CommonErrConstant.ERR_CRM_APPLY_UPD_REQ_MULP_NRIC);
			if (StringUtils.equals(identityTypeCd, CommonConstant.LOOKUP_ITM_ID_PASSPRT)) throw new BusinessException(CommonErrConstant.ERR_CRM_APPLY_UPD_REQ_MULP_PSSPRT);
		}
		IdentityVO identityVO = CollectionUtils.isNotEmpty(identityList) ? identityList.get(0) : new IdentityVO();
		if (identityVO.getPersonId() == null)	identityVO.setPersonId(idPerson);
		if (StringUtils.isBlank(identityVO.getIdType()))	identityVO.setIdType(identityTypeCd);
		if (StringUtils.isBlank(identityVO.getStatusCode()))	identityVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
		identityVO.setIdNo(onlineCustomerProfileUpdateVal);
		
		if (identityVO.getId() != null) customerDAO.update(identityVO); else customerDAO.insert(identityVO);
		return identityVO;
	}
	
	private void applyOnlineCustProfUpdReqLang(OnlineCustomerProfileUpdateVO reqVO, Long idPerson) throws BusinessException {
		deletePersonSubInfo("person_lang", idPerson);
		for (OnlineCustomerUpdLangVO langVO : reqVO.getLangList()) {
			PersonLangVO vo = new PersonLangVO();
			vo.setPersonId(idPerson);
			vo.setLangCd(langVO.getLangCd());
			customerDAO.insert(vo);
		}
	}
	
	private void applyOnlineCustProfUpdReqComplication(OnlineCustomerProfileUpdateVO reqVO, Long idPerson) throws BusinessException {
		deletePersonSubInfo("person_complication", idPerson);
		for (OnlineCustomerUpdComplicationVO complicationVO : reqVO.getComplicationList()) {
			PersonComplicationVO vo = new PersonComplicationVO();
			vo.setPersonId(idPerson);
			vo.setComplicationCd(complicationVO.getComplicationCd());
			customerDAO.insert(vo);
		}
	}
	
	private void applyOnlineCustProfUpdReqMeal(OnlineCustomerProfileUpdateVO reqVO, Long idPerson) throws BusinessException {
		deletePersonSubInfo("person_meal", idPerson);
		for (OnlineCustomerUpdMealVO mealVO : reqVO.getMealList()) {
			PersonMealVO vo = new PersonMealVO();
			vo.setPersonId(idPerson);
			vo.setMealCd(mealVO.getMealCd());
			customerDAO.insert(vo);
		}
	}
	
	private void applyOnlineCustProfUpdReqEc(OnlineCustomerProfileUpdateVO reqVO, PersonVO personVO) throws BusinessException {
		personVO.setEcSurname(reqVO.getEcSurname());
		personVO.setEcGivenName(reqVO.getEcGivenName());
		personVO.setEcContacts(reqVO.getEcContactNo());
		personVO.setEcIdCountryCd(reqVO.getEcIdCountryCd());
		
		CountryVO countryVO = regionDAO.getCountryById(reqVO.getEcIdCountryCd());
		personVO.setEcCountryCd(countryVO != null ? countryVO.getCountryCd() : "");
		personVO.setEcEmail(reqVO.getEcEmail());
		personVO.setEcRelationship(reqVO.getEcRelationship());
	}
}
