	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.CustomerService#isPhoneExisted(com.bcs.zsg.sales.vo.CustDetailsVO, java.lang.Long)
	 */
	@Override
	public boolean isPhoneExisted(CustDetailsVO custDetailsVO, Long idCompany, Boolean isPhoneMan) throws BusinessException {
		PersonContactVO contactVO = custDetailsVO.getPersonContactVO();
	    String mobileNo = contactVO.getPerMobileNumber();
	    String otherNo = contactVO.getPerOtherNumber();
	    String faxNo = contactVO.getPerFaxNumber();
	    String officeNo = contactVO.getPerOfficeNumber();
	    String homeNo = contactVO.getPerHomeNumber();

		if (StringUtils.isBlank(mobileNo) && StringUtils.isBlank(otherNo)) {
			if(isPhoneMan)	return true;
		}
		
		if (StringUtils.isNotBlank(mobileNo)) {
	        if (customerDAO.isPhoneExisted(mobileNo, contactVO.getPerMobileCountryId(), SalesConstant.OTHER_NO_TYPE_CD, custDetailsVO.getPersonId(), idCompany)) {
	            return true;
	        }
	    }
	    
	    if (StringUtils.isNotBlank(officeNo)) {
	        if (customerDAO.isPhoneExisted(officeNo, contactVO.getPerOfficeCountryId(), SalesConstant.OTHER_NO_TYPE_CD, custDetailsVO.getPersonId(), idCompany)) {
	            return true;
	        }
	    }

	    if (StringUtils.isNotBlank(homeNo)) {
	        if (customerDAO.isPhoneExisted(homeNo, contactVO.getPerHomeCountryId(), SalesConstant.OTHER_NO_TYPE_CD, custDetailsVO.getPersonId(), idCompany)) {
	            return true;
	        }
	    }

	    if (StringUtils.isNotBlank(faxNo)) {
	        if (customerDAO.isPhoneExisted(faxNo, contactVO.getPerFaxCountryId(), SalesConstant.OTHER_NO_TYPE_CD, custDetailsVO.getPersonId(), idCompany)) {
	            return true;
	        }
	    }
	    if (isSamePhone(mobileNo, contactVO.getPerMobileCountryId(), faxNo, contactVO.getPerFaxCountryId())
	        || isSamePhone(mobileNo, contactVO.getPerMobileCountryId(), homeNo, contactVO.getPerHomeCountryId())
	        || isSamePhone(mobileNo, contactVO.getPerMobileCountryId(), officeNo, contactVO.getPerOfficeCountryId())) {
	        return true;
	    }
//	    if (isSamePhone(faxNo, contactVO.getPerFaxCountryId(), otherNo, contactVO.getPerOtherCountryId())
//	        || isSamePhone(homeNo, contactVO.getPerHomeCountryId(), otherNo, contactVO.getPerOtherCountryId())
//	        || isSamePhone(officeNo, contactVO.getPerOfficeCountryId(), otherNo, contactVO.getPerOtherCountryId())) {
//	        return true;
//	    }
	    if (isSamePhone(faxNo, contactVO.getPerFaxCountryId(), homeNo, contactVO.getPerHomeCountryId())
	        || isSamePhone(faxNo, contactVO.getPerFaxCountryId(), officeNo, contactVO.getPerOfficeCountryId())
	        || isSamePhone(homeNo, contactVO.getPerHomeCountryId(), officeNo, contactVO.getPerOfficeCountryId())) {
	        return true;
	    }
	    
	    return false;
	}
	
	private boolean isSamePhone(String phone1, Long countryId1, String phone2, Long countryId2) {
	    return StringUtils.isNotBlank(phone1) && StringUtils.isNotBlank(phone2) && Objects.equals(countryId1, countryId2) && StringUtils.equals(phone1, phone2);
	}
