<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.maintenance.vo">
	<class table="pos_upload_sales_trans" name="POSUploadSalesTransVO" polymorphism="explicit">
		<id name="id" type="long" column="id">
            <generator class="native"/>
        </id>
        
		<property name="idPOSUploadSales" type="long" column="id_pos_upload_sales"/>
		<property name="idInvoice" type="long" column="id_invoice"/>
		<property name="docTypeCd" type="string" column="doc_type_cd"/>
		<property name="invoiceNo" type="string" column="invoice_no"/>
		<property name="invoiceDate" type="date" column="invoice_date"/>
		<property name="subTotal" type="double" column="sub_total"/>
		<property name="discountPercentage" type="double" column="discount_percent"/>
		<property name="discountAmount" type="double" column="discount_amount"/>
		<property name="taxRate" type="double" column="tax_rate"/>
		<property name="taxAmount" type="double" column="tax_amount"/>
		<property name="serviceChargePercentage" type="double" column="service_charge_percent"/>
		<property name="serviceChargeAmount" type="double" column="service_charge_amount"/>
		<property name="grandTotal" type="double" column="grand_total"/>
		<property name="isTest" type="boolean" column="is_test"/>
		<property name="isVoid" type="boolean" column="is_void"/>
		
		<!-- BaseVO attributes -->
		<property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
		
	</class>
</hibernate-mapping>