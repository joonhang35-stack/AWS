<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="feedbackReport">
	
	<var name="feedbackReportBean" class="com.bcs.zsg.feedback.web.bean.FeedbackReportBean"/>
	
	<view-state id="feedbackReport" view="feedbackReport.xhtml">
		<on-entry>
			<evaluate expression="feedbackReportBean.init()"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>
