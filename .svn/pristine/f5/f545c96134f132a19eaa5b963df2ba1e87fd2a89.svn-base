package com.bcs.zsg.mail.helper;

import com.bcs.zsg.core.helper.PropertiesLookup;

public final class EmailProperties {
	public static String EMAIL_PROPERTYFILE = "email.properties";
	
	public static String MAIL_URL = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "mail.url");
	public static String FRONTEND_URL_UPD_CUST_P = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "frontend.url.update.customer.person");
	public static String FRONTEND_URL_UPD_CUST_C = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "frontend.url.update.customer.corporate");
	public static String FRONTEND_URL_UPD_SUPPL = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "frontend.url.update.supplier");
	public static String FRONTEND_URL_FEEDBACK_CUSTOMER = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "frontend.url.customer.feedback");
	
	public static String MAIL_LOGO = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "mail.logo");
	
	public static String MAIL_USER_NAME = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "mail.user.name");
	public static String MAIL_USER_FROM_ADDRESS = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "mail.user.fromAddr");
	public static String MAIL_USER_MAIL = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "mail.user.mail");
	public static String MAIL_USER_PASSWORD = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "mail.user.password");
	
	public static String MAIL_SMTP_HOST = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "mail.smtp.host");
	public static String MAIL_SMTP_PORT = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "mail.smtp.port");
	public static String MAIL_SMTP_SOCKETFACTORY_PORT = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "mail.smtp.socketFactory.port");
	public static String MAIL_SMTP_SOCKETFACTORY_CLASS = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "mail.smtp.socketFactory.class");
	public static String MAIL_SMTP_AUTH = PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "mail.smtp.auth");
	public static boolean MAIL_SMTP_USESSL = "true".equals(PropertiesLookup.getProperty(EMAIL_PROPERTYFILE, "mail.smtp.useSSL"));
}
