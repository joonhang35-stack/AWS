		<f:facet name="header">
			<h:outputFormat value="General Ledger Account (G/L Acct) Details" />
		</f:facet>
		<h:form id="idAddAcctSubCatForm">
		<ui:include src="../common/add_gl_acct.xhtml"/>
		</h:form>
</p:dialog> -->

<!--
	DIALOG - ACCOUNT SUB CAT LIST
-->
<p:dialog id="idAcctSubCatList" widgetVar="varAcctSubCatList" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
	<h:form id="idAcctListTableForm">
		<p:dataTable widgetVar="varAcctListTable" id="idAcctListTable" value="#{accountCodeBean.acctList}" var="vo" paginator="true" rows="20" 
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
			filterEvent="enter"
			rowsPerPageTemplate="10, 20, 30" rowKey="#{vo.id}" selectionMode="single">
			<p:ajax event="rowSelect" listener="#{accountCodeBean.handleSubAcctSelect}" oncomplete="varAcctSubCatList.hide()" update=":idEditAccCodeForm:idEditAccCodePanel" process="@this"/>
			 
			<p:column headerText="Account No" sortBy="#{vo.code}" filterBy="#{vo.code}" filterMatchMode="contains">
				<h:outputText value="#{vo.code}" />  
				<h:outputText value=" - #{vo.subCode}" rendered="#{not empty vo.subDesc}" />
			</p:column>
			<p:column headerText="Description" sortBy="#{vo.desc}" filterBy="#{vo.desc}" filterMatchMode="contains">
				<h:outputText value="#{vo.desc}" />
				<h:outputText value=" , #{vo.subDesc}" rendered="#{not empty vo.subDesc}" />
			</p:column>
		</p:dataTable>
	</h:form>
</p:dialog>

