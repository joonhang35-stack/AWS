<p:dialog id="idGSTListDialog" widgetVar="varGSTListDialog" header="GST Output Tax" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
	<p:dataTable id="idOutputTaxCodeList" value="#{accountCodeBean.outputTaxCodeVOList}" var="vo" rowKey="#{vo.id}" selectionMode="single">
		<p:ajax event="rowSelect" listener="#{accountCodeBean.handleGSTSelect}" oncomplete="varGSTListDialog.hide()" update=":idEditAccCodeForm:idEditAccCodePanel"/>
		<p:column headerText="No." width="25" style="text-align:right;">
			<h:outputText value="#{vo.seqNo}"/>
		</p:column>
		<p:column headerText="Code" width="50">
			<h:outputText value="#{vo.code}" />
		</p:column>
		<p:column headerText="Description" >
			<h:outputText value="#{vo.description}" />
		</p:column>
		<p:column headerText="Rate (%)" width="50" style="text-align:right;">
			<h:outputText value="#{vo.rate}"/>
		</p:column>
	</p:dataTable>
</p:dialog>
</ui:define>
</ui:composition>