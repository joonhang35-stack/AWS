<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

	<p:growl id="msg" />
	<h:panelGrid columns="3" style="width:1px; margin-bottom: 4px">
		<p:commandButton value="Add" oncomplete="varAddKeycloakUserDialog.hide()" process="@this" update="@form" actionListener="#{configBean.addKeycloakUser}" />
		<p:commandButton value="Cancel" oncomplete="varAddKeycloakUserDialog.hide()" process="@this" />
	</h:panelGrid>
	
	<p:panelGrid>
		<p:row>
			<p:column>Username</p:column>
			<p:column>
				<p:inputText value="#{configBean.keycloakUserVO.username}">
					<p:ajax event="change" global="false"></p:ajax>
				</p:inputText>
			</p:column>
		</p:row>
		<p:row>
			<p:column>Password</p:column>
			<p:column>
				<p:inputText value="#{configBean.keycloakUserVO.password}">
					<p:ajax event="change" global="false"></p:ajax>
				</p:inputText>
			</p:column>
		</p:row>
		<p:row>
			<p:column>First Name</p:column>
			<p:column>
				<p:inputText value="#{configBean.keycloakUserVO.firstName}">
					<p:ajax event="change" global="false"></p:ajax>
				</p:inputText>
			</p:column>
		</p:row>
		<p:row>
			<p:column>Last Name</p:column>
			<p:column>
				<p:inputText value="#{configBean.keycloakUserVO.lastName}">
					<p:ajax event="change" global="false"></p:ajax>
				</p:inputText>
			</p:column>
		</p:row>
		<p:row>
			<p:column>Nickname</p:column>
			<p:column>
				<p:inputText value="#{configBean.keycloakUserVO.attributes.personVO.nickName}">
					<p:ajax event="change" global="false"></p:ajax>
				</p:inputText>
			</p:column>
		</p:row>
		<p:row>
			<p:column>Nationality</p:column>
			<p:column>
				<h:selectOneMenu id="idNationality" label="Nationality" value="#{configBean.keycloakUserVO.attributes.nationality}" style="width:180px;" required="true">
					<f:selectItem itemLabel="Select One" itemValue="" />
					<f:selectItems value="#{configBean.countryList}" var="vo" itemLabel="#{vo.country}" itemValue="#{vo.threeLetterCode}" />
				</h:selectOneMenu>
			</p:column>
		</p:row>
		<p:row>
			<p:column>Identity</p:column>
			<p:column>
				<p:inputText value="#{configBean.keycloakUserVO.attributes.identity}">
					<p:ajax event="change" global="false"></p:ajax>
				</p:inputText>
			</p:column>
		</p:row>
		<p:row>
			<p:column>Date Of Birth</p:column>
			<p:column>
				<p:calendar label="Date of Birth" value="#{configBean.keycloakUserVO.attributes.personVO.dob}" navigator="true" showButtonPanel="true" pattern="dd-MMM-yyyy">
					<p:ajax event="dateSelect" global="false" />
				</p:calendar>
			</p:column>
		</p:row>
		<p:row>
			<p:column>Email</p:column>
			<p:column>
				<p:inputText value="#{configBean.keycloakUserVO.email}">
					<p:ajax event="change" global="false"></p:ajax>
				</p:inputText>
			</p:column>
		</p:row>
		<p:row>
			<p:column colspan="2">
				<p:panel id="idPanelBillAddress" header="Billing Address">
					<p:panelGrid>
						<p:row>
							<p:column>
								<h:outputLabel for="idAdd1">Address Line 1 <span class="required">*</span>
								</h:outputLabel>
							</p:column>
							<p:column>
								<p:inputText id="idAdd1" label="Address Line 1"
									value="#{configBean.keycloakUserVO.attributes.billAddrVO.addr1}"
									size="50">
									<p:ajax event="change" global="false"></p:ajax>
								</p:inputText>
							</p:column>
						</p:row>
						<p:row>
							<p:column>
								<h:outputLabel for="idAdd2">Address Line 2
								</h:outputLabel>
							</p:column>
							<p:column>
								<p:inputText id="idAdd2" label="Address Line 2"
									value="#{configBean.keycloakUserVO.attributes.billAddrVO.addr2}"
									size="50">
									<p:ajax event="change" global="false"></p:ajax>
								</p:inputText>
							</p:column>
						</p:row>
						<p:row>
							<p:column>
								<h:outputLabel for="idAdd3">Address Line 3 
								</h:outputLabel>
							</p:column>
							<p:column>
								<p:inputText id="idAdd3" label="Address Line 3"
									value="#{configBean.keycloakUserVO.attributes.billAddrVO.addr3}"
									size="50">
									<p:ajax event="change" global="false"></p:ajax>
								</p:inputText>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:panel>
			</p:column>
		</p:row>
	</p:panelGrid>

	<h:panelGrid columns="3" style="width:1px; margin-top: 4px">
		<p:commandButton value="Add" oncomplete="varAddKeycloakAdvUserDialog.hide()" process="@form" update="@form" actionListener="#{configBean.addKeycloakAdvUser}" />
		<p:commandButton value="Cancel" oncomplete="varAddKeycloakAdvUserDialog.hide()" process="@this" />
	</h:panelGrid>

</ui:composition>