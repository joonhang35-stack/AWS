<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="invoice_payment_report">
	
	<var name="invoicePaymentReportBean" class="com.bcs.zsg.sales.web.bean.InvoicePaymentReportBean"/>
	
	<view-state id="invoice_payment_report">
		<on-entry>
			<evaluate expression="invoicePaymentReportBean.init()"/>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>