<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="payment_form">
	
	<!-- backing bean, extends com.bcs.zsg.component.common.web.swf.bean.AppBackingBean -->
	<var name="paymentBean" class="com.bcs.zsg.bank.web.bean.PaymentBean"/>
	<var name="purchaseBean" class="com.bcs.zsg.purchase.web.bean.PurchaseBean"/>
	<var name="acctBean" class="com.bcs.zsg.acct.web.bean.AccountBean"/>
	
	<view-state id="payment_form">
		<on-entry>
			<evaluate expression="paymentBean.init()"/>
			<evaluate expression="purchaseBean.init(1)"/>
			<evaluate expression="acctBean.init(0, false)"></evaluate>
		</on-entry>
	</view-state>
	
	<end-state id="finish"/>
	
</flow>