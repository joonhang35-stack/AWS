	@Override
	public InvoiceVO getInvoice(Map<String, Object> params) throws BusinessException {
		Criteria criteria = getSession().createCriteria(InvoiceVO.class);
		
		if (params.get("psNo") != null) {
			criteria.add(Restrictions.eq("psNo", params.get("psNo")));
		}
		
		if (params.get("code") != null) {
			criteria.add(Restrictions.eq("code", params.get("code")));
		}
		
		if (params.get("docTypeCd") != null) {
			criteria.add(Restrictions.eq("docTypeCd", params.get("docTypeCd")));
		}
		
		return (InvoiceVO) criteria.uniqueResult();
	}
	
	@Override
	public List<InvoiceVO> getSubInvoiceList(Long idParentInv) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append(" select i.id, i.ps_no, i.code, i.doc_type_cd, i.id_company, i.amount, i.balance, i.status_cd, i.travel_warrant_chk, i.is_inv_paid "); 
		sb.append(" from invoice i "); 
		sb.append(" where i.id_parent_inv=" + idParentInv);

		Query query = createSQLQuery(sb.toString());

		List<Object> results = query.list();
		List<InvoiceVO> invoiceList = new ArrayList<InvoiceVO>();

		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			InvoiceVO vo = new InvoiceVO();
			vo.setId(((BigInteger) row[0]).longValue()); 
			vo.setPsNo((String) row[1]);   
			vo.setCode((String) row[2]);   
			vo.setDocTypeCd((String) row[3]);   
			vo.setCompanyId(((BigInteger) row[4]).longValue()); 
			if (row[5] != null) vo.setAmount(Double.parseDouble(row[5].toString()));      
			if (row[6] != null) vo.setBalance(Double.parseDouble(row[6].toString())); 
			vo.setStatusCd((String) row[7]);  
			if (row[8] != null) vo.setTrvWarrantChecked((Boolean) row[8]);
			if (row[9] != null) vo.setIsInvPaid((Boolean) row[9]);
			invoiceList.add(vo);
		}
		return invoiceList;
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<InvoiceVO> getInvoiceListByParams(Map<String, Object> params) throws BusinessException {
		Criteria criteria = createCriteria(InvoiceVO.class);
		if (params.get("companyId") != null)
			criteria.add(Restrictions.eq("companyId", params.get("companyId")));
		if (params.get("docTypeCd") != null)
			criteria.add(Restrictions.eq("docTypeCd", params.get("docTypeCd")));
		if (params.get("eInvoiceStatus") != null)
			criteria.add(Restrictions.eq("eInvoiceStatus", params.get("eInvoiceStatus")));
		if (params.get("eInvoiceStatusList") != null)
			criteria.add(Restrictions.in("eInvoiceStatus", (List<String>) params.get("eInvoiceStatusList")));
		if (params.get("statusList") != null)
			criteria.add(Restrictions.in("statusCd", (List<String>) params.get("statusList")));
		
		// for EInvoiceSchedulerServiceImpl
		if (params.get("invIdList") != null)
			criteria.add(Restrictions.in("id", (List<Long>) params.get("invIdList")));

		if (params.get("invDateFr") != null && params.get("invDateTo") != null)
			criteria.add(Restrictions.between("invoiceDt", params.get("invDateFr"), params.get("invDateTo")));

		if (params.get("depDateFr") != null && params.get("depDateTo") != null)
			criteria.add(Restrictions.between("departureDt", (Date) params.get("depDateFr"), (Date) params.get("depDateTo")));

		List<InvoiceVO> ls = criteria.list();

		return ls;
	}

	@Override
	public void updateInvoiceEInvoiceData(Long idInv, String docUuid, String submissionUid, String status) throws BusinessException {
		String updatedBy = BaseContext.getUserFullName();
		if (StringUtils.isBlank(updatedBy)) updatedBy = BaseContext.getLoginId();
		
		StringBuilder sb = new StringBuilder();
		
		sb.append(" update invoice set ");
		if (StringUtils.isNotBlank(docUuid))		sb.append(" e_invoice_document_uuid = :docUuid, ");
		if (StringUtils.isNotBlank(submissionUid))	sb.append(" e_invoice_submission_uid = :submissionUid, ");
		if (StringUtils.isNotBlank(status))			sb.append(" e_invoice_status = :status, ");
		
		sb.append(" upd_by = :updatedBy, ");
		sb.append(" dt_upd = now() ");
		
		sb.append(" where id = :id ");
		
		Query query = createSQLQuery(sb.toString());
		if (StringUtils.isNotBlank(docUuid))		query.setParameter("docUuid", docUuid);
		if (StringUtils.isNotBlank(submissionUid))	query.setParameter("submissionUid", submissionUid);
		if (StringUtils.isNotBlank(status))			query.setParameter("status", status);
		query.setParameter("id", idInv);
		query.setParameter("updatedBy", updatedBy);
		query.executeUpdate();
		
		insertInvoiceHistory(idInv, CommonConstant.ACTION_CD_UPD, "Submit E-Invoice");
	}
	
