	@SuppressWarnings("unchecked")
	@Override
	public int getCreditNoteDisplayListSize(Map<String, Object> params) throws BusinessException { 
		
		boolean ljCust = false, ljPerson = false, ljInv = false, ljTourDep = false;
		StringBuilder sbFilters = new StringBuilder();
		
		if (params.get("departureDateFr") != null && params.get("departureDateTo") != null) {
			sbFilters.append("and ifnull(cn_iv.dt_departure, cn_ps.dt_departure) BETWEEN date(:departureDateFr) and date(:departureDateTo) ");
			ljInv = true;
		}
		if (params.get("departureDateFr") != null) {
			sbFilters.append("and ifnull(cn_iv.dt_departure, cn_ps.dt_departure) >= date(:departureDateFr) ");
			ljInv = true;
		}
		if (params.get("departureDateTo") != null) {
			sbFilters.append("and ifnull(cn_iv.dt_departure, cn_ps.dt_departure) <= date(:departureDateTo) ");
			ljInv = true;
		}
		
		if (params.get("showSubmittedInvOnly") != null && (Boolean) params.get("showSubmittedInvOnly"))	{
//			sbFilters.append(" and cn_iv.e_invoice_status = 'Valid' ");
			
			sbFilters.append(" and cn_iv.e_invoice_status = 'Valid' ");
			sbFilters.append(" and iv.e_invoice_status != 'Valid' and iv.e_invoice_status != 'Submitted' ");
			sbFilters.append(" and iv.e_invoice_rn_status != 'Valid' and iv.e_invoice_rn_status != 'Submitted' ");
			
			ljInv = true;
		}

		
		Map<String, String> filters = (Map<String, String>) params.get("filters");
		if (!filters.isEmpty()) {
			sbFilters.append("and (");
			for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) {
				Entry<String, String> entry = it.next();
				
				if ("codeLong".equals(entry.getKey())) sbFilters.append("iv.code like '%").append(entry.getValue()).append("%'");
				else if ("invoiceDt".equals(entry.getKey())) {
					sbFilters.append("date_format(iv.dt_inv, '%d-%b-%Y') like '%").append(entry.getValue()).append("%'");
					ljInv = true;
				}
				else if ("departureDt".equals(entry.getKey())) {
					sbFilters.append("date_format(ifnull(cn_iv.dt_departure, cn_ps.dt_departure), '%d-%b-%Y') like '%").append(entry.getValue()).append("%'");
					ljInv = true;
				}
				else if ("custCdLong".equals(entry.getKey())) {
					sbFilters.append("cm.code like '%").append(entry.getValue()).append("%'");
					ljCust = true;
				}
				else if ("custName".equals(entry.getKey())) {
					sbFilters.append("concat(ps.last_name, ' ', ps.first_name) like '%").append(entry.getValue()).append("%'");
					ljCust = true;
					ljPerson = true;
				}
				else if ("rnNo".equals(entry.getKey())) sbFilters.append("iv.rn_no like '%").append(entry.getValue()).append("%'");
				else if ("cnInvNo".equals(entry.getKey())) sbFilters.append("(iv.cn_ps_no like '%").append(entry.getValue()).append("%' or iv.cn_inv_no like '%").append(entry.getValue()).append("%') ");
				else if ("tourCd".equals(entry.getKey())) {
					sbFilters.append("d.code like '%").append(entry.getValue()).append("%'");
					ljInv = true;
					ljTourDep = true;
				}
				else if ("amount".equals(entry.getKey())) sbFilters.append("iv.amount like '%").append(entry.getValue()).append("%'");
				else if ("amtAftRefund".equals(entry.getKey())) sbFilters.append("iv.amt_aft_refund like '%").append(entry.getValue()).append("%'");
				else if ("refundAmt".equals(entry.getKey())) sbFilters.append("iv.refund_amt like '%").append(entry.getValue()).append("%'");
				else if ("statusCd".equals(entry.getKey())) sbFilters.append("upper((select ref_value from com_ref_data where ref_cd = iv.status_cd and cat_cd = 'INV_STATUS')) like upper('%").append(entry.getValue()).append("%')");
				else if ("eInvoiceStatus".equals(entry.getKey())) {
					if (entry.getValue().equals(BaseConstant.PAD_DASH)) {
						sbFilters.append("iv.amt_aft_refund = 0");
					} else {
						sbFilters.append("iv.amt_aft_refund != 0 AND iv.e_invoice_status like '%").append(entry.getValue()).append("%'");
					}
				}
				else if ("eInvoiceRnStatus".equals(entry.getKey())) {
					if (entry.getValue().equals(BaseConstant.PAD_DASH)) {
						sbFilters.append("iv.refund_amt = 0");
					} else {
						sbFilters.append("iv.refund_amt != 0 AND iv.e_invoice_rn_status like '%").append(entry.getValue()).append("%'");
					}
				}
				if (filters.size() > 1 && it.hasNext()) sbFilters.append(" and ");
			}
			sbFilters.append(")");
		}
		
		StringBuilder sb = new StringBuilder();
		sb.append(" select count(*) ");
//		sb.append("from invoice iv, employee ep, sec_user usr, customer cm, person ps "); // original getCreditNoteDisplayListSize query
		sb.append(" from invoice iv ");
		if (ljInv) {
			sb.append(" LEFT JOIN invoice cn_iv ");
				sb.append(" ON iv.id_company = cn_iv.id_company AND iv.doc_type_cd = 'C' AND iv.cn_inv_no IS NOT NULL AND cn_iv.code = iv.cn_inv_no AND cn_iv.doc_type_cd = 'I' ");
			sb.append(" LEFT JOIN invoice cn_ps ");
				sb.append(" ON iv.id_company = cn_ps.id_company AND iv.doc_type_cd = 'C' AND iv.cn_ps_no IS NOT NULL AND cn_ps.ps_no = iv.cn_ps_no AND cn_ps.doc_type_cd = 'P' ");
			if (ljTourDep) {
				sb.append(" LEFT JOIN tour_dep d ");
					sb.append(" ON ifnull(cn_iv.id_tour_dep, cn_ps.id_tour_dep) = d.id ");
			}
		}
//		sb.append(" left join employee ep on iv.id_saler = ep.id "); // original getCreditNoteDisplayListSize query
//		sb.append(" left join sec_user usr on ep.u_sec_user = usr.uuid "); // original getCreditNoteDisplayListSize query
		if (ljCust)	sb.append(" left join customer cm on iv.id_customer = cm.id ");
		if (ljPerson) sb.append(" left join person ps on cm.id_pc = ps.id ");
		sb.append(" where iv.id_company = :idCompany and iv.doc_type_cd = :docTypeCd ");
		
		if (params.get("orderSourceCode") != null) sb.append(" and iv.order_cd = :orderSourceCode ");
		if (params.get("paymentStatusList") != null)	sb.append(" and iv.status_cd in :paymentStatusList ");
		if (params.get("eInvoiceStatusList") != null)	sb.append(" and iv.e_invoice_status in :eInvoiceStatusList ");
		if (params.get("fromDate") != null && params.get("toDate") != null) sb.append(" and date(iv.dt_inv) BETWEEN date(:fromDate) and date(:toDate) ");
		if (params.get("fromDate") != null) sb.append(" and date(iv.dt_inv) >= date(:fromDate) ");
		if (params.get("toDate") != null) sb.append(" and date(iv.dt_inv) <= date(:toDate) ");
		
		if (sbFilters.length() > 0) {
			sb.append(sbFilters);
		}
		
		Query query = createSQLQuery(sb.toString());
		
		query.setParameter("idCompany", params.get("idCompany"));
		if (params.get("orderSourceCode") != null) query.setParameter("orderSourceCode", params.get("orderSourceCode"));
		if (params.get("paymentStatusList") != null) query.setParameterList("paymentStatusList", (String[]) params.get("paymentStatusList"));
		if (params.get("eInvoiceStatusList") != null)	query.setParameterList("eInvoiceStatusList", (String[]) params.get("eInvoiceStatusList"));
		if (params.get("fromDate") != null) query.setParameter("fromDate", params.get("fromDate"));
		if (params.get("toDate") != null) query.setParameter("toDate", params.get("toDate"));
		if (params.get("departureDateFr") != null) query.setParameter("departureDateFr", params.get("departureDateFr"));
		if (params.get("departureDateTo") != null) query.setParameter("departureDateTo", params.get("departureDateTo"));
		query.setParameter("docTypeCd", "C");
		
//		System.out.println("InvoiceDAOImpl.getCreditNoteDisplayListSize()");
//		System.out.println(sb.toString());
		
		return ((BigInteger) query.uniqueResult()).intValue();
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<InvoiceVO> getCreditNoteDisplayList(Map<String, Object> params) throws BusinessException { 
		StringBuilder sb = new StringBuilder();
		sb.append("select iv.id as inv_id, ");
		sb.append("iv.code as inv_cd, ");
		sb.append("iv.dt_inv as dt_inv, ");
		sb.append("ifnull(cn_iv.dt_departure, cn_ps.dt_departure) as dt_departure, ");
		sb.append("iv.amount as inv_amt, ");
		sb.append("iv.balance as inv_bln, ");
		sb.append("iv.inv_due as inv_due, ");
		sb.append("iv.status_cd as status_cd, ");
		sb.append("iv.id_tour_booking as id_tour_booking, ");
		sb.append("iv.id_customer as id_cust, ");
		sb.append("usr.user_name as user_name, ");
		sb.append("ps.first_name as cust_first_name, ");
		sb.append("ps.last_name as cust_last_name, ");
		sb.append("case when ps.salutation_cd != '"+ LookupItemConstant.SALUTATION_EMPTY_CD +"' then ps.salutation_cd else '' end as cust_salutation, ");
		sb.append("cm.corporate_name as company_name, ");
		sb.append("iv.cn_inv_no as cn_inv_no, ");
		sb.append("cm.code as cust_cd, ");
		sb.append("iv.rn_no as rn_no, iv.e_invoice_status as e_invoice_status, iv.cn_ps_no, iv.e_invoice_rn_status as e_invoice_rn_status, iv.refund_amt as refund_amt, iv.amt_aft_refund as amt_aft_refund, ");
		sb.append("d.code as tour_cd, cn_iv.e_invoice_status as cn_iv_e_inv_status ");
		sb.append("from invoice iv ");
			sb.append("LEFT JOIN invoice cn_iv ");
				sb.append("ON iv.id_company = cn_iv.id_company AND iv.doc_type_cd = 'C' AND iv.cn_inv_no IS NOT NULL AND cn_iv.code = iv.cn_inv_no AND cn_iv.doc_type_cd = 'I' ");
			sb.append("LEFT JOIN invoice cn_ps ");
				sb.append("ON iv.id_company = cn_ps.id_company AND iv.doc_type_cd = 'C' AND iv.cn_ps_no IS NOT NULL AND cn_ps.ps_no = iv.cn_ps_no AND cn_ps.doc_type_cd = 'P' ");
			sb.append("LEFT JOIN tour_dep d ");
				sb.append("ON ifnull(cn_iv.id_tour_dep, cn_ps.id_tour_dep) = d.id, ");
			sb.append("employee ep, sec_user usr, customer cm, person ps ");
		sb.append("where iv.id_company = :idCompany and iv.doc_type_cd = :docTypeCd and ");
		sb.append("iv.id_saler = ep.id and ep.u_sec_user = usr.uuid and iv.id_customer = cm.id and cm.id_pc = ps.id ");
		
		if (params.get("orderSourceCode") != null) sb.append("and iv.order_cd = :orderSourceCode ");
		if (params.get("paymentStatusList") != null)	sb.append("and iv.status_cd in :paymentStatusList ");
		if (params.get("eInvoiceStatusList") != null)	sb.append("and iv.e_invoice_status in :eInvoiceStatusList ");
		if (params.get("fromDate") != null && params.get("toDate") != null) sb.append("and date(iv.dt_inv) BETWEEN date(:fromDate) and date(:toDate) ");
		if (params.get("fromDate") != null) sb.append("and date(iv.dt_inv) >= date(:fromDate) ");
		if (params.get("toDate") != null) sb.append("and date(iv.dt_inv) <= date(:toDate) ");
		
		if (params.get("departureDateFr") != null && params.get("departureDateTo") != null) sb.append("and ifnull(cn_iv.dt_departure, cn_ps.dt_departure) BETWEEN date(:departureDateFr) and date(:departureDateTo) ");
		if (params.get("departureDateFr") != null) sb.append("and ifnull(cn_iv.dt_departure, cn_ps.dt_departure) >= date(:departureDateFr) ");
		if (params.get("departureDateTo") != null) sb.append("and ifnull(cn_iv.dt_departure, cn_ps.dt_departure) <= date(:departureDateTo) ");
		if (params.get("showSubmittedInvOnly") != null && (Boolean) params.get("showSubmittedInvOnly"))	{
			sb.append(" and cn_iv.e_invoice_status = 'Valid' ");
			sb.append(" and iv.e_invoice_status != 'Valid' and iv.e_invoice_status != 'Submitted' ");
			sb.append(" and iv.e_invoice_rn_status != 'Valid' and iv.e_invoice_rn_status != 'Submitted' ");
		}
		
		Map<String, String> filters = (Map<String, String>) params.get("filters");
		if (!filters.isEmpty()) {
			sb.append("and (");
			for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) {
				Entry<String, String> entry = it.next();
				
				if ("codeLong".equals(entry.getKey())) sb.append("iv.code like '%").append(entry.getValue()).append("%'");
				else if ("invoiceDt".equals(entry.getKey())) sb.append("date_format(iv.dt_inv, '%d-%b-%Y') like '%").append(entry.getValue()).append("%'");
				else if ("departureDt".equals(entry.getKey())) sb.append("date_format(ifnull(cn_iv.dt_departure, cn_ps.dt_departure), '%d-%b-%Y') like '%").append(entry.getValue()).append("%'");
				else if ("custCdLong".equals(entry.getKey())) sb.append("cm.code like '%").append(entry.getValue()).append("%'");
				else if ("custName".equals(entry.getKey())) sb.append("concat(ps.last_name, ' ', ps.first_name) like '%").append(entry.getValue()).append("%'");
				else if ("rnNo".equals(entry.getKey())) sb.append("iv.rn_no like '%").append(entry.getValue()).append("%'");
				else if ("cnInvNo".equals(entry.getKey())) sb.append("(iv.cn_ps_no like '%").append(entry.getValue()).append("%' or iv.cn_inv_no like '%").append(entry.getValue()).append("%') ");
				else if ("tourCd".equals(entry.getKey())) sb.append("d.code like '%").append(entry.getValue()).append("%'");
				else if ("amount".equals(entry.getKey())) sb.append("iv.amount like '%").append(entry.getValue()).append("%'");
				else if ("amtAftRefund".equals(entry.getKey())) sb.append("iv.amt_aft_refund like '%").append(entry.getValue()).append("%'");
				else if ("refundAmt".equals(entry.getKey())) sb.append("iv.refund_amt like '%").append(entry.getValue()).append("%'");
				else if ("statusCd".equals(entry.getKey())) sb.append("upper((select ref_value from com_ref_data where ref_cd = iv.status_cd and cat_cd = 'INV_STATUS')) like upper('%").append(entry.getValue()).append("%')");
				else if ("eInvoiceStatus".equals(entry.getKey())) {
					if (entry.getValue().equals(BaseConstant.PAD_DASH)) {
						sb.append("iv.amt_aft_refund = 0");
					} else {
						sb.append("iv.amt_aft_refund != 0 AND iv.e_invoice_status like '%").append(entry.getValue()).append("%'");
					}
				}
				else if ("eInvoiceRnStatus".equals(entry.getKey())) {
					if (entry.getValue().equals(BaseConstant.PAD_DASH)) {
						sb.append("iv.refund_amt = 0");
					} else {
						sb.append("iv.refund_amt != 0 AND iv.e_invoice_rn_status like '%").append(entry.getValue()).append("%'");
					}
				}
				if (filters.size() > 1 && it.hasNext()) sb.append(" and ");
			}
			sb.append(")");
		}
		
		sb.append(" order by ");
		String sortField = (String) params.get("sortField");
		
		if (sortField == null) 
			sb.append(" iv.dt_inv desc, iv.id desc ");
		else {
			if ("codeLong".equals(sortField)) sb.append("cast(iv.code as decimal)");
			else if ("invoiceDt".equals(sortField)) sb.append("iv.dt_inv");
			else if ("departureDt".equals(sortField)) sb.append("ifnull(cn_iv.dt_departure, cn_ps.dt_departure)");
			else if ("custCdLong".equals(sortField)) sb.append("cast(cm.code as decimal)");
			else if ("custName".equals(sortField)) sb.append("concat(ps.last_name, ' ', ps.first_name)");
			else if ("rnNo".equals(sortField)) sb.append("iv.rn_no");
			else if ("cnInvNo".equals(sortField)) sb.append("concat(ifnull(iv.cn_inv_no, ''), ifnull(iv.cn_ps_no, ''))");
			else if ("tourCd".equals(sortField)) sb.append("d.code");
			else if ("amount".equals(sortField)) sb.append("iv.amount");
			else if ("amtAftRefund".equals(sortField)) sb.append("iv.amt_aft_refund");
			else if ("refundAmt".equals(sortField)) sb.append("iv.refund_amt");
			else if ("eInvoiceStatus".equals(sortField)) sb.append("iv.e_invoice_status");
			else if ("eInvoiceRnStatus".equals(sortField)) sb.append("iv.e_invoice_rn_status");
			
			if (CommonConstant.SORT_ASC.equals(((SortOrder) params.get("sortOrder")).toString())) sb.append(" asc");
			else sb.append(" desc");
		}
		
		Query query = createSQLQuery(sb.toString());
		query.setParameter("idCompany", params.get("idCompany"));
		if (params.get("orderSourceCode") != null) query.setParameter("orderSourceCode", params.get("orderSourceCode"));
		if (params.get("paymentStatusList") != null) query.setParameterList("paymentStatusList", (String[]) params.get("paymentStatusList"));
		if (params.get("eInvoiceStatusList") != null)	query.setParameterList("eInvoiceStatusList", (String[]) params.get("eInvoiceStatusList"));
		if (params.get("fromDate") != null) query.setParameter("fromDate", params.get("fromDate"));
		if (params.get("toDate") != null) query.setParameter("toDate", params.get("toDate"));
		if (params.get("departureDateFr") != null) query.setParameter("departureDateFr", params.get("departureDateFr"));
		if (params.get("departureDateTo") != null) query.setParameter("departureDateTo", params.get("departureDateTo"));
		if (params.get("first") != null && (Integer) params.get("first") >= 0)	query.setFirstResult((Integer) params.get("first"));
		if (params.get("pageSize") != null && (Integer) params.get("pageSize") >= 0)	query.setMaxResults((Integer) params.get("pageSize"));
		query.setParameter("docTypeCd", "C");
		
//		System.out.println("InvoiceDAOImpl.getCreditNoteDisplayList()");
//		System.out.println(sb.toString());
		
		List<Object> results = query.list();
		List<InvoiceVO> invoiceList = new ArrayList<InvoiceVO>();

		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			InvoiceVO vo = new InvoiceVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setCode((String) row[1]);
			vo.setInvoiceDt((Date) row[2]);
			vo.setDepartureDt((Date) row[3]);
			vo.setAmount(Double.parseDouble(row[4].toString()));
			vo.setBalance(Double.parseDouble(row[5].toString()));
			vo.setInvoiceDue((Date) row[6]);
			vo.setStatusCd((String) row[7]);
			if(row[8] == null )
			{ vo.setBookingId(null);
			}else{	vo.setBookingId(  Long.parseLong(row[8].toString()));
			} 
			//if(row[9] != null ) vo.setTourCd( row[9].toString());   
			if(row[9] != null ) vo.setCustomerId( Long.parseLong(row[9].toString()));   
			if(row[10] != null ) vo.setSalerName( row[10].toString());   
			//vo.setCustName( row[11].toString() + " " + row[12].toString() );   
			vo.setCustName(row[12].toString() + " " + row[11].toString());   
			vo.setCustSalutation(row[13].toString() );
			vo.setCoName((row[14] != null) ? row[14].toString() : null);
			vo.setCnInvNo((row[15] != null) ? row[15].toString() : null);
			vo.setCustCd((row[16] != null) ? row[16].toString() : null);
			vo.setRnNo((row[17] != null) ? row[17].toString() : null);
			vo.seteInvoiceStatus((row[18] != null) ? row[18].toString() : null);
			vo.setCnPsNo((row[19] != null) ? row[19].toString() : null);
			vo.seteInvoiceRnStatus((row[20] != null) ? row[20].toString() : null);
			vo.setRefundAmt((row[21] != null) ? Double.parseDouble(row[21].toString()) : null);
			vo.setAmtAftRefund((row[22] != null) ? Double.parseDouble(row[22].toString()) : null);
			vo.setTourCd((row[23] != null) ? row[23].toString() : null);
			
			vo.setCnInv(new InvoiceVO());
			vo.getCnInv().seteInvoiceStatus((row[24] != null) ? row[24].toString() : null);
			invoiceList.add(vo);
		}
		return invoiceList;
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<InvoicePaymentVO> getSubInvPmntList(Long idParentPmnt) throws BusinessException {
		Criteria criteria = getSession().createCriteria(InvoicePaymentVO.class);
		criteria.add(Restrictions.eq("idParentPmnt", idParentPmnt));
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
		return criteria.list();
	}
	
	@Override
	public List<InvoicePaymentVO> getChildInvPmntList(Long idParentPmnt) throws BusinessException {
		return getSubInvPmntList(idParentPmnt);
	}
	
	@Override
	public List<InvoicePaymentVO> getInvPmntListByIdCreditNote(Long idCreditNote) throws BusinessException {
		
		StringBuilder sb = new StringBuilder();
		sb.append(" select ip.id, ip.id_parent_pmnt, i.doc_type_cd ");
		sb.append(" from invoice_pmnt ip ");
		sb.append(" left join invoice i on ip.id_inv = i.id ");
		sb.append(" where ip.status_cd = :statusCode and ip.id_credit_note = :idCreditNote ");
		
		Query query = createSQLQuery(sb.toString());
		query.setParameter("idCreditNote", idCreditNote);
		query.setParameter("statusCode", BaseConstant.STATUS_ACTIVE);
		
		List<Object> results = query.list();
		List<InvoicePaymentVO> invoicePmntList = new ArrayList<InvoicePaymentVO>();

		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			InvoicePaymentVO vo = new InvoicePaymentVO();
			vo.setId(((BigInteger) row[0]).longValue());
			if (row[1] != null)	vo.setIdParentPmnt(((BigInteger) row[1]).longValue());
			vo.setInvoiceDocTypeCd((String) row[2]);
			
			invoicePmntList.add(vo);
		}
		return invoicePmntList;
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<InvoiceVO> getInvoiceList(Map<String, Object> params, Long idCompany) throws BusinessException {
		Criteria criteria = getSession().createCriteria(InvoiceVO.class);
		
		if (params.get("invDtFrom") != null) {
			criteria.add(Restrictions.ge("invoiceDt", params.get("invDtFrom")));
		}
		
		if (params.get("invDtTo") != null) {
			criteria.add(Restrictions.le("invoiceDt", params.get("invDtTo")));
		}
		
		if (params.get("docTypeCdList") != null) {
			criteria.add(Restrictions.in("docTypeCd", (String[]) params.get("docTypeCdList")));
		}
		
		if (params.get("docTypeStatusList") != null) {
			criteria.add(Restrictions.in("docTypeStatus", (String[]) params.get("docTypeStatusList")));
		}
		
		criteria.add(Restrictions.eq("companyId", idCompany));
		
		criteria.addOrder(Order.desc("invoiceDt"));
		criteria.addOrder(Order.desc("id"));
		
		return criteria.list();
	}
	
	@Override
	public List<InvoiceVoucherVO> getInvoiceVoucherList(Long idInv) throws BusinessException {
		Criteria criteria = createCriteria(InvoiceVoucherVO.class);
		criteria.add(Restrictions.eq("idInv", idInv));
		criteria.add(Restrictions.eq("statusCode", CRMUtils.VOUCHER_ACTIVE));
		List<InvoiceVoucherVO> invoiceVoucherList = criteria.list();
		return invoiceVoucherList;
	}
}
