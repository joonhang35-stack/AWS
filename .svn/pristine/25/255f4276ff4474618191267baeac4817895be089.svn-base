	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.InvoiceDAO#updateCashBookInvoices(com.bcs.zsg.sales.vo.InvoiceVO)
	 */
	@Override
	public void updateCashBookInvoices(InvoiceVO invoiceVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("update inv_pmnt_cashbook_link l, invoice i, invoice_pmnt ip ").
			append("set l.status_cd = :statusCdDel, l.dt_upd = now(), l.upd_by = :updBy ").
		append("where i.id = ip.id_inv and ip.id = l.id_inv_pmnt and l.id_company = :idCompany and i.id = :invoiceId and ip.status_cd = :statusCdDel and l.status_cd = :statusCdAct ");
		Query query = createSQLQuery(sb.toString());
		query.setParameter("updBy", BaseContext.getUserFullName() == null ? BaseContext.getLoginId() : BaseContext.getUserFullName());
		query.setParameter("idCompany", invoiceVO.getCompanyId());
		query.setParameter("invoiceId", invoiceVO.getId());
		query.setParameter("statusCdDel", BaseConstant.STATUS_DELETED);
		query.setParameter("statusCdAct", BaseConstant.STATUS_ACTIVE);
		query.executeUpdate();
		
		sb = new StringBuilder();
		sb.append("update cash_book c, ").
			append("(select l.id_cash_book, group_concat(if(l.status_cd='A', l.invoice_no, null) order by if(l.status_cd='A', l.invoice_no, null)) as 'invoices' ").
			append("from inv_pmnt_cashbook_link l, (select * from inv_pmnt_cashbook_link where id_invoice = :invoiceId group by id_cash_book) i ").
			append("where l.id_company = i.id_company and l.id_cash_book = i.id_cash_book and l.id_company = :idCompany ").
			append("group by l.id_cash_book) a ").
		append("set c.invoices = a.invoices ").
		append("where c.id = a.id_cash_book ");
		query = createSQLQuery(sb.toString());
		query.setParameter("idCompany", invoiceVO.getCompanyId());
		query.setParameter("invoiceId", invoiceVO.getId());
		query.executeUpdate();
	}
	
