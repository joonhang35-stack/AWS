	/* (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.InvoiceDAO#getEmployeeViewList(java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<EmployeeViewVO> getEmployeeViewList(Long companyId) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("select e.id as idEmployee, u.id as idUser, u.user_name, u.email, e.full_name, u.login_id, e.nick_name, e.category, e.department from employee e left join sec_user u on e.u_sec_user = u.uuid ");
		sb.append("where e.id_company = :idCompany and e.u_sec_user != 'superman' and u.status_cd = 'A'");
		sb.append("order by u.user_name ");
		
		Query query = createSQLQuery(sb.toString());
		query.setParameter("idCompany", companyId);
		//query.setParameter("department", str);
		
		List<Object> results = query.list();
		List<EmployeeViewVO> employeeList = new ArrayList<EmployeeViewVO>();

		for (Iterator<Object> it = results.iterator(); it.hasNext();) {
			Object[] row = (Object[]) it.next();
			EmployeeViewVO vo = new EmployeeViewVO();
			vo.setUserVO(new UserVO());
			
			vo.setId(((BigInteger) row[0]).longValue());
			vo.getUserVO().setId(((BigInteger) row[1]).longValue());
			vo.getUserVO().setName((String) row[2]);
			vo.getUserVO().setEmailAddress((String) row[3]);
			vo.setFullName((String) row[4]);
			if (row[5] != null)	vo.getUserVO().setLoginId((String) row[5]);
			if (row[6] != null)	vo.getUserVO().setNickname((String) row[6]);
			if (row[7] != null)	vo.setCategory((String) row[7]);
			if (row[8] != null)	vo.setDepartment((String) row[8]);
			
			employeeList.add(vo);
		}
		return employeeList;
	}
	
