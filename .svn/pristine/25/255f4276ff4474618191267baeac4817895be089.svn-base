			vo.getUserVO().setEmailAddress((String) row[4] );
			employeeList.add(vo);
		}
		return employeeList;
	}
	
	/*
	 * 
	 */
	@Override
	public void updateInvoicePaymentRef(Long companyId, String creditNoteNo, Long creditNoId, Long invPmntId) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		sb.append("update invoice_pmnt set id_credit_note = null, ref_no = '' where id_credit_note = :creditNoId ");
		Query query = createSQLQuery(sb.toString());
		query.setParameter("creditNoId", creditNoId);
		query.executeUpdate();
		
//		System.out.println("CYY companyId: " + companyId);
//		System.out.println("CYY creditNoteNo: " + creditNoteNo);
//		System.out.println("CYY creditNoId: " + creditNoId);
//		System.out.println("CYY invPmntId: " + invPmntId);
		
		sb = new StringBuilder();
		sb.append("update invoice i, invoice_pmnt p ");
		sb.append("set p.ref_no = :refNo, ");
		sb.append("p.id_credit_note = :creditNoId ");
		sb.append("where i.id_company = :idCompany and i.doc_type_cd in ('I','P') and i.id = p.id_inv and p.id = :invPmntId ");
		sb.append("and p.status_cd = :statusCd and p.pmnt_type_cd = 'credit_note' ");
		
//		System.out.println("InvoiceDAOImpl.updateInvoicePaymentRef()");
//		System.out.println(sb.toString());
		
		query = createSQLQuery(sb.toString());
		query.setParameter("refNo", "CN" + creditNoteNo);
		query.setParameter("idCompany", companyId);
		query.setParameter("creditNoId", creditNoId);
		query.setParameter("invPmntId", invPmntId);
		query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
		query.executeUpdate();
	}
	
	@Override
	public void updatePsPaymentRef(Long companyId, String creditNoteNo, Long creditNoId, Long invPmntId) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		// no need clear id_credit_note, cuz if updatePSInvoicePaymentRef is called, then updateInvoicePaymentRef will be called before
//		sb.append("update invoice_pmnt set id_credit_note = null, ref_no = '' where id_credit_note = :creditNoId and  ");
//		Query query = createSQLQuery(sb.toString());
