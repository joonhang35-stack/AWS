	/* (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.InvoiceDAO#getInvoiceListNoCN(com.bcs.zsg.sales.vo.InvoiceVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<InvoiceVO> getInvoiceListNoCN(InvoiceVO invoiceVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		/*sb.append("select i.id,i.code,i.dt_inv,i.amount, ");
		sb.append("c.id AS 'custId', ");
		sb.append("case when c.pc_type_cd = 'C' then o.name when c.pc_type_cd = 'P' then CONCAT_WS(' ', p.salutation_cd, p.last_name, p.first_name) end as custName, ");
		sb.append("i.id_issuer,i.id_saler, c.code as custCd ");
		sb.append("from invoice i ");
		sb.append("inner join customer c on c.id = i.id_customer left join person p on (c.pc_type_cd = 'P' and c.id_pc = p.id) ");
		sb.append("left join corporate o on (c.pc_type_cd = 'C' AND c.id_corporate = o.id ) ");
		sb.append("left join person p2 on (c.pc_type_cd = 'C' and o.id_person = p2.id) ");
		sb.append("where i.id_company = " + invoiceVO.getCompanyId() + " and i.doc_type_cd = 'I' ");
		sb.append("and i.code not in (select cn_inv_no from invoice where id_company = " + invoiceVO.getCompanyId() + " and doc_type_cd = 'C' and status_cd not in ('CC', 'VD')) ");
		sb.append("and i.id in (select id_inv from invoice_pmnt where status_cd = 'A' and pmnt_type_cd = 'credit_note') ");
		sb.append("order by i.dt_inv desc, i.id desc ");*/
		
		sb.append("select iv.id, iv.code, iv.dt_inv, iv.amount, ").
			append("c.id AS 'custId', ").
			append("case when c.pc_type_cd = 'C' then o.name when c.pc_type_cd = 'P' then CONCAT_WS(' ', (case when p.salutation_cd != '"+ LookupItemConstant.SALUTATION_EMPTY_CD +"' then p.salutation_cd else '' end), p.last_name, p.first_name) end as custName, ").
			append("iv.id_issuer,iv.id_saler, c.code as custCd, ip.amount as amtPaid, ip.ref_no, ip.id as invPmntId, iv.doc_type_cd, iv.doc_type_status, iv.ps_no ").
		append("from invoice iv ").
			append("inner join customer c on c.id = iv.id_customer left join person p on (c.pc_type_cd = 'P' and c.id_pc = p.id) ").
			append("left join corporate o on (c.pc_type_cd = 'C' AND c.id_corporate = o.id ) ").
			append("left join person p2 on (c.pc_type_cd = 'C' and o.id_person = p2.id), ").
			append("invoice_pmnt ip ").
		append("where iv.id_company = :idCompany and iv.doc_type_cd in ('I', 'P') and ip.status_cd = 'A' ").
			append("and iv.id = ip.id_inv and ip.pmnt_type_cd = 'credit_note' and ifnull(ip.id_credit_note, '') = '' ").
			append("and iv.status_cd != 'VD' ").
		append("order by iv.dt_inv desc, iv.id desc ");
		
		Query query = createSQLQuery(sb.toString());
		query.setParameter("idCompany", invoiceVO.getCompanyId());

		List<Object> results = query.list();
		List<InvoiceVO> invoiceList = new ArrayList<InvoiceVO>();

		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			InvoiceVO vo = new InvoiceVO();
			vo.setId(((BigInteger) row[0]).longValue()); 
			vo.setCode((String) row[1]);   
			vo.setInvoiceDt((Date) row[2]);   
			vo.setAmount(Double.parseDouble(row[3].toString()));        
			if(row[4] != null ) vo.setCustomerId( Long.parseLong(row[4].toString()));    
			
			vo.setCustName(row[5].toString());    
			vo.setIssuerId(Long.parseLong(row[6].toString()));
			vo.setSalerId(Long.parseLong(row[7].toString()));
			if(row[8] != null ) vo.setCustCd((String) row[8]);
			vo.setAmtPaid(Double.parseDouble(row[9].toString()));
			vo.setRefNo(row[10].toString());
			vo.setInvPmntId(((BigInteger) row[11]).longValue());
			vo.setDocTypeCd((String) row[12]);
			vo.setDocTypeStatus((String) row[13]);
			vo.setPsNo((String) row[14]);
			
			// don't show converted ps crdt_note pmnt
			// to avoid duplication
			if (StringUtils.isNotBlank(vo.getDocTypeCd()) && vo.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_PAX_STMT)
					&& StringUtils.isNotBlank(vo.getDocTypeStatus()) && vo.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_CONVERTED)) {
				continue;
			}
			
			invoiceList.add(vo);
		}
		return invoiceList;
	}
	
