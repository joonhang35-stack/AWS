	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.InvoiceDAO#updateInvoiceCode(java.lang.String, java.lang.String)
	 */
	@Override
	public void updateInvoiceCode(String uuid, String code, String docTypeCd) throws BusinessException {
		updateInvoiceCode(uuid, code, docTypeCd, null);
	}
	
	@Override
	public void updateInvoiceCode(String uuid, String code, String docTypeCd, String rnNo) throws BusinessException {
		String sysCd = CommonConstant.SYS_NUM_CD_INVC;
		// Credit Note
		if (docTypeCd.equals("C")) {
			sysCd = CommonConstant.SYS_NUM_CD_CRDT_NOTE;
		} else if (docTypeCd.equals("P")) {
			sysCd = CommonConstant.SYS_NUM_CD_PAX_STMT;
		}
		
		StringBuilder sb = new StringBuilder();
		sb.append(" UPDATE InvoiceVO SET code = :code ");
		
		if (docTypeCd.equals("P")) {
			sb.append(" , ps_no = :code ");
		}
		
		if (docTypeCd.equals("C") && StringUtils.isNotEmpty(rnNo)) {
			sb.append(" , rn_no = '" + rnNo + "' ");
		}
		
		sb.append(" WHERE docTypeCd = :docTypeCd AND code = :uuid ");
		
		Query query = createQuery(sb.toString());
		query.setString("code", code);
		query.setString("docTypeCd", docTypeCd);
		query.setString("uuid", uuid);
		query.executeUpdate();
		
		sb = new StringBuilder();
		sb.append("UPDATE AcctTransVO SET sysNo = :code, refNo = REPLACE(refNo, :uuid, :code), source = REPLACE(source, :uuid, :code) WHERE sysCode = :sysCode AND sysNo = :uuid");
		
		query = createQuery(sb.toString());
		query.setString("code", code);
		query.setString("sysCode", sysCd);
		query.setString("uuid", uuid);
		query.executeUpdate();
	}
	
	@Override
	public void updateRfndNoteCode(Long id, String docTypeCd, String rnNo) throws BusinessException {
		String sysCd = CommonConstant.SYS_NUM_CD_CRDT_NOTE;
		
		StringBuilder sb = new StringBuilder();
		sb.append(" UPDATE InvoiceVO SET rn_no = :rnNo ");
		sb.append(" WHERE docTypeCd = :docTypeCd AND id = :id ");
		
		Query query = createQuery(sb.toString());
		query.setLong("id", id);
		query.setString("docTypeCd", docTypeCd);
		query.setString("rnNo", rnNo);
		query.executeUpdate();
	}
	
