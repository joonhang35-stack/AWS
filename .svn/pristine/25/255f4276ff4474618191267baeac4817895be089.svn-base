	@Override
	public String getInvPmntHistTooltip(Long invId, Long histId) throws BusinessException {
	    StringBuilder sb = new StringBuilder();
	    sb.append("SELECT GROUP_CONCAT(CONCAT(DATE_FORMAT(min_dt_upd, '%d-%b-%Y %h:%i:%s %p'), ' by ', upd_by, '<br/>') ");
	    sb.append("ORDER BY min_dt_upd DESC SEPARATOR '') AS upd_hist_list ");
	    sb.append("FROM ( ");
	    sb.append("    SELECT MIN(dt_upd) AS min_dt_upd, upd_by ");
	    sb.append("    FROM invoice_pmnt_history ");
	    sb.append("    WHERE id_inv = :invId AND id_hist = :histId ");
	    sb.append("    GROUP BY id_issuer, dt_pmnt, code, ");
	    sb.append("        pmnt_type_cd, ref_no, pmnt_for, received_from, amount, status_cd ");
	    sb.append(") AS grouped_data");

	    SQLQuery query = (SQLQuery) createSQLQuery(sb.toString());
	    query.addScalar("upd_hist_list");
	    query.setParameter("invId", invId);
	    query.setParameter("histId", histId);

	    String result = (String) query.uniqueResult();

	    return result != null ? result : "";
	}


	@Override
	public InvoiceVO getInvoiceByCode(String code) throws BusinessException {
		return getInvoiceByCode(code, SalesConstant.DOC_TYPE_CD_INVC);
	}
	
	@Override
	public InvoiceVO getInvoiceByCode(String code, String docTypeCd) throws BusinessException {
		Criteria criteria = getSession().createCriteria(InvoiceVO.class);
		if (docTypeCd.equals(SalesConstant.DOC_TYPE_CD_INVC) || docTypeCd.equals(SalesConstant.DOC_TYPE_CD_CRDT_NOTE))	
			criteria.add(Restrictions.eq("code", code));
		else if (docTypeCd.equals(SalesConstant.DOC_TYPE_CD_PAX_STMT))	
			criteria.add(Restrictions.eq("psNo", code));
		criteria.add(Restrictions.eq("docTypeCd", docTypeCd));
		return (InvoiceVO) criteria.uniqueResult();
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<PersonEmailVO> getPersonEmailListByPersonId(Long personId) throws BusinessException {
		Criteria criteria = getSession().createCriteria(PersonEmailVO.class);
		criteria.add(Restrictions.eq("idPerson", personId));
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
		criteria.addOrder(Order.desc("isPrimary"));
		List<PersonEmailVO> emailList = criteria.list();
		return emailList;
	}

	@Override
	public void updateStatus(InvoiceVO invoiceVO) throws BusinessException {
		String updatedBy = BaseContext.getUserFullName();
		if (StringUtils.isBlank(updatedBy)) updatedBy = BaseContext.getLoginId();
		
		Query query = createSQLQuery("update invoice set status_cd = :statusCd, upd_by = :updatedBy, dt_upd = now() where id = :id");
		query.setParameter("statusCd", invoiceVO.getStatusCd());
		query.setParameter("updatedBy", updatedBy);
		query.setParameter("id", invoiceVO.getId());
		query.executeUpdate();
	}
	
	@Override
	public void updateInvoiceAmount(InvoiceVO invoiceVO, Boolean updVersion, Boolean updRemarks) throws BusinessException {
		String updatedBy = BaseContext.getUserFullName();
		if (StringUtils.isBlank(updatedBy)) updatedBy = BaseContext.getLoginId();
		
		StringBuilder sb = new StringBuilder();
		sb.append(" update invoice set amount = :amount, balance = :balance, is_inv_paid = :isInvPaid, ");
		if (updRemarks)	sb.append(" remarks = :remarks, internal_remarks = :internalRemarks, ");
		if (updVersion)	sb.append(" version = version + 1, ");
		sb.append(" note_items = :noteItems, ");
		sb.append(" upd_by = :updatedBy, dt_upd = now() ");
		sb.append(" where id = :id ");
		
		Query query = createSQLQuery(sb.toString());
		query.setParameter("amount", invoiceVO.getAmount());
		query.setParameter("balance", invoiceVO.getBalance());
		query.setParameter("isInvPaid", invoiceVO.getIsInvPaid());
		if (updRemarks)	{
			query.setParameter("remarks", invoiceVO.getRemarks());
			query.setParameter("internalRemarks", invoiceVO.getInternalRemarks());
		}
		query.setParameter("noteItems", invoiceVO.getNoteItems());
		query.setParameter("updatedBy", updatedBy);
		query.setParameter("id", invoiceVO.getId());
		query.executeUpdate();
	}
	
