			} 
			//if(row[9] != null ) vo.setTourCd( row[9].toString());   
			if(row[9] != null ) vo.setCustomerId( Long.parseLong(row[9].toString()));   
			if(row[10] != null ) vo.setSalerName( row[10].toString());   
			//vo.setCustName( row[11].toString() + " " + row[12].toString() );   
			vo.setCustName(row[12].toString() + " " + row[11].toString());   
			vo.setCustSalutation(row[13].toString() );
			vo.setCoName((row[14] != null) ? row[14].toString() : null);
			vo.setCnInvNo((row[15] != null) ? row[15].toString() : null);
			vo.setCustCd((row[16] != null) ? row[16].toString() : null);
			vo.setRnNo((row[17] != null) ? row[17].toString() : null);
			vo.seteInvoiceStatus((row[18] != null) ? row[18].toString() : null);
			vo.setCnPsNo((row[19] != null) ? row[19].toString() : null);
			invoiceList.add(vo);
		}
		return invoiceList;
