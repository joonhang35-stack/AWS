				append("group by b.id) ex on a.sys_cd = 'purc_bill' and a.sys_no = ex.sys_no ").
			append("where a.id_company = :idCompany and ").
			append("a.status_cd = :statusCd and ").
			append("a.id_acct = :acctId ").
