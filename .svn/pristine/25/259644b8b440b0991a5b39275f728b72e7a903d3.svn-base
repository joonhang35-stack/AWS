				append("limit 1 ").
				append(") as 'postCode', ").*/
				
				append("(select y.code ").
					append("from account_trans x left join account y on x.id_acct = y.id ").
					append("where x.id_company = :idCompany and x.status_cd = :statusCd ");
						if (searchParamVO.getObj3()!=null && searchParamVO.getObj4()!=null) {
							sb.append("and date(x.dt_trans) between date(:fromDate) and date(:toDate) ");
						}
						sb.append("and x.id_acct != :acctId ").
						append("and x.sys_cd = a.sys_cd and x.sys_no = a.sys_no ").
					append("limit 1 ").
				append(") as 'postCode', ").
				
				
				append("b.prefix_id, a.sys_cd, a.sys_no, ").
				append("case ").
					append("when a.sys_cd = 'purc_bill' then ").
						append("if(ex1.bp_code is null, a.sys_no, concat(a.sys_no,' (', ex1.bp_code, ')')) ").
					append("when a.sys_cd = 'bank_pmnt' then ").
						append("if(ex2.pb_code is null, a.sys_no, concat(a.sys_no,' (', ex2.pb_code, ')')) ").
					append("else ").
						append("a.sys_no ").
				append("end as pb_code ").
				append(", a.tax_code, (select acct.code from account acct where acct.id = a.id_acct) as gl_code, ").
				append("case ").
					append("when a.sys_cd='bank_adjm' OR a.sys_cd = 'bank_deps' OR a.sys_cd = 'bank_dpmt' OR a.sys_cd = 'rfnd' then ").
						append("IF(tr1.code IS NULL, '', tr1.code) ").
					append("when a.sys_cd = 'invc' then ").
						append("IF(tr2.code IS NULL, '', tr2.code) ").
					append("when a.sys_cd = 'crdt_note' then ").
						append("IF(tr3.code IS NULL, '', tr3.code) ").
					append("when a.sys_cd = 'purc_bill' then ").
						append("IF(tr4.code IS NULL, '', tr4.code) ").
					append("when a.sys_cd = 'jrnl' then ").
						append("IF(tr5.code IS NULL, '', tr5.code) ").
					append("else ").
						append("'' ").
				append("end as tour_code, ").
				append("case ").
					append("when a.sys_cd='purc_bill' then ").
						append("IF(eob.comments IS NULL, '', eob.comments) ").
					append("else ").
						append("'' ").
				append("end as comnments ").
			append("from account_trans a left join sys_num_conf b on b.id_company = :idCompany and a.sys_cd = b.code ").
			append("left join (select b.code as sys_no, group_concat(bp.code separator ', ') as bp_code ").
				append("from ex_order_bill b, ex_order_bill_pmnt bp ").
				append("where b.id = bp.id_eo_bill and bp.status_cd = :statusCd and b.id_company = :idCompany and b.status_cd not in ('CC', 'VD') ").
				append("group by b.id) ex1 on a.sys_cd = 'purc_bill' and a.sys_no = ex1.sys_no ").
			append("left join (select group_concat(b.code separator ', ') as pb_code, bp.code as sys_no ").
				append("from ex_order_bill b, ex_order_bill_pmnt bp ").
				append("where b.id = bp.id_eo_bill and bp.status_cd = :statusCd and b.id_company = :idCompany and b.status_cd not in ('CC', 'VD') ").
				append("group by bp.code) ex2 on a.sys_cd = 'bank_pmnt' and a.sys_no = ex2.sys_no ").
			append("left join ").
				append("cash_book cb ON ((a.sys_cd = 'bank_adjm'and cb.sys_cd='bank_adjm') OR (a.sys_cd = 'bank_deps'and cb.sys_cd='bank_deps') OR (a.sys_cd = 'bank_pmnt'and cb.sys_cd='bank_pmnt') OR (a.sys_cd = 'rfnd'and cb.sys_cd='rfnd')) and cb.sys_no = a.sys_no ").
			append("left join ").
				append("tour_dep tr1 ON tr1.id = cb.id_tour_dep ").
			append("left join ").
				append("invoice iv ON iv.doc_type_cd = 'I' and a.sys_cd = 'invc' and a.sys_no = iv.code ").
			append("left join ").
				append("invoice iv_cn ON iv_cn.doc_type_cd = 'C' and a.sys_cd = 'crdt_note' and a.sys_no = iv_cn.code ").
			append("left join ").
				append("invoice iv_cn_cd ON iv_cn_cd.doc_type_cd = 'I' and iv_cn_cd.code = iv_cn.cn_inv_no ").
			append("left join ").
				append("invoice ps_cn_cd ON ps_cn_cd.doc_type_cd = 'P' and ps_cn_cd.ps_no = iv_cn.cn_ps_no ").
			append("left join ").
				append("tour_dep tr2 ON tr2.id = iv.id_tour_dep ").
			append("left join ").
				append("tour_dep tr3 ON tr3.id = if(iv_cn_cd.id_tour_dep is not null, iv_cn_cd.id_tour_dep, ps_cn_cd.id_tour_dep) ").
			append("left join ").
				append("ex_order_bill eob ON a.sys_no = eob.code and a.sys_cd = 'purc_bill' ").
			append("left join ").
				append("tour_dep tr4 ON tr4.id = eob.id_tour_dep ").
			append("left join ").
				append("journal jn ON a.sys_no = jn.sys_no and a.sys_cd = 'jrnl' ").
			append("left join ").
				append("tour_dep tr5 ON tr5.id = jn.id_tour_dep ").
			append("where a.id_company = :idCompany and ").
			append("a.status_cd = :statusCd and ").
			append("a.id_acct = :acctId ");
			//append("and date(a.dt_trans) between date(:fromYearDate) and date(:toYearDate) ");
			if (searchParamVO.getObj3()!=null && searchParamVO.getObj4()!=null) {
				sb.append("and date(a.dt_trans) between date(:fromDate) and date(:toDate) ");
			}
			sb.append("order by a.dt_trans ");
		}
		
		//Query query = createSQLQuery(sb.toString());
		Query query = session.createSQLQuery(sb.toString());
		if (acctId == 3) {
			query.setTimeout(240);
		}
		query.setParameter("idCompany", idCompany);
		query.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
		query.setParameter("acctId", acctId);
		//query.setParameter("fromYearDate", searchParamVO.getFromDate());
		//query.setParameter("toYearDate", searchParamVO.getToDate());
		if (searchParamVO.getObj3()!=null && searchParamVO.getObj4()!=null) {
			query.setParameter("fromDate", (Date) searchParamVO.getObj3());
			query.setParameter("toDate", (Date) searchParamVO.getObj4());
		}
		
		List<Object> results = query.list();
		List<AcctTransViewVO> acctTransViewList = new ArrayList<AcctTransViewVO>();
		
		BigDecimal reducingBal = new BigDecimal(String.valueOf(acctViewVO.getBfBal()));
		
		//strLogs = "#################Acct Cd: " + acctViewVO.getCode() + "-" + acctViewVO.getSubCode() + " Acct Id: " + acctId +  " Speed: " + (System.currentTimeMillis() - start);
		//System.out.println(strLogs);
		
		// Total No tally on account 4020 Mar 2019
		BigDecimal totalDebit = BigDecimal.ZERO;
		BigDecimal totalCredit = BigDecimal.ZERO;
		
		for (Iterator<Object> it = results.iterator(); it.hasNext();) {
			Object[] row = (Object[]) it.next();
			AcctTransViewVO vo = new AcctTransViewVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setTransDt((Date) row[1]);
			vo.setSource((String) row[2]);
			vo.setDestination((String) row[3]);
			vo.setDebit(Double.parseDouble(row[4].toString()));
			vo.setCredit(Double.parseDouble(row[5].toString()));
			vo.setCode((String) row[6]);
			vo.setSysPrefix((String) row[7]);
			vo.setSysCode((String) row[8]);
			vo.setSysNo((String) row[10]);
			vo.setTaxCode((String) row[11]);
			vo.setGlCode((String) row[12]);
			vo.setTourCd((String) row[13]);
			vo.setPbComment((String) row[14]);
			reducingBal = reducingBal.add(new BigDecimal(String.valueOf(vo.getDebit())));
			reducingBal = reducingBal.subtract(new BigDecimal(String.valueOf(vo.getCredit())));
			vo.setReducingBal(reducingBal.doubleValue());
			
			totalDebit = totalDebit.add(new BigDecimal(String.valueOf(vo.getDebit())));
			totalCredit = totalCredit.add(new BigDecimal(String.valueOf(vo.getCredit())));
			
			acctTransViewList.add(vo);
		}
		acctViewVO.setTotalDebit(totalDebit.doubleValue());
		acctViewVO.setTotalCredit(totalCredit.doubleValue());
		
		return acctTransViewList;
	}

	@Override
	public AcctTransVO getAccountTransFilterReferenceID(Map<String, Object> params) {
		Criteria criteria = getSession().createCriteria(AcctTransVO.class);
		criteria = criteriaRestrictionEq(criteria, params);
		criteria.add(Restrictions.isNull("refId"));
		criteria.add(Restrictions.isNull("type"));
		return (AcctTransVO) criteria.uniqueResult();
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.db.bterp.dao.accttrans.AccountTransViewDAO#updateAcctTransDestinationCust(java.lang.Long, java.lang.Long)
	 */
	@Override
	public void updateAcctTransDestinationCust(Long idCompany, Long customerId) throws BusinessException {
		Session session = this.getSessionFactory().openSession();
		long start = System.currentTimeMillis();
		String strLogs = "";
		
		try {
			session.getTransaction().setTimeout(300);
			session.beginTransaction();
			
			StringBuilder sbPrd = new StringBuilder();
			sbPrd.append("select dt_end from financial_period where id_company = :idCompany and status = -1 order by dt_start desc ");
			Query queryPrd = session.createSQLQuery(sbPrd.toString());
			queryPrd.setParameter("idCompany", idCompany);
			queryPrd.setMaxResults(1);
			Object finDateObj = queryPrd.uniqueResult();
			
			// Invoice
			StringBuilder sbInv = new StringBuilder();
			sbInv.append("update account_trans a, ").
				append("(select iv.code, ").
					append("concat('Cust-', ").
					append("case ").
						append("when cm.pc_type_cd = 'C' then cm.corporate_name ").
						append("else concat(l.description, ' ', ps.last_name, ' ', ps.first_name) ").
					append("end, ' ', cm.code) as 'destination' ").
				append("from invoice iv, customer cm, person ps left join (select code, description from lookup_item where lookup_cat_cd = :salutatn) l on ps.salutation_cd = l.code ").
				append("where ").
					append("iv.id_company = :idCompany and cm.id_company = :idCompany and ").
					append("iv.doc_type_cd IN :invOrCrdtNote and iv.status_cd != :statusCdVoid and ").
					append("iv.id_customer = cm.id and cm.id_pc = ps.id and iv.id_customer = :customerId) b ").
			append("set a.destination = b.destination ").
			append("where ").
				append("a.id_company = :idCompany and a.status_cd = :statusCd and a.sys_cd IN :sysCd and a.sys_no = b.code ");
			if (finDateObj != null) sbInv.append("and date(a.dt_trans) > date(:finDate) ");
			
			Query queryInv = session.createSQLQuery(sbInv.toString());
			queryInv.setParameter("idCompany", idCompany);
			queryInv.setParameterList("sysCd", FunctionUtils.generateArrayFromStr(CommonConstant.SYS_NUM_CD_PAX_STMT, CommonConstant.SYS_NUM_CD_INVC));
			queryInv.setParameter("salutatn", CommonConstant.LOOKUP_CAT_CD_SALUTATN);
			queryInv.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			queryInv.setParameterList("invOrCrdtNote", FunctionUtils.generateArrayFromStr(SalesConstant.DOC_TYPE_CD_PAX_STMT, SalesConstant.DOC_TYPE_CD_INVC));
			queryInv.setParameter("customerId", customerId);
			queryInv.setParameter("statusCdVoid", CommonConstant.STATUS_CD_VOID);
			if (finDateObj != null) queryInv.setParameter("finDate", finDateObj);
			strLogs = "####Invoice records: " + queryInv.executeUpdate();
			logger.error(strLogs);
			//logger.error("################# Update Invoice Speed: " + (System.currentTimeMillis() - start));
			//start = System.currentTimeMillis();
			
			// Credit Note
			StringBuilder sbCN = new StringBuilder();
			sbCN.append("update account_trans a, ").
				append("(select iv.code, ").
					append("concat('Cust-', ").
					append("case ").
						append("when cm.pc_type_cd = 'C' then cm.corporate_name ").
						append("else concat(l.description, ' ', ps.last_name, ' ', ps.first_name) ").
					append("end, ' ', cm.code) as 'destination' ").
				append("from invoice iv, customer cm, person ps left join (select code, description from lookup_item where lookup_cat_cd = :salutatn) l on ps.salutation_cd = l.code ").
				append("where ").
					append("iv.id_company = :idCompany and cm.id_company = :idCompany and ").
					append("iv.doc_type_cd IN :invOrCrdtNote and iv.status_cd != :statusCdVoid and ").
					append("iv.id_customer=cm.id and cm.id_pc=ps.id and iv.id_customer = :customerId) b ").
			append("set a.destination = b.destination ").
			append("where ").
				append("a.id_company = :idCompany and a.status_cd = :statusCd and a.sys_cd IN :sysCd and a.sys_no = b.code ");
			if (finDateObj != null) sbCN.append("and date(a.dt_trans) > date(:finDate) ");
			
			Query queryCN = session.createSQLQuery(sbCN.toString());
			queryCN.setParameter("idCompany", idCompany);
			queryCN.setParameterList("sysCd", FunctionUtils.generateArrayFromStr(CommonConstant.SYS_NUM_CD_INVC));
			queryCN.setParameter("salutatn", CommonConstant.LOOKUP_CAT_CD_SALUTATN);
			queryCN.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			queryCN.setParameterList("invOrCrdtNote", FunctionUtils.generateArrayFromStr(SalesConstant.DOC_TYPE_CD_CRDT_NOTE));
			queryCN.setParameter("customerId", customerId);
			queryCN.setParameter("statusCdVoid", CommonConstant.STATUS_CD_VOID);
			if (finDateObj != null) queryCN.setParameter("finDate", finDateObj);
			strLogs = "####Credit Note records: " + queryCN.executeUpdate();
			logger.error(strLogs);
			//logger.error("################# Update Credit Note Speed: " + (System.currentTimeMillis() - start));
			//start = System.currentTimeMillis();
			
			// Refund [Cash Book]
			StringBuilder sbCBRfnd = new StringBuilder();
			sbCBRfnd.append("update cash_book cb, bank b, customer cm, person ps left join (select code, description from lookup_item where lookup_cat_cd = :salutatn) l on ps.salutation_cd = l.code ").
			append("set cb.payee = (case when cm.pc_type_cd = 'C' then cm.corporate_name else concat(l.description, ' ', ps.last_name, ' ', ps.first_name) end) ").
			append("where ").
				append("b.id_company = :idCompany and cm.id_company = :idCompany and b.status_cd = :statusCd and cb.status_cd = :statusCd and cb.sys_cd = :sysCd and ").
				append("cb.id_bank = b.id and ").
				append("cb.id_customer = cm.id and cm.id_pc = ps.id ").
				append("and cb.id_customer = :customerId ").
				append("and cb.payee != (case when cm.pc_type_cd = 'C' then cm.corporate_name else concat(l.description, ' ', ps.last_name, ' ', ps.first_name) end) ");
			if (finDateObj != null) sbCBRfnd.append("and date(cb.dt_trans) > date(:finDate) ");
			
			Query queryCBRfnd = session.createSQLQuery(sbCBRfnd.toString());
			queryCBRfnd.setParameter("idCompany", idCompany);
			queryCBRfnd.setParameter("sysCd", CommonConstant.SYS_NUM_CD_RFND);
			queryCBRfnd.setParameter("salutatn", CommonConstant.LOOKUP_CAT_CD_SALUTATN);
			queryCBRfnd.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			queryCBRfnd.setParameter("customerId", customerId);
			if (finDateObj != null) queryCBRfnd.setParameter("finDate", finDateObj);
			strLogs = "####CB - Refund records: " + queryCBRfnd.executeUpdate();
			logger.error(strLogs);
			//logger.error("################# Update Refund [Cash Book] Speed: " + (System.currentTimeMillis() - start));
			//start = System.currentTimeMillis();
			
			// Refund [Account Trans]
			StringBuilder sbRfnd = new StringBuilder();
			sbRfnd.append("update account_trans a join ").
			append("(select cb.sys_no, ").
				append("concat(cb.remarks,' To-', case when cm.pc_type_cd = 'C' then cm.corporate_name else concat(l.description, ' ', ps.last_name, ' ', ps.first_name) end) as 'destination' ").
			append("from cash_book cb, bank b, customer cm, person ps left join (select code, description from lookup_item where lookup_cat_cd = :salutatn) l on ps.salutation_cd = l.code ").
			append("where b.id_company = :idCompany and cm.id_company = :idCompany and ").
				append("b.status_cd = :statusCd and cb.status_cd = :statusCd and ").
				append("cb.sys_cd = :sysCd and cb.id_bank = b.id and ").
				append("cb.id_customer=cm.id and cm.id_pc=ps.id and ").
				append("cb.id_customer = :customerId) c on a.sys_no = c.sys_no ").
			append("set a.destination = c.destination ").
			append("where ").
				append("a.id_company = :idCompany and a.status_cd = :statusCd and a.sys_cd = :sysCd ");
			if (finDateObj != null) sbRfnd.append("and date(a.dt_trans) > date(:finDate) ");
			
			Query queryRfnd = session.createSQLQuery(sbRfnd.toString());
			queryRfnd.setParameter("idCompany", idCompany);
			queryRfnd.setParameter("sysCd", CommonConstant.SYS_NUM_CD_RFND);
			queryRfnd.setParameter("salutatn", CommonConstant.LOOKUP_CAT_CD_SALUTATN);
			queryRfnd.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			queryRfnd.setParameter("customerId", customerId);
			if (finDateObj != null) queryRfnd.setParameter("finDate", finDateObj);
			strLogs = "####Trans - Refund records: " + queryRfnd.executeUpdate();
			logger.info(strLogs);
			//logger.error("################# Update Refund [Account Trans] Speed: " + (System.currentTimeMillis() - start));
			//start = System.currentTimeMillis();
			
			// Deposite - bank_deps [Cash Book]
			StringBuilder sbCBDeps = new StringBuilder();
			sbCBDeps.append("update cash_book cb, bank b, customer cm, person ps left join (select code, description from lookup_item where lookup_cat_cd = :salutatn) l on ps.salutation_cd = l.code ").
			append("set cb.payee = (case when cm.pc_type_cd = 'C' then cm.corporate_name else concat(l.description, ' ', ps.last_name, ' ', ps.first_name) end) ").
			append("where ").
				append("b.id_company = :idCompany and cm.id_company = :idCompany and b.status_cd = :statusCd and cb.status_cd = :statusCd and cb.sys_cd = :sysCd and ").
				append("cb.id_bank = b.id and ").
				append("cb.id_customer = cm.id and cm.id_pc = ps.id ").
				append("and cb.id_customer = :customerId ").
				append("and cb.payee != (case ").
					append("when cm.pc_type_cd = 'C' then cm.corporate_name ").
					append("else concat(l.description, ' ', ps.last_name, ' ', ps.first_name) ").
				append("end) ");
			if (finDateObj != null) sbCBDeps.append("and date(cb.dt_trans) > date(:finDate) ");
			
			Query queryCBDeps = session.createSQLQuery(sbCBDeps.toString());
			queryCBDeps.setParameter("idCompany", idCompany);
			queryCBDeps.setParameter("sysCd", CommonConstant.SYS_NUM_CD_BANK_DEPS);
			queryCBDeps.setParameter("salutatn", CommonConstant.LOOKUP_CAT_CD_SALUTATN);
			queryCBDeps.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			queryCBDeps.setParameter("customerId", customerId);
			if (finDateObj != null) queryCBDeps.setParameter("finDate", finDateObj);
			strLogs = "####CB - Deposite records: " + queryCBDeps.executeUpdate();
			logger.error(strLogs);
			//logger.error("################# Update Deposite - bank_deps [Cash Book] Speed: " + (System.currentTimeMillis() - start));
			//start = System.currentTimeMillis();
			
			// Deposite - bank_deps [Account Trans]
			StringBuilder sbDeps = new StringBuilder();
			sbDeps.append("update account_trans a join ").
			append("(select cb.sys_no, ").
				append("concat(cb.remarks,' Cust-', ").
				append("case ").
					append("when cm.pc_type_cd = 'C' then cm.corporate_name ").
					append("else concat(l.description, ' ', ps.last_name, ' ', ps.first_name) ").
				append("end, ' ', cm.code) as 'destination' ").
			append("from cash_book cb, bank b, customer cm, person ps left join (select code, description from lookup_item where lookup_cat_cd = :salutatn) l on ps.salutation_cd = l.code ").
			append("where b.id_company = :idCompany and cm.id_company = :idCompany and ").
				append("b.status_cd = :statusCd and cb.status_cd = :statusCd and ").
				append("cb.sys_cd = :sysCd and cb.id_bank = b.id and ").
				append("cb.id_customer = cm.id and cm.id_pc = ps.id and ").
				append("cb.id_customer = :customerId) c on a.sys_no = c.sys_no ").
			append("set a.destination = c.destination ").
			append("where ").
				append("a.id_company = :idCompany and a.status_cd = :statusCd and a.sys_cd = :sysCd ");
			if (finDateObj != null) sbDeps.append("and date(a.dt_trans) > date(:finDate) ");
			
			Query queryDeps = session.createSQLQuery(sbDeps.toString());
			queryDeps.setParameter("idCompany", idCompany);
			queryDeps.setParameter("sysCd", CommonConstant.SYS_NUM_CD_BANK_DEPS);
			queryDeps.setParameter("salutatn", CommonConstant.LOOKUP_CAT_CD_SALUTATN);
			queryDeps.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			queryDeps.setParameter("customerId", customerId);
			if (finDateObj != null) queryDeps.setParameter("finDate", finDateObj);
			strLogs = "####Trans - Deposite records: " + queryDeps.executeUpdate();
			logger.error(strLogs);
			//logger.error("################# Update Deposite - bank_deps [Account Trans] Speed: " + (System.currentTimeMillis() - start));
			//start = System.currentTimeMillis();
			
			session.getTransaction().commit();
			strLogs = "################# updateAcctTransDestinationCust Speed: " + (System.currentTimeMillis() - start);
			logger.error(strLogs);
			
		} catch (Exception e) {
			session.getTransaction().rollback();
			throw e;
			
		} finally {
			session.close();
		}
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.db.bterp.dao.accttrans.AccountTransViewDAO#updateAcctTransDestinationSpplr(java.lang.Long, java.lang.Long)
	 */
	@Override
	public void updateAcctTransDestinationSpplr(Long idCompany, Long supplierId) throws BusinessException {
		Session session = this.getSessionFactory().openSession();
		long start = System.currentTimeMillis();
		String strLogs = "";
		
		try {
			session.getTransaction().setTimeout(300);
			session.beginTransaction();
			
			System.out.println("@@@@@@@@@@@@@@@@@@supplierId: " + supplierId);
			
			StringBuilder sbPrd = new StringBuilder();
			sbPrd.append("select dt_end from financial_period where id_company = :idCompany and status = -1 order by dt_start desc ");
			Query queryPrd = session.createSQLQuery(sbPrd.toString());
			queryPrd.setParameter("idCompany", idCompany);
			queryPrd.setMaxResults(1);
			Object finDate = queryPrd.uniqueResult();
			
			// Bank Payment - bank_pmnt [Cash Book]
			StringBuilder sbCBBP = new StringBuilder();
			sbCBBP.append("update cash_book cb, bank b, ( ").
					append("select s.id, s.sys_no, c.name ").
					append("from supplier s ").
						append("left join person p on s.id_person=p.id ").
						append("left join corporate c on p.id=c.id_person ").
					append("where s.id_company = :idCompany and s.id = :supplierId ").
					append(") sp ").
			append("set cb.payee = sp.name ").
			append("where b.id_company = :idCompany and b.status_cd = :statusCd and cb.status_cd = :statusCd and cb.sys_cd = :sysCd and ").
				append("cb.id_bank = b.id and cb.id_supplier=sp.id ").
				append("and cb.payee != sp.name ");
			if (finDate != null) sbCBBP.append("and date(cb.dt_trans) > date(:finDate) ");
			
			Query queryCBBP = session.createSQLQuery(sbCBBP.toString());
			queryCBBP.setParameter("idCompany", idCompany);
			queryCBBP.setParameter("sysCd", CommonConstant.SYS_NUM_CD_BANK_PMNT);
			queryCBBP.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			queryCBBP.setParameter("supplierId", supplierId);
			if (finDate != null) queryCBBP.setParameter("finDate", finDate);
			strLogs = "####CB - Bank Payment records: " + queryCBBP.executeUpdate();
			logger.error(strLogs);
			//logger.error("################# Update Bank Payment - bank_pmnt [Cash Book] Speed: " + (System.currentTimeMillis() - start));
			//start = System.currentTimeMillis();
			
			// Bank Payment - bank_pmnt [Account Trans]
			StringBuilder sbBP = new StringBuilder();
			sbBP.append("update account_trans a, ").
				append("(select cb.sys_cd, cb.sys_no, cb.id_customer, ").
					append("concat(cb.remarks,' To-', sp.name) as 'destination' ").
				append("from cash_book cb, bank b, ( ").
					append("select s.id, c.name ").
					append("from supplier s ").
						append("left join person p on s.id_person=p.id ").
						append("left join corporate c on p.id=c.id_person ").
					append("where s.id_company = :idCompany and s.id = :supplierId ").
					append(") sp ").
					append("where b.id_company = :idCompany and b.status_cd = :statusCd and cb.status_cd = :statusCd and cb.sys_cd = :sysCd and ").
						append("cb.id_bank = b.id and ").
				append("cb.id_supplier=sp.id) c ").
			append("set a.destination = c.destination ").
			append("where ").
			append("a.id_company = :idCompany and a.status_cd = :statusCd and a.sys_cd = :sysCd and ").
			append("a.sys_no = c.sys_no and a.destination != c.destination ");
			if (finDate != null) sbBP.append("and date(a.dt_trans) > date(:finDate) ");
			
			Query queryBP = session.createSQLQuery(sbBP.toString());
			queryBP.setParameter("idCompany", idCompany);
			queryBP.setParameter("sysCd", CommonConstant.SYS_NUM_CD_BANK_PMNT);
			queryBP.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			queryBP.setParameter("supplierId", supplierId);
			if (finDate != null) queryBP.setParameter("finDate", finDate);
			strLogs = "####Trans - Bank Payment records: " + queryBP.executeUpdate();
			logger.error(strLogs);
			//logger.error("################# Update Bank Payment - bank_pmnt [Account Trans] Speed: " + (System.currentTimeMillis() - start));
			//start = System.currentTimeMillis();
			
			// Purchase Bill - purc_bill
			StringBuilder sbPB = new StringBuilder();
			sbPB.append("update account_trans a, ").
			append("( ").
				append("select ex.code, ex.id_supplier, ex.cn_no, ").
					append("concat_ws(' ', sp.name, sp.sys_no, concat('Inv-', ex.cn_no)) as 'destination' ").
				append("from ex_order_bill ex, ").
					append("(select s.id, s.sys_no, c.name ").
					append("from supplier s ").
					append("left join person p on s.id_person=p.id ").
					append("left join corporate c on p.id=c.id_person ").
					append("where s.id_company= :idCompany and s.id = :supplierId ").
					append(") sp ").
				append("where ex.id_company= :idCompany and ex.status_cd != :statusCdVoid and ").
					append("ex.id_supplier=sp.id ").
			append(") b ").
			append("set a.destination = b.destination ").
			append("where ").
				append("a.id_company= :idCompany and a.status_cd = :statusCd and a.sys_cd = :sysCd and ").
				append("a.sys_no = b.code and a.destination != b.destination ");
			if (finDate != null) sbPB.append("and date(a.dt_trans) > date(:finDate) ");
			
			Query queryPB = session.createSQLQuery(sbPB.toString());
			queryPB.setParameter("idCompany", idCompany);
			queryPB.setParameter("sysCd", CommonConstant.SYS_NUM_CD_PURC_BILL);
			queryPB.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			queryPB.setParameter("supplierId", supplierId);
			queryPB.setParameter("statusCdVoid", CommonConstant.STATUS_CD_VOID);
			if (finDate != null) queryPB.setParameter("finDate", finDate);
			strLogs = "####Trans - Purchase Bill records: " + queryPB.executeUpdate();
			logger.error(strLogs);
			//logger.error("################# Update Purchase Bill - purc_bill Speed: " + (System.currentTimeMillis() - start));
			//start = System.currentTimeMillis();
			
			session.getTransaction().commit();
			strLogs = "################# updateAcctTransDestinationSpplr Speed: " + (System.currentTimeMillis() - start);
			logger.error(strLogs);
			
		} catch (Exception e) {
			session.getTransaction().rollback();
			throw e;
			
		} finally {
			session.close();
		}
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.db.bterp.dao.accttrans.AccountTransViewDAO#updateAcctTransAcctIdSupplr(java.lang.Long, java.lang.Long)
	 */
	@Override
	public void updateAcctTransAcctIdSupplr(Long idCompany, Long supplierId) throws BusinessException {
		Session session = this.getSessionFactory().openSession();
		long start = System.currentTimeMillis();
		String strLogs = "";
		
		try {
			session.getTransaction().setTimeout(300);
			session.beginTransaction();
			
			System.out.println("@@@@@@@@@@@@@@@@@@supplierId: " + supplierId);
			
			StringBuilder sbPrd = new StringBuilder();
			sbPrd.append("select dt_end from financial_period where id_company = :idCompany and status = -1 order by dt_start desc ");
			Query queryPrd = session.createSQLQuery(sbPrd.toString());
			queryPrd.setParameter("idCompany", idCompany);
			queryPrd.setMaxResults(1);
			Object finDate = queryPrd.uniqueResult();
			
			// Ex Order Bill
			StringBuilder sbEOBill = new StringBuilder();
			sbEOBill.append("update ex_order_bill b, supplier s left join company c on s.id_company = c.id ").
			append("set b.id_acct = if(s.type_cd='TC', c.id_acct_purchase_trade, c.id_acct_purchase_sundry) ").
			append("where b.id_supplier = s.id and b.id_company = :idCompany and s.id = :supplierId ");
			if (finDate != null) sbEOBill.append("and date(b.dt_bill) > date(:finDate) ");
			
			Query queryEOBill = session.createSQLQuery(sbEOBill.toString());
			queryEOBill.setParameter("idCompany", idCompany);
			queryEOBill.setParameter("supplierId", supplierId);
			if (finDate != null) queryEOBill.setParameter("finDate", finDate);
			strLogs = "####Ex Order Bill records: " + queryEOBill.executeUpdate();
			logger.error(strLogs);
			//logger.error("################# Update Ex Order Bill Speed: " + (System.currentTimeMillis() - start));
			//start = System.currentTimeMillis();
			
			// Purchase Bill - purc_bill [Account Trans]
			StringBuilder sbPB = new StringBuilder();
			sbPB.append("update account_trans a, ( ").
				append("select s.sys_no, if(s.type_cd='TC', c.id_acct_purchase_trade, c.id_acct_purchase_sundry) as id_acct, b.code ").
				append(",ac.code as ac_code, ac.sub_code, ac.description, ac.sub_description ").
				append("from ex_order_bill b, supplier s ").
				append("left join company c on s.id_company = c.id ").
				append("left join account ac on s.id_company = ac.id_company and if(s.type_cd='TC', c.id_acct_purchase_trade, c.id_acct_purchase_sundry) = ac.id ").
				append("where b.id_supplier = s.id and b.id_company = :idCompany and s.id = :supplierId ").
			append(") bp ").
			append("set a.id_acct = bp.id_acct, ").
			append("a.code = bp.id_acct, ").
			append("a.code = concat(bp.ac_code, (case when bp.sub_code is null or bp.sub_code = '' then '' else concat('-', bp.sub_code) end)), ").
			append("a.description = concat(bp.description, (case when bp.sub_description is null or bp.sub_description = '' then '' else concat(', ', bp.sub_description) end)) ").
			append("where a.status_cd = :statusCd and a.id_company = :idCompany and a.sys_cd = :sysCd and bp.code = a.sys_no and a.id_ref is null and ifnull(a.type_cd,'') not in ('" + CommonConstant.SYS_NUM_CD_TAX + "', '" + CommonConstant.SYS_NUM_CD_ROUNDING + "', '" + CommonConstant.SYS_NUM_CD_NCT + "') and bp.id_acct != a.id_acct ");
			if (finDate != null) sbPB.append("and date(a.dt_trans) > date(:finDate) ");
			
			Query queryPB = session.createSQLQuery(sbPB.toString());
			queryPB.setParameter("idCompany", idCompany);
			queryPB.setParameter("sysCd", CommonConstant.SYS_NUM_CD_PURC_BILL);
			queryPB.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			queryPB.setParameter("supplierId", supplierId);
			if (finDate != null) queryPB.setParameter("finDate", finDate);
			strLogs = "####Trans - Purchase Bill records: " + queryPB.executeUpdate();
			logger.error(strLogs);
			//logger.error("################# Update Purchase Bill - purc_bill [Account Trans] Speed: " + (System.currentTimeMillis() - start));
			//start = System.currentTimeMillis();
			
			// Bank Payment - bank_pmnt [Account Trans]
			StringBuilder sbBP = new StringBuilder();
			sbBP.append("update account_trans a, ").
			append("( ").
				append("select bp.code, if(s.type_cd='TC', c.id_acct_purchase_trade, c.id_acct_purchase_sundry) as id_acct ").
				append(",ac.code as ac_code, ac.sub_code, ac.description, ac.sub_description ").
				append("from ex_order_bill_pmnt bp, ex_order_bill b, supplier s ").
				append("left join company c on s.id_company = c.id ").
				append("left join account ac on s.id_company = ac.id_company and if(s.type_cd='TC', c.id_acct_purchase_trade, c.id_acct_purchase_sundry) = ac.id ").
				append("where b.id_company = :idCompany and bp.id_eo_bill = b.id and b.id_supplier = s.id and bp.status_cd = :statusCd and s.id = :supplierId ").
				append("group by bp.code ").
			append(") p ").
			append("set a.id_acct = p.id_acct, ").
			append("a.code = concat(p.ac_code, (case when p.sub_code is null or p.sub_code = '' then '' else concat('-', p.sub_code) end)), ").
			append("a.description = concat(p.description, (case when p.sub_description is null or p.sub_description = '' then '' else concat(', ', p.sub_description) end)) ").
			append("where a.id_company = :idCompany and a.sys_cd = :sysCd and a.status_cd = :statusCd and a.sys_no = p.code and a.type_cd = 'gnrl_pymt' and p.id_acct != a.id_acct ");
			if (finDate != null) sbBP.append("and date(a.dt_trans) > date(:finDate) ");
			
			Query queryBP = session.createSQLQuery(sbBP.toString());
			queryBP.setParameter("idCompany", idCompany);
			queryBP.setParameter("sysCd", CommonConstant.SYS_NUM_CD_BANK_PMNT);
			queryBP.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			queryBP.setParameter("supplierId", supplierId);
			if (finDate != null) queryBP.setParameter("finDate", finDate);
			strLogs = "####Trans - Bank Payment records: " + queryBP.executeUpdate();
			logger.error(strLogs);
			//logger.error("################# Update Bank Payment - bank_pmnt [Account Trans] Speed: " + (System.currentTimeMillis() - start));
			//start = System.currentTimeMillis();
			
			session.getTransaction().commit();
			strLogs = "################# updateAcctTransAcctIdSupplr Speed: " + (System.currentTimeMillis() - start);
			logger.error(strLogs);
			
		} catch (Exception e) {
			session.getTransaction().rollback();
			throw e;
			
		} finally {
			session.close();
		}
	}
	
	@Override
	public void updateAllCustNmToRelatedTbl(Long idCompany) throws BusinessException {
		Query query = createSQLQuery("CALL prc_upd_acct_trans_dest_cust(:p_id_company)");
		query.setParameter("p_id_company", idCompany);
		query.executeUpdate();
	}
	
	@Override
	public List<AcctTransVO> getAcctTransTaxRndList(Long idCompany, String sysCode, String sysNo) throws BusinessException {
		Criteria criteria = getSession().createCriteria(AcctTransVO.class);
		criteria.add(Restrictions.eq("sysNo", sysNo));
		criteria.add(Restrictions.eq("sysCode", sysCode));
		criteria.add(Restrictions.eq("companyId", idCompany));
		criteria.add(Restrictions.or(
				Restrictions.or(Restrictions.eq("type", CommonConstant.SYS_NUM_CD_TAX),Restrictions.eq("type", CommonConstant.SYS_NUM_CD_NCT)),
				Restrictions.eq("type", CommonConstant.SYS_NUM_CD_ROUNDING)));
		return criteria.list();
	}
}
