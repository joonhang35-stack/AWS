	@SuppressWarnings("unchecked")
	@Override
	public List<AcctTransVO> getAccountTransListFilterID(Map<String, Object> param, Object[] ids, boolean filterIN) {

		Criteria criteria = getSession().createCriteria(AcctTransVO.class);
		criteria = criteriaRestrictionEq(criteria, param);
		
		if(ids.length > 0) {
			Criterion objFilterCriteria = Restrictions.in("id", ids);
			if(filterIN)
				criteria.add(objFilterCriteria);
			else
				criteria.add(Restrictions.not(objFilterCriteria));
		}
		return criteria.list();
	}
	
	private Criteria criteriaRestrictionEq(Criteria _criteria, Map<String, Object> params) {
		if(params == null || params.isEmpty())
			return _criteria;

		for (Iterator<Entry<String, Object>> it = params.entrySet().iterator() ; it.hasNext() ;) {
			Entry<String, Object> entry = it.next();
			_criteria.add(Restrictions.eq(entry.getKey(), entry.getValue()));
		}
		
		return _criteria;
	}
	
	@Override
	public AcctTransVO getAccountTrans() {
		return getAccountTrans(null);
	}
	
	@Override
	public AcctTransVO getAccountTrans(Map<String, Object> params) {
		Criteria criteria = getSession().createCriteria(AcctTransVO.class);
		criteria = criteriaRestrictionEq(criteria, params);
		return (AcctTransVO) criteria.uniqueResult();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.db.bterp.dao.accttrans.AccountTransDAO#getAccountTransSumDebitCreditByAcctId(java.util.Map<String, Object>)
	 */
	@Override
	public AcctTransVO getAccountTransSumDebitCreditByAcctId(Map<String, Object> params) throws BusinessException {
		
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT SUM(debit) AS totalDebit, SUM(credit) AS totalCredit FROM (	")
			.append("	SELECT ").append(getSwapNegativeDebitCreditCase("acctTrans"))
			.append("	FROM account_trans acctTrans WHERE ")
			.append(queryWhereClauseBuilder(params, false))
			.append("		AND status_cd = :statusCode ");
		
		sb.append(") A ");
		
		Query query = createSQLQuery(sb.toString());
		query = queryParamMapping(query, params);
		
		Object results = query.uniqueResult();
		AcctTransVO acctTransVO = new AcctTransVO();

		if(results != null) {
			Object[] row = (Object[]) results;
			if(row[0] != null)
				acctTransVO.setDebit((Double) row[0]);
			if(row[1] != null)
				acctTransVO.setCredit((Double) row[1]);
		} 

		if(acctTransVO.getDebit() == null)
			acctTransVO.setDebit(0.00);
		if(acctTransVO.getCredit() == null)
			acctTransVO.setCredit(0.00);
		return acctTransVO;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.db.bterp.dao.accttrans.AccountTransDAO#getAccountBfBalance(java.util.Map)
	 */
	@Override
	public AcctTransVO getAccountBfBalance(Map<String, Object> params) throws BusinessException {
		
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT IFNULL(SUM(debit), 0) AS totalDebit, IFNULL(SUM(credit), 0) AS totalCredit, acct_cat FROM ( ").
			append("SELECT ").
				append("CASE WHEN t.debit < 0 THEN 0.00 WHEN t.credit < 0 THEN t.credit * -1 ELSE t.debit END AS debit, ").
				append("CASE WHEN t.credit < 0 THEN 0.00 WHEN t.debit < 0 THEN t.debit * -1 ELSE t.credit END AS credit, ").
				append("ac.code AS acct_cat ").
			append("FROM account_trans t ").
				append("LEFT JOIN (SELECT c.code, a.id from account a, account_cat c WHERE a.id_company = :idCompany AND a.id_acct_cat = c.id) ac on ac.id = t.id_acct ").
			append("WHERE t.id_company = :idCompany  AND t.id_acct = :idAcct  AND (t.dt_trans BETWEEN :fromDate AND :toDate) ").
				//append("AND (CASE WHEN ac.code in ('I', 'X', 'P', 'OI') THEN DATE(t.dt_trans) >= DATE(:finDate) ELSE 1=1 END) ").
				append("AND t.status_cd = :statusCode ").
		append(") A ");
		
		Query query = createSQLQuery(sb.toString());
		query.setParameter("idCompany", (Long) params.get("idCompany"));
		query.setParameter("idAcct", (Long) params.get("idAcct"));
		query.setParameter("fromDate", (Date) params.get("fromDate"));
		query.setParameter("toDate", (Date) params.get("toDate"));
		//query.setParameter("finDate", (Date) params.get("finDate"));
		query.setParameter("statusCode", BaseConstant.STATUS_ACTIVE);
		
		//query = queryParamMapping(query, params);
		
		Object results = query.uniqueResult();
		AcctTransVO acctTransVO = new AcctTransVO();

		if(results != null) {
			Object[] row = (Object[]) results;
			if(row[0] != null)
				acctTransVO.setDebit((Double) row[0]);
			if(row[1] != null)
				acctTransVO.setCredit((Double) row[1]);
			acctTransVO.setTempAcct((String) row[2]);
		} 

		if(acctTransVO.getDebit() == null)
			acctTransVO.setDebit(0.00);
		if(acctTransVO.getCredit() == null)
			acctTransVO.setCredit(0.00);
		return acctTransVO;
	}
	
	protected static String getSwapNegativeDebitCreditCase(String tablePrefix) {
		if(tablePrefix == null)
			tablePrefix = "";
		if(StringUtils.isNotEmpty(tablePrefix))
			tablePrefix += ".";
		
		return " CASE WHEN " + tablePrefix + "debit < 0 THEN 0.00 WHEN " + tablePrefix + "credit < 0 "
					+ "THEN " + tablePrefix + "credit * -1 ELSE " + tablePrefix + "debit END AS debit, " 
				+ "	CASE WHEN " + tablePrefix + "credit < 0 THEN 0.00 WHEN " + tablePrefix + "debit < 0 "
					+ "THEN " + tablePrefix + "debit * -1 ELSE " + tablePrefix + "credit END AS credit ";
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctTransVO> getAccountTransListGeneralLedger(Map<String, Object> params) throws BusinessException {
		StringBuilder sb = new StringBuilder();

		sb.append("SELECT id, dt_trans, ")
			.append(getSwapNegativeDebitCreditCase(""))
			.append(", destination, source, sys_cd, sys_no, sys_prefix, tax_code ")
			.append("FROM account_trans ")
			.append("WHERE ").append(queryWhereClauseBuilder(params, false))
			.append("		AND status_cd = :statusCode ");
		
		sb = genAcctTransListFilter(sb, params);
		
		sb.append(" ORDER BY ");
		
		Map<String, String> filters = (Map<String, String>) params.get("filters");
		String destination = null;
		if (!filters.isEmpty()) {
			for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) {
				Entry<String, String> entry = it.next();
				if ("destination".equals(entry.getKey())) {
					destination = entry.getValue();
				}
			}
		}
		
		String sortField = (String) params.get("sortField");
		if (sortField == null) {
			if (destination == null) sb.append("dt_trans");
			else sb.append("case when destination like '").append(filters.get("destination")).append("%' then destination else concat('{0} ', destination) end");
		} else {
			if ("transDt".equals(sortField)) sb.append("dt_trans");
			else if ("debit".equals(sortField)) sb.append("debit");
			else if ("credit".equals(sortField)) sb.append("credit");
			else if ("destination".equals(sortField)) sb.append("case when destination like '").append(filters.get("destination")).append("%' then destination else concat('{0} ', destination) end");
			else if ("source".equals(sortField)) sb.append("case when source like '").append(filters.get("source")).append("%' then source else concat('{0} ', source) end");
			else if ("taxCode".equals(sortField)) sb.append("tax_code");
			
			if (CommonConstant.SORT_ASC.equals(((SortOrder) params.get("sortOrder")).toString())) sb.append(" asc");
			else sb.append(" desc");
		}
		
		Query query = createSQLQuery(sb.toString());
		query = queryParamMapping(query, params);
		query.setFirstResult((int) params.get("first"));
		query.setMaxResults((int) params.get("pageSize"));
		
		List<Object> results = query.list();
		List<AcctTransVO> acctTransList = new ArrayList<AcctTransVO>();
		
		for (Iterator<Object> it = results.iterator() ; it.hasNext() ;) {
			Object[] row = (Object[]) it.next();
			AcctTransVO vo = new AcctTransVO();
			vo.setId(((BigInteger) row[0]).longValue());
			vo.setTransDt((Date) row[1]);
			vo.setDebit((Double) row[2]);
			vo.setCredit((Double) row[3]);
			vo.setDestination((String) row[4]);
			vo.setSource((String) row[5]);
			vo.setSysCode((String) row[6]);
			vo.setSysNo((String) row[7]);
			vo.setSysPrefix((String) row[8]);
			vo.setTaxCode((String) row[9]);
			acctTransList.add(vo);
		}
		
		return acctTransList;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.db.bterp.dao.accttrans.AccountTransViewDAO#getAccountTransListSize(java.util.Map)
	 */
	@Override
	public int getAccountTransListSize(Map<String, Object> params) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT count(id) ");
		sb.append("FROM account_trans  WHERE ")
		.append(queryWhereClauseBuilder(params, false))
		.append("		AND status_cd = :statusCode ");
		
		sb = genAcctTransListFilter(sb, params);
		
		Query query = createSQLQuery(sb.toString());
		query = queryParamMapping(query, params);
		
		return ((BigInteger) query.uniqueResult()).intValue();
	}
	
	@SuppressWarnings("unchecked")
	private StringBuilder genAcctTransListFilter(StringBuilder _sb, Map<String, Object> params) {
		Map<String, String> filters = (Map<String, String>) params.get("filters");
		
		if (!filters.isEmpty()) {
			_sb.append(" AND (");
			for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) {
				Entry<String, String> entry = it.next();
				if ("transDt".equals(entry.getKey())) _sb.append("date_format(dt_trans, '%d-%b-%Y') like '%").append(entry.getValue()).append("%'");
				else if ("debit".equals(entry.getKey())) _sb.append("debit like '%").append(entry.getValue()).append("%'");
				else if ("credit".equals(entry.getKey())) _sb.append("credit like '%").append(entry.getValue()).append("%'");
				else if ("destination".equals(entry.getKey())) _sb.append("destination like '%").append(entry.getValue()).append("%'");
				else if ("source".equals(entry.getKey())) _sb.append("source like '%").append(entry.getValue()).append("%'");
				else if ("taxCode".equals(entry.getKey())) _sb.append("tax_code like '").append(entry.getValue()).append("%'");
				if (filters.size() > 1 && it.hasNext()) _sb.append(" AND ");
			}
			_sb.append(") ");
		}
		return _sb;
	}
	
	private String queryWhereClauseBuilder(Map<String, Object> params, boolean isAdditionalWhereClause) {
		StringBuilder sb = new StringBuilder();
		if(params.get("idCompany") != null)
			sb.append(" AND id_company = :idCompany ");
		
		if(params.get("idAcct") != null)
			sb.append(" AND id_acct = :idAcct ");
		
		if(params.get("fromDate") != null && params.get("toDate") == null) {
			sb.append(" AND dt_trans = :fromDate ");
			
		} else if(params.get("fromDate") != null  && params.get("toDate") != null){
			sb.append(" AND (dt_trans BETWEEN :fromDate AND :toDate)	");
		}
		
		if(!isAdditionalWhereClause && sb.length() > 5 && sb.toString().startsWith(" AND "))
			return sb.substring(4);
			
		return sb.toString();
	}
	
	private Query queryParamMapping(Query _query, Map<String, Object> params) {
		Date fromDate, toDate;
		Long idCompany, idAcct;

		idCompany = (Long) ObjectUtils.defaultIfNull(params.get("idCompany"), null);
		idAcct = (Long) ObjectUtils.defaultIfNull(params.get("idAcct"), null);
		fromDate = (Date) ObjectUtils.defaultIfNull(params.get("fromDate"), null);
		toDate = (Date) ObjectUtils.defaultIfNull(params.get("toDate"), null);
		
		if(idCompany != null)
			_query.setParameter("idCompany", idCompany);
		
		if(idAcct != null)
			_query.setParameter("idAcct", idAcct);
		
		if(fromDate != null)
			_query.setParameter("fromDate", fromDate);
		
		if(toDate != null)
			_query.setParameter("toDate", toDate);

		_query.setParameter("statusCode", BaseConstant.STATUS_ACTIVE);
		return _query;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.db.bterp.dao.accttrans.AccountTransViewDAO#getGLBalanceList(java.lang.Long, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctViewVO> getGLBalanceList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		Session session = this.getSessionFactory().openSession();
		List<AcctViewVO> acctViewList = new ArrayList<AcctViewVO>();
		
		try {
			session.getTransaction().setTimeout(360);
			session.beginTransaction();
			
			StringBuilder sbCode = new StringBuilder();
			StringBuilder sbSubCode = new StringBuilder();
			StringBuilder sb = new StringBuilder();
			
			Calendar cal = null;
			Date fromBfDate = null;
			Date fromDate = null;
			Date toDate = null;
			Date finDate = null;
			
			sb.append("select a.dt_start from ( ").
				append("select * from financial_period where id_company = :idCompany ").
				append("and year = (select year from financial_period where id_company = :idCompany and (status != -1 or year = :year) group by id_company) ").
				append("order by year, seq_no) a ").
				append("group by year ");
			
			Query query = createSQLQuery(sb.toString());
			query.setParameter("idCompany", idCompany);
			query.setParameter("year", searchParamVO.getObj2());
			finDate =  (Date) query.uniqueResult();
			
			// Search By Date
			//if (searchParamVO.getObj3()!=null && searchParamVO.getObj4()!=null) {
			if (searchParamVO.getObj5()!=null) {
				cal = DatesUtils.getDayTimeStart((Date) searchParamVO.getObj3());
				cal.add(Calendar.DATE, -1);
				fromBfDate = cal.getTime();
				fromDate = (Date) searchParamVO.getObj3();
				toDate = (Date) searchParamVO.getObj4();
			} else { // Search All
				cal = DatesUtils.getDayTimeStart((Date) searchParamVO.getFromDate());
				cal.add(Calendar.DATE, -1);
				fromBfDate = cal.getTime();
				fromDate = (Date) searchParamVO.getFromDate();
				toDate = (Date) searchParamVO.getToDate();
			}
			
			sbCode.append("select a.id, a.code, a.description, ac.code as acct_cat_cd, ").
				append("sum(ifnull(bg.begin_bal,0)), ").
				append("sum(round(ifnull(bg.begin_bal,0) + ifnull(bf.b_bf_bal, 0),2)) as 'bf_bal', ").
				append("sum(round(ifnull(bg.begin_bal,0) + ifnull(bc.b_bc_bal, 0),2)) as 'bc_bal' ").
				//append("sum(ifnull(bal.debit,0)), ").
				//append("sum(ifnull(bal.credit,0)) ").
			append("from account a ").
			append("left join account_cat ac on ac.id = a.id_acct_cat ").
			append("left join ( ").
				append("select id_acct, round(debit_begin_bal - credit_begin_bal,2) as 'begin_bal' from account_bal where dt_begin_bal = date(:finDate) "). //fromYearDate
			append(") bg on bg.id_acct = a.id ").
			append("left join ( ").
				//append("select id_company, id_acct, round(sum(debit) - sum(credit),2) as 'b_bf_bal' from account_trans where id_company = :idCompany and status_cd = 'A' and date(dt_trans) between date(:finDate) and date(:fromBfDate) group by id_acct ").
				append("select t.id_company, t.id_acct, round(sum(t.debit) - sum(t.credit),2) as 'b_bf_bal' ").
					append("from account_trans t ").
					append("left join (select c.code, a.id from account a, account_cat c where a.id_company = :idCompany and a.id_acct_cat = c.id) ac on ac.id = t.id_acct ").
				append("where t.id_company = :idCompany and t.status_cd = :statusCd and t.dt_trans between date(:finDate) and date(:fromBfDate) ").
					append("and (case when ac.code in ('I', 'X', 'P', 'OI') then t.dt_trans >= date(:slctdFinDate) else 1=1 end) ").
				append("group by t.id_acct ").
			append(") bf on bf.id_acct = a.id ").
			append("left join ( ").
				//append("select id_company, id_acct, round(sum(debit) - sum(credit),2) as 'b_bc_bal' from account_trans where id_company = :idCompany and status_cd = 'A' and date(dt_trans) between date(:finDate) and date(:toDate) group by id_acct ").
				append("select t.id_company, t.id_acct, round(sum(t.debit) - sum(t.credit),2) as 'b_bc_bal' ").
					append("from account_trans t ").
