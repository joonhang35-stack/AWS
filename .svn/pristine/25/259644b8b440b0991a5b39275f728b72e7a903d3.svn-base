				sb.append("and date(a.dt_trans) between date(:fromDate) and date(:toDate) ");
			}
			sb.append("group by a.id_acct, a.sys_cd, a.sys_no ");
			sb.append("order by a.dt_trans ");
		} else {
			/*sb.append("select a.id, a.dt_trans, a.source, a.destination, ").
