			if (searchParamVO.getObj5()!=null) querySubCode.setParameter("acctId", searchParamVO.getObj5());
			if (searchParamVO.getObj7()!=null) querySubCode.setParameter("acctCatId", searchParamVO.getObj7());
			querySubCode.setParameter("finDate", finDate);
			querySubCode.setParameter("fromBfDate", fromBfDate);
			//querySubCode.setParameter("fromDate", fromDate);
			querySubCode.setParameter("toDate", toDate);
			querySubCode.setParameter("slctdFinDate", searchParamVO.getFromDate());

			List<Object> resultsSubCode = querySubCode.list();
			List<Object> resultsCode = queryCode.list();
			//List<AcctViewVO> acctViewList = new ArrayList<AcctViewVO>();
			List<AcctViewVO> acctViewList2 = new ArrayList<AcctViewVO>();
			
			//int i = 1;
			for (Iterator<Object> it = resultsSubCode.iterator(); it.hasNext();) {
				Object[] row = (Object[]) it.next();
				AcctViewVO vo = new AcctViewVO();
				vo.setAcctBalVO(new AcctBalVO());
				vo.setId(((BigInteger) row[0]).longValue());
				vo.setCode((String) row[1]);
				vo.setSubCode((String) row[2]);
				vo.setDesc((String) row[3]);
				vo.setSubDesc((String) row[4]);
				vo.setAcctCatCode((String) row[5]);
				vo.setBeginBal(Double.parseDouble(row[6].toString()));
				vo.setBfBal(Double.parseDouble(row[7].toString()));
				vo.setCurrBal(Double.parseDouble(row[8].toString()));
				//vo.setTotalDebit(Double.parseDouble(row[9].toString()));
				//vo.setTotalCredit(Double.parseDouble(row[10].toString()));
				
				List<AcctTransViewVO> acctTransViewList = getAcctTransViewSmmyExtdList(idCompany, searchParamVO, vo, vo.getId(), vo.getAcctCatCode(), session);
				vo.setAcctTransViewList(acctTransViewList);
				acctViewList2.add(vo);
				//i++;
			}
			
			// Total No tally on account 4020 Mar 2019
			BigDecimal totalDebit = BigDecimal.ZERO;
			BigDecimal totalCredit = BigDecimal.ZERO;
			for (Iterator<Object> it = resultsCode.iterator(); it.hasNext();) {
				Object[] row = (Object[]) it.next();
				AcctViewVO vo = new AcctViewVO();
				vo.setAcctBalVO(new AcctBalVO());
				vo.setId(((BigInteger) row[0]).longValue());
				vo.setCode((String) row[1]);
				vo.setDesc((String) row[2]);
				vo.setAcctCatCode((String) row[3]);
				
				vo.setBeginBal(Double.parseDouble(row[4].toString()));
				vo.setBfBal(Double.parseDouble(row[5].toString()));
				vo.setCurrBal(Double.parseDouble(row[6].toString()));
				
				//vo.setTotalDebit(Double.parseDouble(row[7].toString()));
				//vo.setTotalCredit(Double.parseDouble(row[8].toString()));
				
				vo.setAcctViewList(new ArrayList<AcctViewVO>());
				totalDebit = BigDecimal.ZERO;
				totalCredit = BigDecimal.ZERO;
				for (AcctViewVO voSub : acctViewList2) {
					if (vo.getCode().equals(voSub.getCode())) {
						vo.getAcctViewList().add(voSub);
						totalDebit = totalDebit.add(new BigDecimal(String.valueOf(voSub.getTotalDebit())));
						totalCredit = totalCredit.add(new BigDecimal(String.valueOf(voSub.getTotalCredit())));
					}
				}
				vo.setTotalDebit(totalDebit.doubleValue());
				vo.setTotalCredit(totalCredit.doubleValue());
				
				acctViewList.add(vo);
			}
			session.getTransaction().commit();
			
		} catch (Exception e) {
			session.getTransaction().rollback();
			throw e;
			
		} finally {
			session.close();
		}
		return acctViewList;
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<AcctTransViewVO> getAcctTransViewSmmyExtdList(Long idCompany, SearchParamVO searchParamVO, AcctViewVO acctViewVO, Long acctId, String acctCatCd, Session session) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		long start = System.currentTimeMillis();
		//String strLogs = "";
		if (acctCatCd.equals("I")) {
			sb.append("select a.id, a.dt_trans, a.source, a.destination, ").
				append("case when (sum(a.debit) - sum(a.credit)) < 0 then 0.00 else (sum(a.debit) - sum(a.credit)) end as 'debit', ").
				append("case when (sum(a.debit) - sum(a.credit)) < 0 then (sum(a.debit) - sum(a.credit)) * -1 else 0.00 end as 'credit', ").
				/*append("(select trans.code ").
				append("from ( ").
					append("select x.id, x.id_acct, x.sys_cd, x.sys_no, y.code ").
					append("from account_trans x left join account y on x.id_acct = y.id ").
					append("where x.id_company = :idCompany and x.status_cd = :statusCd ");
						//append("and date(x.dt_trans) between date(:fromYearDate) and date(:toYearDate) ");
					if (searchParamVO.getObj3()!=null && searchParamVO.getObj4()!=null) {
						sb.append("and date(x.dt_trans) between date(:fromDate) and date(:toDate) ");
					}
						sb.append("and x.id_acct != :acctId ").
					append("group by sys_cd, sys_no ").
					append(") trans ").
				append("where trans.sys_cd = a.sys_cd and trans.sys_no = a.sys_no ").
				append("limit 1 ").
				append(") as 'postCode', ").*/
				append("(select y.code ").
					append("from account_trans x left join account y on x.id_acct = y.id ").
					append("where x.id_company = :idCompany and x.status_cd = :statusCd ");
						if (searchParamVO.getObj3()!=null && searchParamVO.getObj4()!=null) {
							sb.append("and date(x.dt_trans) between date(:fromDate) and date(:toDate) ");
						}
						sb.append("and x.id_acct != :acctId ").
						append("and x.sys_cd = a.sys_cd and x.sys_no = a.sys_no ").
					append("limit 1 ").
				append(") as 'postCode', ").
				append("c.prefix_id, a.sys_cd, a.sys_no, ").
				append("a.sys_no as bp_code ").
				append(", a.tax_code, b.code, ").
				append("case ").
				append("when a.sys_cd='bank_adjm' OR a.sys_cd = 'bank_deps' OR a.sys_cd = 'bank_dpmt' OR a.sys_cd = 'rfnd' then ").
					append("IF(tr1.code IS NULL, '', tr1.code) ").
				append("when a.sys_cd = 'invc' then ").
					append("IF(tr2.code IS NULL, '', tr2.code) ").
				append("when a.sys_cd = 'crdt_note' then ").
					append("IF(tr3.code IS NULL, '', tr3.code) ").
				append("when a.sys_cd = 'purc_bill' then ").
					append("IF(tr4.code IS NULL, '', tr4.code) ").
				append("when a.sys_cd = 'jrnl' then ").
					append("IF(tr5.code IS NULL, '', tr5.code) ").
				append("else ").
					append("'' ").
			append("end as tour_code, ").
			append("case ").
				append("when a.sys_cd='purc_bill' then ").
					append("IF(eob.comments IS NULL, '', eob.comments) ").
				append("else ").
					append("'' ").
			append("end as comments ").
			append("from account_trans a left join sys_num_conf c on c.id_company = :idCompany and a.sys_cd = c.code ").
			append("left join ").
				append("cash_book cb ON ((a.sys_cd = 'bank_adjm'and cb.sys_cd='bank_adjm') OR (a.sys_cd = 'bank_deps'and cb.sys_cd='bank_deps') OR (a.sys_cd = 'bank_pmnt'and cb.sys_cd='bank_pmnt') OR (a.sys_cd = 'rfnd'and cb.sys_cd='rfnd')) and cb.sys_no = a.sys_no ").
			append("left join ").
				append("tour_dep tr1 ON tr1.id = cb.id_tour_dep ").
			append("left join ").
				append("invoice iv ON iv.doc_type_cd = 'I' and a.sys_cd = 'invc' and a.sys_no = iv.code ").
			append("left join ").
				append("invoice iv_cn ON iv_cn.doc_type_cd = 'C' and a.sys_cd = 'crdt_note' and a.sys_no = iv_cn.code ").
			append("left join ").
				append("invoice iv_cn_cd ON iv_cn_cd.doc_type_cd = 'I' and iv_cn_cd.code = iv_cn.cn_inv_no ").
			append("left join ").
				append("invoice ps_cn_cd ON ps_cn_cd.doc_type_cd = 'P' and ps_cn_cd.ps_no = iv_cn.cn_ps_no ").
			append("left join ").
				append("tour_dep tr2 ON tr2.id = iv.id_tour_dep ").
			append("left join ").
				append("tour_dep tr3 ON tr3.id = if(iv_cn_cd.id_tour_dep is not null, iv_cn_cd.id_tour_dep, ps_cn_cd.id_tour_dep) ").
			append("left join ").
				append("ex_order_bill eob ON a.sys_no = eob.code and a.sys_cd = 'purc_bill' ").
			append("left join ").
				append("tour_dep tr4 ON tr4.id = eob.id_tour_dep ").
			append("left join ").
				append("journal jn ON a.sys_no = jn.sys_no and a.sys_cd = 'jrnl' ").
			append("left join ").
				append("tour_dep tr5 ON tr5.id = jn.id_tour_dep, account b ").
			append("where a.id_company = b.id_company and a.id_acct = b.id and b.id_acct_cat = 4 and ").
			append("a.id_company = :idCompany and ").
