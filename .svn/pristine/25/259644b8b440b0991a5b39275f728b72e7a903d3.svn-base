				append("where t.id_company = :idCompany and t.status_cd = :statusCd and date(t.dt_trans) between date(:finDate) and date(:toDate) ").
					append("and (case when ac.code in ('I', 'X', 'P', 'OI') then date(t.dt_trans) >= date(:slctdFinDate) else 1=1 end) ").
				append("group by t.id_acct ").
			append(") bc on bc.id_acct = a.id ").
			/*append("left join ( ").
				append("select id_company, id_acct, ").
				append("sum(case when debit < 0 then 0.00 when credit < 0 then credit * -1 else debit end) as debit, ").
				append("sum(case when credit < 0 then 0.00 when debit < 0 then debit * -1 else credit end) as credit ").
				append("from account_trans where id_company = :idCompany and status_cd = 'A' and date(dt_trans) between date(:fromDate) and date(:toDate) group by id_acct ").
