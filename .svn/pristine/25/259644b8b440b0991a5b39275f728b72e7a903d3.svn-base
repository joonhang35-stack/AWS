				append("where t.id_company = :idCompany and t.status_cd = :statusCd and t.dt_trans between date(:finDate) and date(:fromBfDate) ").
					append("and (case when ac.code in ('I', 'X', 'P', 'OI') then t.dt_trans >= date(:slctdFinDate) else 1=1 end) ").
				append("group by t.id_acct ").
			append(") bf on bf.id_acct = a.id ").
			append("left join ( ").
				//append("select id_company, id_acct, round(sum(debit) - sum(credit),2) as 'b_bc_bal' from account_trans where id_company = :idCompany and status_cd = 'A' and date(dt_trans) between date(:finDate) and date(:toDate) group by id_acct ").
				append("select t.id_company, t.id_acct, round(sum(t.debit) - sum(t.credit),2) as 'b_bc_bal' ").
					append("from account_trans t ").
					append("left join (select c.code, a.id from account a, account_cat c where a.id_company = :idCompany and a.id_acct_cat = c.id) ac on ac.id = t.id_acct ").
				append("where t.id_company = :idCompany and t.status_cd = :statusCd and t.dt_trans between date(:finDate) and date(:toDate) ").
					append("and (case when ac.code in ('I', 'X', 'P', 'OI') then t.dt_trans >= date(:slctdFinDate) else 1=1 end) ").
				append("group by t.id_acct ").
			append(") bc on bc.id_acct = a.id ").
			/*append("left join ( ").
				append("select id_company, id_acct, ").
				append("sum(case when debit < 0 then 0.00 when credit < 0 then credit * -1 else debit end) as debit, ").
				append("sum(case when credit < 0 then 0.00 when debit < 0 then debit * -1 else credit end) as credit ").
				append("from account_trans where id_company = :idCompany and status_cd = 'A' and date(dt_trans) between date(:fromDate) and date(:toDate) group by id_acct ").
			append(") bal on bal.id_company = a.id_company and bal.id_acct = a.id ").*/
			append("where a.id_company = :idCompany and a.status_cd = :statusCd ");
			if (searchParamVO.getObj5()!=null) sbSubCode.append("and a.id = :acctId ");
			if (searchParamVO.getObj7()!=null) sbSubCode.append("and a.id_acct_cat = :acctCatId ");
			if (searchParamVO.getObj10()!=null) { // Trade Debtor Only or W/O Trade Debtor
				String assetType = (String) searchParamVO.getObj10();
				if (StringUtils.isNotEmpty(assetType)) {
					if (StringUtils.isNotEmpty((String) searchParamVO.getObj11())) {
						if ("TDO".equals(assetType)) {
							sbSubCode.append("and a.id in (").append(searchParamVO.getObj11().toString()).append(") ");
						} else if ("WTD".equals(assetType)) {
							sbSubCode.append("and a.id not in (").append(searchParamVO.getObj11().toString()).append(") ");
						}
					}
				}
			}
			sbSubCode.append("order by  cast(a.code as decimal), cast(a.sub_code as decimal) ");
		
			//Query queryCode = createSQLQuery(sbCode.toString());
			Query queryCode = session.createSQLQuery(sbCode.toString());
			queryCode.setParameter("idCompany", idCompany);
			queryCode.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			if (searchParamVO.getObj5()!=null) queryCode.setParameter("acctId", searchParamVO.getObj5());
			if (searchParamVO.getObj7()!=null) queryCode.setParameter("acctCatId", searchParamVO.getObj7());
			queryCode.setParameter("finDate", finDate);
			queryCode.setParameter("fromBfDate", fromBfDate);
			//queryCode.setParameter("fromDate", fromDate);
			queryCode.setParameter("toDate", toDate);
			queryCode.setParameter("slctdFinDate", searchParamVO.getFromDate());
			/*java.text.SimpleDateFormat sdf = new java.text.SimpleDateFormat("yyyy-MM-dd");
			System.out.println("@@@@@@@@@@@@@@acctId : " + searchParamVO.getObj5());
			System.out.println("@@@@@@@@@@@@@@acctCatId : " + searchParamVO.getObj7());
			System.out.println("@@@@@@@@@@@@@@finDate : " + sdf.format(finDate));
			System.out.println("@@@@@@@@@@@@@@fromBfDate : " + sdf.format(fromBfDate));
			System.out.println("@@@@@@@@@@@@@@fromDate : " + sdf.format(fromDate));
			System.out.println("@@@@@@@@@@@@@@toDate : " + sdf.format(toDate));
			System.out.println("@@@@@@@@@@@@@@slctdFinDate : " + sdf.format(searchParamVO.getFromDate()));*/
			
			//Query querySubCode = createSQLQuery(sbSubCode.toString());
			Query querySubCode = session.createSQLQuery(sbSubCode.toString());
			querySubCode.setParameter("idCompany", idCompany);
			querySubCode.setParameter("statusCd", BaseConstant.STATUS_ACTIVE);
			if (searchParamVO.getObj5()!=null) querySubCode.setParameter("acctId", searchParamVO.getObj5());
			if (searchParamVO.getObj7()!=null) querySubCode.setParameter("acctCatId", searchParamVO.getObj7());
			querySubCode.setParameter("finDate", finDate);
			querySubCode.setParameter("fromBfDate", fromBfDate);
			//querySubCode.setParameter("fromDate", fromDate);
			querySubCode.setParameter("toDate", toDate);
			querySubCode.setParameter("slctdFinDate", searchParamVO.getFromDate());

			List<Object> resultsSubCode = querySubCode.list();
			List<Object> resultsCode = queryCode.list();
			//List<AcctViewVO> acctViewList = new ArrayList<AcctViewVO>();
			List<AcctViewVO> acctViewList2 = new ArrayList<AcctViewVO>();
			
			//int i = 1;
			for (Iterator<Object> it = resultsSubCode.iterator(); it.hasNext();) {
				Object[] row = (Object[]) it.next();
				AcctViewVO vo = new AcctViewVO();
				vo.setAcctBalVO(new AcctBalVO());
				vo.setId(((BigInteger) row[0]).longValue());
				vo.setCode((String) row[1]);
				vo.setSubCode((String) row[2]);
				vo.setDesc((String) row[3]);
				vo.setSubDesc((String) row[4]);
				vo.setAcctCatCode((String) row[5]);
				vo.setBeginBal(Double.parseDouble(row[6].toString()));
				vo.setBfBal(Double.parseDouble(row[7].toString()));
				vo.setCurrBal(Double.parseDouble(row[8].toString()));
				//vo.setTotalDebit(Double.parseDouble(row[9].toString()));
				//vo.setTotalCredit(Double.parseDouble(row[10].toString()));
				
				List<AcctTransViewVO> acctTransViewList = getAcctTransViewList(idCompany, searchParamVO, vo, vo.getId(), vo.getAcctCatCode(), session);
				vo.setAcctTransViewList(acctTransViewList);
				acctViewList2.add(vo);
				//i++;
			}
			
			// Total No tally on account 4020 Mar 2019
			BigDecimal totalDebit = BigDecimal.ZERO;
			BigDecimal totalCredit = BigDecimal.ZERO;
			for (Iterator<Object> it = resultsCode.iterator(); it.hasNext();) {
				Object[] row = (Object[]) it.next();
				AcctViewVO vo = new AcctViewVO();
				vo.setAcctBalVO(new AcctBalVO());
				vo.setId(((BigInteger) row[0]).longValue());
				vo.setCode((String) row[1]);
				vo.setDesc((String) row[2]);
				vo.setAcctCatCode((String) row[3]);
				
				vo.setBeginBal(Double.parseDouble(row[4].toString()));
				vo.setBfBal(Double.parseDouble(row[5].toString()));
				vo.setCurrBal(Double.parseDouble(row[6].toString()));
				
				//vo.setTotalDebit(Double.parseDouble(row[7].toString()));
				//vo.setTotalCredit(Double.parseDouble(row[8].toString()));
				
				vo.setAcctViewList(new ArrayList<AcctViewVO>());
				totalDebit = BigDecimal.ZERO;
				totalCredit = BigDecimal.ZERO;
				for (AcctViewVO voSub : acctViewList2) {
					if (vo.getCode().equals(voSub.getCode())) {
						vo.getAcctViewList().add(voSub);
						totalDebit = totalDebit.add(new BigDecimal(String.valueOf(voSub.getTotalDebit())));
						totalCredit = totalCredit.add(new BigDecimal(String.valueOf(voSub.getTotalCredit())));
					}
				}
				vo.setTotalDebit(totalDebit.doubleValue());
				vo.setTotalCredit(totalCredit.doubleValue());
				
				acctViewList.add(vo);
			}
			session.getTransaction().commit();
			
			System.out.println("CYY totalCredit: " + totalCredit);
			System.out.println("CYY totalDedit: " + totalDebit);
			
		} catch (Exception e) {
			session.getTransaction().rollback();
			throw e;
			
		} finally {
			session.close();
		}
		return acctViewList;
	}
	
