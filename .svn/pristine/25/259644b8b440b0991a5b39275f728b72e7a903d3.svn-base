			append(") bf on bf.id_acct = a.id ").
			append("left join ( ").
				//append("select id_company, id_acct, round(sum(debit) - sum(credit),2) as 'b_bc_bal' from account_trans where id_company = :idCompany and status_cd = 'A' and date(dt_trans) between date(:finDate) and date(:toDate) group by id_acct ").
				append("select t.id_company, t.id_acct, round(sum(t.debit) - sum(t.credit),2) as 'b_bc_bal' ").
