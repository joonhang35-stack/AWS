	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.service.TourPackageService#checkTourThemeAvailable(com.bcs.zsg.product.vo.TourThemeVO, com.bcs.zsg.product.vo.TourThemeVO)
	 */
	@Override
	public void checkTourThemeAvailable(TourThemeVO tourThemeVO, TourThemeVO bakTourThemeVO) throws BusinessException {
		if (tourThemeVO.getIdParent() != null && tourThemeVO.getIdParent().longValue() == 0) tourThemeVO.setIdParent(null);
		if (tourThemeVO.getIdParent() != null && tourThemeVO.getIdParent().equals(tourThemeVO.getId())) throw new BusinessException(CommonErrConstant.ERR_TOUR_THEME_SELF_INHERIT);
		
		if (bakTourThemeVO == null) {
			if (!tourPkgDAO.isTourThemeAvailable(tourThemeVO)) throw new BusinessException(CommonErrConstant.ERR_TOUR_THEME_DUPLICATED);
			
		} else {
			if (bakTourThemeVO.getIdParent() == null && tourThemeVO.getIdParent() != null && tourPkgDAO.isSubThemeAvailable(bakTourThemeVO)) {
				throw new BusinessException(CommonErrConstant.ERR_TOUR_THEME_CANNOT_MOVE);
			}
			
			if ((tourThemeVO.getIdParent() != null && bakTourThemeVO.getIdParent() == null) || 
					(tourThemeVO.getIdParent() == null && bakTourThemeVO.getIdParent() != null)) checkTourThemeAvailable(tourThemeVO, null);
			else if (tourThemeVO.getIdParent() != null && !tourThemeVO.getIdParent().equals(bakTourThemeVO.getIdParent())) checkTourThemeAvailable(tourThemeVO, null);
			else if (!tourThemeVO.getDesc().equalsIgnoreCase(bakTourThemeVO.getDesc())) checkTourThemeAvailable(tourThemeVO, null);
		}
	}
	
	@Override
	public void addTourPkg(TourPackageVO tourPkgVO) throws BusinessException {
		// insert tour departure
		insertVO(tourPkgVO);
		
		// insert tour Badge
		if (CollectionUtils.isNotEmpty(tourPkgVO.getTourBadgeTagList())) { 
			for (String code : tourPkgVO.getTourBadgeTagList()) {
				TourPackageAttributeVO tpaVO = new TourPackageAttributeVO();
				tpaVO.setIdTourPkg(tourPkgVO.getId());
				tpaVO.setTagType(CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE);
				tpaVO.setCode(code);
				tourPkgDAO.insert(tpaVO);
			}
		}
		
		if (CollectionUtils.isNotEmpty(tourPkgVO.getTourBadgeTagZhList())) { 
			for (String code : tourPkgVO.getTourBadgeTagZhList()) {
				TourPackageAttributeVO tpaVO = new TourPackageAttributeVO();
				tpaVO.setIdTourPkg(tourPkgVO.getId());
				tpaVO.setTagType(CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE_ZH);
				tpaVO.setCode(code);
				tourPkgDAO.insert(tpaVO);
			}
		}
		
		// insert travel style
		if (CollectionUtils.isNotEmpty(tourPkgVO.getTravelStyleList())) { 
			for (String code : tourPkgVO.getTravelStyleList()) {
				TourPackageAttributeVO tpaVO = new TourPackageAttributeVO();
				tpaVO.setIdTourPkg(tourPkgVO.getId());
				tpaVO.setTagType(CommonConstant.LOOKUP_CAT_CD_TRAVEL_STYLE);
				tpaVO.setCode(code);
				tourPkgDAO.insert(tpaVO);
			}
		}
		
		if (CollectionUtils.isNotEmpty(tourPkgVO.getTravelStyleZhList())) { 
			for (String code : tourPkgVO.getTravelStyleZhList()) {
				TourPackageAttributeVO tpaVO = new TourPackageAttributeVO();
				tpaVO.setIdTourPkg(tourPkgVO.getId());
				tpaVO.setTagType(CommonConstant.LOOKUP_CAT_CD_TRAVEL_STYLE_ZH);
				tpaVO.setCode(code);
				tourPkgDAO.insert(tpaVO);
			}
		}
		
		if(CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCountryVO().getIdRegionList())) {
			for(String region : tourPkgVO.getTourPkgCountryVO().getIdRegionList()) {
				TourPackageCountryVO tourPkgCountryVO = new TourPackageCountryVO();
				tourPkgCountryVO.setIdTourPkg(tourPkgVO.getId());
				tourPkgCountryVO.setCode(CommonConstant.TYPE_CD_REGION);
				tourPkgCountryVO.setIdLocation(Long.valueOf(region));
				tourPkgCountryVO.setStatusCd(CommonConstant.STATUS_CD_ACTIVE);
				tourPkgDAO.insert(tourPkgCountryVO);
			}
		}
		
		if(CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCountryVO().getIdCountryList())) {
			for(String country : tourPkgVO.getTourPkgCountryVO().getIdCountryList()) {
				TourPackageCountryVO tourPkgCountryVO = new TourPackageCountryVO();
				tourPkgCountryVO.setIdTourPkg(tourPkgVO.getId());
				tourPkgCountryVO.setCode(CommonConstant.TYPE_CD_COUNTRY);
				tourPkgCountryVO.setIdLocation(Long.valueOf(country));
				tourPkgCountryVO.setStatusCd(CommonConstant.STATUS_CD_ACTIVE);
				tourPkgDAO.insert(tourPkgCountryVO);
			}
		}
		
		if(CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCountryVO().getIdCityList())) {
			for(String city : tourPkgVO.getTourPkgCountryVO().getIdCityList()) {
				TourPackageCountryVO tourPkgCountryVO = new TourPackageCountryVO();
				tourPkgCountryVO.setIdTourPkg(tourPkgVO.getId());
				tourPkgCountryVO.setCode(CommonConstant.TYPE_CD_CITY);
				tourPkgCountryVO.setIdLocation(Long.valueOf(city));
				tourPkgCountryVO.setStatusCd(CommonConstant.STATUS_CD_ACTIVE);
				tourPkgDAO.insert(tourPkgCountryVO);
			}
		}
		
		// insert tour itinery
		if (CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgItineryVOList())) {
			for (TourPackageItineryVO vo : tourPkgVO.getTourPkgItineryVOList()) {
				vo.setIdTourPkg(tourPkgVO.getId());
				insertVO(vo);
			}
		}
		
		// insert tour image
		if (CollectionUtils.isNotEmpty(tourPkgVO.getTourImageVOList())) {
			for (TourImageVO vo : tourPkgVO.getTourImageVOList()) {
				vo.setIdTour(tourPkgVO.getId());
				insertVO(vo);
			}
		}
		
		// insert commision
		if (tourPkgVO.getTourPkgCommisionAUDList() != null) {
			if (CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCommisionAUDList().getAddList())) {
				for (TourPackageCommisionVO vo : tourPkgVO.getTourPkgCommisionAUDList().getAddList()) {
					vo.setIdTourPkg(tourPkgVO.getId()); 
					insertVO(vo);
				}
			}
		}
		
		// insert tour package daily itinerary
		for (TourPackageDailyItineraryVO dailyItineraryVO : tourPkgVO.getTourPkgDailyItineraryVOList()) {
			if (dailyItineraryVO.getPkgItineryMap() != null)
				dailyItineraryVO.setTourPackageItineryVOList(new ArrayList<TourPackageItineryVO>(dailyItineraryVO.getPkgItineryMap().values()));
			else 
				dailyItineraryVO.setTourPackageItineryVOList(new ArrayList<TourPackageItineryVO>());
				
			dailyItineraryVO.setIdTourPkg(tourPkgVO.getId());
			dailyItineraryVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
			insertVO(dailyItineraryVO);
			
			for (TourPackageItineryVO vo : dailyItineraryVO.getTourPackageItineryVOList()) {
				if (vo.getId() == null) {
					vo.setIdTourPkgDailyItinerary(dailyItineraryVO.getId());
					insertVO(vo);
				} else 
					updateVO(vo);
			}
			
			// Update Daily Itinerary Item
			updateTourPkgDailyItineraryItem(dailyItineraryVO);
		}
		
		// insert tour package tag
		for (TourPackageTagVO tagVO : tourPkgVO.getTourPackageTagVOList()) {
			tagVO.setIdTourPkg(tourPkgVO.getId());
			insertVO(tagVO);
		}
		
		for (TourPackageTagVO tagVO : tourPkgVO.getDelTourPackageTagVOList()) {
			deleteVO(tagVO);
		}
	}
	
	private void updateTourPkgDailyItineraryItem(TourPackageDailyItineraryVO dailyItineraryVO) throws BusinessException {
		if (dailyItineraryVO.getGenAUDDailyItineraryItemVOList() != null) {
			for (TourPackageDailyItineraryItemVO itemVO : dailyItineraryVO.getGenAUDDailyItineraryItemVOList().getAddList()) {
				itemVO.setIdTourPkgDailyItinerary(dailyItineraryVO.getId());
				itemVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
				insertVO(itemVO);
			}
			
			for (TourPackageDailyItineraryItemVO itemVO : dailyItineraryVO.getGenAUDDailyItineraryItemVOList().getUpdList()) {
				updateVO(itemVO);
			}
			
			for (TourPackageDailyItineraryItemVO itemVO : dailyItineraryVO.getGenAUDDailyItineraryItemVOList().getDelList()) {
				itemVO.setStatusCode(BaseConstant.STATUS_DELETED);
				updateVO(itemVO);
			}
			
			dailyItineraryVO.setGenAUDDailyItineraryItemVOList(new GenAddUpdDelVO<TourPackageDailyItineraryItemVO>());
		}
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.bo.TourPackageBO#addTourDep(com.bcs.zsg.product.vo.TourDepartureVO)
	 */
	@Override
	public void addTourDep(TourDepartureVO tourDepVO) throws BusinessException {
		if (isTourDepExisted(tourDepVO, null)) throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_EXISTED);
		if (tourDepVO.getSeatAllot().intValue() > 0 && tourDepVO.getSeatAllot().intValue() <= (tourDepVO.getReservedSeat().intValue() + tourDepVO.getTourManagerPax().intValue()))
			tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_FULL);
		
		// insert tour departure
		insertVO(tourDepVO);
		
		// insert depart date badge
		if (CollectionUtils.isNotEmpty(tourDepVO.getDepartDateBadgeList())) { 
			for (String code : tourDepVO.getDepartDateBadgeList()) {
				TourDepartureAttributeVO tdaVO = new TourDepartureAttributeVO();
				tdaVO.setIdTourDep(tourDepVO.getId());
				tdaVO.setTagType(CommonConstant.LOOKUP_CAT_CD_DEPART_DATE_BADGE);
				tdaVO.setCode(code);
				insertVO(tdaVO);
			}
		}
		
		if (CollectionUtils.isNotEmpty(tourDepVO.getDepartDateBadgeZhList())) { 
			for (String code : tourDepVO.getDepartDateBadgeZhList()) {
				TourDepartureAttributeVO tdaVO = new TourDepartureAttributeVO();
				tdaVO.setIdTourDep(tourDepVO.getId());
				tdaVO.setTagType(CommonConstant.LOOKUP_CAT_CD_DEPART_DATE_BADGE_ZH);
				tdaVO.setCode(code);
				insertVO(tdaVO);
			}
		}
		
		// insert tour itinery
		if (CollectionUtils.isNotEmpty(tourDepVO.getTourItineryList())) {
			for (TourItineryVO vo : tourDepVO.getTourItineryList()) {
				if (vo.getIsFromPkg())
					continue;
				
				vo.setIdTourDep(tourDepVO.getId());
				insertVO(vo);
			}
		}
		// insert tour hotel
		if (CollectionUtils.isNotEmpty(tourDepVO.getTourHotelList())) {
			for (TourHotelVO vo : tourDepVO.getTourHotelList()) {
				vo.setIdTourDep(tourDepVO.getId());
				insertVO(vo);
			}
		}
		// insert tour departure item
		if (CollectionUtils.isNotEmpty(tourDepVO.getTourDepItemList())) {
			for (TourDepItemVO vo : tourDepVO.getTourDepItemList()) {
				vo.setIdTourDep(tourDepVO.getId());
				vo.setQuantity(1);
				if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(vo.getCode())) { vo.setAirfare(tourDepVO.getAirfareSgl()); }
				if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(vo.getCode())) { vo.setAirfare(tourDepVO.getAirfareTwn()); }
				if (ProductConstant.TOUR_DEP_ITM_CD_FT_CTW.equals(vo.getCode())) { vo.setAirfare(tourDepVO.getAirfareCtw()); }
				if (ProductConstant.TOUR_DEP_ITM_CD_FT_CWB.equals(vo.getCode())) { vo.setAirfare(tourDepVO.getAirfareCeb()); }
				if (ProductConstant.TOUR_DEP_ITM_CD_FT_CNB.equals(vo.getCode())) { vo.setAirfare(tourDepVO.getAirfareCnb()); }
				insertVO(vo);
			}
		}
		
		// insert tour departure remarks
		if (CollectionUtils.isNotEmpty(tourDepVO.getTourPackageRemarksList())) { 
			for (TourPackageRemarksVO vo : tourDepVO.getTourPackageRemarksList()) { 
				vo.setIdTourDep(tourDepVO.getId()); 
				insertVO(vo);
			}
		}
		
		// insert tour departure discount
		if (tourDepVO.getGenAUDTourDepDiscountVO() != null) {
			if (CollectionUtils.isNotEmpty(tourDepVO.getGenAUDTourDepDiscountVO().getAddList())) {
				for (TourDepartureDiscountVO vo : tourDepVO.getGenAUDTourDepDiscountVO().getAddList()) {
					vo.setIdTourDep(tourDepVO.getId()); 
					insertVO(vo);
				}
			}
		}
		
		// insert tour departure season
		if (CollectionUtils.isNotEmpty(tourDepVO.getSelectedSeason())) {
			updateTourDepSeason(tourDepVO.getId(), tourDepVO.getSelectedSeason());
		}
		
		// insert tour cruise cabin
		if (CollectionUtils.isNotEmpty(tourDepVO.getTourCruiseCabinList())) {
			tourCruiseCabinService.addTourCruiseCabinList(tourDepVO.getTourCruiseCabinList(), tourDepVO);
		}
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.bo.TourPackageBO#updTourDep(com.bcs.zsg.product.vo.TourDepartureVO, com.bcs.zsg.common.vo.AddUpdDelVO, com.bcs.zsg.common.vo.AddUpdDelVO, com.bcs.zsg.common.vo.AddUpdDelVO)
	 */
	@Override
	public void updTourDep(TourDepartureVO tourDepVO, AddUpdDelVO itineryAUDVO, AddUpdDelVO tourHotelAUDVO, AddUpdDelVO tourDepItemAUDVO, AddUpdDelVO tourDepRemarks, List<List<TourDepItemVO>> delTourDepItemList) throws BusinessException {
		if (!tourDepVO.getCode().equals(tourDepVO.getTourDepHistoryVO().getCode()) || !tourDepVO.getDtDep().equals(tourDepVO.getTourDepHistoryVO().getDtDep())) {
			if (isTourDepExisted(tourDepVO, null)) throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_EXISTED);
		}
		
		int totalBook = bookingService.getTotalBookByTourDep(tourDepVO.getId(), null);
		int balance = tourDepVO.getSeatAllot() - tourDepVO.getTourManagerPax() - tourDepVO.getReservedSeat() - totalBook;
				//tourDepVO.getAgentPax() + tourDepVO.getInHsePax() + tourDepVO.getKivPax() + tourDepVO.getTfairPax());
		if (tourDepVO.getSeatAllot().intValue() > 0 && balance < 0) throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_BALANCE_OVER);
		
		int limitedSeatAllotment = Integer.parseInt(LookupItemUtils.getGlobalConfigValue(MaintConstant.GLOBAL_CD_GLOBAL, MaintConstant.GLOBAL_CD_SEAT_ALLOTMENT_LIMITED_STATUS));
		
		if (tourDepVO.getTourStatusCd().equals(ProductConstant.TOUR_STATUS_CD_FULL)) {
			if (tourDepVO.getSeatAllot().intValue() == 0) tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
			else if (balance > 0) {
				if (balance <= limitedSeatAllotment) tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_LIMITED);
				else tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
			}
		} else {
			if (tourDepVO.getTourStatusCd().equals(ProductConstant.TOUR_STATUS_CD_AVAILABLE) || tourDepVO.getTourStatusCd().equals(ProductConstant.TOUR_STATUS_CD_LIMITED)) {
				if (tourDepVO.getSeatAllot().intValue() > 0) {
					if (balance == 0) tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_FULL);
					else if (balance <= limitedSeatAllotment) tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_LIMITED);
					else tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
				}
			}
		}
		
		// delete all attribute before update tags
		tourPkgDAO.deleteTourDepartureTags(tourDepVO.getId());
		
		// insert depart date badge
		if (CollectionUtils.isNotEmpty(tourDepVO.getDepartDateBadgeList())) { 
			for (String code : tourDepVO.getDepartDateBadgeList()) {
				TourDepartureAttributeVO tdaVO = new TourDepartureAttributeVO();
				tdaVO.setIdTourDep(tourDepVO.getId());
				tdaVO.setTagType(CommonConstant.LOOKUP_CAT_CD_DEPART_DATE_BADGE);
				tdaVO.setCode(code);
				insertVO(tdaVO);
			}
		}
		
		if (CollectionUtils.isNotEmpty(tourDepVO.getDepartDateBadgeZhList())) { 
			for (String code : tourDepVO.getDepartDateBadgeZhList()) {
				TourDepartureAttributeVO tdaVO = new TourDepartureAttributeVO();
				tdaVO.setIdTourDep(tourDepVO.getId());
				tdaVO.setTagType(CommonConstant.LOOKUP_CAT_CD_DEPART_DATE_BADGE_ZH);
				tdaVO.setCode(code);
				insertVO(tdaVO);
			}
		}
		// update itinery
		if (CollectionUtils.isNotEmpty(tourDepVO.getTourItineryList())) {
			for (TourItineryVO vo : tourDepVO.getTourItineryList()) {
				if (vo.getIsFromPkg())
					continue;
					
				if (vo.getId() == null) {
					vo.setIdTourDep(tourDepVO.getId());
					insertVO(vo);
				} else updateVO(vo);
			}
		}
		// delete itinery
		if (CollectionUtils.isNotEmpty(itineryAUDVO.getDelList())) {
			for (Object obj : itineryAUDVO.getDelList()) deleteVO((TourItineryVO) obj);
		}
		
		// add tour hotel
		if (CollectionUtils.isNotEmpty(tourHotelAUDVO.getAddList())) {
			for (Object obj : tourHotelAUDVO.getAddList()) {
				TourHotelVO vo = (TourHotelVO) obj;
				vo.setIdTourDep(tourDepVO.getId());
				insertVO(vo);
			}
		}
		// delete tour hotel
		if (CollectionUtils.isNotEmpty(tourHotelAUDVO.getDelList())) {
			for (Object obj : tourHotelAUDVO.getDelList()) deleteVO((TourHotelVO) obj);
		}
		
		// add tour dep item
		if (CollectionUtils.isNotEmpty(tourDepItemAUDVO.getAddList())) {
			for (Object obj : tourDepItemAUDVO.getAddList()) {
				TourDepItemVO vo = (TourDepItemVO) obj;
				vo.setIdTourDep(tourDepVO.getId());
				insertVO(vo);
			}
		}
		// update tour dep item
		if (CollectionUtils.isNotEmpty(tourDepItemAUDVO.getUpdList())) {
			for (Object obj : tourDepItemAUDVO.getUpdList()) updateVO((TourDepItemVO) obj);
		}
		// delete tour dep item
		if (CollectionUtils.isNotEmpty(tourDepItemAUDVO.getDelList())) {
			for (Object obj : tourDepItemAUDVO.getDelList()) deleteVO((TourDepItemVO) obj);
		}
		// insert tour dep remarks
		if (CollectionUtils.isNotEmpty(tourDepRemarks.getAddList())) {
			for (Object obj : tourDepRemarks.getAddList()) {
				TourPackageRemarksVO vo = (TourPackageRemarksVO) obj;
				vo.setIdTourDep(tourDepVO.getId());
				insertVO(vo);
			}
		}
		// delete tour dep remarks
		if (CollectionUtils.isNotEmpty(tourDepRemarks.getDelList())) {
			for (Object obj : tourDepRemarks.getDelList()) deleteVO((TourPackageRemarksVO) obj);
		}
		// update tour dep remarks
		if (CollectionUtils.isNotEmpty(tourDepRemarks.getUpdList())) {
			for (Object obj : tourDepRemarks.getUpdList()) updateVO((TourPackageRemarksVO) obj);
		}
		// delete departure items
		if (CollectionUtils.isNotEmpty(delTourDepItemList)) {
			for (List<TourDepItemVO> list : delTourDepItemList) {
				for (TourDepItemVO vo : list) {
					deleteVO(vo);
				}
			}
		}
		
		// tour departure discount
		if (tourDepVO.getGenAUDTourDepDiscountVO() != null) {
			if (CollectionUtils.isNotEmpty(tourDepVO.getGenAUDTourDepDiscountVO().getAddList())) {
				for (TourDepartureDiscountVO vo : tourDepVO.getGenAUDTourDepDiscountVO().getAddList()) {
					vo.setIdTourDep(tourDepVO.getId()); 
					insertVO(vo);
				}
			}
			
			if (CollectionUtils.isNotEmpty(tourDepVO.getGenAUDTourDepDiscountVO().getUpdList())) {
				for (TourDepartureDiscountVO vo : tourDepVO.getGenAUDTourDepDiscountVO().getUpdList()) {
					updateVO(vo);
				}
			}
			
			if (CollectionUtils.isNotEmpty(tourDepVO.getGenAUDTourDepDiscountVO().getDelList())) {
				for (TourDepartureDiscountVO vo : tourDepVO.getGenAUDTourDepDiscountVO().getDelList()) {
					deleteVO(vo);
				}
			}
		}
		
		// update tour departure season
		if (CollectionUtils.isNotEmpty(tourDepVO.getSelectedSeason())) {
			updateTourDepSeason(tourDepVO.getId(), tourDepVO.getSelectedSeason());
		}

		// insert/update tour cruise cabin
		if (CollectionUtils.isNotEmpty(tourDepVO.getTourCruiseCabinList())) {
			tourCruiseCabinService.updTourCruiseCabinList(tourDepVO.getTourCruiseCabinList(), tourDepVO);
		}
		
		// update tour dep items value
		updTourDepItemsValue(tourDepVO);
		updateVO(tourDepVO);
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.bo.TourPackageBO#addTourDep(com.bcs.zsg.product.vo.TourDepartureVO)
	 */
	@Override
	public void cloneTourDep(TourDepartureVO tourDepVO) throws BusinessException {
		DateFormat dfm = new SimpleDateFormat("yyMMddHHmmss");
        Date d = new Date(); 
        
		String tempCode = tourDepVO.getCode();
		if(tempCode.indexOf("_clone") >= 0) {
			tempCode = tempCode.substring(0,tempCode.indexOf("_clone"));
		} 
		tourDepVO.setCode(tempCode+ "_clone" + dfm.format(d));
		tourDepVO.setPrn(null);
		tourDepVO.setTravelInsPolicyS(null);
		tourDepVO.setTravelInsPolicyF(null);
		tourDepVO.setIsIssuedS(false);
		tourDepVO.setIsIssuedF(false);
		if (isTourDepExisted(tourDepVO, null)) throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_EXISTED);
		
		addTourDep(tourDepVO);
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.service.TourPackageService#updateTourPkg(com.bcs.zsg.product.vo.TourPackageVO, com.bcs.zsg.history.vo.TourPackageHistoryVO)
	 */
	@Override
	public void updateTourPkg(TourPackageVO tourPkgVO, TourPackageHistoryVO tourPkgHistoryVO) throws BusinessException {
		// Update tour package
		updateVO(tourPkgVO);
		
		// before insert delete all tag
		tourPkgDAO.deleteTourPackageTags(tourPkgVO.getId()); 
		
		// insert package tags
		if (CollectionUtils.isNotEmpty(tourPkgVO.getTourBadgeTagList())) { 
			for (String code : tourPkgVO.getTourBadgeTagList()) {
				TourPackageAttributeVO tpaVO = new TourPackageAttributeVO();
				tpaVO.setIdTourPkg(tourPkgVO.getId());
				tpaVO.setTagType(CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE);
				tpaVO.setCode(code);
				tourPkgDAO.insert(tpaVO);
			}
		}
		
		if (CollectionUtils.isNotEmpty(tourPkgVO.getTourBadgeTagZhList())) { 
			for (String code : tourPkgVO.getTourBadgeTagZhList()) {
				TourPackageAttributeVO tpaVO = new TourPackageAttributeVO();
				tpaVO.setIdTourPkg(tourPkgVO.getId());
				tpaVO.setTagType(CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE_ZH);
				tpaVO.setCode(code);
				tourPkgDAO.insert(tpaVO);
			}
		}
		
		// insert travel style
		if (CollectionUtils.isNotEmpty(tourPkgVO.getTravelStyleList())) { 
			for (String code : tourPkgVO.getTravelStyleList()) {
				TourPackageAttributeVO tpaVO = new TourPackageAttributeVO();
				tpaVO.setIdTourPkg(tourPkgVO.getId());
				tpaVO.setTagType(CommonConstant.LOOKUP_CAT_CD_TRAVEL_STYLE);
				tpaVO.setCode(code);
				tourPkgDAO.insert(tpaVO);
			}
		}
		
		if (CollectionUtils.isNotEmpty(tourPkgVO.getTravelStyleZhList())) { 
			for (String code : tourPkgVO.getTravelStyleZhList()) {
				TourPackageAttributeVO tpaVO = new TourPackageAttributeVO();
				tpaVO.setIdTourPkg(tourPkgVO.getId());
				tpaVO.setTagType(CommonConstant.LOOKUP_CAT_CD_TRAVEL_STYLE_ZH);
				tpaVO.setCode(code);
				tourPkgDAO.insert(tpaVO);
			}
		}
		tourPkgDAO.deleteTourPackageCountryTags(tourPkgVO.getId()); 
		
		if(CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCountryVO().getIdRegionList())) {
			for(String region : tourPkgVO.getTourPkgCountryVO().getIdRegionList()) {
				TourPackageCountryVO tourPkgCountryVO = new TourPackageCountryVO();
				tourPkgCountryVO.setIdTourPkg(tourPkgVO.getId());
				tourPkgCountryVO.setCode(CommonConstant.TYPE_CD_REGION);
				tourPkgCountryVO.setIdLocation(Long.valueOf(region));
				tourPkgCountryVO.setStatusCd(CommonConstant.STATUS_CD_ACTIVE);
				tourPkgDAO.insert(tourPkgCountryVO);
			}
		}
		
		if(CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCountryVO().getIdCountryList())) {
			for(String country : tourPkgVO.getTourPkgCountryVO().getIdCountryList()) {
				TourPackageCountryVO tourPkgCountryVO = new TourPackageCountryVO();
				tourPkgCountryVO.setIdTourPkg(tourPkgVO.getId());
				tourPkgCountryVO.setCode(CommonConstant.TYPE_CD_COUNTRY);
				tourPkgCountryVO.setIdLocation(Long.valueOf(country));
				tourPkgCountryVO.setStatusCd(CommonConstant.STATUS_CD_ACTIVE);
				tourPkgDAO.insert(tourPkgCountryVO);
			}
		}
		
		if(CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCountryVO().getIdCityList())) {
			for(String city : tourPkgVO.getTourPkgCountryVO().getIdCityList()) {
				TourPackageCountryVO tourPkgCountryVO = new TourPackageCountryVO();
				tourPkgCountryVO.setIdTourPkg(tourPkgVO.getId());
				tourPkgCountryVO.setCode(CommonConstant.TYPE_CD_CITY);
				tourPkgCountryVO.setIdLocation(Long.valueOf(city));
				tourPkgCountryVO.setStatusCd(CommonConstant.STATUS_CD_ACTIVE);
				tourPkgDAO.insert(tourPkgCountryVO);
			}
		}
		
		// tour package commision
		if (tourPkgVO.getTourPkgCommisionAUDList() != null) {
			if (CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCommisionAUDList().getAddList())) {
				for (TourPackageCommisionVO vo : tourPkgVO.getTourPkgCommisionAUDList().getAddList()) {
					vo.setIdTourPkg(tourPkgVO.getId());
					insertVO(vo);
				}
			}

			if (CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCommisionAUDList().getUpdList())) {
				for (TourPackageCommisionVO vo : tourPkgVO.getTourPkgCommisionAUDList().getUpdList()) {
					updateVO(vo);
				}
			}

			if (CollectionUtils.isNotEmpty(tourPkgVO.getTourPkgCommisionAUDList().getDelList())) {
				for (TourPackageCommisionVO vo : tourPkgVO.getTourPkgCommisionAUDList().getDelList()) {
					deleteVO(vo);
				}
			}
		}
		
		for (TourPackageItineryVO vo : tourPkgVO.getTourPkgItineryVOList()) {
			if (vo.getId() == null) {
				vo.setIdTourPkg(tourPkgVO.getId());
				insertVO(vo);
			} else 
				updateVO(vo);
		}
		
		if (CollectionUtils.isNotEmpty(tourPkgVO.getTourImageVOList())) {
			for (TourImageVO vo : tourPkgVO.getTourImageVOList()) {
				if (vo.getId() == null) {
					vo.setIdTour(tourPkgVO.getId());
					insertVO(vo);
				} else 
					updateVO(vo);
			}
		}
		
		for (TourPackageDailyItineraryVO dailyItineraryVO : tourPkgVO.getTourPkgDailyItineraryVOList()) {
			
			if (dailyItineraryVO.getPkgItineryMap() != null)
				dailyItineraryVO.setTourPackageItineryVOList(new ArrayList<TourPackageItineryVO>(dailyItineraryVO.getPkgItineryMap().values()));
			else 
				dailyItineraryVO.setTourPackageItineryVOList(new ArrayList<TourPackageItineryVO>());
				
			if (dailyItineraryVO.getId() == null) {
				dailyItineraryVO.setIdTourPkg(tourPkgVO.getId());
				dailyItineraryVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
				insertVO(dailyItineraryVO);
				
				for (TourPackageItineryVO vo : dailyItineraryVO.getTourPackageItineryVOList()) {
					if (vo.getId() == null) {
						vo.setIdTourPkgDailyItinerary(dailyItineraryVO.getId());
						insertVO(vo);
					} else 
						updateVO(vo);
				}
				
				// Update Daily Itinerary Item
				updateTourPkgDailyItineraryItem(dailyItineraryVO);
			} else {
				updateVO(dailyItineraryVO);
				
				for (TourPackageItineryVO vo : dailyItineraryVO.getTourPackageItineryVOList()) {
					if (vo.getId() == null) {
						vo.setIdTourPkgDailyItinerary(dailyItineraryVO.getId());
						insertVO(vo);
					} else 
						updateVO(vo);
				}
				
				// Update Daily Itinerary Item
				updateTourPkgDailyItineraryItem(dailyItineraryVO);
			}
			
			if (dailyItineraryVO.getGenAUDTourPkgItineraryVO() != null) {
				for (TourPackageItineryVO vo : dailyItineraryVO.getGenAUDTourPkgItineraryVO().getDelList()) {
					tourPkgDAO.delTourPackageItinery(vo.getId());
				}
			}
		}
		
		if (tourPkgVO.getTourPkgDailyItineraryAUDList() != null) {
			for (TourPackageDailyItineraryVO dailyItineraryVO : tourPkgVO.getTourPkgDailyItineraryAUDList().getDelList()) {
				dailyItineraryVO.setStatusCode(BaseConstant.STATUS_DELETED);
				updateVO(dailyItineraryVO);
				
				// Update Daily Itinerary Item
				for (TourPackageDailyItineraryItemVO itemVO : dailyItineraryVO.getDailyItineraryItemEngVOList()) {
					itemVO.setStatusCode(BaseConstant.STATUS_DELETED);
					updateVO(itemVO);
				}
				
				for (TourPackageDailyItineraryItemVO itemVO : dailyItineraryVO.getDailyItineraryItemZhVOList()) {
					itemVO.setStatusCode(BaseConstant.STATUS_DELETED);
					updateVO(itemVO);
				}
			}
			
			tourPkgVO.setTourPkgDailyItineraryAUDList(new GenAddUpdDelVO<TourPackageDailyItineraryVO>());
		}
		
		// Delete itinery
		if (tourPkgVO.getTourPkgItineryAUDList() != null) {
			for (TourPackageItineryVO vo : tourPkgVO.getTourPkgItineryAUDList().getDelList()) {
				tourPkgDAO.delTourPackageItinery(vo.getId());
			}
		}
		
		// Delete Tour Image
		if (tourPkgVO.getTourImageAUDList() != null) {
			for (TourImageVO vo : tourPkgVO.getTourImageAUDList().getDelList()) {
				tourPkgDAO.delete(vo);
			}
		}
		
		// update others
		if (tourPkgHistoryVO != null && !tourPkgVO.getTfairDiscount().equals(tourPkgHistoryVO.getTfairDiscount())) {
			tourPkgDAO.updateTourDepsDiscount(tourPkgVO);
		}
		
		// insert tour package tag
		for (TourPackageTagVO tagVO : tourPkgVO.getTourPackageTagVOList()) {
			if (tagVO.getId() == null) {
				tagVO.setIdTourPkg(tourPkgVO.getId());
				insertVO(tagVO);
			}
		}
		
		for (TourPackageTagVO tagVO : tourPkgVO.getDelTourPackageTagVOList()) {
			deleteVO(tagVO);
		}
		
	}

