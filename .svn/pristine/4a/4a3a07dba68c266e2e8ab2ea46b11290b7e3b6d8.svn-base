	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.service.TourPackageService#addTourTheme(com.bcs.zsg.product.vo.TourThemeVO)
	 */
	@Override
	public void addTourTheme(TourThemeVO tourThemeVO) throws BusinessException {
		tourPkgDAO.insert(tourThemeVO);
		
		for (Long country : tourThemeVO.getSelectedCountries()) {
			TourThemeCountryVO ttcVO = new TourThemeCountryVO();
			ttcVO.setIdTourTheme(tourThemeVO.getId());
			ttcVO.setIdCountry(country);
			tourPkgDAO.insert(ttcVO);
		}
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.service.TourPackageService#updTourTheme(com.bcs.zsg.product.vo.TourThemeVO)
	 */
	@Override
	public void updTourTheme(TourThemeVO tourThemeVO) throws BusinessException {
		tourPkgDAO.update(tourThemeVO);
		
		tourPkgDAO.delTourThemeCountry(tourThemeVO.getId());
		
		for (Long country : tourThemeVO.getSelectedCountries()) {
			TourThemeCountryVO ttcVO = new TourThemeCountryVO();
			ttcVO.setIdTourTheme(tourThemeVO.getId());
			ttcVO.setIdCountry(country);
			tourPkgDAO.insert(ttcVO);
		}
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.service.TourPackageService#delTourDep(com.bcs.zsg.product.vo.TourDepartureVO)
	 */
	@Override
	public void delTourDep(TourDepartureVO tourDepVO) throws BusinessException {
		if (bookingDAO.getBookingList(tourDepVO.getId()).size() > 0) throw new BusinessException(CommonErrConstant.ERR_TOUR_DEP_BOOKED);
		
		// delete tour itineries
		tourPkgDAO.delTourItinery(tourDepVO.getId());
		// delete tour hotels
		tourPkgDAO.delTourHotel(tourDepVO.getId());
		// delete tour departure items
		tourPkgDAO.delTourDepItem(tourDepVO.getId());
		// delete tour departure remarks
		tourPkgDAO.delTourDepRemarks(tourDepVO.getId());
		// delete tour departure discount
		tourPkgDAO.delTourDepDiscount(tourDepVO.getId());
		// delete tour departure - change status to inactive
		tourDepVO.setStatusCode(CommonConstant.STATUS_CD_CANCELLED);
		updateVO(tourDepVO);
		//deleteVO(tourDepVO);
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.service.TourPackageService#getTourThemeList(com.bcs.zsg.common.vo.SearchParamVO, int)
	 */
	@Override
	public List<TourThemeVO> getTourThemeList(SearchParamVO searchParamVO, int level) throws BusinessException {
		int maxYearRange = Integer.valueOf(SystemProperty.LISTING_YEAR_RANGE);
		List<String> yearList = new ArrayList<>();
		List<TourThemeVO> tourThemeList = null;
		
		tourThemeList = tourPkgDAO.getTourThemeList(searchParamVO, null);
		
		if (CollectionUtils.isNotEmpty(tourThemeList)) {
			if (StringUtils.equals((String) searchParamVO.getObj1(), ProductConstant.TYPE_TOUR)
					|| StringUtils.equals((String) searchParamVO.getObj1(), ProductConstant.TYPE_CRUISE)) {
				SimpleDateFormat yearFormat = new SimpleDateFormat("yyyy");
				Calendar cal = Calendar.getInstance();
				cal.setTime(new Date());
				String currentYear = yearFormat.format(cal.getTime());
				yearList.add(currentYear);
				
				for (int i = 1; i < maxYearRange; i++) {
					cal.add(Calendar.YEAR, 1);
					String nextYear = yearFormat.format(cal.getTime());
					yearList.add(nextYear);
				}
			}
			
			for (TourThemeVO tourThemeVO : tourThemeList) {
				handleTourThemeListTree(searchParamVO, tourThemeVO, yearList);
			}
		}
		
		return tourThemeList;
	}
	
