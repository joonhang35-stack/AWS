	private void populateTourDepDetailCruise(Long idTourPkg, List<TourDepartureVO> tourDepList, CompanyVO companyVO) throws BusinessException {
		if (CollectionUtils.isNotEmpty(tourDepList)) {
			SimpleDateFormat monthFormat = new SimpleDateFormat("MM-yyyy");
			String dtDep = null;
			int groupColor = 0;
			
			int count = 0;
			for (TourDepartureVO vo : tourDepList) {
				if (count == 0) {
					dtDep = monthFormat.format(vo.getDtDep());
					vo.setGroupColor(groupColor);
					
				} else {
					if (dtDep.equals(monthFormat.format(vo.getDtDep()))) {
						vo.setGroupColor(groupColor);
						
					} else {
						dtDep = monthFormat.format(vo.getDtDep());
						if (groupColor == 0) groupColor = 1;
						else groupColor = 0;
						vo.setGroupColor(groupColor);
					}
				}
				
				if (vo.getIsDepositPaid()) {
					vo.setDuration("PD ");
				}
				vo.setDuration(vo.getDuration() + vo.getNumDays() + "D/" + vo.getNumNights() + "N");
				if (StringUtils.isNotEmpty(vo.getDesc())) {
					vo.setDuration(vo.getDuration() + "[" + vo.getDesc() + "]");
				}
				if (StringUtils.isNotEmpty(vo.getPrn())) {
					vo.setDuration(vo.getDuration() + "[" + vo.getPrn() + "]");
				}
				if (vo.getIsIssuedS()) {
					vo.setDuration(vo.getDuration() + "[S]");
				}
				if (vo.getIsIssuedF()) {
					vo.setDuration(vo.getDuration() + "[F]");
				}
				if (vo.getIsPush()) {
					vo.setDuration(vo.getDuration() + "PUSH");
				}
				
				vo.setTourItineryList(tourPkgDAO.getTourItineryList(vo.getId()));
				
				if (CollectionUtils.isEmpty(vo.getTourItineryList())) {
					vo.setTourItineryList(new ArrayList<TourItineryVO>());
				}
				
				Long idTourPkgSearch = idTourPkg;
				if (idTourPkg == null)
					idTourPkgSearch = vo.getIdTourPkg();
				
				for (TourPackageItineryVO itineryPkgVO : getTourPkgItineryList(idTourPkgSearch)) {
					boolean isMatch = false;
					for (TourItineryVO itineryVO : vo.getTourItineryList()) {
						if (StringUtils.equals(itineryVO.getLangCd(), itineryPkgVO.getLangCd()) && StringUtils.equals(itineryVO.getTypeCd(), itineryPkgVO.getTypeCd())) {
							isMatch = true;
							break;
						}
					}
					
					if (!isMatch) {
						TourItineryVO tourItineryVO = new TourItineryVO();
						tourItineryVO.setName(itineryPkgVO.getName());
						tourItineryVO.setLangCd(itineryPkgVO.getLangCd());
						tourItineryVO.setPath(itineryPkgVO.getPath());
						tourItineryVO.setTypeCd(itineryPkgVO.getTypeCd());
						tourItineryVO.setCreatedBy(itineryPkgVO.getCreatedBy());
						tourItineryVO.setCreatedDate(itineryPkgVO.getCreatedDate());
						tourItineryVO.setIsFromPkg(true);
						vo.getTourItineryList().add(tourItineryVO);
					}
				}
				
				//vo.setDepartDateBadgeList(tourPkgDAO.getDepartureTagList(vo.getId(), CommonConstant.LOOKUP_CAT_CD_DEPART_DATE_BADGE));
				//vo.setAirlineVO(airlineDAO.getAirline(vo.getIdAirline()));
				if (companyVO != null) {
					vo.setAccCodeStatusCd(tourPkgDAO.getTourAcctCdStatusCd(vo, companyVO, ProductConstant.TYPE_CRUISE));
				}
				
				//Daily Itinerary
				if (vo.getTourPkgDailyCms() != null) {
					vo.setTourPackageDailyItineraryVO(getTourPkgDailyItinerary(vo.getTourPkgDailyCms()));
					vo.setDailyCmsTitle(vo.getTourPackageDailyItineraryVO() != null ? vo.getTourPackageDailyItineraryVO().getTitle() : null);
					vo.setDailyCode(vo.getTourPackageDailyItineraryVO() != null ? vo.getTourPackageDailyItineraryVO().getCode() : null);
				}
				count++;
			}
		}
	}

