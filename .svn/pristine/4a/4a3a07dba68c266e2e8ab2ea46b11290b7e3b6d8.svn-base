	/**
	 * Handle tour booking pax
	 * @param vo
	 */
	@Override
	public int handleTourBookingPax(TourDepartureVO tourDepVO) throws BusinessException {
		List<BookingVO> bookingList = bookingDAO.getBookingList(tourDepVO.getId());
		int balance = -1;
		if (CollectionUtils.isNotEmpty(bookingList)) {
			int tfairPax = 0;
			int agentPax = 0;
			int inHsePax = 0;
			int on9BookingPax = 0;
			int kivPax = 0;
			int totalGA = 0;
			
			for (BookingVO vo : bookingList) {
				if (CollectionUtils.isNotEmpty(vo.getBookingChargeItemSet())) {
					for (BookingChargeItemVO itemVO : vo.getBookingChargeItemSet()) {
						if (CommonConstant.STATUS_CD_BOOKED.equals(vo.getStatusCode()) && SalesConstant.BOOKING_PMNT_STATUS_KIV.equals(vo.getPmntStatusCd()))
							kivPax = caculateTourPax(itemVO, kivPax);
						else {
							if (SalesConstant.BOOKING_ORDER_TYPE_TFAIR.equals(vo.getOrderTypeCd())) tfairPax = caculateTourPax(itemVO, tfairPax);
							else if (SalesConstant.BOOKING_ORDER_TYPE_AGENT.equals(vo.getOrderTypeCd())) agentPax = caculateTourPax(itemVO, agentPax);
							else if (SalesConstant.BOOKING_ORDER_TYPE_INHSE.equals(vo.getOrderTypeCd())) inHsePax = caculateTourPax(itemVO, inHsePax);
							else if (SalesConstant.BOOKING_ORDER_TYPE_ONLINE.equals(vo.getOrderTypeCd())) on9BookingPax = caculateTourPax(itemVO, on9BookingPax);
						}
						if (itemVO.getCode().startsWith(SalesConstant.BOOKING_PAX_GA)) totalGA += itemVO.getQuantity();
					}
				}
			}
			tourDepVO.setTfairPax(tfairPax);
			tourDepVO.setAgentPax(agentPax);
			tourDepVO.setInHsePax(inHsePax);
			tourDepVO.setOn9BookingPax(on9BookingPax);
			tourDepVO.setKivPax(kivPax);
			tourDepVO.setTotalGA(totalGA);
			
			balance = tourDepVO.getSeatAllot() - tourDepVO.getTourManagerPax() - tourDepVO.getReservedSeat() - tourDepVO.getTfairPax() -
					tourDepVO.getAgentPax() - tourDepVO.getInHsePax() - tourDepVO.getKivPax() - tourDepVO.getOn9BookingPax() - tourDepVO.getOn9BookingPax();
			// TODO will change to event scheduler call to store proc
			if (ProductConstant.TOUR_STATUS_CD_FULL.equals(tourDepVO.getTourStatusCd())) {
				if (balance > 0) {
					tourDepVO.setTourStatusCd(ProductConstant.TOUR_STATUS_CD_AVAILABLE);
					updateVO(tourDepVO);
				}
			}
		}
		return balance;
	}
	
