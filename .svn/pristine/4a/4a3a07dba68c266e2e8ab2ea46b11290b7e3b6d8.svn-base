	/* (non-Javadoc)
	 * @see com.bcs.zsg.sales.service.CustomerService#updObjList(com.bcs.zsg.sales.vo.CustomerVO, com.bcs.zsg.common.vo.AddUpdDelVO)
	 */
	@Override
	public void updObjList(TourPackageRemarksVO tourPackageRemarksVO, AddUpdDelVO objectVO) throws BusinessException {
		if (objectVO.getAddList().size() > 0) {
			for (Object vo : objectVO.getAddList()) { 
				if (vo instanceof TourPackageRemarksVO) tourPkgDAO.insert((TourPackageRemarksVO) vo);
			}
		}
		
		if (objectVO.getUpdList().size() > 0) {
			for (Object vo : objectVO.getUpdList()) {

				if (vo instanceof TourPackageRemarksVO) tourPkgDAO.update((TourPackageRemarksVO) vo);
			}
		}

		if (objectVO.getDelList().size() > 0) {
			for (Object vo : objectVO.getDelList()) { 
				if (vo instanceof TourPackageRemarksVO) tourPkgDAO.delete((TourPackageRemarksVO) vo);
			}
		}
	}

