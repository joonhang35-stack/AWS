	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.service.TourPackageService#setMiscAdtChd(com.bcs.zsg.product.vo.TourDepartureVO, com.bcs.zsg.product.vo.AirlineScheduleVO)
	 */
	@Override
	public void setMiscAdtChd(TourDepartureVO tourDepVO, AirlineScheduleVO airlineScheduleVO) throws BusinessException {
		double miscAdt = 0;
		double miscChd = 0;
		double aptAdt = 0;
		double aptChd = 0;
		double yqAdt = 0;
		double yqChd = 0;
		double trvlIns = 0;
		double visa = 0;
		double ac = 0;
		double tipping = 0;
		double deviation = 0;
		double extraMisc = 0;
		int tktValidity = 0;
		double grdMiscAdtChd = 0;
		
		if (airlineScheduleVO != null) {
			aptAdt = airlineScheduleVO.getAmtAptAdt();
			aptChd = airlineScheduleVO.getAmtAptChd();
			yqAdt = airlineScheduleVO.getAmtFuelAdt();
			yqChd = airlineScheduleVO.getAmtFuelChd();
			trvlIns = airlineScheduleVO.getAmtTrvlIns();
			visa = airlineScheduleVO.getAmtVisa();
			ac = airlineScheduleVO.getAmtAC();
			tipping = airlineScheduleVO.getAmtTipping();
			deviation = airlineScheduleVO.getAmtDeviation();
			tktValidity = airlineScheduleVO.getTktValidity();
			
			List<AirlineScheduleChargeVO> chargeList = airlineService.getAirlineScheduleChargeList(airlineScheduleVO.getId());
			if (CollectionUtils.isNotEmpty(chargeList)) {
				airlineScheduleVO.setExtraItemChargeList(chargeList);
				for (AirlineScheduleChargeVO chargeVO : chargeList) {
					if (chargeVO.getIsMisc()) extraMisc += chargeVO.getAmount();
				}
			}
		}
		
		if (CollectionUtils.isNotEmpty(tourDepVO.getTourDepItemList())) {
			if (CollectionUtils.isEmpty(tourDepVO.getExtraItemChargeList())) tourDepVO.setExtraItemChargeList(new ArrayList<TourDepItemVO>());
			for (TourDepItemVO vo : tourDepVO.getTourDepItemList()) {
				if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(vo.getTypeCd())) {
					if (vo.getIsMisc()) extraMisc += vo.getAmount();
				}
				
				if (vo.getIdInvEoItem() != null) {
					tourDepVO.getExtraItemChargeList().add(vo);
				}
			}
		}
		
		miscAdt = aptAdt + yqAdt + trvlIns + visa + ac + tipping + extraMisc;
		miscChd = aptChd + yqChd + trvlIns + visa + ac + tipping + extraMisc;
		grdMiscAdtChd = trvlIns + visa + tipping;
		
		tourDepVO.setMiscAdt(miscAdt);
		tourDepVO.setMiscChd(miscChd);
		tourDepVO.setAirlineAptAdt(aptAdt);
		tourDepVO.setAirlineAptChd(aptChd);
		tourDepVO.setAirlineYqAdt(yqAdt);
		tourDepVO.setAirlineYqChd(yqChd);
		tourDepVO.setAirlineTrvlIns(trvlIns);
		tourDepVO.setAirlineVisa(visa);
		tourDepVO.setAirlineAC(ac);
		tourDepVO.setAirlineTipping(tipping);
		tourDepVO.setAirlineDeviation(deviation);
		tourDepVO.setAirlineExtra(extraMisc);
		tourDepVO.setAirlineTotAdt(miscAdt);
		tourDepVO.setAirlineTotChd(miscChd);
		tourDepVO.setTktValidity(tktValidity);
		tourDepVO.setGrdMiscAdtChd(grdMiscAdtChd);
	}
	
	public void setCruiseMiscAdtChd(TourDepartureVO tourDepVO, CruiseScheduleVO cruiseScheduleVO) throws BusinessException {
		double miscAdt = 0;
		double miscChd = 0;
		double aptAdt = 0;
		double aptChd = 0;
		double yqAdt = 0;
		double yqChd = 0;
		double trvlIns = 0;
		double visa = 0;
		double ac = 0;
		double tipping = 0;
		double deviation = 0;
		double extraMisc = 0;
		int tktValidity = 0;
		double grdMiscAdtChd = 0;
		
		if (cruiseScheduleVO != null) {
			aptAdt = cruiseScheduleVO.getAmtAptAdt();
			aptChd = cruiseScheduleVO.getAmtAptChd();
			yqAdt = cruiseScheduleVO.getAmtFuelAdt();
			yqChd = cruiseScheduleVO.getAmtFuelChd();
			trvlIns = cruiseScheduleVO.getAmtTrvlIns();
			visa = cruiseScheduleVO.getAmtVisa();
			ac = cruiseScheduleVO.getAmtAC();
			tipping = cruiseScheduleVO.getAmtTipping();
			deviation = cruiseScheduleVO.getAmtDeviation();
			tktValidity = cruiseScheduleVO.getTktValidity();
			
			List<CruiseScheduleChargeVO> chargeList = cruiseService.getCruiseScheduleChargeList(cruiseScheduleVO.getId());
			if (CollectionUtils.isNotEmpty(chargeList)) {
				cruiseScheduleVO.setExtraItemChargeList(chargeList);
				for (CruiseScheduleChargeVO chargeVO : chargeList) {
					if (chargeVO.getIsMisc()) extraMisc += chargeVO.getAmount();
				}
			}
		}
		
		if (CollectionUtils.isNotEmpty(tourDepVO.getTourDepItemList())) {
			for (TourDepItemVO vo : tourDepVO.getTourDepItemList()) {
				if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(vo.getTypeCd())) {
					if (vo.getIsMisc()) extraMisc += vo.getAmount();
				}
			}
		}
		
		miscAdt = aptAdt + yqAdt + trvlIns + visa + ac + tipping + extraMisc + deviation;
		miscChd = aptChd + yqChd + trvlIns + visa + ac + tipping + extraMisc + deviation;
		grdMiscAdtChd = trvlIns + visa + tipping;
		
		tourDepVO.setMiscAdt(miscAdt);
		tourDepVO.setMiscChd(miscChd);
		tourDepVO.setCruiseMiscAdt(miscAdt);
		tourDepVO.setCruiseMiscChd(miscChd);
		tourDepVO.setCruiseAptAdt(aptAdt);
		tourDepVO.setCruiseAptChd(aptChd);
		tourDepVO.setCruiseYqAdt(yqAdt);
		tourDepVO.setCruiseYqChd(yqChd);
		tourDepVO.setCruiseTrvlIns(trvlIns);
		tourDepVO.setCruiseVisa(visa);
		tourDepVO.setCruiseAC(ac);
		tourDepVO.setCruiseTipping(tipping);
		tourDepVO.setCruiseDeviation(deviation);
		tourDepVO.setCruiseExtra(extraMisc);
		tourDepVO.setCruiseTotAdt(miscAdt);
		tourDepVO.setCruiseTotChd(miscChd);
		tourDepVO.setTktValidity(tktValidity);
		tourDepVO.setGrdMiscAdtChd(grdMiscAdtChd);
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.service.TourPackageService#setMiscAdtChd(com.bcs.zsg.product.vo.TourDepartureVO, com.bcs.zsg.sales.vo.BookingVO)
	 */
	@Override
	public void setMiscAdtChd(TourDepartureVO tourDepVO, BookingVO bookingVO) throws BusinessException {
		if (CollectionUtils.isNotEmpty(bookingVO.getBookingChargeItemList())) {
			
			List<AirlineScheduleChargeVO> chargeList = airlineService.getAirlineScheduleChargeList(tourDepVO.getIdAirlineSchedule());
			double extraMisc = 0;
			
			for (BookingChargeItemVO vo : bookingVO.getBookingChargeItemList()) {
				if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(vo.getCode())) { bookingVO.setPaxFullSgl(vo.getQuantity()); bookingVO.setAmtFullSgl(vo.getAmount()); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(vo.getCode())) { bookingVO.setPaxFullTwn(vo.getQuantity()); bookingVO.setAmtFullTwn(vo.getAmount()); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CTW.equals(vo.getCode())) { bookingVO.setPaxFullCtw(vo.getQuantity()); bookingVO.setAmtFullCtw(vo.getAmount()); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CWB.equals(vo.getCode())) { bookingVO.setPaxFullCeb(vo.getQuantity()); bookingVO.setAmtFullCeb(vo.getAmount()); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CNB.equals(vo.getCode())) { bookingVO.setPaxFullCnb(vo.getQuantity()); bookingVO.setAmtFullCnb(vo.getAmount()); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_FT_INFT.equals(vo.getCode())) { bookingVO.setPaxFullInft(vo.getQuantity()); bookingVO.setAmtFullInft(vo.getAmount()); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_GA_SGL.equals(vo.getCode())) { bookingVO.setPaxGrndSgl(vo.getQuantity()); bookingVO.setAmtGrndSgl(vo.getAmount()); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_GA_TWN.equals(vo.getCode())) { bookingVO.setPaxGrndTwn(vo.getQuantity()); bookingVO.setAmtGrndTwn(vo.getAmount()); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CTW.equals(vo.getCode())) { bookingVO.setPaxGrndCtw(vo.getQuantity()); bookingVO.setAmtGrndCtw(vo.getAmount()); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CWB.equals(vo.getCode())) { bookingVO.setPaxGrndCeb(vo.getQuantity()); bookingVO.setAmtGrndCeb(vo.getAmount()); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CNB.equals(vo.getCode())) { bookingVO.setPaxGrndCnb(vo.getQuantity()); bookingVO.setAmtGrndCnb(vo.getAmount()); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_GA_INFT.equals(vo.getCode())) { bookingVO.setPaxGrndInft(vo.getQuantity()); bookingVO.setAmtGrndInft(vo.getAmount()); }
				else if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(vo.getCode())) bookingVO.setDiscount(vo.getAmount());
				else if (ProductConstant.AIRLINE_ITM_CD_APT_ADT.equals(vo.getCode())) bookingVO.setAirlineAptAdt(vo.getAmount());
				else if (ProductConstant.AIRLINE_ITM_CD_APT_CHD.equals(vo.getCode())) bookingVO.setAirlineAptChd(vo.getAmount());
				else if (ProductConstant.AIRLINE_ITM_CD_FUEL_ADT.equals(vo.getCode())) bookingVO.setAirlineYqAdt(vo.getAmount());
				else if (ProductConstant.AIRLINE_ITM_CD_FUEL_CHD.equals(vo.getCode())) bookingVO.setAirlineYqChd(vo.getAmount());
				else if (ProductConstant.AIRLINE_ITM_CD_TRVL_INS.equals(vo.getCode())) bookingVO.setAirlineTrvlIns(vo.getAmount());
				else if (ProductConstant.AIRLINE_ITM_CD_VISA.equals(vo.getCode())) bookingVO.setAirlineVisa(vo.getAmount());
				else if (ProductConstant.AIRLINE_ITM_CD_AC.equals(vo.getCode())) bookingVO.setAirlineAC(vo.getAmount());
				else if (ProductConstant.AIRLINE_ITM_CD_TIPPING.equals(vo.getCode())) bookingVO.setAirlineTipping(vo.getAmount());
				else if (ProductConstant.AIRLINE_ITM_CD_DEVIATION.equals(vo.getCode())) bookingVO.setAirlineDeviation(vo.getAmount());
				else {
					if (CollectionUtils.isNotEmpty(chargeList)) {
						for (AirlineScheduleChargeVO chargeVO : chargeList) {
							if (vo.getCode().equals(chargeVO.getTypeCd())) {
								if (chargeVO.getIsMisc()) extraMisc += chargeVO.getAmount();
								break;
							}
						}
					}
					
					List<TourDepItemVO> tourDepItemList = tourDepVO.getTourDepItemList();
					if (CollectionUtils.isEmpty(tourDepVO.getTourDepItemList())) tourDepItemList = tourPkgDAO.getTourDepItemList(tourDepVO.getId(), null, null);
					
					if (CollectionUtils.isNotEmpty(tourDepItemList)) {
						for (TourDepItemVO itemVO : tourDepItemList) {
							if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(itemVO.getTypeCd()) && vo.getCode().equals(itemVO.getCode())) {
								if (itemVO.getIsMisc()) extraMisc += vo.getAmount();
								break;
							}
						}
					}
				}
			}
			bookingVO.setAirlineExtra(extraMisc);
			bookingVO.setAirlineTotAdt(bookingVO.getAirlineAptAdt() + bookingVO.getAirlineYqAdt() + bookingVO.getAirlineTrvlIns() +
					bookingVO.getAirlineVisa() + bookingVO.getAirlineTipping() + extraMisc + bookingVO.getAirlineAC());
			bookingVO.setAirlineTotChd(bookingVO.getAirlineAptChd() + bookingVO.getAirlineYqChd() + bookingVO.getAirlineTrvlIns() +
					bookingVO.getAirlineVisa() + bookingVO.getAirlineTipping() + extraMisc + bookingVO.getAirlineAC());
			tourDepVO.setGrdMiscAdtChd(bookingVO.getAirlineTrvlIns() + bookingVO.getAirlineVisa() + bookingVO.getAirlineTipping());
		}
	}
	
	public void setCruiseMiscAdtChd(TourDepartureVO tourDepVO, BookingVO bookingVO) throws BusinessException {
		if (CollectionUtils.isNotEmpty(bookingVO.getBookingChargeItemList())) {
			List<CruiseScheduleChargeVO> chargeList = cruiseService.getCruiseScheduleChargeList(tourDepVO.getIdCruiseSchedule());
			double extraMisc = 0;
			boolean isFare = false;
			double subTotal = 0.00;
			double totalAmt = 0.00;
			double ttlAgentComm = 0.00;
			int adultTourPax = 0;
			int adultGroundPax = 0;
			int childTourPax = 0;
			int childGroundPax = 0;
			List<BookingChargeItemVO> bookingChargeItemList = new ArrayList<BookingChargeItemVO>();
			List<BookingChargeItemVO> additionalTaxList = new ArrayList<BookingChargeItemVO>();
			List<BookingChargeItemVO> miscChargesList = new ArrayList<BookingChargeItemVO>();
			List<BookingChargeItemVO> depositList = new ArrayList<BookingChargeItemVO>();
			List<BookingChargeItemVO> discountList = new ArrayList<BookingChargeItemVO>();
			List<BookingChargeItemVO> commList = new ArrayList<BookingChargeItemVO>();
			
			for (BookingChargeItemVO vo : bookingVO.getBookingChargeItemList()) {
				System.out.println("vo.getCode: " + vo.getCode());
				isFare = false;
				
				if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(vo.getCode())) {
					bookingVO.setPaxFullSgl(vo.getQuantity());
					bookingVO.setAmtFullSgl(vo.getAmount());
					isFare = true;
					adultTourPax += vo.getQuantity();
				} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(vo.getCode())) {
					bookingVO.setPaxFullTwn(vo.getQuantity());
					bookingVO.setAmtFullTwn(vo.getAmount());
					isFare = true;
					adultTourPax += vo.getQuantity();
				} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CTW.equals(vo.getCode())) {
					bookingVO.setPaxFullCtw(vo.getQuantity());
					bookingVO.setAmtFullCtw(vo.getAmount());
					isFare = true;
					childTourPax += vo.getQuantity();
				} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CWB.equals(vo.getCode())) {
					bookingVO.setPaxFullCeb(vo.getQuantity());
					bookingVO.setAmtFullCeb(vo.getAmount());
					isFare = true;
					childTourPax += vo.getQuantity();
				} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CNB.equals(vo.getCode())) {
					bookingVO.setPaxFullCnb(vo.getQuantity());
					bookingVO.setAmtFullCnb(vo.getAmount());
					isFare = true;
					childTourPax += vo.getQuantity();
				} else if (ProductConstant.TOUR_DEP_ITM_CD_FT_INFT.equals(vo.getCode())) {
					bookingVO.setPaxFullInft(vo.getQuantity());
					bookingVO.setAmtFullInft(vo.getAmount());
					isFare = true;
					childTourPax += vo.getQuantity();
				} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_SGL.equals(vo.getCode())) {
					bookingVO.setPaxGrndSgl(vo.getQuantity());
					bookingVO.setAmtGrndSgl(vo.getAmount());
					isFare = true;
					adultGroundPax += vo.getQuantity();
				} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_TWN.equals(vo.getCode())) {
					bookingVO.setPaxGrndTwn(vo.getQuantity());
					bookingVO.setAmtGrndTwn(vo.getAmount());
					isFare = true;
					adultGroundPax += vo.getQuantity();
				} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CTW.equals(vo.getCode())) {
					bookingVO.setPaxGrndCtw(vo.getQuantity());
					bookingVO.setAmtGrndCtw(vo.getAmount());
					isFare = true;
					childGroundPax += vo.getQuantity();
				} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CWB.equals(vo.getCode())) {
					bookingVO.setPaxGrndCeb(vo.getQuantity());
					bookingVO.setAmtGrndCeb(vo.getAmount());
					isFare = true;
					childGroundPax += vo.getQuantity();
				} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CNB.equals(vo.getCode())) {
					bookingVO.setPaxGrndCnb(vo.getQuantity());
					bookingVO.setAmtGrndCnb(vo.getAmount());
					isFare = true;
					childGroundPax += vo.getQuantity();
				} else if (ProductConstant.TOUR_DEP_ITM_CD_GA_INFT.equals(vo.getCode())) {
					bookingVO.setPaxGrndInft(vo.getQuantity());
					bookingVO.setAmtGrndInft(vo.getAmount());
					isFare = true;
				} else if (vo.getCode().startsWith(ProductConstant.TOUR_DEP_ITM_CD_DISC)) {
					bookingVO.setDiscount(vo.getAmount());
					
					vo.setTtlAmt(vo.getAmount() * vo.getQuantity());
					if (vo.getQuantity() > 0) {
						totalAmt += vo.getTtlAmt();
						discountList.add(vo);
					}
				} else if (ProductConstant.CRUISE_ITM_CD_PORT_CHARGES.equals(vo.getCode())) {
					bookingVO.setCruiseAptAdt(vo.getAmount());
				} else if (ProductConstant.CRUISE_ITM_CD_APT_ADT.equals(vo.getCode())) {
					bookingVO.setCruiseAptAdt(vo.getAmount());
				} else if (ProductConstant.CRUISE_ITM_CD_APT_CHD.equals(vo.getCode())) {
					bookingVO.setCruiseAptChd(vo.getAmount());
				} else if (ProductConstant.CRUISE_ITM_CD_FUEL_ADT.equals(vo.getCode())) {
					bookingVO.setCruiseYqAdt(vo.getAmount());
				} else if (ProductConstant.CRUISE_ITM_CD_FUEL_CHD.equals(vo.getCode())) {
					bookingVO.setCruiseYqChd(vo.getAmount());
				} else if (ProductConstant.CRUISE_ITM_CD_TRVL_INS.equals(vo.getCode())) {
					bookingVO.setCruiseTrvlIns(vo.getAmount());
				} else if (ProductConstant.CRUISE_ITM_CD_VISA.equals(vo.getCode())) {
					bookingVO.setCruiseVisa(vo.getAmount());
				} else if (ProductConstant.CRUISE_ITM_CD_AC.equals(vo.getCode())) {
					bookingVO.setCruiseAC(vo.getAmount());
				} else if (ProductConstant.CRUISE_ITM_CD_TIPPING.equals(vo.getCode())) {
					bookingVO.setCruiseTipping(vo.getAmount());
				} else if (ProductConstant.CRUISE_ITM_CD_DEVIATION.equals(vo.getCode())) {
					bookingVO.setCruiseDeviation(vo.getAmount());
				} else {
					isFare = true;
					
					if (CollectionUtils.isNotEmpty(chargeList)) {
						for (CruiseScheduleChargeVO chargeVO : chargeList) {
							if (vo.getCode().equals(chargeVO.getTypeCd())) {
								if (chargeVO.getIsMisc()) {
									extraMisc += vo.getAmount();
									additionalTaxList.add(vo);
								}
								break;
							}
						}
					}
					
					if (CollectionUtils.isNotEmpty(tourDepVO.getTourDepItemList())) {
						for (TourDepItemVO itemVO : tourDepVO.getTourDepItemList()) {
							if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(itemVO.getTypeCd()) && vo.getCode().equals(itemVO.getCode())) {
								if (itemVO.getIsMisc()) extraMisc += vo.getAmount();
								break;
							}
						}
					}
				}
				
				if (vo.getQuantity() > 0 && isFare) {
					vo.setTtlAmt(vo.getAmount() * vo.getQuantity());
					subTotal += vo.getTtlAmt();
					totalAmt += vo.getTtlAmt();
					bookingChargeItemList.add(vo);
				}
			}
			
			bookingVO.setCruiseExtra(extraMisc);
			bookingVO.setCruiseTotAdt(bookingVO.getCruiseAptAdt() + bookingVO.getCruiseYqAdt() + bookingVO.getCruiseTrvlIns() +
					bookingVO.getCruiseVisa() + bookingVO.getCruiseTipping() + extraMisc + bookingVO.getCruiseAC());
			bookingVO.setCruiseTotChd(bookingVO.getCruiseAptChd() + bookingVO.getCruiseYqChd() + bookingVO.getCruiseTrvlIns() +
					bookingVO.getCruiseVisa() + bookingVO.getCruiseTipping() + extraMisc + bookingVO.getCruiseAC());
			tourDepVO.setGrdMiscAdtChd(bookingVO.getCruiseTrvlIns() + bookingVO.getCruiseVisa() + bookingVO.getCruiseTipping());
		}
	}

