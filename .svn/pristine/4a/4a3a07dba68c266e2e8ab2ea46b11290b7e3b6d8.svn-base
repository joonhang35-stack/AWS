	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.service.TourPackageService#importDefaultInvoiceItems(com.bcs.zsg.product.vo.TourDepartureVO, com.bcs.zsg.maintenance.vo.CompanyVO)
	 */
	@Override
	public List<TourDepItemVO> importDefaultInvoiceItems(TourDepartureVO tourDepVO, CompanyVO companyVO) throws BusinessException {
		List<TourDepItemVO> tourDepItemList = new ArrayList<TourDepItemVO>();
		System.out.println("tourDepVO.getTourTypeCode(): " + tourDepVO.getTourTypeCode());
		if (ProductConstant.TYPE_CRUISE.equals(tourDepVO.getTourTypeCode())) {
			CruiseScheduleVO cruiseScheduleVO = cruiseService.getCruiseSchedule(tourDepVO);
			
			if (cruiseScheduleVO!=null) {
			
				tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.CRUISE_ITM_CD_CAT, ProductConstant.CRUISE_ITM_CD_PORT_CHARGES, ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE, cruiseScheduleVO.getAmtAptAdt(), 0.0)); // airport tax - adult
				tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.CRUISE_ITM_CD_CAT, ProductConstant.CRUISE_ITM_CD_AC, ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE, cruiseScheduleVO.getAmtAC(), 0.0)); // agent collection
				tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.CRUISE_ITM_CD_CAT, ProductConstant.CRUISE_ITM_CD_TIPPING, ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE, cruiseScheduleVO.getAmtTipping(), 0.0)); // tipping
				tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.CRUISE_ITM_CD_CAT, ProductConstant.CRUISE_ITM_CD_TRVL_INS, ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE, cruiseScheduleVO.getAmtTrvlIns(), 0.0)); // travel insurance
				tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.CRUISE_ITM_CD_CAT, ProductConstant.CRUISE_ITM_CD_VISA, ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE, cruiseScheduleVO.getAmtVisa(), 0.0)); // visa
				tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.CRUISE_ITM_CD_CAT, ProductConstant.CRUISE_ITM_CD_DEVIATION, ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE, cruiseScheduleVO.getAmtDeviation(), 0.0)); // deviation charges
				tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_DISC, ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE, 0, 0.0));
				
				List<CruiseScheduleChargeVO> chargeList = cruiseService.getCruiseScheduleChargeList(tourDepVO.getIdCruiseSchedule());
				if (CollectionUtils.isNotEmpty(chargeList)) {
					for (CruiseScheduleChargeVO vo : chargeList) {
						tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, vo.getTypeDesc(), vo.getTypeCd(), ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE, vo.getAmount(), 0.0));
					}
				}
			
			}
		} else {
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_FT_SGL, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, tourDepVO.getFullSgl(), tourDepVO.getAirfareSgl())); // full tour - adult single
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_FT_TWN, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, tourDepVO.getFullTwn(), tourDepVO.getAirfareTwn())); // full tour - adult twin
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_FT_CTW, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, tourDepVO.getFullCtw(), tourDepVO.getAirfareCtw())); // full tour - child with twin
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_FT_CWB, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, tourDepVO.getFullCeb(), tourDepVO.getAirfareCeb())); // full tour - child with bed
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_FT_CNB, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, tourDepVO.getFullCnb(), tourDepVO.getAirfareCnb())); // full tour - child no bed
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_FT_INFT, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, tourDepVO.getFullInft(), tourDepVO.getAirfareInft())); // full tour - infant
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_GA_SGL, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, tourDepVO.getGrndSgl(), 0.0)); // ground tour - adult single
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_GA_TWN, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, tourDepVO.getGrndTwn(), 0.0)); // ground tour - adult twin
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_GA_CTW, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, tourDepVO.getGrndCtw(), 0.0)); // ground tour - child with twin
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_GA_CWB, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, tourDepVO.getGrndCeb(), 0.0)); // ground tour - child with bed
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_GA_CNB, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, tourDepVO.getGrndCnb(), 0.0)); // ground tour - child no bed
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_GA_INFT, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, tourDepVO.getGrndInft(), 0.0)); // ground tour - infant
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.AIRLINE_ITM_CD_CAT, ProductConstant.AIRLINE_ITM_CD_APT_ADT, ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE, tourDepVO.getAirlineAptAdt(), 0.0)); // airport tax - adult
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.AIRLINE_ITM_CD_CAT, ProductConstant.AIRLINE_ITM_CD_APT_CHD, ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE, tourDepVO.getAirlineAptChd(), 0.0)); // airport tax - children
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.AIRLINE_ITM_CD_CAT, ProductConstant.AIRLINE_ITM_CD_FUEL_ADT, ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE, tourDepVO.getAirlineYqAdt(), 0.0)); // fuel tax - adult
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.AIRLINE_ITM_CD_CAT, ProductConstant.AIRLINE_ITM_CD_FUEL_CHD, ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE, tourDepVO.getAirlineYqChd(), 0.0)); // fuel tax - children
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.AIRLINE_ITM_CD_CAT, ProductConstant.AIRLINE_ITM_CD_AC, ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE, tourDepVO.getAirlineAC(), 0.0)); // agent collection
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.AIRLINE_ITM_CD_CAT, ProductConstant.AIRLINE_ITM_CD_TIPPING, ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE, tourDepVO.getAirlineTipping(), 0.0)); // tipping
			if (CollectionUtils.isNotEmpty(tourDepVO.getTourDepartureDiscountVOList())) {
				double discountAmtTemp = 0.00;
						
				if (CollectionUtils.isNotEmpty(tourDepVO.getTourDepartureDiscountVOList())) {
					for (TourDepartureDiscountVO discountVO : tourDepVO.getTourDepartureDiscountVOList()) {
						if ((discountVO.getDiscountPax()) > 0) {
							discountAmtTemp = discountVO.getDiscountAmt();
							break;
						}
					}
				}
				
				double discountAmt = (discountAmtTemp == 0) ? discountAmtTemp : -discountAmtTemp;
				tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_DISC, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, discountAmt, 0.0)); // discount	
			}else {
				double discountAmt = 0.00;
				tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.TOUR_DEP_ITM_CD_CAT, ProductConstant.TOUR_DEP_ITM_CD_DISC, ProductConstant.TOUR_DEP_ITM_TYPE_TOUR, discountAmt, 0.0));
			}
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.AIRLINE_ITM_CD_CAT, ProductConstant.AIRLINE_ITM_CD_TRVL_INS, ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE, tourDepVO.getAirlineTrvlIns(), 0.0)); // travel insurance
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.AIRLINE_ITM_CD_CAT, ProductConstant.AIRLINE_ITM_CD_VISA, ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE, tourDepVO.getAirlineVisa(), 0.0)); // visa
			tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, ProductConstant.AIRLINE_ITM_CD_CAT, ProductConstant.AIRLINE_ITM_CD_DEVIATION, ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE, tourDepVO.getAirlineDeviation(), 0.0)); // deviation charges
			
			List<AirlineScheduleChargeVO> chargeList = airlineService.getAirlineScheduleChargeList(tourDepVO.getIdAirlineSchedule());
			if (CollectionUtils.isNotEmpty(chargeList)) {
				for (AirlineScheduleChargeVO vo : chargeList) {
					tourDepItemList.add(getDefaultInvoiceItem(tourDepVO, companyVO, vo.getTypeDesc(), vo.getTypeCd(), ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE, vo.getAmount(), 0.0));
				}
			}
			
			List<InvoiceAndExchangeOrderVO> invoiceAndExchangeOrderList = invoiceAndExchangeOrderService.getInvoiceAndExchangeOrderList(companyVO.getId());
			
			// Reset editable on tour dep items
			for (TourDepItemVO tourDepItemVO : tourDepItemList) {
				for (InvoiceAndExchangeOrderVO invAndEOVO : invoiceAndExchangeOrderList) {
					if (tourDepItemVO.getCode().equals(invAndEOVO.getCode())) {
						tourDepItemVO.setIsEditable(invAndEOVO.getIsEditable());
						break;
					}
				}
			}
		}
		
		return tourDepItemList;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.service.TourPackageService#updTourDepItemsValue(com.bcs.zsg.product.vo.TourDepartureVO, com.bcs.zsg.product.vo.AirlineScheduleVO)
	 */
	@Override
	public void updTourDepItemsValue(TourDepartureVO tourDepVO) throws BusinessException {
		List<TourDepItemVO> tourDepItemList = tourPkgDAO.getTourDepItemList(tourDepVO.getId(), null, null);
		
		if (CollectionUtils.isNotEmpty(tourDepItemList)) {
			if (tourDepVO.getTourTypeCode() != null && tourDepVO.getTourTypeCode().equals("CRUISE")) {
				CruiseScheduleVO cruiseScheduleVO = cruiseDAO.getCruiseSchedule(tourDepVO.getIdCruiseSchedule());
				List<CruiseScheduleChargeVO> cruiseSchedulechargeList = cruiseService.getCruiseScheduleChargeList(cruiseScheduleVO.getId());
				HashMap<Long, CompanyVO> companyMap = new HashMap<Long, CompanyVO>();
				boolean isDeleteCruise = false;
				int count = 0;
				
				tourDepVO.setMiscAdt(0.0);
				tourDepVO.setMiscChd(0.0);
				tourDepVO.setCruiseMiscAdt(0.0);
				tourDepVO.setCruiseMiscChd(0.0);
				Long companyId = tourDepItemList.get(0).getCompanyVO().getId();
				
				for (TourDepItemVO vo : tourDepItemList) {
					if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(vo.getCode())) { vo.setAmount(tourDepVO.getFullSgl()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(vo.getCode())) { vo.setAmount(tourDepVO.getFullTwn()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CTW.equals(vo.getCode())) { vo.setAmount(tourDepVO.getFullCtw()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CWB.equals(vo.getCode())) { vo.setAmount(tourDepVO.getFullCeb()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CNB.equals(vo.getCode())) { vo.setAmount(tourDepVO.getFullCnb()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_GA_SGL.equals(vo.getCode())) { vo.setAmount(tourDepVO.getGrndSgl()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_GA_TWN.equals(vo.getCode())) { vo.setAmount(tourDepVO.getGrndTwn()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CTW.equals(vo.getCode())) { vo.setAmount(tourDepVO.getGrndCtw()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CWB.equals(vo.getCode())) { vo.setAmount(tourDepVO.getGrndCeb()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CNB.equals(vo.getCode())) { vo.setAmount(tourDepVO.getGrndCnb()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(vo.getCode())) { 
						if (CollectionUtils.isNotEmpty(tourDepVO.getTourDepartureDiscountVOList())) {
							double discountAmtTemp = 0.00;
									
							if (CollectionUtils.isNotEmpty(tourDepVO.getTourDepartureDiscountVOList())) {
								for (TourDepartureDiscountVO discountVO : tourDepVO.getTourDepartureDiscountVOList()) {
									if ((discountVO.getDiscountPax()) > 0) {
										discountAmtTemp = discountVO.getDiscountAmt();
										break;
									}
								}
							}
							
							double discountAmt = (discountAmtTemp == 0) ? discountAmtTemp : -discountAmtTemp;
							vo.setAmount(discountAmt);
						} else {
							vo.setAmount(0.00);
						}
						updateVO(vo); 
					} else if (ProductConstant.CRUISE_ITM_CD_PORT_CHARGES.equals(vo.getCode())) { 
						vo.setAmount(cruiseScheduleVO.getAmtAptAdt()); 
						updateVO(vo); 
						if (vo.getCompanyVO().getId().equals(companyId)) { 
							tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount()); 
							tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount()); 
						}
					} else if (ProductConstant.CRUISE_ITM_CD_APT_ADT.equals(vo.getCode())) { 
						vo.setAmount(cruiseScheduleVO.getAmtAptAdt()); 
						updateVO(vo); 
						if (vo.getCompanyVO().getId().equals(companyId)) {
							tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount());
						}
					} else if (ProductConstant.CRUISE_ITM_CD_APT_CHD.equals(vo.getCode())) { 
						vo.setAmount(cruiseScheduleVO.getAmtAptChd()); 
						updateVO(vo); 
						if (vo.getCompanyVO().getId().equals(companyId)) {
							tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount()); 
						}
					} else if (ProductConstant.CRUISE_ITM_CD_FUEL_ADT.equals(vo.getCode())) { 
						vo.setAmount(cruiseScheduleVO.getAmtFuelAdt()); 
						updateVO(vo); 
						if (vo.getCompanyVO().getId().equals(companyId)) {
							tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount()); 
						}
					} else if (ProductConstant.CRUISE_ITM_CD_FUEL_CHD.equals(vo.getCode())) { 
						vo.setAmount(cruiseScheduleVO.getAmtFuelChd()); 
						updateVO(vo); 
						if (vo.getCompanyVO().getId().equals(companyId)) { 
							tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount());
						}
					} else if (ProductConstant.CRUISE_ITM_CD_TRVL_INS.equals(vo.getCode())) { 
						vo.setAmount(cruiseScheduleVO.getAmtTrvlIns()); 
						updateVO(vo); 
						if (vo.getCompanyVO().getId().equals(companyId)) { 
							tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount()); 
							tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount()); 
						}
					} else if (ProductConstant.CRUISE_ITM_CD_VISA.equals(vo.getCode())) { 
						vo.setAmount(cruiseScheduleVO.getAmtVisa()); 
						updateVO(vo); 
						if (vo.getCompanyVO().getId().equals(companyId)) { 
							tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount()); 
							tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount()); 
						}
					} else if (ProductConstant.CRUISE_ITM_CD_AC.equals(vo.getCode())) { 
						vo.setAmount(cruiseScheduleVO.getAmtAC()); 
						updateVO(vo); 
						if (vo.getCompanyVO().getId().equals(companyId)) { 
							tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount()); 
							tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount()); 
						}
					} else if (ProductConstant.CRUISE_ITM_CD_TIPPING.equals(vo.getCode())) { 
						vo.setAmount(cruiseScheduleVO.getAmtTipping()); 
						updateVO(vo); 
						if (vo.getCompanyVO().getId().equals(companyId)) { 
							tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount()); 
							tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount()); 
						}
					} else if (ProductConstant.CRUISE_ITM_CD_DEVIATION.equals(vo.getCode())) { 
						vo.setAmount(cruiseScheduleVO.getAmtDeviation()); 
						updateVO(vo);
						if (vo.getCompanyVO().getId().equals(companyId)) { 
							tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount()); 
							tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount()); 
						}
					} else {
						// check cruise charge item
						if (ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE.equals(vo.getTypeCd())) {
							count++;
							if (isDeleteCruise) {
								deleteVO(vo);
								
							} else {
								if (CollectionUtils.isNotEmpty(cruiseSchedulechargeList)) {
									int flag = 0;
									for (CruiseScheduleChargeVO chargeVO : cruiseSchedulechargeList) {
										if (vo.getCode().equals(chargeVO.getTypeCd())) {
											vo.setAmount(chargeVO.getAmount());
											updateVO(vo);
											
											if (vo.getCompanyVO().getId().equals(companyId)) {
												if (chargeVO.getIsMisc()) {
													tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount());
													tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount());
												}
											}
											flag = 1;
											break;
										}
									}
									if (flag == 0) {
										deleteVO(vo);
										isDeleteCruise = true;
									}
								} else deleteVO(vo);
							}
						} else if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(vo.getTypeCd())) {
							if (vo.getCompanyVO().getId().equals(companyId) && vo.getIsMisc()) {
								tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount());
								tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount());
							}
						}
					}
					// add company vo
					companyMap.put(vo.getCompanyVO().getId(), vo.getCompanyVO());
				}
				// insert extra cruise if the cruise schedule changed
				if (isDeleteCruise || count == 0) {
					if (CollectionUtils.isNotEmpty(cruiseSchedulechargeList)) {
						List<CompanyVO> companyList = new ArrayList<CompanyVO>(companyMap.values());
						companyId = companyList.get(0).getId();
						
						//for (Iterator<Entry<Long, CompanyVO>> it = companyMap.entrySet().iterator() ; it.hasNext() ;) {
						for (CompanyVO companyVO : companyList) {
							for (CruiseScheduleChargeVO chargeVO : cruiseSchedulechargeList) {
								//CompanyVO companyVO = it.next().getValue();
								TourDepItemVO vo = new TourDepItemVO();
								vo.setCompanyVO(companyVO);
								vo.setIdTourDep(tourDepVO.getId());
								vo.setCode(chargeVO.getTypeCd());
								vo.setDesc(chargeVO.getTypeDesc());
								vo.setAmount(chargeVO.getAmount());
								vo.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE);
								insertVO(vo);
								
								if (companyVO.getId().equals(companyId)) {
									tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount());
									tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount());
								}
							}
						}
					}
				}
			} else {
				AirlineScheduleVO airlineScheduleVO = airlineDAO.getAirlineSchedule(tourDepVO.getIdAirlineSchedule());
				List<AirlineScheduleChargeVO> airLineSchedulechargeList = airlineService.getAirlineScheduleChargeList(airlineScheduleVO.getId());
				HashMap<Long, CompanyVO> companyMap = new HashMap<Long, CompanyVO>();
				boolean isDeleteAirline = false;
				int count = 0;
				
				tourDepVO.setMiscAdt(0.0);
				tourDepVO.setMiscChd(0.0);
				Long companyId = tourDepItemList.get(0).getCompanyVO().getId();
				
				for (TourDepItemVO vo : tourDepItemList) {
					if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(vo.getCode())) { vo.setAmount(tourDepVO.getFullSgl()); vo.setAirfare(tourDepVO.getAirfareSgl()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(vo.getCode())) { vo.setAmount(tourDepVO.getFullTwn()); vo.setAirfare(tourDepVO.getAirfareTwn()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CTW.equals(vo.getCode())) { vo.setAmount(tourDepVO.getFullCtw()); vo.setAirfare(tourDepVO.getAirfareCtw()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CWB.equals(vo.getCode())) { vo.setAmount(tourDepVO.getFullCeb()); vo.setAirfare(tourDepVO.getAirfareCeb()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_FT_CNB.equals(vo.getCode())) { vo.setAmount(tourDepVO.getFullCnb()); vo.setAirfare(tourDepVO.getAirfareCnb()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_GA_SGL.equals(vo.getCode())) { vo.setAmount(tourDepVO.getGrndSgl()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_GA_TWN.equals(vo.getCode())) { vo.setAmount(tourDepVO.getGrndTwn()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CTW.equals(vo.getCode())) { vo.setAmount(tourDepVO.getGrndCtw()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CWB.equals(vo.getCode())) { vo.setAmount(tourDepVO.getGrndCeb()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_GA_CNB.equals(vo.getCode())) { vo.setAmount(tourDepVO.getGrndCnb()); updateVO(vo); }
					else if (ProductConstant.TOUR_DEP_ITM_CD_DISC.equals(vo.getCode())) { 
						if (CollectionUtils.isNotEmpty(tourDepVO.getTourDepartureDiscountVOList())) {
							double discountAmtTemp = 0.00;
									
							if (CollectionUtils.isNotEmpty(tourDepVO.getTourDepartureDiscountVOList())) {
								for (TourDepartureDiscountVO discountVO : tourDepVO.getTourDepartureDiscountVOList()) {
									if ((discountVO.getDiscountPax()) > 0) {
										discountAmtTemp = discountVO.getDiscountAmt();
										break;
									}
								}
							}
							
							double discountAmt = (discountAmtTemp == 0) ? discountAmtTemp : -discountAmtTemp;
							vo.setAmount(discountAmt);
						} else {
							vo.setAmount(0.00);
						}
						updateVO(vo); 
					}
					else if (ProductConstant.AIRLINE_ITM_CD_APT_ADT.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtAptAdt()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount()); }
					else if (ProductConstant.AIRLINE_ITM_CD_APT_CHD.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtAptChd()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount()); }
					else if (ProductConstant.AIRLINE_ITM_CD_FUEL_ADT.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtFuelAdt()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount()); }
					else if (ProductConstant.AIRLINE_ITM_CD_FUEL_CHD.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtFuelChd()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount()); }
					else if (ProductConstant.AIRLINE_ITM_CD_TRVL_INS.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtTrvlIns()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) { tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount()); tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount()); }}
					else if (ProductConstant.AIRLINE_ITM_CD_VISA.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtVisa()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) { tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount()); tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount()); }}
					else if (ProductConstant.AIRLINE_ITM_CD_AC.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtAC()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) { tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount()); tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount()); }}
					else if (ProductConstant.AIRLINE_ITM_CD_TIPPING.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtTipping()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) { tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount()); tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount()); }}
					else if (ProductConstant.AIRLINE_ITM_CD_DEVIATION.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtDeviation()); updateVO(vo); }
					else {
						// check airline charge item
						if (ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE.equals(vo.getTypeCd())) {
							count++;
							if (isDeleteAirline) {
								deleteVO(vo);
								
							} else {
								if (CollectionUtils.isNotEmpty(airLineSchedulechargeList)) {
									int flag = 0;
									for (AirlineScheduleChargeVO chargeVO : airLineSchedulechargeList) {
										if (vo.getCode().equals(chargeVO.getTypeCd())) {
											vo.setAmount(chargeVO.getAmount());
											updateVO(vo);
											
											if (vo.getCompanyVO().getId().equals(companyId)) {
												if (chargeVO.getIsMisc()) {
													tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount());
													tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount());
												}
											}
											flag = 1;
											break;
										}
									}
									if (flag == 0) {
										deleteVO(vo);
										isDeleteAirline = true;
									}
								} else deleteVO(vo);
							}
						} else if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(vo.getTypeCd())) {
							if (vo.getCompanyVO().getId().equals(companyId) && vo.getIsMisc()) {
								tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount());
								tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount());
							}
						}
					}
					// add company vo
					companyMap.put(vo.getCompanyVO().getId(), vo.getCompanyVO());
				}
				// insert extra airline if the airline schedule changed
				if (isDeleteAirline || count == 0) {
					if (CollectionUtils.isNotEmpty(airLineSchedulechargeList)) {
						List<CompanyVO> companyList = new ArrayList<CompanyVO>(companyMap.values());
						companyId = companyList.get(0).getId();
						
						//for (Iterator<Entry<Long, CompanyVO>> it = companyMap.entrySet().iterator() ; it.hasNext() ;) {
						for (CompanyVO companyVO : companyList) {
							for (AirlineScheduleChargeVO chargeVO : airLineSchedulechargeList) {
								//CompanyVO companyVO = it.next().getValue();
								TourDepItemVO vo = new TourDepItemVO();
								vo.setCompanyVO(companyVO);
								vo.setIdTourDep(tourDepVO.getId());
								vo.setCode(chargeVO.getTypeCd());
								vo.setDesc(chargeVO.getTypeDesc());
								vo.setAmount(chargeVO.getAmount());
								vo.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE);
								insertVO(vo);
								
								if (companyVO.getId().equals(companyId)) {
									tourDepVO.setMiscAdt(tourDepVO.getMiscAdt() + vo.getAmount());
									tourDepVO.setMiscChd(tourDepVO.getMiscChd() + vo.getAmount());
								}
							}
						}
					}
				}
			}
		}
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.service.TourPackageService#updTourDepItemsValue(com.bcs.zsg.product.vo.AirlineScheduleVO, java.util.List, java.util.List, java.util.List)
	 */
	@Override
	public void updTourDepItemsValue(AirlineScheduleVO airlineScheduleVO, List<AirlineScheduleChargeVO> addItemChargeList,
			List<AirlineScheduleChargeVO> updItemChargeList, List<AirlineScheduleChargeVO> delItemChargeList) throws BusinessException {
		List<TourDepartureVO> tourDepList = tourPkgDAO.getTourDepList(null, airlineScheduleVO.getId());
		if (CollectionUtils.isNotEmpty(tourDepList)) {
			for (TourDepartureVO tdVO : tourDepList) {
				List<TourDepItemVO> tourDepItemList = tourPkgDAO.getTourDepItemList(tdVO.getId(), null, null);
				tdVO.setMiscAdt(0.0);
				tdVO.setMiscChd(0.0);
				
				if (CollectionUtils.isNotEmpty(tourDepItemList)) {
					Long companyId = tourDepItemList.get(0).getCompanyVO().getId();
					
					for (TourDepItemVO vo : tourDepItemList) {
						if (ProductConstant.AIRLINE_ITM_CD_APT_ADT.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtAptAdt()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) tdVO.setMiscAdt(tdVO.getMiscAdt() + vo.getAmount()); }
						else if (ProductConstant.AIRLINE_ITM_CD_APT_CHD.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtAptChd()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) tdVO.setMiscChd(tdVO.getMiscChd() + vo.getAmount()); }
						else if (ProductConstant.AIRLINE_ITM_CD_FUEL_ADT.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtFuelAdt()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) tdVO.setMiscAdt(tdVO.getMiscAdt() + vo.getAmount()); }
						else if (ProductConstant.AIRLINE_ITM_CD_FUEL_CHD.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtFuelChd()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) tdVO.setMiscChd(tdVO.getMiscChd() + vo.getAmount()); }
						else if (ProductConstant.AIRLINE_ITM_CD_TRVL_INS.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtTrvlIns()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) { tdVO.setMiscAdt(tdVO.getMiscAdt() + vo.getAmount()); tdVO.setMiscChd(tdVO.getMiscChd() + vo.getAmount()); }}
						else if (ProductConstant.AIRLINE_ITM_CD_VISA.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtVisa()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) { tdVO.setMiscAdt(tdVO.getMiscAdt() + vo.getAmount()); tdVO.setMiscChd(tdVO.getMiscChd() + vo.getAmount()); }}
						else if (ProductConstant.AIRLINE_ITM_CD_AC.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtAC()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) { tdVO.setMiscAdt(tdVO.getMiscAdt() + vo.getAmount()); tdVO.setMiscChd(tdVO.getMiscChd() + vo.getAmount()); }}
						else if (ProductConstant.AIRLINE_ITM_CD_TIPPING.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtTipping()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) { tdVO.setMiscAdt(tdVO.getMiscAdt() + vo.getAmount()); tdVO.setMiscChd(tdVO.getMiscChd() + vo.getAmount()); }}
						else if (ProductConstant.AIRLINE_ITM_CD_DEVIATION.equals(vo.getCode())) { vo.setAmount(airlineScheduleVO.getAmtDeviation()); updateVO(vo); }
						else {
							if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(vo.getTypeCd())) {
								if (vo.getCompanyVO().getId().equals(companyId) && vo.getIsMisc()) {
									tdVO.setMiscAdt(tdVO.getMiscAdt() + vo.getAmount());
									tdVO.setMiscChd(tdVO.getMiscChd() + vo.getAmount());
								}
							}
						}
					}
					// for extra item
					if (CollectionUtils.isNotEmpty(airlineScheduleVO.getExtraItemChargeList())) {
						for (AirlineScheduleChargeVO vo : airlineScheduleVO.getExtraItemChargeList()) {
							if (vo.getIsMisc()) {
								tdVO.setMiscAdt(tdVO.getMiscAdt() + vo.getAmount());
								tdVO.setMiscChd(tdVO.getMiscChd() + vo.getAmount());
							}
						}
					}
					
					// add airline items charge
					if (CollectionUtils.isNotEmpty(addItemChargeList)) {
						// add TourDepItemVO to list
						long idCompany = 0;
						long idTourDep = 0;
						List<TourDepItemVO> list = new ArrayList<TourDepItemVO>();
						for (int i = 0 ; i < tourDepItemList.size() ; i++) {
							TourDepItemVO vo = tourDepItemList.get(i);
							if (i == 0) {
								idCompany = vo.getCompanyVO().getId();
								idTourDep = vo.getIdTourDep();
								list.add(vo);
								
							} else {
								if (idCompany == vo.getCompanyVO().getId().longValue() && idTourDep == vo.getIdTourDep().longValue()) continue;
								idCompany = vo.getCompanyVO().getId();
								idTourDep = vo.getIdTourDep();
								list.add(vo);
							}
						}
						// add charges
						if (CollectionUtils.isNotEmpty(list)) {
							for (TourDepItemVO vo : list) {
								for (AirlineScheduleChargeVO chargeVO : addItemChargeList) {
									TourDepItemVO itemVO = new TourDepItemVO();
									itemVO.setIdTourDep(vo.getIdTourDep());
									itemVO.setCompanyVO(vo.getCompanyVO());
									itemVO.setCode(chargeVO.getTypeCd());
									itemVO.setDesc(chargeVO.getTypeDesc());
									itemVO.setAmount(chargeVO.getAmount());
									itemVO.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_AIRLINE);
									insertVO(itemVO);
									
									//tdVO.setMiscAdt(tdVO.getMiscAdt() + itemVO.getAmount());
									//tdVO.setMiscChd(tdVO.getMiscChd() + itemVO.getAmount());
								}
							}
						}
					}
					// update airline items charge
					if (CollectionUtils.isNotEmpty(updItemChargeList)) {
						for (AirlineScheduleChargeVO chargeVO : updItemChargeList) {
							for (TourDepItemVO itemVO : tourDepItemList) {
								if (itemVO.getCode().equals(chargeVO.getTypeCd())) {
									itemVO.setDesc(chargeVO.getTypeDesc());
									itemVO.setAmount(chargeVO.getAmount());
									updateVO(itemVO);
								}
							}
						}
					}
					// delete airline items charge
					if (CollectionUtils.isNotEmpty(delItemChargeList)) {
						for (AirlineScheduleChargeVO chargeVO : delItemChargeList) {
							for (TourDepItemVO itemVO : tourDepItemList) {
								if (itemVO.getCode().equals(chargeVO.getTypeCd())) deleteVO(itemVO);
							}
						}
					}
				}
				// update tour departure
				updateVO(tdVO);
			}
		}
	}
	
	@Override
	public void updTourDepItemsValue(CruiseScheduleVO cruiseScheduleVO, List<CruiseScheduleChargeVO> addItemChargeList,
			List<CruiseScheduleChargeVO> updItemChargeList, List<CruiseScheduleChargeVO> delItemChargeList) throws BusinessException {
		List<TourDepartureVO> tourDepList = tourPkgDAO.getTourDepList(null, cruiseScheduleVO.getId());
		if (CollectionUtils.isNotEmpty(tourDepList)) {
			for (TourDepartureVO tdVO : tourDepList) {
				List<TourDepItemVO> tourDepItemList = tourPkgDAO.getTourDepItemList(tdVO.getId(), null, null);
				tdVO.setCruiseMiscAdt(0.0);
				tdVO.setCruiseMiscChd(0.0);
				
				if (CollectionUtils.isNotEmpty(tourDepItemList)) {
					Long companyId = tourDepItemList.get(0).getCompanyVO().getId();
					
					for (TourDepItemVO vo : tourDepItemList) {
						if (ProductConstant.CRUISE_ITM_CD_PORT_CHARGES.equals(vo.getCode())) { vo.setAmount(cruiseScheduleVO.getAmtAptAdt()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) tdVO.setCruiseMiscAdt(tdVO.getCruiseMiscAdt() + vo.getAmount()); }
						else if (ProductConstant.CRUISE_ITM_CD_APT_CHD.equals(vo.getCode())) { vo.setAmount(cruiseScheduleVO.getAmtAptChd()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) tdVO.setCruiseMiscChd(tdVO.getCruiseMiscChd() + vo.getAmount()); }
						else if (ProductConstant.CRUISE_ITM_CD_FUEL_ADT.equals(vo.getCode())) { vo.setAmount(cruiseScheduleVO.getAmtFuelAdt()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) tdVO.setCruiseMiscAdt(tdVO.getCruiseMiscAdt() + vo.getAmount()); }
						else if (ProductConstant.CRUISE_ITM_CD_FUEL_CHD.equals(vo.getCode())) { vo.setAmount(cruiseScheduleVO.getAmtFuelChd()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) tdVO.setCruiseMiscChd(tdVO.getCruiseMiscChd() + vo.getAmount()); }
						else if (ProductConstant.CRUISE_ITM_CD_TRVL_INS.equals(vo.getCode())) { vo.setAmount(cruiseScheduleVO.getAmtTrvlIns()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) { tdVO.setCruiseMiscAdt(tdVO.getCruiseMiscAdt() + vo.getAmount()); tdVO.setCruiseMiscChd(tdVO.getCruiseMiscChd() + vo.getAmount()); }}
						else if (ProductConstant.CRUISE_ITM_CD_VISA.equals(vo.getCode())) { vo.setAmount(cruiseScheduleVO.getAmtVisa()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) { tdVO.setCruiseMiscAdt(tdVO.getCruiseMiscAdt() + vo.getAmount()); tdVO.setCruiseMiscChd(tdVO.getCruiseMiscChd() + vo.getAmount()); }}
						else if (ProductConstant.CRUISE_ITM_CD_AC.equals(vo.getCode())) { vo.setAmount(cruiseScheduleVO.getAmtAC()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) { tdVO.setCruiseMiscAdt(tdVO.getCruiseMiscAdt() + vo.getAmount()); tdVO.setCruiseMiscChd(tdVO.getCruiseMiscChd() + vo.getAmount()); }}
						else if (ProductConstant.CRUISE_ITM_CD_TIPPING.equals(vo.getCode())) { vo.setAmount(cruiseScheduleVO.getAmtTipping()); updateVO(vo); if (vo.getCompanyVO().getId().equals(companyId)) { tdVO.setCruiseMiscAdt(tdVO.getCruiseMiscAdt() + vo.getAmount()); tdVO.setCruiseMiscChd(tdVO.getCruiseMiscChd() + vo.getAmount()); }}
						else if (ProductConstant.CRUISE_ITM_CD_DEVIATION.equals(vo.getCode())) { vo.setAmount(cruiseScheduleVO.getAmtDeviation()); updateVO(vo); }
						else {
							if (ProductConstant.TOUR_DEP_ITM_TYPE_TOUR.equals(vo.getTypeCd())) {
								if (vo.getCompanyVO().getId().equals(companyId) && vo.getIsMisc()) {
									tdVO.setMiscAdt(tdVO.getMiscAdt() + vo.getAmount());
									tdVO.setMiscChd(tdVO.getMiscChd() + vo.getAmount());
								}
							}
						}
					}
					// for extra item
					if (CollectionUtils.isNotEmpty(cruiseScheduleVO.getExtraItemChargeList())) {
						for (CruiseScheduleChargeVO vo : cruiseScheduleVO.getExtraItemChargeList()) {
							if (vo.getIsMisc()) {
								tdVO.setCruiseMiscAdt(tdVO.getCruiseMiscAdt() + vo.getAmount());
								tdVO.setCruiseMiscChd(tdVO.getCruiseMiscChd() + vo.getAmount());
							}
						}
					}
					
					// add cruise items charge
					if (CollectionUtils.isNotEmpty(addItemChargeList)) {
						// add TourDepItemVO to list
						long idCompany = 0;
						long idTourDep = 0;
						List<TourDepItemVO> list = new ArrayList<TourDepItemVO>();
						for (int i = 0 ; i < tourDepItemList.size() ; i++) {
							TourDepItemVO vo = tourDepItemList.get(i);
							if (i == 0) {
								idCompany = vo.getCompanyVO().getId();
								idTourDep = vo.getIdTourDep();
								list.add(vo);
								
							} else {
								if (idCompany == vo.getCompanyVO().getId().longValue() && idTourDep == vo.getIdTourDep().longValue()) continue;
								idCompany = vo.getCompanyVO().getId();
								idTourDep = vo.getIdTourDep();
								list.add(vo);
							}
						}
						// add charges
						if (CollectionUtils.isNotEmpty(list)) {
							for (TourDepItemVO vo : list) {
								for (CruiseScheduleChargeVO chargeVO : addItemChargeList) {
									TourDepItemVO itemVO = new TourDepItemVO();
									itemVO.setIdTourDep(vo.getIdTourDep());
									itemVO.setCompanyVO(vo.getCompanyVO());
									itemVO.setCode(chargeVO.getTypeCd());
									itemVO.setDesc(chargeVO.getTypeDesc());
									itemVO.setAmount(chargeVO.getAmount());
									itemVO.setTypeCd(ProductConstant.TOUR_DEP_ITM_TYPE_CRUISE);
									insertVO(itemVO);
									
									//tdVO.setCruiseMiscAdt(tdVO.getCruiseMiscAdt() + itemVO.getAmount());
									//tdVO.setCruiseMiscChd(tdVO.getCruiseMiscChd() + itemVO.getAmount());
								}
							}
						}
					}
					// update cruise items charge
					if (CollectionUtils.isNotEmpty(updItemChargeList)) {
						for (CruiseScheduleChargeVO chargeVO : updItemChargeList) {
							for (TourDepItemVO itemVO : tourDepItemList) {
								if (itemVO.getCode().equals(chargeVO.getTypeCd())) {
									itemVO.setDesc(chargeVO.getTypeDesc());
									itemVO.setAmount(chargeVO.getAmount());
									updateVO(itemVO);
								}
							}
						}
					}
					// delete airline items charge
					if (CollectionUtils.isNotEmpty(delItemChargeList)) {
						for (CruiseScheduleChargeVO chargeVO : delItemChargeList) {
							for (TourDepItemVO itemVO : tourDepItemList) {
								if (itemVO.getCode().equals(chargeVO.getTypeCd())) deleteVO(itemVO);
							}
						}
					}
				}
				// update tour departure
				updateVO(tdVO);
			}
		}
	}

