	@Override
	public List<TourHotelVO> getTourHotelList(Long idTourDep, List<HotelVO> hotelList) throws BusinessException {
		List<TourHotelVO> tourHotelList = tourPkgDAO.getTourHotelList(idTourDep);
		
		if (CollectionUtils.isNotEmpty(hotelList)) {
			if (CollectionUtils.isNotEmpty(tourHotelList)) {
				for (TourHotelVO vo : tourHotelList) {
					for (HotelVO hotelVO : hotelList) {
						//if (vo.getIdHotel().equals(hotelVO.getId())) {
						if (vo.getHotelVO().getId().equals(hotelVO.getId())) {
							vo.setHotelVO(hotelVO);
							break;
						}
					}
				}
			}
		}
		return tourHotelList;
	}

