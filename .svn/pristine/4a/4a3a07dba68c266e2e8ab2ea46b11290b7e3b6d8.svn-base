	@Override
	public void clonseTourPkgDailyItinerary(TourPackageDailyItineraryVO tourPkgDailyItineraryVO) throws BusinessException {
		insertVO(tourPkgDailyItineraryVO);
		
		if (CollectionUtils.isNotEmpty(tourPkgDailyItineraryVO.getDailyItineraryItemEngVOList())) {
			for (TourPackageDailyItineraryItemVO itemVO : tourPkgDailyItineraryVO.getDailyItineraryItemEngVOList()) {
				itemVO.setId(null);
				itemVO.setIdTourPkgDailyItinerary(tourPkgDailyItineraryVO.getId());
				itemVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
				insertVO(itemVO);
			}
		}
		
		if (CollectionUtils.isNotEmpty(tourPkgDailyItineraryVO.getDailyItineraryItemZhVOList())) {
			for (TourPackageDailyItineraryItemVO itemVO : tourPkgDailyItineraryVO.getDailyItineraryItemZhVOList()) {
				itemVO.setId(null);
				itemVO.setIdTourPkgDailyItinerary(tourPkgDailyItineraryVO.getId());
				itemVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
				insertVO(itemVO);
			}
		}
	}

