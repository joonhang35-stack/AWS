	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.product.service.TourPackageService#getTourDepListWithPush(com.bcs.zsg.maintenance.vo.CompanyVO, com.bcs.zsg.common.vo.SearchParamVO)
	 */
	@Override
	public List<TourThemeVO> getTourDepListWithPush(CompanyVO companyVO, SearchParamVO searchParamVO) throws BusinessException {
		AppSettingVO appSettingVO = appSettingService.getAppSettingByCode(ConstantAppSetting.ADMIN_TOUR_DEP_ITINERARY_FROM_CMS);
		
		List<TourThemeVO> themeList = new ArrayList<TourThemeVO>();
		List<TourDepartureVO> tourDepList = tourPkgDAO.getTourDepListWithPush(searchParamVO);
		
		if (CollectionUtils.isNotEmpty(tourDepList)) {
			SimpleDateFormat monthFormat = new SimpleDateFormat("MM-yyyy");
			String dtDep = null;
			int groupColor = 0;
			
			String themeName = null;
			Long idTourPkg = null;
			
			TourThemeVO themeVO = null;
			TourPackageVO tourPkgVO = null;
			
			for (int i = 0 ; i < tourDepList.size() ; i++) {
				TourDepartureVO vo = tourDepList.get(i);
				
				if (i == 0) {
					dtDep = monthFormat.format(vo.getDtDep());
					vo.setGroupColor(groupColor);
					
				} else {
					if (dtDep.equals(monthFormat.format(vo.getDtDep()))) {
						vo.setGroupColor(groupColor);
						
					} else {
						dtDep = monthFormat.format(vo.getDtDep());
						if (groupColor == 0) groupColor = 1;
						else groupColor = 0;
						vo.setGroupColor(groupColor);
					}
				}
				
				if (vo.getIsDepositPaid()) {
					vo.setDuration("PD ");
				}
				vo.setDuration(vo.getDuration() + vo.getNumDays() + "D/" + vo.getNumNights() + "N");
				if (StringUtils.isNotEmpty(vo.getDesc())) {
					vo.setDuration(vo.getDuration() + "[" + vo.getDesc() + "]");
				}
				if (StringUtils.isNotEmpty(vo.getPrn())) {
					vo.setDuration(vo.getDuration() + "[" + vo.getPrn() + "]");
				}
				if (vo.getIsIssuedS()) {
					vo.setDuration(vo.getDuration() + "[S]");
				}
				if (vo.getIsIssuedF()) {
					vo.setDuration(vo.getDuration() + "[F]");
				}
				if (vo.getIsPush()) {
					vo.setDuration(vo.getDuration() + "PUSH");
				}
				
				// Checking valid user for private tour booking
				if (searchParamVO != null && searchParamVO.getObj10() != null) {
					if (vo.getIsPrivateTour() != null && vo.getIsPrivateTour() == Boolean.TRUE) {
						vo.setIsPrivateBooking(Boolean.TRUE);
						if (StringUtils.isNotBlank(vo.getPrivatePic()) &&
								vo.getPrivatePic().concat(",").contains(searchParamVO.getObj10().toString().concat(","))) {
							vo.setIsPrivateBooking(Boolean.FALSE);
						}
					}
				}
				
				if (BaseConstant.YES.equals(appSettingVO.getValue())) {
					if (vo.getTourPkgDailyCms() != null) {
						List<TourPackageItineryVO> itineraryList = tourPkgDAO.getTourPkgItineryListByIdTourPkgDailyItinerary(vo.getTourPkgDailyCms());
						if (!CollectionUtils.isEmpty(itineraryList)) {
							int custEnItineryIdx = -1;
							int agentEnItineryIdx = -1;
							int itineryIdx = 0;
							vo.setTourItineryList(new ArrayList<TourItineryVO>());
							
							for (TourPackageItineryVO itineraryVO : itineraryList) {
								TourItineryVO tourItineryVO = new TourItineryVO();
								tourItineryVO.setName(itineraryVO.getName());
								tourItineryVO.setLangCd(itineraryVO.getLangCd());
								tourItineryVO.setPath(itineraryVO.getPath());
								tourItineryVO.setTypeCd(itineraryVO.getTypeCd());
								vo.getTourItineryList().add(tourItineryVO);
								
								if ("CUST".equals(itineraryVO.getTypeCd()) && "EN".equals(itineraryVO.getLangCd())) custEnItineryIdx = itineryIdx;
								if ("AGENT".equals(itineraryVO.getTypeCd()) && "EN".equals(itineraryVO.getLangCd())) agentEnItineryIdx = itineryIdx;
								
								itineryIdx ++;
							}
							
							if (searchParamVO != null && searchParamVO.getObj11() != null) {
								Boolean isB2BAgent = (Boolean) searchParamVO.getObj11();
								if (isB2BAgent && agentEnItineryIdx != -1) {
									if (custEnItineryIdx != -1) vo.getTourItineryList().remove(custEnItineryIdx);
								}
							}
						}
					}
				} else {
					vo.setTourItineryList(tourPkgDAO.getTourItineryList(vo.getId()));
					
					if (CollectionUtils.isEmpty(vo.getTourItineryList())) {
						vo.setTourItineryList(new ArrayList<TourItineryVO>());
					}
					
					for (TourPackageItineryVO itineryPkgVO : getTourPkgItineryList(vo.getIdTourPkg())) {
						boolean isMatch = false;
						for (TourItineryVO itineryVO : vo.getTourItineryList()) {
							if (StringUtils.equals(itineryVO.getLangCd(), itineryPkgVO.getLangCd()) && StringUtils.equals(itineryVO.getTypeCd(), itineryPkgVO.getTypeCd())) {
								isMatch = true;
								break;
							}
						}
						
						if (!isMatch) {
							TourItineryVO tourItineryVO = new TourItineryVO();
							tourItineryVO.setName(itineryPkgVO.getName());
							tourItineryVO.setLangCd(itineryPkgVO.getLangCd());
							tourItineryVO.setPath(itineryPkgVO.getPath());
							tourItineryVO.setTypeCd(itineryPkgVO.getTypeCd());
							tourItineryVO.setCreatedBy(itineryPkgVO.getCreatedBy());
							tourItineryVO.setCreatedDate(itineryPkgVO.getCreatedDate());
							tourItineryVO.setIsFromPkg(true);
							vo.getTourItineryList().add(tourItineryVO);
						}
					}
				}
				
				vo.setDepartDateBadgeList(tourPkgDAO.getDepartureTagList(vo.getId(), CommonConstant.LOOKUP_CAT_CD_DEPART_DATE_BADGE));
				if (companyVO != null) vo.setAccCodeStatusCd(tourPkgDAO.getTourAcctCdStatusCd(vo, companyVO));
				
				if (themeName == null || !vo.getCountryName().equals(themeName)) {
					themeName = vo.getCountryName();
					
					themeVO = new TourThemeVO();
					themeVO.setDesc(themeName);
					themeVO.setTourPkgList(new ArrayList<TourPackageVO>());
					themeList.add(themeVO);
				}
				
				if (tourPkgVO == null || idTourPkg.longValue() != vo.getIdTourPkg().longValue()) {
					idTourPkg = vo.getIdTourPkg();
					
					tourPkgVO = new TourPackageVO();
					tourPkgVO.setNumDays(vo.getPackageDays());
					tourPkgVO.setNumNights(vo.getPackageNights());
					tourPkgVO.setNameEn(vo.getNameEn());
					tourPkgVO.setNameZh(vo.getNameZh());
					tourPkgVO.setNameOther(vo.getNameOther());
					tourPkgVO.setTourDepList(new ArrayList<TourDepartureVO>());
					tourPkgVO.getTourDepList().add(vo);
					
					// add package into theme
					themeVO.getTourPkgList().add(tourPkgVO);
					
				} else tourPkgVO.getTourDepList().add(vo);
				
				if (vo.getTourPkgDailyCms() != null) {
					vo.setTourPackageDailyItineraryVO(getTourPkgDailyItinerary(vo.getTourPkgDailyCms()));
					vo.setDailyCmsTitle(vo.getTourPackageDailyItineraryVO() != null ? vo.getTourPackageDailyItineraryVO().getTitle() : null);
					vo.setDailyCode(vo.getTourPackageDailyItineraryVO() != null ? vo.getTourPackageDailyItineraryVO().getCode() : null);
					
					if (searchParamVO != null && searchParamVO.getObj11() != null) {
						if (vo.getTourPackageDailyItineraryVO() != null && vo.getTourPackageDailyItineraryVO().getPkgItineryMap() != null) {
							Boolean isB2BAgent = (Boolean) searchParamVO.getObj11();
							if (isB2BAgent && vo.getTourPackageDailyItineraryVO().getPkgItineryMap().get("DAILY_ITINERARY_AGENTEN") != null) vo.getTourPackageDailyItineraryVO().getPkgItineryMap().remove("DAILY_ITINERARY_CUSTEN");
							else vo.getTourPackageDailyItineraryVO().getPkgItineryMap().remove("DAILY_ITINERARY_AGENTEN");
						}
					}
				}
			}
		}
		return themeList;
	}
	
