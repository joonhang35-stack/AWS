	/*
	 * 
	 * @param searchParamVO
	 * @param tourThemeVO
	 * @param nextYear 
	 * @param currentYear 
	 * @param level
	 * @throws BusinessException
	 */
	private void handleTourThemeListTree(SearchParamVO searchParamVO, TourThemeVO tourThemeVO, List<String> yearList) throws BusinessException {
		List<TourThemeVO> tourThemeList = tourPkgDAO.getTourThemeList(searchParamVO, tourThemeVO.getId());
		
		if (CollectionUtils.isEmpty(tourThemeList)) {
			int count = 0;
			Map<String, List<TourPackageVO>> paramsMap = new HashMap<>();
			for (String year : yearList) {
				if (count == 0) {
					paramsMap.put(year, tourPkgDAO.getTourPkgViewList(tourThemeVO, year));
					getTourPackageTagList(tourThemeVO, year);
				} else {
					// only for tour
					if (StringUtils.equals((String) searchParamVO.getObj1(), ProductConstant.TYPE_TOUR) ||
							StringUtils.equals((String) searchParamVO.getObj1(), ProductConstant.TYPE_CRUISE)) {
						paramsMap.put(year, tourPkgDAO.getTourPkgViewList(tourThemeVO, year));
						getTourPackageTagList(tourThemeVO, year);
					}
				}
				
				count++;
			}
			
			tourThemeVO.setTourPkgYearMap(paramsMap);
		} else {
			int count = 0;
			Map<String, List<TourThemeVO>> paramsMap = new HashMap<>();
			for (String year : yearList) {
				if (count == 0) {
					// current year tour package
					for (TourThemeVO vo : tourThemeList) {
						vo.setTourPkgList(tourPkgDAO.getTourPkgViewList(vo, year));
						getTourPackageTagList(vo, year);
					}
					
					paramsMap.put(year, tourThemeList);
				} else {
					List<TourThemeVO> nextTourThemeList = tourPkgDAO.getTourThemeList(searchParamVO, tourThemeVO.getId());
					
					for (int i = nextTourThemeList.size() - 1 ; i >= 0 ; i--) {
						TourThemeVO vo = nextTourThemeList.get(i);
						List<TourPackageVO> tourPkgViewList = tourPkgDAO.getTourPkgViewList(vo, year);
						getTourPackageTagList(vo, year);

						if (CollectionUtils.isNotEmpty(tourPkgViewList)) vo.setTourPkgList(tourPkgViewList);
						else nextTourThemeList.remove(i);
					}
					
					if (CollectionUtils.isNotEmpty(nextTourThemeList)) {
						paramsMap.put(year, nextTourThemeList);
					}
				}
				count++;
			}
			
			tourThemeVO.setTourThemeYearMap(paramsMap);
		}
	}

	private void getTourPackageTagList(TourThemeVO tourThemeVO, String year) throws BusinessException {
		for (TourPackageVO tourPkgVO : tourPkgDAO.getTourPkgViewList(tourThemeVO, year)) {
			tourPkgVO.setTourBadgeTagList(getPackageTagList(tourPkgVO.getId(), CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE));
			tourPkgVO.setTravelStyleList(getPackageTagList(tourPkgVO.getId(), CommonConstant.LOOKUP_CAT_CD_TRAVEL_STYLE));
			String tourBadgeDesc = "";
			String travelStyleDesc = "";

			for (String tourBadgeCode : tourPkgVO.getTourBadgeTagList()) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_TOUR_BADGE, tourBadgeCode);
				if (tempDesc == null) continue;
				if (StringUtils.isBlank(tourBadgeDesc))
					tourBadgeDesc = tempDesc;
				else
					tourBadgeDesc = tourBadgeDesc + ", " + tempDesc;
			}
			for (String travelStyleCode : tourPkgVO.getTravelStyleList()) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_TRAVEL_STYLE, travelStyleCode);
				if (tempDesc == null) continue;
				if (StringUtils.isBlank(travelStyleDesc))
					travelStyleDesc = tempDesc;
				else
					travelStyleDesc = travelStyleDesc + ", " + tempDesc;
			}

			tourPkgVO.setTourBadgeDescList(tourBadgeDesc.split(", "));
			tourPkgVO.setTravelStyleDescList(travelStyleDesc.split(", "));
		}
	}
	
	/*
	 * Insert default invoice item
	 * @param tourDepVO
	 * @param tourDepItemVO
	 * @param cat
	 * @param code
	 * @param amount
	 * @throws BusinessException
	 */
	private TourDepItemVO getDefaultInvoiceItem(TourDepartureVO tourDepVO, CompanyVO companyVO, String cat, String code, String typeCd, double amount, double airfare) throws BusinessException {
		TourDepItemVO vo = new TourDepItemVO();
		vo.setCompanyVO(companyVO);
		vo.setIdTourDep(tourDepVO.getId());
		vo.setCode(code);
		vo.setTypeCd(typeCd);
		String desc = LookupUtils.getReferenceDataValue(cat, code);
		if (StringUtils.isEmpty(desc)) {
			vo.setDesc(cat);
		} else {
			vo.setDesc(LookupUtils.getReferenceDataValue(cat, code));
		}
		vo.setAmount(amount);
		vo.setAirfare(airfare);
		return vo;
	}
	
	/*
	 * 
	 * @param vo
	 * @param pax
	 * @return
	 */
	private int caculateTourPax(BookingChargeItemVO vo, int pax) {
		if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(vo.getCode()) || ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(vo.getCode()) ||
				ProductConstant.TOUR_DEP_ITM_CD_FT_CTW.equals(vo.getCode()) || ProductConstant.TOUR_DEP_ITM_CD_FT_CWB.equals(vo.getCode()) ||
				ProductConstant.TOUR_DEP_ITM_CD_FT_CNB.equals(vo.getCode())) pax += vo.getQuantity();
		return pax;
	}

