	@Override
	public List<TourPackageDailyItineraryVO> getTourPkgDailyItineraryList(Long idTourPkg) throws BusinessException {
		List<TourPackageDailyItineraryVO> voList = tourPkgDAO.getTourPkgDailyItineraryList(idTourPkg);
		
		for (TourPackageDailyItineraryVO vo : voList) {
			vo.setTourPackageItineryVOList(tourPkgDAO.getTourPkgItineryListByIdTourPkgDailyItinerary(vo.getId()));
			
			for (TourPackageItineryVO itineraryVO : vo.getTourPackageItineryVOList()) {
				vo.getPkgItineryMap().put("DAILY_ITINERARY_" + itineraryVO.getTypeCd() + itineraryVO.getLangCd(), itineraryVO);
			}
			
			vo.setDailyItineraryItemEngVOList(getTourPkgDailyItineraryItemList(vo.getId(), ProductConstant.LANGUAGE_CD_ENG));
			vo.setDailyItineraryItemZhVOList(getTourPkgDailyItineraryItemList(vo.getId(), ProductConstant.LANGUAGE_CD_ZH));
			vo.setGenAUDDailyItineraryItemVOList(new GenAddUpdDelVO<TourPackageDailyItineraryItemVO>());
		}
		
		return voList;
	}
	
	@Override
	public TourPackageDailyItineraryVO getTourPkgDailyItinerary(Long id) throws BusinessException {
		TourPackageDailyItineraryVO vo = tourPkgDAO.getTourPkgDailyItinerary(id);
		if(vo!=null) {
		vo.setTourPackageItineryVOList(tourPkgDAO.getTourPkgItineryListByIdTourPkgDailyItinerary(vo.getId()));
		
		for (TourPackageItineryVO itineraryVO : vo.getTourPackageItineryVOList()) {
			vo.getPkgItineryMap().put("DAILY_ITINERARY_" + itineraryVO.getTypeCd() + itineraryVO.getLangCd(), itineraryVO);
		}
		
		vo.setDailyItineraryItemEngVOList(getTourPkgDailyItineraryItemList(vo.getId(), ProductConstant.LANGUAGE_CD_ENG));
		vo.setDailyItineraryItemZhVOList(getTourPkgDailyItineraryItemList(vo.getId(), ProductConstant.LANGUAGE_CD_ZH));
		vo.setGenAUDDailyItineraryItemVOList(new GenAddUpdDelVO<TourPackageDailyItineraryItemVO>());
		}
		return vo;
	}
	
