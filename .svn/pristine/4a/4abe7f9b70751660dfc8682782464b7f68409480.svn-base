package com.bcs.zsg.crm.bo;

import java.util.List;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;

import com.bcs.zsg.core.exception.BusinessException;
import com.bcs.zsg.crm.sec.vo.CRMMembershipVO;
import com.bcs.zsg.crm.service.CRMMembershipService;

public class CRMMembershipBOImpl implements CRMMembershipBO {
	
	@Autowired
	private CRMMembershipService crmMembershipService;
	
	@Override
	public int getCRMMembershipListSize(Map<String, Object> params) throws BusinessException {
		return crmMembershipService.getCRMMembershipListSize(params);
	}
	
	@Override
	public List<CRMMembershipVO> getCRMMembershipList(Map<String, Object> params) throws BusinessException {
		return crmMembershipService.getCRMMembershipList(params);
	}
	
	@Override
	public void delCRMMembership(CRMMembershipVO vo) {
		crmMembershipService.delCRMMembership(vo);
	}
	
	@Override
	public void unlinkCRMMembership(CRMMembershipVO vo) {
		crmMembershipService.unlinkCRMMembership(vo);
	}
}
