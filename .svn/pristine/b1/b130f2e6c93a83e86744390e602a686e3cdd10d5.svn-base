<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.maintenance.vo">
	<class table="company" name="CompanyVO" polymorphism="explicit">
		<id name="id" type="long" column="id">
            <generator class="identity"/>
        </id>
        
        <property name="name" type="string" column="name"/>
        <property name="code" type="string" column="code"/>
		<property name="conumber" type="string" column="reg_no"/>
		<property name="taxIdNo" type="string" column="tax_id_no"/>
		<property name="email" type="string" column="email"/>
		<property name="slogan" type="string" column="slogan"/>
		<property name="idAcctSales" type="long" column="id_acct_sales"/>
		<property name="idAcctTrade" type="long" column="id_acct_purchase_trade"/>
		<property name="idAcctSundry" type="long" column="id_acct_purchase_sundry"/>
		<property name="idAcctGST" type="long" column="id_acct_gst"/>
		<property name="idAcctNonClaimableGST" type="long" column="id_acct_non_claimable_gst"/>
		<property name="idAcctRounding" type="long" column="id_acct_rounding"/>
		<property name="idAcctAccumulatedPL" type="long" column="id_acct_accumulated_pl"/>
		<property name="idAcctCurrentPL" type="long" column="id_acct_current_pl"/>
		<property name="myInvoisClientId" type="string" column="myinvois_client_id"/>
		<property name="myInvoisClientSecret1" type="string" column="myinvois_client_secret_1"/>
		<property name="myInvoisClientSecret2" type="string" column="myinvois_client_secret_2"/>
		<property name="keycloakClientId" type="string" column="keycloak_client_id"/>
		<property name="keycloakClientSecret" type="string" column="keycloak_client_secret"/>
		
		<!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
		
	</class>
</hibernate-mapping>