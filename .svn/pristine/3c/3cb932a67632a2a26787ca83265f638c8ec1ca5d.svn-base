	widgetVar="varBookingListDialog" modal="true" resizable="false"
	dynamic="true" draggable="true" hideEffect="fade" showEffect="fade"
	closable="false">
	<h:form id="idBookingListForm">
		<ui:include src="booking_list.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - BOOKING DETAILS
-->
<p:dialog id="idBookingDetailsDialog" header="Cruise Booking Details"
	widgetVar="varBookingDetailsDialog" modal="true" resizable="false"
	dynamic="true" draggable="true" closable="false">
	<h:form id="idBookingDetailsForm">
		<ui:include src="booking_details.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - ADD BOOKING
-->
<p:dialog id="idAddBookingDialog" header="Cruise Book Tour"
	widgetVar="varAddBookingDialog" modal="true" resizable="false"
	dynamic="true" draggable="true" closable="false">
	<h:form id="idAddInvoiceForm">
		<ui:include src="add_booking.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - CANCEL BOOKING
-->
<p:confirmDialog widgetVar="varCancelBookingDialog"
	message="Are you sure want to cancel this booking?">
	<h:form>
		<p:growl id="msg" />
		<p:commandButton value="#{msg['common.button.label.yes']}"
			actionListener="#{tourPkgBean.cancelBooking}"
			update="@form,:idBookingListForm,:idTourDepListForm"
			oncomplete="varCancelBookingDialog.hide()" />
		<p:commandButton value="#{msg['common.button.label.no']}"
			actionListener="#{tourPkgBean.resetForm}"
			oncomplete="varCancelBookingDialog.hide()" />
	</h:form>
</p:confirmDialog>

<!--
	DIALOG - CUSTOMER LIST
-->
<p:dialog id="idCustListDialog" header="Customer List"
	widgetVar="varCustListDialog" modal="true" showEffect="fade"
	resizable="false" dynamic="true" draggable="true" closable="false">
	<h:form id="idCustListForm">
		<ui:include src="customer_list.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - ADD CUSTOMER
-->
<p:dialog id="idAddCustDialog" header="Customer" widgetVar="varAddCustDialog" modal="true"
	resizable="false" dynamic="true" draggable="true" closable="false">
	<h:form id="idAddCustForm">
		<ui:include src="add_customer.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - AVAILABLE TOUR DEPARTURE LIST
-->
<p:dialog header="Select Tour Departure"
	widgetVar="varAvailableTourDepListDialog" modal="true"
	resizable="false" dynamic="true" draggable="true" closable="false">
	<h:form id="idAvailableTourDepList">
		<ui:include src="available_tour_dep_list.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - TRANSFER CONFIRMATION
-->
<p:confirmDialog widgetVar="varTransferConfirmationDialog"
	header="Confirmation" message="Are you sure want to do transfer?"
	closable="false">
	<h:form>
		<p:growl id="msg" />
		<p:commandButton value="#{msg['common.button.label.yes']}"
			actionListener="#{tourPkgBean.handleTransfer(true)}"
			update="@form,:idBookingListForm:idBookingList,:idTourDepListForm"
			oncomplete="onTransferValidation(xhr, status, args)" />
		<p:commandButton value="#{msg['common.button.label.no']}"
			onclick="varTransferConfirmationDialog.hide()" />
	</h:form>
</p:confirmDialog>

<p:dialog id="idTourStatusReasonDialog" header="Cruise Status Change Reason List"
	widgetVar="varTourStatusReasonDialog" modal="true" resizable="false"
	dynamic="true" draggable="true" closable="true">
	<p:ajax event="close" update=":idTourStatusReasonDialog" oncomplete="varTourStatusReasonDialog.hide()" />
	<h:form id="idTourStatusReasonListForm">
		<h:panelGrid columns="1">
			<p:commandButton value="#{msg['common.button.label.cancel']}"
				update=":idTourStatusReasonDialog" oncomplete="varTourStatusReasonDialog.hide()" />
		</h:panelGrid>
		<div style="height:350px; overflow:auto;">
			<p:dataTable widgetVar="varTourStatusReasonTable"
				value="#{tourPkgBean.tourDepHistoryList}" var="vo" paginator="true" rows="10"
				paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
				rowsPerPageTemplate="10, 20, 30" filterEvent="enter" style="width: 1200px;">

				<p:column headerText="Tour Status" style="width:70px; text-align:center;">
					<h:outputText value="#{bterp:lookupItemDesc('tour_status', vo.tourStatusCd)}" rendered="#{vo.tourStatusCd ne 'F'}" />
					<h:outputText value="Full" rendered="#{vo.tourStatusCd eq 'F'}" />
				</p:column>
				<p:column headerText="Reason" style="width:200px;">
					<h:outputText value="#{vo.tourStatusReason}" escape="true"
						style="white-space: pre-wrap" />
				</p:column>
				<p:column headerText="Updated Date" sortBy="#{vo.updatedDate}"
					filterBy="#{vo.updatedDate}" style="width:80px;">
					<h:outputText value="#{vo.updatedDate}">
						<f:convertDateTime pattern="dd-MMM-yyyy HH:mm:ss" />
					</h:outputText>
				</p:column>
				<p:column headerText="Updated By" sortBy="#{vo.updatedBy}"
					filterBy="#{vo.updatedBy}" style="width:80px;">
					<h:outputText value="#{vo.updatedBy}" />
				</p:column>
			</p:dataTable>
		</div>
		<h:panelGrid columns="1">
			<p:commandButton value="#{msg['common.button.label.cancel']}"
				update=":idTourStatusReasonDialog" oncomplete="varTourStatusReasonDialog.hide()" />
		</h:panelGrid>
	</h:form>
</p:dialog>
<!--
	DIALOG - ADD / EDIT CRUISE CABIN
-->
<p:dialog header="Cruise Cabin" id="idAddCruiseCabinDialog"
	widgetVar="varAddCruiseCabinDialog" modal="true"
	resizable="false" dynamic="true" draggable="true" closable="true">
	<h:form id="idAddCruiseCabinForm">
		<ui:include src="add_cruise_cabin.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - ADD / EDIT CRUISE CABIN BOOKING
-->
<p:dialog header="Cruise Cabin" id="idAddBookingCruiseCabinDialog"
	widgetVar="varAddBookingCruiseCabinDialog" modal="true"
	resizable="false" dynamic="true" draggable="true" closable="true">
	<h:form id="idAddBookingCruiseCabinForm">
		<ui:include src="add_booking_cruise_cabin.xhtml" />
	</h:form>
</p:dialog>

		<!--
			DIALOG - EO LIST
		-->
		<p:dialog id="idEODetailsDialog" header="Exchange Order"
			widgetVar="varEODetailsDialog" modal="true" resizable="false"
			dynamic="true" draggable="true" closable="false" onShow="initializeFilters()">
			<h:form>
				<ui:include src="../../tour/op_exorder_list.xhtml" />
			</h:form>
			<script type="text/javascript">
				function initializeFilters() {
					var filters = document
							.querySelectorAll('#idEODetailsDialog input.ui-column-filter');
					filters.forEach(function(filter) {
						filter.setAttribute('enterkeyhint', 'enter');
					});
				}
			</script>
		</p:dialog>
		
		<!--
			DIALOG - EO DETAILS
		-->
		<p:dialog id="idAddEORefDialog" header="Exchange Order"
			widgetVar="varAddEORefDialog" modal="true" resizable="false"
			dynamic="true" closable="true" styleClass="EORefDialog">
			<h:form id="idAddEORefForm">
				<ui:include src="../../../purchase/common/exchange_order/add_ref_exchange_order.xhtml" />
			</h:form>
		</p:dialog>
		
		<p:dialog id="idTourDepCruiseInfoDialog"
			widgetVar="varTourDepCruiseInfoDialog" header="Cruise" modal="true"
			resizable="false" dynamic="true" draggable="true" closable="false"
			style="width:100% !important;">
			<h:form id="idTourDepAirlineInfoForm">
				<ui:include src="cruise_info.xhtml" />
			</h:form>
		</p:dialog>
</ui:define>
</ui:composition>