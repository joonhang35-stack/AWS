<!--
	DIALOG - ACCOUNT LIST
-->
<p:dialog widgetVar="varAcctListDialog" header="GL Account List"
	modal="true" resizable="false" dynamic="true" draggable="true"
	closable="true">
	<h:form id="idAcctListForm">
		<!--p:dataTable value="#{tourPkgBean.acctViewList}" var="vo" paginator="true" rows="10"
	paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
	rowsPerPageTemplate="5, 10, 15" rowKey="#{vo.id}" selectionMode="single"-->
		<p:dataTable value="#{tourPkgBean.acctViewList}" var="vo"
			rowKey="#{vo.id}" selectionMode="single" scrollable="true"
			scrollHeight="200">
			<p:ajax event="rowSelect"
				listener="#{tourPkgBean.handleAcctSelect}"
				update=":idAddDepItemForm:idGLAcct,:idEditDepItemForm:idGLAcct"
				oncomplete="varAcctListDialog.hide()" />

			<p:column headerText="Account" sortBy="#{vo.code}"
				filterBy="#{vo.code}" style="width:200px;">
				<h:outputText value="#{vo.code}" rendered="#{empty vo.subCode}" />
				<h:outputText value="#{vo.code}-#{vo.subCode}"
					rendered="#{not empty vo.subCode}" />
			</p:column>
			<p:column headerText="Description" sortBy="#{vo.desc}"
				filterBy="#{vo.desc}" style="width:250px;">
				<h:outputText value="#{vo.desc}" rendered="#{empty vo.subDesc}" />
				<h:outputText value="#{vo.desc}, #{vo.subDesc}"
					rendered="#{not empty vo.subDesc}" />
			</p:column>
		</p:dataTable>
		<h:panelGrid columns="1">
			<p:commandButton value="#{msg['common.button.label.cancel']}"
				onclick="varAcctListDialog.hide()" process="@this" />
		</h:panelGrid>
	</h:form>
</p:dialog>

