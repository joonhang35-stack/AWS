package com.bcs.zsg.db.bterp.vo.gst;

import java.util.Date;

import com.bcs.zsg.core.vo.BaseVO;

public class GSTMappingStateVO extends BaseVO {
	private static final long serialVersionUID = 1L;
	
	private Date mappingDt;
	private String GSTField;
	private String description;
	private String taxCode;
	private Date calDt;
	
	private Date fromDate;
	private Date toDate;
	
	/**
	 * @return the mappingDt
	 */
	public Date getMappingDt() {
		return mappingDt;
	}
	/**
	 * @param mappingDt the mappingDt to set
	 */
	public void setMappingDt(Date mappingDt) {
		this.mappingDt = mappingDt;
	}
	/**
	 * @return the calDt
	 */
	public Date getCalDt() {
		return calDt;
	}
	/**
	 * @param calDt the calDt to set
	 */
	public void setCalDt(Date calDt) {
		this.calDt = calDt;
	}
	/**
	 * @return the gSTField
	 */
	public String getGSTField() {
		return GSTField;
	}
	/**
	 * @param gSTField the gSTField to set
	 */
	public void setGSTField(String gSTField) {
		GSTField = gSTField;
	}
	/**
	 * @return the description
	 */
	public String getDescription() {
		return description;
	}
	/**
	 * @param description the description to set
	 */
	public void setDescription(String description) {
		this.description = description;
	}
	/**
	 * @return the taxCode
	 */
	public String getTaxCode() {
		return taxCode;
	}
	/**
	 * @param taxCode the taxCode to set
	 */
	public void setTaxCode(String taxCode) {
		this.taxCode = taxCode;
	}
	/**
	 * @return the fromDate
	 */
	public Date getFromDate() {
		return fromDate;
	}
	/**
	 * @param fromDate the fromDate to set
	 */
	public void setFromDate(Date fromDate) {
		this.fromDate = fromDate;
	}
	/**
	 * @return the toDate
	 */
	public Date getToDate() {
		return toDate;
	}
	/**
	 * @param toDate the toDate to set
	 */
	public void setToDate(Date toDate) {
		this.toDate = toDate;
	}
}
