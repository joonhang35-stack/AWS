<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui"
	xmlns:pe="http://primefaces.org/ui/extensions"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

	<p:growl id="msg" />
	<p:dataTable id="idEInvoiceTable" widgetVar="varDocumentTable"
		value="#{salesBean.eInvConsolDetailsList}" var="vo" paginator="true"
		rows="20" rowIndexVar="rowIndex"
		paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}"
		rowsPerPageTemplate="20, 30, 50" filterEvent="enter"
		rowKey="#{vo.uuid}">

		<!-- <p:column headerText="Refresh" style="text-align:center;">
			<p:commandButton icon="ui-icon-refresh"
				actionListener="#{salesBean.updDocumentDetails(vo)}" process="@this"
				update=":idEInvoiceDocumentForm:idEInvoiceTable :idEInvoiceDocumentForm:msg" />
		</p:column> -->
		<!-- <p:column headerText="View" style="text-align:center;">
			<p:commandButton icon="ui-icon-search" />
		</p:column> -->
		<!-- <p:column headerText="UUID" sortBy="#{vo.documentUuid}"
			filterBy="#{vo.documentUuid}" filterMatchMode="contains">
			<h:outputText value="#{vo.documentUuid}"></h:outputText>
		</p:column> -->
		<!-- <p:column headerText="Status" sortBy="#{vo.statusCode}"
			filterBy="#{vo.statusCode}" filterMatchMode="contains">
			<h:outputText value="#{vo.statusCode}"></h:outputText>
			<p:graphicImage id="idInfo"
				rendered="#{vo.statusCode eq 'Invalid' or vo.statusCode eq 'Cancelled'}"
				value="/img/more.png" />
			<pe:tooltip for="idInfo">
				<h:outputText value="#{vo.docStatusReason}" escape="true"
					style="white-space: pre-wrap" />
			</pe:tooltip>
		</p:column> -->
		<!-- <p:column headerText="E-Invoice Document Type"
			sortBy="#{vo.eInvoiceDocType}" filterBy="#{vo.eInvoiceDocType}"
			filterMatchMode="contains">
			<h:outputText value="#{vo.eInvoiceDocType}"></h:outputText>
		</p:column> -->
		<!-- <p:column headerText="Consolidated" styleClass="txt_center">
			<h:outputText rendered="#{vo.isConsolEInv}" value="Y"></h:outputText>
		</p:column> -->
		<p:column headerText="Ref No." sortBy="#{vo.refNo}"
			filterBy="#{vo.refNo}" filterMatchMode="contains">
			<h:outputText value="#{vo.sysPrefix} #{vo.refNo}"></h:outputText>
		</p:column>
		<!-- <p:column headerText="System Document Type" sortBy="#{vo.statusCode}"
			filterBy="#{vo.statusCode}" filterMatchMode="contains">
			<h:outputText value="#{vo.sysDocType}"></h:outputText>
		</p:column> -->
		<!-- <p:column headerText="Created Date">
			<h:outputText value="#{vo.createdDate}">
				<f:convertDateTime pattern="dd-MMM-yyyy HH:mm:ss" />
			</h:outputText>
		</p:column> -->
		<!-- <p:column headerText="Created By" sortBy="#{vo.createdBy}"
			filterBy="#{vo.createdBy}" filterMatchMode="contains">
			<h:outputText value="#{vo.createdBy}"></h:outputText>
		</p:column> -->

	</p:dataTable>

	<h:panelGrid columns="2" style="width:1px;">
		<p:commandButton value="#{msg['common.button.label.cancel']}" update=":idEInvoiceDocumentForm"
			oncomplete="varConsolDetailsDialog.hide()">
		</p:commandButton>
	</h:panelGrid>
</ui:composition>