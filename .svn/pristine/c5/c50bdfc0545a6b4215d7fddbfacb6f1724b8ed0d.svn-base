package com.bcs.zsg.acct.vo;

import com.bcs.zsg.core.vo.BaseVO;

public class AcctVO extends BaseVO {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;

	private Long idCompany;
	private Long idAcctCat;
	private Long idAcctSubCat;
	private Long idParentAcct;
	private String code;
	private String subCode;
	private String desc;
	private String subDesc;
	private String accCodeSubCode;
	private String gstType;
	private String taxCode;
	private Float taxRate;
	private String typeCode;
	private Boolean isPreSales;
	
	public AcctVO() {
		
	}

	/**
	 * @return the idAcctCat
	 */
	public Long getIdAcctCat() {
		return idAcctCat;
	}

	/**
	 * @param idAcctCat the idAcctCat to set
	 */
	public void setIdAcctCat(Long idAcctCat) {
		this.idAcctCat = idAcctCat;
	}


	/**
	 * @return the idAcctCat
	 */
	public String getAccCodeSubCode() {
		return accCodeSubCode;
	}

	/**
	 * @param idAcctCat the idAcctCat to set
	 */
	public void setAccCodeSubCode(String accCodeSubCode) {
		this.accCodeSubCode = accCodeSubCode;
	}
	
	
	/**
	 * @return the idCompany
	 */
	public Long getIdCompany() {
		return idCompany;
	}

	/**
	 * @param idCompany the idCompany to set
	 */
	public void setIdCompany(Long idCompany) {
		this.idCompany = idCompany;
	}

	/**
	 * @return the idAcctSubCat
	 */
	public Long getIdAcctSubCat() {
		return idAcctSubCat;
	}

	/**
	 * @param idAcctSubCat the idAcctSubCat to set
	 */
	public void setIdAcctSubCat(Long idAcctSubCat) {
		this.idAcctSubCat = idAcctSubCat;
	}

	/**
	 * @return the code
	 */
	public String getCode() {
		return code;
	}

	/**
	 * @param code the code to set
	 */
	public void setCode(String code) {
		this.code = code;
	}

	/**
	 * @return the subCode
	 */
	public String getSubCode() {
		return subCode;
	}

	/**
	 * @param subCode the subCode to set
	 */
	public void setSubCode(String subCode) {
		this.subCode = subCode;
	}

	/**
	 * @return the desc
	 */
	public String getDesc() {
		return desc;
	}

	/**
	 * @param desc the desc to set
	 */
	public void setDesc(String desc) {
		this.desc = desc;
	}

	/**
	 * @return the subDesc
	 */
	public String getSubDesc() {
		return subDesc;
	}

	/**
	 * @param subDesc the subDesc to set
	 */
	public void setSubDesc(String subDesc) {
		this.subDesc = subDesc;
	}

	/**
	 * @return the gstType
	 */
	public String getGstType() {
		return gstType;
	}

	/**
	 * @param gstType the gstType to set
	 */
	public void setGstType(String gstType) {
		this.gstType = gstType;
	}

	public String getTaxCode() {
		return taxCode;
	}

	public void setTaxCode(String taxCode) {
		this.taxCode = taxCode;
	}

	/**
	 * @return the taxRate
	 */
	public Float getTaxRate() {
		return taxRate;
	}

	/**
	 * @param taxRate the taxRate to set
	 */
	public void setTaxRate(Float taxRate) {
		this.taxRate = taxRate;
	}

	/**
	 * @return the typeCode
	 */
	public String getTypeCode() {
		return typeCode;
	}

	/**
	 * @param typeCode the typeCode to set
	 */
	public void setTypeCode(String typeCode) {
		this.typeCode = typeCode;
	}

	public Long getIdParentAcct() {
		return idParentAcct;
	}

	public void setIdParentAcct(Long idParentAcct) {
		this.idParentAcct = idParentAcct;
	}
	
	public Boolean getIsPreSales() {
		return isPreSales;
	}

	public Boolean isPreSales() {
		return isPreSales;
	}

	public void setIsPreSales(Boolean isPreSales) {
		this.isPreSales = isPreSales;
	}
}
