<!--Paragraph-->
<table class="row" style="width:100%; padding-left: 30px; padding-right: 30px; padding-top: 20px;">
<tbody>
<tr>
<td>
	<!--Message-->
	<table class="row" style="width:100%; font-family: Helvetica, Arial, sans-serif">
		<tbody>
			<tr>
				<td style="font-size:16px;padding-bottom: 10px;" colspan="3">
					<br/>Dear ${customerName},
				</td>
			</tr>
			<tr>
				<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px;" align="justify" colspan="3">
					Thank you for taking the time to complete our survey. Your feedback is very important to us and will help us improve our services.
					<br/><br/>
					Please click the button below to access the survey:
				</td>
			</tr>
			<tr>
				<td style="font-size:15px; font-family: Helvetica, Arial, sans-serif;padding-bottom: 10px; text-align: center;" align="justify" colspan="3">
					<br/><a href="${url}" style="border: 0 solid #2199e8; border-radius: 3px; color: white;background-color: #7c51a1; display: inline-block; font-family: Helvetica, Arial, sans-serif; font-size: 16px; font-weight: bold; line-height: 1.3; margin: 0; padding: 20px 20px 20px 20px; text-align: center; text-decoration: none;">Start Survey</a>
				</td>
			</tr>
		</tbody>
	</table>
	<!--/Message-->

</td>
</tr>
</tbody>
</table>
<!--/Paragraph-->
