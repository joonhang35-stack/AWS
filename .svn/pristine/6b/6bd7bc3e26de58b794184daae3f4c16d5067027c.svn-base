package com.bcs.zsg.einvoice.vo;

import java.util.List;

import com.bcs.zsg.core.vo.BaseVO;
import com.bcs.zsg.web.object.EInvoiceDocument;

public class ApiDocumentQueryResponseVO extends BaseVO {
	private static final long serialVersionUID = 1L;

	// E-Invoice API properties
	private List<EInvoiceDocument> result;
	private ApiMetadataVO metadata;
	
	// to store response
	private String jsonResponse;
	private int pageNo;
	
	public List<EInvoiceDocument> getResult() {
		return result;
	}
	public void setResult(List<EInvoiceDocument> result) {
		this.result = result;
	}
	public ApiMetadataVO getMetadata() {
		return metadata;
	}
	public void setMetadata(ApiMetadataVO metadata) {
		this.metadata = metadata;
	}
	public String getJsonResponse() {
		return jsonResponse;
	}
	public void setJsonResponse(String jsonResponse) {
		this.jsonResponse = jsonResponse;
	}
	public int getPageNo() {
		return pageNo;
	}
	public void setPageNo(int pageNo) {
		this.pageNo = pageNo;
	}

}
