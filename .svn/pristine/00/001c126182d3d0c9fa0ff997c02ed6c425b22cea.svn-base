public class HttpUtils {
	
	private static final Logger logger = LoggerFactory.getLogger(HttpUtils.class);
	
	public static final String HTTP_GET = "GET";
    public static final String HTTP_POST = "POST";
    public static final String HTTP_PUT = "PUT";
    public static final String HTTP_DELETE = "DELETE";
	
	public static int STATUS_CD_OK = 200;
	public static int STATUS_CD_UNAUTHORIZED = 401;
	public static int STATUS_CD_NOT_FOUND = 404;
	public static int STATUS_CD_GATEWAY_TIMEOUT = 504;

	static TrustManager[] trustAllCerts = new TrustManager[] {
			new X509TrustManager() {
				public java.security.cert.X509Certificate[] getAcceptedIssuers() {
					return null;
				}
	
				public void checkClientTrusted(
						java.security.cert.X509Certificate[] certs, String authType) {}
	
				public void checkServerTrusted(
						java.security.cert.X509Certificate[] certs, String authType) {}
			}
	};

	public static SSLContext getSslContext() throws NoSuchAlgorithmException, KeyManagementException {
		SSLContext sc = SSLContext.getInstance("TLSv1.2");
		sc.init(null, trustAllCerts, new java.security.SecureRandom());
		return sc;
	}

	public static HttpsURLConnection openHttpsURLConnection(URL url, String requestMethod, String accessToken) throws IOException, KeyManagementException, NoSuchAlgorithmException {
	    return openHttpsURLConnection(url, requestMethod, accessToken, "");
	}

	public static HttpsURLConnection openHttpsURLConnection(URL url, String requestMethod, String accessToken, JSONObject requestBody) throws IOException, KeyManagementException, NoSuchAlgorithmException {
	    return openHttpsURLConnection(url, requestMethod, accessToken, requestBody.toString());
	}

	public static HttpsURLConnection openHttpsURLConnection(URL url, String requestMethod, String accessToken, String requestBody) throws IOException, KeyManagementException, NoSuchAlgorithmException {
		// open connection
	    HttpsURLConnection connection = (HttpsURLConnection) url.openConnection();
	    connection.setSSLSocketFactory(getSslContext().getSocketFactory());
	    connection.setRequestMethod(requestMethod);
	    
	    // set headers
	    connection.setRequestProperty("Accept", "application/json");
	    connection.setRequestProperty("Accept-Language", "en");
	    connection.setRequestProperty("Content-Type", "application/json");
	    connection.setRequestProperty("Authorization", "Bearer " + accessToken);
	    
	    // java.net.ProtocolException: cannot write to a URLConnection if doOutput=false - call setDoOutput(true)
	    connection.setDoOutput(true);
	    
	    // set request body
		if (StringUtils.isNotBlank(requestBody)) {
			try (OutputStream os = connection.getOutputStream()) {
				byte[] input = requestBody.getBytes("utf-8");
				os.write(input, 0, input.length);
			}
		}
	    
	    return connection;
	}
	
	public static HttpURLConnection openAuthAccessTokenHttpsURLConnection(URL url, String requestMethod, String requestBody)
			throws IOException, KeyManagementException, NoSuchAlgorithmException {
		HttpURLConnection connection = (HttpURLConnection) url.openConnection();
		connection.setRequestMethod("POST");
		connection.setRequestProperty("Content-Type", "application/x-www-form-urlencoded");
		connection.setDoOutput(true);

		try (OutputStream os = connection.getOutputStream()) {
			byte[] input = requestBody.getBytes("utf-8");
			os.write(input, 0, input.length);
		}

		return connection;
	}
	
	public static HttpURLConnection openHttpURLConnection(URL url, String requestMethod, String accessToken) throws IOException, KeyManagementException, NoSuchAlgorithmException {
	    return openHttpURLConnection(url, requestMethod, accessToken, "");
	}

	public static HttpURLConnection openHttpURLConnection(URL url, String requestMethod, String accessToken, JSONObject requestBody) throws IOException, KeyManagementException, NoSuchAlgorithmException {
	    return openHttpURLConnection(url, requestMethod, accessToken, requestBody.toString());
	}

	public static HttpURLConnection openHttpURLConnection(URL url, String requestMethod, String accessToken, String requestBody) throws IOException, KeyManagementException, NoSuchAlgorithmException {
		// open connection
	    HttpURLConnection connection = (HttpURLConnection) url.openConnection();
	    connection.setRequestMethod(requestMethod);
	    
	    // set headers
	    connection.setRequestProperty("Accept", "application/json");
	    connection.setRequestProperty("Accept-Language", "en");
	    connection.setRequestProperty("Content-Type", "application/json");
	    connection.setRequestProperty("Authorization", "Bearer " + accessToken);
	    
	    // java.net.ProtocolException: cannot write to a URLConnection if doOutput=false - call setDoOutput(true)
	    connection.setDoOutput(true);
	    
	    // set request body
		if (StringUtils.isNotBlank(requestBody)) {
			try (OutputStream os = connection.getOutputStream()) {
				byte[] input = requestBody.getBytes("utf-8");
				os.write(input, 0, input.length);
			}
		}
	    
	    return connection;
	}
	
	public static String openCRMConnection(URL url, HttpMethod requestMethod, String requestBody) throws Exception {
		RestTemplate restTemplate = new RestTemplate();
		
		// Headers
		HttpHeaders headers = new HttpHeaders();
        headers.add("Accept", CRMProperties.SYSTEM_API_REQUEST_HEADER_CONTENT_TYPE);
	    headers.add("Accept-Language", "en");
	    headers.add("Content-Type", CRMProperties.SYSTEM_API_REQUEST_HEADER_CONTENT_TYPE);
	    headers.add("X-TENANT-ID", CRMProperties.SYSTEM_REQUEST_HEADER_TENANT_ID);
	    headers.add("X-API-KEY", CRMProperties.SYSTEM_REQUEST_HEADER_AUTHORIZATION);
       
        // Body
//        ObjectMapper mapper = new ObjectMapper();
//        String jsonString = mapper.writeValueAsString(requestBody);
        
        // Entity
        TrackingLogUtils.infoLogs(String.format("Request JSON: %s", requestBody));
        HttpEntity<String> requestEntity = new HttpEntity<>(requestBody, headers);
        
        try {
	        ResponseEntity<String> response = restTemplate.exchange(
	        		url.toURI(),
	        		requestMethod,
	                requestEntity,
	                String.class
	        );
	        
	        // get status code
	        HttpStatus statusCode = response.getStatusCode();
	        
	        if (statusCode == HttpStatus.OK || statusCode == HttpStatus.CREATED) {
	        	TrackingLogUtils.infoLogs(String.format("SUCCESS: %s", response.getBody()));
	        } else {
	        	TrackingLogUtils.errorLogs(String.format("FAILED: Error Code: %s", statusCode));
	        }
	        
	        return response.getBody();
        } catch (HttpClientErrorException e) {
        	TrackingLogUtils.errorLogs(String.format("FAILED: Error Code: %s, Error Msg: %s", e.getStatusCode(), e.getMessage()));
        	throw e;
        }
	}
	
	/**
	 * open AWS API connection (:2034)
	 * @param url
	 * @param requestMethod
	 * @param requestBody
	 * @return
	 * @throws Exception
	 */
	public static <T> ApiResponseVO<T> openAPIConnection(URL url, HttpMethod requestMethod, String requestBody, Class<T> responseClass) throws Exception {
		RestTemplate restTemplate = new RestTemplate();
		
//		ObjectMapper objectMapper = new ObjectMapper();
		Gson gson = new Gson();
		
		// construct the parameterized type equivalent to ApiResponseVO<T>
	    Type responseType = TypeToken.getParameterized(ApiResponseVO.class, responseClass).getType();
//        JavaType javaType = objectMapper.getTypeFactory().constructParametricType(ApiResponseVO.class, responseClass);
		
		// Headers
		HttpHeaders headers = new HttpHeaders();
        headers.add("Accept", SystemProperty.SYSTEM_API_REQUEST_HEADER_CONTENT_TYPE);
	    headers.add("Accept-Language", "en");
	    headers.add("Content-Type", SystemProperty.SYSTEM_API_REQUEST_HEADER_CONTENT_TYPE);
	    headers.add("X-API-KEY", SystemProperty.SYSTEM_REQUEST_HEADER_AUTHORIZATION);
        
        // Entity
        TrackingLogUtils.infoLogs(String.format("Request JSON: %s", requestBody));
        HttpEntity<String> requestEntity = new HttpEntity<>(requestBody, headers);
        
        try {
	        ResponseEntity<String> response = restTemplate.exchange(
	        		url.toURI(),
	        		requestMethod,
	                requestEntity,
	                String.class
	        );
	        
	        // get status code
	        HttpStatus statusCode = response.getStatusCode();
	        
	        // get response body
	        String responseBody = response.getBody();
	        
	        // deserialize
	        ApiResponseVO<T> apiResponse = gson.fromJson(responseBody, responseType);
//	        ApiResponseVO<T> apiResponse = objectMapper.readValue(responseBody, javaType);
	        
	        if (statusCode == HttpStatus.OK || statusCode == HttpStatus.CREATED) {
	        	TrackingLogUtils.infoLogs(String.format("SUCCESS: %s", response.getBody()));
	        } else {
	        	TrackingLogUtils.errorLogs(String.format("FAILED: Error Code: %s", statusCode));
	        }
	        
	        return apiResponse;
        } catch (HttpClientErrorException e) {
        	TrackingLogUtils.errorLogs(String.format("FAILED: Error Code: %s, Error Msg: %s", e.getStatusCode(), e.getMessage()));
        	throw e;
        } catch (HttpServerErrorException e) {
        	// deserialize
        	ApiResponseVO<T> apiResponse = gson.fromJson(e.getResponseBodyAsString(), responseType);
//        	ApiResponseVO<T> apiResponse = objectMapper.readValue(e.getResponseBodyAsString(), javaType);
			return apiResponse;
		}
	}

	public static String getConnectionResponse(HttpURLConnection connection) throws UnsupportedEncodingException, IOException {
		BufferedReader reader = new BufferedReader(new InputStreamReader(
				connection.getResponseCode() > 299 ? connection.getErrorStream() : connection.getInputStream(), "utf-8"));
		StringBuilder response = new StringBuilder();
		String line;
		while ((line = reader.readLine()) != null) {
			response.append(line.trim());
		}
		reader.close();
		
		return response.toString();
	}

	/**
	 * http://localhost:8082/
	 * @return 
	 */
	public static String getAppBaseUrl() {
	    HttpServletRequest req = (HttpServletRequest) FacesContext.getCurrentInstance()
	            .getExternalContext()
	            .getRequest();

	    String scheme = req.getScheme();           // http
	    String host = req.getServerName();         // localhost
	    int port = req.getServerPort();            // 8082
	    String contextPath = req.getContextPath(); // /bterp

	    return scheme + "://" + host + ":" + port + contextPath + "/";
	}
}
