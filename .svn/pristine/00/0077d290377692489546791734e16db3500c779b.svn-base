<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.cfg.sec.vo">

    <class table="sec_user_password_reset" name="PasswordResetVO" polymorphism="explicit">
        <id name="Id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="emailAddress" type="string" column="email_address"/>
        <property name="loginId" type="string" column="login_id"/>
        <property name="encodedPassword" type="string" column="encoded_password"/>
       
        <!-- BaseVO attributes -->
		<property name="statusCode" type="string" column="status_cd"/>
		<property name="updatedDate" type="timestamp" column="dt_update"/>
    </class>

</hibernate-mapping>