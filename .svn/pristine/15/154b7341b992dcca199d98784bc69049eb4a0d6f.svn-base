<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.sales.vo">

    <class table="INVOICE" name="InvoiceVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="companyId" type="long" column="ID_COMPANY"/>
        <property name="customerId" type="long" column="ID_CUSTOMER"/>
        <property name="acctId" type="long" column="ID_ACCT"/>
        <property name="bookingId" type="long" column="ID_TOUR_BOOKING"/>
        <property name="idParentInv" type="long" column="ID_PARENT_INV"/>
        <property name="idParentInvTourBooking" type="long" column="ID_PARENT_INV_TOUR_BOOKING"/>
        <property name="invoiceDt" type="timestamp" column="DT_INV"/>
        <property name="code" type="string" column="CODE"/>
        <property name="psNo" type="string" column="PS_NO"/>
        <property name="rnNo" type="string" column="RN_NO"/>
        <property name="docTypeCd" type="string" column="DOC_TYPE_CD"/>
        <property name="docTypeStatus" type="string" column="DOC_TYPE_STATUS"/>
        <property name="typeCd" type="string" column="TYPE_CD"/>
        <property name="attnTo" type="string" column="ATTN_TO"/>
        <property name="cnInvNo" type="string" column="CN_INV_NO"/>
        <property name="cnPsNo" type="string" column="CN_PS_NO"/>
        <property name="pmntTypeCd" type="string" column="pmnt_type_cd"/>
        <property name="salerId" type="long" column="ID_SALER"/>
        <property name="tourDepId" type="long" column="ID_TOUR_DEP"/>
        <property name="departureDt" type="timestamp" column="DT_DEPARTURE"/>
        <property name="issuerId" type="long" column="ID_ISSUER"/>
        <property name="eoRefId" type="long" column="ID_EO_REF"/>
        <property name="catCd" type="string" column="CAT_CD"/>
        <property name="idDepartment" type="string" column="ID_DPT"/>
        <property name="orderCd" type="string" column="ORDER_CD"/>
        <property name="tfairSalerId" type="long" column="ID_SALER_TFAIR"/>
        <property name="isLockSP" type="boolean" column="is_lock_sp"/>
        <property name="isApplePoint" type="boolean" column="is_apple_point"/>
        <property name="deliveryCd" type="string" column="DELIVERY_CD"/>
        <property name="invoiceDue" type="timestamp" column="INV_DUE"/>
        <property name="gdsBookingRef" type="string" column="GDS_BOOKING_REF"/>
        <property name="amount" type="double" column="AMOUNT"/>
        <property name="balance" type="double" column="BALANCE"/>
        <property name="refundAmt" type="double" column="refund_amt"/>
        <property name="amtAftRefund" type="double" column="amt_aft_refund"/>
        <property name="statusCd" type="string" column="STATUS_CD"/>
        <property name="isInvPaid" type="boolean" column="IS_INV_PAID"/>
        <property name="subjLine" type="string" column="SUBJ_LINE"/>
        <property name="remarks" type="string" column="REMARKS"/>
        <property name="internalRemarks" type="string" column="internal_remarks"/>
        <property name="noteItems" type="string" column="note_items"/>
        <property name="trvWarrantChecked" type="boolean" column="travel_warrant_chk"/>
        <property name="totalUPoint" type="integer" column="total_upoint"/>
        <property name="totalVoucherPoint" type="integer" column="total_apple_voucher_point"/>
        <property name="transferredDate" type="timestamp" column="transferred_date"/>
        <property name="transferredBy" type="string" column="transferred_by"/>
        <property name="originalTc" type="string" column="original_tc"/>
        <property name="isConsolEInv" type="boolean" column="is_consol_e_invoice"/>
        <property name="eInvoiceSubmissionUid" type="string" column="e_invoice_submission_uid"/>
        <property name="eInvoiceDocumentUuid" type="string" column="e_invoice_document_uuid"/>
        <property name="eInvoiceStatus" type="string" column="e_invoice_status"/>
        <property name="eInvoiceRnSubmissionUid" type="string" column="e_invoice_rn_submission_uid"/>
        <property name="eInvoiceRnDocumentUuid" type="string" column="e_invoice_rn_document_uuid"/>
        <property name="eInvoiceRnStatus" type="string" column="e_invoice_rn_status"/>
        <property name="skipAutoSubmit" type="boolean" column="skip_auto_submit"/>
        <property name="subPsRunningNumber" type="integer" column="sub_ps_running_number"/>
        
        <!-- BaseVO attributes -->
        <property name="version" type="long" column="version"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>