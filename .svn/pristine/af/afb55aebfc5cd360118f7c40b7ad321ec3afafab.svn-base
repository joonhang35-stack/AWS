-- create table sec_role_func_act
CREATE TABLE `SEC_ROLE_FUNC_ACT` (
  `ID` bigint(10) NOT NULL AUTO_INCREMENT COMMENT 'Auto incremental ID and PK for this table.',
  `U_ROLE` varchar(50) NOT NULL COMMENT 'Foreign key referencing sec_role.uuid',
  `U_FUNC` varchar(50) NOT NULL COMMENT 'Foreign key referencing sec_func.uuid',
  `ACTION_CD` varchar(50) NOT NULL COMMENT 'Foreign key referencing sec_act.uuid',
  PRIMARY KEY (`ID`),
  UNIQUE KEY `UK_SEC_ROLE_FUNC` (`U_ROLE`,`U_FUNC`,`ACTION_CD`),
  KEY `FK_SEC_RF_FUNC` (`U_FUNC`),
  CONSTRAINT `FK_SEC_RFA_ROLE` FOREIGN KEY (`U_ROLE`) REFERENCES `SEC_ROLE` (`UUID`),
  CONSTRAINT `FK_SEC_RFA_FUNC` FOREIGN KEY (`U_FUNC`) REFERENCES `SEC_FUNC` (`UUID`)
) ENGINE=InnoDB AUTO_INCREMENT=1 DEFAULT CHARSET=latin1 COMMENT='List of role-function-action mappings.';

