<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.purchase.vo">

    <class table="EX_ORDER_BILL" name="ExOrderBillVO" polymorphism="explicit">
        <id name="Id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="eoId" type="long" column="ID_EO"/>
        <property name="supplierId" type="long" column="ID_SUPPLIER"/>
        <property name="idPayee" type="long" column="ID_PAYEE"/>
        <property name="companyId" type="long" column="ID_COMPANY"/>
        <property name="tourId" type="long" column="ID_TOUR_DEP"/>
        <property name="acctId" type="long" column="ID_ACCT"/>
        <property name="idJournal" type="long" column="ID_JOURNAL"/>
        <property name="billDt" type="timestamp" column="DT_BILL"/>
        <property name="dueDt" type="timestamp" column="DT_DUE"/>
        <property name="depDt" type="timestamp" column="DT_DEP"/>
        <property name="invoiceDt" type="timestamp" column="DT_INV"/>
        <property name="cnNumber" type="string" column="CN_NO"/>
        <property name="code" type="string" column="CODE"/>
        <property name="desc" type="string" column="DESCRIPTION"/>
        <property name="status" type="string" column="STATUS_CD"/>
        <property name="billAmt" type="double" column="BILL_AMT"/>
        <property name="amtPaid" type="double" column="AMT_PAID"/>
        <property name="paymentTerm" type="string" column="PAYMENT_TERM"/>
        <property name="comments" type="text" column="COMMENTS"/>
        <property name="exReason" type="text" column="EX_REASON"/>
        <property name="taxCodeGroup" type="string" column="tax_code_group"/>
        <property name="isEInvoice" type="boolean" column="is_e_invoice"/>
        <property name="eInvoiceSubmissionUid" type="string" column="e_invoice_submission_uid"/>
        <property name="eInvoiceDocumentUuid" type="string" column="e_invoice_document_uuid"/>
        <property name="eInvoiceStatus" type="string" column="e_invoice_status"/>
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>