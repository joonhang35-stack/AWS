package com.bcs.zsg.db.bterp.vo.report;

import java.io.Serializable;

public class UserExportVO implements Serializable {
    private static final long serialVersionUID = 1L;
    
    private String loginId;
    private String statusCode;
    private String name;
    private String employeeFullName;
    private String employeeIdNo;
    private String employeeDepartment;
    private String mobileNumber;
    private String roleList;
    private String emailAddress;
    private String firstLoginDate;
    private String lastLoginDate;
    private String lastPasswordChangeDate;
    private Integer loginSuccessCount;
    private Integer loginInvalidCount;
    
    public String getLoginId() {
    	return loginId;
    }
    
    public void setLoginId(String loginId) {
    	this.loginId = loginId;
    }

	public String getStatusCode() {
		return statusCode;
	}

	public void setStatusCode(String statusCode) {
		this.statusCode = statusCode;
	}

	public String getName() {
		return name;
	}

	public void setName(String name) {
		this.name = name;
	}

	public String getEmployeeFullName() {
		return employeeFullName;
	}

	public void setEmployeeFullName(String employeeFullName) {
		this.employeeFullName = employeeFullName;
	}

	public String getEmployeeDepartment() {
		return employeeDepartment;
	}

	public void setEmployeeDepartment(String employeeDepartment) {
		this.employeeDepartment = employeeDepartment;
	}

	public String getEmployeeIdNo() {
		return employeeIdNo;
	}

	public void setEmployeeIdNo(String employeeIdNo) {
		this.employeeIdNo = employeeIdNo;
	}

	public String getMobileNumber() {
		return mobileNumber;
	}

	public void setMobileNumber(String mobileNumber) {
		this.mobileNumber = mobileNumber;
	}

	public String getRoleList() {
		return roleList;
	}

	public void setRoleList(String roleList) {
		this.roleList = roleList;
	}

	public String getEmailAddress() {
		return emailAddress;
	}

	public void setEmailAddress(String emailAddress) {
		this.emailAddress = emailAddress;
	}

	public String getFirstLoginDate() {
		return firstLoginDate;
	}

	public void setFirstLoginDate(String firstLoginDate) {
		this.firstLoginDate = firstLoginDate;
	}

	public String getLastLoginDate() {
		return lastLoginDate;
	}

	public void setLastLoginDate(String lastLoginDate) {
		this.lastLoginDate = lastLoginDate;
	}

	public String getLastPasswordChangeDate() {
		return lastPasswordChangeDate;
	}

	public void setLastPasswordChangeDate(String lastPasswordChangeDate) {
		this.lastPasswordChangeDate = lastPasswordChangeDate;
	}

	public Integer getLoginSuccessCount() {
		return loginSuccessCount;
	}

	public void setLoginSuccessCount(Integer loginSuccessCount) {
		this.loginSuccessCount = loginSuccessCount;
	}

	public Integer getLoginInvalidCount() {
		return loginInvalidCount;
	}

	public void setLoginInvalidCount(Integer loginInvalidCount) {
		this.loginInvalidCount = loginInvalidCount;
	}
}