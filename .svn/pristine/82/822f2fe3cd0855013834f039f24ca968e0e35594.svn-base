<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
					template="/WEB-INF/views/layouts/main.xhtml"
					xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

<ui:define name="content">

<script type="text/javascript">
function monitorExporting(start, complete) {
	if (start) {
		start();
	}

	window.pdfExportingMonitor = setInterval(function() {
		var exportingComplete = $.cookie('cookie.pdf.exporting');

		if (exportingComplete === 'true') {
			if (complete) {
				complete();
			}
			$.cookie('cookie.pdf.exporting', null);
			clearInterval(window.pdfExportingMonitor);
		}
	}, 500);
}

function start() {
	statusDialog.show();
}

function stop() {
	statusDialog.hide();
}
</script>

<p:dialog modal="true" widgetVar="statusDialog" header="Report Loading"
        draggable="false" closable="false" resizable="false">
	<p:panelGrid columns="1">
		<h:outputLabel>Please wait while the report is being prepared...</h:outputLabel>
		<p:graphicImage value="/img/ajaxloadingbar.gif" />
	</p:panelGrid>
</p:dialog>

<p:panel header="Bank Report" toggleable="true" toggleSpeed="500">
	<h:form id="idFormBankReport">
		<p:growl id="msg"/>
		<p:panelGrid style="width:600px;">
			<p:row>
				<p:column style="width:100px;">
					<h:outputLabel for="idReportType">Report Type <span class="required">*</span></h:outputLabel>
				</p:column>
				<p:column>
					<h:selectOneMenu id="idReportType" label="Report Type" value="#{bankRptBean.reportType}" effect="fade">
						<p:ajax event="change" listener="#{bankRptBean.handleSelectReportType}" update="idFormBankReport" />
						<f:selectItem itemLabel="Select One" itemValue=""/>
						<f:selectItem itemLabel="Bank Account Listing" itemValue="BA"/>
					</h:selectOneMenu>
				</p:column>
				<p:column>
					<p:commandButton icon="ui-icon-print" value="Print [PDF]" actionListener="#{bankRptBean.printReport('PDF')}" rendered="#{bankRptBean.reportType != ''}" ajax="false" onclick="monitorExporting(start,stop)"/>
					<p:commandButton icon="ui-icon-print" value="Print [Excel]" actionListener="#{bankRptBean.printReport('XLS')}" rendered="#{bankRptBean.reportType != ''}" ajax="false" onclick="monitorExporting(start,stop)"/>
				</p:column>
			</p:row>
		</p:panelGrid>
		
		<p:panelGrid id="idSearchTypeA" style="width:750px;">
			<!-- <p:row rendered="#{bankRptBean.reportType == 'BA}">
				<p:column style="width:110px;">
					<h:outputLabel>Bank Account</h:outputLabel>
				</p:column>
				<p:column style="width:10px;">
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column style="width:150px;" colspan="3">
					<h:selectOneMenu Label="Bank" value="#{bankRptBean.supplierVO.id}">      
						<p:ajax event="change" listener="#{bankRptBean.handleSelectReportType}" update="idFormBankReport" />           
						<f:selectItem itemLabel="All" itemValue="" />   
							<f:selectItem itemLabel="Select One" itemValue=""/>
			            <f:selectItems value="#{bankRptBean.supplierList}" var="vo" itemLabel="#{vo.fullName}" itemValue="#{vo.id}" /> 
				    </h:selectOneMenu>
				</p:column>
			</p:row> -->
		</p:panelGrid>
	</h:form>
</p:panel>

</ui:define>
</ui:composition>