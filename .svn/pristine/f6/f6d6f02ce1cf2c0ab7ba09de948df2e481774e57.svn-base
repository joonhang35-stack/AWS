	@Autowired
	private transient AppSettingBO appSettingBO;
	
	private LazyDataModel<PendingEInvoiceVO> lazyDataModel;
	
	private List<AppSettingVO> appSettingVOList;
	
	private SelectItem[] statusListItems;
	
	private SimpleDateFormat dateFormat;
	
	/********* --- Config Value START --- *********/
	// submit scheduler
	private String submitSchedulerEnabled;
	private Date submitSchedulerTime;
	
