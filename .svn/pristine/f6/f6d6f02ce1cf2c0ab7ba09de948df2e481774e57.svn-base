	private String dailyRefreshSchedulerEnabled;
	private Date dailyRefreshSchedulerTime;
	
	// refresh submission scheduler
	private String refreshSubmSchedulerEnabled;
	private String refreshSubmInterval;
	/********* --- Config Value END --- *********/
	
	// access control
	private boolean isJournalConfigRole = false;
	
	@Override
	public void resetForm() {
		submitSchedulerEnabled = "";
		submitSchedulerTime = new Date();
		dailyRefreshSchedulerEnabled = "";
		dailyRefreshSchedulerTime = new Date();
		refreshSubmSchedulerEnabled = "";
		refreshSubmInterval = "";
		dateFormat = new SimpleDateFormat("HH:mm");
	}
	
	public void init() {
		resetForm();
		
		loadAppSettingData();
		
		try {
			loadAuthority();
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
		
		lazyDataModel = new LazyPendingEInvoiceDataModel();
	}
	
	public void loadAppSettingData() {
		try {
			appSettingVOList = appSettingBO.getAppSettingList(ConstantAppSetting.MODULE_MAINT.getValue());
			
			for (AppSettingVO vo : appSettingVOList) {
				if (StringUtils.equals(vo.getModule().concat("_").concat(vo.getCode()), ConstantAppSetting.MAINT_AUTO_SUBMIT_E_INV_SCHEDULER.getValue())) {
//						vo.setValue(submitSchedulerEnabled);
					submitSchedulerEnabled = vo.getValue();
				} else if (StringUtils.equals(vo.getModule().concat("_").concat(vo.getCode()), ConstantAppSetting.MAINT_AUTO_E_INV_CONFIG_SCHEDULER_SUBMIT_TIME_1.getValue())) { 
//						vo.setValue(dateFormat.format(submitSchedulerTime));
					submitSchedulerTime = dateFormat.parse(vo.getValue());
				} else if (StringUtils.equals(vo.getModule().concat("_").concat(vo.getCode()), ConstantAppSetting.MAINT_AUTO_DAILY_REFRESH_E_INV_SCHEDULER.getValue())) {
//						vo.setValue(dailyRefreshSchedulerEnabled);
					dailyRefreshSchedulerEnabled = vo.getValue();
				} else if (StringUtils.equals(vo.getModule().concat("_").concat(vo.getCode()), ConstantAppSetting.MAINT_AUTO_E_INV_CONFIG_SCHEDULER_REFRESH_TIME.getValue())) { 
//						vo.setValue(dateFormat.format(dailyRefreshSchedulerTime));
					dailyRefreshSchedulerTime = dateFormat.parse(vo.getValue());
				} else if (StringUtils.equals(vo.getModule().concat("_").concat(vo.getCode()), ConstantAppSetting.MAINT_AUTO_REFRESH_E_INV_SUBMISSION_SCHEDULER.getValue())) {
//						vo.setValue(refreshSubmSchedulerEnabled);
					refreshSubmSchedulerEnabled = vo.getValue();
				} else if (StringUtils.equals(vo.getModule().concat("_").concat(vo.getCode()), ConstantAppSetting.MAINT_AUTO_E_INV_CONFIG_SCHEDULER_REFRESH_SUB_INTERVAL.getValue())) { 
//						vo.setValue(refreshSubmInterval);
					refreshSubmInterval = vo.getValue();
				} 
			}
		} catch (BusinessException | ParseException e) {
			e.printStackTrace();
			errorResult(e);
		}
	}
	
	/**
	 * Load access control
	 * @throws BusinessException
	 */
	private void loadAuthority() throws BusinessException {
		
		List<UserRoleViewVO> userRoleList = this.getUserInfo().getRoleList();
		
		if (CollectionUtils.isNotEmpty(userRoleList)) {
			for (UserRoleViewVO userRoleVO : userRoleList) {
				if (userRoleVO.getRoleCode().equals(SalesConstant.JOURNAL_CONFIG_ROLE)) {
					isJournalConfigRole = true;
				} 
			}
		}
	}
	
	public void saveAppSettingData() {
		try {
			validateSchedulerTime(submitSchedulerTime, dailyRefreshSchedulerTime, refreshSubmInterval);
			
			for (AppSettingVO vo : appSettingVOList) {
				if (StringUtils.equals(vo.getModule().concat("_").concat(vo.getCode()), ConstantAppSetting.MAINT_AUTO_SUBMIT_E_INV_SCHEDULER.getValue())) {
					vo.setValue(submitSchedulerEnabled);
				} else if (StringUtils.equals(vo.getModule().concat("_").concat(vo.getCode()), ConstantAppSetting.MAINT_AUTO_E_INV_CONFIG_SCHEDULER_SUBMIT_TIME_1.getValue())) { 
					vo.setValue(dateFormat.format(submitSchedulerTime));
				} else if (StringUtils.equals(vo.getModule().concat("_").concat(vo.getCode()), ConstantAppSetting.MAINT_AUTO_DAILY_REFRESH_E_INV_SCHEDULER.getValue())) {
					vo.setValue(dailyRefreshSchedulerEnabled);
				} else if (StringUtils.equals(vo.getModule().concat("_").concat(vo.getCode()), ConstantAppSetting.MAINT_AUTO_E_INV_CONFIG_SCHEDULER_REFRESH_TIME.getValue())) { 
					vo.setValue(dateFormat.format(dailyRefreshSchedulerTime));
				} else if (StringUtils.equals(vo.getModule().concat("_").concat(vo.getCode()), ConstantAppSetting.MAINT_AUTO_REFRESH_E_INV_SUBMISSION_SCHEDULER.getValue())) {
					vo.setValue(refreshSubmSchedulerEnabled);
				} else if (StringUtils.equals(vo.getModule().concat("_").concat(vo.getCode()), ConstantAppSetting.MAINT_AUTO_E_INV_CONFIG_SCHEDULER_REFRESH_SUB_INTERVAL.getValue())) { 
					vo.setValue(refreshSubmInterval);
				} 
			}
			
			appSettingBO.update(appSettingVOList);
			
			boolean enableSubmitScheduler = "Y".equals(appSettingBO.getAppSettingByCode(ConstantAppSetting.MAINT_AUTO_SUBMIT_E_INV_SCHEDULER).getValue());
			boolean enableDailyRefreshScheduler = "Y".equals(appSettingBO.getAppSettingByCode(ConstantAppSetting.MAINT_AUTO_DAILY_REFRESH_E_INV_SCHEDULER).getValue());
			boolean enableRefreshSubmissionScheduler = "Y".equals(appSettingBO.getAppSettingByCode(ConstantAppSetting.MAINT_AUTO_REFRESH_E_INV_SUBMISSION_SCHEDULER).getValue());
			
			SchedulerApp.getInstance().getAllScheduler();
			System.out.println("----");
			
			for (AppSettingVO vo : appSettingVOList) {
				// Scheduler - Auto E-Invoice Submission
				if (StringUtils.equals(vo.getCode(), ConstantAppSetting.MAINT_AUTO_E_INV_CONFIG_SCHEDULER_SUBMIT_TIME_1.getValue().split(PAD_UNDERSCORE, 2)[1])) {
					if (enableSubmitScheduler) {
						SchedulerUtils.scheduleJob(vo.getValue(), EnumJobKey.AutoSubmitEInvoice, SubmitEInvoiceScheduler.class, "AutoSubmitEInvoiceDailySchedule");
					} else {
						SchedulerUtils.removeJob(EnumJobKey.AutoSubmitEInvoice, "AutoSubmitEInvoiceDailySchedule");
					}
				}
				
				// Scheduler - Auto Refresh (Get Status) E-Invoice (Daily)
				if (StringUtils.equals(vo.getCode(), ConstantAppSetting.MAINT_AUTO_E_INV_CONFIG_SCHEDULER_REFRESH_TIME.getValue().split(PAD_UNDERSCORE, 2)[1])) {					
					if (enableDailyRefreshScheduler) {
						SchedulerUtils.scheduleJob(vo.getValue(), EnumJobKey.AutoDailyRefreshEInvoice, DailyRefreshEInvoiceScheduler.class, "AutoRefreshEInvoiceDailySchedule");
					} else {
						SchedulerUtils.removeJob(EnumJobKey.AutoDailyRefreshEInvoice, "AutoRefreshEInvoiceDailySchedule");
					}
				}
				
				// Scheduler - Refresh Submission
				if (StringUtils.equals(vo.getCode(), ConstantAppSetting.MAINT_AUTO_E_INV_CONFIG_SCHEDULER_REFRESH_SUB_INTERVAL.getValue().split(PAD_UNDERSCORE, 2)[1])) {					
					if (enableRefreshSubmissionScheduler) {
						SchedulerUtils.scheduleJobByCron(SchedulerUtils.secondsToCron(vo.getValue()), EnumJobKey.AutoRefreshSubmissionEInvoice, RefreshEInvoiceScheduler.class, "AutoRefreshEInvoiceSubmissionSchedule");
					} else {
						SchedulerUtils.removeJob(EnumJobKey.AutoRefreshSubmissionEInvoice, "AutoRefreshEInvoiceSubmissionSchedule");
					}
				}
			}
			
			SchedulerApp.getInstance().getAllScheduler();
			
			successResult();
			loadAppSettingData();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void processReverseJournal() {
		TrackingLogUtils trackingLogUtils = new TrackingLogUtils(getClass());
		trackingLogUtils.startLogs();
		try {
			
			PendingJournalServiceImpl journalServiceImpl = new PendingJournalServiceImpl();
			journalServiceImpl.execute(null);
			
			successResult();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("processReversePastInvoice");
		}
	}
	
	public static void validateSchedulerTime(Date submitSchedulerTime, Date dailyRefreshSchedulerTime, String refreshSubmInterval) throws BusinessException {
		if (!EInvoiceProperties.isTesting()) {
			if (!DatesUtils.validateTime(submitSchedulerTime, 22, 0, 23, 45)) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Submission scheduler time must be set between 10:00 PM (22:00) and 11:45 PM (23:45)."));
			}
			
			int interval = Integer.valueOf(refreshSubmInterval);
			if (interval < 60) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Refresh Submission Scheduler Interval must be greater than 60 seconds."));
			}
			
//			if (60 % interval != 0) {
//				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("Cron does not support every " + interval + " seconds"));
//		    }
		}
		
		
	}
	
	private Map<String, Object> generateSearchParams() {
		Map<String, Object> params = new HashMap<String, Object>();
		
		params.put("idCompany", getSessionInfoBean().getCompanyVO().getId());
		
//		if (StringUtils.isNotBlank(orderSourceCode))	params.put("orderSourceCode", orderSourceCode);
//		if (ArrayUtils.isNotEmpty(paymentStatusList))	params.put("paymentStatusList", paymentStatusList);
//		if (ArrayUtils.isNotEmpty(eInvoiceStatusList))	params.put("eInvoiceStatusList", eInvoiceStatusList);
//		if (fromDate != null)							params.put("fromDate", fromDate);
//		if (toDate != null)								params.put("toDate", toDate);
//		if (departureDateFr != null)					params.put("departureDateFr", departureDateFr);
//		if (departureDateTo != null)					params.put("departureDateTo", departureDateTo);
		
		return params;
	}
	
	/**********************
	 * Lazy loading model *
	 **********************/
	class LazyPendingEInvoiceDataModel extends LazyDataModel<PendingEInvoiceVO> implements Serializable {
		private static final long serialVersionUID = 1L;

		/*
		 * (non-Javadoc)
		 * @see org.primefaces.model.LazyDataModel#load(int, int, java.lang.String, org.primefaces.model.SortOrder, java.util.Map)
		 */
		@Override
		public List<PendingEInvoiceVO> load(int first, int pageSize, String sortField, SortOrder sortOrder, Map<String, String> filters) {
			
			TrackingLogUtils trackingLogUtils = new TrackingLogUtils(getClass());
			
			try {
				
				trackingLogUtils.startLogs();
				
				Map<String, Object> params = generateSearchParams();
				params.put("first", first);
				params.put("pageSize", pageSize);
				params.put("sortField", sortField);
				params.put("sortOrder", sortOrder);
				params.put("filters", filters);
				
				setRowCount(eInvoiceSchedulerBO.getPendingEInvoiceListSize(params));
				
				if (0 < getRowCount()) {
					return eInvoiceSchedulerBO.getPendingEInvoiceList(params);
				}
				
			} catch (Throwable t) {
				t.printStackTrace();
				errorResult(t);
			} finally {
				trackingLogUtils.endLogs("LazyPendingEInvoiceDataModel");
			}
			return new ArrayList<PendingEInvoiceVO>();
		}
		
		@Override
		public void setRowIndex(int rowIndex) {
			/*
			 * The following is in ancestor (LazyDataModel):
			 * this.rowIndex = rowIndex == -1 ? rowIndex : (rowIndex % pageSize);
			 */
			if (rowIndex == -1 || getPageSize() == 0) {
				super.setRowIndex(-1);
			} else super.setRowIndex(rowIndex % getPageSize());
		}
		
	}
	
