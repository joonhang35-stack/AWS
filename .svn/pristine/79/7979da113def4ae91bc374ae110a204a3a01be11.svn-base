<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="monthly_sales_ticketing_rpt" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="828" leftMargin="7" rightMargin="7" topMargin="20" bottomMargin="20" whenResourceMissingType="Empty" uuid="78182573-a563-484d-9d55-5781194bb148">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="Dataset1" uuid="ac7146fe-a696-47d5-ad74-88403a9b2fca">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="AWSDB"/>
		<queryString>
			<![CDATA[SELECT INV.id, INV.SELLER_NAME, INV.dt_inv, INV.id_tour_dep, INV.airline_no, INV.code, INV.tour_code,
(SELECT COUNT(1) FROM invoice_pax invPax WHERE INV.id = invPax.id_inv) AS totalPax,
	INV.SELL, INV.NETT, (INV.SELL - INV.NETT) AS PROFIT,
 	concat(ps.salutation_cd, ' ', ps.first_name, ' ', ps.last_name) AS CUST_NAME,
 	cust.corporate_name as company_name,
 	(SELECT GROUP_CONCAT(DISTINCT (CASE WHEN ticket_no = '' THEN NULL ELSE ticket_no END) ORDER BY
ticket_no SEPARATOR ', ')
		FROM invoice_pax invPax WHERE INV.id = invPax.id_inv) AS tickets FROM ( SELECT inv.id, inv.code, inv.dt_inv,
inv.id_tour_dep, tdp.code AS tour_code, inv.id_customer, usr.user_name as SELLER_NAME,
 	GROUP_CONCAT(DISTINCT (CASE WHEN airflight.code = '' THEN NULL ELSE airflight.code END)
	 			ORDER BY airflight.code SEPARATOR ', ') AS airline_no,
 	SUM( CASE WHEN invItem.amount < 0.00 THEN 0.00 ELSE invItem.amount END) AS SELL,
 	SUM( invItem.quantity * IFNULL(invItem.net_price, 0.00)) AS NETT FROM invoice inv INNER JOIN (
	tour_dep tdp INNER JOIN tour_pkg tourpkg 		ON tdp.id_tour_pkg = tourpkg.id AND tourpkg.status_cd = 'AC'
 	) ON inv.id_tour_dep = tdp.id AND inv.cat_cd = 'ti'
	INNER JOIN invoice_item invItem ON inv.id = invItem.id_inv
	LEFT JOIN airline airflight ON invItem.id_airline = airflight.id
	INNER JOIN employee ep ON inv.id_saler = ep.id 	INNER JOIN sec_user usr ON ep.u_sec_user = usr.uuid
 WHERE inv.id_company = 1	AND inv.id_saler = 50
	AND YEAR(inv.dt_inv) = '2014' AND MONTH(inv.dt_inv) = '03' AND inv.id_saler =50 GROUP BY inv.id )
INV INNER JOIN customer cust ON INV.id_customer = cust.id 	JOIN person ps ON cust.id_pc = ps.id
 ORDER BY airline_no ASC]]>
		</queryString>
	</subDataset>
