package com.bcs.zsg.product.vo;

import com.bcs.zsg.core.vo.BaseVO;

public class TourPackageCommisionVO extends BaseVO{
	private static final long serialVersionUID = 1L;
	
	private Long idTourPkg;
	private double cnaAdt;
	private double cpaAdt;
	private double csiAdt;
	private int commisionPax;
	
	public Long getIdTourPkg() {
		return idTourPkg;
	}
	public void setIdTourPkg(Long idTourPkg) {
		this.idTourPkg = idTourPkg;
	}
	public double getCnaAdt() {
		return cnaAdt;
	}
	public void setCnaAdt(double cnaAdt) {
		this.cnaAdt = cnaAdt;
	}
	public double getCpaAdt() {
		return cpaAdt;
	}
	public void setCpaAdt(double cpaAdt) {
		this.cpaAdt = cpaAdt;
	}
	public double getCsiAdt() {
		return csiAdt;
	}
	public void setCsiAdt(double csiAdt) {
		this.csiAdt = csiAdt;
	}
	public int getCommisionPax() {
		return commisionPax;
	}
	public void setCommisionPax(int commisionPax) {
		this.commisionPax = commisionPax;
	}
	
	
}
