<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui"
	xmlns:pe="http://primefaces.org/ui/extensions"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

<script type="text/javascript">
	function onTourDepValidation(xhr, status, args) {
		if (!args.validationFailed) {
			varEditTourDepDialog.hide();
		}
	}

	function onTourDepReasonValidation(xhr, status, args) {
		if (!args.validationFailed) {
			varTourDepReasonDialog.show();
		}
	}
</script>
<p:growl id="msg" />
<div style="height: 500px; overflow: auto;">
<p:panelGrid>
	<p:row>
		<p:column>
			<h:outputLabel for="idSeqNo">Sequence Number</h:outputLabel>
		</p:column>
		<p:column colspan="3">
			<p:inputText label="Sequence Number" id="idSeqNo"
				value="#{tourPkgBean.tourDepVO.seqNo}" maxlength="4" style="width:50px" >
			</p:inputText>
			<span style="font-style: italic; font-size: 9px; color: #333333;">max:
				4 char</span>
		</p:column>
	</p:row>
	<p:row>
		<p:column style="width:100px;">
			<h:outputLabel for="idPushToOnline">Push To Online</h:outputLabel>
		</p:column>
		<p:column>
			<p:selectBooleanButton label="Push To Online" id="idPushToOnline" value="#{tourPkgBean.tourDepVO.isPushToOnline}"
				onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"/>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel>Departure ID </h:outputLabel>
		</p:column>
		<p:column colspan="2">#{tourPkgBean.tourDepVO.id} </p:column>
	</p:row>
	<p:row>
		<p:column style="width:150px"></p:column>
		<p:column style="width:100px">
			<p:inputText label="Days" value="#{tourPkgBean.tourDepVO.numDays}"
				style="width:50px" /> Days</p:column>
		<p:column>
			<p:inputText label="Nights"
				value="#{tourPkgBean.tourDepVO.numNights}" style="width:50px" /> Nights</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idDtDep">Departure <span
					class="required">*</span>
			</h:outputLabel>
		</p:column>
		<p:column colspan="2">
			<p:calendar id="idDtDep" label="Departure" navigator="true" showButtonPanel="true"
				value="#{tourPkgBean.tourDepVO.dtDep}" pattern="dd-MMM-yyyy"
				required="true">
				<p:ajax event="dateSelect"
					listener="#{tourPkgBean.handleDepartureDateChange}"
					update="idDtDep, idTourCd" global="false" />
			</p:calendar>
			<span style="font-style: italic; font-size: 9px; color: #333333;">(dd-MMM-yyyy)</span>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idTourCd">Tour Code <span
					class="required">*</span>
			</h:outputLabel>
		</p:column>
		<p:column colspan="2">
			<p:inputText id="idTourCd" label="Tour Code"
				value="#{tourPkgBean.tourDepVO.code}" maxlength="30" size="35"
				required="true">
				<p:ajax event="change" global="false" />
			</p:inputText>
			<span style="font-style: italic; font-size: 9px; color: #333333;">max:
				30 char</span>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idTourDesc">Desc</h:outputLabel>
		</p:column>
		<p:column colspan="2">
			<p:inputText id="idTourDesc" value="#{tourPkgBean.tourDepVO.desc}"
				maxlength="100" style="width:500px;" />
			<span style="font-style: italic; font-size: 9px; color: #333333;">max:
				100 char</span>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idTourDescZh">Desc (Chinese)</h:outputLabel>
		</p:column>
		<p:column colspan="2">
			<p:inputText id="idTourDescZh" value="#{tourPkgBean.tourDepVO.descZh}"
				maxlength="100" style="width:500px;" />
			<span style="font-style: italic; font-size: 9px; color: #333333;">max:
				100 char</span>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idSeason">Season</h:outputLabel>
		</p:column>
		<p:column colspan="2">
			<p:selectManyCheckbox id="idSeason" label="Season"
				value="#{tourPkgBean.tourDepVO.selectedSeason}">
				<f:selectItems value="#{tourPkgBean.refDataListSeason}" var="vo"
					itemLabel="#{vo.value}" itemValue="#{vo.code}" />
				<p:ajax event="change" update="idSeason"
					listener="#{tourPkgBean.selectAllSeason}" global="false" />
			</p:selectManyCheckbox>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idDepartDateBadge">Depart Date Badge</h:outputLabel>
		</p:column>
		<p:column colspan="2">
			<p:selectCheckboxMenu id="idDepartDateBadge" value="#{tourPkgBean.tourDepVO.departDateBadgeList}" label="Depart Date Badge" filter="true" filterMatchMode="contains" onHide="executeOnBadgeOnhide();" style="display: flex;width: fit-content;">
				<f:selectItems value="#{bterp:lookupItemList('depart_date_badge')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
			</p:selectCheckboxMenu>
			<p:remoteCommand name="executeOnBadgeOnhide" actionListener="#{tourPkgBean.handleDepartDateBadgeChange(false)}" update="idTxtDeptDateBadgeTag" global="false" />
			<p:outputLabel id="idTxtDeptDateBadgeTag" value="#{tourPkgBean.deptDateDesc}" style="float:left;"/>
		</p:column>
	</p:row>
	
	<p:row>
		<p:column>
			<h:outputLabel for="idDepartDateBadgeZh">Depart Date Badge (Chinese)</h:outputLabel>
		</p:column>
		<p:column colspan="2">
			<p:selectCheckboxMenu id="idDepartDateBadgeZh" value="#{tourPkgBean.tourDepVO.departDateBadgeZhList}" label="Depart Date Badge (Chinese)" filter="true" filterMatchMode="contains" onHide="executeOnBadgeZHOnhide();" style="display: flex;width: fit-content;">
				<f:selectItems value="#{bterp:lookupItemList('depart_date_badge_zh')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}"/>
			</p:selectCheckboxMenu>
			<p:remoteCommand name="executeOnBadgeZHOnhide" actionListener="#{tourPkgBean.handleDepartDateBadgeChange(true)}" update="idTxtDeptDateBadgeZHTag" global="false" />
			<p:outputLabel id="idTxtDeptDateBadgeZHTag" value="#{tourPkgBean.deptDateZhDesc}" style="float:left;"/>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idDailyCMS">Itinerary CMS</h:outputLabel>
		</p:column>
		<p:column colspan="2">
			<h:selectOneMenu id="idDailyCMS"
				value="#{tourPkgBean.tourDepVO.tourPkgDailyCms}"
				effect="fade">
				<f:selectItem itemLabel="Select One" />
				<f:selectItems value="#{tourPkgBean.tourDepVO.tourPkgDailyItineraryVOList}"
					var="vo" itemLabel="#{vo.code} - #{vo.title}" itemValue="#{vo.id}" />
			</h:selectOneMenu>
		</p:column>
	</p:row>

	<p:row>
		<p:column>
			<h:outputLabel>Customer Itinerary</h:outputLabel>
		</p:column>
		<p:column colspan="2"></p:column>
	</p:row>
</p:panelGrid>
<p:panelGrid id="idShowTourItineries">
	<p:row>
		<p:column style="width:150px">
			<h:outputLabel>
				<p:commandButton value="English"
					actionListener="#{tourPkgBean.handleTourItineryButtonClick('CUST', 'EN')}"
					process="@this" oncomplete="varAddCustItineryDialog.show()"
					update=":idAddCustItineryDialog" />
			</h:outputLabel>
		</p:column>
		<p:column>
			<p:panelGrid id="idCustItineryEN" style="border:0">
				<p:row>
					<p:column style="width:20px">
						<p:commandLink styleClass="ui-icon ui-icon-close"
							actionListener="#{tourPkgBean.delTourItinery('CUST', 'EN')}"
							update=":idAddTourDepForm:idCustItineryEN,:idEditTourDepForm:idCustItineryEN, :idAddTourDepForm:idCustItineryENUploadBy, :idEditTourDepForm:idCustItineryENUploadBy"
							process="@this"
							rendered="#{not empty tourPkgBean.itineryMap['CUSTEN'] and not tourPkgBean.itineryMap['CUSTEN'].isFromPkg}" />
					</p:column>
					<p:column>
						<h:outputText
							rendered="#{not tourPkgBean.itineryMap['CUSTEN'].isFromPkg}"
							value="#{tourPkgBean.itineryMap['CUSTEN'].name}" />
					</p:column>
				</p:row>
			</p:panelGrid>
		</p:column>
	</p:row>
	<p:row>
		<p:column />
		<p:column>
			<p:panelGrid id="idCustItineryENUploadBy" style="border:0">
				<p:row
					rendered="#{not empty tourPkgBean.itineryMap['CUSTEN'] and not tourPkgBean.itineryMap['CUSTEN'].isFromPkg}">
					<p:column style="width:75px;">
						<h:outputText value="Upload Date:" />
					</p:column>
					<p:column style="width:150px;">
						<p:inputText
							value="#{tourPkgBean.itineryMap['CUSTEN'].createdDate}"
							readonly="true" style="background:#ccc">
							<f:convertDateTime pattern="dd-MMM-yyyy" />
						</p:inputText>
					</p:column>
					<p:column style="width:75px;">
						<h:outputText value="Upload By:" />
					</p:column>
					<p:column>
						<p:inputText
							value="#{tourPkgBean.itineryMap['CUSTEN'].createdBy}"
							readonly="true" style="background:#ccc" />
					</p:column>
				</p:row>
			</p:panelGrid>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel>
				<p:commandButton value="Chinese/Malay"
					actionListener="#{tourPkgBean.handleTourItineryButtonClick('CUST', 'ZH')}"
					process="@this" oncomplete="varAddCustItineryDialog.show()"
					update=":idAddCustItineryDialog" />
			</h:outputLabel>
		</p:column>
		<p:column>
			<p:panelGrid id="idCustItineryZH" style="border:0">
				<p:row>
					<p:column style="width:20px">
						<p:commandLink styleClass="ui-icon ui-icon-close"
							actionListener="#{tourPkgBean.delTourItinery('CUST', 'ZH')}"
							update=":idAddTourDepForm:idCustItineryZH,:idEditTourDepForm:idCustItineryZH,:idAddTourDepForm:idCustItineryZHUploadBy,:idEditTourDepForm:idCustItineryZHUploadBy"
							process="@this"
							rendered="#{not empty tourPkgBean.itineryMap['CUSTZH'] and not tourPkgBean.itineryMap['CUSTZH'].isFromPkg}" />
					</p:column>
					<p:column>
						<h:outputText
							rendered="#{not tourPkgBean.itineryMap['CUSTZH'].isFromPkg}"
							value="#{tourPkgBean.itineryMap['CUSTZH'].name}" />
					</p:column>
				</p:row>
			</p:panelGrid>
		</p:column>
	</p:row>
	<p:row>
		<p:column />
		<p:column>
			<p:panelGrid id="idCustItineryZHUploadBy" style="border:0">
				<p:row
					rendered="#{not empty tourPkgBean.itineryMap['CUSTZH'] and not tourPkgBean.itineryMap['CUSTZH'].isFromPkg}">
					<p:column style="width:75px;">
						<h:outputText value="Upload Date:" />
					</p:column>
					<p:column style="width:150px;">
						<p:inputText
							value="#{tourPkgBean.itineryMap['CUSTZH'].createdDate}"
							readonly="true" style="background:#ccc">
							<f:convertDateTime pattern="dd-MMM-yyyy" />
						</p:inputText>
					</p:column>
					<p:column style="width:75px;">
						<h:outputText value="Upload By:" />
					</p:column>
					<p:column>
						<p:inputText
							value="#{tourPkgBean.itineryMap['CUSTZH'].createdBy}"
							readonly="true" style="background:#ccc" />
					</p:column>
				</p:row>
			</p:panelGrid>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel>Agent Itinerary</h:outputLabel>
		</p:column>
		<p:column></p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel>
				<p:commandButton value="English"
					actionListener="#{tourPkgBean.handleTourItineryButtonClick('AGENT', 'EN')}"
					process="@this" oncomplete="varAddAgentItineryDialog.show()"
					update=":idAddAgentItineryDialog" />
			</h:outputLabel>
		</p:column>
		<p:column>
			<p:panelGrid id="idAgentItineryEN" style="border:0">
				<p:row>
					<p:column style="width:20px">
						<p:commandLink styleClass="ui-icon ui-icon-close"
							actionListener="#{tourPkgBean.delTourItinery('AGENT', 'EN')}"
							update=":idAddTourDepForm:idAgentItineryEN,:idEditTourDepForm:idAgentItineryEN,:idAddTourDepForm:idAgentItineryENUploadBy,:idEditTourDepForm:idAgentItineryENUploadBy"
							process="@this"
							rendered="#{not empty tourPkgBean.itineryMap['AGENTEN'] and not tourPkgBean.itineryMap['AGENTEN'].isFromPkg}" />
					</p:column>
					<p:column>
						<h:outputText
							rendered="#{not tourPkgBean.itineryMap['AGENTEN'].isFromPkg}"
							value="#{tourPkgBean.itineryMap['AGENTEN'].name}" />
					</p:column>
				</p:row>
			</p:panelGrid>
		</p:column>
	</p:row>
	<p:row>
		<p:column />
		<p:column>
			<p:panelGrid id="idAgentItineryENUploadBy" style="border:0">
				<p:row
					rendered="#{not empty tourPkgBean.itineryMap['AGENTEN'] and not tourPkgBean.itineryMap['AGENTEN'].isFromPkg}">
					<p:column style="width:75px;">
						<h:outputText value="Upload Date:" />
					</p:column>
					<p:column style="width:150px;">
						<p:inputText
							value="#{tourPkgBean.itineryMap['AGENTEN'].createdDate}"
							readonly="true" style="background:#ccc">
							<f:convertDateTime pattern="dd-MMM-yyyy" />
						</p:inputText>
					</p:column>
					<p:column style="width:75px;">
						<h:outputText value="Upload By:" />
					</p:column>
					<p:column>
						<p:inputText
							value="#{tourPkgBean.itineryMap['AGENTEN'].createdBy}"
							readonly="true" style="background:#ccc" />
					</p:column>
				</p:row>
			</p:panelGrid>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel>
				<p:commandButton value="Chinese/Malay"
					actionListener="#{tourPkgBean.handleTourItineryButtonClick('AGENT', 'ZH')}"
					process="@this" oncomplete="varAddAgentItineryDialog.show()"
					update=":idAddAgentItineryDialog" />
			</h:outputLabel>
		</p:column>
		<p:column>
			<p:panelGrid id="idAgentItineryZH" style="border:0">
				<p:row>
					<p:column style="width:20px">
						<p:commandLink styleClass="ui-icon ui-icon-close"
							actionListener="#{tourPkgBean.delTourItinery('AGENT', 'ZH')}"
							update=":idAddTourDepForm:idAgentItineryZH,:idEditTourDepForm:idAgentItineryZH,:idAddTourDepForm:idAgentItineryZHUploadBy,:idEditTourDepForm:idAgentItineryZHUploadBy"
							process="@this"
							rendered="#{not empty tourPkgBean.itineryMap['AGENTZH'] and not tourPkgBean.itineryMap['AGENTZH'].isFromPkg}" />
					</p:column>
					<p:column>
						<h:outputText
							rendered="#{not tourPkgBean.itineryMap['AGENTZH'].isFromPkg}"
							value="#{tourPkgBean.itineryMap['AGENTZH'].name}" />
					</p:column>
				</p:row>
			</p:panelGrid>
		</p:column>
	</p:row>
	<p:row>
		<p:column />
		<p:column>
			<p:panelGrid id="idAgentItineryZHUploadBy" style="border:0">
				<p:row
					rendered="#{not empty tourPkgBean.itineryMap['AGENTZH'] and not tourPkgBean.itineryMap['AGENTZH'].isFromPkg}">
					<p:column style="width:75px;">
						<h:outputText value="Upload Date:" />
					</p:column>
					<p:column style="width:150px;">
						<p:inputText
							value="#{tourPkgBean.itineryMap['AGENTZH'].createdDate}"
							readonly="true" style="background:#ccc">
							<f:convertDateTime pattern="dd-MMM-yyyy" />
						</p:inputText>
					</p:column>
					<p:column style="width:75px;">
						<h:outputText value="Upload By:" />
					</p:column>
					<p:column>
						<p:inputText
							value="#{tourPkgBean.itineryMap['AGENTZH'].createdBy}"
							readonly="true" style="background:#ccc" />
					</p:column>
				</p:row>
			</p:panelGrid>
		</p:column>
	</p:row>
</p:panelGrid>
<p:panelGrid>
	<p:row>
		<p:column style="width:150px">
			<h:outputLabel for="idCruise">Cruise Schedule </h:outputLabel>
		</p:column>
		<p:column colspan="3">
			<h:selectOneMenu id="idCruise" label="Cruise Schedule"
				value="#{tourPkgBean.tourDepVO.idCruise}" effect="fade">
				<f:selectItem itemLabel="Select One" />
				<f:selectItems value="#{tourPkgBean.cruiseList}" var="vo"
					itemValue="#{vo.id}" itemLabel="#{vo.code} - #{vo.desc}" />
				<p:ajax listener="#{tourPkgBean.handleCruiseSelect}"
					event="change" update=":idCruiseScheduleListForm, idTourCd"
					oncomplete="varCruiseScheduleListDialog.show()" />
			</h:selectOneMenu>&nbsp;&nbsp;
			<p:commandButton icon="ui-icon-search"
				actionListener="#{tourPkgBean.handleCruiseSelect}"
				update=":idCruiseScheduleListDialog"
				oncomplete="varCruiseScheduleListDialog.show()" process="@this" />
			&nbsp;&nbsp;
			<p:commandLink actionListener="#{tourPkgBean.handleCruiseSelect}"
				update=":idCruiseScheduleListForm"
				oncomplete="varCruiseScheduleListDialog.show()" process="@this"
				style="color:#0040FF; text-decoration:underline;">
				<h:outputText id="idCruiseScheduleDesc"
					value="#{tourPkgBean.tourDepVO.cruiseScheduleVO.desc}" />
			</p:commandLink>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idShowCruise">Show Cruise Schedule</h:outputLabel>
		</p:column>
		<p:column colspan="3">
			<p:selectBooleanButton id="idShowCruise"
				value="#{tourPkgBean.tourDepVO.isShowCruise}" onLabel="Yes"
				offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close" />
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idTrvlInsPolicyS">Trvl Ins Policy</h:outputLabel>
		</p:column>
		<p:column>
			<p:inputTextarea id="idTrvlInsPolicyS"
				value="#{tourPkgBean.tourDepVO.travelInsPolicyS}"
				style="width:200px;" />
		</p:column>
		<p:column>
			<h:outputLabel for="idTrvlInsPolicySIssued">Issued</h:outputLabel>
		</p:column>
		<p:column style="width:450px">
			<p:selectBooleanButton id="idTrvlInsPolicySIssued"
				value="#{tourPkgBean.tourDepVO.isIssuedS}" onLabel="Yes"
				offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close" />
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idTourStatus">Tour Status</h:outputLabel>
		</p:column>
		<p:column>
			<h:selectOneMenu id="idTourStatus"
				value="#{tourPkgBean.tourDepVO.tourStatusCd}" effect="fade">
				<f:selectItems value="#{bterp:lookupItemList('tour_status')}"
					var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}" />
				<p:ajax event="change"
					listener="#{tourPkgBean.setIsTourStatusChanged(true)}"
					global="false" />
			</h:selectOneMenu>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idDepositPaid">Deposit Paid</h:outputLabel>
		</p:column>
		<p:column>
			<p:selectBooleanButton id="idDepositPaid"
				value="#{tourPkgBean.tourDepVO.isDepositPaid}" onLabel="Yes"
				offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close" />
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idPush">Is Push</h:outputLabel>
		</p:column>
		<p:column>
			<p:selectBooleanButton id="idPush"
				value="#{tourPkgBean.tourDepVO.isPush}" onLabel="Yes"
				offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close" />
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idHotDeal">Is Hot Deal</h:outputLabel>
		</p:column>
		<p:column>
			<p:selectBooleanButton id="idHotDeal"
				value="#{tourPkgBean.tourDepVO.isHotDeal}" onLabel="Yes"
				offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close" />
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel>Commision (RM)</h:outputLabel>
		</p:column>
		<p:column>
			<p:selectOneRadio value="#{tourPkgBean.tourDepVO.isCommisionPercent}">
				<f:selectItem itemLabel="Amount" itemValue="false" />
        		<f:selectItem itemLabel="Percentage" itemValue="true" />
    		</p:selectOneRadio>
		</p:column>
		<p:column>
			<p:panelGrid>
				<p:row>
					<p:column>
						<h:outputLabel style="width:50px;">AC</h:outputLabel>
					</p:column>
					<p:column>
						<h:outputLabel style="width:50px;">PC</h:outputLabel>
					</p:column>
					<p:column>
						<h:outputLabel style="width:50px;">SI</h:outputLabel>
					</p:column>
				</p:row>
				<p:row>
					<p:column>
						<p:inputText value="#{tourPkgBean.tourDepVO.cnaValue}"
							style="width:50px">
							<f:convertNumber pattern="#,##0.00" />
							<pe:keyFilter regEx="/[\d\.\s,]/" />
						</p:inputText>
					</p:column>
					<p:column>
						<p:inputText value="#{tourPkgBean.tourDepVO.cpaValue}"
							style="width:50px">
							<f:convertNumber pattern="#,##0.00" />
							<pe:keyFilter regEx="/[\d\.\s,]/" />
						</p:inputText>
					</p:column>
					<p:column>
						<p:inputText value="#{tourPkgBean.tourDepVO.csiValue}"
							style="width:50px">
							<f:convertNumber pattern="#,##0.00" />
							<pe:keyFilter regEx="/[\d\.\s,]/" />
						</p:inputText>
					</p:column>
				</p:row>
			</p:panelGrid>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel>
				<p:commandButton value="Hotel"
					oncomplete="varAddHotelDialog.show()" update=":idAddHotelDialog" />
			</h:outputLabel>
		</p:column>
		<p:column colspan="3">
			<p:panel id="idShowHotelList" style="border:0;">
				<p:dataTable value="#{tourPkgBean.tourDepVO.tourHotelList}"
					var="vo"
					rendered="#{not empty tourPkgBean.tourDepVO.tourHotelList}">
					<p:column style="width:30px;">
						<p:commandLink styleClass="ui-icon ui-icon-close"
							actionListener="#{tourPkgBean.delTourHotel(vo)}"
							update=":idAddTourDepForm:idShowHotelList,:idEditTourDepForm:idShowHotelList,:idAddTourHotelForm" />
					</p:column>
					<p:column headerText="From Date" style="width:50px;">
						<h:outputText value="#{vo.fromDate}">
							<f:convertDateTime pattern="dd-MMM-yyyy" />
						</h:outputText>
					</p:column>
					<p:column headerText="To Date" style="width:50px;">
						<h:outputText value="#{vo.toDate}">
							<f:convertDateTime pattern="dd-MMM-yyyy" />
						</h:outputText>
					</p:column>
					<p:column headerText="Hotel Name">
						<h:outputText value="#{vo.hotelVO.name}" />
					</p:column>
				</p:dataTable>
			</p:panel>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel>
				<p:commandButton value="Company Code"
					actionListener="#{tourPkgBean.showTourDepItemList}"
					oncomplete="varDepItemListDialog.show()"
					update=":idDepItemListDialog"
					process="@this" />
					<span class="required">*</span>
			</h:outputLabel>
		</p:column>
		<p:column colspan="3">
			<p:panel id="idShowCompanyCodeList" style="border:0;">
				<ui:repeat value="#{tourPkgBean.tourDepItemList}" var="list">
					<h:outputText value="#{list.get(0).companyVO.name}"
						style="padding:2px 0;" />
					<br />
				</ui:repeat>
			</p:panel>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel>
				<p:commandButton value="Cruise Cabin +" actionListener="#{tourPkgBean.resetTourCabinForm}"
					oncomplete="varAddCruiseCabinDialog.show()" update=":idAddCruiseCabinDialog,:idAddCruiseCabinForm">
					<pe:resetEditableValues for=":idAddCruiseCabinForm" />
				</p:commandButton>
			</h:outputLabel>
		</p:column>
		<p:column colspan="3">
			<p:dataTable id="idTourCabinListTable" value="#{tourPkgBean.tourCabinList}" var="cabinVO">
				<p:columnGroup type="header">
					<p:row>
						<p:column rowspan="2" headerText="Edit" width="30"/>
						<p:column rowspan="2" headerText="Delete" width="30"/>
						<p:column rowspan="2" headerText="Type"/>
						<p:column rowspan="2" headerText="Allotment"/>
						<p:column rowspan="2" headerText="Max Pax/Cabin"/>
						<p:column colspan="4" headerText="Adult (RM)"/>
						<p:column colspan="2" headerText="Child (RM)"/>
						<p:column colspan="1" headerText="Infant (RM)"/>
						<p:column colspan="2" headerText="Discount Level 1"/>
						<p:column colspan="2" headerText="Discount Level 2"/>
					</p:row>
					<p:row>
						<p:column headerText="1st/2nd"/>
						<p:column headerText="3rd"/>
						<p:column headerText="4th"/>
						<p:column headerText="Single"/>
						<p:column headerText="3rd"/>
						<p:column headerText="4th"/>
						<p:column headerText="Infant"/>
						<p:column headerText="Amount"/>
						<p:column headerText="Pax"/>
						<p:column headerText="Amount"/>
						<p:column headerText="Pax"/>
					</p:row>
				</p:columnGroup>
				<p:column style="width:30px; text-align:center;">
					<p:commandButton icon="ui-icon-pencil"
						actionListener="#{tourPkgBean.setTourCabinVO(cabinVO)}"
						oncomplete="varAddCruiseCabinDialog.show()" process="@this,:idAddCruiseCabinForm"
						update=":idAddCruiseCabinDialog,:idAddCruiseCabinForm" />
				</p:column>
				<p:column style="width:30px; text-align:center;">
					<p:commandButton icon="ui-icon-close" styleClass="ui-state-error"
						actionListener="#{tourPkgBean.deleteTourCabin(cabinVO)}"
						update="idTourCabinListTable,:idAddTourDepForm:msg,:idEditTourDepForm:msg"
						process="@this" />
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.cruiseCabinCd}" />
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.cabinAllotment}"/>
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.paxPerCabin}"/>
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.priceTwn}">
						<f:convertNumber pattern="#,##0.00" />
					</h:outputText>
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.price3}">
						<f:convertNumber pattern="#,##0.00" />
					</h:outputText>
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.price4}">
						<f:convertNumber pattern="#,##0.00" />
					</h:outputText>
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.priceSgl}">
						<f:convertNumber pattern="#,##0.00" />
					</h:outputText>
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.price3Chd}">
						<f:convertNumber pattern="#,##0.00" />
					</h:outputText>
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.price4Chd}">
						<f:convertNumber pattern="#,##0.00" />
					</h:outputText>
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.priceInf}">
						<f:convertNumber pattern="#,##0.00" />
					</h:outputText>
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.discountLvl1}">
						<f:convertNumber pattern="#,##0.00" />
					</h:outputText>
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.discountLvl1Pax}"/>
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.discountLvl2}">
						<f:convertNumber pattern="#,##0.00" />
					</h:outputText>
				</p:column>
				<p:column>
					<h:outputText value="#{cabinVO.discountLvl2Pax}"/>
				</p:column>
			</p:dataTable>
		</p:column>
	</p:row>
	<p:row>
		<p:column>
			<h:outputLabel for="idInvRemarks">Tour Remarks</h:outputLabel>
		</p:column>
		<p:column colspan="3">
			<p:inputTextarea id="idInvRemarks" rows="10"
				value="#{tourPkgBean.tourDepVO.invRemarks}" style="width: 500px; height: 200px;" />
		</p:column>
	</p:row>
</p:panelGrid>
</div>
<h:panelGrid columns="2" style="width:1px; margin-top:10px;">
	<p:commandButton value="#{msg['common.button.label.save']}"
		actionListener="#{tourPkgBean.addTourDep}"
		update="@form,:idTourDepListForm:idTourDepList"
		rendered="#{empty tourPkgBean.tourDepVO.id}" />
	<p:commandButton value="#{msg['common.button.label.update']}"
		actionListener="#{tourPkgBean.setReasonType2}"
		oncomplete="onTourDepReasonValidation(xhr, status, args)"
		update="@form,:idTourDepListForm:idTourDepList"
		rendered="#{not empty tourPkgBean.tourDepVO.id}" />
	<p:commandButton value="#{msg['common.button.label.cancel']}"
		actionListener="#{tourPkgBean.resetTourDepForm}"
		oncomplete="varAddTourDepDialog.hide(),varEditTourDepDialog.hide()"
		process="@this" update="@form">
		<pe:resetEditableValues for="idAddTourDepForm,idEditTourDepForm" />
	</p:commandButton>
</h:panelGrid>
</ui:composition>