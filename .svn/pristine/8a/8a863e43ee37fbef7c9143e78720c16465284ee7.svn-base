<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui"
	xmlns:pe="http://primefaces.org/ui/extensions"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

	<p:growl id="msg" />

	<script type="text/javascript">
		function onValidation(xhr, status, args) {
			if (args.validationFailed) {
				varCancelEInvoiceDialog.show();
			} else {
				varCancelEInvoiceDialog.hide();
			}
		}
	</script>

	<p:panelGrid>
		<p:row>
			<p:column>Cancellation reason <span class="required">*</span> </p:column>
			<p:column>
				<p:inputText value="#{paymentBean.cancellationReason}" required="true"></p:inputText>
			</p:column>
		</p:row>
	</p:panelGrid>

	<h:panelGrid columns="2" style="width: 1px;">
		<p:commandButton value="OK"
			actionListener="#{paymentBean.cancelEInvoice(paymentBean.cancellationReason)}"
			update="@form, :idEInvoiceForm, :idAddPayment" oncomplete="if (args &amp;&amp; !args.validationFailed) {varCancelEInvoiceDialog.hide();}" />
		<p:commandButton value="Close" oncomplete="varCancelEInvoiceDialog.hide();" />
	</h:panelGrid>
</ui:composition>