	/**
	 * Delete account trans
	 * @param acctTransViewVO
	 */
	public void delAcctTrans(AcctTransViewVO acctTransViewVO) {
		try {
			cashBookVO.getAcctTransList().remove(acctTransViewVO);
			updateTaxableAmount();
			
			totalBal = totalAcctTransBal();
			successResult();

		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * Edit account trans
	 * @throws BusinessException
	 */
	public void editAcctTrans() throws BusinessException{
		try {
			if (acctTransViewVO.getAmount()==0.00) {
				throw new BusinessException(CommonErrConstant.ERR_BANK_PAYMENT_CREDIT_REQUIRED);
			
			} else {
				resetAcctTransViewForm();
				updateTaxableAmount();
				
				totalBal = totalAcctTransBal();
				acctTransViewVO.setAmount(cashBookVO.getCredit() - totalBal);
				successResult();
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void addAcctTrans() throws BusinessException {
		try {
			if(acctTransViewVO.getAmount()==0.00) {
				throw new BusinessException(CommonErrConstant.ERR_BANK_PAYMENT_CREDIT_REQUIRED);
			} else {	
				if(null == cashBookVO.getAcctTransList()) 
					cashBookVO.setAcctTransList(new ArrayList<AcctTransViewVO>());
				acctTransViewVO.setType(lookupItemCBT.getCode());
				
				cashBookVO.getAcctTransList().add(acctTransViewVO);
				updateTaxableAmount();
				
				resetAcctTransViewForm();
				totalBal = totalAcctTransBal();
				acctTransViewVO.setAmount(cashBookVO.getCredit() - totalBal);
				
				successResult();
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void addPayment() throws BusinessException {
		try {
			trackingLogUtils.startLogs();
			
			// check financial closed / GST submitted
			checkFinGSTClosed(CommonConstant.ACTION_CD_ADD, null, cashBookVO.getDtTrans(), invPmntAuthVO.isAccountManager());
			
			bankAcctSearchVO = paymentBO.getBankAcctSearchList(cashBookVO.getIdBank());
			acctVO = paymentBO.getAcctSearchList(bankAcctSearchVO.getIdAcct());
			
			if(cashBookVO.getCredit() != 0.00) {
				if(amtCalcViewVO.getTotalAmountIncludeTax().doubleValue() == cashBookVO.getCredit().doubleValue()) {
					cashBookVO.setAmountCalcViewVO(amtCalcViewVO);
					paymentBO.addPayment(cashBookVO, getSessionInfoBean().getCompanyVO().getId(), bankAcctSearchVO, lookupItemBT, lookupItemCBT, acctVO);
					onPaymentSelected(cashBookVO);
					
				} else throw new BusinessException(CommonErrConstant.ERR_BANK_PAYMENT_NOT_EQUAL);
			} else throw new BusinessException(CommonErrConstant.ERR_BANK_PAYMENT_CREDIT_REQUIRED);	
			cashBookVO.setTemp(bankAcctSearchVO.getName());
			cashBookVO.setIdBank(bankAcctSearchVO.getId());

			//Calculate new total balance
			updateTaxableAmount();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("addPayment");
		}
	}
	
	private void updateTaxableAmount() throws BusinessException {
		amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(amtCalcViewVO, true, cashBookVO.getAcctTransList(), null, false);
	}
	
	/**
	 * 
	 * @param vo
	 */
	public void onPaymentSelected(CashBookVO vo) {
		try {
			trackingLogUtils.startLogs();
			
			cashBookVO = cashBookBO.getCashBookById(vo.getId()); //vo;
			setOriObj(cashBookVO.clone());
			
			acctTransCashBookVO = depositBO.getAcctTransCashBook(cashBookVO.getSysNo(), cashBookVO.getTransTypeCd(), cashBookVO.getSysCode(), getSessionInfoBean().getCompanyVO().getId());
			cashBookVO.setAcctTransList(paymentBO.getAcctTransViewTableList(cashBookVO.getSysNo(),cashBookVO.getTypeCd(),cashBookVO.getSysCode(),BaseConstant.STATUS_ACTIVE,getSessionInfoBean().getCompanyVO().getId()));
			bankAcctSearchVO = paymentBO.getBankAcctSearchList(cashBookVO.getIdBank());

			for (int i = 0 ; i < cashBookVO.getAcctTransList().size() ; i++) {
				if (cashBookVO.getAcctTransList().get(i).getCredit() > 0) {
					cashBookVO.getAcctTransList().get(i).setAmount(-cashBookVO.getAcctTransList().get(i).getCredit());
				} else {
					cashBookVO.getAcctTransList().get(i).setAmount(cashBookVO.getAcctTransList().get(i).getDebit());
				}
			}
			isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), cashBookVO.getDtTrans());
			
			totalBal = totalAcctTransBal();
			updateTaxableAmount();
			
			cashBookVO.setTemp(bankAcctSearchVO.getName());
			// Check Financial Period Closed
			getFinPeriodClosedStatus();

			if (cashBookVO.getIdSupplier() != null) {
				SupplierVO supplierVO = purchaseBO.getSupplierDetails(cashBookVO.getIdSupplier());
				cashBookVO.setSuppCode(supplierVO.getSysNo());
			}
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("onPaymentSelected");
		}
	}

	/**
	 * 
	 * @throws BusinessException
	 */
	public void deletePayment() throws BusinessException {
		try {
			trackingLogUtils.startLogs();
			
			// Unable to delete this record due to financial period closed.
			if (cashBookVO.isDateInFinPeriodClosed()) throw new BusinessException(CommonErrConstant.ERR_ACCT_FIN_PERIOD_CLOSED_CANNOT_DEL);
			
			//deletePaymentList();
			paymentBO.deletePaymentList(cashBookVO, getSessionInfoBean().getCompanyVO().getId());
			search();
			resetForm();
			resetAcctTransViewForm();
			successResult();

		} catch (Throwable t){
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("deletePayment");
		}
	}

