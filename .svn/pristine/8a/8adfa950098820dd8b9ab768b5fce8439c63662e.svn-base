<!-- 	</p:row> -->
</p:panelGrid>
<h:panelGrid columns="2" style="width:1px;">
	<p:commandButton value="#{msg['common.button.label.save']}" actionListener="#{cruiseBean.addCruiseSchedule}" oncomplete="onAddCruiseScheduleValidate(xhr, status, args)" update="@form,:idCruiseSchedulesForm"/>
	<p:commandButton value="#{msg['common.button.label.cancel']}" oncomplete="varAddCruiseScheduleDialog.hide()" process="@this" update="@form">
		<pe:resetEditableValues for="idAddCruiseScheduleForm"/>
	</p:commandButton>
</h:panelGrid>

</ui:composition>