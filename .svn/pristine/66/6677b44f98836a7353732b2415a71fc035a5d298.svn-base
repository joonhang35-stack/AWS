package com.bcs.zsg.acct.vo;

import java.util.Date;

import com.bcs.zsg.core.vo.BaseVO;

public class AcctBalVO extends BaseVO {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;

	private Long idAcct;
	private Double debitBeginBal = 0.0;
	private Double creditBeginBal = 0.0;
	private Double debitCurrentBal = 0.0;
	private Double creditCurrentBal = 0.0;
	private Double debitCloseBal = 0.0;
	private Double creditCloseBal = 0.0;
	private Date dtBeginBal;
	private Date dtCurrentBal;
	private Date dtCloseBal;
	private String typeCode;

	/**
	 * @return the idAcct
	 */
	public Long getIdAcct() {
		return idAcct;
	}

	/**
	 * @param idAcct the idAcct to set
	 */
	public void setIdAcct(Long idAcct) {
		this.idAcct = idAcct;
	}

	/**
	 * @return the debitBeginBal
	 */
	public Double getDebitBeginBal() {
		return debitBeginBal;
	}

	/**
	 * @param debitBeginBal the debitBeginBal to set
	 */
	public void setDebitBeginBal(Double debitBeginBal) {
		this.debitBeginBal = debitBeginBal;
	}

	/**
	 * @return the creditBeginBal
	 */
	public Double getCreditBeginBal() {
		return creditBeginBal;
	}

	/**
	 * @param creditBeginBal the creditBeginBal to set
	 */
	public void setCreditBeginBal(Double creditBeginBal) {
		this.creditBeginBal = creditBeginBal;
	}

	/**
	 * @return the debitCurrentBal
	 */
	public Double getDebitCurrentBal() {
		return debitCurrentBal;
	}

	/**
	 * @param debitCurrentBal the debitCurrentBal to set
	 */
	public void setDebitCurrentBal(Double debitCurrentBal) {
		this.debitCurrentBal = debitCurrentBal;
	}

	/**
	 * @return the creditCurrentBal
	 */
	public Double getCreditCurrentBal() {
		return creditCurrentBal;
	}

	/**
	 * @param creditCurrentBal the creditCurrentBal to set
	 */
	public void setCreditCurrentBal(Double creditCurrentBal) {
		this.creditCurrentBal = creditCurrentBal;
	}

	/**
	 * @return the debitCloseBal
	 */
	public Double getDebitCloseBal() {
		return debitCloseBal;
	}

	/**
	 * @param debitCloseBal the debitCloseBal to set
	 */
	public void setDebitCloseBal(Double debitCloseBal) {
		this.debitCloseBal = debitCloseBal;
	}

	/**
	 * @return the creditCloseBal
	 */
	public Double getCreditCloseBal() {
		return creditCloseBal;
	}

	/**
	 * @param creditCloseBal the creditCloseBal to set
	 */
	public void setCreditCloseBal(Double creditCloseBal) {
		this.creditCloseBal = creditCloseBal;
	}

	/**
	 * @return the dtBeginBal
	 */
	public Date getDtBeginBal() {
		return dtBeginBal;
	}

	/**
	 * @param dtBeginBal the dtBeginBal to set
	 */
	public void setDtBeginBal(Date dtBeginBal) {
		this.dtBeginBal = dtBeginBal;
	}

	/**
	 * @return the dtCurrentBal
	 */
	public Date getDtCurrentBal() {
		return dtCurrentBal;
	}

	/**
	 * @param dtCurrentBal the dtCurrentBal to set
	 */
	public void setDtCurrentBal(Date dtCurrentBal) {
		this.dtCurrentBal = dtCurrentBal;
	}

	/**
	 * @return the dtCloseBal
	 */
	public Date getDtCloseBal() {
		return dtCloseBal;
	}

	/**
	 * @param dtCloseBal the dtCloseBal to set
	 */
	public void setDtCloseBal(Date dtCloseBal) {
		this.dtCloseBal = dtCloseBal;
	}

	/**
	 * @return the typeCode
	 */
	public String getTypeCode() {
		return typeCode;
	}

	/**
	 * @param typeCode the typeCode to set
	 */
	public void setTypeCode(String typeCode) {
		this.typeCode = typeCode;
	}
