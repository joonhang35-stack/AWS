<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp"
				template="/WEB-INF/views/layouts/main.xhtml">

<ui:define name="content">
<style type="text/css">
	.amount {
		text-align:right;
	}
	
	/*#idCashBookForm .ui-datatable-scrollable-body table tr:nth-child(even) {
		background: #fbf7df;
	}*/
</style>
<p:panel header="Cash Book" toggleable="true" toggleSpeed="500">
	<h:form id="idCashBookForm">
	<p:growl id="msgW" widgetVar="msgWidget" />
	<script language="javascript" src="#{request.contextPath}/js/Validator.js"  />
	<script type="text/javascript" >
	//<![CDATA[
		$(document).ready(function() {
			initScreen();
		});

		function initScreen() {
	    	$(".DATE").children().blur(function() {
		    	var dt = $(this).attr("value");
		    	if(dt == "") return;
	
		    	if (Validator.ValidateDate(dt, "dd-MMM-yyyy")) {
			    	msgWidget.show([{summary:'INVALID DATE', detail: 'Inputed date is invalid.', severity: 'warn'}]);
			    	$(this).focus();
		  		}
		    });
		}
		
		document.addEventListener('DOMContentLoaded', function() {
		    var filters = document.querySelectorAll('input.ui-column-filter');
		    filters.forEach(function(filter) {
		        filter.setAttribute('enterkeyhint', 'enter');
		    });
		});

		function setEnterKeyHint() {
		    var filters = document.querySelectorAll('input.ui-column-filter');
		    filters.forEach(function(filter) {
		        filter.setAttribute('enterkeyhint', 'enter');
		    });
		}
	//]]>
	</script>
		<p:panelGrid>
			<p:row>
				<p:column style="width:100px"><h:outputLabel for="idBankAcct">Bank Account:</h:outputLabel></p:column>
				<p:column style="width:200px">
					<h:selectOneMenu id="idBankAcct"  label="Bank Account" value="#{cashBookBean.searchParamVO.obj1}" effect="fade" required="true" style="width:200px">  
		            	<f:selectItem itemLabel="Select One"/>  
		            	<f:selectItems value="#{cashBookBean.bankAcctViewList}" var="vo" itemLabel="#{vo.name}" itemValue="#{vo.id}"/>  
		        	</h:selectOneMenu>
		       	</p:column>
       			<p:column style="width:1px;"><h:outputLabel>From</h:outputLabel></p:column>
				<p:column style="width:1px;">
					<p:calendar value="#{cashBookBean.searchParamVO.fromDate}" id="idFromDate" label="Date From" pattern="#{config['date.display.pattern']}" navigator="true" showButtonPanel="true" 
						 		maxlength="11" size="11" styleClass="DATE" display="inline"></p:calendar>
				</p:column>
				<p:column style="width:1px;"><h:outputLabel>To</h:outputLabel></p:column>
				<p:column style="width:1px;">
					<p:calendar value="#{cashBookBean.searchParamVO.toDate}" id="idToDate" label="Date To" pattern="#{config['date.display.pattern']}" navigator="true" showButtonPanel="true" 
								maxlength="11" size="11" styleClass="DATE" display="inline"></p:calendar>
				</p:column>
				<p:column style="width:70px">
					<p:commandButton value="Search" actionListener="#{cashBookBean.search}" update="@form" oncomplete="varCashBookList.clearFilters(); setEnterKeyHint();"/>
				</p:column>
				<p:column style="width:110px">
					<p:commandButton value="#{msg['common.button.label.print']} [PDF]" icon="ui-icon-print"
						actionListener="#{cashBookBean.printBankBookReport('PDF')}" ajax="false" rendered="#{not empty cashBookBean.cashBookList}"/>
				</p:column>
				<p:column style="width:110px">
					<p:commandButton value="#{msg['common.button.label.print']} [Excel]" icon="ui-icon-print"
						actionListener="#{cashBookBean.printBankBookReport('XLS')}" ajax="false" rendered="#{not empty cashBookBean.cashBookList}"/>
				</p:column>
				<p:column></p:column>
			</p:row>
		</p:panelGrid>
		
		<p:panelGrid id="idShowBal">
			<p:row>
				<p:column style="width:150px;"><h:outputText value="Beginning Balance: " style="font-size:15px;"/></p:column>
				<p:column style="width:300px; text-align:left;">
					<h:outputText value="#{cashBookBean.bankAcctViewVO.beginBalVO.debitBeginBal}" style="font-size:15px;" rendered="#{cashBookBean.bankAcctViewVO.beginBalVO.debitBeginBal gt 0}">
						<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
					</h:outputText>
					<h:outputText value="#{cashBookBean.bankAcctViewVO.beginBalVO.creditBeginBal}" style="font-size:15px;" rendered="#{cashBookBean.bankAcctViewVO.beginBalVO.creditBeginBal gt 0}">
						<f:convertNumber pattern="-#{config['amount.format.pattern']}"/>
					</h:outputText>
					<h:outputText value="0.00" style="font-size:15px;" rendered="#{cashBookBean.bankAcctViewVO.beginBalVO.creditBeginBal le 0 and cashBookBean.bankAcctViewVO.beginBalVO.debitBeginBal le 0}"/>
				</p:column>
				<p:column></p:column>
			</p:row>
		</p:panelGrid>
		
		<p:dataTable widgetVar="varCashBookList" id="idCashBookList" var="vo" value="#{cashBookBean.cashBookList}" 
					scrollable="true" scrollRows="20" scrollHeight="500" liveScroll="true" filteredValue="#{cashBookBean.filteredObjList}" filterEvent="enter">
			
			<p:ajax event="sort" listener="#{cashBookBean.onSorting}" update=":idCashBookForm:idCashBookList" process="@this"/>
			
			<p:column id="idSysNo" width="80" headerText="Doc #" filterBy="#{vo.sysPrefix}-#{vo.sysNo}" filterStyle="width:70px;" filterMatchMode="contains" sortBy="#{vo.sysPrefix}-#{vo.sysNo}">
				<h:outputText value="#{vo.sysPrefix}-#{vo.sysNo}"/>
			</p:column>
			
			<p:column id="idDtTrans" width="90" headerText="Date" filterBy="#{cashBookBean.dateFormat(vo.dtTrans, config['date.display.pattern'])}" filterStyle="width:80px;" filterMatchMode="contains" sortBy="#{vo.dtTrans}">
				<h:outputText value="#{vo.dtTrans}">
					<f:convertDateTime pattern="#{config['date.display.pattern']}"/>
				</h:outputText>
			</p:column>
			
			<p:column id="idTransTypeCd" width="120" headerText="Transaction Type" filterBy="#{bterp:lookupItemDesc('bank_tran', vo.transTypeCd)}" filterMatchMode="contains" sortBy="#{vo.transTypeCd}">
				<h:outputText value="#{bterp:lookupItemDesc('bank_tran', vo.transTypeCd)}"/>
			</p:column>
			
			<p:column id="idDeposit" width="120" headerText="Deposit" filterBy="#{vo.debit}" styleClass="amount" sortBy="#{vo.debit}">
				<h:outputText value="#{vo.debit}">
					<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
				</h:outputText>
			</p:column>
			
			<p:column id="idCredit" width="120" headerText="Payment" filterBy="#{vo.credit}" styleClass="amount" sortBy="#{vo.credit}">
				<h:outputText value="#{vo.credit}">
					<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
				</h:outputText>
			</p:column>
			
			<p:column width="120" headerText="Balance" filterBy="#{vo.balance}" styleClass="amount">
				<h:outputText value="#{vo.balance}" rendered="#{vo.statusCode eq 'A'}">
					<f:convertNumber pattern="#{config['amount.format.pattern']}"/>
				</h:outputText>
			</p:column>
			
			<p:column id="idPayee" width="120" headerText="Payee" filterBy="#{vo.payee}" filterMatchMode="contains" sortBy="#{vo.payee}">
				<h:outputText value="#{vo.payee}"/>
			</p:column>
			
			<p:column id="idRefNo" width="120" headerText="Cheque No." filterBy="#{vo.refNo}" filterMatchMode="contains" sortBy="#{vo.refNo}">
				<h:outputText value="#{vo.refNo}"/>
			</p:column>
			
			<p:column id="idRemarks" width="120" headerText="Memo" filterBy="#{vo.remarks}" filterMatchMode="contains" sortBy="#{vo.remarks}">
				<h:outputText value="#{vo.remarks}"/>
			</p:column>
			
			<p:column id="idStatusCode" width="80" headerText="Status" filterBy="#{cashBookBean.getStatusStr(vo.statusCode)}" filterStyle="width:70px;" sortBy="#{vo.remarks}" style="text-align:center;">
				<h:outputText value="Void" rendered="#{vo.statusCode eq 'T'}"/>
			</p:column>
			
			<p:column id="idClr" width="40" headerText="Clr" filterBy="#{vo.isClear}" filterStyle="width:30px;" sortBy="#{vo.isClear}" style="width:40px; text-align:center;">
				<p:selectBooleanCheckbox value="#{vo.isClear}" disabled="true">
				</p:selectBooleanCheckbox>
			</p:column>
			
			<p:column id="idMrk" width="40" headerText="Mrk" filterBy="#{vo.isMark}" filterStyle="width:30px;" sortBy="#{vo.isMark}" style="width:40px; text-align:center;">
				<p:selectBooleanCheckbox value="#{vo.isMark}" disabled="true">
				</p:selectBooleanCheckbox>
			</p:column>
			
			<p:column id="idUpdBy" width="120" headerText="Updated By" filterBy="#{vo.updatedBy}" filterMatchMode="contains">
				<h:outputText value="#{vo.updatedBy}">
					<f:convertDateTime pattern="#{config['date.display.pattern']}"/>
				</h:outputText>
			</p:column>
			
			<p:column id="idUpdDate" width="80" headerText="Updated Date" >
				<h:outputText value="#{vo.updatedDate}">
					<f:convertDateTime pattern="#{config['date.display.pattern']} HH:mm:ss"/>
				</h:outputText>
			</p:column>
			
			<p:columnGroup type="footer">
				<p:row>
					<p:column width="332" colspan="3" footerText="Total" style="text-align:right"/>
					<p:column width="120" style="text-align:right" footerText="#{cashBookBean.getDoubleDecimalFormat(config['amount.format.pattern'], cashBookBean.cashBookBalVO.totalDebit)}"/>
					<p:column width="120" style="text-align:right" footerText="#{cashBookBean.getDoubleDecimalFormat(config['amount.format.pattern'], cashBookBean.cashBookBalVO.totalCredit)}"/>
					<p:column width="120" style="text-align:right" footerText="#{cashBookBean.getDoubleDecimalFormat(config['amount.format.pattern'], (cashBookBean.bankAcctViewVO.beginBalVO.debitBeginBal - cashBookBean.bankAcctViewVO.beginBalVO.creditBeginBal) + (cashBookBean.cashBookBalVO.totalDebit - cashBookBean.cashBookBalVO.totalCredit))}"/>
					<p:column width="870" />
				</p:row>
			</p:columnGroup>
		</p:dataTable>
		<!-- Hidden checking -->
		<h:outputText value="#{cashBookBean.bankAcctViewVO.currentBalVO.debitCurrentBal}" style="color:#ffffff;"/>
		<h:outputText value="|" style="color:#ffffff;"/>
		<h:outputText value="#{cashBookBean.bankAcctViewVO.currentBalVO.creditCurrentBal}" style="color:#ffffff;"/>
		
		<!-- <p:panel style="border:none;">
			<p:commandButton value="#{msg['common.button.label.print']} PDF" icon="ui-icon-print"
					actionListener="#{cashBookBean.printCashBookReport}" ajax="false"
								rendered="#{not empty cashBookBean.cashBookList}">
			</p:commandButton>
		</p:panel> -->
	    	
	</h:form>
</p:panel>

<!--
	DIALOG - EDIT CASH BOOK
-->
<p:dialog widgetVar="varEditCashBookDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="true">
	<f:facet name="header">
		<h:outputFormat value="Edit Cash Book" />
	</f:facet>
	
	<h:form id="idEditCashBookForm">
		<p:growl id="msg" />
		<p:panelGrid>
			<p:row>
				<p:column><h:outputLabel for="idDocNo">Doc #:</h:outputLabel></p:column>
				<p:column><p:inputText id="idDocNo" value="#{cashBookBean.cashBookVO.sysNo}" readonly="true"/></p:column>
			</p:row>
			<p:row>
				<p:column><h:outputLabel for="idDocNo">Clear:</h:outputLabel></p:column>
				<p:column><p:selectBooleanButton value="#{cashBookBean.cashBookVO.isClear}" onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"/></p:column>
			</p:row>
			<p:row>
				<p:column><h:outputLabel for="idDocNo">Mark:</h:outputLabel></p:column>
				<p:column><p:selectBooleanButton value="#{cashBookBean.cashBookVO.isMark}" onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"/></p:column>
			</p:row>
		</p:panelGrid>
		<h:panelGrid columns="2" style="width: 1px;">
			<p:commandButton value="Save" actionListener="#{cashBookBean.updCashBook}" update="@form,:idCashBookForm:idCashBookList" oncomplete="varEditCashBookDialog.hide()"/>
			<p:commandButton value="Cancel" actionListener="#{cashBookBean.resetForm}" onclick="varEditCashBookDialog.hide()" process="@this" update="@form"/>
		</h:panelGrid>
	</h:form>
</p:dialog>
</ui:define>
</ui:composition>