<p:dialog header="Credit Note Payments" widgetVar="varAddInvoicePaymentsDialog" modal="true"
	resizable="false" dynamic="true" draggable="true" closable="false">
	<h:form id="idAddInvoicePaymentsForm">
		<ui:include src="../../sales/common/add_creditnote_payments.xhtml"/>
	</h:form>
</p:dialog>

