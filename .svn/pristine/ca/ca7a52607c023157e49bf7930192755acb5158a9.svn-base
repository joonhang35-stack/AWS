<p:dialog header="Account List" widgetVar="varAcctListDialog" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
	<h:form id="idAcctListForm">
		<p:dataTable value="#{salesBean.acctViewList}" var="vo" paginator="true" rows="20" 
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
			rowsPerPageTemplate="10, 20, 30" rowKey="#{vo.id}" selectionMode="single" filterEvent="enter">
			<p:ajax event="rowSelect" listener="#{salesBean.handleAcctSelect}" update=":idAddInvoiceDetailsForm:idSalesAcct, :idAddInvoiceDetailsForm:idAcctDesc" oncomplete="varAcctListDialog.hide()"/>
			
			<p:column headerText="Account" sortBy="#{vo.code}-#{vo.subCode}" filterBy="#{vo.code}-#{vo.subCode}" filterMatchMode="contains">
				<h:outputText value="#{vo.code}" rendered="#{empty vo.subCode}"/>
				<h:outputText value="#{vo.code}-#{vo.subCode}" rendered="#{not empty vo.subCode}"/>
			</p:column>
			<p:column headerText="Description" sortBy="#{vo.desc}, #{vo.subDesc}" filterBy="#{vo.desc}, #{vo.subDesc}" filterMatchMode="contains">
				<h:outputText value="#{vo.desc}" rendered="#{empty vo.subDesc}"/>
				<h:outputText value="#{vo.desc}, #{vo.subDesc}" rendered="#{not empty vo.subDesc}"/>
			</p:column>
		</p:dataTable>
		<h:panelGrid columns="1">
			<p:commandButton value="#{msg['common.button.label.cancel']}" onclick="varAcctListDialog.hide()"/>
		</h:panelGrid>
	</h:form>
</p:dialog>

<p:dialog id="idInvEOItemListDialog" header="Invoice Item List" widgetVar="varInvEOItemListDialog" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
	<h:form id="idInvEOItemListForm">
		<p:dataTable value="#{salesBean.invEOItemViewList}" var="vo" paginator="true" rows="20" 
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
			rowsPerPageTemplate="10, 20, 30" rowKey="#{vo.id}" selectionMode="single" filterEvent="enter">
			<p:ajax event="rowSelect" listener="#{salesBean.handleInvEOItemSelect}" update=":idAddInvoiceDetailsForm" oncomplete="varInvEOItemListDialog.hide()"/>
			
			<p:column headerText="Code" sortBy="#{vo.code}" filterBy="#{vo.code}" filterMatchMode="contains">
				<h:outputText value="#{vo.code}"/>
			</p:column>
			<p:column headerText="Description" sortBy="#{vo.description}" filterBy="#{vo.description}" filterMatchMode="contains">
				<h:outputText value="#{vo.description}"/>
			</p:column>
			<p:column headerText="Amount" sortBy="#{vo.amount}" filterBy="#{vo.amount}">
				<h:outputText value="#{vo.amount}"/>
			</p:column>
			
			<p:column headerText="Account" sortBy="#{vo.acctVO.code}-#{vo.acctVO.subCode}" filterBy="#{vo.acctVO.code}-#{vo.acctVO.subCode}" filterMatchMode="contains">
				<h:outputText value="#{vo.acctVO.code}" rendered="#{empty vo.acctVO.subCode}"/>
				<h:outputText value="#{vo.acctVO.code}-#{vo.acctVO.subCode}" rendered="#{not empty vo.acctVO.subCode}"/>
			</p:column>
			<p:column headerText="Description" sortBy="#{vo.acctVO.desc}, #{vo.acctVO.subDesc}" filterBy="#{vo.acctVO.desc}, #{vo.acctVO.subDesc}" filterMatchMode="contains">
				<h:outputText value="#{vo.acctVO.desc}" rendered="#{empty vo.acctVO.subDesc}"/>
				<h:outputText value="#{vo.acctVO.desc}, #{vo.acctVO.subDesc}" rendered="#{not empty vo.acctVO.subDesc}"/>
			</p:column>
		</p:dataTable>
		<h:panelGrid columns="1">
			<p:commandButton value="#{msg['common.button.label.cancel']}" onclick="varInvEOItemListDialog.hide()"/>
		</h:panelGrid>
	</h:form>
</p:dialog>

