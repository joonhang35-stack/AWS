<!--
	DIALOG - INVOICE LIST
-->
<p:dialog id="idCNInvoiceListDialog" header="Invoice List" widgetVar="varCNInvoiceListDialog" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
	<h:form id="idCNInvoiceListForm">
		<p:dataTable id="idCNInvoiceList" value="#{salesBean.cnInvoiceList}" var="vo" paginator="true" rows="20" 
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
			rowsPerPageTemplate="10, 20, 30" rowKey="#{vo.invPmntId}" selectionMode="single" filterEvent="enter">
			<p:ajax event="rowSelect" listener="#{salesBean.handleCNInvoiveSelect}" 
				update=":idAddInvoiceForm" 
				oncomplete="varCNInvoiceListDialog.hide()"/>
			
			<p:column headerText="Document No." sortBy="#{vo.code}" filterBy="#{vo.code}" filterMatchMode="contains">
				<h:outputText rendered="#{vo.docTypeCd eq 'I'}" value="#{salesBean.invPrefixVal} #{vo.code}" />
				<h:outputText rendered="#{vo.docTypeCd eq 'P'}" value="#{salesBean.psPrefixVal} #{vo.psNo}" />
			</p:column>
			<p:column headerText="Document Date" sortBy="#{vo.invoiceDt}" filterBy="#{salesBean.dateFormat(vo.invoiceDt, config['date.display.pattern'])})" filterMatchMode="contains">
				<h:outputText value="#{vo.invoiceDt}">
				<f:convertDateTime pattern="dd-MMM-yyyy" />
				</h:outputText> 
			</p:column>
			<p:column headerText="Customer No." sortBy="#{vo.custCd}" filterBy="#{vo.custCd}" filterMatchMode="contains">
				<h:outputText value="#{vo.custCd}" />
			</p:column>
			<p:column headerText="Customer Name" sortBy="#{vo.custName}" filterBy="#{vo.custName}" filterMatchMode="contains">
				<h:outputText value="#{vo.custName}" />
			</p:column>
			<p:column headerText="Sales Amount" sortBy="#{vo.amount}" filterBy="#{vo.amount}" filterMatchMode="contains">
				<h:outputText value="#{vo.amount}">
					<f:convertNumber pattern="#,##0.00"/>
				</h:outputText>
			</p:column>
			<p:column headerText="Reference No" sortBy="#{vo.refNo}" filterBy="#{vo.refNo}" filterMatchMode="contains">
				<h:outputText value="#{vo.refNo}" />
			</p:column>
			<p:column headerText="Payment" sortBy="#{vo.amtPaid}" filterBy="#{vo.amtPaid}" filterMatchMode="contains">
				<h:outputText value="#{vo.amtPaid}">
					<f:convertNumber pattern="#,##0.00"/>
				</h:outputText>
			</p:column>
		</p:dataTable>
		<h:panelGrid columns="1">
			<p:commandButton value="#{msg['common.button.label.cancel']}" onclick="varCNInvoiceListDialog.hide()"/>
		</h:panelGrid>
	</h:form>
</p:dialog>

<!--
	DIALOG - REASON FOR UPDATE/DELETE
-->
<p:dialog widgetVar="varReasonDialog" header="Reason" modal="true" resizable="false" dynamic="true" draggable="true" closable="false">
	<h:form id="idReasonDialog">
		<p:growl id="msg"/>
		<p:panelGrid>
			<p:row>
				<p:column><h:outputLabel for="idReason">Reason <span class="required">*</span></h:outputLabel></p:column>
				<p:column><p:inputTextarea label="Reason" id="idReason" value="#{salesBean.invoiceVO.reason}" rows="5" style="width:300px" required="true"/></p:column>
			</p:row>
		</p:panelGrid>
		<h:panelGrid columns="2" style="width:1px;">
			<!--p:commandButton value="#{msg['common.button.label.update']}" actionListener="#{salesBean.updateInvoice}" oncomplete="onValidationReason(xhr, status, args)" update="@form,:idInvListForm:idInvListTable"/-->
			<p:commandButton value="#{msg['common.button.label.update']}" actionListener="#{salesBean.updateInvoice}" oncomplete="onValidationReason(xhr, status, args)" update="@form,:idAddInvoiceForm"/>
			<p:commandButton value="#{msg['common.button.label.cancel']}" onclick="varReasonDialog.hide()" process="@this" update="@form" global="false">
				<pe:resetEditableValues for="idReasonDialog"/>
			</p:commandButton>
		</h:panelGrid>
	</h:form>
</p:dialog>

<p:dialog id="idGSTListDialog" widgetVar="varGSTListDialog" modal="true" resizable="false" dynamic="true" draggable="true" closable="true">
	<p:tabView >
   			<p:tab title="Input Tax" style="width:150px;">
			<p:dataTable id="idInputTaxCodeList" value="#{salesBean.inputTaxCodeVOList}" var="vo" rowKey="#{vo.id}" selectionMode="single">
				<p:ajax event="rowSelect" listener="#{salesBean.handleGSTSelect}" oncomplete="varGSTListDialog.hide()" update=":idAddInvoiceDetailsForm"/>
				<p:column headerText="No." width="25" style="text-align:right;">
					<h:outputText value="#{vo.seqNo}"/>
				</p:column>
				<p:column headerText="Code" width="50">
					<h:outputText value="#{vo.code}" />
				</p:column>
				<p:column headerText="Description" >
					<h:outputText value="#{vo.description}" />
				</p:column>
				<p:column headerText="Rate (%)" width="50" style="text-align:right;">
					<h:outputText value="#{vo.rate}"/>
				</p:column>
			</p:dataTable>
		</p:tab>
   		<p:tab title="Output Tax" style="width:150px;">
			<p:dataTable id="idOutputTaxCodeList" value="#{salesBean.outputTaxCodeVOList}" var="vo" rowKey="#{vo.id}" selectionMode="single">
				<p:ajax event="rowSelect" listener="#{salesBean.handleGSTSelect}" oncomplete="varGSTListDialog.hide()" update=":idAddInvoiceDetailsForm"/>
				<p:column headerText="No." width="25" style="text-align:right;">
					<h:outputText value="#{vo.seqNo}"/>
				</p:column>
				<p:column headerText="Code" width="50">
					<h:outputText value="#{vo.code}" />
				</p:column>
				<p:column headerText="Description" >
					<h:outputText value="#{vo.description}" />
				</p:column>
				<p:column headerText="Rate (%)" width="50" style="text-align:right;">
					<h:outputText value="#{vo.rate}"/>
				</p:column>
			</p:dataTable>
		</p:tab>
	</p:tabView>
</p:dialog>

