	</h:form>
</p:dialog>

		<!-- DIALOG - MULTIPLE E-INVOICE SUBMIT PREVIEW -->
		<p:dialog id="idMultipleEInvSubmitPreviewDialog" header="Preview"
			widgetVar="varMultipleEInvSubmitPreviewDialog" modal="true" resizable="false"
			dynamic="true" draggable="true" closable="true">
			<p:ajax event="close" update="idInvListForm" />
			<h:form id="idMultipleEInvSubmitPreviewForm">
				<ui:include src="multiple_e_invoice_submission_preview.xhtml" />
			</h:form>
		</p:dialog>

		<!-- DIALOG - MULTIPLE E-INVOICE SUBMIT RESPONSE -->
