	resizable="false" dynamic="true" draggable="true" closable="true">
	<h:form id="idPassangerListForm">
		<ui:include src="../../sales/common/passanger_list.xhtml" />
	</h:form>
</p:dialog> -->

<p:dialog id="idAddInvoiceDetailsDialog" header="Credit Note Details" widgetVar="varAddInvoiceDetailsDialog" modal="true"
	resizable="false" dynamic="true" draggable="true" closable="false">
	<h:form id="idAddInvoiceDetailsForm">
		<ui:include src="../../sales/common/add_invoice_details.xhtml"/>
	</h:form>
</p:dialog>

