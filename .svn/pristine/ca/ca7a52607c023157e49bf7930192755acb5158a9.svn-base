<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
				template="/WEB-INF/views/layouts/main.xhtml"
				xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

<ui:define name="content">

	<style>
		.badge-e-success {
			background-color: green;
		}
		
		.badge-e-fail {
			background-color: red;
		}
		
		.badge-e-success,
		.badge-e-fail {
			color: white;
		    padding: 1px 4px; /* Adjusted padding to make the badge smaller */
		    margin-left: 5px;
		    border-radius: 50%;
		    font-size: 0.75em; /* Adjusted font size to make the badge text smaller */
		    font-weight: bold;
		}
	
	</style>


<script type="text/javascript">
    function fncLoad() {
        document.getElementById('idInvListForm:idAddBtn').onclick();
    }
    
    function onValidationReason(xhr, status, args) {
		if (args.validationFailed) {
			varReasonDialog.show();
		} else {
			varReasonDialog.hide();
			//varAddInvoiceDialog.hide();
		}
	}
    
    document.addEventListener('DOMContentLoaded', function() {
        var filters = document.querySelectorAll('input.ui-column-filter');
        filters.forEach(function(filter) {
            filter.setAttribute('enterkeyhint', 'enter');
        });
        
        var input = document.getElementById('idInvListForm:idDepartureDateFr_input');
        if (input) input.setAttribute('autocomplete', 'off');
        
        input = document.getElementById('idInvListForm:idDepartureDateTo_input');
        if (input) input.setAttribute('autocomplete', 'off');
        
        input = document.getElementById('idInvListForm:idInvoiceDateFr_input');
        if (input) input.setAttribute('autocomplete', 'off');
        
        input = document.getElementById('idInvListForm:idInvoiceDateTo_input');
        if (input) input.setAttribute('autocomplete', 'off');
        
    });
</script>

<p:panel header="Credit Note Issuance" toggleable="true" toggleSpeed="500">
<h:body onload="#{salesBean.strOnLoad}">
	<h:form id="idInvListForm">
		<p:growl id="msg"/>
		<p:panelGrid style="margin-top:5px; width:1px">
			<p:row>
				<p:column>
					<p:commandButton id="idAddBtn" value="Add" actionListener="#{salesBean.initAddInvoice}" oncomplete="varAddInvoiceDialog.show()" immediate="true" update=":idAddInvoiceDialog"/>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px" />
				</p:column>
				<p:column styleClass="nowrap" rendered="#{salesBean.invPmntAuthVO.eInvoice}">
					<p:commandButton value="E-Invoice Submission" 
						actionListener="#{salesBean.enterEInvSubm}"
						update="@form"
						rendered="#{salesBean.invPmntAuthVO.eInvoice and not salesBean.isEInvSubm}">
					</p:commandButton>
					<!-- <p:commandButton value="Submit" 
						actionListener="#{salesBean.submitMultipleEInvoice}"
						update="@form :idMultipleEInvSubmitRespDialog"
						oncomplete="if (#{salesBean.isEInvSubm}) varMultipleEInvSubmitRespDialog.show()"
						rendered="#{salesBean.invPmntAuthVO.eInvoice and salesBean.isEInvSubm}">
					</p:commandButton> -->
					<p:commandButton value="Submit" 
						actionListener="#{salesBean.onSubmitMultipleEInvoice}"
						update=":idMultipleEInvSubmitPreviewDialog"
						oncomplete="varMultipleEInvSubmitPreviewDialog.show()"
						rendered="#{salesBean.invPmntAuthVO.eInvoice and salesBean.isEInvSubm}">
					</p:commandButton>
					<p:commandButton id="idExitBtn" icon="ui-icon-close" rendered="#{salesBean.isEInvSubm}"
						actionListener="#{salesBean.setIsEInvSubm(not salesBean.isEInvSubm)}"
						update="@form">
					</p:commandButton>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column>
				 	<p:calendar id="idInvoiceDateFr" label="CN Date From" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.fromDate}">
				 		<p:ajax event="dateSelect" listener="#{salesBean.handleCNDateChange}"
							oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idInvListTable :idInvListForm:msg"/>
				 	</p:calendar>
					<p:watermark for="idInvoiceDateFr" value="CN Date From" />
				</p:column>
				<p:column>
					<p:calendar id="idInvoiceDateTo" label="CN Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.toDate}">
				 		<p:ajax event="dateSelect" listener="#{salesBean.handleCNDateChange}"
							oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idInvListTable :idInvListForm:msg"/>
				 	</p:calendar>
					<p:watermark for="idInvoiceDateTo" value="CN Date To" />
				</p:column>
				<p:column>
				 	<p:calendar id="idDepartureDateFr" label="Departure Date From" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.departureDateFr}">
				 		<p:ajax event="dateSelect" listener="#{salesBean.handleCNDateChange}"
							oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idInvListTable :idInvListForm:msg"/>
				 	</p:calendar>
					<p:watermark for="idDepartureDateFr" value="Departure Date From" />
				</p:column>
				<p:column>
					<p:calendar id="idDepartureDateTo" label="Departure Date To" pattern="dd-MMM-yyyy" navigator="true" showButtonPanel="true" value="#{salesBean.departureDateTo}">
				 		<p:ajax event="dateSelect" listener="#{salesBean.handleCNDateChange}"
							oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idInvListTable :idInvListForm:msg"/>
				 	</p:calendar>
					<p:watermark for="idDepartureDateTo" value="Departure Date To" />
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column styleClass="nowrap">
					<h:outputText value="Payment Status" />
				</p:column>
				<p:column>
					<h:selectOneMenu id="idSelOrderSource" label="Payment Status"
						value="#{salesBean.paymentStatus}" effect="fade">
						<f:selectItem itemValue="" itemLabel="All" />
						<f:selectItem itemValue="IN" itemLabel="Invoiced" />
						<f:selectItem itemValue="DP" itemLabel="Deposit Paid" />
						<f:selectItem itemValue="FP" itemLabel="Full Payment" />
						<f:selectItem itemValue="VD" itemLabel="Void" />
						<f:selectItem itemValue="CC" itemLabel="Cancelled" />
						<!-- <f:selectItems value="#{zsg:referenceDataList('INV_STATUS')}"
							var="vo" itemValue="#{vo.code}" itemLabel="#{vo.value}" /> -->
						<p:ajax event="change"
							listener="#{salesBean.handlePaymentStatusSelect}"
							oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idInvListTable :idInvListForm:msg" />
					</h:selectOneMenu>
				</p:column>
				<p:column styleClass="nowrap">
					<h:outputText value="E-Invoice Status" />
				</p:column>
				<p:column>
					<h:selectOneMenu id="idEInvStatus" label="E-Invoice Status" value="#{salesBean.eInvoiceStatus}">
						<f:selectItem itemLabel="All" itemValue="" />
						<f:selectItems value="#{bterp:lookupItemList('e_inv_status')}"
							var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
						<p:ajax event="change"
							listener="#{salesBean.handleEInvStatusSelect}"
							oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idInvListTable :idInvListForm:msg" />
					</h:selectOneMenu>
				</p:column>
				<p:column>
					<p:separator style="width:2px;height:20px"/>
				</p:column>
				<p:column>
					<p:selectBooleanCheckbox value="#{salesBean.showSubmittedInvOnly}" itemLabel="Ready to Submit" style="width: 150px; display: flex; align-items: center;">
						<p:ajax event="change" listener="#{salesBean.loadCreditNoteDisplay}"
							oncomplete="varInvoiceListTable.clearFilters()" update=":idInvListForm:idInvListTable :idInvListForm:msg"/>
					</p:selectBooleanCheckbox>
				</p:column>
			</p:row>
		</p:panelGrid>
		
		<p:dataTable id="idInvListTable" widgetVar="varInvoiceListTable" value="#{salesBean.lazyDataModel}" var="vo" paginator="true" rows="20" 
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
			rowsPerPageTemplate="20, 30, 50, 100, 300, 500, 1000, 1500" filterEvent="enter" rowKey="#{vo.id}" lazy="true"
			selection="#{salesBean.selectedInvoiceList}">
			
			<!-- <p:ajax event="rowSelectCheckbox" update="idInvListTable"/>
			<p:ajax event="rowUnselectCheckbox" update="idInvListTable"/>
			<p:ajax event="toggleSelect" update="idInvListTable"/> -->
			<!-- <p:ajax event="filter" listener="#{salesBean.onFilter}" update="idInvListTable"/> -->
								
			<p:column selectionMode="multiple" style="width:16px;text-align:center" rendered="#{salesBean.isEInvSubm}" exportable="false"/>
			
			<p:column headerText="Edit" style="width:50px; text-align:center;">
				<p:commandButton icon="ui-icon-pencil"
					actionListener="#{salesBean.onInvoiceSelected(vo)}"
					oncomplete="varAddInvoiceDialog.show()" update=":idAddInvoiceDialog"/>
			</p:column>
					
			<p:column headerText="Cancel" style="width:50px; text-align:center;">
				<p:commandButton icon="ui-icon-close" actionListener="#{salesBean.onInvoiceSelected(vo)}" oncomplete="varDelInvDialog.show()" rendered="#{vo.statusCd eq 'BL' or vo.statusCd eq 'PD' or vo.statusCd eq 'IN' or vo.statusCd eq 'DP' or vo.statusCd eq 'FP'}"/>
			</p:column>
			
			<p:column headerText="Credit Note No." sortBy="#{vo.codeLong}" filterBy="#{vo.codeLong}" filterMatchMode="contains">
				<h:outputText value="#{salesBean.prefixValue} #{vo.codeLong}" />
			</p:column>
			
			<p:column headerText="Credit Note Date" sortBy="#{vo.invoiceDt}">
				<h:outputText value="#{vo.invoiceDt}">
					<f:convertDateTime pattern="dd-MMM-yyyy"/>  
				</h:outputText>
			</p:column>
			
			<p:column headerText="Tour Code" sortBy="#{vo.tourCd}" filterBy="#{vo.tourCd}" filterMatchMode="contains">
				<h:outputText value="#{vo.tourCd}"/>
			</p:column>
			
			<p:column headerText="Departure Date" sortBy="#{vo.departureDt}">
				<h:outputText value="#{vo.departureDt}">
					<f:convertDateTime pattern="dd-MMM-yyyy"/>  
				</h:outputText>
			</p:column>
			
			<p:column headerText="Document No." 
				sortBy="#{vo.cnInvNo}" 
				filterBy="#{vo.cnInvNo}" 
				filterMatchMode="contains">
				<h:outputText rendered="#{vo.cnInvNo ne null and vo.cnPsNo eq null}" value="#{salesBean.invPrefixVal} #{vo.cnInvNo}" />
				<h:outputText rendered="#{vo.cnInvNo ne null and vo.cnPsNo ne null}" value="#{salesBean.invPrefixVal} #{vo.cnInvNo} / #{salesBean.psPrefixVal} #{vo.cnPsNo}" />
				<h:outputText rendered="#{vo.cnInvNo eq null and vo.cnPsNo ne null}" value="#{salesBean.psPrefixVal} #{vo.cnPsNo}" />
				
				<h:outputText id="idDocEInvStatus" value="E" styleClass="badge-e-success" rendered="#{vo.readyToSubmitCN}"/>
			</p:column>
			
			<p:column headerText="Total Amt" sortBy="#{vo.amount}" filterBy="#{vo.amount}" styleClass="txt_center">
	        	<h:outputText value="#{vo.amount}">
	        		<f:convertNumber pattern="#,##0.00"/>
	        	</h:outputText>
	        </p:column>
	        
	        <p:column headerText="CN Amt" sortBy="#{vo.amtAftRefund}" filterBy="#{vo.amtAftRefund}" filterMatchMode="contains" styleClass="txt_center">
				<h:outputText value="#{vo.amtAftRefund}">
					<f:convertNumber pattern="#,##0.00"/>
				</h:outputText>
			</p:column>
	        
	        <p:column headerText="RN Amt" sortBy="#{vo.refundAmt}" filterBy="#{vo.refundAmt}" filterMatchMode="contains" styleClass="txt_center">
				<h:outputText value="#{vo.refundAmt}">
					<f:convertNumber pattern="#,##0.00"/>
				</h:outputText>
			</p:column>
			
			<p:column headerText="Refund Note No." sortBy="#{vo.rnNo}" filterBy="#{vo.rnNo}" filterMatchMode="contains">
				<h:outputText value="#{salesBean.prefixValueRN} #{vo.rnNo}" rendered="#{not empty vo.rnNo}" />
			</p:column>
			
			<p:column headerText="Status" style="width: 80px;" styleClass="txt_center" filterBy="#{vo.statusCd}">
				<h:outputText value="#{zsg:referenceDataValue('INV_STATUS', vo.statusCd)}" />
			</p:column>
			
			<p:column headerText="Customer Name" sortBy="#{vo.custName}" filterBy="#{vo.custName}" filterMatchMode="contains">
				<h:outputText value="#{bterp:lookupItemDesc('salutatn', vo.custSalutation)} #{vo.custName}" />
			</p:column>
			
			<p:column headerText="Customer No." sortBy="#{vo.custCdLong}" filterBy="#{vo.custCdLong}" filterMatchMode="contains">
				<h:outputText value="#{vo.custCdLong}" />
			</p:column>

			<p:column headerText="CN E-Invoice Status" sortBy="#{vo.eInvoiceStatus}" style="width: 80px;" styleClass="txt_center" filterBy="#{vo.eInvoiceStatus}">
				<h:outputText rendered="#{vo.amtAftRefund != 0}" value="#{vo.eInvoiceStatus}" />
				<h:outputText rendered="#{vo.amtAftRefund == 0}" value="-" />
			</p:column>
			
			<p:column headerText="RN E-Invoice Status" sortBy="#{vo.eInvoiceRnStatus}" style="width: 80px;" styleClass="txt_center" filterBy="#{vo.eInvoiceRnStatus}">
				<h:outputText rendered="#{vo.refundAmt != 0}" value="#{vo.eInvoiceRnStatus}" />
				<h:outputText rendered="#{vo.refundAmt == 0}" value="-" />
			</p:column>
		</p:dataTable>
		
		<h:panelGrid columns="2" style="margin-top:5px; width:1px">
			<p:commandButton value="Add" actionListener="#{salesBean.initAddInvoice}" oncomplete="varAddInvoiceDialog.show()" immediate="true" update=":idAddInvoiceDialog"/>
		</h:panelGrid>
	</h:form>
</h:body>
</p:panel>

<p:dialog id="idAddInvoiceDialog" header="Credit Note" widgetVar="varAddInvoiceDialog" modal="true" 
	resizable="false" dynamic="true" draggable="true" closable="false">
	<h:form id="idAddInvoiceForm"> 
		<ui:include src="../../sales/inv/add_creditnote.xhtml"/>
	</h:form>
</p:dialog>

<p:confirmDialog widgetVar="varDelInvDialog" message="Are you sure want to delete this record?">
	<h:form>
		<p:commandButton value="Yes" actionListener="#{salesBean.deleteInvoice}" update="@form,:idInvListForm" oncomplete="varDelInvDialog.hide();varInvoiceListTable.clearFilters();"/>
		<p:commandButton value="Cancel" oncomplete="varDelInvDialog.hide()"/>
	</h:form>
</p:confirmDialog>

<p:dialog id="idCustListDialog" header="Customer List" widgetVar="varCustListDialog" modal="true"
	resizable="false" dynamic="true" draggable="true" closable="true">
	<h:form id="idCustListForm">
		<ui:include src="../../sales/common/customer_list.xhtml" />
	</h:form>
</p:dialog>

