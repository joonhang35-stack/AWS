	public void init() throws BusinessException {
		try {
			initSearchParam();
			searchParamVO.setFromDate(new Date());
			searchParamVO.setToDate(searchParamVO.getFromDate());
			
			bankAcctViewList = bankAcctBO.getBankAcctList(getSessionInfoBean().getCompanyVO().getId());
			acctViewList = chartOfAcctBO.getAcctViewList(getSessionInfoBean().getCompanyVO().getId(), null);
			resetAcctTransViewForm();
			resetAcctTransForm();
			loadBankAdjust();
			resetForm();
			loadListingTableView();
			prefixValue = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_BANK_ADJM).getPrefixid();
			
			// GST Code
			setInputTaxCodeVOList(gstBO.getTaxCodeList(GSTType.INPUT));
			setOutputTaxCodeVOList(gstBO.getTaxCodeList(GSTType.OUTPUT));
			
		}catch (Throwable t) {
			errorResult(t);
		}
	}

	private void loadBankAdjust() throws BusinessException {
		try {
			resetFilteredObjList();
			if(bankAcctViewList.size()!=0) {
				List<UserRoleViewVO> userRoleList = securityBO.getUserRoleListByUser(this.getSessionInfoBean().getUserVO().getUuid());
				
				invPmntAuthVO = new InvPmntAuthVO();
				if (CollectionUtils.isNotEmpty(userRoleList)) {
					for (UserRoleViewVO userRoleVO : userRoleList) {
						if (userRoleVO.getRoleCode().equals(SalesConstant.BANK_ADJUST_DEL)) {
							invPmntAuthVO.setPmntDel(true);
						} else if (userRoleVO.getRoleCode().equalsIgnoreCase(SalesConstant.ACCT_MANAGER_ROLE)) {
							invPmntAuthVO.setAccountManager(true);
						}
					}
				}	
				
				lookupItemBTCD = paymentBO.getlookupItemBT("cash_deps");
				lookupItemBT = paymentBO.getlookupItemBT("cash_with");
				lookupItemCBT = paymentBO.getlookupItemCBT("gnrl_pymt");
				lookupItemGnDp = paymentBO.getlookupItemCBT("gnrl_deps");
				searchParamVO.setObj1(bankAcctViewList.get(0).getId().toString());
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}

	public void addBankAdjustment() throws BusinessException {
		try {
			// check financial closed / GST submitted
			checkFinGSTClosed(CommonConstant.ACTION_CD_ADD, null, cashBookVO.getDtTrans(), invPmntAuthVO.isAccountManager());
			if (CollectionUtils.isEmpty(cashBookVO.getAcctTransList())) throw new BusinessException(CommonErrConstant.ERR_ADJUST_ACCT_LIST_EMPTY);
			
			bankAcctSearchVO = paymentBO.getBankAcctSearchList(cashBookVO.getIdBank());
			acctVO = paymentBO.getAcctSearchList(bankAcctSearchVO.getIdAcct());
			cashBookVO.setAmountCalcViewVO(amtCalcViewVO);
			
			bankAdjustBO.addBankAdjust(cashBookVO,getSessionInfoBean().getCompanyVO().getId(),bankAcctSearchVO,lookupItemBT,lookupItemCBT,lookupItemGnDp,lookupItemBTCD,acctVO);
			
			resetForm();
			resetFilteredObjList();
			successResult();
			cashBookVO.setTemp(bankAcctSearchVO.getName());
			cashBookVO.setIdBank(bankAcctSearchVO.getId());

		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void onAddBankAdjustSelected() {
		try {
			resetAcctTransViewForm();
			
			Long bankId = Long.parseLong((String) searchParamVO.getObj1());
			if (!CommonConstant.SEARCH_ALL_BANKS.equals(searchParamVO.getObj1())) {
				for(BankAcctViewVO vo : bankAcctViewList) {
					if (vo.getId().equals(bankId)) {
						cashBookVO.setIdBank(vo.getId());
						cashBookVO.setTemp(vo.getName());
						break;
					}
				}
			}
			
			isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), cashBookVO.getDtTrans());
		}catch (Throwable t) {
			errorResult(t);
		}
	}

	/**
	 * 
	 * @param vo
	 * @throws BusinessException
	 */
	public void onBankAdjustSelected(CashBookVO vo) throws BusinessException{
		try {
			cashBookVO = cashBookBO.getCashBookById(vo.getId()); //cashBookVO;
			setOriObj(cashBookVO.clone());
			
			acctTransCashBookVO = depositBO.getAcctTransCashBook(cashBookVO.getSysNo(),cashBookVO.getTransTypeCd(),cashBookVO.getSysCode(),getSessionInfoBean().getCompanyVO().getId());
			cashBookVO.setAcctTransList(bankAdjustBO.getAcctTransViewTableList(cashBookVO.getSysNo(),cashBookVO.getTypeCd(),cashBookVO.getSysCode(),getSessionInfoBean().getCompanyVO().getId()));
			bankAcctSearchVO = paymentBO.getBankAcctSearchList(cashBookVO.getIdBank());
			
			if (cashBookVO.getTourDepId() != null) {
				TourDepartureVO tourDepVO = tourPkgBO.getTourDepById(cashBookVO.getTourDepId());
				if (tourDepVO != null) cashBookVO.setTourCd(tourDepVO.getCode());
			}
			
			for (AcctTransViewVO viewVO : cashBookVO.getAcctTransList()) {
				if (viewVO.getDebit() == 0.00) viewVO.setAmount(viewVO.getCredit());
				else viewVO.setAmount(viewVO.getDebit());
			}
			
			// gnrl_pymt or gnrl_deps
			cashBookVO.setAdjmType(cashBookVO.getTypeCd());
			
			isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), cashBookVO.getDtTrans());
			
			updateTaxableAmount(true);
			
			cashBookVO.setTemp(bankAcctSearchVO.getName());
			// Check Financial Period Closed
			getFinPeriodClosedStatus();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}

	public void deleteAdjustRecord() throws BusinessException{
		try {
			// Unable to delete this record due to financial period closed.
			if (cashBookVO.isDateInFinPeriodClosed()) throw new BusinessException(CommonErrConstant.ERR_ACCT_FIN_PERIOD_CLOSED_CANNOT_DEL);
						
			//deleteAdjustList();
			paymentBO.deletePaymentList(cashBookVO, getSessionInfoBean().getCompanyVO().getId());
			search();
			resetForm();
			resetAcctTransViewForm();
			//init();
			successResult();

		} catch (Throwable t){
			errorResult(t);
		}
	}
	
