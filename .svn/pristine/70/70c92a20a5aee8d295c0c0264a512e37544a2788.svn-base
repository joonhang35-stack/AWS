	public List<String> complete(String query) {  
        List<String> results = new ArrayList<String>();   
        try {
        	/*acctAutoCompleteList=paymentBO.getAcctList(getSessionInfoBean().getCompanyVO().getId(),query);
        	for (int i = 0; i <acctAutoCompleteList.size(); i++) {
	        	if(acctAutoCompleteList.get(i).getSubCode().isEmpty()) { 
	        		results.add(acctAutoCompleteList.get(i).getCode());
	        	} else {
	        		results.add(acctAutoCompleteList.get(i).getCode() + "-" + acctAutoCompleteList.get(i).getSubCode() );  
	        	}
        	}*/
        	
        	String tempStr;
        	for (int i = 0 ; i < acctViewList.size() ; i++) {
        		tempStr = acctViewList.get(i).getCode() + ((StringUtils.isEmpty(acctViewList.get(i).getSubCode())) ? "" : "-" + acctViewList.get(i).getSubCode());
        		if (tempStr.startsWith(query)) {
        			results.add(tempStr);
        		}
        	}
        	
        } catch(Exception e){
        	e.printStackTrace() ;
        }
        return results;  
    }
	
	public void changeDesc() throws BusinessException{
		try{
			for (AcctViewVO vo : acctViewList) {
				if (acctTransViewVO.getCode().equals(vo.getCode())) {
					acctTransViewVO.setDesc(vo.getDesc());
					acctTransViewVO.setAcctViewVO(vo);
					acctTransViewVO.setAcctId(vo.getId());
					acctTransViewVO.setTaxCode(vo.getTaxCode());
					acctTransViewVO.setTaxRate(vo.getTaxRate());
					break;
					
				} else if (acctTransViewVO.getCode().equalsIgnoreCase(vo.getCode() + "-" + vo.getSubCode())) {
					acctTransViewVO.setDesc(vo.getDesc() + "," + vo.getSubDesc());
					acctTransViewVO.setAcctViewVO(vo);
					acctTransViewVO.setAcctId(vo.getId());
					acctTransViewVO.setTaxCode(vo.getTaxCode());
					acctTransViewVO.setTaxRate(vo.getTaxRate());
					break;
				}
			}
			
			// populate GST code and rate]
			handleTaxCodeSelection(acctTransViewVO.getTaxCode(), acctTransViewVO.getTaxRate() == null ? null : (double) acctTransViewVO.getTaxRate());
			
		} catch(Throwable t) {
			errorResult(t);
		}
	}
	
	public void changeDescCredit() throws BusinessException{
		try{
			for(AcctViewVO vo:acctViewList) {
				if(acctTransViewVO.getTempDeposit().toString().equalsIgnoreCase(vo.getCode().toString())) {
					acctTransViewVO.setDepositDesc(vo.getDesc());
					if(vo.getSubCode().isEmpty()) {
						acctTransViewVO.setAcctViewVO(vo);
						acctTransViewVO.setAcctDepositId(vo.getId());
					}
				} else if(acctTransViewVO.getTempDeposit().toString().equalsIgnoreCase(vo.getCode().toString()+"-"+vo.getSubCode().toString())) {
					if(vo.getSubDesc().toString().isEmpty()) {
						acctTransViewVO.setDepositDesc(vo.getDesc());
						acctTransViewVO.setAcctViewVO(vo);
						acctTransViewVO.setAcctDepositId(vo.getId());
					} else {	
						acctTransViewVO.setDepositDesc(vo.getDesc()+","+vo.getSubDesc());
						acctTransViewVO.setAcctViewVO(vo);
						acctTransViewVO.setAcctDepositId(vo.getId());
					}	
				}
			}
		}catch(Throwable t){
			errorResult(t);
		}
	}
	
	public void changeDescDebit() throws BusinessException{
		try{
			for(AcctViewVO vo:acctViewList) {
				if(acctTransViewVO.getTempPayment().toString().equalsIgnoreCase(vo.getCode().toString())) {
					acctTransViewVO.setPaymentDesc(vo.getDesc());
					if(vo.getSubCode().isEmpty()) {
						acctTransViewVO.setAcctViewVO(vo);
						acctTransViewVO.setAcctPaymentId(vo.getId());
					}
				} else if(acctTransViewVO.getTempPayment().toString().equalsIgnoreCase(vo.getCode().toString()+"-"+vo.getSubCode().toString())) {
					if(vo.getSubDesc().toString().isEmpty()) {
						acctTransViewVO.setPaymentDesc(vo.getDesc());
						acctTransViewVO.setAcctViewVO(vo);
						acctTransViewVO.setAcctPaymentId(vo.getId());
					} else {	
						acctTransViewVO.setPaymentDesc(vo.getDesc()+","+vo.getSubDesc());
						acctTransViewVO.setAcctViewVO(vo);
						acctTransViewVO.setAcctPaymentId(vo.getId());
					}	
				}
			}
		}catch(Throwable t){
			errorResult(t);
		}
	}
	
	public void handleAcctSelect(SelectEvent event) {
		try {
			AcctVO acctVO = (AcctVO) event.getObject();
			String codeView = "";
			String code = acctVO.getCode();
			String desc = acctVO.getDesc();
			
			if (StringUtils.isNotEmpty(acctVO.getSubCode())) {
				code += "-" + acctVO.getSubCode();
				desc += "-" + acctVO.getSubDesc();
			}
			
			acctTransViewVO.setCode(code);
			acctTransViewVO.setDesc(desc);
			
			handleTaxCodeSelection(acctVO.getTaxCode(), acctVO.getTaxRate() == null ? null : (double) acctVO.getTaxRate());
			
			for (AcctViewVO vo : acctViewList) {
				codeView = vo.getCode();
				if (StringUtils.isNotEmpty(vo.getSubCode())) codeView += "-" + vo.getSubCode();
				
				if (code.equals(codeView)) {
					acctViewVO = vo;
					break;
				}
			}
			
			acctTransViewVO.setAcctViewVO(acctViewVO);
			acctTransViewVO.setAcctId(acctViewVO.getId());
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	private void handleTaxCodeSelection(String taxCode, Double taxRate) throws BusinessException {

		if(getSessionInfoBean().getCompanyVO().getIdAcctGST() != null && taxCode != null) {
			if(isGSTPeriod) {

				if(taxCode != null && taxRate == null) {
					//acctTransViewVO = (AcctTransViewVO) GSTHelper.getInstance().updateAcctTrans(acctTransViewVO, taxCode);
					TaxCodeVO taxCodeVO = gstBO.getTaxCode(taxCode);
					acctTransViewVO.setTaxCode(taxCodeVO.getCode());
					acctTransViewVO.setTaxRate(taxCodeVO.getRate());
					
				} else {
					acctTransViewVO.setTaxCode(taxCode);
					acctTransViewVO.setTaxRate(taxRate.floatValue());
				}
				
				//This handling to ensure the amount input by user is the actual amount without tax
				if(acctTransViewVO.getTaxRate() > 0.00)
					acctTransViewVO = (AcctTransViewVO) AccountHelper.calcAmountBaseOnTotalTaxableAmount(acctTransViewVO);
				else
					acctTransViewVO = (AcctTransViewVO) AccountHelper.calcTaxableAmount(acctTransViewVO, false, 0, 0);
				
			}
		} else {
			acctTransViewVO.setTaxCode(null);
			acctTransViewVO.setTaxRate(null);
			
			acctTransViewVO = (AcctTransViewVO) AccountHelper.calcTaxableAmount(acctTransViewVO, false, 0, 0);
		}
	}
	
	public void handleGSTSelect(SelectEvent event) {
		try {
			TaxCodeVO taxCodeVO = (TaxCodeVO) event.getObject();
			handleTaxCodeSelection(taxCodeVO.getCode(), (double) taxCodeVO.getRate());
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleTaxCodeClear() {
		try {
			handleTaxCodeSelection(null, null);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleDateChange(DateSelectEvent event) {
		try {
			isGSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), cashBookVO.getDtTrans());
			
			if(!isGSTPeriod) {
				//Reset all account trans with null taxCode
				for (int i = 0 ; i < cashBookVO.getAcctTransList().size() ; i++) {
					cashBookVO.getAcctTransList().get(i).setTaxCode(null);
					cashBookVO.getAcctTransList().get(i).setTaxRate(null);
				}
			}
			updateTaxableAmount(true);
			
		}  catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/*private void updateTaxableAmount() throws BusinessException {
		amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(amtCalcViewVO, true, cashBookVO.getAcctTransList(), null, false);
	}*/
	
	private void updateTaxableAmount(boolean isCalGLItems) throws BusinessException {
		if (isCalGLItems) calculateGLItemsAmount(cashBookVO.getAcctTransList());
		
		amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(amtCalcViewVO, false, cashBookVO.getAcctTransList(), null, false);
	}
	
	public void handleAmountChange() {
		try {
			acctTransViewVO = (AcctTransViewVO) AccountHelper.calcTaxableAmount(acctTransViewVO, false, 0, 0);
			//updateTaxableAmount();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleGSTAmtChange() {
		try {
			BigDecimal amount = new BigDecimal(String.valueOf(acctTransViewVO.getAmount()));
			BigDecimal taxAmount = new BigDecimal(acctTransViewVO.getTaxAmount().toString());
			
			acctTransViewVO.setAmountIncludeTax(amount.add(taxAmount).doubleValue());
			amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(amtCalcViewVO, false, cashBookVO.getAcctTransList(), null, false);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	
	public void handleAmountIncludeTaxChange() {
		try {
			acctTransViewVO = (AcctTransViewVO) AccountHelper.calcAmountBaseOnTotalTaxableAmount(acctTransViewVO);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	private void calculateGLItemsAmount(List<AcctTransViewVO> list) throws BusinessException {
		for (AcctTransVO vo : list) {
			vo.setTaxAmount(vo.getAmount() < 0 ? -vo.getTaxAmount() : vo.getTaxAmount());
			
			BigDecimal amount = new BigDecimal(String.valueOf(vo.getAmount()));
			BigDecimal taxAmount = new BigDecimal(vo.getTaxAmount().toString());
			
			vo.setAmountIncludeTax(amount.add(taxAmount).doubleValue());
		}
	}
	
