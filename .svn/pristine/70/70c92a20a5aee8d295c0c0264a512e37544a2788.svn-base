	public void handleAcctSelectDebit(SelectEvent event) throws BusinessException {
		try {
			AcctViewVO acctViewVO = (AcctViewVO) event.getObject();
			if (StringUtils.isEmpty(acctViewVO.getSubCode())) {
				acctTransViewVO.setTempPayment(acctViewVO.getCode());
			} else {	
				acctTransViewVO.setTempPayment(acctViewVO.getCode() + "-" + acctViewVO.getSubCode());
			}
			if (StringUtils.isEmpty(acctViewVO.getSubDesc())) {
				
				acctTransViewVO.setPaymentDesc(acctViewVO.getDesc());
			} else {
				acctTransViewVO.setPaymentDesc(acctViewVO.getDesc()+","+acctViewVO.getSubDesc());
			}
			acctTransViewVO.setAcctViewVO(acctViewVO);
			acctTransViewVO.setAcctPaymentId(acctTransViewVO.getAcctViewVO().getId());

		} catch (Throwable t) {
			errorResult(t);
		}
	}

	public void handleAcctSelectCredit(SelectEvent event) throws BusinessException{
		try {
			AcctViewVO acctViewVO = (AcctViewVO) event.getObject();
			if (StringUtils.isEmpty(acctViewVO.getSubCode())) {
				acctTransViewVO.setTempDeposit(acctViewVO.getCode());
			} else {	
				acctTransViewVO.setTempDeposit(acctViewVO.getCode() + "-" + acctViewVO.getSubCode());
			}
			if (StringUtils.isEmpty(acctViewVO.getSubDesc())) {
				acctTransViewVO.setDepositDesc(acctViewVO.getDesc());
			} else {
				acctTransViewVO.setDepositDesc(acctViewVO.getDesc()+","+acctViewVO.getSubDesc());
			}
			acctTransViewVO.setAcctViewVO(acctViewVO);
			acctTransViewVO.setAcctDepositId(acctTransViewVO.getAcctViewVO().getId());
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}


