	/**
	 * Add invoice
	 */
	public void addInvoice() {
		try {
			trackingLogUtils.startLogs();
			
			invoiceItemAmountChecking(invoiceVO.getInvoiceItemList());
			
			// check financial closed / GST submitted
			checkFinGSTClosed(CommonConstant.ACTION_CD_ADD, null, invoiceVO.getInvoiceDt(), invPmntAuthVO.isAccountManager());
			
			fromBooking = false;
			
			//if (invoiceVO.getEoRefId() == 0) invoiceVO.setEoRefId(null); //prevent is 0
			if (invoiceVO.getBookingId() != null && invoiceVO.getBookingId() == 0) invoiceVO.setBookingId(null);

			if (custDetailsVO.getContPersonName() == null) {
				throw new BusinessException(CommonErrConstant.ERR_INV_CUST_REQUIRED);
			} else if (invoiceVO.getInvoiceItemList().size() == 0) {
				throw new BusinessException(CommonErrConstant.ERR_INV_ITEM_REQUIRED, null, new String[]{docTypeDesc});
			} else if (invoiceVO.getBookingId() != null && invoiceVO.getBookingId() != 0 && invoiceBO.getBookingInvExist(invoiceVO.getBookingId())) {
				throw new BusinessException(CommonErrConstant.ERR_INV_BOOKING_NO_USED);
			} else if (invoiceVO.getBookingId() != null && (invoiceVO.getInvoicePaxList().size() > bookingBO.getBooking(invoiceVO.getBookingId()).getQuantity())) {
				throw new BusinessException(CommonErrConstant.ERR_INV_PAX_OVER);
			} else {
				// if there is credit note
				// set credit note default value
				setCreditNote();
				
				if (invoiceVO.getNoteItemsList() != null && !invoiceVO.getNoteItemsList().isEmpty()) {
				    String rawString = String.join(",", invoiceVO.getNoteItemsList());
				    invoiceVO.setNoteItems(rawString);
				} else { // if the note item list is empty then set note items string empty
					invoiceVO.setNoteItems(""); 
				}
				
				for (InvoicePaxVO invoicePaxVO : invoiceVO.getInvoicePaxList()) {
					if (invoicePaxVO.getRoomPairingNo() == null) {
						invoicePaxVO.setRoomPairingNo(0);
					}
				} 
				
				// check if invoice entitle to be consolidated
				invoiceVO.setIsConsolEInv(EInvoiceUtils.isConsolEInv(invoiceVO, invoiceAndExchangeOrderBO));
				
				// calTtlAmt();
				if (invoiceVO.getAmount() < 0) {
				    throw new BusinessException(CommonErrConstant.ERR_AMOUNT_NEGATIVE);
				}
				invoiceBO.insertInvoice(invoiceVO, invoiceVO.getTourDepId());
				
				fileUploadUtils.deleteAllFiles();
				processAttachmentUploadFile();
				fileUploadUtils.setDelList(new ArrayList<String>());
				fileUploadUtils.setDelTmpList(new ArrayList<String>());
				isTmpFile = false;
				
				try {
					invoiceBO.updInvCd(invoiceVO);
				} catch (Throwable t) {
					t.printStackTrace();
					errorResult(t);
				}
				
				// insert invoice history
				invoiceBO.insertInvoiceHistory(invoiceVO.getId(), CommonConstant.ACTION_CD_ADD, "");
				
				onInvoiceSelected(invoiceVO);
				
				successResult();
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("addInvoice");
		}
	}
	
	/**
	 * Update invoice
	 */
	public void updateInvoice() {
		updateInvoice(false, false);
	}

	/**
	 * Update invoice
	 */
	public void updateInvoice(Boolean isUpdatePmntOnly, Boolean isUpdateAccCodeOnly) {
		try {
			if (isUpdatePmntOnly && isUpdateAccCodeOnly) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr("isUpdatePmntOnly and isUpdateAccCodeOnly cannot be true at the same time!"));
			} else if (isUpdateAccCodeOnly) {
				invoiceVO = updateInvoiceItemAccCode(invoiceVO);
			}
			
			trackingLogUtils.startLogs();
			
			invoiceItemAmountChecking(invoiceVO.getInvoiceItemList());
			
			InvoiceVO oriVO = (InvoiceVO) getOriObj();
			checkFinGSTClosed(CommonConstant.ACTION_CD_UPD, oriVO.getInvoiceDt(), invoiceVO.getInvoiceDt(), invPmntAuthVO.isAccountManager());
			
			fromBooking = false;
			
			//if (invoiceVO.getEoRefId() == 0) invoiceVO.setEoRefId(null); //prevent is 0
			if (invoiceVO.getBookingId() != null && invoiceVO.getBookingId() == 0) invoiceVO.setBookingId(null);

			//String invStatusCd = invoiceBO.getInvoiceStatus(invoiceVO.getId());
			if (invoiceVO.getStatusCd().equals(CommonConstant.STATUS_CD_VOID) || invoiceVO.getStatusCd().equals(CommonConstant.STATUS_CD_CANCELLED)) {
				throw new BusinessException(CommonErrConstant.ERR_INV_VOIDED);
			} else if (custDetailsVO.getContPersonName() == null) {
				throw new BusinessException(CommonErrConstant.ERR_INV_CUST_REQUIRED);
			} else if (invoiceVO.getInvoiceItemList().size() == 0) {
				throw new BusinessException(CommonErrConstant.ERR_INV_ITEM_REQUIRED, null, new String[]{docTypeDesc});
			} else if (invoiceVO.getBookingId() != null && (invoiceVO.getInvoicePaxList().size() > bookingBO.getBooking(invoiceVO.getBookingId()).getQuantity())) {
				throw new BusinessException(CommonErrConstant.ERR_INV_PAX_OVER);
			} else if (invoiceVO.isDateInFinPeriodClosed() != getFinPeriodClosedStatus()) {
				throw new BusinessException(CommonErrConstant.ERR_ACCT_FIN_PERIOD_CLOSED_CANNOT_UPD);
			} else {
				InvoiceVO currentInvVO = invoiceBO.getInvoiceById(invoiceVO.getId());
				if (currentInvVO.getVersion() > invoiceVO.getVersion()) throw new BusinessException(CommonErrConstant.ERR_INV_NOT_LATEST_VERSION);
				
				if (invoiceVO.getNoteItemsList() != null && !invoiceVO.getNoteItemsList().isEmpty()) {
				    String rawString = String.join(",", invoiceVO.getNoteItemsList());
				    rawString = rawString.replaceAll("\\s", "");
				    invoiceVO.setNoteItems(rawString);
				} else { // if the note item list is empty then set note items string empty
					invoiceVO.setNoteItems(""); 
				}
				
				checkInvoiceItemLock(invoiceVO.getBookingId());
				checkSalesPersonLock();
				
				for (InvoicePaxVO invoicePaxVO : invoiceVO.getInvoicePaxList()) {
					if (invoicePaxVO.getRoomPairingNo() == null) {
						invoicePaxVO.setRoomPairingNo(0);
					}
				} 
				
				// check if invoice entitle to be consolidated
				invoiceVO.setIsConsolEInv(EInvoiceUtils.isConsolEInv(invoiceVO, invoiceAndExchangeOrderBO));
				
				// calTtlAmt();
				trackingLogUtils.endLogs("updateInvoice 1");
				if (isUpdatePmntOnly) {
					invoiceVO.setInvoiceItemList(invoiceBO.getInvItemList(invoiceVO));
					calTtlAmt();
					// update invoice payments only
					invoiceBO.updateInvoicePayments(invoiceVO, invoiceVO.getTourDepId(), true);
				} else if (isUpdateAccCodeOnly) {
					invoiceBO.updateInvoice(invoiceVO, invoiceVO.getTourDepId(), true);
				} else {
					invoiceBO.updateInvoice(invoiceVO, invoiceVO.getTourDepId(), true);
				}
				trackingLogUtils.endLogs("updateInvoice 2");
				
				
				fileUploadUtils.deleteAllFiles();
				processAttachmentUploadFile();
				fileUploadUtils.setDelList(new ArrayList<String>());
				fileUploadUtils.setDelTmpList(new ArrayList<String>());
				isTmpFile = false;
				
				// update cash book invoices
				trackingLogUtils.endLogs("updateInvoice3");
				invoiceBO.updateCashBookInvoices(invoiceVO);
				trackingLogUtils.endLogs("updateInvoice4");
				
				if (isUpdatePmntOnly)	invoiceVO.setReason("[PAYMENT] " + invoiceVO.getReason());
				
				// for audit trial history purpose
				invoiceBO.insertInvoiceHistory(invoiceVO.getId(), CommonConstant.ACTION_CD_UPD, invoiceVO.getReason());
				onInvoiceSelected(invoiceVO);
				resetReasonForm();
				successResult();
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("updateInvoice");
		}
	}
	
	public InvoiceVO updateInvoiceItemAccCode(InvoiceVO invoiceVO) throws BusinessException {
		InvoiceVO currentInvoiceVO = invoiceBO.getInvoiceById(invoiceVO.getId());
		currentInvoiceVO = invoiceBO.getInvoiceDetails(currentInvoiceVO);
		
		if (CollectionUtils.isNotEmpty(invoiceVO.getInvoiceItemList())
				&& CollectionUtils.isNotEmpty(currentInvoiceVO.getInvoiceItemList())) {
			for (InvoiceItemVO itemVO : invoiceVO.getInvoiceItemList()) {
				for (InvoiceItemVO currentItemVO : currentInvoiceVO.getInvoiceItemList()) {
					if (currentItemVO.getId().equals(itemVO.getId())) {
						if (!currentItemVO.getAcctId().equals(itemVO.getId())) {
							System.out.println("CYY itemVO.getId(): " + itemVO.getId());
							System.out.println("CYY itemVO.getDesc(): " + itemVO.getDesc());
							System.out.println("CYY itemVO.getAcctId(): " + itemVO.getAcctId());
							System.out.println();
							
							System.out.println("CYY currentItemVO.getId(): " + currentItemVO.getId());
							System.out.println("CYY currentItemVO.getDesc(): " + currentItemVO.getDesc());
							System.out.println("CYY currentItemVO.getAcctId(): " + currentItemVO.getAcctId());
							System.out.println();
							
							currentItemVO.setAcctId(itemVO.getAcctId());
						}
					}
				}
			}
		}
		
		// set opened invoice version to avoid version issue
		currentInvoiceVO.setVersion(invoiceVO.getVersion());
		
		// reason needed also
		currentInvoiceVO.setReason("[ACCOUNT CODE] " + invoiceVO.getReason());
		
		return currentInvoiceVO;
	}
	
	public void updateInvoiceInternalRemarkOnly() {
		try {
			
			String intRemark = invoiceVO.getInternalRemarks();
			String reason = invoiceVO.getReason();
			
			onInvoiceSelected(invoiceVO);
			
			invoiceVO.setInternalRemarks(intRemark);
			invoiceVO.setReason("[REMARK] " + reason);
			
			updateInvoice(false, false);
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	/**
	 * Single submission
	 */
	public void submitEInvoice() {
		try {
			
			// reset err
			invoiceVO.seteInvoiceErr(null);
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO, invoiceBO, invoiceAndExchangeOrderBO, regionBO, malaysiaStateBO, chartOfAcctBO, corporateProfileBO);
			JSONObject submitResponse = eInvoiceBO.submitInvoice(invoiceVO);
			eInvoiceUtils.processSubmitResponse(submitResponse, invoiceVO);
			
			successResult();
			
		} catch (Throwable t) {
			
			t.printStackTrace();
			
			// display err on interface, instead as err popup
			BusinessException be = (BusinessException) t;
			if (t instanceof BusinessException) {
				String message = messageSource.getMessage(be.getErrorCode(), be.getParameters(), "System error", getLocale());
				invoiceVO.seteInvoiceErr(message);
			}
			
			errorResult(t);
		}
	}
	
	public void onCancelEInvoiceAPI() {
			
