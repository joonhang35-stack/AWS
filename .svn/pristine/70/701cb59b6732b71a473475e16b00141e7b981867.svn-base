			if (StringUtils.isBlank(invoicePaxVO.getCustDetailsVO().getAddressVO().getCity())) {
				invoicePaxVO.getCustDetailsVO().getAddressVO().setCity(EInvoiceConstant.NOT_APPLICABLE);
