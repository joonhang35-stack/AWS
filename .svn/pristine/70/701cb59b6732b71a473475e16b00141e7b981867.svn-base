	public void handleAdminChargesPercentageChange() {
		invoiceEmailPaymentVO.setAdminCharges(invoiceEmailPaymentVO.getPaymentAmt().multiply(invoiceEmailPaymentVO.getAdminChargesPercentage()).divide(new BigDecimal(100), 2, RoundingMode.HALF_UP));
		calculateTotalPaymentAmt();
	}
	
	public void calculateTotalPaymentAmt() {
		invoiceEmailPaymentVO.setTotalPaymentAmt(invoiceEmailPaymentVO.getPaymentAmt().add(invoiceEmailPaymentVO.getAdminCharges()));
	}
	
	public void processEmailPayment() {
		try {
			InvoiceVO invoiceTempVO = invoiceBO.getInvoiceById(invoiceEmailPaymentVO.getIdInvoice());
			
			if (StringUtils.isEmpty(invoiceTempVO.getSubjLine())) {
				throw new BusinessException(CommonErrConstant.ERR_SUBJ_LINE_IS_REQUIRED);
			}
			
			invoiceEmailPaymentBO.updateInvoiceEmailPayment(invoiceEmailPaymentVO, getSessionInfo().getUserVO());
			successResult();
		} catch (BusinessException e) {
			errorResult(e);
		}
	}
	
	public void processEmailInvoice() throws JRException, IOException {
		try {
			//CustomerVO customerVO = customerBO.getCustomer(invoiceVO.getCustomerId());
			//String email = customerVO.getPersonVO().getEmail();
			
			InvoiceVO tempVO = SerializationUtils.clone(invoiceVO);
			InvoiceVO invVO = invoiceBO.getInvoiceDetails(tempVO);
			
			CompanyVO companyVO = corporateProfileBO.getCompanyDetails(invVO.getCompanyId());
			
			List <InvoiceVO> invList = new ArrayList<InvoiceVO>();

			calTtlAmt(invVO, true);
			
//			if (StringUtils.isNotEmpty(invVO.getCustDetailsVO().getNickName())) {
//				invVO.getCustDetailsVO().setContPersonName(invVO.getCustDetailsVO().getContPersonName() + " (" + invVO.getCustDetailsVO().getNickName() + ")");
//			}
			invVO.getCustDetailsVO().setContPersonName(FunctionUtils.getContPersonName(invVO.getCustDetailsVO().getContPersonName(),
					invVO.getCustDetailsVO().getNickName(), invVO.getCustDetailsVO().getTitle(), invVO.getCustDetailsVO().getSalutation()));
			
			if (invVO.getCustDetailsVO().getCustType().equals("C")) {
				if (invVO.getCustDetailsVO().getCorAddressVO() != null) {
					invVO.getCustDetailsVO().getCorAddressVO().setCountryName(getCountryName(invVO.getCustDetailsVO().getCorAddressVO().getCountryId()));
				}
			} else {
				if (invVO.getCustDetailsVO().getAddressVO() != null) {
					invVO.getCustDetailsVO().getAddressVO().setCountryName(getCountryName(invVO.getCustDetailsVO().getAddressVO().getCountryId()));
				}
			}
			
			List<EmployeeViewVO> fullEmployeeList = invoiceBO.getFullEmployeeViewList(this.getSessionInfoBean().getCompanyVO().getId());
			
			for (EmployeeViewVO vo : fullEmployeeList) {
				if (vo.getId().longValue() == invVO.getSalerId().longValue()) {
					invVO.setSalerName(vo.getUserVO().getName());
				}
			}
			
			invVO.setBalanceWord(EnglishNumberToWords.withCents(invVO.getBalance().doubleValue()));
			
			if (invVO.getTourDepId() != null) {
				TourDepartureVO tourDpVO = tourPackageBO.getTourDepById(invoiceVO.getTourDepId());
				
				// if tour departure remark is empty then get tour package CMS remarks
				if (StringUtils.isEmpty(tourDpVO.getInvRemarks())) {
					List<TourPackageDailyItineraryVO> tourPkgDIList = tourPackageBO.getTourPkgDailyItineraryList(tourDpVO.getIdTourPkg());
					if (CollectionUtils.isNotEmpty(tourPkgDIList)) {
						for (TourPackageDailyItineraryVO diVO : tourPkgDIList) {
							if (StringUtils.isNotEmpty(diVO.getGenRemarks())) {
								invVO.setTourDpInvRmk(diVO.getGenRemarks());
								break;
							}
						}
					}
				} else invVO.setTourDpInvRmk(tourDpVO.getInvRemarks());
			}

			// Set contact
			String contact = "";
			if (invVO.getCustDetailsVO().getCustType().equals("P")) {
				if (CollectionUtils.isNotEmpty(invVO.getCustDetailsVO().getContactList())) {
					for (PersonContactVO vo : invVO.getCustDetailsVO().getContactList()) {
						contact += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, vo.getTypeCd()) + ": " + vo.getNumber();
						if (StringUtils.isNotBlank(vo.getAttention())) contact += "\t" + "Attn: " + vo.getAttention();
						contact += "\n";
					}
					invVO.getCustDetailsVO().setContact(contact);
				}
			} else {
				if (CollectionUtils.isNotEmpty(invVO.getCustDetailsVO().getCorContactList())) {
					for (CorContactVO vo : invVO.getCustDetailsVO().getCorContactList()) {
						contact += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, vo.getContactType()) + ": " + vo.getContactNo();
						if (StringUtils.isNotBlank(vo.getAttention())) contact += "\t" + "Attn: " + vo.getAttention();
						contact += "\n";
					}
					invVO.getCustDetailsVO().setContact(contact);
				}
			}
			
			// Sorting Tax Code
			invVO.setInvoiceItemTaxList(new ArrayList<InvoiceItemVO>());
			
			for (InvoiceItemVO vo : invVO.getInvoiceItemList()) {
				if (vo.getTaxCode() == null) {
					vo.setTaxCode("");
				}
				
				// Condition for show invoice item desc
				if (CommonConstant.LOOKUP_ITM_INV_CAT_TOUR.equals(invVO.getCatCd())) {
					if (StringUtils.isNotEmpty(vo.getSubDesc())) 
						vo.setDesc(vo.getDesc() + " - " + vo.getSubDesc());
				} else {
					if (StringUtils.isNotEmpty(vo.getSubDesc()))
						vo.setDesc(vo.getSubDesc());
					else
						vo.setDesc(vo.getDesc());
				}
				
				invVO.getInvoiceItemTaxList().add(vo);
			}
			
			if (invVO.getInvoiceItemTaxList().size() > 0) {
				Collections.sort(invVO.getInvoiceItemTaxList(), new Comparator<InvoiceItemVO>() {
					@Override
					public int compare(final InvoiceItemVO obj1, final InvoiceItemVO obj2) {
						return obj1.getTaxCode().compareTo(obj2.getTaxCode());
					}
				});
			}
			
			/***
			 * Exclude the deposit account amount -START-
			 */
			List<String> acctList = new ArrayList<>();
			AppSettingVO appSettingVO = appSettingBO.getAppSettingByCode(ConstantAppSetting.MAINT_POS_CONFIG_GL_ACCT_TO_EXCLUDE);
			
			if (StringUtils.isNotBlank(appSettingVO.getValue())) {
				List<String> strAcctList = Arrays.asList(appSettingVO.getValue().split(","));
				
				for (String acctExclude : strAcctList)
					acctList.add(acctExclude);
				
				List<InvoiceItemVO> tempItemVOList = new ArrayList<>();
				List<InvoiceItemVO> tempExcludeItemVOList = new ArrayList<>();
				for (InvoiceItemVO vo : invVO.getInvoiceItemList()) {
					// Check Account was deposit payment
					boolean accountToExcludeMatch = false;
					
					for (String idAcct : acctList) {
						if (vo.getAcctId().equals(Long.valueOf(idAcct))) {
							accountToExcludeMatch = true;
							break;
						}
					}
					
					if (!accountToExcludeMatch) tempItemVOList.add(vo);
					else tempExcludeItemVOList.add(vo);
				}
				
				// Calculate again the total amount
				if (CollectionUtils.isNotEmpty(tempExcludeItemVOList)) {
					invVO.setInvoiceItemList(tempItemVOList);
					invVO.setInvoiceItemExcludeList(tempExcludeItemVOList);
					
					BigDecimal totalAmtExclude = BigDecimal.ZERO;
					if (CollectionUtils.isNotEmpty(tempExcludeItemVOList)) {
						AmountCalcViewVO amtExcludeCalcViewVO = AccountHelper.computeAmountTotalBasedItem(new AmountCalcViewVO(), false, tempExcludeItemVOList, null, false);
						if (amtExcludeCalcViewVO != null)
							totalAmtExclude = amtExcludeCalcViewVO.getTotalAmountAfterRounding();
					}
					
					AmountCalcViewVO amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(new AmountCalcViewVO(), false, tempItemVOList, invVO.getInvoicePaymentList(), false);
					invVO.setAmount(amtCalcViewVO.getTotalAmountAfterRounding().doubleValue());
					invVO.setBalance(amtCalcViewVO.getTotalAmountAfterRounding()
							.add(totalAmtExclude)
							.subtract(amtCalcViewVO.getTotalAmountPaid()).doubleValue());
				}
			}
			/***
			 * Exclude the deposit account amount -END-
			 */

			for (InvoicePaxVO vo : invVO.getInvoicePaxList()) {
				vo.setRoomTypeDesc(LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_ROOM_TYPE, vo.getRoomTypeCd()));
				vo.setLangDesc("");
				String languages = "";
				if (vo.getCustDetailsVO() != null) {
					if (CollectionUtils.isNotEmpty(vo.getCustDetailsVO().getLangList())) {
						for (int i=0; i<vo.getCustDetailsVO().getLangList().size(); i++) {
							PersonLangVO langVO = vo.getCustDetailsVO().getLangList().get(i);
							if (i==0) {
								languages += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_LANG_DILC, langVO.getLangCd());
							} else {
								languages += ", " + LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_LANG_DILC, langVO.getLangCd());
							}
						}
					}
				}
				vo.setLangDesc(languages);
			}
			
			for (InvoicePaymentVO vo : invVO.getInvoicePaymentList()) {
				if (vo.getIssuerId() == null) vo.setPmntIssuedBy("SYSTEM");
				else vo.setPmntIssuedBy(getUserName(vo.getIssuerId()));
				vo.setPmntTypeName(LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_PYMT_TYPE, vo.getPmntTypeCd()));
			}
			
			// Set Prefix INV / CN
			invVO.setPrefix(prefixValue);
			invList.add(invVO);

			if (CollectionUtils.isEmpty(invList)) throw new BusinessException("No result.");

			CompanyTaxVO companyTaxVO = corporateProfileBO.getCompanyTax(getSessionInfoBean().getCompanyVO().getId());
			HashMap<String, Object> map = new HashMap<String, Object>();
			companyTaxVO.setTaxNumber((companyTaxVO.getTaxNumber().isEmpty()) ? "" : companyTaxVO.getTaxNumber());
			map.put("companyCode", companyVO != null ? companyVO.getCode() : "");
			map.put("docTypeCd", invVO.getDocTypeCd());
			
			
			//if (isPrintLetterHead) {
				map.put("letterHeadUrl", "../img/letter-head-header.png");
				if (companyVO != null) {
					validateEffectiveCompanyName(companyVO, invVO.getInvoiceDt());
					map.put("letterHeadUrl", companyVO.getLetterHeadUrl());
				}
			//}
			
			map.put("taxNumber", companyTaxVO.getTaxNumber());
			map.put("GSTPeriod", GSTPeriod);
			
			String jasperFileName = CommonConstant.JAS_RPT_INV_WITH_LETTER_HEAD;
			
			JasperPrint jasperPrint = ReportUtils.getJasperPrint(invList, map, jasperFileName);
			String filePath = AppConfigConstant.uploadPath + File.separator + "upload" + File.separator + prefixValue + "_" + invoiceVO.getCode() + ".pdf";
			invoiceVO.setPrefix(prefixValue);
			
			if (jasperPrint != null) {
				JasperExportManager.exportReportToPdfFile(jasperPrint, filePath);
				File file = new File(filePath);
				
				if (file.exists()) {
					String termsAndConditionsFile = AppConfigConstant.uploadPath + "/pdf/t_and_c/STANDARD TERMS AND CONDITIONS FOR OUTBOUND TOUR PACKAGES.pdf";
					String itineraryPath = "";
					if (invVO.getTourDepId() != null) {
						TourDepartureVO tourDpVO = tourPackageBO.getTourDepById(invoiceVO.getTourDepId());
						TourPackageItineryVO tourPackageItineryVO =  tourPackageBO.getTourPackageItineraryVOByCode(tourDpVO.getIdTourPkg(), tourDpVO.getTourPkgDailyCms());
						if (tourPackageItineryVO != null && invoiceVO.getBookingId() != null) {
							itineraryPath = AppConfigConstant.uploadPath + tourPackageItineryVO.getPath() + "/" + tourPackageItineryVO.getName();
						}
					}
					// Check the person email list has any incorrect email format
					if (CollectionUtils.isNotEmpty(personEmailList)) {
						String emailRegex = CommonConstant.EMAIL_FORMAT;
						Pattern emailPattern = Pattern.compile(emailRegex);
						for (PersonEmailVO vo : personEmailList) {
							Matcher emailMatcher = emailPattern.matcher(vo.getEmail());
							if (!emailMatcher.matches()) {
								throw new BusinessException(CommonErrConstant.ERR_WRONG_FORMAT_EMAIL);
							}
						}
					}
					// Check the primary email from the email text has incorrect email format
					if (StringUtils.isNotBlank(custDetailsVO.getEmail())) {
						String emailRegex = CommonConstant.EMAIL_FORMAT;
						Pattern emailPattern = Pattern.compile(emailRegex);
						Matcher emailMatcher = emailPattern.matcher(custDetailsVO.getEmail());
						if (!emailMatcher.matches()) {
							throw new BusinessException(CommonErrConstant.ERR_WRONG_FORMAT_EMAIL);
						}
					}
					for(String selectEmailList : invoiceEmailPaymentVO.getSelectedEmailList()) {
						emailList.add(selectEmailList);
					}
					if (StringUtils.isNotBlank(invoiceEmailPaymentVO.getEmail())) {
						emailList.add(invoiceEmailPaymentVO.getEmail());
					}
					
					if (CommonConstant.LOOKUP_ITM_INV_CAT_TOUR.equals(invoiceVO.getCatCd())) {
						emailingBO.sendEmailInvoiceEmail(invoiceVO, getSessionInfo().getUserVO(), emailList, file, termsAndConditionsFile, itineraryPath);
					} else {
						emailingBO.sendEmailInvoiceEmail(invoiceVO, getSessionInfo().getUserVO(), emailList, file, null, null);
					}
				} else throw new BusinessException("ERR_INVOICE_GEN_FAILED");
			}
			
			//ByteArrayDataSource attachment = new ByteArrayDataSource(ReportUtils.exportReportToByte(jasperPrint), "application/pdf");
			
			//File file = new File(AppConfigConstant.uploadPath + 
			//		File.separator + "INV" + invoiceVO.getId() + ".pdf");
			
			//file.getParentFile().mkdirs();
			
			//OutputStream saveLoc = new FileOutputStream(file);
			
			//IOUtils.copy(attachment.getInputStream(), saveLoc);
			//attachment.getInputStream().close();
			
			//emailingBO.sendEmailInvoiceEmail(invoiceVO, getSessionInfo().getUserVO(), email, file);
			successResult();
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
