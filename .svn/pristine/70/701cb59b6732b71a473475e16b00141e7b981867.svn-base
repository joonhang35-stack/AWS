	public Integer getActiveTab() {
		return activeTab;
	}
	
	public void setActiveTab(Integer activeTab) {
		setActiveTab(activeTab, false);
	}

	public void setActiveTab(Integer activeTab, Boolean isNextBtn) {
//		System.out.println("InvoiceBean.setActiveTab()");
//		System.out.println("prevActiveTab: " + prevActiveTab);
//		System.out.println("activeTab: " + activeTab);
		
		if (prevActiveTab != null && prevActiveTab != -1) {
			try {
				if (prevActiveTab == 0) {
					validateSplitItem();
				} else if (prevActiveTab == 1) {
					validateSplitPax();
				} else if (prevActiveTab == 2) {
					validateSplitPayment();
				}
			} catch (Throwable t) {
//				Integer temp = Integer.valueOf(prevActiveTab);
//				prevActiveTab = -1;
//				System.out.println("temp: " + temp);
//				setActiveTab(temp);
				
				// if hit error when switching tabs (or click next/previous button), may printStackTrace here to check error
				// commented to avoid spam console
//				t.printStackTrace();
				errorResult(t);
				if (isNextBtn) {
						
				} else {
					prevActiveTab = activeTab;
					this.activeTab = activeTab;	
				}
				
//				System.out.println("prevActiveTab: " + prevActiveTab);
//				System.out.println("activeTab: " + this.activeTab);
				
				return;
			}
		}
		
		this.activeTab = activeTab;
		
		// selectCheckboxMenu selection will lost after ajax update, hence need load selection again
		if (activeTab == 1) {
			for (InvoiceVO invoiceVO : splitInvoiceList) {
				invoiceVO.setSelectedPaxIds(new ArrayList<String>());
				for (InvoicePaxVO paxVO : invoiceVO.getInvoicePaxList()) {
					invoiceVO.getSelectedPaxIds().add(String.valueOf(paxVO.getId()));
//					System.out.println(paxVO.getId() + " ");
				}
//				System.out.println();
			}
		}
		
		prevActiveTab = activeTab;
	}

