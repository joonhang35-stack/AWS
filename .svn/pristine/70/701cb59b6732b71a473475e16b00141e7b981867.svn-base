		try {
			setContactAdd(false);
			if (StringUtils.isNotEmpty(vo.getContactNo())) {
				String[] contact = vo.getContactNo().split("-", 2);
				if (contact.length > 1) {
					vo.setAreaCode(contact[0]);
					vo.setContactNo(contact[1]);
				} else {
					vo.setpNumber(contact[0]);
				}
			}
			setCorContactVO(vo);

		} catch (Throwable t) {
			errorResult(t);
		}
	}

