	public void loadAvailableItemCode() {
	    availableItemCode = new ArrayList<>();
	    Set<String> allowedCodes = new HashSet<>(Arrays.asList(
	            "FT_SGL", "FT_TWN", "FT_CTW", "FT_CWB", "FT_CNB",
	            "GA_SGL", "GA_TWN", "GA_CTW", "GA_CWB", "GA_CNB"
	        ));
	    Set<String> filterDuplicate = new HashSet<>();

	    if (invoiceVO != null && invoiceVO.getInvoiceItemList() != null) {
	    	for (InvoiceItemVO item : invoiceVO.getInvoiceItemList()) {
	    	    if (allowedCodes.contains(item.getCode()) && filterDuplicate.add(item.getDesc())) {
	    	        availableItemCode.add(new SelectItem(item.getCode(),item.getDesc()));
	    	    }
	    	}
	    }
	}
	
	public void loadPersonEmailList() {
		try {
			PersonEmailVO defaultPrimaryEmail = new PersonEmailVO();
			CustomerVO customerVO = customerBO.getCustomer(invoiceVO.getCustomerId());
			personEmailList = invoiceBO.getPersonEmailListByPersonId(customerVO.getPersonVO().getId());
			if (CollectionUtils.isEmpty(personEmailList)) {
				throw new BusinessException(CommonErrConstant.ERR_EMPTY_EMAIL_LIST);
			}
			// Check the person email list has any incorrect email format
			if (CollectionUtils.isNotEmpty(personEmailList)) {
				String emailRegex = CommonConstant.EMAIL_FORMAT;
				Pattern emailPattern = Pattern.compile(emailRegex);
				for (PersonEmailVO vo : personEmailList) {
					Matcher emailMatcher = emailPattern.matcher(vo.getEmail());
					if (!emailMatcher.matches()) {
						disableEmailSent = true;
						throw new BusinessException(CommonErrConstant.ERR_WRONG_FORMAT_EMAIL);
					}
				}
			}
			// Check the primary email from the email text has incorrect email format 
			if (StringUtils.isNotBlank(custDetailsVO.getEmail())) {
				String emailRegex = CommonConstant.EMAIL_FORMAT;
				Pattern emailPattern = Pattern.compile(emailRegex);
				Matcher emailMatcher = emailPattern.matcher(custDetailsVO.getEmail());
				if (!emailMatcher.matches()) {
					disableEmailSent = true;
					throw new BusinessException(CommonErrConstant.ERR_WRONG_FORMAT_EMAIL);
				}
				// load the primary email from the email text and assigned into selected email list for default primary email send
				defaultPrimaryEmail.setIdPerson(customerVO.getPersonVO().getId());
				defaultPrimaryEmail.setEmail(custDetailsVO.getEmail());
				defaultPrimaryEmail.setIsPrimary(true);
			}
			invoiceEmailPaymentVO.getSelectedEmailList().add(defaultPrimaryEmail.getEmail());
			emailList.add(defaultPrimaryEmail.getEmail());
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}

	public void processSendEmail() {
		try {
			if (CollectionUtils.isEmpty(fullEmployeeList) && CollectionUtils.isEmpty(departmentList)) {
				FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_ERROR, "Specific Person and Department must be select either one.", "");
				FacesContext.getCurrentInstance().addMessage(null, msg);
				return;
			}
			
			emailList = new ArrayList<String>();
			if (CollectionUtils.isNotEmpty(fullEmployeeList)) {
				for(EmployeeViewVO vo : employeeList){
					for(String id : fullEmployeeList) {
						if(StringUtils.equals(id, String.valueOf(vo.getId()))) {
							if(StringUtils.isNotBlank(vo.getUserVO().getEmailAddress())) {
								emailList.add(vo.getUserVO().getEmailAddress());
							}
						}
					}
				}
			}
			
			if(CollectionUtils.isNotEmpty(departmentList)) {
				List<LookupItemVO> dptmtList = LookupItemUtils.getLookupItemList(CommonConstant.LOOKUP_CAT_CD_DEPARTMENT);
				
				for (String selectedDptmt : departmentList) {
					for (LookupItemVO liVO : dptmtList) {
						if (selectedDptmt.equals(liVO.getCode())) {
							if (liVO.getRemarks() != null && liVO.getRemarks().toLowerCase().startsWith("email:"))
							emailList.add(liVO.getRemarks().replaceAll("(?i)email:", "").trim());
						}
					}
				}
			}
			
			emailingBO.sendInvChangesBySpecificPerson(invoiceVO, prefixValue, emailList, invoiceChangesList, otherTypeRemark, getSessionInfo().getUserVO());
			
			FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_INFO, "Change Request Notification - Mail Sent Successfully", "");
			FacesContext.getCurrentInstance().addMessage(null, msg);
			
			resetEmailForm();
//			RequestContext.getCurrentInstance().addCallbackParam("isPass", isPass);
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void handleNtfctItemChange(int flag) {
		if (flag == 1) {
			selectedEmployee = "";
			for (String emp : fullEmployeeList) {
				for (EmployeeViewVO vo : employeeList) {
					if (Long.parseLong(emp) == vo.getId()) {
						if (StringUtils.isBlank(selectedEmployee))
							selectedEmployee = vo.getUserVO().getName();
						else
							selectedEmployee = selectedEmployee + ", " + vo.getUserVO().getName();
						break;
					}
				}
			}
		} else if (flag == 2) {
			selectedDepartment = "";
			for (String dep : departmentList) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_DEPARTMENT, dep);
				if (StringUtils.isBlank(selectedDepartment))
					selectedDepartment = tempDesc;
				else
					selectedDepartment = selectedDepartment + ", " + tempDesc;
			}
		} else if (flag == 3) {
			selectedChanges = "";
			for (String chgs : invoiceChangesList) {
				String tempDesc = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_INV_CHANGES, chgs);
				if (StringUtils.isBlank(selectedChanges))
					selectedChanges = tempDesc;
				else
					selectedChanges = selectedChanges + ", " + tempDesc;
			}
		}
	}
	
