	public void convertToCustomer(CustomerVO customerVO) {
		try {
			trackingLogUtils.startLogs();
			
			// Resync back the details
			if (customerVO.getPersonVO() != null) {
//				if (StringUtils.isNotEmpty(customerVO.getPersonVO().getNric())) {
					if (CollectionUtils.isNotEmpty(customerVO.getIdentityList())) {
						for (IdentityVO vo : customerVO.getIdentityList()) {
							if (CommonConstant.LOOKUP_ITM_ID_NRIC.equals(vo.getIdType())) {
								vo.setIdNo(customerVO.getPersonVO().getNric());
							}
							if (CommonConstant.LOOKUP_ITM_ID_PASSPRT.equals(vo.getIdType())) {
								vo.setIdNo(customerVO.getPersonVO().getPassportNo());
							}
						}
					}
//				}
				
				if (StringUtils.isNotEmpty(customerVO.getPersonVO().getEmail())) {
					if (CollectionUtils.isNotEmpty(customerVO.getPersonVO().getEmailList())) {
						for (PersonEmailVO vo : customerVO.getPersonVO().getEmailList()) {
							if (true == vo.getIsPrimary()) {
								vo.setEmail(customerVO.getPersonVO().getEmail());
								break;
							}
						}
					}
				}
			}
			
			// check duplicate customer
			checkDuplicateCustomer(customerVO);
			customerBO.insertCustomer(customerVO);
			//invoiceVO = invBO.getInvoice(tmpIdBooking);
			invoiceVO.setCustomerId(customerVO.getId());
			invoiceBO.updateCustomerId(invoiceVO);
			onInvoiceSelected(invoiceVO);

			// add customer to passenger list
			if (customerVO.getOnlineBookingPaxVO() != null) {
				customerVO.getOnlineBookingPaxVO().setIdCustomer(customerVO.getId());
				convertToPassenger(customerVO.getOnlineBookingPaxVO(), true);
			} else {
				//resetForm();
				successResult();
			}
		} catch (Throwable t) {
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("convertToCustomer");
		}
	}
	
	public void convertToPassenger(OnlineBookingPassengerVO vo, boolean isFromCustomer) {
		try {
			invoicePaxVO = new InvoicePaxVO();
			invoicePaxVO.setRoomTypeCd("twn");
			invoicePaxVO.setRoomPairingNo(vo.getRoomNo());
			invoicePaxVO.setSpclReq(vo.getRemarks());
			
			invoicePaxVO.setCustDetailsVO(new CustDetailsVO());
			invoicePaxVO.getCustDetailsVO().setFirstName(vo.getGivenName());
			invoicePaxVO.getCustDetailsVO().setLastName(vo.getSurname());
			invoicePaxVO.getCustDetailsVO().setSalutation(vo.getSalutationCd());
			invoicePaxVO.getCustDetailsVO().setTitle(vo.getTitleCd());
			invoicePaxVO.getCustDetailsVO().setNickName(vo.getNickName());
			invoicePaxVO.getCustDetailsVO().setEmail("");
			invoicePaxVO.getCustDetailsVO().setRemarks(vo.getRemarks());
			invoicePaxVO.getCustDetailsVO().setDob(vo.getDob());
			invoicePaxVO.getCustDetailsVO().setSex(vo.getSexCd());
			invoicePaxVO.getCustDetailsVO().setIdCountry(vo.getIdCountry());
			invoicePaxVO.getCustDetailsVO().setTaxIdNo(vo.getTaxIdNo());
			if (isFromCustomer) invoicePaxVO.setCustId(vo.getIdCustomer());
			
			if (StringUtils.isNotEmpty(vo.getIcNo()) || StringUtils.isNotEmpty(vo.getPassportNo())) {
				invoicePaxVO.getCustDetailsVO().setIdentityList(new ArrayList<IdentityVO>());
				IdentityVO identityVO = null;
				
				if (StringUtils.isNotEmpty(vo.getIcNo())) {
					identityVO = new IdentityVO();
					identityVO.setIdType(CommonConstant.LOOKUP_ITM_ID_NRIC);
					identityVO.setIdNo(vo.getIcNo());
					
					identityVO.setIdentityDetailVO(new IdentityDetailVO());
					identityVO.getIdentityDetailVO().setIdCountry(vo.getIdCountry());
					
					invoicePaxVO.getCustDetailsVO().getIdentityList().add(identityVO);
				}
				if (StringUtils.isNotEmpty(vo.getPassportNo())) {
					identityVO = new IdentityVO();
					identityVO.setIdType(CommonConstant.LOOKUP_ITM_ID_PASSPRT);
					identityVO.setIdNo(vo.getPassportNo());
					
					identityVO.setIdentityDetailVO(new IdentityDetailVO());
					identityVO.getIdentityDetailVO().setIdCountry(vo.getIdCountry());
					identityVO.getIdentityDetailVO().setDtExpired(vo.getDtExpiry());
					
					invoicePaxVO.getCustDetailsVO().getIdentityList().add(identityVO);
				}
			}
			addInvPax();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
