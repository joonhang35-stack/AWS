	public String getPrefixValue(InvoiceVO invoiceVO) {
		if (StringUtils.isBlank(invoiceVO.getDocTypeCd())) {
			return prefixValue;
		}
		if (invoiceVO.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_PAX_STMT)) {
			if (StringUtils.isBlank(psPrefixVal)) {
				psPrefixVal = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_PAX_STMT).getPrefixid();
			}
			return psPrefixVal;
		} else if (invoiceVO.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_INVC)) {
			if (StringUtils.isBlank(invPrefixVal)) {
				invPrefixVal = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_INVC).getPrefixid();
			}
			return invPrefixVal;
		}
		return prefixValue;
	}

	/**
	 * Calculate invoice amount
	 */
	public void calInvAmt() {
		try {
			if (invoiceItemVO.getAcctId() == null) 
				throw new BusinessException(CommonErrConstant.ERR_INV_SALES_ACCT_EMPTY);
			
			invoiceItemVO = (InvoiceItemVO) AccountHelper.calcTaxableAmount(invoiceItemVO, true, invoiceItemVO.getQty(),
														invoiceItemVO.getUnitPrice());
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}

	/**
	 * Calculate total amount
	 */
	public void calTtlAmt() {
		calTtlAmt(null, true);
	}
	
	/**
	 * Calculate total amount
	 */
	public void calTtlAmt(InvoiceVO invVO, boolean updateItemAmount) {
		try {
			
			if (invVO == null) {
				//Manual update the item Amount here
				if(!updateItemAmount) {
					calculateInvoiceItemsAmount(invoiceVO.getInvoiceItemList());
					//updateItemAmount = false;
				}
				AmountCalcViewVO amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(new AmountCalcViewVO(), false, invoiceVO.getInvoiceItemList(),
																	invoiceVO.getInvoicePaymentList(), false);
				
				invoiceVO.setTaxAmt(amtCalcViewVO.getTotalTax().doubleValue());
				invoiceVO.setTaxIncAmt(amtCalcViewVO.getTotalAmountIncludeTax().doubleValue());
				invoiceVO.setRoundingAmt(amtCalcViewVO.getTotalRounding().doubleValue());
				invoiceVO.setAmount(amtCalcViewVO.getTotalAmountAfterRounding().doubleValue());
				invoiceVO.setAmtPaid(amtCalcViewVO.getTotalAmountPaid().doubleValue());
				invoiceVO.setBalance(amtCalcViewVO.getTotalAmountAfterRounding()
										.subtract(amtCalcViewVO.getTotalAmountPaid()).doubleValue());
				
				BigDecimal taxAmt = new BigDecimal(String.valueOf(invoiceVO.getTaxAmt()));
				BigDecimal taxIncAmt = new BigDecimal(String.valueOf(invoiceVO.getTaxIncAmt()));
				BigDecimal taxExcAmt = taxIncAmt.subtract(taxAmt);
				invoiceVO.setTaxExcAmt(taxExcAmt.doubleValue());
				
				EInvoiceUtils.calcEInvItemList(invoiceVO);
				
			} else { // From Print Invoice
				if(updateItemAmount) {
					calculateInvoiceItemsAmount(invVO.getInvoiceItemList());
					updateItemAmount = false;
				}
				
				AmountCalcViewVO amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(new AmountCalcViewVO(), updateItemAmount, invVO.getInvoiceItemList(),
						invVO.getInvoicePaymentList(), false);
				
				invVO.setTaxAmt(amtCalcViewVO.getTotalTax().doubleValue());
				invVO.setTaxIncAmt(amtCalcViewVO.getTotalAmountIncludeTax().doubleValue());
				invVO.setRoundingAmt(amtCalcViewVO.getTotalRounding().doubleValue());
				invVO.setAmount(amtCalcViewVO.getTotalAmountAfterRounding().doubleValue());
				invVO.setAmtPaid(amtCalcViewVO.getTotalAmountPaid().doubleValue());
				invVO.setBalance(amtCalcViewVO.getTotalAmountAfterRounding()
										.subtract(amtCalcViewVO.getTotalAmountPaid()).doubleValue());
				
				BigDecimal taxAmt = new BigDecimal(String.valueOf(invVO.getTaxAmt()));
				BigDecimal taxIncAmt = new BigDecimal(String.valueOf(invVO.getTaxIncAmt()));
				BigDecimal taxExcAmt = taxIncAmt.subtract(taxAmt);
				invVO.setTaxExcAmt(taxExcAmt.doubleValue());
				
				EInvoiceUtils.calcEInvItemList(invVO);
			}
			
			if (invoiceVO.getBalance() == 0) disabledEmailPayment = true;
			else disabledEmailPayment = false;

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	// For Pop Up Invoice Use
	public void calTtlAmt(InvoiceVO invVO) {
		try {		
			AmountCalcViewVO amtCalcViewVO = AccountHelper.computeAmountTotalBasedItem(new AmountCalcViewVO(), false, invVO.getInvoiceItemList(),
					invVO.getInvoicePaymentList(), false);

			invVO.setTaxAmt(amtCalcViewVO.getTotalTax().doubleValue());
			invVO.setTaxIncAmt(amtCalcViewVO.getTotalAmountIncludeTax().doubleValue());
			invVO.setRoundingAmt(amtCalcViewVO.getTotalRounding().doubleValue());
			invVO.setAmount(amtCalcViewVO.getTotalAmountAfterRounding().doubleValue());
			invVO.setAmtPaid(amtCalcViewVO.getTotalAmountPaid().doubleValue());
			invVO.setBalance(amtCalcViewVO.getTotalAmountAfterRounding()
					.subtract(amtCalcViewVO.getTotalAmountPaid()).doubleValue());

			BigDecimal taxAmt = new BigDecimal(String.valueOf(invVO.getTaxAmt()));
			BigDecimal taxIncAmt = new BigDecimal(String.valueOf(invVO.getTaxIncAmt()));
			BigDecimal taxExcAmt = taxIncAmt.subtract(taxAmt);
			invVO.setTaxExcAmt(taxExcAmt.doubleValue());
			
			EInvoiceUtils.calcEInvItemList(invVO);

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	private void calculateInvoiceItemsAmount(List<InvoiceItemVO> invoiceItemList) throws BusinessException {
		//Manual update the item Amount here
		for(InvoiceItemVO vo : invoiceItemList) {
			BigDecimal qty = new BigDecimal(String.valueOf(vo.getQty()));
			BigDecimal unitPrice = new BigDecimal(String.valueOf(vo.getUnitPrice()));
			BigDecimal totalPriceIncGST = unitPrice.multiply(qty);
			vo.setTaxIncAmt(totalPriceIncGST.doubleValue());
			if (vo.getQty() == 0 || vo.getUnitPrice() == 0.00) {
				vo.setAmount(0.00);
			} 
			
			//vo = (InvoiceItemVO) AccountHelper.calcAmountBaseOnTotalTaxableAmount(vo);
		}
	}
	
	private void calculateTotalUApple(CustDetailsVO custDetailsVO, List<InvoicePaxVO> invoicePaxList) throws BusinessException {
		int totalUPoint = 0;
		int totalVoucherPoint = 0;
		if(custDetailsVO != null) {
			if(custDetailsVO.getuPoint() == null) {
				custDetailsVO.setuPoint(0);
			}
			if(custDetailsVO.getApplePoint() == null) {
				custDetailsVO.setApplePoint(0);
			}
			totalUPoint += custDetailsVO.getuPoint();
			totalVoucherPoint += custDetailsVO.getApplePoint();
		}
		if(CollectionUtils.isNotEmpty(invoicePaxList)) {
			for(InvoicePaxVO vo : invoicePaxList) {
				if(vo.getuPoint() == null) {
					vo.setuPoint(0);
				}
				if(vo.getApplePoint() == null) {
					vo.setApplePoint(0);
				}
				totalUPoint += vo.getuPoint();
				totalVoucherPoint += vo.getApplePoint();
			}
		}
		invoiceVO.setTotalUPoint(totalUPoint);
		invoiceVO.setTotalVoucherPoint(totalVoucherPoint);
	}
	
	public void handleAmountIncludeTaxChange() {
		try {
			BigDecimal qty = new BigDecimal(String.valueOf(invoiceItemVO.getQty()));
			BigDecimal unitPrice = new BigDecimal(String.valueOf(invoiceItemVO.getUnitPrice()));
			BigDecimal totalPriceIncGST = unitPrice.multiply(qty);
			invoiceItemVO.setTaxIncAmt(totalPriceIncGST.doubleValue());
			if (invoiceItemVO.getQty() == 0 || invoiceItemVO.getUnitPrice() == 0.00) {
				invoiceItemVO.setAmount(0.00);
			}
			
			invoiceItemVO = (InvoiceItemVO) AccountHelper.calcAmountBaseOnTotalTaxableAmount(invoiceItemVO);
			
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handleGSTAmtChange() {
		try {
			BigDecimal qty = new BigDecimal(String.valueOf(invoiceItemVO.getQty()));
			BigDecimal unitPrice = new BigDecimal(String.valueOf(invoiceItemVO.getUnitPrice()));
			BigDecimal taxAmount = new BigDecimal(String.valueOf(invoiceItemVO.getTaxAmount()));
			BigDecimal totalPriceIncGST = unitPrice.multiply(qty);
			invoiceItemVO.setTaxIncAmt(totalPriceIncGST.doubleValue());
			if (invoiceItemVO.getQty() == 0 || invoiceItemVO.getUnitPrice() == 0.00) {
				invoiceItemVO.setAmount(0.00);
			}
			
			invoiceItemVO = (InvoiceItemVO) AccountHelper.calcAmountBaseOnTotalTaxableAmount(invoiceItemVO);
			
			if (invoiceItemVO.getTaxIncAmt() != 0.00) {
				totalPriceIncGST = new BigDecimal(String.valueOf(invoiceItemVO.getTaxIncAmt()));
				invoiceItemVO.setTaxAmount(taxAmount.doubleValue());
				invoiceItemVO.setAmount(totalPriceIncGST.subtract(taxAmount).doubleValue());
			}
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	/**
	 * On passanger selected
	 * @param event
	 */
	public void handlePassangerSelect(SelectEvent event) {
		try {
			CustDetailsVO vo = invoiceBO.getCustDetails(((CustomerVO) event.getObject()).getId(), true, true);
			//invoiceBO.setPerSubInfo(vo); // set languages and meals list
			if (null == vo.getIdentityList()) vo.setIdentityList(new ArrayList<IdentityVO>());
			if (null == vo.getContactList()) vo.setContactList(new ArrayList<PersonContactVO>());
			if (null == vo.getMealList()) vo.setMealList(new ArrayList<PersonMealVO>());
			if (null == vo.getLangList()) vo.setLangList(new ArrayList<PersonLangVO>());
			if (null == vo.getEmailList()) vo.setEmailList(new ArrayList<PersonEmailVO>());
			if (null == vo.getClassCdList()) vo.setClassCdList(new ArrayList<String>());
			if (null == vo.getLangCdList()) vo.setLangCdList(new ArrayList<String>());
			if (null == vo.getCompliCdList()) vo.setCompliCdList(new ArrayList<String>());
			if (null == vo.getMealCdList()) vo.setMealCdList(new ArrayList<String>());
			if (null == vo.getAddressVO()) {
				vo.setAddressVO(new AddressVO());
				vo.getAddressVO().setCountryId(CommonConstant.DEF_COUNTRY_ID);
				vo.getAddressVO().setAddrType(CommonConstant.BILL_ADDR);
			}
			if (null == vo.getMailAddressVO()) {
				vo.setMailAddressVO(new AddressVO());
				vo.getMailAddressVO().setCountryId(CommonConstant.DEF_COUNTRY_ID);
				vo.getMailAddressVO().setAddrType(CommonConstant.MAIL_ADDR);
			}
			
			
			invoicePaxVO.setCustId(vo.getCustId());
			invoicePaxVO.setCustDetailsVO(vo);
			resetPassangerListForm();
			
			if (invoicePaxVO != null) {
				if (invoicePaxVO.getCustDetailsVO() != null) {
					if (invoicePaxVO.getCustDetailsVO().getNricIdVO() == null) {
						invoicePaxVO.getCustDetailsVO().setNricIdVO(new IdentityVO());
						invoicePaxVO.getCustDetailsVO().getNricIdVO().setIdType(CommonConstant.LOOKUP_ITM_ID_NRIC);
						invoicePaxVO.getCustDetailsVO().getNricIdVO().setIdentityDetailVO(new IdentityDetailVO());
					} else {
						if (invoicePaxVO.getCustDetailsVO().getNricIdVO().getIdType() == null)
							invoicePaxVO.getCustDetailsVO().getNricIdVO().setIdType(CommonConstant.LOOKUP_ITM_ID_NRIC);
					}
					if (invoicePaxVO.getCustDetailsVO().getPassportIdVO() == null) {
						invoicePaxVO.getCustDetailsVO().setPassportIdVO(new IdentityVO());
						invoicePaxVO.getCustDetailsVO().getPassportIdVO().setIdType(CommonConstant.LOOKUP_ITM_ID_PASSPRT);
						invoicePaxVO.getCustDetailsVO().getPassportIdVO().setIdentityDetailVO(new IdentityDetailVO());
						if (invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdentityDetailVO().getIdCountry() == null)
							invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdentityDetailVO().setIdCountry(CommonConstant.DEF_COUNTRY_ID);
					} else {
						if (invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdType() == null)
							invoicePaxVO.getCustDetailsVO().getPassportIdVO().setIdType(CommonConstant.LOOKUP_ITM_ID_PASSPRT);
						if (invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdentityDetailVO() == null)
							invoicePaxVO.getCustDetailsVO().getPassportIdVO().setIdentityDetailVO(new IdentityDetailVO());
					}
				}
				
				if (invoicePaxVO.getCustDetailsVO().getPersonContactVO() == null) invoicePaxVO.getCustDetailsVO().setPersonContactVO(new PersonContactVO());
			}
			
			handleLanguageChange();
			handleMealChange();
			handleClassChange();
			handleComplicationChange();
			
			if (invoicePaxVO.getCustDetailsVO() != null && CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getIdentityList())) {
				CustDetailsVO custDtlVO = invoicePaxVO.getCustDetailsVO();
				for (IdentityVO idVO : custDtlVO.getIdentityList()) {
					if (StringUtils.equals(idVO.getIdType(), CommonConstant.LOOKUP_ITM_ID_NRIC)) {
						custDtlVO.setNricIdVO((IdentityVO) idVO.clone());
						custDtlVO.getNricIdVO().setIdNo(idVO.getIdNo());
						calculateDOBByNRIC(custDtlVO.getNricIdVO());
						continue;
					}
					if (StringUtils.equals(idVO.getIdType(), CommonConstant.LOOKUP_ITM_ID_PASSPRT)) {
						custDtlVO.setPassportIdVO((IdentityVO) idVO.clone());
						custDtlVO.getPassportIdVO().setIdNo(idVO.getIdNo());
						if (idVO.getIdentityDetailVO() != null) {
							custDtlVO.getPassportIdVO().setIdentityDetailVO((IdentityDetailVO) idVO.getIdentityDetailVO().clone());
							custDtlVO.getPassportIdVO().setUploadedFile(custDtlVO.getPassportIdVO().getIdentityDetailVO().getScannedPath());
							continue;
						} else {
							custDtlVO.getPassportIdVO().setIdentityDetailVO(new IdentityDetailVO());
							custDtlVO.getPassportIdVO().getIdentityDetailVO().setIdCountry(CommonConstant.DEF_COUNTRY_ID);
						}
					}
				}
			}
			
			for (PersonContactVO perContVO : invoicePaxVO.getCustDetailsVO().getContactList()) {
				if (StringUtils.equals(perContVO.getTypeCd(), SalesConstant.MOBILE_TYPE_CD)) {
					invoicePaxVO.getCustDetailsVO().getPersonContactVO().setPerMobileNumber(perContVO.getNumber());
					invoicePaxVO.getCustDetailsVO().getPersonContactVO().setPerMobileAttention(perContVO.getAttention());
				}
				if (StringUtils.equals(perContVO.getTypeCd(), SalesConstant.OFFICE_TYPE_CD)) {
					invoicePaxVO.getCustDetailsVO().getPersonContactVO().setPerOfficeNumber(perContVO.getNumber());
					invoicePaxVO.getCustDetailsVO().getPersonContactVO().setPerOfficeAttention(perContVO.getAttention());
				}
				if (StringUtils.equals(perContVO.getTypeCd(), SalesConstant.HOME_TYPE_CD)) {
					invoicePaxVO.getCustDetailsVO().getPersonContactVO().setPerHomeNumber(perContVO.getNumber());
					invoicePaxVO.getCustDetailsVO().getPersonContactVO().setPerHomeAttention(perContVO.getAttention());
				}
				if (StringUtils.equals(perContVO.getTypeCd(), SalesConstant.FAX_TYPE_CD)) {
					invoicePaxVO.getCustDetailsVO().getPersonContactVO().setPerFaxNumber(perContVO.getNumber());
					invoicePaxVO.getCustDetailsVO().getPersonContactVO().setPerFaxAttention(perContVO.getAttention());
				}
			}

		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	static void deleteFolder(File file){
	      for (File subFile : file.listFiles()) {
	         if(subFile.isDirectory()) {
	            deleteFolder(subFile);
	         } else {
	            subFile.delete();
	         }
	      }
	      file.delete();
	   }
	
	/**
	 * On invoice item selected
	 * @param event
	 */
	public void onInvoiceSelected(InvoiceVO vo) {
		System.out.println("InvoiceBean.onInvoiceSelected()");
		System.out.println("CYY docTypeCd: " + docTypeCd);
//		System.out.println("CYY activeListingTab: " +activeListingTab);
		try {
			trackingLogUtils.startLogs();
			
			addEdit = false;
			isEditSeq = false;
			isEditPaxSeq = false;
			isEditPmntSeq = false;
			isEditBookingSync = false;
			tourDepListInactiveRecords = false;
			
			String folder = AppConfigConstant.uploadPath + destinationTmpPath;
	        recursiveDelete(new File(folder));
			invoiceVO = invoiceBO.getInvoiceById(vo.getId());
			setOriObj(invoiceVO.clone());
			
			invoiceBO.getInvoiceDetails(invoiceVO);
			custDetailsVO = invoiceVO.getCustDetailsVO();
			
			if (CollectionUtils.isNotEmpty(invoiceVO.getInvoicePaxList())) {
				for (InvoicePaxVO invoicePaxVO : invoiceVO.getInvoicePaxList()) {
					if (invoicePaxVO.getCustDetailsVO() != null && CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getIdentityList())) {
						CustDetailsVO custDtlVO = invoicePaxVO.getCustDetailsVO();
						for (IdentityVO idVO : custDtlVO.getIdentityList()) {
							if (StringUtils.equals(idVO.getIdType(), CommonConstant.LOOKUP_ITM_ID_NRIC)) {
								custDtlVO.setNricIdVO((IdentityVO) idVO.clone());
								custDtlVO.getNricIdVO().setIdNo(idVO.getIdNo());
								invoicePaxVO.getCustDetailsVO().setAge(CalculationUtils.calculateAgeByIdNo(custDtlVO.getNricIdVO().getIdNo()));
								continue;
							}
							if (StringUtils.equals(idVO.getIdType(), CommonConstant.LOOKUP_ITM_ID_PASSPRT)) {
								custDtlVO.setPassportIdVO((IdentityVO) idVO.clone());
								custDtlVO.getPassportIdVO().setIdNo(idVO.getIdNo());
								if (idVO.getIdentityDetailVO() != null) {
									custDtlVO.getPassportIdVO().setIdentityDetailVO((IdentityDetailVO) idVO.getIdentityDetailVO().clone());
									custDtlVO.getPassportIdVO().setUploadedFile(custDtlVO.getPassportIdVO().getIdentityDetailVO().getScannedPath());
									continue;
								} else {
									custDtlVO.getPassportIdVO().setIdentityDetailVO(new IdentityDetailVO());
									custDtlVO.getPassportIdVO().getIdentityDetailVO().setIdCountry(CommonConstant.DEF_COUNTRY_ID);
								}
							}
						}
					}
					loadReferenceNo(invoicePaxVO, false);
				}
			}
			
			resetInvItemForm();
			resetEoInvForm();
			resetInvPmntForm();
			resetFileUploadForm();
			resetEmailForm();
			loadAll();
			loadAvailableItemCode();
			invoiceVO.setIdAcctGST(this.getSessionInfoBean().getCompanyVO().getIdAcctGST());
			//invoiceVO.setIdAcctRounding(this.getSessionInfoBean().getCompanyVO().getIdAcctRounding());
			
			if (StringUtils.isNotBlank(invoiceVO.getNoteItems())) {
				List<String> noteItemsList = Arrays.asList(invoiceVO.getNoteItems().split(","));
				invoiceVO.setNoteItemsList(noteItemsList);
			}
			
			// Check is booking lock, if yes then remarks not able to edit
			checkBookingLock(invoiceVO.getBookingId(), invoiceVO.getIdParentInvTourBooking());
			
			GSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), invoiceVO.getInvoiceDt());
			
			calTtlAmt(null, false);
			calculateTotalUApple(custDetailsVO, invoiceVO.getInvoicePaxList());
			
			// Check Financial Period Closed
			invoiceVO.setDateInFinPeriodClosed(getFinPeriodClosedStatus());
			// Check Invoice Date changeable
			invoiceVO.setInvoiceDateChangeable(getInvoiceDateChangeable());
			//setGstProccessStatus(LookupItemUtils.getGSTProcessStatus(getSessionInfoBean().getCompanyVO().getId(), invoiceVO.getInvoiceDt()));
			if (vo.getId() != null) checkPOSUploadEditable(vo.getId().toString());
			
			if (custDetailsVO != null && String.valueOf(custDetailsVO.getCode()).equals(onlineBookingConfigVO.getValue())) {
				disableEditCustomer = true;
			}
			
			//set the transferred date to this format (dd-MMM-yyyy)
			if (invoiceVO.getTransferredDate() != null) {
				SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy");
				String formatedTransferredDate = sdf.format(invoiceVO.getTransferredDate());
				invoiceVO.setFormattedTransferredDate(formatedTransferredDate);
			}
			
			invBeforeEInv = isInvoiceBeforeEInvoice(invoiceVO);
			// set e inv qr code (if have)
			if (invoiceVO.geteInvoiceDocumentVO() != null) {
				System.out.println("invoiceVO.geteInvoiceDocumentVO() != null");
				EInvoiceUtils.generateValidationQrCode(invoiceVO.geteInvoiceDocumentVO());
			}
			if (invoiceVO.geteInvoiceRnDocumentVO() != null) {
				EInvoiceUtils.generateValidationQrCode(invoiceVO.geteInvoiceRnDocumentVO());
			}
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("onInvoiceSelected");
		}
	}
	
	private Boolean isInvoiceBeforeEInvoice(InvoiceVO invVO) {
		if (invVO == null)	return true; // avoid err in log
		if (StringUtils.isNotBlank(invVO.getDocTypeCd()) && invVO.getDocTypeCd().equals("P")) {
			return true;
		} else {
			if (invVO.getPsNo()!=null && invVO.getPsNo().length()>0) {
				return false;
			} else {
				return true;
			}
		}
	}
	
	public static void recursiveDelete(File file) {
        //to end the recursive loop
        if (!file.exists())
            return;
        
        //if directory, go inside and call recursively
        if (file.isDirectory()) {
            for (File f : file.listFiles()) {
                //call recursively
                recursiveDelete(f);
            }
        }
        //call delete to delete files and empty directory
        file.delete();
    }
	
