	public void loadNewCustomer(CustDetailsVO vo) {
		try {
			if (isAddNewCust) {
				invoiceVO.setCustomerId(vo.getCustId());
				invoiceVO.setAttnTo(vo.getContPersonName());
				invoiceVO.setAttnTo(FunctionUtils.getContPersonName(vo.getContPersonName(), vo.getNickName(), vo.getTitle(), vo.getSalutation()));
				setCustDetailsVO(vo);
				invoiceVO.setCustDetailsVO(custDetailsVO);
				calculateTotalUApple(invoiceVO.getCustDetailsVO(), invoiceVO.getInvoicePaxList());
			}else {
				setCustDetailsVO(vo);
				calculateTotalUApple(custDetailsVO, invoiceVO.getInvoicePaxList());
			}
		} catch (Exception e) {
			e.printStackTrace();
		}
	}
	
	public void loadListingTableView() {
		listingTableViewMap = new HashMap<>();
		try {
			listingTableViewVO = listingTableViewBO.getListingTableView(ConstantListingTableView.LISTING_TYPE_INVOICE, getSessionInfo().getUserVO().getId());
			
			if (listingTableViewVO == null) {
				listingTableViewVO = new ListingTableViewVO();
				listingTableViewVO.setIdUser(getSessionInfo().getUserVO().getId());
				listingTableViewVO.setListingType(ConstantListingTableView.LISTING_TYPE_INVOICE);
				
				listingTableViewVO.setListingTableViewColumnsVOList(new ArrayList<ListingTableViewColumnsVO>()); 
			}
			
			for (ListingTableViewColumnsVO columnsVO : listingTableViewVO.getListingTableViewColumnsVOList()) {
				listingTableViewMap.put(columnsVO.getSeqNo(), columnsVO.getVisible());
			}
		} catch (BusinessException e) {
			e.printStackTrace();
			errorResult(e);
		}
	}

	/**
