	public boolean canSelectSplitPax(InvoiceVO subInvoiceVO, InvoicePaxVO invoicePaxVO) {
		for (InvoiceVO othersSubInvoiceVO : splitInvoiceList) {
			if (othersSubInvoiceVO.getCode().equals(subInvoiceVO.getCode())) {
				continue;
			}
			
			for (InvoicePaxVO subPaxVO : othersSubInvoiceVO.getInvoicePaxList()) {
				if (subPaxVO.getId().equals(invoicePaxVO.getId())) {
					return false;
				}
			}
		}
		
		return true;
	}
	
