	/**
	 * On selected invoice reference
	 */
	public void handleInvNoSelect(SelectEvent event) throws BusinessException {
		InvoiceVO vo = (InvoiceVO) event.getObject();
		
		if (isFromImportAttachment) {
			try {
				List<InvoiceAttachmentVO> invoiceAttachmentList = invoiceBO.getInvoiceAttachmentList(vo.getId());
				InvoiceAttachmentVO invAttchVO = new InvoiceAttachmentVO();
				
				Long version = 1L; //For prevent GenUpdateVOList.processAddUpdDelVO ignore add function
				for (InvoiceAttachmentVO attchVO : invoiceAttachmentList) {
					// rename the valid file name
					String fileName = attchVO.getName().substring(15);
					SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMddHHmmss");
					fileName = sdf.format(new Date()) + "_" + fileName;
					
					invAttchVO = new InvoiceAttachmentVO();
					invAttchVO.setId(null);
					invAttchVO.setInvId(invoiceVO.getId());
					invAttchVO.setName(fileName);
					invAttchVO.setScannedPath(fileName);
					invAttchVO.setFilePath(UUID.randomUUID().toString() + "." + FilenameUtils.getExtension(fileName));
					invAttchVO.setTypeCd(attchVO.getTypeCd());
					invAttchVO.setCreatedBy(null);
					invAttchVO.setCreatedDate(null);
					invAttchVO.setUpdatedBy(null);
					invAttchVO.setUpdatedDate(null);
					invAttchVO.setVersion(System.currentTimeMillis() + version);
				
					/*fileUploadUtils.getDelTmpList().add(destinationTmpPath + File.separator + invAttchVO.getFilePath());
					
					fileUploadUtils.getTmpMap().put(invAttchVO.getFilePath(),
							new FileUploadVO(destinationTmpPath, invAttchVO.getFilePath(), destinationAttachmentPath, attchVO.getFilePath()));
					fileUploadUtils.getMap().put(invAttchVO.getFilePath(),
							new FileUploadVO(destinationAttachmentPath, invAttchVO.getFilePath(), destinationAttachmentPath, attchVO.getFilePath()));
					
					GenUpdateVOList.processAddUpdDelVO(invoiceVO.getGenAUDInvoiceAttachmentVOList(), invoiceVO.getInvoiceAttachmentVOList(), invAttchVO, ConstantScreenAction.ADD);*/
					
					fileUploadUtils.uploadSingleFile(null, destinationAttachmentPath, invAttchVO.getFilePath(), destinationAttachmentPath, attchVO.getFilePath(), true);
					invoiceBO.addDeleteInvoiceAttachment(invAttchVO, false);
					invoiceVO.getInvoiceAttachmentVOList().add(invAttchVO);
					version = version + 1L;
				}
				
				/*if (fileUploadUtils.getTmpMap().size() > 0) {
					fileUploadUtils.uploadTmpFile();
				}*/
				
				if (invoiceAttachmentList.size() > 0) {
					String desc = "";
					if (invoiceAttachmentList.size() > 1) desc = invoiceAttachmentList.size() + " file ";
					else  desc = invoiceAttachmentList.size() + " files ";
					FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_INFO, desc + "is uploaded.", desc + "is uploaded.");
					FacesContext.getCurrentInstance().addMessage(null, msg);
				} else {
					FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_WARN, "Invoice selected do not have attacment.", "Invoice selected do not have attacment.");
					FacesContext.getCurrentInstance().addMessage(null, msg);
				}
				
			} catch (Exception e) {
				errorResult(e);
			}
		}  else if (!isFromImportPassenger && !isFromImportRemarks && !isFromImportINVDetails) {
			for (InvoiceReferenceVO refVO : invoiceVO.getInvoiceRefVOList()) {
				if (vo.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_PAX_STMT)) {
					if (StringUtils.equals(refVO.getInvRefCode(), vo.getPsNo())) {
						FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_WARN, "Invoice selected already exists.", "Invoice selected already exists");
						FacesContext.getCurrentInstance().addMessage(null, msg);
						return;
					}
				}
				
				if (vo.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_INVC)) {
					if (StringUtils.equals(refVO.getInvRefCode(), vo.getCode())) {
						FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_WARN, "Invoice selected already exists.", "Invoice selected already exists");
						FacesContext.getCurrentInstance().addMessage(null, msg);
						return;
					}
				}
			}
			
			InvoiceReferenceVO invoiceRefVO = new InvoiceReferenceVO();
			invoiceRefVO.setInvRefId(vo.getId());
			invoiceRefVO.setDocTypeCd(vo.getDocTypeCd());
			invoiceRefVO.setInvRefCode(vo.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_PAX_STMT) ? vo.getPsNo() : vo.getCode());
			
			try {
				GenUpdateVOList.processAddUpdDelVO(invoiceVO.getGenAUDINvoiceRefVOList(), invoiceVO.getInvoiceRefVOList(), invoiceRefVO, ConstantScreenAction.ADD);
			} catch (Exception e) {
				errorResult(e);
			}
		} else if (isFromImportINVDetails) {
		    invoiceVO.setCustomerId(vo.getCustomerId());
		    List<InvoiceItemVO> invDetailsList = invoiceBO.getInvItemList(vo);
		    List<TourDepItemVO> acctTourDepItemList = null;
		    Double sglAirfare = 0.0;
		    Double twnAirfare = 0.0;
		    if (invoiceVO.getTourDepId() != null)	 acctTourDepItemList = tourPkgBO.getTourDepItemList(invoiceVO.getTourDepId(), getSessionInfoBean().getCompanyVO().getId());
		    
		    if (invoiceVO.getTourDepId() != null && CollectionUtils.isNotEmpty(acctTourDepItemList)) {
		    	for (TourDepItemVO tdItemVO : acctTourDepItemList) {
		            if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(tdItemVO.getCode())) sglAirfare = tdItemVO.getAirfare();
		            if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(tdItemVO.getCode())) twnAirfare = tdItemVO.getAirfare();
		        }
		    }
		    
		    for (InvoiceItemVO invDetailsVO : invDetailsList) {
		    	InvoiceAndExchangeOrderVO invoiceAndExchangeOrderVO = null;
		    	invDetailsVO.setInvId(null);
		        invDetailsVO.setId(null);

		        if (invDetailsVO.getInvEOItemId() != null) {
		        	invoiceAndExchangeOrderVO = invoiceAndExchangeOrderBO.getInvoiceAndExchangeOrderVO(invDetailsVO.getInvEOItemId());
		            if (invoiceAndExchangeOrderVO != null) invDetailsVO.setTypeCd(invoiceAndExchangeOrderVO.getTypeCd());
		        } else if (StringUtils.isNotBlank(invDetailsVO.getCode())) {
		        	invoiceAndExchangeOrderVO = invoiceAndExchangeOrderBO.getInvoiceAndExchangeOrderVO(invDetailsVO.getCode());
		            if (invoiceAndExchangeOrderVO != null) invDetailsVO.setTypeCd(invoiceAndExchangeOrderVO.getTypeCd());
		        }
				
				if (invoiceAndExchangeOrderVO != null)	vo.setTypeCd(invoiceAndExchangeOrderVO.getTypeCd());
				
				if (invoiceVO.getTourDepId() != null) {
					Double airfare = 0.0;
				    if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(invDetailsVO.getCode())) airfare = sglAirfare;
				    else if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(invDetailsVO.getCode())) airfare = twnAirfare;
		            invDetailsVO.setAirfare(airfare);
		            BigDecimal unitPrice = BigDecimal.valueOf(invDetailsVO.getUnitPrice());
		            BigDecimal tourFare = unitPrice.subtract(BigDecimal.valueOf(airfare));
		            invDetailsVO.setTourFare(tourFare.doubleValue());
		        } else {
		            invDetailsVO.setAirfare(0.0);
		        }
				
				if (invoiceVO.getTourDepId() != null) {
					Long acctId = null;
					boolean isExistInTourDepList = false;
					
					if (CollectionUtils.isNotEmpty(acctTourDepItemList)) {
						for (TourDepItemVO tdItemVO : acctTourDepItemList) {
							if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(tdItemVO.getCode()))
								acctId = tdItemVO.getAcctId();
							if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(tdItemVO.getCode()))
								acctId = tdItemVO.getAcctId();
							if (tdItemVO.getCode() != null && tdItemVO.getCode().equals(vo.getCode())) {
								acctId = tdItemVO.getAcctId();
								isExistInTourDepList = true;
								break;
							}
						}
					}
				
					if (acctId != null) {
						if (isExistInTourDepList) {
							invDetailsVO.setAcctId(acctId);
						} else {
							if (true == invoiceAndExchangeOrderVO.getIsDefAcct()) {
								invDetailsVO.setAcctId(invoiceAndExchangeOrderVO.getAcctId());
							} else invDetailsVO.setAcctId(acctId); // Set same with sgl or twn account
						}
					} else invDetailsVO.setAcctId(invoiceAndExchangeOrderVO.getAcctId());
				
					if (invDetailsVO.getAcctId() != null) {
						AcctVO acctVO = chartOfAcctBO.getAcctVO(invDetailsVO.getAcctId());
						if (acctVO.getSubCode().equals("")) {
							invDetailsVO.setSalesAcctCd(acctVO.getCode());
							invDetailsVO.setSalesAcctDesc(acctVO.getDesc());
						} else {
							invDetailsVO.setSalesAcctCd(acctVO.getCode() + "-" + acctVO.getSubCode());
							invDetailsVO.setSalesAcctDesc(acctVO.getDesc() + ", " + acctVO.getSubDesc());
						}
					}
				}
		        invoiceVO.getInvoiceItemList().add(invDetailsVO);
		    }
		    calTtlAmt();
		} else {
			if (isFromImportPassenger || isFromImportRemarks)
				vo = invoiceBO.getInvoiceById(vo.getId());
			
			// Move to addSelectedInvPaxList
			if (isFromImportPassenger) {
				invoiceBO.getInvoiceDetails(vo);
				
				invoicePaxSelectList = new ArrayList<InvoicePaxVO>();
				
				if (CollectionUtils.isNotEmpty(vo.getInvoicePaxList()) && vo.getInvoicePaxList().size() > 0) {
					invoicePaxSelectList = vo.getInvoicePaxList();
					for (InvoicePaxVO invoicePaxVO : invoicePaxSelectList) {
						loadReferenceNo(invoicePaxVO, false);
					}
					selectedInvPaxList = invoicePaxSelectList.toArray(new Object[invoicePaxSelectList.size()]);
				}
			}
//			if (isFromImportPassenger) {
//				boolean duplicateCustomer = false;
//				invoiceBO.getInvoiceDetails(vo);
//				for (InvoicePaxVO selectedInvoicePaxVO : vo.getInvoicePaxList()) {
//					if (invoiceVO.getInvoicePaxList() == null)
//						invoiceVO.setInvoicePaxList(new ArrayList<InvoicePaxVO>());
//					
//					boolean isSameCusExists = false;
//					for (InvoicePaxVO invoicePaxVO : invoiceVO.getInvoicePaxList()) {
//						if (invoicePaxVO.getCustId().equals(selectedInvoicePaxVO.getCustId())) {
//							isSameCusExists = true;
//							duplicateCustomer = true;
//							break;
//						}
//					}
//					
//					if (!isSameCusExists) {
//						selectedInvoicePaxVO.setId(null);
//						selectedInvoicePaxVO.setInvId(null);
//						selectedInvoicePaxVO.setTravelInsPolicy("");
//						invoiceVO.getInvoicePaxList().add(selectedInvoicePaxVO);
//					}
//				}
//				
//				if (duplicateCustomer) {
//					FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_WARN, "Duplicate customer will not added into listing.", "Duplicate customer will not added into listing");
//					FacesContext.getCurrentInstance().addMessage(null, msg);
//				}
//			}
			if (!isFromImportPassenger) calculateTotalUApple(invoiceVO.getCustDetailsVO(), invoiceVO.getInvoicePaxList());
			if (isFromImportRemarks) {
				invoiceVO.setRemarks(invoiceVO.getRemarks() + "\n" + vo.getRemarks());
			}
		}
		
		isFromImportPassenger = false;
		isFromImportRemarks = false;
		isFromImportAttachment = false;
		isFromImportINVDetails = false;
	}
	
	public void addSelectedInvPaxList() {
		try {
			boolean duplicateCustomer = false;
			for (Object obj : selectedInvPaxList) {
				InvoicePaxVO invPaxVO = (InvoicePaxVO) obj;
        		if (invoiceVO.getInvoicePaxList() == null)
					invoiceVO.setInvoicePaxList(new ArrayList<InvoicePaxVO>());
				
				boolean isSameCusExists = false;
				for (InvoicePaxVO invoicePaxVO : invoiceVO.getInvoicePaxList()) {
					if (invoicePaxVO.getCustId().equals(invPaxVO.getCustId())) {
						isSameCusExists = true;
						duplicateCustomer = true;
						break;
					}
				}
				
				if (!isSameCusExists) {
					invPaxVO.setId(null);
					invPaxVO.setInvId(null);
					invPaxVO.setTravelInsPolicy("");
					for (InvoicePaxRefNoVO invoicePaxRefNoVO : invPaxVO.getInvoicePaxRefNoList()) {
						invoicePaxRefNoVO.setId(null);
						invoicePaxRefNoVO.setInvPaxId(null);
					}
					invoiceVO.getInvoicePaxList().add(invPaxVO);
				}
        	}
			
			if (duplicateCustomer) {
				FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_WARN, "Duplicate customer will not added into listing.", "Duplicate customer will not added into listing");
				FacesContext.getCurrentInstance().addMessage(null, msg);
			}
			
			calculateTotalUApple(invoiceVO.getCustDetailsVO(), invoiceVO.getInvoicePaxList());

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

