	/**
	 * Load Invoice EO item list
	 */
	public void loadInvEOItemList() {
		try {
			resetFilteredObjList();
			if (StringUtils.isEmpty(invoiceVO.getCatCd())) {
				FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_WARN, "Please select invoice category!", "");
				FacesContext.getCurrentInstance().addMessage(null, msg);
				return;
			}
			
			String invItemCat = null; // Search for default only
			if (invItemListDefaultOnly == true) {
				invItemCat = ProductConstant.INV_ITM_CAT_DEFAULT;
			}
			
			List<String> excludeInvItemCatList = new ArrayList<String>();
			if (docTypeCd.equals(SalesConstant.DOC_TYPE_CD_PAX_STMT) && !invItemListDefaultOnly) {
				excludeInvItemCatList.add(ProductConstant.INV_ITM_CAT_DEFAULT);
			}
			
			invEOItemViewList = invoiceBO.getInvEOItemViewList(this.getSessionInfoBean().getCompanyVO().getId(),
					invPmntAuthVO.isAccountManager(), invoiceVO.getCatCd(), invItemCat, excludeInvItemCatList);
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
