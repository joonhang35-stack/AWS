	/**
	 * Handle file upload
	 * @param event
	 */
	public void handleFileUpload(FileUploadEvent event) {
		try {
			isTmpFile = true;
			// rename the valid file name
			fileName = event.getFile().getFileName();
			fileName = fileName.replace(" ", "_");
			SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMddHHmmss");
			fileName = sdf.format(new Date()) + "_" + fileName;
			
			String destinationPath = "";
			if (isAttachmentUpload) {
				invoiceAttachmentVO.setName(fileName);
				invoiceAttachmentVO.setFilePath(UUID.randomUUID().toString() + "." + FilenameUtils.getExtension(fileName));
				
				attachmentUploadedFile = event.getFile();
			} else {
				if(identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_PASSPRT)) {
					destinationPath = destinationPassportPath;
				} else {
					destinationPath = destinationVisaPath;
				}
				
				identityVO.getIdentityDetailVO().setFilePath(UUID.randomUUID().toString() + "." + FilenameUtils.getExtension(fileName));
				
				//fileUploadUtils.getMap().put(fileName, new FileUploadVO(event.getFile(), destinationPath, identityVO.getIdentityDetailVO().getFilePath()));
				fileUploadUtils.uploadSingleFile(event.getFile(), destinationPath, identityVO.getIdentityDetailVO().getFilePath(), null, null, false);
			}
			
			//uploadedFile = fileName;
			if (isAttachmentUpload) {
				invoiceAttachmentVO.setScannedPath(fileName);
				fileUploadUtils.getDelTmpList().add(destinationTmpPath + File.separator + invoiceAttachmentVO.getFilePath());
			}
			else
				identityVO.getIdentityDetailVO().setScannedPath(fileName);
			
			FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_INFO, "Success! ", event.getFile().getFileName() + " is uploaded.");
			FacesContext.getCurrentInstance().addMessage(null, msg);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handlePaxFileUploadPassport(FileUploadEvent event) {
		try {
			// rename the valid file name
			fileName = event.getFile().getFileName();
			fileName = fileName.replace(" ", "_");
			String destinationPath = "";
			
			if(invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdType().equals(CommonConstant.LOOKUP_ITM_ID_PASSPRT)) {
				destinationPath = destinationPassportPath;
			} else {
				destinationPath = destinationVisaPath;
			}
			
			invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdentityDetailVO().setFilePath(UUID.randomUUID().toString() + "." + FilenameUtils.getExtension(fileName));
			
			fileUploadUtils.uploadSingleFile(event.getFile(), destinationPath, invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdentityDetailVO().getFilePath(),
					null, null, false);
			
			invoicePaxVO.getCustDetailsVO().getPassportIdVO().setUploadedFile(fileName);
			invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdentityDetailVO().setScannedPath(fileName);
			
			FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_INFO, "Success! ", event.getFile().getFileName() + " is uploaded.");
			FacesContext.getCurrentInstance().addMessage(null, msg);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handlePaymentFileUpload(FileUploadEvent event) {
		try {
//			if (CollectionUtils.isEmpty(invoicePaymentVO.getInvoicePaymentAttachmentList())) {
//				invoicePaymentVO.setInvoicePaymentAttachmentList(new ArrayList<InvoicePaymentAttachmentVO>());
//			}
			
			// rename the valid file name
			fileName = event.getFile().getFileName();
			fileName = fileName.replace(" ", "_");
			SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMddHHmmss");
			fileName = sdf.format(new Date()) + "_" + fileName;
			
			InvoicePaymentAttachmentVO attachVO = new InvoicePaymentAttachmentVO();
			
			attachVO.setTypeCd("attachment");
			attachVO.setScannedPath(fileName);
			attachVO.setFilePath(UUID.randomUUID().toString() + "." + FilenameUtils.getExtension(fileName));
			attachVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
			
			if (invoicePaymentVO.getId() != null && event.getFile() != null) {
				pmntFileUploadUtils.uploadSingleFile(event.getFile(), destinationPaymentAttachmentPath, attachVO.getFilePath(), null, null, false);

				attachVO.setIdInvPmnt(invoicePaymentVO.getId());
				invoiceBO.addDeleteInvoicePaymentAttachment(attachVO, false);
				invoicePaymentVO.getInvoicePaymentAttachmentList().add(attachVO);
				
				FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_INFO, "Success! ", event.getFile().getFileName() + " is uploaded.");
				FacesContext.getCurrentInstance().addMessage(null, msg);
			} else {
				FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_ERROR, "Error! ", event.getFile().getFileName() + " is not upload.");
				FacesContext.getCurrentInstance().addMessage(null, msg);
			}
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void handleAttachmentFileUpload(FileUploadEvent event) {
		isAttachmentUpload = true;
		handleFileUpload(event);
	}
	
	public void loadPrefixVal(String docTypeCd) {
		setDocTypeCd(docTypeCd);
		// Credit Note
		if (docTypeCd.equals("C")) {
			prefixValue = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_CRDT_NOTE).getPrefixid();
			setDocTypeDesc("Credit Note");
		} else if (docTypeCd.equals("P")) {
			prefixValue = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_PAX_STMT).getPrefixid();
			setDocTypeDesc("Pax Statement");
		} else {
			prefixValue = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_INVC).getPrefixid();
			setDocTypeDesc("Invoice");
		}
		invPrefixVal = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_INVC).getPrefixid();
		psPrefixVal = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_PAX_STMT).getPrefixid();
	}
	
	public void handleInvRefNoClick(String code, String docTypeCd) {
		try {
			TrackingLogUtils.printLogs("CYY code, docTypeCd: " + code + ", " + docTypeCd);
			InvoiceVO invoiceVO = invoiceBO.getInvoiceByCode(code, docTypeCd);
			handleInvRefNoClick(invoiceVO.getId(), false);
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void handleInvRefNoClick(InvoiceReferenceVO vo) {
		handleInvRefNoClick(vo.getInvRefId(), false);
	}
	
	public void handleInvRefNoClick(InvoiceVO vo) {
		TrackingLogUtils.printLogs("CYY handleInvRefNoClick vo.getId(): " + vo.getId());
		handleInvRefNoClick(vo.getId(), false);
	}
	
	public void handleInvRefNoClick(String invNoWithPrefix) {
		try {
			TrackingLogUtils.printLogs("CYY handleInvRefNoClick invNoWithPrefix: " + invNoWithPrefix);
			if (invNoWithPrefix.contains(psPrefixVal)) {
				setDocTypeCd(SalesConstant.DOC_TYPE_CD_PAX_STMT);
			} else if (invNoWithPrefix.contains(invPrefixVal)) {
				setDocTypeCd(SalesConstant.DOC_TYPE_CD_INVC);
			} else {
				// no prefix, old invoice before 2025
				setDocTypeCd(SalesConstant.DOC_TYPE_CD_INVC);
			}
			String invNoWithoutPrefix = invNoWithPrefix.replace(psPrefixVal, "").replace(invPrefixVal, "");
//			System.out.println(invNoWithoutPrefix);
//			System.out.println(getDocTypeCd());
			InvoiceVO invoiceVO = invoiceBO.getInvoiceByCode(invNoWithoutPrefix, getDocTypeCd());
			handleInvRefNoClick(invoiceVO);
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void handleInvRefNoClick(Object invId, Boolean isString) {
//		System.out.println("InvoiceBean.handleInvRefNoClick()");
		TrackingLogUtils.printLogs("CYY handleInvRefNoClick invId, isString: " + invId + ", " + isString);
		try {
			trackingLogUtils.startLogs();
			
			//addEdit = false;
			if (isString) {
				invRefVO = invoiceBO.getInvoiceByCode((String) invId);
			}
			else {
				invRefVO = invoiceBO.getInvoiceById((Long) invId);
//				System.out.println("CYY invId: " + invId);
			}
			//setOriObj(invRefVO.clone());
			
			loadPrefixVal(invRefVO.getDocTypeCd());
			
			//set the transferred date to this format (dd-MMM-yyyy)
			if (invRefVO.getTransferredDate() != null) {
				SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy");
				String formatedTransferredDate = sdf.format(invRefVO.getTransferredDate());
				invRefVO.setFormattedTransferredDate(formatedTransferredDate);
			}
			
			invoiceBO.getInvoiceDetails(invRefVO);
			invRefCustDetailsVO = invRefVO.getCustDetailsVO();
			invRefVO.setIssuedBy(getUserName(invRefVO.getIssuerId()));
			invRefVO.setIdAcctGST(this.getSessionInfoBean().getCompanyVO().getIdAcctGST());
		
			if (CollectionUtils.isNotEmpty(invRefVO.getInvoicePaxList())) {
				for (InvoicePaxVO invoicePaxVO : invRefVO.getInvoicePaxList()) {
					if (invoicePaxVO.getCustDetailsVO() != null && CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getIdentityList())) {
						CustDetailsVO custDtlVO = invoicePaxVO.getCustDetailsVO();
						for (IdentityVO idVO : custDtlVO.getIdentityList()) {
							if (StringUtils.equals(idVO.getIdType(), CommonConstant.LOOKUP_ITM_ID_NRIC)) {
								custDtlVO.setNricIdVO((IdentityVO) idVO.clone());
								custDtlVO.getNricIdVO().setIdNo(idVO.getIdNo());
								invoicePaxVO.getCustDetailsVO().setAge(CalculationUtils.calculateAgeByIdNo(custDtlVO.getNricIdVO().getIdNo()));
								continue;
							}
							if (StringUtils.equals(idVO.getIdType(), CommonConstant.LOOKUP_ITM_ID_PASSPRT)) {
								custDtlVO.setPassportIdVO((IdentityVO) idVO.clone());
								custDtlVO.getPassportIdVO().setIdNo(idVO.getIdNo());
								if (idVO.getIdentityDetailVO() != null) {
									custDtlVO.getPassportIdVO().setIdentityDetailVO((IdentityDetailVO) idVO.getIdentityDetailVO().clone());
									custDtlVO.getPassportIdVO().setUploadedFile(custDtlVO.getPassportIdVO().getIdentityDetailVO().getScannedPath());
									continue;
								} else {
									custDtlVO.getPassportIdVO().setIdentityDetailVO(new IdentityDetailVO());
									custDtlVO.getPassportIdVO().getIdentityDetailVO().setIdCountry(CommonConstant.DEF_COUNTRY_ID);
								}
							}
						}
						loadReferenceNo(invoicePaxVO, false);
					}
				}
			}
			
			if (StringUtils.isNotBlank(invRefVO.getNoteItems())) {
				List<String> noteItemsList = Arrays.asList(invRefVO.getNoteItems().split(","));
				invRefVO.setNoteItemsList(noteItemsList);
			}
			
			AcctVO acctVO = new AcctVO();
			if (invRefVO.getAcctId() != null) {
				acctVO = chartOfAcctBO.getAcctVO(invRefVO.getAcctId());
			} else {
				acctVO = chartOfAcctBO.getAcctVO(this.getSessionInfoBean().getCompanyVO().getIdAcctSales());
			}
			invRefAcctVO = acctVO;
			
			calTtlAmt(invRefVO);
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("onInvoiceSelected");
		}
	}
	
	public void handleInvAttachmentClick(InvoiceAttachmentVO vo) {
		invoiceAttachmentVO = vo;
		if(invoiceAttachmentVO.getId() == null) {
			isTmpFile = true;
		}else
			isTmpFile = false;
		invoiceAttachmentOriVO = SerializationUtils.clone(vo);
	}
	
	/**
	 * Delete scanned copy
	 */
	public void delScannedCopy() {
		try {
			String destinationPath;
			if(identityVO.getIdType().equals(CommonConstant.LOOKUP_ITM_ID_PASSPRT)) {
				destinationPath = destinationPassportPath;
			} else {
				destinationPath = destinationVisaPath;
			}
			
			fileUploadUtils.getDelList().add(destinationPath + File.separator + identityVO.getIdentityDetailVO().getFilePath());
			if (fileUploadUtils.getMap().size() > 0) {
				fileUploadUtils.deleteFileFromMap(identityVO.getIdentityDetailVO().getFilePath());
			}
			
			//uploadedFile = "";
			identityVO.getIdentityDetailVO().setScannedPath(null);
			identityVO.getIdentityDetailVO().setFilePath(null);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void delPaxScannedPassport() {
		try {
			String destinationPath;
			if(invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdType().equals(CommonConstant.LOOKUP_ITM_ID_PASSPRT)) {
				destinationPath = destinationPassportPath;
			} else {
				destinationPath = destinationVisaPath;
			}
			
			fileUploadUtils.getDelList().add(destinationPath + File.separator + invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdentityDetailVO().getFilePath());
			if (fileUploadUtils.getMap().size() > 0) {
				fileUploadUtils.deleteFileFromMap(invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdentityDetailVO().getFilePath());
			}
			
			invoicePaxVO.getCustDetailsVO().getPassportIdVO().setUploadedFile("");
			invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdentityDetailVO().setScannedPath(null);
			invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdentityDetailVO().setFilePath(null);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void delAttachmentScannedCopy() {
		try {
			deletedFilePath = invoiceAttachmentVO.getFilePath();
			invoiceAttachmentVO.setScannedPath(null);
			invoiceAttachmentVO.setFilePath(null);
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
