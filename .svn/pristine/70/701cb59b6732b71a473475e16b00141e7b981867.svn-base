	/**
	 * Reset invoice item form
	 * @throws BusinessException
	 */
	public void resetInvItemForm() {
		invItemAdd = true;
		invoiceItemVO = new InvoiceItemVO();
		invoiceItemOrgVO = new InvoiceItemVO();
		invoiceItemVO.setSalesAcctCd("");
		invoiceItemVO.setInvItemCd("");
		invoiceItemVO.setQty(1);
		invoiceItemVO.setUnitPrice(0.0);
		invoiceItemVO.setAmount(0.0);
	}
	
	public void editInvoiceItemSeq() {
		if (isEditSeq) isEditSeq = false;
		else isEditSeq = true;
	}
	
	public void editInvoicePaxSeq() {
		if (isEditPaxSeq) isEditPaxSeq = false;
		else isEditPaxSeq = true;
	}
	
	public void editInvoicePmntSeq() {
		if (isEditPmntSeq) isEditPmntSeq = false;
		else isEditPmntSeq = true;
	}
	
	public void editInvoiceDetailBookingSync() {
		if (isEditBookingSync) isEditBookingSync = false;
		else isEditBookingSync = true;
	}

	/**
	 * Reset invoice payment form
	 * @throws BusinessException
	 */
	public void resetInvPaxForm() throws BusinessException {
		invPaxAdd = true;
		invoicePaxVO = new InvoicePaxVO();
		invoicePaxOrgVO = new InvoicePaxVO();
		invoicePaxVO.setCustDetailsVO(new CustDetailsVO());
		if (invoicePaxVO.getCustDetailsVO().getCountryId() == null) invoicePaxVO.getCustDetailsVO().setCountryId(CommonConstant.DEF_COUNTRY_ID);
		resetInvPaxPassanger();
		resetFileUploadForm();
		
		// For ticketing [ti]
		if (invoiceVO.getCatCd() != null && invoiceVO.getCatCd().equalsIgnoreCase(CommonConstant.LOOKUP_ITM_INV_CAT_TICKETING)) {
			invoicePaxVO.setRoomTypeCd(CommonConstant.LOOKUP_ITM_ROOM_TYPE_NA);
			invoicePaxVO.setRoomPairingNo(0);
			invoicePaxVO.setTravelInsType(CommonConstant.LOOKUP_ITM_TRVL_INS_NA);
		}
	}

	/**
	 * Reset invoice pax passanger
	 * @throws BusinessException
	 */
	public void resetInvPaxPassanger() throws BusinessException {
		personLangVO = new PersonLangVO();
		personMealVO = new PersonMealVO();
		personContactVO = new PersonContactVO();
		identityVO = new IdentityVO();
		identityCloneVO = new IdentityVO();
		identityVO.setIdentityDetailVO(new IdentityDetailVO());
		identityCloneVO.setIdentityDetailVO(new IdentityDetailVO());
		personEmailVO = new PersonEmailVO();
		invoicePaxRefNoVO = new InvoicePaxRefNoVO();
		tempInvoicePaxRefNoList = new ArrayList<InvoicePaxRefNoVO>();
		
		if (invoicePaxVO != null) {
			if (invoicePaxVO.getInvoicePaxRefNoList() == null) invoicePaxVO.setInvoicePaxRefNoList(new ArrayList<InvoicePaxRefNoVO>());
			
			if (invoicePaxVO.getCustDetailsVO() != null) {
				if (invoicePaxVO.getCustDetailsVO().getLangList() == null) invoicePaxVO.getCustDetailsVO().setLangList(new ArrayList<PersonLangVO>());
				if (invoicePaxVO.getCustDetailsVO().getMealList() == null) invoicePaxVO.getCustDetailsVO().setMealList(new ArrayList<PersonMealVO>());
				if (invoicePaxVO.getCustDetailsVO().getContactList() == null) invoicePaxVO.getCustDetailsVO().setContactList(new ArrayList<PersonContactVO>());
				if (invoicePaxVO.getCustDetailsVO().getIdentityList() == null) invoicePaxVO.getCustDetailsVO().setIdentityList(new ArrayList<IdentityVO>());
				if (invoicePaxVO.getCustDetailsVO().getAttachmentList() == null) invoicePaxVO.getCustDetailsVO().setAttachmentList(new ArrayList<PersonAttachmentVO>());
				if (invoicePaxVO.getCustDetailsVO().getEmailList() == null) invoicePaxVO.getCustDetailsVO().setEmailList(new ArrayList<PersonEmailVO>());
				
				invoicePaxVO.getCustDetailsVO().setNricIdVO(new IdentityVO());
				invoicePaxVO.getCustDetailsVO().getNricIdVO().setIdType(CommonConstant.LOOKUP_ITM_ID_NRIC);
				invoicePaxVO.getCustDetailsVO().getNricIdVO().setIdentityDetailVO(new IdentityDetailVO());
				invoicePaxVO.getCustDetailsVO().setPassportIdVO(new IdentityVO());
				invoicePaxVO.getCustDetailsVO().getPassportIdVO().setIdType(CommonConstant.LOOKUP_ITM_ID_PASSPRT);
				invoicePaxVO.getCustDetailsVO().getPassportIdVO().setIdentityDetailVO(new IdentityDetailVO());
				if (invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdentityDetailVO().getIdCountry() == null)
					invoicePaxVO.getCustDetailsVO().getPassportIdVO().getIdentityDetailVO().setIdCountry(CommonConstant.DEF_COUNTRY_ID);
				
				if (invoicePaxVO.getCustDetailsVO().getAddressVO() == null) {
					invoicePaxVO.getCustDetailsVO().setAddressVO(new AddressVO());
					invoicePaxVO.getCustDetailsVO().getAddressVO().setCountryId(CommonConstant.DEF_COUNTRY_ID);
					invoicePaxVO.getCustDetailsVO().getAddressVO().setAddrType(CommonConstant.BILL_ADDR);
				}
				if (invoicePaxVO.getCustDetailsVO().getMailAddressVO() == null) {
					invoicePaxVO.getCustDetailsVO().setMailAddressVO(new AddressVO());
					invoicePaxVO.getCustDetailsVO().getMailAddressVO().setCountryId(CommonConstant.DEF_COUNTRY_ID);
					invoicePaxVO.getCustDetailsVO().getMailAddressVO().setAddrType(CommonConstant.MAIL_ADDR);
				}
			}
		}
	}
	
