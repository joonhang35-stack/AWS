	public void beforeSplitPaxStatement() {
		try {
			paxStmtChildCnt = null;
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void onSplitPaxStatement() {
		try {
			summaryInvoiceVO = new InvoiceVO();
			splitInvoiceList = new ArrayList<InvoiceVO>();	
			
			for (InvoiceItemVO itemVO : invoiceVO.getInvoiceItemList()) {
				InvoiceItemVO clonedItemVO = SerializationUtils.clone(itemVO);
				summaryInvoiceVO.getInvoiceItemList().add(clonedItemVO);
			}
			
			for (InvoicePaymentVO itemVO : invoiceVO.getInvoicePaymentList()) {
				InvoicePaymentVO clonedItemVO = SerializationUtils.clone(itemVO);
//				clonedItemVO.setAmount(null); // fix onChangeSubPayment NullPointerException
				clonedItemVO.setAmount(0.0);
				summaryInvoiceVO.getInvoicePaymentList().add(clonedItemVO);
			}
			
			for (int j = 0; j < paxStmtChildCnt; j++) {
				InvoiceVO vo = new InvoiceVO();
				vo.setCode(String.valueOf(j + 1));
				
				// init billing person
				vo.setCustDetailsVO(SerializationUtils.clone(custDetailsVO));
				vo.setCustomerId(invoiceVO.getCustomerId());
				vo.setAttnTo(invoiceVO.getAttnTo());
				
				// init invoice item
				vo.setInvoiceItemList(new ArrayList<InvoiceItemVO>());
				for (InvoiceItemVO itemVO : invoiceVO.getInvoiceItemList()) {
					InvoiceItemVO clonedItemVO = SerializationUtils.clone(itemVO);
					clonedItemVO.setQty(itemVO.getQty() / paxStmtChildCnt);
//					onChangeSubItem(clonedItemVO);
//					System.out.println(itemVO.getQty() / paxStmtChildCnt * paxStmtChildCnt);
					vo.getInvoiceItemList().add(clonedItemVO);
				}
				
				// init invoice pax
				vo.setInvoicePaxList(new ArrayList<InvoicePaxVO>());
				vo.setSelectedPaxIds(new ArrayList<String>());
				vo.setPassengerListForSplit(new ArrayList<InvoicePaxVO>());
				for (InvoicePaxVO paxVO : invoiceVO.getInvoicePaxList()) {
					vo.getPassengerListForSplit().add(SerializationUtils.clone(paxVO));
				}
				
				// init invoice payment
				vo.setInvoicePaymentList(new ArrayList<InvoicePaymentVO>());
				for (InvoicePaymentVO paymentVO : invoiceVO.getInvoicePaymentList()) {
					InvoicePaymentVO clonedPaymentVO = SerializationUtils.clone(paymentVO);
					clonedPaymentVO.setAmount(0.0); // fix onChangeSubPayment NullPointerException
					clonedPaymentVO.setIdParentPmnt(paymentVO.getId());
					vo.getInvoicePaymentList().add(clonedPaymentVO);
				}
				
				vo.setAmount(0.0);
				vo.setAmtPaid(0.0);
				
				splitInvoiceList.add(vo);
			}
			
			for (int i = 0; i < invoiceVO.getInvoiceItemList().size(); i++) {
				InvoiceItemVO itemVO = invoiceVO.getInvoiceItemList().get(i);
//				System.out.println(itemVO.getQty() - itemVO.getQty() / paxStmtChildCnt * paxStmtChildCnt);
				for (int j = 0; j < itemVO.getQty() - itemVO.getQty() / paxStmtChildCnt * paxStmtChildCnt; j++) {
					InvoiceItemVO subItemVO = splitInvoiceList.get(j).getInvoiceItemList().get(i);
					subItemVO.setQty(subItemVO.getQty() + 1);
				}
				
			}
			
			summaryInvoiceVO.setAmount(0.0);
			
			// amount calculation
			for (InvoiceVO invoiceVO : splitInvoiceList) {
				
				// invoice item
				for (InvoiceItemVO itemVO : invoiceVO.getInvoiceItemList()) {
					itemVO.setAmount(itemVO.getQty() * itemVO.getUnitPrice());
					invoiceVO.setAmount(invoiceVO.getAmount() + itemVO.getAmount());
				}
				
				// invoice payment
				for (InvoicePaymentVO paymentVO : invoiceVO.getInvoicePaymentList()) {
					invoiceVO.setAmtPaid(invoiceVO.getAmtPaid() + paymentVO.getAmount());
				}
				
				summaryInvoiceVO.setAmount(summaryInvoiceVO.getAmount() + invoiceVO.getAmount());
			}
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);	
		} finally {
			
		}
	}
	
	public void splitPaxStatement() {
		trackingLogUtils.startLogs();
		try {
			
			validateSplit();
//			System.out.println("InvoiceBean.splitPaxStatement()");
			
//			for (InvoiceVO invoiceVO : splitInvoiceList) {
//				System.out.println(invoiceVO);
//				for (InvoiceItemVO vo : invoiceVO.getInvoiceItemList()) {
//					System.out.print(vo.getQty() + " ");
//					System.out.println(vo);
//					System.out.println("CYY " + vo.getQty() + "×" + vo.getUnitPrice() + "=" + vo.getAmount());
//				}
//				System.out.println();
//			}
			
//			if (splitInvoiceList.size() > 0) {
//				return;
//			}
			
//			System.out.println();
//			for (InvoiceVO invoiceVO : splitInvoiceList) {
//				for (String vo : invoiceVO.getSelected()) {
//					System.out.print(vo + " ");
//				}
//				System.out.println();
//			}
			
//			for (InvoiceVO invoiceVO : splitInvoiceList) {
//				for (InvoicePaymentVO vo : invoiceVO.getInvoicePaymentList()) {
//					System.out.print(vo.getAmount() + " ");
//				}
//				System.out.println();
//			}
			
//			for (InvoiceVO subInvoiceVO : splitInvoiceList) {
//				System.out.println(subInvoiceVO.getCustomerId());
//			}
//			
//			if (splitInvoiceList.size() > 0) {
//				return;
//			}
			
			int code = 1;
			if (invoiceVO.getSubPsRunningNumber() != null)	code += invoiceVO.getSubPsRunningNumber();
			for (InvoiceVO subInvoiceVO : splitInvoiceList) {
				InvoiceVO invoiceVO = SerializationUtils.clone(this.invoiceVO);
				invoiceVO.setPsNo(invoiceVO.getCode() + "-" + String.format("%03d", code));
				invoiceVO.setCode(invoiceVO.getCode() + "-" + String.format("%03d", code));
				invoiceVO.setIdParentInv(this.invoiceVO.getId());
				invoiceVO.setInvoiceItemList(subInvoiceVO.getInvoiceItemList());
//				invoiceVO.setInvoicePaxList(subInvoiceVO.getInvoicePaxList());
				
				invoiceVO.setCustomerId(subInvoiceVO.getCustDetailsVO().getCustId());
				invoiceVO.setAttnTo(subInvoiceVO.getCustDetailsVO().getContPersonName());
				invoiceVO.setCustDetailsVO(subInvoiceVO.getCustDetailsVO());
				
				// remove booking id to avoid error when redirecting from booking list to invoice page
				// when redirecting from booking list to invoice page, will show the parent pax statement
				invoiceVO.setIdParentInvTourBooking(invoiceVO.getBookingId());
				invoiceVO.setBookingId(null);
				
				invoiceVO.setInvoicePaxList(new ArrayList<InvoicePaxVO>());
				for (InvoicePaxVO vo : subInvoiceVO.getInvoicePaxList()) {
					InvoicePaxVO clonedInvoicePaxVO = SerializationUtils.clone(vo);
					clonedInvoicePaxVO.setId(null);
					invoiceVO.getInvoicePaxList().add(clonedInvoicePaxVO);
				}
				
				invoiceVO.setInvoicePaymentList(new ArrayList<InvoicePaymentVO>());
				for (InvoicePaymentVO paymentVO : subInvoiceVO.getInvoicePaymentList()) {
					if (!paymentVO.getAmount().equals(0.0)) {
						invoiceVO.getInvoicePaymentList().add(paymentVO);
					}
				}
//				invoiceVO.setInvoicePaymentList(subInvoiceVO.getInvoicePaymentList());
				
//				for (InvoicePaymentVO voo : invoiceVO.getInvoicePaymentList()) {
//					for (InvoicePaymentAttachmentVO vooo : voo.getInvoicePaymentAttachmentList()) {
//						System.out.println(vooo.getScannedPath());
//					}
//				}
				
//				if (invoiceVO.getInvoicePaymentList().size() > 0)
//				continue;
				
				calTtlAmt(invoiceVO);				
				invoiceBO.insertSubPaxStatement(invoiceVO, this.invoiceVO.getTourDepId(), false);
//				System.out.println(invoiceVO.getCode());
				code++;
			}
			invoiceBO.terminateAcctTrans(invoiceVO, CommonConstant.ACTION_CD_DEL);
			invoiceBO.updateInvoiceDocTypeStatus(this.invoiceVO.getId(), ProductConstant.PAX_STMT_STATUS_SPLIT);
//			InvoiceVO tempInvoiceVO = invoiceBO.getInvoiceById(invoiceVO.getId());
//			tempInvoiceVO.setSubPsRunningNumber(paxStmtChildCnt);
			invoiceBO.updateInvoiceSubPsRunningNumber(this.invoiceVO.getId(), invoiceVO.getSubPsRunningNumber() != null ? invoiceVO.getSubPsRunningNumber() + paxStmtChildCnt : paxStmtChildCnt);
			onInvoiceSelected(invoiceVO);
			invoiceBO.insertInvoiceHistory(invoiceVO.getId(), CommonConstant.ACTION_CD_UPD, "SPLIT");
			
			successResult();
			
			summaryInvoiceVO = new InvoiceVO();
			splitInvoiceList = new ArrayList<InvoiceVO>();	
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			trackingLogUtils.endLogs("splitPaxStatement");
		}
	}
	
	public void validateSplit() throws BusinessException {
		validateSplitItem();
		validateSplitPax();
		validateSplitPayment();
	}
	
	public void validateSplitItem() throws BusinessException {
		for (int j = 0; j < invoiceVO.getInvoiceItemList().size(); j++) {
			if (!invoiceVO.getInvoiceItemList().get(j).getAmount().equals(
					summaryInvoiceVO.getInvoiceItemList().get(j).getAmount()
					)) {
//				System.out.println(j);
				throw new BusinessException(CommonErrConstant.ERR_SPLIT_ITEM_NOT_TALLY, null, new String[] {invoiceVO.getInvoiceItemList().get(j).getDesc()});
			}
		}
		
		if (!invoiceVO.getAmount().equals(summaryInvoiceVO.getAmount())) {
//			System.out.println("!invoiceVO.getAmount().equals(summaryInvoiceVO.getAmount())");
			throw new BusinessException(CommonErrConstant.ERR_SPLIT_STMT_TOTAL_NOT_TALLY);
		}
	}
	
	public void validateSplitPayment() throws BusinessException {
		for (int j = 0; j < invoiceVO.getInvoicePaymentList().size(); j++) {
			if (!invoiceVO.getInvoicePaymentList().get(j).getAmount().equals(
					summaryInvoiceVO.getInvoicePaymentList().get(j).getAmount()
					)) {
//				System.out.println(j);
				throw new BusinessException(CommonErrConstant.ERR_SPLIT_PAYMENT_NOT_TALLY, String.valueOf(j));
			}
		}
		
		if (invoiceVO.getInvoicePaymentList().size() > 0 && !invoiceVO.getAmtPaid().equals(summaryInvoiceVO.getAmtPaid())) {
//			System.out.println("!invoiceVO.getAmtPaid().equals(summaryInvoiceVO.getAmtPaid())");
			throw new BusinessException(CommonErrConstant.ERR_SPLIT_PAYMENT_NOT_TALLY);
		}
	}
	
	public void validateSplitPax() throws BusinessException {
		for (InvoicePaxVO invoicePaxVO : invoiceVO.getInvoicePaxList()) {
			boolean found = false;
			int cnt = 0;
			
			for (InvoiceVO invoiceVO : splitInvoiceList) {
				for (InvoicePaxVO subPaxVO : invoiceVO.getInvoicePaxList()) {
					if (subPaxVO.getId().equals(invoicePaxVO.getId())) {
						found = true;
						cnt++;
					}
				}
			}
			
			if (!found) {
//				System.out.println(invoicePaxVO.getId());
				String name = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_SALUTATN, invoicePaxVO.getCustDetailsVO().getSalutation()) + " "
						+ invoicePaxVO.getCustDetailsVO().getFirstName() + " "
						+ invoicePaxVO.getCustDetailsVO().getLastName();
				throw new BusinessException(CommonErrConstant.ERR_SPLIT_PAX_MISSING, null, new String[] {name});
			}
			
			if (cnt > 1) {
//				System.out.println(invoicePaxVO.getId());
				throw new BusinessException(CommonErrConstant.ERR_SPLIT_PAX_DUPLICATE);
			}
		}
	}
	
	public void onChangeSubItem(InvoiceItemVO vo) {
//		System.out.println("InvoiceBean.onChangeSubItem()");
		try {
//			System.out.println(vo);
//			vo.setAmount(vo.getUnitPrice() * vo.getQty());
			vo.setAmount(CalcUtils.multiply(vo.getUnitPrice(), vo.getQty()).doubleValue()); // use BigDecimal
//			System.out.println("CYY " + vo.getQty() + "×" + vo.getUnitPrice() + "=" + vo.getAmount());
			
			for (InvoiceItemVO itemVO : summaryInvoiceVO.getInvoiceItemList()) {
				itemVO.setAmount(0.0);
				itemVO.setQty(0);
			}
			
			summaryInvoiceVO.setAmount(0.0);
			for (InvoiceVO invoiceVO : splitInvoiceList) {
				invoiceVO.setAmount(0.0);
				for (int j = 0; j < invoiceVO.getInvoiceItemList().size(); j++) {
//					summaryInvoiceVO.getInvoiceItemList().get(j).setAmount(
//							summaryInvoiceVO.getInvoiceItemList().get(j).getAmount() +
//							invoiceVO.getInvoiceItemList().get(j).getAmount()
//							);
					summaryInvoiceVO.getInvoiceItemList().get(j).setAmount(
							CalcUtils.add(
									summaryInvoiceVO.getInvoiceItemList().get(j).getAmount(), 
									invoiceVO.getInvoiceItemList().get(j).getAmount())
							.doubleValue()); // use BigDecimal
					summaryInvoiceVO.getInvoiceItemList().get(j).setQty(
							summaryInvoiceVO.getInvoiceItemList().get(j).getQty() +
							invoiceVO.getInvoiceItemList().get(j).getQty()); // qty is int type
//					invoiceVO.setAmount(invoiceVO.getAmount() + invoiceVO.getInvoiceItemList().get(j).getAmount());
					invoiceVO.setAmount(
							CalcUtils.add(
									invoiceVO.getAmount(), 
									invoiceVO.getInvoiceItemList().get(j).getAmount())
							.doubleValue()); // use BigDecimal
				}
//				summaryInvoiceVO.setAmount(summaryInvoiceVO.getAmount() + invoiceVO.getAmount());
				summaryInvoiceVO.setAmount(CalcUtils.add(summaryInvoiceVO.getAmount(), invoiceVO.getAmount()).doubleValue()); // use BigDecimal
			}
			
//			for (InvoiceVO invoiceVO : splitInvoiceList) {
//				for (InvoiceItemVO itemVO : invoiceVO.getInvoiceItemList()) {
//					if (vo.equals(itemVO)) {
//						itemVO.setQty(vo.getQty());
//					}
//				}
//			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void onChangeItemPax(InvoiceVO invoiceVO) {
		for (InvoiceItemVO itemVO : invoiceVO.getInvoiceItemList()) {
			itemVO.setQty(invoiceVO.getNumOfPax());
			itemVO.setAmount(itemVO.getUnitPrice() * itemVO.getQty());
		}
		
		for (InvoiceItemVO itemVO : summaryInvoiceVO.getInvoiceItemList()) {
			itemVO.setAmount(0.0);
			itemVO.setQty(0);
		}
		
		summaryInvoiceVO.setAmount(0.0);
//		summaryInvoiceVO
		for (InvoiceVO subInvoiceVO : splitInvoiceList) {
			subInvoiceVO.setAmount(0.0);
			for (int j = 0; j < subInvoiceVO.getInvoiceItemList().size(); j++) {
				summaryInvoiceVO.getInvoiceItemList().get(j).setAmount(
						summaryInvoiceVO.getInvoiceItemList().get(j).getAmount() +
						subInvoiceVO.getInvoiceItemList().get(j).getAmount());
				summaryInvoiceVO.getInvoiceItemList().get(j).setQty(
						summaryInvoiceVO.getInvoiceItemList().get(j).getQty() +
						subInvoiceVO.getInvoiceItemList().get(j).getQty());
				subInvoiceVO.setAmount(subInvoiceVO.getAmount() + subInvoiceVO.getInvoiceItemList().get(j).getAmount());
			}
			summaryInvoiceVO.setAmount(summaryInvoiceVO.getAmount() + subInvoiceVO.getAmount());
		}
	}
	
