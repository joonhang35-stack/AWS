	public void onConsolInvListToggle(AjaxBehaviorEvent e) {
		try {
			
			List<InvoiceVO> dataList = (List<InvoiceVO>) lazyConsolidateInvoiceList.getWrappedData();
			
			if (selectedInvoiceList.length > 0) {
				System.out.println("Select All");

				List<InvoiceVO> addList = new ArrayList<InvoiceVO>();
				
				for (InvoiceVO selectedInvVO : dataList) {
					boolean found = false;
					for (InvoiceVO savedInvVO : savedSelectedInvoiceList) {
						if (savedInvVO.getId().equals(selectedInvVO.getId())) {
							found = true;
							break;
						}
					}
					
					if (!found) {
						addList.add(selectedInvVO);
					}
				}
//				List <ExOrderBillVO> list =  lazyConsolDataModel.load(-1, -1, null, null, filters);
				savedSelectedInvoiceList.addAll(addList);
			} else {
				System.out.println("Unselect All");
				
				List<InvoiceVO> removeList = new ArrayList<InvoiceVO>();
				
				for (InvoiceVO selectedInvoiceVO : dataList) {
					for (InvoiceVO savedInvoiceVO : savedSelectedInvoiceList) {
						if (savedInvoiceVO.getId().equals(selectedInvoiceVO.getId())) {
							removeList.add(savedInvoiceVO);
							break;
						}
					}
				}
//				List <ExOrderBillVO> list =  lazyConsolDataModel.load(-1, -1, null, null, filters);
				savedSelectedInvoiceList.removeAll(removeList);
			}
			
			System.out.println("CYY onConsolInvListToggle savedSelectedInvoiceList.size(): " + savedSelectedInvoiceList.size());
			for (InvoiceVO vo : savedSelectedInvoiceList) {
//				System.out.println(vo.getCode());
			}
			
//			savedSelectedInvoiceList.addAll(invoiceBO.getInvoiceList(null));
//			lazyDataModel.	

//			e.
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void onPagination(PageEvent e){
		try {
