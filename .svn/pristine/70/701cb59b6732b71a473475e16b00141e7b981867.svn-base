	public void validatePostedInvoiceAmount() {
		try {
			boolean isPass = true;
			
			if(lockAmountChanges) {
				boolean isAcctIdSame = false;
				double totalItemAmount = 0.00;
				List<AppSettingVO> appSettingVOList = appSettingBO.getAppSettingList(ConstantAppSetting.MODULE_MAINT.getValue());
				List<AcctVO> accountExcludeVOList = new ArrayList<>();;
				for(AppSettingVO vo : appSettingVOList) {
					if (StringUtils.equals(vo.getModule().concat("_").concat(vo.getCode()), ConstantAppSetting.MAINT_POS_CONFIG_GL_ACCT_TO_EXCLUDE.getValue())) {
						
						if (StringUtils.isNotBlank(vo.getValue())) {
							List<String> acctExcludeList = Arrays.asList(vo.getValue().split(","));
							
							for (String acctExclude : acctExcludeList) {
								AcctVO acctVO = accountBO.getAcctVO(Long.valueOf(acctExclude));
								
								if (acctVO != null) accountExcludeVOList.add(acctVO);
							}
						}
					}
				}
				
				for(InvoiceItemVO itemVO : invoiceVO.getInvoiceItemList()) {
					for(AcctVO accountVO : accountExcludeVOList) {
						if(StringUtils.equals(String.valueOf(itemVO.getAcctId()), String.valueOf(accountVO.getId()))) {
							isAcctIdSame = true;
							break;
						}
					}
					if(!isAcctIdSame)
						totalItemAmount += itemVO.getAmount();
					else continue;
				}
				
//				if (posTotalAmountLocked != totalItemAmount) {
//					FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_ERROR, "Unable to save due to total amount does not match with posted amount (RM " + new BigDecimal(posTotalAmountLocked).setScale(2) + ")", "");
//					FacesContext.getCurrentInstance().addMessage(null, msg);
//					isPass = false;
//				}
			}
			RequestContext.getCurrentInstance().addCallbackParam("isPass", isPass);
		}catch(Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	private void invoiceItemAmountChecking(List<InvoiceItemVO> invoiceItemList) throws BusinessException {
		for(InvoiceItemVO vo : invoiceItemList) {
			if (vo.getQty() != 0 && vo.getUnitPrice() != 0.00 && vo.getAmount() == 0.00) {
				throw new BusinessException(CommonErrConstant.ERR_INV_ITEM_AMT_ZERO, null, new String[]{"[" + vo.getDesc() + "]"});
			}
		}
	}
	
	private void processAttachmentUploadFile() throws Exception {
		if (CollectionUtils.isNotEmpty(invoiceVO.getGenAUDInvoiceAttachmentVOList().getAddList()) ||
				CollectionUtils.isNotEmpty(invoiceVO.getGenAUDInvoiceAttachmentVOList().getUpdList()) ||
				CollectionUtils.isNotEmpty(invoiceVO.getGenAUDInvoiceAttachmentVOList().getDelList())) {
			fileUploadUtils.deleteFiles();
			if (fileUploadUtils.getMap().size() > 0) {
				fileUploadUtils.uploadFile();
			}
		}
	}
	
	private void processInvoicePaxAttachmentUploadFile() throws Exception {
		if (CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getAttachmentList())) {
			for (PersonAttachmentVO vo : invoicePaxVO.getCustDetailsVO().getAttachmentList()) {
				if (vo.getId() == null) {
					fileUploadUtils.uploadSingleFile(personAttachmentVO.getUploadedFile(), destinationPersonAttachmentPath, vo.getFilePath(), destinationPersonAttachmentPath + "/tmp", vo.getFilePath(), true);
					fileUploadUtils.deleteFile(destinationPersonAttachmentPath + "/tmp", vo.getFilePath());
				}
			}
		}
	}
	
	/**
	 * Reinsert multiple list item
	 */
	public void rewriteMultipleList() {
		invoiceItemVOList.setAddList(new ArrayList<Object>());
		invoicePaxVOList.setAddList(new ArrayList<Object>());
		invoicePaymentVOList.setAddList(new ArrayList<Object>());
		eoInvVOList.setAddList(new ArrayList<Object>());
		
		for (InvoiceItemVO vo : invoiceVO.getInvoiceItemList()) {
			if (vo.getId() == null) {
				invoiceItemVOList.getAddList().add(vo);
			}
		}
		
		for (InvoicePaxVO vo : invoiceVO.getInvoicePaxList()) {
			if (vo.getId() == null) {
				invoicePaxVOList.getAddList().add(vo);
			}
		}
		
		for (InvoicePaymentVO vo : invoiceVO.getInvoicePaymentList()) {
			if (vo.getId() == null) {
				invoicePaymentVOList.getAddList().add(vo);
			}
		}
		
		for (EOInvoiceVO vo : invoiceVO.getEoInvList()) {
			if (vo.getId() == null) {
				eoInvVOList.getAddList().add(vo);
			}
		}
	}
	
