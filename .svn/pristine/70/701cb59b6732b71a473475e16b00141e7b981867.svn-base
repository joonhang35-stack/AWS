	public void syncBookingWithInvoiceItem(InvoiceItemVO vo) {
		try {
			if (invoiceVO.getBookingVO() != null && invoiceVO.getBookingVO().getId() != null) {
				if (vo.getQty() != invoiceVO.getBookingVO().getQuantity()) {
					invoiceItemOrgVO = vo;
					setEditInvoiceItem(vo, invoiceItemVO);
					
					if (invoiceItemVO.isSyncBooking() == true) {
						invoiceItemVO.setPrevQty(vo.getQty());
						invoiceItemVO.setQty(invoiceVO.getBookingVO().getQuantity());
					} else {
						invoiceItemVO.setQty(vo.getPrevQty());
					}
					
					handleAmountIncludeTaxChange();
					updateInvItem();
				}
			}
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	

