	/**
	 * On selected tour departure details
	 */
	public void handleTourDepSelect(SelectEvent event) throws BusinessException{
		try {
			TourDepartureVO vo = (TourDepartureVO) event.getObject();
			invoiceVO.setTourCd(vo.getCode());
			invoiceVO.setTourDepId(vo.getId());
			if(invoiceVO.getBookingId() == null) {
				if (StringUtils.isNotEmpty(invoiceVO.getCatCd()) && !invoiceVO.getCatCd().equalsIgnoreCase(CommonConstant.LOOKUP_ITM_INV_CAT_TOUR)) {
					invoiceVO.setDepartureDt(new Date());
				} else {
//					if(StringUtils.startsWithIgnoreCase("INS", invoiceVO.getTourCd()) ||
//							StringUtils.startsWithIgnoreCase("VISA", invoiceVO.getTourCd()) ||
//							StringUtils.startsWithIgnoreCase("PARKS-IN", invoiceVO.getTourCd()) ||
//							StringUtils.startsWithIgnoreCase("USJ-07", invoiceVO.getTourCd()) ||
//							StringUtils.startsWithIgnoreCase("USJ-JPN", invoiceVO.getTourCd()) ||
//							StringUtils.startsWithIgnoreCase("TKT", invoiceVO.getTourCd())) {
//						invoiceVO.setDepartureDt(new Date());
//					}else
//						invoiceVO.setDepartureDt(vo.getDtDep());
					invoiceVO.setDepartureDt(null);
					if (ProductConstant.TYPE_TOUR.equals(vo.getTourPkgTypeCd()) || ProductConstant.TYPE_MICE.equals(vo.getTourPkgTypeCd())) {
						invoiceVO.setDepartureDt(vo.getDtDep());
					}
				}
			}
			StringBuilder sb = new StringBuilder();
			if (vo.getNumDays() != 0) sb.append(vo.getNumDays() + "Days ");
			if (vo.getNumNights() != 0) sb.append(vo.getNumNights() + "Nights ");
			if (!StringUtils.isEmpty(vo.getNameEn())) sb.append(vo.getNameEn());
			if (!StringUtils.isEmpty(vo.getNameOther())) sb.append(" " + vo.getNameOther());
			if (!StringUtils.isEmpty(vo.getNameZh())) sb.append(" " + vo.getNameZh());
			if (!StringUtils.isEmpty(vo.getDesc())) sb.append(" [" + vo.getDesc() + "]");
			invoiceVO.setSubjLine(sb.toString());
			if (StringUtils.isNotEmpty(vo.getTourPkgTypeCd()) && StringUtils.isNotEmpty(vo.getLangCode()) &&
					ProductConstant.TYPE_TOUR.equals(vo.getTourPkgTypeCd())) {
				invoiceVO.setSubjLine(invoiceVO.getSubjLine() + " [" +
					LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_PRODUCT_LANG, vo.getLangCode()) +
				"]");
			}
			
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
