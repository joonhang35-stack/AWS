	public void loadReferenceNo(InvoicePaxVO invoicePaxVO, boolean isPrintOut) {
		// Grab all the reference numbers
		if (invoicePaxVO != null && CollectionUtils.isNotEmpty(invoicePaxVO.getInvoicePaxRefNoList())) {
		    List<InvoicePaxRefNoVO> invoicePaxRefNoList = invoicePaxVO.getInvoicePaxRefNoList();

		    StringBuilder fullReferenceNos = new StringBuilder();
		    String referenceNoPreview = "";

		    for (int i = 0; i < invoicePaxRefNoList.size(); i++) {
		        InvoicePaxRefNoVO invoicePaxRefNoVO = invoicePaxRefNoList.get(i);
		        String prefix = invoicePaxRefNoVO.getRefType() + ": ";

		        // Build the full reference list with line breaks
		        fullReferenceNos.append(prefix).append(invoicePaxRefNoVO.getRefNo());
		        if (isPrintOut) {
	        		fullReferenceNos.append("\n");
	        	} else {
	        		fullReferenceNos.append("<br/>");
	        	}

		        // Set preview reference based on the number of entries
		        if (i == 0) {
		            if (invoicePaxRefNoList.size() == 1) {
		                // Only one reference, no "......"
		                referenceNoPreview = prefix + invoicePaxRefNoVO.getRefNo();
		            } else {
		                // Multiple references, add "......" after the first
		                referenceNoPreview = prefix + invoicePaxRefNoVO.getRefNo() + " ......";
		            }
		        }
		    }

		    // Set the full reference number and preview reference number in CustDetailsVO
		    invoicePaxVO.setReferenceNo(fullReferenceNos.toString());      // Full reference list for tooltip
		    invoicePaxVO.setReferenceNoPreview(referenceNoPreview);        // Preview reference number
		}
	}

	/**
	 * Booking initial call from xhtml add new button
	 */
	public void initAddInvoice() {
		try {
			if (!fromBooking) resetForm();
			GSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), invoiceVO.getInvoiceDt());
			loadAll();
			if(CollectionUtils.isEmpty(employeeList)) {
				employeeList = invoiceBO.getEmployeeViewList(this.getSessionInfoBean().getCompanyVO().getId());
			}
			for(EmployeeViewVO vo : employeeList) {
				if(invoiceVO.getSalerId().equals(vo.getId())) {
					invoiceVO.setSalerName(vo.getUserVO().getName());
				}
				if (invoiceVO.getTfairSalerId() == null) {
					invoiceVO.setTfairSalerId(invoiceVO.getSalerId());
					invoiceVO.setTfairSalerName(invoiceVO.getSalerName());
					
				} else if (invoiceVO.getTfairSalerId() != null && invoiceVO.getTfairSalerId().equals(vo.getId())) {
					invoiceVO.setTfairSalerName(vo.getUserVO().getName());
				}
			}
			// Check Financial Period Closed
			invoiceVO.setDateInFinPeriodClosed(getFinPeriodClosedStatus());
			// Check Invoice Date changeable
			invoiceVO.setInvoiceDateChangeable(getInvoiceDateChangeable());
			
		} catch(Exception t) {
			errorResult(t);
		}
	}
	
