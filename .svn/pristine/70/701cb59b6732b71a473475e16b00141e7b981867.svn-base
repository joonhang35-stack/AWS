	public void onChangeSubPayment() {
//		System.out.println("InvoiceBean.onChangeSubPayment()");
		try {
			
			for (InvoiceVO invoiceVO : splitInvoiceList) {
				invoiceVO.setAmtPaid(0.0);
				for (InvoicePaymentVO pVo : invoiceVO.getInvoicePaymentList()) {
					if (pVo.getAmount() == null) {
						pVo.setAmount(0.0);
					}
//					invoiceVO.setAmtPaid(invoiceVO.getAmtPaid() + pVo.getAmount());
					invoiceVO.setAmtPaid(CalcUtils.add(invoiceVO.getAmtPaid(), pVo.getAmount()).doubleValue()); // use BigDecimal		
				}
			}
			
			for (InvoicePaymentVO itemVO : summaryInvoiceVO.getInvoicePaymentList()) {
				itemVO.setAmount(0.0);
			}
			
			summaryInvoiceVO.setAmtPaid(0.0);
//			summaryInvoiceVO
			for (InvoiceVO invoiceVO : splitInvoiceList) {
//				invoiceVO.setAmount(0.0);
				for (int j = 0; j < invoiceVO.getInvoicePaymentList().size(); j++) {
//					summaryInvoiceVO.getInvoicePaymentList().get(j).setAmount(
//							summaryInvoiceVO.getInvoicePaymentList().get(j).getAmount() +
//							invoiceVO.getInvoicePaymentList().get(j).getAmount());
					summaryInvoiceVO.getInvoicePaymentList().get(j).setAmount(
							CalcUtils.add(
									summaryInvoiceVO.getInvoicePaymentList().get(j).getAmount(), 
									invoiceVO.getInvoicePaymentList().get(j).getAmount())
							.doubleValue()); // use BigDecimal

				}
//				summaryInvoiceVO.setAmtPaid(summaryInvoiceVO.getAmtPaid() + invoiceVO.getAmtPaid());
				summaryInvoiceVO.setAmtPaid(CalcUtils.add(summaryInvoiceVO.getAmtPaid(), invoiceVO.getAmtPaid()).doubleValue()); // use BigDecimal
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
