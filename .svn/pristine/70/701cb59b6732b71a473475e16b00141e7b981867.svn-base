	public void downloadQRCode() {
		try {
			if (invoiceVO.geteInvoiceDocument() == null || invoiceVO.geteInvoiceValidationLink() == null) {
				return;
			}
			
			File file = QRCodeUtils.generateQRCodeFile(invoiceVO.geteInvoiceValidationLink(), "E-Invoice Validation QR Code", 300, 300);
			
			HttpServletResponse httpServletResponse = (HttpServletResponse) FacesContext.getCurrentInstance()
					.getExternalContext().getResponse();
			httpServletResponse.setContentType("image/png");
			httpServletResponse.addHeader("Content-disposition", "attachment; filename=" + file.getName());
			FileInputStream fileInputStream = new FileInputStream(file);
			ServletOutputStream outputStream = httpServletResponse.getOutputStream();

			byte[] buffer = new byte[1024];
			int bytesRead;

			while ((bytesRead = fileInputStream.read(buffer)) != -1) {
				outputStream.write(buffer, 0, bytesRead);
			}

			outputStream.flush();

			FacesContext.getCurrentInstance().responseComplete();

			successResult();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void submitMultipleEInvoice() {
		trackingLogUtils.startLogs();
		try {
			
			mulpInvSubmRespListExportTitle = "E_Invoice_Submission_List";
			
			if (savedSelectedInvoiceList.size() > CommonConstant.E_INV_MAX_DOC_CNT) {
				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null,
						new String[] { "Maximum document count in a submission is 20. "
								+ savedSelectedInvoiceList.size() + " is selected." });
			}
			
			EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO, invoiceBO, invoiceAndExchangeOrderBO, regionBO, malaysiaStateBO, chartOfAcctBO, corporateProfileBO);
			eInvoiceUtils.setMessageSource(messageSource);
			CompanyVO companyVO = corporateProfileBO.getCompanyDetails(getSessionInfoBean().getCompanyVO().getId());
			if (isEInvSubm) {
//				JSONObject submitResponse = eInvoiceUtils.submitInvoices(savedSelectedInvoiceList, companyVO.getId());
				JSONObject submitResponse = eInvoiceBO.submitInvoices(savedSelectedInvoiceList, companyVO.getId());
				eInvoiceUtils.processSubmitResponseInvoices(submitResponse, savedSelectedInvoiceList, companyVO.getId());
			}
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
		
		isEInvSubm = !isEInvSubm;
		mulpInvSubmRespList = new ArrayList<InvoiceVO>(savedSelectedInvoiceList);
		savedSelectedInvoiceList.clear();
		
		trackingLogUtils.endLogs("submitMultipleEInvoice");
	}
	
	/**********************
	 * Lazy loading model *
	 **********************/
	class LazyInvoiceDataModel extends LazyDataModel<InvoiceVO> implements Serializable {
		private static final long serialVersionUID = 1L;
		private String[] statusList;
		private Boolean isConsolEInv;
		private Date invDateFrom;
		private Date invDateTo;
		private Date depDateFrom;
		private Date depDateTo;
		
		public LazyInvoiceDataModel(String ...status) {
			statusList = status;
		}
		
		public LazyInvoiceDataModel(Boolean isConsolEInv, String ...status) {
			statusList = status;
			this.isConsolEInv = isConsolEInv;
		}
		
		public LazyInvoiceDataModel(Boolean isConsolEInv) {
			this.isConsolEInv = isConsolEInv;
		}
		
		public LazyInvoiceDataModel(Boolean isConsolEInv, Date invDateFrom, Date invDateTo, Date depDateFrom,
				Date depDateTo) {
//			super();
			this.isConsolEInv = isConsolEInv;
			this.invDateFrom = invDateFrom;
			this.invDateTo = invDateTo;
			this.depDateFrom = depDateFrom;
			this.depDateTo = depDateTo;
		}

		public LazyInvoiceDataModel(Date invDateFrom, Date invDateTo, Date depDateFrom, Date depDateTo, String[] statusList) {
//			super();
			this.statusList = statusList;
			this.invDateFrom = invDateFrom;
			this.invDateTo = invDateTo;
			this.depDateFrom = depDateFrom;
			this.depDateTo = depDateTo;
		}
		
		public LazyInvoiceDataModel(Date invDateFrom, Date invDateTo, Date depDateFrom, Date depDateTo) {
//			super();
			this.invDateFrom = invDateFrom;
			this.invDateTo = invDateTo;
			this.depDateFrom = depDateFrom;
			this.depDateTo = depDateTo;
		}

		/*
		 * (non-Javadoc)
		 * @see org.primefaces.model.LazyDataModel#load(int, int, java.lang.String, org.primefaces.model.SortOrder, java.util.Map)
		 */
		@Override
		public List<InvoiceVO> load(int first, int pageSize, String sortField, SortOrder sortOrder, Map<String, String> filters) {
			try {
				trackingLogUtils.startLogs();
				
				InvoiceBean.this.docFilters = filters;
//				System.out.println(first);
//				System.out.println(pageSize);
				
				// Config of Role that allow to view certain list by category code
				List<String> notViewableCatCode = new ArrayList<>();
				if (CollectionUtils.isNotEmpty(visibleConfigList)) {
					boolean isVisible = false;
					for (VisibleListingConfigVO vo : visibleConfigList) {
						isVisible = false;
						
						if (vo.getIdRoleList() != null) {
							for (String idRole : vo.getIdRoleList()) {
								for (UserRoleViewVO roleVO : getSessionInfo().getUserVO().getRoleList()) {
									if (roleVO.getRoleUUID().equals(idRole)) {
										isVisible = true;
										break;
									}
								}
							}
						}
						
						if (vo.getDepartmentList() != null) {
							for (String dept : vo.getDepartmentList()) {
								if (getSessionInfoBean().getEmployeeVO().getDepartment().equalsIgnoreCase(dept)) {
									isVisible = true;
									break;
								}
							}
						}
						
						if (!isVisible) notViewableCatCode.add(vo.getCatCd());
					}
				}
				
				Map<String, Object> params = new HashMap<String, Object>();
				params.put("companyId", getSessionInfoBean().getCompanyVO().getId());
				params.put("first", first);
				params.put("pageSize", pageSize);
				params.put("sortField", sortField);
				params.put("sortOrder", sortOrder);
				params.put("filters", filters);
				if (CollectionUtils.isNotEmpty(notViewableCatCode)) params.put("notViewableCatCode", notViewableCatCode);
				if (StringUtils.isNotBlank(orderSourceCode)) params.put("orderSourceCode", orderSourceCode);
				if (StringUtils.isNotBlank(invoiceCategoryCode)) params.put("invoiceCategoryCode", invoiceCategoryCode);
				if (StringUtils.isNotBlank(pmntStatus)) params.put("pmntStatus", pmntStatus);
				if (CollectionUtils.isNotEmpty(pmntStatusList)) params.put("pmntStatusList", pmntStatusList);
				if (StringUtils.isNotBlank(insIssued)) params.put("insIssued", insIssued);
				if (fromDate != null) params.put("fromDate", fromDate);
				if (toDate != null) params.put("toDate", toDate);
				if (StringUtils.isNotBlank(invFrom)) params.put("invFrom", invFrom);
				if (StringUtils.isNotBlank(invTo)) params.put("invTo", invTo);
				
				// to load consol e inv
				if (invDateFrom != null) params.put("fromDate", invDateFrom);
				if (invDateTo != null) params.put("toDate", invDateTo);
				if (depDateFrom != null) params.put("depDateFrom", depDateFrom);
				if (depDateTo != null) params.put("depDateTo", depDateTo);
				
				if (ArrayUtils.isNotEmpty(eInvoiceStatusList)) params.put("eInvoiceStatusList", eInvoiceStatusList);
				params.put("type", FunctionUtils.generateArrayFromStr(docTypeCd));
				if (statusList != null && statusList.length > 0)	params.put("docTypeStatus", statusList);
				if (isConsolEInv != null && isConsolEInv)	params.put("isConsolEInv", isConsolEInv);
//				System.out.println("CYY isConsolEInv:" + isConsolEInv);
				setRowCount(invoiceBO.getInvoiceListSize(params));
				
//				System.out.println("CYY getRowCount(): " + getRowCount());
				
//				System.out.println("CYY getRowCount(): " + getRowCount());
				
				if (savedSelectedInvoiceList != null && savedSelectedInvoiceList.size() > 0) {
					selectedInvoiceList = savedSelectedInvoiceList.toArray(new InvoiceVO[savedSelectedInvoiceList.size()]);
				}
				
				if (0 < getRowCount()) {
					invoiceList = invoiceBO.getInvoiceList(params);
					return invoiceList;
				}
				
			} catch (Throwable t) {
				t.printStackTrace();
				errorResult(t);
			} finally {
				trackingLogUtils.endLogs("LazyInvoiceDataModel");
			}
			return new ArrayList<InvoiceVO>();
		}
		
		@Override
		public void setRowIndex(int rowIndex) {
			/*
			 * The following is in ancestor (LazyDataModel):
			 * this.rowIndex = rowIndex == -1 ? rowIndex : (rowIndex % pageSize);
			 */
			if (rowIndex == -1 || getPageSize() == 0) {
				super.setRowIndex(-1);
			} else super.setRowIndex(rowIndex % getPageSize());
		}
		
	}
	
	class LazyInvRefDataModel extends LazyDataModel<InvoiceVO> implements Serializable {
		private static final long serialVersionUID = 1L;
		private boolean clearFilter;
		
		public LazyInvRefDataModel(boolean clearFilter) {
			this.clearFilter = clearFilter;
		}

		/*
		 * (non-Javadoc)
		 * @see org.primefaces.model.LazyDataModel#load(int, int, java.lang.String, org.primefaces.model.SortOrder, java.util.Map)
		 */
		@Override
		public List<InvoiceVO> load(int first, int pageSize, String sortField, SortOrder sortOrder, Map<String, String> filters) {
			try {
				trackingLogUtils.startLogs();
				
				if (clearFilter) filters.clear();
				
				Map<String, Object> params = new HashMap<String, Object>();
				params.put("companyId", getSessionInfoBean().getCompanyVO().getId());
				params.put("first", first);
				params.put("pageSize", pageSize);
				params.put("sortField", sortField);
				params.put("sortOrder", sortOrder);
				params.put("filters", filters);
//				params.put("type", "I");
//				params.put("type", docTypeCd);
				params.put("type", FunctionUtils.generateArrayFromStr(SalesConstant.DOC_TYPE_CD_PAX_STMT, SalesConstant.DOC_TYPE_CD_INVC));
				setRowCount(invoiceBO.getInvoiceListSize(params));
				if (0 < getRowCount()) return invoiceBO.getInvoiceList(params);
				
			} catch (Throwable t) {
				errorResult(t);
			} finally {
				clearFilter = false;
				trackingLogUtils.endLogs("LazyInvRefDataModel");
			}
			return null;
		}
		
		@Override
		public void setRowIndex(int rowIndex) {
			/*
			 * The following is in ancestor (LazyDataModel):
			 * this.rowIndex = rowIndex == -1 ? rowIndex : (rowIndex % pageSize);
			 */
			if (rowIndex == -1 || getPageSize() == 0) {
				super.setRowIndex(-1);
			} else super.setRowIndex(rowIndex % getPageSize());
		}
		
	}
	
	class LazyInvLogDataModel extends LazyDataModel<InvoiceVO> implements Serializable {
		private static final long serialVersionUID = 1L;

		/*
		 * (non-Javadoc)
		 * @see org.primefaces.model.LazyDataModel#load(int, int, java.lang.String, org.primefaces.model.SortOrder, java.util.Map)
		 */
		@Override
		public List<InvoiceVO> load(int first, int pageSize, String sortField, SortOrder sortOrder, Map<String, String> filters) {
			try {
				trackingLogUtils.startLogs();
				
				Map<String, Object> params = new HashMap<String, Object>();
				params.put("idHist", invoiceVO.getId());
				params.put("companyId", getSessionInfoBean().getCompanyVO().getId());
				params.put("first", first);
				params.put("pageSize", pageSize);
				params.put("sortField", sortField);
				params.put("sortOrder", sortOrder);
				params.put("filters", filters);
//				params.put("type", "I");
				params.put("type", docTypeCd);
				System.out.println("docTypeCd: " + docTypeCd);
				setRowCount(invoiceBO.getInvoiceHistoryListSize(params));
				if (0 < getRowCount()) return invoiceBO.getInvoiceHistoryList(params);
				
			} catch (Throwable t) {
				errorResult(t);
			} finally {
				trackingLogUtils.endLogs("LazyInvoiceLogDataModel");
			}
			return null;
		}
		
		@Override
		public void setRowIndex(int rowIndex) {
			/*
			 * The following is in ancestor (LazyDataModel):
			 * this.rowIndex = rowIndex == -1 ? rowIndex : (rowIndex % pageSize);
			 */
			if (rowIndex == -1 || getPageSize() == 0) {
				super.setRowIndex(-1);
			} else super.setRowIndex(rowIndex % getPageSize());
		}
		
	}
	
	/*******************************
	 * Lazy loading model Customer *
	 *******************************/
	class LazyCustomerDataModel extends LazyDataModel<CustomerVO> implements Serializable {
		private static final long serialVersionUID = 1L;
		
		/*
		 * (non-Javadoc)
		 * @see org.primefaces.model.LazyDataModel#load(int, int, java.lang.String, org.primefaces.model.SortOrder, java.util.Map)
		 */
		@Override
		public List<CustomerVO> load(int first, int pageSize, String sortField, SortOrder sortOrder, Map<String, String> filters) {
			List<CustomerVO> data = new ArrayList<CustomerVO>();
			
			try {
				trackingLogUtils.startLogs();
				
				Map<String, Object> params = new HashMap<String, Object>();
				params.put("idCompany", getSessionInfoBean().getCompanyVO().getId());
				params.put("nonCorporate", true);
				params.put("removeInactive", true);
				params.put("first", first);
				params.put("pageSize", pageSize);
				params.put("sortField", sortField);
				params.put("sortOrder", sortOrder);
				params.put("filters", filters);
				
				int size = customerBO.getCustomerListSize(params);
				if (CommonConstant.LAZY_ROW_COUNT < size) {
					size = CommonConstant.LAZY_ROW_COUNT;
				}
				setRowCount(size);
				if (size > 0) data = customerBO.getCustomerList(params);
				
			} catch (Throwable t) {
				errorResult(t);
			} finally {
				trackingLogUtils.endLogs("LazyCustomerDataModel");
			}
			return data;
		}
		
		@Override
		public void setRowIndex(int rowIndex) {
			/*
			 * The following is in ancestor (LazyDataModel):
			 * this.rowIndex = rowIndex == -1 ? rowIndex : (rowIndex % pageSize);
			 */
			if (rowIndex == -1 || getPageSize() == 0) {
				super.setRowIndex(-1);
			} else super.setRowIndex(rowIndex % getPageSize());
		}
	}
	
	/**
	 * Get Financial Period Closed Status
	 */ 
	public boolean getFinPeriodClosedStatus() {
		boolean rtn = false;
		try {
			rtn = LookupItemUtils.getFinAndGSTPeriodClosedStatus(this.getSessionInfoBean().getCompanyVO().getId(), invoiceVO.getInvoiceDt(), invPmntAuthVO.isAccountManager());
		} catch (Throwable t) {
			errorResult(t);
		}
		
		return rtn;
	}
	
	/**
	 * Get Invoice Date Changeable
	 */ 
	public boolean getInvoiceDateChangeable() {
		boolean rtn = true;
		try {
			// New Invoice with Invoice Date changeable role
			//boolean invDtChangeableFirstTime = ((invoiceVO.getId()==null) && invPmntAuthVO.isInvDtChangeableFirstTime());
			boolean invDtChangeableFirstTime = invPmntAuthVO.isInvDtChangeableFirstTime();
			
			String gstProcessStatus = LookupItemUtils.getGSTProcessStatus(this.getSessionInfoBean().getCompanyVO().getId(), invoiceVO.getInvoiceDt());
			finPeriodClosedStatus = LookupItemUtils.getFinPeriodClosedStatus(this.getSessionInfoBean().getCompanyVO().getId(), invoiceVO.getInvoiceDt());
			if (gstProcessStatus.equals(GSTProcessStatus.SUBMIT.getValue()) || finPeriodClosedStatus == -1) {
				rtn = false;
			} else if ((!gstProcessStatus.equals(GSTProcessStatus.SUBMIT.getValue()) && !(invDtChangeableFirstTime || invPmntAuthVO.isAccountManager())) ||
					(finPeriodClosedStatus != -1 && !(invDtChangeableFirstTime || invPmntAuthVO.isAccountManager()))) {
				rtn = false;
			}
		} catch (Throwable t) {
			errorResult(t);
		}
		
		return rtn;
	}
	
	public void handleNationalitySelected() {
		if (invoicePaxVO.getCustDetailsVO().getCountryId() != 129) {
			if (StringUtils.isBlank(invoicePaxVO.getCustDetailsVO().getTaxIdNo())) {
				invoicePaxVO.getCustDetailsVO().setTaxIdNo(EInvoiceConstant.E_INV_GNRL_TIN_F_BUYER);
			}
			
			if (StringUtils.isBlank(invoicePaxVO.getCustDetailsVO().getAddressVO().getCity())) {
				invoicePaxVO.getCustDetailsVO().getAddressVO().setCity(EInvoiceConstant.NOT_APPLICABLE);
			}
			
			if (StringUtils.isBlank(invoicePaxVO.getCustDetailsVO().getAddressVO().getState())) {
				invoicePaxVO.getCustDetailsVO().getAddressVO().setState(EInvoiceConstant.NOT_APPLICABLE);
			}
		}
	}
	
