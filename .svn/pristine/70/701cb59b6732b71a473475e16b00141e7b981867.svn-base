	public void validateSendToReview(InvoiceVO oriVO, CompanyVO companyVO) throws BusinessException {
		
		EInvoiceUtils eInvoiceUtils = new EInvoiceUtils(eInvoiceBO, invoiceBO, invoiceAndExchangeOrderBO, regionBO, malaysiaStateBO, chartOfAcctBO, corporateProfileBO);
		eInvoiceUtils.setMessageSource(messageSource);
		
		InvoiceVO invoiceVO = invoiceBO.getInvoiceById(oriVO.getId());
		invoiceVO = invoiceBO.getInvoiceDetails(invoiceVO);
		invoiceVO.seteInvoiceDocument(new EInvoiceDocument());
		invoiceVO.setCompanyVO(companyVO);
		oriVO.seteInvoiceDocument(new EInvoiceDocument());
		
        try {
        	InvoiceType invoiceType = eInvoiceBO.generateInvoiceType(invoiceVO, companyVO);
//        	if (!validateTaxpayerTin(invoiceVO, accessToken)) {
//	        	throw new BusinessException(CommonErrConstant.ERR_TAXPAYER_TIN_VALIDATION_FAILED);
//	        }
//        	invoiceTypeList.add(invoiceType);
        	
        	oriVO.setInvoiceType(invoiceType); // save generated e invoice info
        	oriVO.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_VALID);
		} catch (BusinessException b) {
			String errMsg = messageSource.getMessage(ErrorConstant.ERR_GENERAL_EXCEPTION, null, "System error", LocaleUtils.toLocale(BaseContext.getLocaleCode()));
			errMsg = messageSource.getMessage(b.getErrorCode(), b.getParameters(), errMsg, LocaleUtils.toLocale(BaseContext.getLocaleCode()));
			oriVO.geteInvoiceDocument().setStatus(EInvoiceConstant.E_INV_STATUS_INVALID);
			oriVO.geteInvoiceDocument().setDocumentStatusReason(errMsg);
			
			throw b;
		} catch (Throwable t) {
			throw t;
		}
	}
	
	private boolean canSkipSendReviewPaxStmt(InvoiceVO vo) {
		return vo.getDocTypeCd().equals(SalesConstant.DOC_TYPE_CD_INVC) ||
		           vo.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_REVIEWING) ||
		           vo.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_CONVERTED) ||
		           vo.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_SPLIT) ||
		           vo.getDocTypeStatus().equals(ProductConstant.PAX_STMT_STATUS_CLOSED);
	}
	
	public void sendToReview() {
		trackingLogUtils.startLogs(); 
		TrackingLogUtils.printLogs("---- Start sendToReview ----");
		try {
			
			mulpInvSubmRespListExportTitle = "Pax_Statement_Send_To_Review_Status_List";
			CompanyVO companyVO = corporateProfileBO.getCompanyDetails(getSessionInfoBean().getCompanyVO().getId());
			
			for (InvoiceVO vo : savedSelectedInvoiceList) {
				vo.setCreatedBy(StringUtils.isBlank(BaseContext.getUserFullName()) ? BaseContext.getLoginId() : BaseContext.getUserFullName());
				vo.setCreatedDate(new Date());
				vo.setCompanyVO(companyVO);
				if (canSkipSendReviewPaxStmt(vo)) {
					continue;
				}
				
				try {
					validateSendToReview(vo, companyVO);
				} catch (Throwable t) {
					continue;
				} finally {
					
				}
				
				System.out.println("Send To Review | PS No: " + vo.getPsNo() + " | ID: " + vo.getId() + " | Doc Type Code: " + vo.getDocTypeCd() + " | Status: " + vo.getDocTypeStatus());
				
//				vo.setDocTypeStatus(ProductConstant.PAX_STMT_STATUS_REVIEWING);
				invoiceBO.updateInvoiceDocTypeStatus(vo.getId(), ProductConstant.PAX_STMT_STATUS_REVIEWING);
				invoiceBO.insertInvoiceHistory(vo.getId(), CommonConstant.ACTION_CD_UPD, "Send To Review");
			}
			mulpInvSubmRespList = new ArrayList<InvoiceVO>(savedSelectedInvoiceList);
			selectedInvoiceList = new InvoiceVO[1]; // clear array
			savedSelectedInvoiceList = new ArrayList<InvoiceVO>();
			loadInvoiceDisplay();
			successResult();
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
			TrackingLogUtils.printLogs("---- End sendToReview ----");
			trackingLogUtils.endLogs("sendToReview");
		}
	}
	
