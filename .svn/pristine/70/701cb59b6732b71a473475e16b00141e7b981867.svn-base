	public void handleChangeColumnsViewClick() {
		// Get Data Table Columns
		DataTable dataTable = (DataTable) FacesContext.getCurrentInstance().getViewRoot().findComponent("idInvListForm:idTabView:idInvListTable");
		List<UIColumn> column = dataTable.getColumns();
		int index = 1;
		List<ListingTableViewColumnsVO> columnList = new ArrayList<>();
		for (UIColumn uiColumn : column) {
			
			if (StringUtils.isBlank(uiColumn.getHeaderText()))	continue;
			
			boolean isExists = false;
			for (ListingTableViewColumnsVO columnsVO : listingTableViewVO.getListingTableViewColumnsVOList()) {
				if (StringUtils.equals(columnsVO.getColumnsName(), uiColumn.getHeaderText())) {
					columnsVO.setSeqNo(index);
					
					columnList.add(columnsVO);
					isExists = true;
					break;
				}
			}
			
			if (!isExists) {
				ListingTableViewColumnsVO columnsVO = new ListingTableViewColumnsVO();
				columnsVO.setColumnsName(uiColumn.getHeaderText());
				columnsVO.setSeqNo(index);
				columnsVO.setVisible(true);
				columnList.add(index - 1, columnsVO);
			}
			index++;
		} 
		
		listingTableViewVO.setListingTableViewColumnsVOList(columnList);
	}
	
	public void handleCategoryCodeChange() {
		try {
			loadTmpMsgList();
			if(StringUtils.equals(invoiceVO.getCatCd(), CommonConstant.LOOKUP_ITM_INV_CAT_TOUR) && invoiceVO.getTourDepId() != null) {
				TourDepartureVO vo = tourPkgBO.getTourDepById(invoiceVO.getTourDepId());
				invoiceVO.setIdDepartment(vo.getIdDepartment());
			}else {
				List<EmployeeViewVO> fullEmployeeList = invoiceBO.getFullEmployeeViewList(this.getSessionInfoBean().getCompanyVO().getId());
				for(EmployeeViewVO vo : fullEmployeeList) {
					if(invoiceVO.getSalerId().equals(vo.getId())) {
						invoiceVO.setIdDepartment(vo.getDepartment());
						break;
					}
				}
			}
		} catch(Throwable t) {
			errorResult(t);
		}
	}
	
