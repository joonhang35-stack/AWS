	public void handleSplitCustSelect(SelectEvent event) {
//		System.out.println("InvoiceBean.handleSplitCustSelect()");
		try {
			custDetailsVO = invoiceBO.getCustDetails(((CustomerVO) event.getObject()).getId());
//			System.out.println(((CustomerVO) event.getObject()).getId());
			custDetailsVO.setContPersonName(FunctionUtils.getContPersonName(custDetailsVO.getContPersonName(), custDetailsVO.getNickName(), custDetailsVO.getTitle(), custDetailsVO.getSalutation()));
			activeInvoiceVO.setCustomerId(custDetailsVO.getCustId());
			activeInvoiceVO.setAttnTo(custDetailsVO.getContPersonName());

			activeInvoiceVO.setCustDetailsVO(custDetailsVO);
			resetCustomerListForm();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
//		System.out.println("InvoiceBean.handleSplitCustSelect()");
	}
	
	public void onUndoSplit(InvoiceVO invoiceVO) {
		try {
			this.invoiceVO = invoiceBO.getInvoiceById(invoiceVO.getId());
			List <InvoiceVO> invoiceList = invoiceBO.getInvoiceByParentInvoiceId(this.invoiceVO.getId());
//			System.out.println("this.invoiceVO.getId(): " + this.invoiceVO.getId());
//			System.out.println("invoiceList.size(): " + invoiceList.size());
			
			for (InvoiceVO subInvoiceVO : invoiceList) {
//				System.out.println(invoiceVO2.getCode());
				if (subInvoiceVO.getDocTypeCd().equals("I")) {
					throw new BusinessException(CommonErrConstant.ERR_UNDO_SPLIT_CONVERTED);
				}
			}
			
			// invoice cancel / void cannot undo split (You Yuan 2025.11.27)
			for (InvoiceVO subInvoiceVO : invoiceList) {
				if (subInvoiceVO.getStatusCd().equals(CommonConstant.STATUS_CD_VOID) || subInvoiceVO.getStatusCd().equals(CommonConstant.STATUS_CD_CANCELLED)) {
					if (!StringUtils.equalsIgnoreCase(subInvoiceVO.getDocTypeStatus(), ProductConstant.PAX_STMT_STATUS_CLOSED)) {
						throw new BusinessException(CommonErrConstant.ERR_UNDO_SPLIT_VD_CC);
					}
				}
			}
			
			// booking cancel / void cannot undo split (You Yuan 2025.11.27)
			if (StringUtils.isNotBlank(invoiceVO.getBookingStatusCd())) {
				if (StringUtils.equalsIgnoreCase(invoiceVO.getBookingStatusCd(), CommonConstant.STATUS_CD_VOID)
						|| StringUtils.equalsIgnoreCase(invoiceVO.getBookingStatusCd(), CommonConstant.STATUS_CD_CANCELLED)) {
					throw new BusinessException(CommonErrConstant.ERR_UNDO_SPLIT_BK_VD_CC);
				}
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void undoSplitPaxStatement() {
		try {
			
			invoiceBO.undoSplitPS(invoiceVO.getId());
			
			invoiceVO.setReason("UNDO SPLIT");
			invoiceBO.insertInvoiceHistory(invoiceVO.getId(), CommonConstant.ACTION_CD_UPD, invoiceVO.getReason());
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	public void showDocument(InvoiceVO invoiceVO, String docTypeCd) {
//		System.out.println("InvoiceBean.redirect()");
		
		try {
