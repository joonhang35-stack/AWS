	/**
	 * On selected Invoice exchange order item
	 */
	public void handleInvEOItemSelect(SelectEvent event) throws BusinessException {
		System.out.println("CYY skipAcctCodeCheck: " + skipAcctCodeCheck);
		try {
			InvoiceAndExchangeOrderViewVO vo = (InvoiceAndExchangeOrderViewVO) event.getObject();
			invoiceItemVO.setInvItemCd(vo.getCode());
			invoiceItemVO.setInvEOItemId(vo.getId());
			invoiceItemVO.setCode(vo.getCode());
			invoiceItemVO.setDesc(vo.getDescription());
			invoiceItemVO.setTypeCd(vo.getTypeCd());
			
			//boolean GSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), invoiceVO.getInvoiceDt());
			if (GSTPeriod && invoiceVO.getIdAcctGST() != null) {
				invoiceItemVO.setTaxCode(vo.getTaxCode());
				invoiceItemVO.setTaxRate(vo.getTaxRate());
			} else {
				invoiceItemVO.setTaxCode(null);
				invoiceItemVO.setTaxRate(null);
			}
			//invoiceItemVO.setQty(1);
			//invoiceItemVO.setUnitPrice(vo.getAmount());
			//invoiceItemVO.setTaxAmount(0.00);
			//invoiceItemVO.setAmount(vo.getAmount());
			//invoiceItemVO.setTaxIncAmt(vo.getAmount());
			
			List<TourDepItemVO> acctTourDepItemList = null;
			Long acctId = null;
			boolean isExistInTourDepList = false;
			if (invoiceVO.getTourDepId() != null) {
				acctTourDepItemList = tourPkgBO.getTourDepItemList(invoiceVO.getTourDepId(), getSessionInfoBean().getCompanyVO().getId());
				
				if (CollectionUtils.isNotEmpty(acctTourDepItemList)) {
					for (TourDepItemVO tdItemVO : acctTourDepItemList) {
						if (ProductConstant.TOUR_DEP_ITM_CD_FT_SGL.equals(tdItemVO.getCode()))
							acctId = tdItemVO.getAcctId();
						if (ProductConstant.TOUR_DEP_ITM_CD_FT_TWN.equals(tdItemVO.getCode()))
							acctId = tdItemVO.getAcctId();
						if (tdItemVO.getCode() != null && tdItemVO.getCode().equals(vo.getCode())) {
							acctId = tdItemVO.getAcctId();
							isExistInTourDepList = true;
							break;
						}
					}
				}
			}
			
//			System.out.println("CYY acctId: " + acctId);
//			System.out.println("CYY isExistInTourDepList: " + isExistInTourDepList);
//			System.out.println("CYY vo.getIsDefAcct(): " + vo.getIsDefAcct());
//			System.out.println("CYY vo.getAcctVO().getId(): " + vo.getAcctVO().getId());
			
			if (acctId != null) {
				if (isExistInTourDepList) {
					invoiceItemVO.setAcctId(acctId);
				} else {
					if (true == vo.getIsDefAcct()) {
						invoiceItemVO.setAcctId(vo.getAcctVO().getId());
					} else invoiceItemVO.setAcctId(acctId); // Set same with sgl or twn account
				}
			} else invoiceItemVO.setAcctId(vo.getAcctVO().getId());
			
			if (skipAcctCodeCheck) {
				invoiceItemVO.setAcctId(vo.getAcctVO().getId());
			}
			
//			System.out.println("CYY invoiceItemVO.getAcctId(): " + invoiceItemVO.getAcctId());
			
			AcctVO acctVO = chartOfAcctBO.getAcctVO(invoiceItemVO.getAcctId());
			if (acctVO.getSubCode().equals("")) {
				invoiceItemVO.setSalesAcctCd(acctVO.getCode());
				invoiceItemVO.setSalesAcctDesc(acctVO.getDesc());
			} else {
				invoiceItemVO.setSalesAcctCd(acctVO.getCode() + "-" + acctVO.getSubCode());
				invoiceItemVO.setSalesAcctDesc(acctVO.getDesc() + ", " + acctVO.getSubDesc());
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

