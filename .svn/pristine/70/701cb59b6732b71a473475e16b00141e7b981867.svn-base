	public void handleLanguageChange() {
		try {
			if(StringUtils.isNotBlank(invoicePaxVO.getCustDetailsVO().getLanguageName())) {
				invoicePaxVO.getCustDetailsVO().setLanguageName("");
			}
			if(CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getLangCdList())) {
				List<LookupItemVO> languageList = customerBO.getLookUpItemList(CommonConstant.LOOKUP_CAT_CD_LANG_DILC);
				for(LookupItemVO vo : languageList) {
					for(String code : invoicePaxVO.getCustDetailsVO().getLangCdList()) {
						if(StringUtils.equals(vo.getCode(), code))
							invoicePaxVO.getCustDetailsVO().setLanguageName(StringUtils.isBlank(invoicePaxVO.getCustDetailsVO().getLanguageName()) ? vo.getDescription() : invoicePaxVO.getCustDetailsVO().getLanguageName() + ", " + vo.getDescription());
					}
				}
			}
		}catch(Throwable t) {
			errorResult(t);
		}
	}
	
