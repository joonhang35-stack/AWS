	public InvoiceVO[] getSelectedInReviewInvList() {
		return selectedInReviewInvList;
	}

	public void setSelectedInReviewInvList(InvoiceVO[] selectedInReviewInvList) {
//		System.out.println("\nInvoiceBean.setSelectedInvoiceList()");
//		System.out.println("CYY selectedInvoiceList.length: " + selectedInvoiceList.length);
//		for (InvoiceVO vo : selectedInvoiceList) {
//			System.out.print(vo.getPsNo() + ", ");
//		}
//		System.out.println();
//		this.selectedInvoiceList = selectedInvoiceList;
		if (savedSelectedInvoiceList == null) savedSelectedInvoiceList = new ArrayList<InvoiceVO>();
    	if (selectedInReviewInvList != null) {
    		boolean existed = false;
    		for (Object obj : selectedInReviewInvList) {
    			InvoiceVO custVO = (InvoiceVO) obj;
        		existed = false;
        		for (InvoiceVO selectedVO : savedSelectedInvoiceList) {
        			if (selectedVO.getId().equals(custVO.getId())) {
        				existed = true;
        				break;
        			}
        		}
        		if (!existed) savedSelectedInvoiceList.add(custVO);
        	}
    	}
    	List<InvoiceVO> dataList = (List<InvoiceVO>) lazyReviewingPaxStmtDataModel.getWrappedData();
//    	System.out.println("CYY dataList.size(): " + dataList.size());
//    	for (InvoiceVO vo : dataList) {
//    		System.out.print(vo.getPsNo() + ", ");
//		}
//    	System.out.println();
    	if (dataList != null && dataList.size() > 0) {
    		List<InvoiceVO> removeList = new ArrayList<InvoiceVO>();
    		for (InvoiceVO data : dataList) {
    			for (Object obj : selectedInReviewInvList) {
    				InvoiceVO custVO = (InvoiceVO) obj;
    	    		if (data.getId().equals(custVO.getId())) {
    	    			removeList.add(data);
    	    			break;
    	    		}
    	    	}
    		}
    		if(removeList.size() > 0) dataList.removeAll(removeList);
    		removeList = new ArrayList<InvoiceVO>();
    		for (InvoiceVO data : dataList) {
    			for (InvoiceVO selectedVO : savedSelectedInvoiceList) {
    	    		if (data.getId().equals(selectedVO.getId())) {
    	    			removeList.add(selectedVO);
    	    			break;
    	    		}
    	    	}
    		}
    		if(removeList.size() > 0) savedSelectedInvoiceList.removeAll(removeList);
    	}
    	this.selectedInReviewInvList = savedSelectedInvoiceList.toArray(new InvoiceVO[savedSelectedInvoiceList.size()]);
//    	System.out.println("CYY savedSelectedInvoiceList.size(): " + savedSelectedInvoiceList.size());
//    	for (InvoiceVO vo : savedSelectedInvoiceList) {
//    		System.out.print(vo.getPsNo() + ", ");
//		}
//    	System.out.println();
	}
	
