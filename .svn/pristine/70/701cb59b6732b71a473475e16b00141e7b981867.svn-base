	/**
	 * Add invoice pax
	 */
	public void addInvPax() {
		try {
			
			IdentityUtils.syncNricPassport(invoicePaxVO.getCustDetailsVO().getNricIdVO(), invoicePaxVO.getCustDetailsVO().getPassportIdVO(), invoicePaxVO.getCustDetailsVO().getIdentityList());

			if (invoiceVO.getBookingId() != null && invoiceVO.getBookingId() != 0 && (invoiceVO.getInvoicePaxList().size() >= bookingBO.getBooking(invoiceVO.getBookingId()).getQuantity()))
				throw new BusinessException(CommonErrConstant.ERR_INV_PAX_OVER);
			
			// check duplicate customer
			if (invoicePaxVO.getCustId() == null) {
				int custExisted = customerBO.isCustomerExisted(invoicePaxVO.getCustDetailsVO(), getSessionInfoBean().getCompanyVO().getId(), true);
				if (custExisted == 1) throw new BusinessException(CommonErrConstant.ERR_CUST_NAME_EXISTED);
				else if (custExisted == 2) throw new BusinessException(CommonErrConstant.ERR_CUST_ID_EXISTED);
				
				
			} else {
				if (!CommonConstant.LOOKUP_ITM_INV_CAT_TICKETING.equals(invoiceVO.getCatCd())) {
					for (InvoicePaxVO vo : invoiceVO.getInvoicePaxList()) {
						if (invoicePaxVO.getCustId().equals(vo.getCustId())) throw new BusinessException(CommonErrConstant.ERR_INV_PAX_EXISTED);
					}
				}
			}
			boolean emailExisted = customerBO.isEmailExisted(invoicePaxVO.getCustDetailsVO(), getSessionInfoBean().getCompanyVO().getId());
			if (emailExisted) throw new BusinessException(CommonErrConstant.ERR_CUST_EMAIL_EXISTED);
			EInvoiceUtils.validateCustomerContact(invoicePaxVO.getCustDetailsVO().getPersonContactVO());
			EInvoiceUtils.checkMalaysianPostcode(invoicePaxVO);

			for(IdentityVO identityVO : invoicePaxVO.getCustDetailsVO().getIdentityList()) {
				if ((StringUtils.isNotEmpty(identityVO.getIdentityDetailVO().getScannedPath()) &&
					StringUtils.isEmpty(identityVO.getIdentityDetailVO().getFilePath()))
						|| (StringUtils.isEmpty(identityVO.getIdentityDetailVO().getScannedPath()) &&
							StringUtils.isNotEmpty(identityVO.getIdentityDetailVO().getFilePath()))) {
					throw new BusinessException(CommonErrConstant.ERR_PASSENGER_FILE_PATH_MISSING);
				}
			}
			// Check duplicate Primary Email and check if there is at least a Primary Email
			if (CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getEmailList())) {
	            int primaryCount = 0;
	            boolean allPrimaryFalse = true;
	            for (PersonEmailVO personEmailVO : invoicePaxVO.getCustDetailsVO().getEmailList()) {
	            	if (personEmailVO.getIsPrimary()) {
	            		primaryCount++;
	            		allPrimaryFalse = false;
	            		if (primaryCount > 1) {
	            			throw new BusinessException(CommonErrConstant.ERR_PRIMARY_EMAIL_MORE_THAN_ONE);
	            		}
	            	}
	            }
	            if (allPrimaryFalse == true) {
					throw new BusinessException(CommonErrConstant.ERR_MISSING_PRIMARY_EMAIL);
				}
	        }
			invoicePaxVO.setInvoicePaxRefNoList(tempInvoicePaxRefNoList);
			
			invoiceBO.updateInvoicePax(invoiceVO, invoicePaxVO);
			invoiceVO.getInvoicePaxList().add(invoicePaxVO);
			calculateTotalUApple(invoiceVO.getCustDetailsVO(), invoiceVO.getInvoicePaxList());
			loadReferenceNo(invoicePaxVO, false);
			
			resetInvPaxForm();
			successResult();

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	/**
	 * Edit invoice pax
	 */
	public void updateInvPax() {
		try {
			
			IdentityUtils.syncNricPassport(invoicePaxVO.getCustDetailsVO().getNricIdVO(), invoicePaxVO.getCustDetailsVO().getPassportIdVO(), invoicePaxVO.getCustDetailsVO().getIdentityList());
			
			int custExisted = customerBO.isCustomerExisted(invoicePaxVO.getCustDetailsVO(), getSessionInfoBean().getCompanyVO().getId());
			if (custExisted == 1) throw new BusinessException(CommonErrConstant.ERR_CUST_NAME_EXISTED);
			else if (custExisted == 2) throw new BusinessException(CommonErrConstant.ERR_CUST_ID_EXISTED);
			//should be able to follow billing person
			if(customerBO.isEmailExisted(invoicePaxVO.getCustDetailsVO(), getSessionInfoBean().getCompanyVO().getId())) {
				throw new BusinessException(CommonErrConstant.ERR_CUST_EMAIL_EXISTED);
			}

			// check duplicate customer
			if (invoicePaxVO.getCustId() == null) {
				
			} else {
				if (!CommonConstant.LOOKUP_ITM_INV_CAT_TICKETING.equals(invoiceVO.getCatCd())) {
					if (!invoicePaxOrgVO.getCustId().equals(invoicePaxVO.getCustId())) {
						for (InvoicePaxVO vo : invoiceVO.getInvoicePaxList()) {
							if (invoicePaxVO.getCustId().equals(vo.getCustId()))
								throw new BusinessException(CommonErrConstant.ERR_INV_PAX_EXISTED);
						}
					}
				}
			}
			
			EInvoiceUtils.validateCustomerContact(invoicePaxVO.getCustDetailsVO().getPersonContactVO());
			EInvoiceUtils.checkMalaysianPostcode(invoicePaxVO);

			for(IdentityVO identityVO : invoicePaxVO.getCustDetailsVO().getIdentityList()) {
				if ((StringUtils.isNotEmpty(identityVO.getIdentityDetailVO().getScannedPath()) &&
					StringUtils.isEmpty(identityVO.getIdentityDetailVO().getFilePath()))
						|| (StringUtils.isEmpty(identityVO.getIdentityDetailVO().getScannedPath()) &&
							StringUtils.isNotEmpty(identityVO.getIdentityDetailVO().getFilePath()))) {
					throw new BusinessException(CommonErrConstant.ERR_PASSENGER_FILE_PATH_MISSING);
				}
			}
			// Check duplicate Primary Email and check if there is at least a Primary Email
			if (CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getEmailList())) {
				int primaryCount = 0;
				boolean allPrimaryFalse = true;
				for (PersonEmailVO personEmailVO : invoicePaxVO.getCustDetailsVO().getEmailList()) {
					if (personEmailVO.getIsPrimary()) {
						primaryCount++;
						allPrimaryFalse = false;
						if (primaryCount > 1) {
							throw new BusinessException(CommonErrConstant.ERR_PRIMARY_EMAIL_MORE_THAN_ONE);
						}
					}
				}
				if (allPrimaryFalse == true) {
					throw new BusinessException(CommonErrConstant.ERR_MISSING_PRIMARY_EMAIL);
				}
			}
			invoicePaxVO.setInvoicePaxRefNoList(tempInvoicePaxRefNoList);
			
			// keep a copy for later for future update tempInvoicePaxRefNoList
			List<InvoicePaxRefNoVO> copyInvoicePaxRefNoList = new ArrayList<>(tempInvoicePaxRefNoList);
			
			invoiceBO.updateInvoicePax(invoiceVO, invoicePaxVO);
			setEditInvoicePax(invoicePaxVO, invoicePaxOrgVO);
			calculateTotalUApple(invoiceVO.getCustDetailsVO(), invoiceVO.getInvoicePaxList());
			loadReferenceNo(invoicePaxVO, false);
			
			// keep a copy for later for future update referenceNo and referenceNoPreview
			String referenceNo = invoicePaxVO.getReferenceNo();
			String referenceNoPreview = invoicePaxVO.getReferenceNoPreview();
			// Update the invoicePaxList from invoiceVO about the referenceNo and referenceNoPreview
			for (InvoicePaxVO invPaxVO : invoiceVO.getInvoicePaxList()) {
				if (invPaxVO.getId() != null && invoicePaxVO.getId() != null && invPaxVO.getId() == invoicePaxVO.getId()) {
					invPaxVO.setReferenceNo(referenceNo);
					invPaxVO.setReferenceNoPreview(referenceNoPreview);
				} else if (invPaxVO.getCustId() != null && invoicePaxVO.getCustId() != null && invPaxVO.getCustId() == invoicePaxVO.getCustId() ) {
					invPaxVO.setReferenceNo(referenceNo);
					invPaxVO.setReferenceNoPreview(referenceNoPreview);
				}
			}
			
			// upload file
			fileUploadUtils.deleteFiles();
			
			resetInvPaxForm();
			
			// reinsert back into tempInvoicePaxRefNoList for edit to prevent lost data
			tempInvoicePaxRefNoList = copyInvoicePaxRefNoList;

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
