		}
	}

	/**
	 * Handle booking transfer
	 */
	public void handleTransfer(boolean isTransfer) {
		try {
			if (isTransfer) {
				InvoiceVO oriVO = (InvoiceVO) getOriObj();
				checkFinGSTClosed(CommonConstant.ACTION_CD_UPD, oriVO.getInvoiceDt(), invoiceVO.getInvoiceDt(), invPmntAuthVO.isAccountManager());
				
				if (availableTourDepVO == null || availableTourDepVO.getId() == null) throw new BusinessException(CommonErrConstant.ERR_BOOKING_NOT_TOUR_DEP_SELECTED);
				setInvoiceItemVOList(new AddUpdDelVO(new ArrayList<Object>(), new ArrayList<Object>(), new ArrayList<Object>()));

				String tourCodeBefore = invoiceVO.getTourCd();
				Long bookingNoBefore = invoiceVO.getBookingId();
				String tourCodeAfter = "";
				Long bookingNoAfter = null;

				InvoiceVO transferInvVO = bookingBO.transferBooking(invoiceVO.getBookingId(), invoiceVO.getTourDepId(), invoiceVO.getInvoiceDt(), availableTourDepVO, true);
				tourCodeAfter = transferInvVO.getTourCd();
				bookingNoAfter = transferInvVO.getBookingId();
				
				// for Transferred Stamp use
				SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss");
				String formattedTransferredDate = sdf.format(DateUtils.getCurrentDate());
				invoiceVO.setTransferredDate(sdf.parse(formattedTransferredDate));
				invoiceVO.setTransferredBy(getSessionInfoBean().getUserVO().getName());
				invoiceVO.setOriginalTc(tourCodeBefore);

				// Reset invoice with detail
				setInvoiceVO(invoiceBO.getInvoiceDetails(invoiceVO));

				invoiceVO.setBookingId(transferInvVO.getBookingId());
				invoiceVO.setTourCd(transferInvVO.getTourCd());
				invoiceVO.setTourDepId(transferInvVO.getTourDepId());
				invoiceVO.setDepartureDt(transferInvVO.getDepartureDt());
				invoiceVO.setSubjLine(transferInvVO.getSubjLine());
				invoiceVO.setReason("Transfer Tour Code [" + tourCodeBefore + "] to [" + tourCodeAfter + "] And Booking No [" + bookingNoBefore + "] to [" + bookingNoAfter + "] by [" + getSessionInfoBean().getUserVO().getName() + "] on [" + formattedTransferredDate + "]");
				
				//if (!invoiceVO.isDateInFinPeriodClosed()) {
				if (!LookupItemUtils.getFinAndGSTPeriodClosedStatus(this.getSessionInfoBean().getCompanyVO().getId(), invoiceVO.getInvoiceDt(), false)) {
					if (CollectionUtils.isNotEmpty(transferInvVO.getInvoiceItemList())) {
						if (GSTPeriod && invoiceVO.getIdAcctGST() != null) {
							for (InvoiceItemVO vo : transferInvVO.getInvoiceItemList()) {
								vo = (InvoiceItemVO) AccountHelper.calcAmountBaseOnTotalTaxableAmount(vo);
							}
						} else {
							for (InvoiceItemVO vo : transferInvVO.getInvoiceItemList()) {
								vo.setTaxCode(null);
								vo.setTaxRate(null);
							}
						}
						invoiceVO.setInvoiceItemList(transferInvVO.getInvoiceItemList());
						calTtlAmt();
					}
				}
				// for audit trial history purpose
				if (invoiceVO.getVersion().intValue() == 1) {
					invoiceBO.insertInvoiceHistory(invoiceVO.getId(), CommonConstant.ACTION_CD_ADD, "");
				}

				invoiceBO.updateInvoice(invoiceVO, invoiceVO.getTourDepId());
				// for audit trial history purpose
				invoiceBO.insertInvoiceHistory(invoiceVO.getId(), CommonConstant.ACTION_CD_UPD, invoiceVO.getReason());
				
				// Transfer booking history log
				bookingBO.insertBookingHistory(invoiceVO.getBookingId(), CommonConstant.ACTION_CD_XFER, "Transfer Tour Code [" + tourCodeBefore + "] to [" + tourCodeAfter + "] And Booking No [" + bookingNoBefore + "] to [" + bookingNoAfter + "] by [" + getSessionInfoBean().getUserVO().getName() + "] on [" + formattedTransferredDate + "]");

				setInvoiceItemVOList(new AddUpdDelVO(new ArrayList<Object>(), new ArrayList<Object>(), new ArrayList<Object>()));
				setInvoicePaxVOList(new AddUpdDelVO(new ArrayList<Object>(), new ArrayList<Object>(), new ArrayList<Object>()));
				setInvoicePaymentVOList(new AddUpdDelVO(new ArrayList<Object>(), new ArrayList<Object>(), new ArrayList<Object>()));
				setEoInvVOList(new AddUpdDelVO(new ArrayList<Object>(), new ArrayList<Object>(), new ArrayList<Object>()));
				invoiceVO.setReason("");
				onInvoiceSelected(invoiceVO);
				successResult();

			} else {
//				availableTourDepList = tourPkgBO.getAvailableTourDepList(this.getSessionInfoBean().getCompanyVO().getId(), invoiceVO);
				
				BookingVO bookingVO = bookingBO.getBooking(invoiceVO.getBookingId());
				availableTourDepList = tourPackageBO.getAvailableTourDepList(
						this.getSessionInfoBean().getCompanyVO().getId(), invoiceVO, bookingVO.getTypeCd());
			}

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	

	public void handleSelectCruiseTransfer() {
		try {
			BookingVO bookingVO = bookingBO.getBooking(invoiceVO.getBookingId());
			BookingViewVO vo = bookingBO.getBookingView(bookingVO.getId());
			vo.setBookingChargeItemList(new ArrayList<BookingChargeItemVO>(vo.getBookingChargeItemSet()));
			vo.setInvoiceVO(invoiceBO.getInvoice(vo.getId()));
			vo.setCustomerVO(customerBO.getCustomer(vo.getIdCust()));
			this.bookingViewVO = vo;
			this.bookingViewVO.setTourCode(bookingViewVO.getTourCode());

			bookingVO = (BookingVO) vo.clone();
			availableTourDepList = tourPackageBO
					.getAvailableCruiseTourDepList(getSessionInfoBean().getCompanyVO().getId(), null, bookingVO);

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	/**
