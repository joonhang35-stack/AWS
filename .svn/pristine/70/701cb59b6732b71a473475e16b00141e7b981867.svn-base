//			InvoiceVO thisInvoiceVO = invoiceBO.getinvoice(invoiceVO.getPsNo());
			HashMap<String, Object> params = new HashMap<String, Object>();
			params.put("docTypeCd", docTypeCd);
			if (docTypeCd.equals("I")) {
				params.put("code", invoiceVO.getCode());
			} else if (docTypeCd.equals("P")) {
				params.put("psNo", invoiceVO.getPsNo());
			}
			
//			System.out.println("thisInvoiceVO.getIdParentInv(): " + thisInvoiceVO.getIdParentInv());
//			sendRedirect("bookingId", invoiceVO.getBookingId(), invoiceVO, "/app/sales/paxStatement");
			InvoiceVO documentVO = invoiceBO.getInvoice(params);
//			setInvoiceVO(documentVO);
			preInit(docTypeCd); // init(docTypeCd);
			onInvoiceSelected(documentVO);
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
