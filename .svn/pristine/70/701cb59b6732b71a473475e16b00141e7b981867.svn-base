	/**
	 * 
	 *  Calculate Age
	 */
	public void calculateAge(DateSelectEvent event) {
		Calendar dob = Calendar.getInstance();
		dob.setTime(event.getDate());
		Calendar today = Calendar.getInstance();

		Integer age = today.get(Calendar.YEAR) - dob.get(Calendar.YEAR);

		if(today.get(Calendar.DAY_OF_YEAR) <= dob.get(Calendar.DAY_OF_YEAR)) {
			age--;
		}

		//set the age variable
		passangerVO.getPersonVO().setAge(age);
	}

	/**
	 * 
	 *  Add invoice due date
	 */
	public void setInvoiceDueDate(DateSelectEvent event) {
		//set the invoive due variable
		invoiceVO.setInvoiceDue(addInvoiceDueDate(event.getDate()));
		
		// Reset if not in GST period
		try {
			GSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), invoiceVO.getInvoiceDt());
			
			if (CollectionUtils.isNotEmpty(invoiceVO.getInvoiceItemList())) {
				if (!GSTPeriod) {
					for (InvoiceItemVO vo : invoiceVO.getInvoiceItemList()) {
						vo.setTaxCode(null);
						vo.setTaxRate(null);
						vo.setAmount(vo.getTaxIncAmt());
					}
					calTtlAmt();
				}
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public Date addInvoiceDueDate(Date dt) {
		Calendar invDt = Calendar.getInstance();
		if (dt == null) {
			invDt.setTime(new Date());
		} else {
			invDt.setTime(dt);
		}
		invDt.add(Calendar.DATE, Integer.parseInt(LookupItemUtils.getGlobalConfigValue(LookupItemConstant.GC_CATEGORY, LookupItemConstant.GC_PAID_EXP)));
		return invDt.getTime();
	}
	
	public void addInvoiceAttachment() {
		try {
			if (StringUtils.isBlank(invoiceAttachmentVO.getScannedPath())) {
				FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_ERROR, "Scanned Copy is required.", "");
				FacesContext.getCurrentInstance().addMessage(null, msg);
				return;
			}
			
			isTmpFile = false;
			
			if (attachmentUploadedFile != null) {
				fileUploadUtils.uploadSingleFile(attachmentUploadedFile, destinationAttachmentPath, invoiceAttachmentVO.getFilePath(), null, null, false);

				invoiceAttachmentVO.setInvId(invoiceVO.getId());
				invoiceBO.addDeleteInvoiceAttachment(invoiceAttachmentVO, false);
				invoiceVO.getInvoiceAttachmentVOList().add(invoiceAttachmentVO);
			}
			
			resetAttachmentForm();
			successResult();
		} catch (Exception e) {
			e.printStackTrace();
			errorResult(e);
		}
	}
	
	public void addPersonAttachment() {
		try {
			if (personAttachmentVO.getUploadedFile() != null) {
				fileUploadUtils.uploadSingleFile(personAttachmentVO.getUploadedFile(), destinationPersonAttachmentPath, personAttachmentVO.getFilePath(), null, null, false);
				personAttachmentVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
				invoicePaxVO.getCustDetailsVO().getAttachmentList().add(personAttachmentVO);
			}
			resetPersonAttachmentForm();
			successResult();
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void deletePersonAttachment() {
		try {
			if (personAttachmentVO.getId() == null) {
				fileUploadUtils.deleteFile(destinationPersonAttachmentPath, personAttachmentVO.getFilePath());
				
			} else {
				fileUploadUtils.deleteFile(destinationPersonAttachmentPath, personAttachmentVO.getFilePath());
				personAttachmentVO.setStatusCode(BaseConstant.STATUS_DELETED);
				customerBO.updateObject(personAttachmentVO);
			}
			invoicePaxVO.getCustDetailsVO().getAttachmentList().remove(personAttachmentVO);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
	public void handlePersonAttachmentFileUpload(FileUploadEvent event) {
		try {
			String fileName = event.getFile().getFileName();
			fileName = fileName.replace(" ", "_");
			SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMddHHmmss");
			fileName = sdf.format(new Date()) + "_" + fileName;
			
			personAttachmentVO.setName(fileName);
			personAttachmentVO.setScannedPath(fileName);
			personAttachmentVO.setFilePath(UUID.randomUUID().toString() + "." + FilenameUtils.getExtension(fileName));
			personAttachmentVO.setUploadedFile(event.getFile());
			
			fileUploadUtils.uploadSingleFile(personAttachmentVO.getUploadedFile(), destinationPersonAttachmentPath, personAttachmentVO.getFilePath(), null, null, false);
			
		} catch (Throwable t) {
			errorResult(t);
		}
	}
	
