	public void checkInvoiceItemLock(Long idBooking) throws BusinessException {
		if (idBooking != null) {
			BookingVO bookingVO = bookingBO.getBooking(idBooking);
			
			if (bookingVO != null && bookingVO.getBookingChargeItemSet() != null) {
				for (InvoiceItemVO itemVO : invoiceVO.getInvoiceItemList()) {
					if (itemVO.getCode() != null && itemVO.getChangedLock() == null && itemVO.getIsLock() == false) {
						for (BookingChargeItemVO bkItemVO : bookingVO.getBookingChargeItemSet()) {
							if (itemVO.getCode().equals(bkItemVO.getCode())) {
								if (bkItemVO.getIsLock() != null) itemVO.setIsLock(bkItemVO.getIsLock());
								break;
							}
						}
					}
				}
			}
		}
	}
	
	public void checkSalesPersonLock() {
		try {
			InvoiceVO oriVO = (InvoiceVO) getOriObj();
			
			if (invoiceVO.getBookingId() != null) {
				if (!addEdit && (oriVO.getIsLockSP() != null && oriVO.getIsLockSP() == false)) {
					invoiceVO.setIsLockSP(true);
				}
			}
			
		} catch (Throwable e) {
			e.printStackTrace();
			errorResult(e);
		}
	}
	
	
	public void changeBookingLockStatus() throws BusinessException {
		if (invoiceVO.getBookingId() != null) {
			if (invoiceVO.getBookingVO() != null) {
				bookingBO.updateIndividualBookingLockStatus(invoiceVO.getBookingId(), invoiceVO.getBookingVO().getLockStatus());
				checkBookingLock(invoiceVO.getBookingId(), invoiceVO.getIdParentInvTourBooking());
			}
		} else if (invoiceVO.getIdParentInvTourBooking() != null) {
			if (invoiceVO.getBookingVO() != null) {
				bookingBO.updateIndividualBookingLockStatus(invoiceVO.getIdParentInvTourBooking(), invoiceVO.getBookingVO().getLockStatus());
				checkBookingLock(invoiceVO.getBookingId(), invoiceVO.getIdParentInvTourBooking());
			}
		}
	}
	
	public void checkBookingLock(Long idBooking, Long idParentInvTourBooking) throws BusinessException {
		BookingVO bookingVO = bookingBO.getBooking(idBooking);
		if (idBooking == null && idParentInvTourBooking != null) bookingVO = bookingBO.getBooking(idParentInvTourBooking);
		
		if (bookingVO != null) disabledRemarks = bookingVO.getLockStatus();
		else disabledRemarks = false;
		
		List<UserRoleViewVO> userRoleList = securityBO.getUserRoleListByUser(this.getSessionInfoBean().getUserVO().getUuid());
		for (UserRoleViewVO userRoleVO : userRoleList) {
			if (userRoleVO.getRoleCode().equals(SalesConstant.SALES_ROLE)) {
				if (bookingVO != null) 
					hideInvoiceDetailChange = bookingVO.getLockStatus();
			}
		}		
	}
	
