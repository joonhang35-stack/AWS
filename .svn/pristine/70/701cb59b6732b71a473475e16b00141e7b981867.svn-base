	@Override
	public void resetForm() {
		invoiceVO = new InvoiceVO();
		invoiceItemVO = new InvoiceItemVO();
		invoiceItemOrgVO = new InvoiceItemVO();
		invoicePaxVO = new InvoicePaxVO();
		invoicePaymentVO = new InvoicePaymentVO();
		eoInvVO = new EOInvoiceVO();
		custDetailsVO = new CustDetailsVO();
		resetCustomerListForm();
		
		addEdit = true;
		fromBooking = false;
		GSTPeriod = false;
		editablePOSUploaded = true;
		isEditSeq = false;
		isEditPaxSeq = false;
		isEditPmntSeq = false;
		isEditBookingSync = false;
		tourDepListInactiveRecords = false;
		
		if (!docTypeCd.equals("C")) {
			invoiceVO.setSalerId(this.getSessionInfoBean().getEmployeeVO().getId());
			invoiceVO.setSalerName(this.getSessionInfoBean().getUserVO().getName());
		}
		invoiceVO.setCompanyId(this.getSessionInfoBean().getCompanyVO().getId());
		invoiceVO.setAcctId(this.getSessionInfoBean().getCompanyVO().getIdAcctSales());
		invoiceVO.setIssuerId(this.getSessionInfoBean().getEmployeeVO().getId());
		invoiceVO.setIssuedBy(this.getSessionInfoBean().getUserVO().getName());
		invoiceVO.setIdAcctGST(this.getSessionInfoBean().getCompanyVO().getIdAcctGST());
		//invoiceVO.setIdAcctRounding(this.getSessionInfoBean().getCompanyVO().getIdAcctRounding());
		
		invoiceVO.setDocTypeCd(docTypeCd);
		invoiceVO.setInvoiceDt(new Date());
		invoiceVO.setInvoiceDue(addInvoiceDueDate(new Date()));
		invoiceVO.setPrefix(prefixValue);
		resetFileUploadForm();
		resetPmntFileUploadForm();
		
		setOriObj(null);
	}

	public void closeForm() {
		try {
			
			if (fileUploadUtils != null) {
				fileUploadUtils.deleteAllFiles();
				fileUploadUtils.setDelList(new ArrayList<String>());
				fileUploadUtils.setDelTmpList(new ArrayList<String>());
				isTmpFile = false;
			}
			
			if (pmntFileUploadUtils != null) {
				pmntFileUploadUtils.deleteAllFiles();
				pmntFileUploadUtils.setDelList(new ArrayList<String>());
				pmntFileUploadUtils.setDelTmpList(new ArrayList<String>());
			}
			
			invoiceVO = new InvoiceVO();
			invoiceItemVO = new InvoiceItemVO();
			invoiceItemOrgVO = new InvoiceItemVO();
			invoicePaxVO = new InvoicePaxVO();
			invoicePaymentVO = new InvoicePaymentVO();
			eoInvVO = new EOInvoiceVO();
			custDetailsVO = new CustDetailsVO();
			custDetailsList = new ArrayList<CustDetailsVO>();
			fileName = null;
			fileUploadUtils = null;
			pmntFileUploadUtils = null;

			employeeList = new ArrayList<EmployeeViewVO>();
			acctViewList = new ArrayList<AcctViewVO>();
			invEOItemViewList = new ArrayList<InvoiceAndExchangeOrderViewVO>();
			airlineList = new ArrayList<AirlineVO>();
			acctVO = new AcctVO();
			countryList = new ArrayList<CountryVO>();
			fromBooking = false;
			
//			System.out.println("CYY fromDocType:" + fromDocType);
			if (StringUtils.isNotBlank(fromDocType)) {
				init(fromDocType);
			}
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
