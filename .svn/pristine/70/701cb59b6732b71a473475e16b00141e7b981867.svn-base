	public void loadInvoiceDisplay() throws BusinessException, ParseException {
		if (docTypeCd.equals("I") || docTypeCd.equals("C")) {
			lazyDataModel = new LazyInvoiceDataModel(fromDate, toDate, depDateFrom, depDateTo);
		} else if (docTypeCd.equals("P")) {
			lazyDataModel = new LazyInvoiceDataModel(fromDate, toDate, depDateFrom, depDateTo,
					FunctionUtils.generateArrayFromStr(ProductConstant.PAX_STMT_STATUS_OPENED,
							ProductConstant.PAX_STMT_STATUS_CLOSED, ProductConstant.PAX_STMT_STATUS_REVIEWING,
							ProductConstant.PAX_STMT_STATUS_CONVERTED, ProductConstant.PAX_STMT_STATUS_SPLIT));
			lazyReviewingPaxStmtDataModel = new LazyInvoiceDataModel(ProductConstant.PAX_STMT_STATUS_REVIEWING);
			lazyConvertedPaxStmtDataModel = new LazyInvoiceDataModel(ProductConstant.PAX_STMT_STATUS_CONVERTED);
			lazySplitPaxStmtDataModel = new LazyInvoiceDataModel(ProductConstant.PAX_STMT_STATUS_SPLIT);
		}
		savedSelectedInvoiceList = new ArrayList<InvoiceVO>();
		selectedInvoiceList = new InvoiceVO[1];
		loadAuthority();
		
		// set date 2025-01-01 to check inv save btn rendering
		String dateString = "2025-01-01";
        SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd");
        eInvStartDt = dateFormat.parse(dateString);
	}
	
