	/**
	 * Invoice maintenance
	 */
	public void init(String docTypeCd) {
		try { 
			trackingLogUtils = new TrackingLogUtils(this.getClass());
			
			fromDocType = docTypeCd;
			preInit(docTypeCd);

			loadOnlineBookingConfig();
			loadEmployeeList();
			loadInvoiceDisplay();
			bookingInit();
			loadAvailableItemCode();
			loadListingTableView();
			initSearchParam();
			
			lazyPassangerDataModel = new LazyCustomerDataModel();
			
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	/**
	 * function separated to be called when inv/ps redirect
	 * @param docTypeCd
	 * @throws BusinessException
	 */
	public void preInit(String docTypeCd) throws BusinessException {
		// Set document type and prefix (Invoice or Credit Note)
		setDocTypeCd(docTypeCd);
		
		// Credit Note
		if (docTypeCd.equals("C")) {
			prefixValue = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_CRDT_NOTE).getPrefixid();
			setDocTypeDesc("Credit Note");
		} else if (docTypeCd.equals("P")) {
			prefixValue = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_PAX_STMT).getPrefixid();
			setDocTypeDesc("Pax Statement");
			
			// Load Visible Config
			Map<String, Object> params = new HashMap<>();
			params.put("listingType", CommonConstant.LISTING_TYPE_INV_CAT);
			visibleConfigList = visibleListingConfigBO.getVisibleListingConfigListGroupByCatCdListingtype(params);
		} else {
			prefixValue = 
					LookupItemUtils
					.getSysNumGenVO(
							getSessionInfoBean()
							.getCompanyVO()
							.getId(), 
							CommonConstant
							.SYS_NUM_CD_INVC)
					.getPrefixid();
			setDocTypeDesc("Invoice");
			
			// Load Visible Config
			Map<String, Object> params = new HashMap<>();
			params.put("listingType", CommonConstant.LISTING_TYPE_INV_CAT);
			visibleConfigList = visibleListingConfigBO.getVisibleListingConfigListGroupByCatCdListingtype(params);
		}
		
		invPrefixVal = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_INVC).getPrefixid();
		psPrefixVal = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_PAX_STMT).getPrefixid();
	}

	public void initPopUp() {
		trackingLogUtils = new TrackingLogUtils(this.getClass());
		// Set document type and prefix (Invoice or Credit Note)
		setDocTypeCd("I");
		prefixValue = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_INVC).getPrefixid();
		invPrefixVal = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_INVC).getPrefixid();
		psPrefixVal = LookupItemUtils.getSysNumGenVO(getSessionInfoBean().getCompanyVO().getId(), CommonConstant.SYS_NUM_CD_PAX_STMT).getPrefixid();

		loadEmployeeList();
		
		try {
			acctViewList = chartOfAcctBO.getAcctViewList(this.getSessionInfoBean().getCompanyVO().getId(), null);
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		} finally {
		}
	}
	/**
	 * initialize booking
	 */
	private void bookingInit() {
//		System.out.println("InvoiceBean.bookingInit()");
		try {
			// get invoice vo from booking request
			InvoiceVO bookingInvVO = (InvoiceVO) getVOFromSession("bookingId");
			if (bookingInvVO == null) {
				String invId = getParamValue("invId");
				if (invId == null) setStrOnLoad("");
				else {
					// from customer tour history
					resetForm();
					fromBooking = true;
					addEdit = false;
					
					invoiceVO = invoiceBO.getInvoiceById(Long.parseLong(invId));
					
					if (invoiceVO.getId() == null ||  isViewableInvoice(invoiceVO.getCatCd())) {
						setStrOnLoad("fncLoad()");
					} else {
						FacesContext.getCurrentInstance().addMessage(null, new FacesMessage(FacesMessage.SEVERITY_INFO, "Not Authorize to access!", "Not Authorize to access!"));
					}
					
					setOriObj(invoiceVO.clone());
					
					invoiceVO = invoiceBO.getInvoiceDetails(invoiceVO);
					if (CollectionUtils.isNotEmpty(invoiceVO.getInvoicePaxList())) {
						for (InvoicePaxVO invoicePaxVO : invoiceVO.getInvoicePaxList()) {
							if (invoicePaxVO.getCustDetailsVO() != null && CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getIdentityList())) {
								CustDetailsVO custDtlVO = invoicePaxVO.getCustDetailsVO();
								for (IdentityVO idVO : custDtlVO.getIdentityList()) {
									if (StringUtils.equals(idVO.getIdType(), CommonConstant.LOOKUP_ITM_ID_NRIC)) {
										custDtlVO.setNricIdVO((IdentityVO) idVO.clone());
										custDtlVO.getNricIdVO().setIdNo(idVO.getIdNo());
										invoicePaxVO.getCustDetailsVO().setAge(CalculationUtils.calculateAgeByIdNo(custDtlVO.getNricIdVO().getIdNo()));
										continue;
									}
									if (StringUtils.equals(idVO.getIdType(), CommonConstant.LOOKUP_ITM_ID_PASSPRT)) {
										custDtlVO.setPassportIdVO((IdentityVO) idVO.clone());
										custDtlVO.getPassportIdVO().setIdNo(idVO.getIdNo());
										if (idVO.getIdentityDetailVO() != null) {
											custDtlVO.getPassportIdVO().setIdentityDetailVO((IdentityDetailVO) idVO.getIdentityDetailVO().clone());
											custDtlVO.getPassportIdVO().setUploadedFile(custDtlVO.getPassportIdVO().getIdentityDetailVO().getScannedPath());
											continue;
										} else {
											custDtlVO.getPassportIdVO().setIdentityDetailVO(new IdentityDetailVO());
											custDtlVO.getPassportIdVO().getIdentityDetailVO().setIdCountry(CommonConstant.DEF_COUNTRY_ID);
										}
									}
								}
							}
							loadReferenceNo(invoicePaxVO, false);
						}
					}
					invoiceVO.setIssuedBy(getUserName(invoiceVO.getIssuerId()));
					custDetailsVO = invoiceVO.getCustDetailsVO();
					
					GSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), invoiceVO.getInvoiceDt());
					
					calTtlAmt(null, false);
					calculateTotalUApple(custDetailsVO, invoiceVO.getInvoicePaxList());
					
					// Check Financial Period Closed
					invoiceVO.setDateInFinPeriodClosed(getFinPeriodClosedStatus());
					// Check Invoice Date changeable
					invoiceVO.setInvoiceDateChangeable(getInvoiceDateChangeable());

					// Preset GST and Round Acct
					invoiceVO.setIdAcctGST(this.getSessionInfoBean().getCompanyVO().getIdAcctGST());
					//invoiceVO.setIdAcctRounding(this.getSessionInfoBean().getCompanyVO().getIdAcctRounding());
				}
			} else { // From booking page
				resetForm();
				fromBooking = true;
				
				invoiceVO.setInvoiceDt(new Date());
				invoiceVO.setInvoiceDue(addInvoiceDueDate(new Date()));
				invoiceVO.setCustomerId(bookingInvVO.getCustomerId());
				CustDetailsVO custVO = invoiceBO.getCustDetails(bookingInvVO.getCustomerId());
				if (custVO != null) {
					invoiceVO.setCustDetailsVO(custVO);
					setCustDetailsVO(custVO);
					invoiceVO.setAttnTo(custVO.getContPersonName());
					invoiceVO.setAttnTo(FunctionUtils.getContPersonName(custVO.getContPersonName(), custVO.getNickName(), custVO.getTitle(), custVO.getSalutation()));
				}
				
				invoiceVO.setBookingId(bookingInvVO.getBookingId());
				invoiceVO.setTourCd(bookingInvVO.getTourCd());
				invoiceVO.setTourDepId(bookingInvVO.getTourDepId());
				invoiceVO.setSubjLine(bookingInvVO.getSubjLine());
				invoiceVO.setDepartureDt(bookingInvVO.getDepartureDt());
				invoiceVO.setOrderCd(bookingInvVO.getOrderCd());
				invoiceVO.setCatCd(bookingInvVO.getCatCd());
				invoiceVO.setSalerId(bookingInvVO.getSalerId());
				invoiceVO.setTfairSalerId(bookingInvVO.getTfairSalerId());
				invoiceVO.setIssuedBy(getUserName(invoiceVO.getIssuerId()));
				
				GSTPeriod = gstBO.isGSTPeriod(getSessionInfoBean().getCompanyVO().getId(), invoiceVO.getInvoiceDt());
				
				if (CollectionUtils.isNotEmpty(bookingInvVO.getInvoiceItemList())) {
					//invoiceVO.setInvoiceItemList(bookingInvVO.getInvoiceItemList());
					
					if (GSTPeriod && invoiceVO.getIdAcctGST() != null) {
						for (InvoiceItemVO vo : bookingInvVO.getInvoiceItemList()) {
							vo = (InvoiceItemVO) AccountHelper.calcAmountBaseOnTotalTaxableAmount(vo);
						}
					} else {
						for (InvoiceItemVO vo : bookingInvVO.getInvoiceItemList()) {
							vo.setTaxCode(null);
							vo.setTaxRate(null);
						}
					}
					invoiceVO.setInvoiceItemList(bookingInvVO.getInvoiceItemList());
					for (InvoiceItemVO vo : invoiceVO.getInvoiceItemList()) {
						if (vo.getAirfare() != null && vo.getAirfare() != 0.0) {
						    BigDecimal unitPrice = BigDecimal.valueOf(vo.getUnitPrice());
						    BigDecimal airfare = BigDecimal.valueOf(vo.getAirfare());
						    
						    // Subtract airfare from unitPrice
						    BigDecimal tourFare = unitPrice.subtract(airfare);

						    // Set the calculated value back to tourFare
						    vo.setTourFare(tourFare.doubleValue());
						}
					}
					calTtlAmt();
				}
				
				// If booking id existed in invoice go to update modes
				if (invoiceBO.getBookingInvExist(invoiceVO.getBookingId())) {
					addEdit = false;
					invoiceVO = invoiceBO.getInvoice(invoiceVO.getBookingId());
					setOriObj(invoiceVO.clone());
					
					invoiceVO = invoiceBO.getInvoiceDetails(invoiceVO);

				    if (CollectionUtils.isNotEmpty(invoiceVO.getInvoicePaxList())) {
				        for (InvoicePaxVO invoicePaxVO : invoiceVO.getInvoicePaxList()) {
				            if (invoicePaxVO.getCustDetailsVO() != null && 
				                CollectionUtils.isNotEmpty(invoicePaxVO.getCustDetailsVO().getIdentityList())) {
				                
				                CustDetailsVO custDtlVO = invoicePaxVO.getCustDetailsVO();
				                for (IdentityVO idVO : custDtlVO.getIdentityList()) {
				                    if (StringUtils.equals(idVO.getIdType(), CommonConstant.LOOKUP_ITM_ID_NRIC)) {
				                        custDtlVO.setNricIdVO((IdentityVO) idVO.clone());
				                        custDtlVO.getNricIdVO().setIdNo(idVO.getIdNo());
				                        invoicePaxVO.getCustDetailsVO().setAge(
				                            CalculationUtils.calculateAgeByIdNo(custDtlVO.getNricIdVO().getIdNo()));
				                        continue;
				                    }
				                    if (StringUtils.equals(idVO.getIdType(), CommonConstant.LOOKUP_ITM_ID_PASSPRT)) {
				                        custDtlVO.setPassportIdVO((IdentityVO) idVO.clone());
				                        custDtlVO.getPassportIdVO().setIdNo(idVO.getIdNo());
				                        if (idVO.getIdentityDetailVO() != null) {
				                            custDtlVO.getPassportIdVO().setIdentityDetailVO(
				                                (IdentityDetailVO) idVO.getIdentityDetailVO().clone());
				                            custDtlVO.getPassportIdVO().setUploadedFile(
				                                custDtlVO.getPassportIdVO().getIdentityDetailVO().getScannedPath());
				                        } else {
				                            custDtlVO.getPassportIdVO().setIdentityDetailVO(new IdentityDetailVO());
				                            custDtlVO.getPassportIdVO().getIdentityDetailVO().setIdCountry(
				                                CommonConstant.DEF_COUNTRY_ID);
				                        }
				                    }
				                }
				            }
				            loadReferenceNo(invoicePaxVO, false);
				        }
				    }
				    
					custDetailsVO = invoiceVO.getCustDetailsVO();
					invoiceVO.setIssuedBy(getUserName(invoiceVO.getIssuerId()));
					
					calTtlAmt(null, false);
				}
				calculateTotalUApple(invoiceVO.getCustDetailsVO(), invoiceVO.getInvoicePaxList());
				if (invoiceVO.getId() == null ||  isViewableInvoice(invoiceVO.getCatCd())) {
					setStrOnLoad("fncLoad()");
				} else {
					FacesContext.getCurrentInstance().addMessage(null, new FacesMessage(FacesMessage.SEVERITY_ERROR, "Not Authorize to access!", "Not Authorize to access!"));
				}
				
				// Check Financial Period Closed
				invoiceVO.setDateInFinPeriodClosed(getFinPeriodClosedStatus());
				// Check Invoice Date changeable
				invoiceVO.setInvoiceDateChangeable(getInvoiceDateChangeable());
				
				// Preset GST and Round Acct
				invoiceVO.setIdAcctGST(this.getSessionInfoBean().getCompanyVO().getIdAcctGST());
				//invoiceVO.setIdAcctRounding(this.getSessionInfoBean().getCompanyVO().getIdAcctRounding());
				
				//set the transferred date to this format (dd-MMM-yyyy)
				if (invoiceVO.getTransferredDate() != null) {
					SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy");
					String formatedTransferredDate = sdf.format(invoiceVO.getTransferredDate());
					invoiceVO.setFormattedTransferredDate(formatedTransferredDate);
				}
			}
			
			if (custDetailsVO != null && String.valueOf(custDetailsVO.getCode()).equals(onlineBookingConfigVO.getValue())) {
				disableEditCustomer = true;
			}
			
			// Check is booking lock, if yes then remarks not able to edit and invoice detail add/edit/delete button will be hidden
			disabledRemarks = false;
			hideInvoiceDetailChange = false;
			if (invoiceVO != null) {
				checkBookingLock(invoiceVO.getBookingId(), invoiceVO.getIdParentInvTourBooking());
				if (invoiceVO.getId() != null) checkPOSUploadEditable(invoiceVO.getId().toString());
			}
			if (invoiceVO != null) {
				invBeforeEInv = isInvoiceBeforeEInvoice(invoiceVO);
				if(StringUtils.isNotBlank(invoiceVO.getDocTypeCd())) setDocTypeCd(invoiceVO.getDocTypeCd());			
			}
		} catch(Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}
	
	private boolean isViewableInvoice(String catCode) {
		// Config of Role that allow to view certain list by category code
		boolean isViewable = true;
		if (CollectionUtils.isNotEmpty(visibleConfigList)) {
			for (VisibleListingConfigVO vo : visibleConfigList) {
				// Category Code not exists in config all will be viewable
				if (StringUtils.equals(catCode, vo.getCatCd())) {
					isViewable = false; // To indicate that config have category code but role didnt match
					
					if (vo.getIdRoleList() != null) {
						for (String idRole : vo.getIdRoleList()) {
							for (UserRoleViewVO roleVO : getSessionInfo().getUserVO().getRoleList()) {
								if (roleVO.getRoleUUID().equals(idRole)) {
									isViewable = true;
									break;
								}
							}
						}
					}
					
					if (vo.getDepartmentList() != null) {
						for (String dept : vo.getDepartmentList()) {
							if (getSessionInfoBean().getEmployeeVO().getDepartment().equalsIgnoreCase(dept)) {
								isViewable = true;
								break;
							}
						}
					}
					return isViewable;
				}
			}
		}
		
		return isViewable;
	}
	
	public boolean isAddNewCust(boolean addNewCust) {
		if(addNewCust) {
			isAddNewCust = true;
		}else {
			isAddNewCust = false;
		}
		return isAddNewCust;
	}
	
	private void checkPOSUploadEditable(String idInv) throws BusinessException {
		// Check Invoice was POS uploaded
		Map<String, Object> params = new HashMap<>();
		Map<String, String> filters = new HashMap<>();
		filters.put("idInvoice", idInv);
		params.put("filters", filters);
		
		editablePOSUploaded = true;
		lockAmountChanges = false;
		
		if (posUploadSalesBO.getPOSUploadSalesTransListCount(params) > 0) {
			
			POSUploadSalesTransVO posUploadSalesTransVO = posUploadSalesBO.getPOSUploadSalesTransVO(params);
			if (posUploadSalesTransVO != null) {
				posTotalAmountLocked = posUploadSalesTransVO.getGrandTotal();
			} else {
				posTotalAmountLocked = SerializationUtils.clone(invoiceVO.getAmount());
			}
			
			editablePOSUploaded = false;
			lockAmountChanges = true;
			
			if (invPmntAuthVO.isAccountManager()) {
				editablePOSUploaded = true; // Account role can edit even the POS uploaded
			}
		}
	}
	
