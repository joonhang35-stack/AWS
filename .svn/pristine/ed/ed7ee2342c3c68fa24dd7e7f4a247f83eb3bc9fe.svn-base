<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:pe="http://primefaces.org/ui/extensions"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
	  			xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

<script type="text/javascript">
	function onValidation(xhr, status, args) {
		if (!args.validationFailed) {
			varAddBookingDialog.hide();
		}
	}
	function onAddValidation(xhr, status, args) {
		if (!args.validationFailed) {
			varAddBookingDialog.hide();
		}
	}
	
	function handleComplete(tourDepId) {
		var ftTwnPax = $("#idAddInvoiceForm\\:idFtTwn").val();
		var ftSglPax = $("#idAddInvoiceForm\\:idFtSgl").val();
		var ftCtwPax = $("#idAddInvoiceForm\\:idFtCtw").val();
		var ftCwbPax = $("#idAddInvoiceForm\\:idFtCwb").val();
		var ftCnbPax = $("#idAddInvoiceForm\\:idFtCnb").val();
		var ftInftPax = $("#idAddInvoiceForm\\:idFtInft").val();
		var gaTwnPax = $("#idAddInvoiceForm\\:idGaTwn").val();
		var gaSglPax = $("#idAddInvoiceForm\\:idGaSgl").val();
		var gaCtwPax = $("#idAddInvoiceForm\\:idGaCtw").val();
		var gaCwbPax = $("#idAddInvoiceForm\\:idGaCwb").val();
		var gaCnbPax = $("#idAddInvoiceForm\\:idGaCnb").val();
		var gaInftPax = $("#idAddInvoiceForm\\:idGaInft").val();
		
		var params = "&amp;ftTwnPax=" + ftTwnPax;
		params += "&amp;ftSglPax=" + ftSglPax;
		params += "&amp;ftCtwPax=" + ftCtwPax;
		params += "&amp;ftCwbPax=" + ftCwbPax;
		params += "&amp;ftCnbPax=" + ftCnbPax;
		params += "&amp;ftInftPax=" + ftInftPax;
		params += "&amp;gaTwnPax=" + gaTwnPax;
		params += "&amp;gaSglPax=" + gaSglPax;
		params += "&amp;gaCtwPax=" + gaCtwPax;
		params += "&amp;gaCwbPax=" + gaCwbPax;
		params += "&amp;gaCnbPax=" + gaCnbPax;
		params += "&amp;gaInftPax=" + gaInftPax;
		/* alert('#{request.contextPath}/app/emailtmp/bookingemailtmp?tourDepId=' + tourDepId + params); */
		window.open('#{request.contextPath}/app/emailtmp/cruisebookingemailtmp?tourDepId=' + tourDepId + params);
	}
	function onBookingTransferValidation(xhr, status, args) {
		if (!args.validationFailed) {
			varAvailableTourDepListDialog.show();
		}
	}
</script>

<p:growl id="msg"/>
<p:panelGrid>
	<p:row>
		<p:column><h:outputText value="Dep Date"/></p:column>
		<p:column><h:outputText value="#{tourPkgBean.tourDepVO.dtDep}"><f:convertDateTime pattern="dd-MMM-yyyy"/></h:outputText></p:column>
	</p:row>
	<p:row>
		<p:column><h:outputText value="Tour Name"/></p:column>
		<p:column><h:outputText value="#{tourPkgBean.tourPkgVO.numDays}D/#{tourPkgBean.tourPkgVO.numNights}N "/><h:outputText value="#{tourPkgBean.tourPkgVO.nameEn}"/> <h:outputText value=" [#{tourPkgBean.tourDepVO.desc}]"/></p:column>
	</p:row>
	<p:row>
		<p:column><h:outputText value="Invoice No."/></p:column>
		<p:column><h:outputText value="#{tourPkgBean.bookingVO.invoiceVO.code}" rendered="#{not empty tourPkgBean.bookingVO.invoiceVO}"/></p:column>
	</p:row>
</p:panelGrid>
<p:panel>
	<p:panelGrid>
		<p:row>
			<p:column style="width: 100px;"><h:outputLabel>Sales Person</h:outputLabel></p:column>
			<p:column style="width: 140px;">
				<p:inputText value="#{tourPkgBean.sessionInfoBean.userVO.name}" readonly="true" style="background:#ccc" rendered="#{tourPkgBean.bookBoolean.add and not tourPkgBean.salesPersonAuth}"/>
				<p:inputText value="#{tourPkgBean.bookingVO.employeeViewVO.userVO.name}" readonly="true" style="background:#ccc" rendered="#{tourPkgBean.bookBoolean.upd and not tourPkgBean.salesPersonAuth}"/>
				<h:selectOneMenu value="#{tourPkgBean.bookingVO.idEmployee}" rendered="#{(tourPkgBean.bookBoolean.add or tourPkgBean.bookBoolean.upd) and tourPkgBean.salesPersonAuth}">
					<f:selectItems value="#{tourPkgBean.employeeList}" var="vo" itemValue="#{vo.id}" itemLabel="#{vo.userVO.name}"/>
				</h:selectOneMenu>
			</p:column>
			<p:column style="width: 80px;">
				<h:outputLabel for="idAddSurvey">Survey</h:outputLabel>
			</p:column>
			<p:column style="padding-top: 10px;padding-bottom: 0px;width: 300px;">
				<p:selectCheckboxMenu id="idAddSurvey" label="Select" onHide="updateSurveyDesc();"
					value="#{tourPkgBean.bookingVO.idSurveyList}" filter="true" filterMatchMode="contains">
					<f:selectItems value="#{bterp:lookupItemList('survey_type')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
				</p:selectCheckboxMenu>
				<p:remoteCommand name="updateSurveyDesc" update="idSurveyDesc" global="false"/>
			</p:column>
		</p:row>
		<p:row>
			<p:column><h:outputLabel>Order Source</h:outputLabel></p:column>
			<p:column>
				<h:selectOneMenu value="#{tourPkgBean.bookingVO.orderTypeCd}" effect="fade">
					<f:selectItems value="#{bterp:lookupItemList('ordr_sorc')}" var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}"/>
				</h:selectOneMenu>
			</p:column>
			<p:column colspan="2" style="width: 300px;">
				<p:outputLabel id="idSurveyDesc" value="#{tourPkgBean.bookingVO.surveyDesc}" />
			</p:column>
		</p:row>
		<p:row>
			<p:column colspan="4">
				<p:panelGrid>
					<p:row>
						<p:column>
							<p:commandButton value="Add" actionListener="#{tourPkgBean.onAddBookingCruiseCabin}" oncomplete="varAddBookingCruiseCabinDialog.show()" update=":idAddBookingCruiseCabinDialog" immediate="true"/>
						</p:column>
					</p:row>
				</p:panelGrid>
				
				<div style="height:250px;overflow:auto;">
				<p:dataTable id="idTourCabinListTable" value="#{tourPkgBean.bookingVO.tourCruiseCabinList}" var="cabinVO" paginator="true" rows="5" 
					paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
					rowsPerPageTemplate="5">
					<p:column headerText="Edit" style="width:50px; text-align:center;">
						<p:commandButton icon="ui-icon-pencil" actionListener="#{tourPkgBean.onBookingCruiseCabinSelected(cabinVO)}" oncomplete="varAddBookingCruiseCabinDialog.show()" update=":idAddBookingCruiseCabinDialog" process="@this"/>
					</p:column>
					<p:column headerText="Delete" style="width:50px; text-align:center;">
						<p:commandButton icon="ui-icon-close" actionListener="#{tourPkgBean.deleteBookingCruiseCabin(cabinVO)}" update=":idAddInvoiceForm:idTourCabinListTable,:idAddInvoiceForm:idTotalAmtGroup" process="@this"/>
					</p:column>
					<p:column headerText="Cabin Type">
						<h:outputText value="#{cabinVO.cruiseCabinCd}"/>
					</p:column>
					<p:column headerText="Adult 1ST/2ND" style="text-align:center;">
						<h:outputText value="#{cabinVO.paxTwn}"/>
					</p:column>
					<p:column headerText="Adult 3RD" style="text-align:center;">
						<h:outputText value="#{cabinVO.pax3}"/>
					</p:column>
					<p:column headerText="Adult 4TH" style="text-align:center;">
						<h:outputText value="#{cabinVO.pax4}"/>
					</p:column>
					<p:column headerText="Adult SGL" style="text-align:center;">
						<h:outputText value="#{cabinVO.paxSgl}"/>
					</p:column>
					<p:column headerText="Child 3RD" style="text-align:center;">
						<h:outputText value="#{cabinVO.pax3Chd}"/>
					</p:column>
					<p:column headerText="Child 4TH" style="text-align:center;">
						<h:outputText value="#{cabinVO.pax4Chd}"/>
					</p:column>
					<p:column headerText="Infant" style="text-align:center;">
						<h:outputText value="#{cabinVO.paxInf}"/>
					</p:column>
					<p:column headerText="Total Cabin" style="text-align:center;">
						<h:outputText value="#{cabinVO.ttlCabin}"/>
					</p:column>
				</p:dataTable>
				</div>
			</p:column>
		</p:row>
		<p:row>
			<p:column />
			<p:column colspan="3">
				<p:panelGrid id="idTotalAmtGroup">
					<p:row>
						<p:column style="text-align:right">
							<h:outputLabel>
							Total Amount:
							</h:outputLabel>&nbsp;
							<p:inputText id="idTotalAmount" value="#{tourPkgBean.bookingVO.totalAmount}"
								label="Total Amount" required="true" readonly="true" 
								style="background:#ccc; text-transform:uppercase;">
								<f:convertNumber pattern="#,##0.00"/>
							</p:inputText>
						</p:column>
					</p:row>
					<p:row>
						<p:column style="text-align:right">
							<h:outputLabel>
							Discount Amount:
							</h:outputLabel>&nbsp;
							<p:inputText id="idDiscountAmount" value="#{tourPkgBean.bookingVO.discountAmount}"
								label="Discount Amount" required="true" readonly="true" 
								style="background:#ccc; text-transform:uppercase;">
								<f:convertNumber pattern="#,##0.00"/>
							</p:inputText>
						</p:column>
					</p:row>
					<p:row>
						<p:column style="text-align:right">
							<h:outputLabel>
							Deposit Amount:
							</h:outputLabel>&nbsp;
							<p:inputText id="idDepositAmount" value="#{tourPkgBean.bookingVO.depositAmount}"
								label="Deposit Amount" required="true" readonly="true" 
								style="background:#ccc; text-transform:uppercase;">
								<f:convertNumber pattern="#,##0.00"/>
							</p:inputText>
						</p:column>
					</p:row>
					<p:row>
						<p:column style="text-align:right">
							<h:outputLabel>
							Total Amount Payable:
							</h:outputLabel>&nbsp;
							<p:inputText id="idTotalAmountPayable" value="#{tourPkgBean.bookingVO.amountPayable}"
								label="Total Amount Payable" required="true" readonly="true" 
								style="background:#ccc; text-transform:uppercase;">
								<f:convertNumber pattern="#,##0.00"/>
							</p:inputText>
						</p:column>
					</p:row>
				</p:panelGrid>
			</p:column>
		</p:row>
		<p:row>
			<p:column><h:outputLabel for="idCustDetails">Customer <span class="required">*</span></h:outputLabel></p:column>
			<p:column colspan="3">
				<p:inputText id="idCustDetails" label="Customer" value="#{tourPkgBean.custDetailsVO.contPersonName}" required="true" readonly="true" style="background:#ccc; text-transform:uppercase;"/>&nbsp;
				<p:commandButton icon="ui-icon-search" oncomplete="varCustListDialog.show()" update=":idCustListDialog"/>
				<p:commandButton icon="ui-icon-plus" oncomplete="varAddCustDialog.show()" update=":idAddCustDialog"/>
				<h:inputHidden id="idAttTo"/>
				<h:inputHidden id="idTotalUPoint"/>
				<h:inputHidden id="idTotalVoucher"/>
			</p:column>
		</p:row>
	</p:panelGrid>
</p:panel>
<h:panelGrid columns="3" style="width:1px;">
	<p:commandButton value="#{msg['common.button.label.update']}" actionListener="#{tourPkgBean.updBooking}" update="@form,:idTourDepListForm,:idBookingListForm,:idTourPkgForm:idTab:idFilterTourDepList" oncomplete="onValidation(xhr, status, args)" rendered="#{tourPkgBean.bookBoolean.upd and not tourPkgBean.fromBookingPage}"/>
	<!-- <p:commandButton value="#{msg['common.button.label.update']}" actionListener="#{tourPkgBean.updBooking2}" update="@form,:idBookingListForm:idBookingList,:idAddInvoiceForm" oncomplete="onValidation(xhr, status, args)" rendered="#{tourPkgBean.bookBoolean.upd and tourPkgBean.fromBookingPage}"/> -->
	<p:commandButton value="#{msg['common.button.label.cancel']}" actionListener="#{tourPkgBean.resetBookingForm}" update="@form" process="@this" oncomplete="varAddBookingDialog.hide()" rendered="#{not tourPkgBean.fromBookingPage}">
		<pe:resetEditableValues for="idAddInvoiceForm"/>
	</p:commandButton>
	<p:commandButton value="#{msg['common.button.label.cancel']}" update="@form,:idAddInvoiceForm:idCustDetails" oncomplete="varAddBookingDialog.hide()" rendered="#{tourPkgBean.fromBookingPage}"/>
</h:panelGrid>
</ui:composition>