<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">
	<p:tabView id="idTab">
		<p:tab id="idTabList" title="Package Info">
			<p:panel
				header="#{tourPkgBean.tourPkgVO.numDays}D/#{tourPkgBean.tourPkgVO.numNights}N #{tourPkgBean.tourPkgVO.nameEn} #{tourPkgBean.tourPkgVO.nameZh} #{tourPkgBean.tourPkgVO.nameOther}"
				style="border:0;">
				<div style="width:100%; height: 450px; overflow: auto;">
					<h:outputText
						value="#{fn:replace(tourPkgBean.tourPkgVO.highLight, '\\n', '&lt;br/&gt;')}"
						escape="false" />
					<br />
					<h:outputText value="Full Tour Price" style="font-weight:bold;"/>
					<div class="ui-datatable ui-widget">
						<table>
							<thead>
								<tr>
									<th colspan="2" class="ui-state-default" style="padding: 5px;"><h:outputText
											value="ADULT (RM)" /></th>
									<th colspan="3" class="ui-state-default"><h:outputText
											value="CHILD (RM)" /></th>
								</tr>
								<tr>
									<th class="ui-state-default" style="padding: 5px;"><h:outputText
											value="TWN" /></th>
									<th class="ui-state-default"><h:outputText value="SGL" /></th>
									<th class="ui-state-default"><h:outputText value="CTW" /></th>
									<th class="ui-state-default"><h:outputText value="CWB" /></th>
									<th class="ui-state-default"><h:outputText value="CNB" /></th>
								</tr>
							</thead>
							<tbody class="ui-datatable-data ui-widget-content">
								<tr>
									<td style="text-align: center; padding: 5px;"><h:outputText
											value="#{tourPkgBean.tourDepVO.fullTwn}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.fullSgl}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.fullCtw}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.fullCeb}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.fullCnb}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
								</tr>
							</tbody>
						</table>
					</div>
					<h:outputText value="Full Remarks (Departure)" style="font-weight:bold;"/>
					<br/>
					<h:outputText
						value="#{fn:replace(tourPkgBean.tourDepVO.fullRemarks, '\\n', '&lt;br/&gt;')}"
						escape="false" style="font-size:10px;"
						rendered="#{not empty tourPkgBean.tourDepVO.fullRemarks}" />
					<br /><br />
					<h:outputText value="Full Remarks (Package)" style="font-weight:bold;"/>
					<br/>
					<h:outputText
						value="#{fn:replace(tourPkgBean.tourPkgVO.fullRemarks, '\\n', '&lt;br/&gt;')}"
						escape="false" style="font-size:10px;"
						rendered="#{not empty tourPkgBean.tourPkgVO.fullRemarks}" />
					<br /> <br />
					<h:outputText value="Ground Only Price"	style="font-weight:bold;" />
					<div class="ui-datatable ui-widget">
						<table>
							<thead>
								<tr>
									<th colspan="2" class="ui-state-default" style="padding: 5px;"><h:outputText
											value="ADULT (RM)" /></th>
									<th colspan="3" class="ui-state-default"><h:outputText
											value="CHILD (RM)" /></th>
								</tr>
								<tr>
									<th class="ui-state-default" style="padding: 5px;"><h:outputText
											value="TWN" /></th>
									<th class="ui-state-default"><h:outputText value="SGL" /></th>
									<th class="ui-state-default"><h:outputText value="CTW" /></th>
									<th class="ui-state-default"><h:outputText value="CWB" /></th>
									<th class="ui-state-default"><h:outputText value="CNB" /></th>
								</tr>
							</thead>
							<tbody class="ui-datatable-data ui-widget-content">
								<tr>
									<td style="text-align: center; padding: 5px;"><h:outputText
											value="#{tourPkgBean.tourDepVO.grndTwn}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.grndSgl}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.grndCtw}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.grndCeb}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.grndCnb}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
								</tr>
							</tbody>
						</table>
					</div>
					<h:outputText value="Ground Remarks (Departure)" style="font-weight:bold;"/>
					<br/>
					<h:outputText
						value="#{fn:replace(tourPkgBean.tourDepVO.grndRemarks, '\\n', '&lt;br/&gt;')}"
						escape="false" style="font-size:10px;"
						rendered="#{not empty tourPkgBean.tourDepVO.grndRemarks}" />
					<br /><br />
					<h:outputText value="Ground Remarks (Package)" style="font-weight:bold;"/>
					<br/>
					<h:outputText
						value="#{fn:replace(tourPkgBean.tourPkgVO.grndRemarks, '\\n', '&lt;br/&gt;')}"
						escape="false" style="font-size:10px;"
						rendered="#{not empty tourPkgBean.tourPkgVO.grndRemarks}" />
					<br /> <br />
					<h:outputText value="Airline" style="font-weight:bold;" />
					<div class="ui-datatable ui-widget">
						<table>
							<thead>
								<tr>
									<th class="ui-state-default" style="padding: 5px;">Airline</th>
									<th class="ui-state-default" style="padding: 5px;">Visa</th>
									<th class="ui-state-default" style="padding: 5px;">A/C</th>
									<th class="ui-state-default" style="padding: 5px;">Tipping</th>
									<th class="ui-state-default" style="padding: 5px;">**Others</th>
									<th class="ui-state-default" style="padding: 5px;">APT Tax<br />(Adult/Child)
									</th>
									<th class="ui-state-default" style="padding: 5px;">YQ
										&amp; Fuel<br />(Adult/Child)
									</th>
									<th class="ui-state-default" style="padding: 5px;">Travel<br />Insurance
									</th>
									<th class="ui-state-default" style="padding: 5px;">Total(RM)<br />(Adult/Child)
									</th>
									<th class="ui-state-default" style="padding: 5px;">Grp Tkt<br />Validity
									</th>
									<th class="ui-state-default" style="padding: 5px;">Deviation</th>
								</tr>
							</thead>
							<tbody class="ui-datatable-data ui-widget-content">
								<tr>
									<td style="text-align: center; padding: 5px;"><h:outputText
											value="#{tourPkgBean.tourDepVO.airlineVO.code}" /></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.airlineVisa}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.airlineAC}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.airlineTipping}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.airlineExtra}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.airlineAptAdt}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText>/<h:outputText value="#{tourPkgBean.tourDepVO.airlineAptChd}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.airlineYqAdt}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText>/<h:outputText value="#{tourPkgBean.tourDepVO.airlineYqChd}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.airlineTrvlIns}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.airlineTotAdt}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText>/<h:outputText value="#{tourPkgBean.tourDepVO.airlineTotChd}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.tktValidity}" /></td>
									<td style="text-align: center;"><h:outputText
											value="#{tourPkgBean.tourDepVO.airlineDeviation}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText></td>
								</tr>
							</tbody>
						</table>
					</div>
					<h:outputText value="Airline Remarks:" style="font-size:11px; font-weight:bold;" />
					<br />
					<h:outputText
						value="#{tourPkgBean.tourDepVO.airlineScheduleVO.remarks}"
						style="font-size:11px;" />
					<br /> <br />
					<h:outputText value="**Others:" style="font-size:11px; font-weight:bold;"/>
					<br />
					<p:panelGrid style="width:400px;">
						<c:if test="#{not empty tourPkgBean.tourDepVO.airlineScheduleVO.extraItemChargeList}">
							<c:forEach
								items="#{tourPkgBean.tourDepVO.airlineScheduleVO.extraItemChargeList}"
								var="chargeVO">
								<p:row>
									<p:column style="width:350px;">
										<h:outputText value="#{chargeVO.typeDesc}" />
									</p:column>
									<p:column style="width:50px;">
										<h:outputText value="#{chargeVO.amount}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText>
									</p:column>
								</p:row>
							</c:forEach>
						</c:if>
						<c:if test="#{not empty tourPkgBean.tourDepVO.extraItemChargeList}">
							<c:forEach items="#{tourPkgBean.tourDepVO.extraItemChargeList}" var="extraVO">
								<p:row>
									<p:column style="width:550px;">
										<h:outputText value="#{extraVO.desc}" />
									</p:column>
									<p:column style="width:50px;">
										<h:outputText value="#{extraVO.amount}">
											<f:convertNumber pattern="#,##0.00" />
										</h:outputText>
									</p:column>
								</p:row>
							</c:forEach>
						</c:if>
					</p:panelGrid>
					<br />
					<c:if test="#{tourPkgBean.tourDepVO.isShowAirline}">
						<h:outputText value="Flight Schedule (Subject to change)" style="font-weight:bold;"/>
						<br />
						<h:outputText value="No flight schedule selected."
							style="color:#FF0000; font-size:10px;"
							rendered="#{empty tourPkgBean.tourDepVO.airlineScheduleVO}" />
						<p:dataTable
							value="#{tourPkgBean.tourDepVO.airlineScheduleVO.airlineScheduleItemList}"
							var="itemVO" style="margin-bottom:5px;"
							rendered="#{not empty tourPkgBean.tourDepVO.airlineScheduleVO}">
							<p:column headerText="Seq" style="width:50px">
								<h:outputText value="#{itemVO.seq}" />
							</p:column>
							<p:column headerText="Type" style="width:80px">
								<h:outputText value="#{itemVO.typeCd}" />
							</p:column>
							<p:column headerText="Dep Date" style="width:130px">
								<h:outputText value="#{itemVO.departureDate}">
									<f:convertDateTime pattern="#{config['date.display.pattern2']}" />
								</h:outputText>
							</p:column>
							<p:column headerText="Arr Date" style="width:130px">
								<h:outputText value="#{itemVO.arrivalDate}">
									<f:convertDateTime pattern="#{config['date.display.pattern2']}" />
								</h:outputText>
							</p:column>
							<p:column headerText="Flight Code" style="width:80px">
								<h:outputText value="#{itemVO.flightCd}" />
							</p:column>
							<p:column headerText="From" style="width:80px">
								<h:outputText value="#{itemVO.fromAirportCd}" />
							</p:column>
							<p:column headerText="To" style="width:80px">
								<h:outputText value="#{itemVO.toAirportCd}" />
							</p:column>
							<p:column headerText="ETD" style="width:80px">
								<h:outputText value="#{itemVO.etd}" />
							</p:column>
							<p:column headerText="ETA" style="width:80px">
								<h:outputText value="#{itemVO.eta}"
									rendered="#{not itemVO.isNextDay}" />
								<h:outputText value="#{itemVO.eta}+1"
									rendered="#{itemVO.isNextDay}" />
							</p:column>
							<p:column headerText="Remarks" style="width:200px">
								<h:outputText value="Est #{itemVO.remarks}" />
							</p:column>
						</p:dataTable>
						<br />
						<br />
					</c:if>
					<h:outputText value="Hotel Stay" style="font-weight:bold;"/>
					<br />
					<h:outputText value="No hotel selected."
						style="color:#FF0000; font-size:10px;"
						rendered="#{empty tourPkgBean.tourDepVO.tourHotelList}" />
					<p:dataTable value="#{tourPkgBean.tourDepVO.tourHotelList}"
						var="vo"
						rendered="#{not empty tourPkgBean.tourDepVO.tourHotelList}">
						<!--p:column headerText="No. of Nights" style="width:50px;"><h:outputText value="#{vo.nightNum}"/></p:column-->
						<p:column headerText="From Date" style="width:100px;">
							<h:outputText value="#{vo.fromDate}">
								<f:convertDateTime pattern="dd-MMM-yyyy" />
							</h:outputText>
						</p:column>
						<p:column headerText="To Date" style="width:100px;">
							<h:outputText value="#{vo.toDate}">
								<f:convertDateTime pattern="dd-MMM-yyyy" />
							</h:outputText>
						</p:column>
						<p:column headerText="Hotel Name">
							<h:outputText value="#{vo.hotelVO.name}" />
						</p:column>
						<p:column headerText="Stars">
							<h:outputText value="#{vo.hotelVO.starCd}" />
						</p:column>
						<p:column headerText="Website">
							<h:outputText value="#{vo.hotelVO.website}" />
						</p:column>
					</p:dataTable>
					<!--br/>
<h:outputText value="Discount"/>&nbsp;&nbsp;
<h:outputText value="#{tourPkgBean.tourDepVO.tfairDiscount}"><f:convertNumber pattern="RM#,##0"/></h:outputText-->
					<br /> <br />
					<h:outputText value="Itinerary" style="font-weight:bold;" />
					<p:panelGrid>
						<p:row>
							<p:column style="width:100px;">
								<h:outputText value="English" />
							</p:column>
							<p:column>
								<c:if test="#{not empty tourPkgBean.itineryMap['CUSTEN'].name}">
									<h:outputLink target="_blank"
										value="#{request.contextPath}#{tourPkgBean.itineryMap['CUSTEN'].path}/#{tourPkgBean.urlEncoder(tourPkgBean.itineryMap['CUSTEN'].name)}"
										style="color:#0040FF;">
										<h:outputText value="#{tourPkgBean.itineryMap['CUSTEN'].name}" />
									</h:outputLink>
								</c:if>
							</p:column>
						</p:row>
						<p:row>
							<p:column style="width:100px;">
								<h:outputText value="Chinese/Malay" />
							</p:column>
							<p:column>
								<c:if test="#{not empty tourPkgBean.itineryMap['CUSTZH'].name}">
									<h:outputLink target="_blank"
										value="#{request.contextPath}#{tourPkgBean.itineryMap['CUSTZH'].path}/#{tourPkgBean.urlEncoder(tourPkgBean.itineryMap['CUSTZH'].name)}"
										style="color:#0040FF;">
										<h:outputText value="#{tourPkgBean.itineryMap['CUSTZH'].name}" />
									</h:outputLink>
								</c:if>
							</p:column>
						</p:row>
					</p:panelGrid>
				</div>
			</p:panel>
		</p:tab>
		<p:tab id="idTabCms" title="Itinerary CMS"
			rendered="#{tourPkgBean.tourDepVO.tourPackageDailyItineraryVO ne null}">
			<p:panel
				header="#{tourPkgBean.tourDepVO.tourPackageDailyItineraryVO.title}"
				style="border:0;">
				<div style="width: 900px; height: 450px; overflow: auto;">
					<p:panelGrid id="idPanelDailyItineraryItem">
						<p:row>
							<p:column>
								<p:selectOneButton
									value="#{tourPkgBean.tourDepVO.tourPackageDailyItineraryVO.langCd}">
									<f:selectItem itemLabel="ENGLISH" itemValue="ENG" />
									<f:selectItem itemLabel="CHINESE" itemValue="ZH" />
									<p:ajax global="false"
										update=":idTourDepMoreInfoForm:idTab:idTableDailyItineraryItem" />
								</p:selectOneButton>
							</p:column>
						</p:row>
					</p:panelGrid>

					<p:dataTable id="idTableDailyItineraryItem"
						value="#{tourPkgBean.tourDepVO.tourPackageDailyItineraryVO.langCd eq 'ENG' ? tourPkgBean.tourDepVO.tourPackageDailyItineraryVO.dailyItineraryItemEngVOList : tourPkgBean.tourDepVO.tourPackageDailyItineraryVO.dailyItineraryItemZhVOList}"
						var="subVo" style="margin: 10px; width: 1100px;" rows="10"
						paginator="true"
						paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink} {RowsPerPageDropdown}"
						rowsPerPageTemplate="10,15,20">
						<p:column headerText="Seq" style="width:50px; text-align:center;">
							<h:outputText value="#{subVo.seq}" />
						</p:column>
						<p:column headerText="Title" style="width:200px;">
							<h:outputText value="#{subVo.title}" escape="false" />
						</p:column>
						<p:column headerText="Hotel" style="width:200px;">
							<h:outputText value="#{subVo.hotel}" escape="true"
								style="white-space: pre-wrap" />
						</p:column>
						<p:column headerText="Meals" style="width:200px;">
							<h:outputText value="#{subVo.meals}" escape="true"
								style="white-space: pre-wrap" />
						</p:column>
						<p:column headerText="Description">
							<h:outputText value="#{subVo.description}" escape="false" />
						</p:column>
						<p:column headerText="Remark" style="width:200px">
							<h:outputText value="#{subVo.remarks}" escape="true"
								style="white-space: pre-wrap" />
						</p:column>
					</p:dataTable>
					<br /> <br />
					<h:outputText value="Itinerary" />
					<p:panelGrid>
						<p:row>
							<p:column style="width:100px;">
								<h:outputText value="English" />
							</p:column>
							<p:column>
								<c:if
									test="#{not empty tourPkgBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTEN'].name}">
									<h:outputLink target="_blank"
										value="#{request.contextPath}#{tourPkgBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTEN'].path}/#{tourPkgBean.urlEncoder(tourPkgBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTEN'].name)}"
										style="color:#0040FF;">
										<h:outputText
											value="#{tourPkgBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTEN'].name}" />
									</h:outputLink>
								</c:if>
							</p:column>
						</p:row>
						<p:row>
							<p:column style="width:100px;">
								<h:outputText value="Chinese/Malay" />
							</p:column>
							<p:column>
								<c:if
									test="#{not empty tourPkgBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTZH'].name}">
									<h:outputLink target="_blank"
										value="#{request.contextPath}#{tourPkgBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTZH'].path}/#{tourPkgBean.urlEncoder(tourPkgBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTZH'].name)}"
										style="color:#0040FF;">
										<h:outputText
											value="#{tourPkgBean.tourDepVO.tourPackageDailyItineraryVO.pkgItineryMap['DAILY_ITINERARY_CUSTZH'].name}" />
									</h:outputLink>
								</c:if>
							</p:column>
						</p:row>
					</p:panelGrid>
				</div>
			</p:panel>
		</p:tab>
	</p:tabView>
	<h:panelGrid columns="1">
		<p:commandButton value="#{msg['common.button.label.cancel']}"
			actionListener="#{tourPkgBean.resetTourDepForm}"
			onclick="varTourDepMoreInfoDialog.hide()" />
	</h:panelGrid>

</ui:composition>