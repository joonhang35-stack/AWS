	@SuppressWarnings("unchecked")
	@Override
	public List<RegionVO> getRegionListParam(Map<String, Object> params, RegionVO regionVO) throws BusinessException
	{
		List<String> listFilteredValue = new ArrayList<String>();
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT r.id, r.code, r.name, r.dt_created, r.created_by, r.dt_upd, r.upd_by ")
			.append("FROM region r ");
		Map<String, String> filters = (Map<String, String>) params.get("filters");
		
		if(regionVO != null) {
			sb.append(" WHERE r.id=" + regionVO.getId());
			listFilteredValue = addFilterRegionList(filters, sb, true);
		} else {
			listFilteredValue = addFilterRegionList(filters, sb, false);
		}
		
		sb.append(" ORDER BY ");
		String sortField = (String) params.get("sortField");
		if (sortField == null) {
			if(listFilteredValue.size() == 0)
			{	
				sb.append("r.name");
			} else {
				sb.append(getOrderByMatches(listFilteredValue.get(2), listFilteredValue.get(1)));
			}
			sb.append(" ASC");
		}	
		else 
		{
			if ("regioncode".equals(sortField)) sb.append("r.code");
			else if("regionname".equals(sortField)) sb.append("r.name");
			
			if (CommonConstant.SORT_ASC.equals(((SortOrder) params.get("sortOrder")).toString())) sb.append(" asc");
			else sb.append(" desc");
		}
		
		Query query = createSQLQuery(sb.toString());
		query.setFirstResult((int) params.get("first"));
		query.setMaxResults((int) params.get("pageSize"));
		
		List<Object> objList = query.list();
		List<RegionVO> list = new ArrayList<RegionVO>();
		
		if (CollectionUtils.isNotEmpty(objList)) {
			for (Iterator<Object> it = objList.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				RegionVO vo = new RegionVO();
				vo.setId(((BigInteger) row[0]).longValue());
				vo.setRegioncode((String) row[1]);
				vo.setRegionname((String) row[2]);
				vo.setCreatedDate((Date) row[3]);
				vo.setCreatedBy((String) row[4]);
				vo.setUpdatedDate((Date) row[5]);
				vo.setUpdatedBy((String) row[6]);
				list.add(vo);
			}
		}
		
		return list;
	}
	
	@SuppressWarnings("unchecked")
