		if (sortField == null) 
		{
//			if(listFilteredValue.size() == 0)
//			{	
//				sb.append("c.name");
//			} else {
//				sb.append(getOrderByMatches(listFilteredValue.get(2), listFilteredValue.get(1)));
//			}
			sb.append("c.name");
			sb.append(" ASC");
		}
		else 
		{
			
			if ("code".equals(sortField)) sb.append("c.code");
			else if("country".equals(sortField)) sb.append("c.name");
			else if("regionname".equals(sortField)) sb.append("r.name");
			
			if (CommonConstant.SORT_ASC.equals(((SortOrder) params.get("sortOrder")).toString())) sb.append(" asc");
			else sb.append(" desc");
		}
		
//		System.out.println(sb.toString());
		
		Query query = createSQLQuery(sb.toString());
		query.setFirstResult((int) params.get("first"));
		query.setMaxResults((int) params.get("pageSize"));
		
		List<Object> objList = query.list();
		List<CountryVO> list = new ArrayList<CountryVO>();
		
		if (CollectionUtils.isNotEmpty(objList)) {
			for (Iterator<Object> it = objList.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				CountryVO vo = new CountryVO();
				
				vo.setRegionname((String) row[0]);
				vo.setId(((BigInteger) row[1]).longValue());
				vo.setRegionId(((BigInteger) row[2]).longValue());
				vo.setCode((String) row[3]);
				vo.setCountry((String) row[4]);
				vo.setImage((String) row[5]);
				vo.setCreatedDate((Date) row[6]);
				vo.setCreatedBy((String) row[7]);
				vo.setUpdatedDate((Date) row[8]);
				vo.setUpdatedBy((String) row[9]);
				vo.setIsOnline(((Boolean) row[10]));
				vo.setThreeLetterCode((String) row[11]);
				vo.setIsActualCountry(((Boolean) row[12]));
				list.add(vo);
			}
		}
		
		return list;
	}
	
