		StringBuilder sb = new StringBuilder();
		sb.append("SELECT r.name as regionname, c.ID, c.ID_REGION, c.CODE, c.NAME, c.IMAGE, ")
			.append("	c.DT_CREATED, c.CREATED_BY, c.DT_UPD, c.UPD_BY, c.ISONLINE, c.three_letter_code, c.is_actual_country ")
			.append("FROM country c ")
