	@SuppressWarnings("unchecked")
	@Override
	public List<RegionVO> getRegionList() throws BusinessException {
		Criteria criteria=createCriteria(RegionVO.class);
		criteria.addOrder(Order.asc("regionname"));
		return criteria.list();
	}
		
	@SuppressWarnings("unchecked")
	@Override
	public List<CountryVO> getCountryList() throws BusinessException {
		Criteria criteria = createCriteria(CountryVO.class);
		criteria.addOrder(Order.asc("country"));
		return criteria.list();
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<CountryVO> getActualCountryList() throws BusinessException {
		Criteria criteria = createCriteria(CountryVO.class);
		criteria.add(Restrictions.eq("isActualCountry", true)); 
		criteria.addOrder(Order.asc("country"));
		return criteria.list();
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public List<CityVO> getCityList() throws BusinessException {
		Criteria criteria = createCriteria(CityVO.class);
		criteria.addOrder(Order.asc("name"));
		return criteria.list();
	}
	
	@Override
	public CountryVO getCountryById(Long countryId) throws BusinessException {
		Criteria criteria = createCriteria(CountryVO.class);
		criteria.add(Restrictions.eq("id",countryId)); 
		return (CountryVO) criteria.uniqueResult(); 
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public int getRegionListSize(Map<String, Object> params,RegionVO regionVO)
			throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT count(r.id) ")
			.append("FROM region r ");

		Map<String, String> filters = (Map<String, String>) params.get("filters");
		if(regionVO != null) {
			sb.append("WHERE r.id=" + regionVO.getId());
			addFilterRegionList(filters, sb, false);
		} else {
			addFilterRegionList(filters, sb, false);
		}
	
		Query query = createSQLQuery(sb.toString());
		return ((BigInteger) query.uniqueResult()).intValue();
	}

	private List<String> addFilterRegionList(Map<String, String> filters, StringBuilder sb, boolean isAdditionalWhereClause) {
		List<String> filterValue = new ArrayList<String>();
		if (filters.isEmpty()) 
			return filterValue;
		
		if(!isAdditionalWhereClause)
			sb.append("WHERE ");
		else
			sb.append(" AND ");
		
		for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) 
		{
			Entry<String, String> entry = it.next();
			filterValue.clear();
			//Filter value is in KEY, VALUE, COLUMN. ONLY 1 PAIR will exists
			filterValue.add(entry.getKey());
			filterValue.add(entry.getValue());
			
			if ("regioncode".equals(entry.getKey())) {
				filterValue.add("r.code");
			} else if ("regionname".equals(entry.getKey())) {
				filterValue.add("r.name");
			}
			sb.append(filterValue.get(2)).append(" LIKE '%").append(entry.getValue()).append("%'");
			
			if (filters.size() > 1 && it.hasNext()) sb.append(" AND ");
		}

		return filterValue;
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public int getCountryListSize(Map<String, Object> params, RegionVO regionVO)
			throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT count(c.id) ")
			.append("FROM country c ")
			.append("left join region r on c.id_region=r.id ");

		Map<String, String> filters = (Map<String, String>) params.get("filters");
		if(regionVO != null)
		{ 
			sb.append("WHERE c.id_region="+regionVO.getId());
			addFilterCountryList(filters, sb, true);
		}
		else {	
			addFilterCountryList(filters, sb, false);
		}
		
//		System.out.println(sb.toString());
		
		Query query = createSQLQuery(sb.toString());
		return ((BigInteger) query.uniqueResult()).intValue();
	}
	
	private List<String> addFilterCountryList(Map<String, String> filters, StringBuilder sb, boolean isAdditionalWhereClause) {
		List<String> filterValue = new ArrayList<String>();
		
		if (filters.isEmpty()) 
			return filterValue;
		
		if(!isAdditionalWhereClause)
			sb.append("WHERE ");
		else
			sb.append(" AND ");
		
		for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) 
		{
			Entry<String, String> entry = it.next();
			filterValue.clear();
			filterValue.add(entry.getKey());
			filterValue.add(entry.getValue());
			
//			System.out.println(entry.getKey() + " " + entry.getValue());
			
			if ("code".equals(entry.getKey())) {
				sb.append("c.code like '%").append(entry.getValue()).append("%'");
			} else if ("country".equals(entry.getKey())) {
				filterValue.add("c.name");
				sb.append("c.name like '%").append(entry.getValue()).append("%'");
			} else if ("regionname".equals(entry.getKey())) {
				filterValue.add("r.name");
				sb.append("r.name like '%").append(entry.getValue()).append("%'");
			} else if ("threeLetterCode".equals(entry.getKey())) {
				filterValue.add("c.three_letter_code");
				sb.append("c.three_letter_code like '%").append(entry.getValue()).append("%'");
			} else if ("isActualCountry".equals(entry.getKey())) {
				if (entry.getValue().equals("All")) {
					filterValue.add("c.is_actual_country");
					sb.append("1=1");
				} else {
					filterValue.add("c.is_actual_country");
//					if (entry.getValue().equalsIgnoreCase("true"))
					sb.append("c.is_actual_country like '%").append(entry.getValue()).append("%'");
				}
				
			}
//			sb.append(filterValue.get(2)).append(" LIKE '%").append(entry.getValue()).append("%'");
			
			if (filters.size() > 1 && it.hasNext()) sb.append(" AND ");
		}
		return filterValue;
	}
	
	@SuppressWarnings("unchecked")
	@Override
	public int getCityListSize(Map<String, Object> params, RegionVO regionVO)
			throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT count(c.id) ")
			.append("FROM city c ")
			.append("left join country cy on c.id_country = cy.id ")
			.append("left join region r on cy.id_region = r.id ");

		Map<String, String> filters = (Map<String, String>) params.get("filters");
		if(regionVO != null)
		{ 
			sb.append("WHERE cy.id_region=" + regionVO.getId());
			addFilterCityList(filters, sb, true);
		}
		else {	
			addFilterCityList(filters, sb, false);
		}
		Query query = createSQLQuery(sb.toString());
		return ((BigInteger) query.uniqueResult()).intValue();
	}
	
	private List<String> addFilterCityList(Map<String, String> filters, StringBuilder sb, boolean isAdditionalWhereClause) {
		List<String> filterValue = new ArrayList<String>();
		
		if (filters.isEmpty()) 
			return filterValue;
		
		if(!isAdditionalWhereClause)
			sb.append("WHERE ");
		else
			sb.append(" AND ");
		
		for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) 
		{
			Entry<String, String> entry = it.next();
			filterValue.clear();
			filterValue.add(entry.getKey());
			filterValue.add(entry.getValue());
			
			if ("code".equals(entry.getKey())) {
				filterValue.add("c.code");
			} else if ("name".equals(entry.getKey())) {
				filterValue.add("c.name");
			} else if ("countryName".equals(entry.getKey())) {
				filterValue.add("cy.name");
			}
			sb.append(filterValue.get(2)).append(" LIKE '%").append(entry.getValue()).append("%'");
			
			if (filters.size() > 1 && it.hasNext()) sb.append(" AND ");
		}
		return filterValue;
	}
	
	private String getOrderByMatches(String columnName, String columnValue) {
		return "CASE WHEN " + columnName + " LIKE '" + columnValue + "%' THEN " + columnName 
				+ " ELSE concat('{0} ', " + columnName + ") END";
	}
	
	@Override
	public CountryVO getCountryByThreeLetterCode(String threeLetterCode) {
		Criteria criteria = createCriteria(CountryVO.class);
		criteria.add(Restrictions.eq("threeLetterCode", threeLetterCode));
		return (CountryVO) criteria.uniqueResult();
	}
	
	@Override
	public void updateActualCountry(Long idCountry, boolean isActualCountry) throws BusinessException {
		String updatedBy = BaseContext.getUserFullName();
		if (StringUtils.isBlank(updatedBy)) updatedBy = BaseContext.getLoginId();
		
		Query query = createSQLQuery("update country set is_actual_country = :isActualCountry, upd_by = :updatedBy, dt_upd = now() where id = :idCountry");
		query.setParameter("isActualCountry", isActualCountry);
		query.setParameter("updatedBy", updatedBy);
		query.setParameter("idCountry", idCountry);
		query.executeUpdate();
	}
}