<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
				xmlns:c="http://java.sun.com/jsp/jstl/core"
	    		xmlns:ui="http://java.sun.com/jsf/facelets"
	  			xmlns:h="http://java.sun.com/jsf/html"
	  			xmlns:f="http://java.sun.com/jsf/core"
	  			xmlns:p="http://primefaces.org/ui"
	  			xmlns:zsg="http://www.bcs.com/zsg/jsf"
				template="/WEB-INF/views/layouts/main.xhtml">

<ui:define name="content">
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        var filters = document.querySelectorAll('input.ui-column-filter');
        filters.forEach(function(filter) {
            filter.setAttribute('enterkeyhint', 'enter');
        });
    });
</script>
<p:panel header="Airlines" toggleable="true" toggleSpeed="500">
	<h:form id="idAirlineForm">
		<h:panelGrid columns="2" style="width:1px;">
			<p:commandButton value="Add" oncomplete="varAddAirlineDialog.show()" update=":idAddAirlineDialog" immediate="true"/>
		</h:panelGrid>
		
		<p:dataTable id="idAirlineList" value="#{airlineBean.airlineList}" var="vo" paginator="true" rows="20" 
			paginatorTemplate="{CurrentPageReport} {FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}  Page: {JumpToPageDropdown} {RowsPerPageDropdown}" 
			rowsPerPageTemplate="20, 30, 50" filterEvent="enter">
			<p:column headerText="Edit" style="width:50px; text-align:center;">
				<p:commandButton icon="ui-icon-pencil" actionListener="#{airlineBean.setAirlineVO(vo)}" update=":idEditAirlineDialog" oncomplete="varEditAirlineDialog.show()"/>
			</p:column>
			<p:column headerText="Delete" style="width:50px; text-align:center;">
				<p:commandButton icon="ui-icon-close" actionListener="#{airlineBean.setAirlineVO(vo)}" oncomplete="varDelAirlineDialog.show()"/>
			</p:column>
			<p:column headerText="Airline Code" sortBy="#{vo.code}" filterBy="#{vo.code}" style="width:100px;" filterMatchMode="contains">
				<h:outputText value="#{vo.code}"/>
			</p:column>
			<p:column headerText="Airline Description" sortBy="#{vo.desc}" filterBy="#{vo.desc}" filterMatchMode="contains">
				<h:outputText value="#{vo.desc}"/>
			</p:column>
			<p:column headerText="Schedules" style="width:50px; text-align:center;">
				<p:commandButton icon="ui-icon-plus" actionListener="#{airlineBean.handleAirlineSchedule(vo)}" oncomplete="varAirlineSchedulesDialog.show()" update=":idAirlineSchedulesDialog"/>
			</p:column>
		</p:dataTable>
		
		<h:panelGrid columns="2" style="width:1px;">
			<p:commandButton value="Add" oncomplete="varAddAirlineDialog.show()" update=":idAddAirlineDialog" immediate="true"/>
		</h:panelGrid>
	</h:form>
</p:panel>

<!--
	DIALOG - ADD AIRLINE
-->
<p:dialog id="idAddAirlineDialog" widgetVar="varAddAirlineDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Add Airline" />
	</f:facet>
	
	<h:form id="idAddAirlineForm">
		<ui:include src="add_airline.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - EDIT AIRLINE
-->
<p:dialog id="idEditAirlineDialog" widgetVar="varEditAirlineDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Edit Airline" />
	</f:facet>
	
	<h:form id="idEditAirlineForm">
		<ui:include src="add_airline.xhtml" />
	</h:form>
</p:dialog>
	
<!--
	DIALOG - DELETE AIRLINE
-->
<p:confirmDialog header="Delete Airline" widgetVar="varDelAirlineDialog" message="Are you sure want to delete this record?" closable="false">
	<h:form>
		<p:growl id="msg"/>
		<p:commandButton value="#{msg['common.button.label.yes']}" actionListener="#{airlineBean.delAirline}" update="@form,:idAirlineForm" oncomplete="varDelAirlineDialog.hide()"/>
		<p:commandButton value="#{msg['common.button.label.no']}" actionListener="#{airlineBean.resetForm}" oncomplete="varDelAirlineDialog.hide()"/>
	</h:form>
</p:confirmDialog>

<!--
	DIALOG - SCHEDULE LIST
-->
<p:dialog id="idAirlineSchedulesDialog" widgetVar="varAirlineSchedulesDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Schedule(s)" />
	</f:facet>
	
	<h:form id="idAirlineSchedulesForm">
		<ui:include src="airline_schedule_list.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - SCHEDULE LIST
-->
<p:dialog id="idEditAirlineScheduleDialog" widgetVar="varEditAirlineScheduleDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Schedule(s)" />
	</f:facet>
	
	<h:form id="idEditAirlineSchedulesForm">
		<ui:include src="edit_airline_schedule_list.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - ADD AIRLINE SCHEDULE
-->
<p:dialog id="idAddAirlineScheduleDialog" widgetVar="varAddAirlineScheduleDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Add Airline Schedule" />
	</f:facet>
	
	<h:form id="idAddAirlineScheduleForm">
		<ui:include src="add_airline_schedule.xhtml" />
	</h:form>
</p:dialog>
	
<!--
	DIALOG - DELETE AIRLINE SCHEDULE
-->
<p:confirmDialog header="Delete Schedule" widgetVar="varDelAirlineScheduleDialog" message="Are you sure want to delete this schedule?" closable="false">
	<h:form>
		<p:growl id="msg"/>
		<p:commandButton value="#{msg['common.button.label.yes']}" actionListener="#{airlineBean.delAirlineSchedule}" update="@form,:idAirlineSchedulesForm" oncomplete="varDelAirlineScheduleDialog.hide()"/>
		<p:commandButton value="#{msg['common.button.label.no']}" actionListener="#{airlineBean.resetScheduleForm}" oncomplete="varDelAirlineScheduleDialog.hide()"/>
	</h:form>
</p:confirmDialog>

<!--
	DIALOG - ADD AIRLINE SCHEDULE ITEM
-->
<p:dialog id="idAddAirlineScheduleItemDialog" widgetVar="varAddAirlineScheduleItemDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Add Airline Schedule Item" />
	</f:facet>
	
	<h:form id="idAddAirlineScheduleItemForm">
		<ui:include src="add_airline_schedule_item.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - EDIT AIRLINE SCHEDULE ITEM
-->
<p:dialog id="idEditAirlineScheduleItemDialog" widgetVar="varEditAirlineScheduleItemDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Edit Airline Schedule Item" />
	</f:facet>
	
	<h:form id="idEditAirlineScheduleItemForm">
		<ui:include src="add_airline_schedule_item.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - ADD AIRLINE SCHEDULE ITEM CHARGE
-->
<p:dialog id="idAddScheduleChargeDialog" widgetVar="varAddScheduleChargeDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Airline Schedule Item Charge" />
	</f:facet>
	
	<h:form id="idAddScheduleItemChargeForm">
		<ui:include src="add_airline_schedule_charge.xhtml" />
	</h:form>
</p:dialog>

<!--
	DIALOG - EDIT AIRLINE SCHEDULE ITEM CHARGE
-->
<!-- <p:dialog id="idEditScheduleChargeDialog" widgetVar="varEditScheduleChargeDialog" modal="true" resizable="false" dynamic="true" draggable="true" 
	hideEffect="fade" showEffect="fade" closable="false">
	<f:facet name="header">
		<h:outputFormat value="Edit Airline Schedule Item Charge" />
	</f:facet>
	
	<h:form id="idEditScheduleItemChargeForm">
		<ui:include src="add_airline_schedule_charge.xhtml" />
	</h:form>
</p:dialog> -->

<!--
	DIALOG - DELETE AIRLINE SCHEDULE ITEM
-->
<p:confirmDialog header="Delete Schedule Item" widgetVar="varDelAirlineScheduleItemDialog" message="Are you sure want to delete this schedule item?" closable="false">
	<h:form>
		<p:growl id="msg"/>
		<p:commandButton value="#{msg['common.button.label.yes']}" actionListener="#{airlineBean.delAirlineScheduleItem}" update="@form,:idAirlineSchedulesForm" oncomplete="varDelAirlineScheduleItemDialog.hide()"/>
		<p:commandButton value="#{msg['common.button.label.no']}" actionListener="#{airlineBean.resetScheduleForm}" oncomplete="varDelAirlineScheduleItemDialog.hide()"/>
	</h:form>
</p:confirmDialog>

</ui:define>
</ui:composition>