<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="tour_pkg_itinery" name="TourPackageItineryVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idTourPkg" type="long" column="id_tour_pkg"/>
        <property name="idTourPkgDailyItinerary" type="long" column="id_tour_pkg_daily_itinerary"/>
        <property name="name" type="string" column="name"/>
        <property name="path" type="string" column="path"/>
        <property name="langCd" type="string" column="lang_cd"/>
        <property name="typeCd" type="string" column="type_cd"/>
        
        <!-- BaseVO attributes -->
        <property name="version" type="long" column="version"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_update"/>
		<property name="updatedBy" type="string" column="updated_by"/>
    </class>
</hibernate-mapping>