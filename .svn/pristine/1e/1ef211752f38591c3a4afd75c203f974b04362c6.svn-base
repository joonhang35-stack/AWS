<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.sales.vo">

    <class table="INVOICE_VOUCHER" name="InvoiceVoucherVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="idInv" type="long" column="ID_INV"/>
        <property name="idCust" type="long" column="ID_CUST"/>
        
        <property name="voucherId" type="string" column="VOUCHER_ID"/>
        <property name="voucherCode" type="string" column="VOUCHER_CODE"/>
        <property name="voucherDesc" type="string" column="VOUCHER_DESCRIPTION"/>
        <property name="refVoucherId" type="string" column="REF_VOUCHER_ID"/>
        <property name="category" type="string" column="CATEGORY"/>
        
        <property name="dtRedeem" type="timestamp" column="DT_REDEEM"/>
        <property name="pointsUsed" type="integer" column="POINTS_USED"/>
        
        <property name="desc" type="string" column="DESCRIPTION"/>
        <property name="qty" type="integer" column="QUANTITY"/>
        <property name="unitPrice" type="double" column="UNIT_PRICE"/>
        <property name="amount" type="double" column="AMOUNT"/>
        <property name="seq" type="integer" column="seq"/>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="STATUS_CD"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>