<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.sales.vo">

    <class table="INVOICE_ITEM" name="InvoiceItemVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="invId" type="long" column="ID_INV"/>
        <property name="acctId" type="long" column="ID_ACCT"/>
        <property name="idPreSalesAcct" type="long" column="ID_ACCT_PS"/>
        <property name="invEOItemId" type="long" column="ID_INV_EO_ITEM"/>
        <property name="idInvVoucher" type="long" column="ID_INV_VOUCHER"/>
        <property name="code" type="string" column="code"/>
        <property name="desc" type="string" column="DESCRIPTION"/>
        <property name="subDesc" type="string" column="SUB_DESCRIPTION"/>
        <property name="airlineId" type="long" column="ID_AIRLINE"/>
        <property name="qty" type="integer" column="QUANTITY"/>
        <property name="unitPrice" type="double" column="UNIT_PRICE"/>
        <property name="netPrice" type="double" column="NET_PRICE"/>
        <property name="amount" type="double" column="AMOUNT"/>
        <property name="airfare" type="double" column="airfare"/>
        <property name="refundAmt" type="double" column="refund_amt"/>
        <property name="taxCode" type="string" column="tax_code"/>
        <property name="taxRate" type="float" column="tax_rate"/>
        <property name="taxAmount" type="double" column="tax_amount"/>
        <property name="invVoucherRef" type="string" column="inv_voucher_ref"/>
        <property name="seq" type="integer" column="seq"/>
        <property name="isLock" type="boolean" column="is_lock"/>
        <property name="exRate" type="double" column="ex_rate"/>
        <property name="currencyId" type="long" column="id_currency"/>
        <property name="currencyPrice" type="double" column="currency_price"/>
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="STATUS_CD"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>