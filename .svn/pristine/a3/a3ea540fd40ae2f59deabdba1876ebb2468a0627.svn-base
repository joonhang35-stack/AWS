	public void saveCustomerFeedbackEdits() {
		try {
			if (editingFeedbackRow == null) {
				return;
			}

			// 1. Upload files
			if (editCustNewUploadedFilesMap != null && !editCustNewUploadedFilesMap.isEmpty()) {
				for (Map.Entry<String, byte[]> entry : editCustNewUploadedFilesMap.entrySet()) {
					String uuidFileName = entry.getKey();
					byte[] fileBytes = entry.getValue();
					String responseStr = uploadFileToApi(uuidFileName, fileBytes, "true");
					Gson gson = new Gson();
					JsonObject json = gson.fromJson(responseStr, JsonObject.class);
					if (json == null || !json.has("status") || !"SUCCESS".equals(json.get("status").getAsString())) {
						throw new IOException("Failed to upload " + uuidFileName);
					}
				}
			}

			// 2. Prepare FeedbackVO
			FeedbackVO vo = new FeedbackVO();
			vo.setIdFeedback(editingFeedbackRow.getIdFeedback());
			vo.setIdTourPkg(editingFeedbackRow.getIdTourPkg());
			vo.setIdTourDeparture(selectedTourDep.getId());
			vo.setInvId(editingFeedbackRow.getInvId());
			vo.setCustomerId(editingFeedbackRow.getCustomerId());
			vo.setTourBookingId(editingFeedbackRow.getTourBookingId());
			vo.setCustomerEmail(editingFeedbackRow.getCustomerEmail());
			vo.setTokenUuid(UUID.randomUUID().toString());
			vo.setFeedbackStatus("C"); // Completed
			vo.setComments(this.editCustComments);

			feedbackBO.saveCustomerFeedback(vo, editCustQAAnswers, editCustAttachments, editCustDeletedAttachmentIds);

			// 3. Reset maps and reload report data
			if (editCustNewUploadedFilesMap != null) editCustNewUploadedFilesMap.clear();
			if (editCustDeletedAttachmentIds != null) editCustDeletedAttachmentIds.clear();
			loadReportData();

			FacesContext.getCurrentInstance().addMessage(null,
				new FacesMessage(FacesMessage.SEVERITY_INFO, "Customer Feedback submitted successfully.", ""));
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	

