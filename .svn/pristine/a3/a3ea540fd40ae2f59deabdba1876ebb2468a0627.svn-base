	public void handleTourDepSelect(SelectEvent event) {
		try {
			selectedTourDep = (TourDepartureVO) event.getObject();
			selectedSearchFeedbackRow = null;
			loadReportData();
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public void loadReportData() {
		try {
			if (selectedTourDep == null) {
				return;
			}
			
			// Load Header Information
			TourDepartureVO headerVO = feedbackBO.getFeedbackReportHeader(selectedTourDep.getId());
			if (headerVO != null) {
				this.tourCode = headerVO.getCode();
				this.tourLeader = headerVO.getTourLead();
				this.tourManager = headerVO.getTourManager();
				this.packageName = headerVO.getPackageName();
			} else {
				this.tourCode = selectedTourDep.getCode();
				this.tourLeader = "-";
				this.tourManager = "-";
				this.packageName = selectedTourDep.getPackageName();
			}

			// 1. Build Column Headers dynamically from active questions (sorted by question id)
			List<Object[]> activeQA = feedbackBO.getActiveQuestionsAndAnswers();
			Map<String, String> lookupMap = feedbackBO.getFeedbackLookupMap();

			columnList = new ArrayList<ReportColumn>();
			headerGroupList = new ArrayList<HeaderGroup>();
			Map<String, HeaderGroup> groupMap = new LinkedHashMap<String, HeaderGroup>();
			
			// Map to track unique question columns for RATING/TEXT types
			Map<Long, ReportColumn> ratingTextColsMap = new LinkedHashMap<Long, ReportColumn>();

			for (Object[] row : activeQA) {
				Long qId = row[0] != null ? ((Number) row[0]).longValue() : null;
				Integer seqNo = row[1] != null ? ((Number) row[1]).intValue() : 0;
				String sectionType = row[2] != null ? row[2].toString() : "";
				String qCode = row[3] != null ? row[3].toString() : "";
				String qText = row[4] != null ? row[4].toString() : "";
				String ansType = row[5] != null ? row[5].toString() : "";

				Long ansId = row[6] != null ? ((Number) row[6]).longValue() : null;
				String ansLabel = row[7] != null ? row[7].toString() : "";

				// Determine groupKey and groupHeaderText and rowspan
				String groupKey;
				String groupHeaderText;
				int rowspan;

				if ("RADIO".equalsIgnoreCase(ansType) || "CHECKBOX".equalsIgnoreCase(ansType)) {
					groupKey = "Q_" + qId;
					boolean isFirstOfSection = true;
					for (HeaderGroup existingGroup : headerGroupList) {
						if (sectionType.equals(existingGroup.getSectionType())) {
							isFirstOfSection = false;
							break;
						}
					}
					if (isFirstOfSection && lookupMap.containsKey(sectionType)) {
						groupHeaderText = lookupMap.get(sectionType);
					} else {
						groupHeaderText = StringUtils.isNotBlank(qText) ? qText : sectionType;
					}
					rowspan = 1;
				} else {
					groupKey = "SEC_" + sectionType;
					if (lookupMap.containsKey(sectionType)) {
						groupHeaderText = lookupMap.get(sectionType);
					} else {
						groupHeaderText = sectionType;
					}
					if (StringUtils.isBlank(qText)) {
						rowspan = 2;
					} else {
						rowspan = 1;
					}
				}

				HeaderGroup group = groupMap.get(groupKey);
				if (group == null) {
					group = new HeaderGroup(groupHeaderText);
					group.setRowspan(rowspan);
					group.setSectionType(sectionType);
					groupMap.put(groupKey, group);
					headerGroupList.add(group);
				}

				if ("RATING".equalsIgnoreCase(ansType) || "TEXT".equalsIgnoreCase(ansType) || "TEXTAREA".equalsIgnoreCase(ansType)) {
					if (!ratingTextColsMap.containsKey(qId)) {
						String colHeader = (rowspan == 2) ? groupHeaderText : qText;
						ReportColumn col = new ReportColumn(qId, colHeader, ansType, null, groupHeaderText);
						ratingTextColsMap.put(qId, col);
						columnList.add(col);
						group.getColumns().add(col);
					}
				} else if ("RADIO".equalsIgnoreCase(ansType) || "CHECKBOX".equalsIgnoreCase(ansType)) {
					if (ansId != null) {
						String labelText = ansLabel;
						if (labelText.startsWith("?")) {
							labelText = labelText.substring(1);
						}
						// Dynamic sub-column for each answer option
						ReportColumn col = new ReportColumn(qId, labelText, ansType, ansId, groupHeaderText);
						columnList.add(col);
						group.getColumns().add(col);
					}
				}
			}

			// Rebuild columnList from headerGroupList to ensure the data columns (columnList)
			// align exactly with the grouped headers (headerGroupList)
			columnList.clear();
			for (HeaderGroup g : headerGroupList) {
				for (ReportColumn col : g.getColumns()) {
					columnList.add(col);
				}
			}

			// 2. Pivot Feedback Data into Rows - show ALL feedback for the tour departure
			List<FeedbackVO> details = feedbackBO.getFeedbackListbyTourDepId(selectedTourDep.getId());
			Map<Long, FeedbackRow> rowsMap = new LinkedHashMap<Long, FeedbackRow>();
			List<FeedbackRow> feedbackRowList = new ArrayList<FeedbackRow>();

			for (FeedbackVO vo : details) {
				Long feedbackId = vo.getIdFeedback();
				if (feedbackId == null) continue;

				FeedbackRow row = rowsMap.get(feedbackId);
				if (row == null) {
					row = new FeedbackRow();
					row.setIdFeedback(feedbackId);
					row.setTourBookingId(vo.getTourBookingId());
					row.setCustomerId(vo.getCustomerId());
					row.setInvId(vo.getInvId());
					row.setInvCode(vo.getInvCode());
					row.setPsNo(vo.getPsNo());
					row.setIdTourPkg(vo.getIdTourPkg());
					row.setCustomerEmail(vo.getCustomerEmail());
					row.setCustomerName(vo.getCustomerName());
					row.setComments(vo.getComments());
					row.setCommentsHos(vo.getCommentsHos());
					row.setAttachment(vo.getAttachment());
					row.setAttachmentHos(vo.getAttachmentHos());
					rowsMap.put(feedbackId, row);
					feedbackRowList.add(row);
				}

				// Map Cell Value using answer_label_en
				Long qId = vo.getIdFeedbackQuestion();
				if (qId == null) continue;

				String ansType = vo.getAnswerType();
				if ("RATING".equalsIgnoreCase(ansType)) {
					// Display answer_label_en (e.g. "Excellent", "Good", "Average", "Poor")
					String answerLabel = vo.getAnswerLabelEn();
					if (StringUtils.isNotBlank(answerLabel)) {
						if (answerLabel.startsWith("?")) {
							answerLabel = answerLabel.substring(1);
						}
						Integer score = vo.getScoreValue();
						String cellValue = (score != null) ? answerLabel + " (" + score + ")" : answerLabel;
						row.getCellValues().put(String.valueOf(qId), cellValue);
						row.getCellScoreValues().put(String.valueOf(qId), vo.getScoreValue());
					}
				} else if ("TEXT".equalsIgnoreCase(ansType) || "TEXTAREA".equalsIgnoreCase(ansType)) {
					String cellValue = StringUtils.isNotBlank(vo.getAnswerText()) ? vo.getAnswerText() : "";
					if (StringUtils.isNotBlank(vo.getRemarks())) {
						cellValue += (StringUtils.isNotBlank(cellValue) ? " | " : "") + vo.getRemarks();
					}
					row.getCellValues().put(String.valueOf(qId), cellValue);
				} else if ("RADIO".equalsIgnoreCase(ansType) || "CHECKBOX".equalsIgnoreCase(ansType)) {
					Long selectedAnsId = vo.getIdFeedbackAnswer();
					if (selectedAnsId != null) {
						String key = qId + "_" + selectedAnsId;
						row.getCellValues().put(key, "Y");
					}
				}
			}

			// 2b. Back-fill missing column keys with "-" so every row has an entry for every column.
			// Without this, unanswered questions leave gaps in cellValues, causing column misalignment.
			for (FeedbackRow r : feedbackRowList) {
				for (ReportColumn col : columnList) {
					String colKey = col.getKey();
					if (!r.getCellValues().containsKey(colKey)) {
						r.getCellValues().put(colKey, "-");
					}
				}
			}

			// 3. Compute Totals & Averages
			int totalFeedbacksCount = feedbackRowList.size();
			
			// Total Row
			FeedbackRow totalRow = new FeedbackRow();
			totalRow.setSummaryRow(true);
			totalRow.setSummaryType("TOTAL");
			totalRow.setCustomerName("Total");

			// Average Row
			FeedbackRow averageRow = new FeedbackRow();
			averageRow.setSummaryRow(true);
			averageRow.setSummaryType("AVERAGE");
			averageRow.setCustomerName("Average");

			for (ReportColumn col : columnList) {
				String colKey = col.getKey();
				if ("RATING".equalsIgnoreCase(col.getAnswerType())) {
					int sum = 0;
					int respondentsCount = 0;
					for (FeedbackRow r : feedbackRowList) {
						String val = r.getCellValues().get(colKey);
						if (StringUtils.isNotBlank(val)) {
							Integer score = r.getCellScoreValues().get(colKey);
							if (score != null) {
								sum += score;
								respondentsCount++;
							}
						}
					}
					if (respondentsCount > 0) {
						totalRow.getCellValues().put(colKey, String.valueOf(sum));
						double average = (double) sum / respondentsCount;
						averageRow.getCellValues().put(colKey, String.format("%.2f", average));
					} else {
						totalRow.getCellValues().put(colKey, "-");
						averageRow.getCellValues().put(colKey, "-");
					}
				} else {
					totalRow.getCellValues().put(colKey, "");
					averageRow.getCellValues().put(colKey, "");
				}
			}

			// Add summary rows to list
			if (totalFeedbacksCount > 0) {
				feedbackRowList.add(totalRow);
				feedbackRowList.add(averageRow);
			}

			this.feedbackRows = feedbackRowList;

			this.searchFeedbackRows = new ArrayList<FeedbackRow>();
			for (FeedbackRow r : feedbackRowList) {
				if (!r.isSummaryRow()) {
					this.searchFeedbackRows.add(r);
				}
			}

		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public void loadFeedbackDetails(FeedbackRow row) {
		try {
			this.selectedFeedbackRow = row;
			this.editingCommentsHos = row.getCommentsHos();
			this.deletedAttachmentIds = new ArrayList<Long>();
			this.newUploadedFilesMap = new HashMap<String, byte[]>();

			// Load attachments from database
			List<FeedbackVO> allAttachments = feedbackBO.getAttachmentsByFeedbackId(row.getIdFeedback());
			this.editingHosAttachments = new ArrayList<FeedbackVO>();

			if (CollectionUtils.isNotEmpty(allAttachments)) {
				for (FeedbackVO att : allAttachments) {
					if ("hos".equals(att.getType())) {
						this.editingHosAttachments.add(att);
					}
				}
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public void handleHosAttachmentUpload(FileUploadEvent event) {
		try {
			String originalName = event.getFile().getFileName();
			String fileNameLower = originalName.toLowerCase();
			
			if (fileNameLower.endsWith(".jpg") ||
				fileNameLower.endsWith(".jpeg") ||
				fileNameLower.endsWith(".png") ||
				fileNameLower.endsWith(".gif") ||
				fileNameLower.endsWith(".webp") ||
				fileNameLower.endsWith(".pdf")) {
				System.out.println("Valid attachment file: " + originalName);
			} else {
				FacesContext.getCurrentInstance().addMessage(null,
					new FacesMessage(FacesMessage.SEVERITY_ERROR, "Invalid file type. Only JPG, JPEG, PNG, GIF, WEBP, and PDF files are allowed.", ""));
				return;
			}
			
			String ext = "";
			int idx = originalName.lastIndexOf(".");
			if (idx >= 0) {
				ext = originalName.substring(idx);
			}
			String uuidFileName = UUID.randomUUID().toString() + ext;
			
			byte[] fileContents;
			try (InputStream in = event.getFile().getInputstream();
				 ByteArrayOutputStream bos = new ByteArrayOutputStream()) {
				byte[] buf = new byte[1024];
				int read;
				while ((read = in.read(buf)) != -1) {
					bos.write(buf, 0, read);
				}
				fileContents = bos.toByteArray();
			}
			
			if (this.newUploadedFilesMap == null) {
				this.newUploadedFilesMap = new HashMap<String, byte[]>();
			}
			this.newUploadedFilesMap.put(uuidFileName, fileContents);
			
			FeedbackVO att = new FeedbackVO();
			att.setIdFeedback(selectedFeedbackRow.getIdFeedback());
			att.setAttachmentUrl("api/files/feedback/");
			att.setFilename(uuidFileName);
			att.setType("hos");
			
			if (this.editingHosAttachments == null) {
				this.editingHosAttachments = new ArrayList<FeedbackVO>();
			}
			this.editingHosAttachments.add(att);
			
			FacesContext.getCurrentInstance().addMessage(null,
				new FacesMessage(FacesMessage.SEVERITY_INFO, "File " + originalName + " selected.", ""));
		} catch (Throwable t) {
			t.printStackTrace();
			FacesContext.getCurrentInstance().addMessage(null,
				new FacesMessage(FacesMessage.SEVERITY_ERROR, "Failed to select file: " + t.getMessage(), ""));
		}
	}

	public void removeHosAttachment(FeedbackVO att) {
		try {
			if (att.getIdAttachment() != null) {
				this.deletedAttachmentIds.add(att.getIdAttachment());
			} else {
				if (this.newUploadedFilesMap != null) {
					this.newUploadedFilesMap.remove(att.getFilename());
				}
			}
			this.editingHosAttachments.remove(att);
			
			FacesContext.getCurrentInstance().addMessage(null,
				new FacesMessage(FacesMessage.SEVERITY_INFO, "Attachment removed.", ""));
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public String getAttachmentSecureUrl(FeedbackVO att) {
		if (att == null || att.getFilename() == null) return "#";
		try {
			if (this.newUploadedFilesMap != null && this.newUploadedFilesMap.containsKey(att.getFilename())) {
				byte[] bytes = this.newUploadedFilesMap.get(att.getFilename());
				String base64 =DatatypeConverter.printBase64Binary(bytes);
				String mimeType = "image/png";
				String fn = att.getFilename().toLowerCase();
				if (fn.endsWith(".pdf")) mimeType = "application/pdf";
				else if (fn.endsWith(".jpg") || fn.endsWith(".jpeg")) mimeType = "image/jpeg";
				else if (fn.endsWith(".gif")) mimeType = "image/gif";
				else if (fn.endsWith(".webp")) mimeType = "image/webp";
				return "data:" + mimeType + ";base64," + base64;
			}

			String privateKey = SystemProperty.SYSTEM_REQUEST_HEADER_AUTHORIZATION;
			String raw = "file=" + att.getFilename() + "&privateKey=" + privateKey;
			String encrypted = URLEncoder.encode(AESEncryption.encrypt(raw), "UTF-8");
			return SystemProperty.FEEDBACK_GET_ATTACHMENT + att.getFilename() + "?key=" + encrypted;
		} catch (Exception e) {
			e.printStackTrace();
			return "#";
		}
	}

	private String uploadFileToApi(String originalName, byte[] fileBytes, String useOriginalFilename) throws Exception {
		String boundary = "===" + System.currentTimeMillis() + "===";
		String LINE_FEED = "\r\n";
		
		URL url = new URL(SystemProperty.getSystemApiUrl() + "/api/files/upload");
		HttpURLConnection conn = (HttpURLConnection) url.openConnection();
		
		if (conn instanceof HttpsURLConnection) {
			((HttpsURLConnection) conn).setSSLSocketFactory(HttpUtils.getSslContext().getSocketFactory());
		}
		
		conn.setUseCaches(false);
		conn.setDoOutput(true);
		conn.setDoInput(true);
		conn.setRequestMethod("POST");
		conn.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary);
		conn.setRequestProperty("x-api-key", SystemProperty.SYSTEM_REQUEST_HEADER_AUTHORIZATION);
		
		try (OutputStream outputStream = conn.getOutputStream();
			 PrintWriter writer = new PrintWriter(new OutputStreamWriter(outputStream, "UTF-8"), true)) {
			
			writer.append("--" + boundary).append(LINE_FEED);
			writer.append("Content-Disposition: form-data; name=\"path\"").append(LINE_FEED);
			writer.append("Content-Type: text/plain; charset=UTF-8").append(LINE_FEED);
			writer.append(LINE_FEED);
			writer.append("feedback").append(LINE_FEED);
			writer.flush();
			
			writer.append("--" + boundary).append(LINE_FEED);
			writer.append("Content-Disposition: form-data; name=\"useOriginalFilename\"").append(LINE_FEED);
			writer.append("Content-Type: text/plain; charset=UTF-8").append(LINE_FEED);
			writer.append(LINE_FEED);
			writer.append(useOriginalFilename).append(LINE_FEED);
			writer.flush();
			
			writer.append("--" + boundary).append(LINE_FEED);
			writer.append("Content-Disposition: form-data; name=\"file\"; filename=\"" + originalName + "\"").append(LINE_FEED);
			writer.append("Content-Type: " + URLConnection.guessContentTypeFromName(originalName)).append(LINE_FEED);
			writer.append("Content-Transfer-Encoding: binary").append(LINE_FEED);
			writer.append(LINE_FEED);
			writer.flush();
			
			outputStream.write(fileBytes);
			outputStream.flush();
			
			writer.append(LINE_FEED);
			writer.flush();
			
			writer.append("--" + boundary + "--").append(LINE_FEED);
			writer.flush();
		}
		
		int responseCode = conn.getResponseCode();
		if (responseCode == HttpURLConnection.HTTP_OK) {
			try (BufferedReader reader = new BufferedReader(new InputStreamReader(conn.getInputStream(), "UTF-8"))) {
				StringBuilder response = new StringBuilder();
				String line;
				while ((line = reader.readLine()) != null) {
					response.append(line);
				}
				return response.toString();
			}
		} else {
			try (BufferedReader reader = new BufferedReader(new InputStreamReader(conn.getErrorStream() != null ? conn.getErrorStream() : conn.getInputStream(), "UTF-8"))) {
				StringBuilder errorResponse = new StringBuilder();
				String line;
				while ((line = reader.readLine()) != null) {
					errorResponse.append(line);
				}
				throw new IOException("Server returned HTTP response code: " + responseCode + ", details: " + errorResponse.toString());
			}
		}
	}

	public void saveFeedbackEdits() {
		try {
			if (selectedFeedbackRow == null) {
				return;
			}
			
			// 1. Upload files
			if (newUploadedFilesMap != null && !newUploadedFilesMap.isEmpty()) {
				for (Map.Entry<String, byte[]> entry : newUploadedFilesMap.entrySet()) {
					String uuidFileName = entry.getKey();
					byte[] fileBytes = entry.getValue();
					String responseStr = uploadFileToApi(uuidFileName, fileBytes, "true");
					Gson gson = new Gson();
					JsonObject json = gson.fromJson(responseStr, JsonObject.class);
					if (json == null || !json.has("status") || !"SUCCESS".equals(json.get("status").getAsString())) {
						throw new IOException("Failed to upload " + uuidFileName);
					}
				}
			}
			
			// 2. Save HOS actions comments and attachments
			feedbackBO.saveFeedbackEdits(selectedFeedbackRow.getIdFeedback(), editingCommentsHos, editingHosAttachments, deletedAttachmentIds);
			
			// 3. Clear memory and refresh UI
			if (newUploadedFilesMap != null) newUploadedFilesMap.clear();
			if (deletedAttachmentIds != null) deletedAttachmentIds.clear();
			loadReportData();
			
			FacesContext.getCurrentInstance().addMessage(null,
				new FacesMessage(FacesMessage.SEVERITY_INFO, "HOS Comments and Attachments updated successfully.", ""));
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public void handleTourDepLeaderOrGuideChange() { 
		try {
			if (selectedTourDep != null) {
				feedbackBO.updateTourDepLeaderAndGuide(selectedTourDep.getId(), selectedTourDep.getIdTourLeader(), selectedTourDep.getIdTourGuide());
				
				// Re-load header information to show updated leader/manager names
				TourDepartureVO headerVO = feedbackBO.getFeedbackReportHeader(selectedTourDep.getId());
