			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public void initManualFeedback() {
		try {
			if (selectedTourDep == null) {
				FacesContext.getCurrentInstance().addMessage(null,
					new FacesMessage(FacesMessage.SEVERITY_WARN, "Please select a Tour Departure first.", ""));
				return;
			}
			
			eligibleBookings = feedbackBO.getBookingsWithoutFeedback(selectedTourDep.getId());
			selectedEligibleBooking = null;
			selectedManualPaxKey = null;
			manualQAAnswers = new ArrayList<ManualQuestionAnswer>();
			manualGeneralComments = null;
			manualAttachments = new ArrayList<FeedbackVO>();
			manualDeletedAttachmentIds = new ArrayList<Long>();
			manualNewUploadedFilesMap = new HashMap<String, byte[]>();

			// Prepare empty questions for key-in
			List<Object[]> activeQA = feedbackBO.getActiveQuestionsAndAnswers();
			Map<Long, ManualQuestionAnswer> map = new LinkedHashMap<Long, ManualQuestionAnswer>();

			for (Object[] row : activeQA) {
				Long qId = row[0] != null ? ((Number) row[0]).longValue() : null;
				Integer seqNo = row[1] != null ? ((Number) row[1]).intValue() : 0;
				String sectionType = row[2] != null ? row[2].toString() : "";
				String qText = row[4] != null ? row[4].toString() : "";
				String ansType = row[5] != null ? row[5].toString() : "";
				
				Long ansId = row[6] != null ? ((Number) row[6]).longValue() : null;
				String ansLabel = row[7] != null ? row[7].toString() : "";
				Integer scoreVal = row[8] != null ? ((Number) row[8]).intValue() : 0;

				ManualQuestionAnswer mq = map.get(qId);
				if (mq == null) {
					mq = new ManualQuestionAnswer();
					mq.setQuestionId(qId);
					mq.setSeqNo(seqNo);
					mq.setQuestionText(StringUtils.isNotBlank(qText) ? qText : sectionType);
					mq.setAnswerType(ansType);
					mq.setOptions(new ArrayList<AnswerOption>());
					map.put(qId, mq);
					manualQAAnswers.add(mq);
				}
				
				if (ansId != null) {
					String label = ansLabel;
					if (label.startsWith("?")) {
						label = label.substring(1);
					}
					mq.getOptions().add(new AnswerOption(ansId, label, scoreVal));
				}
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public void saveManualFeedback() {
		try {
			if (selectedManualPaxKey == null || selectedManualPaxKey.trim().isEmpty()) {
				FacesContext.getCurrentInstance().addMessage(null,
					new FacesMessage(FacesMessage.SEVERITY_ERROR, "Please select a customer/booking.", ""));
				return;
			}

			selectedEligibleBooking = null;
			if (eligibleBookings != null) {
				for (FeedbackVO b : eligibleBookings) {
					String key = b.getTourBookingId() + "_" + b.getCustomerId() + "_" + (b.getInvId() != null ? b.getInvId() : "0");
					if (key.equals(selectedManualPaxKey)) {
						selectedEligibleBooking = b;
						break;
					}
				}
			}

			if (selectedEligibleBooking == null) {
				FacesContext.getCurrentInstance().addMessage(null,
					new FacesMessage(FacesMessage.SEVERITY_ERROR, "Selected booking could not be found.", ""));
				return;
			}

			// 1. Upload files
			if (manualNewUploadedFilesMap != null && !manualNewUploadedFilesMap.isEmpty()) {
				for (Map.Entry<String, byte[]> entry : manualNewUploadedFilesMap.entrySet()) {
					String uuidFileName = entry.getKey();
					byte[] fileBytes = entry.getValue();
					String responseStr = uploadFileToApi(uuidFileName, fileBytes, "true");
					Gson gson = new Gson();
					JsonObject json = gson.fromJson(responseStr, JsonObject.class);
					if (json == null || !json.has("status") || !"SUCCESS".equals(json.get("status").getAsString())) {
						throw new IOException("Failed to upload " + uuidFileName);
					}
				}
			}

			// 2. Create dynamic FeedbackVO
			FeedbackVO manualVO = new FeedbackVO();
			manualVO.setIdTourPkg(selectedEligibleBooking.getIdTourPkg());
			manualVO.setIdTourDeparture(selectedTourDep.getId());
			manualVO.setInvId(selectedEligibleBooking.getInvId());
			manualVO.setPsNo(selectedEligibleBooking.getPsNo());
			manualVO.setCustomerId(selectedEligibleBooking.getCustomerId());
			manualVO.setTourBookingId(selectedEligibleBooking.getTourBookingId());
			manualVO.setCustomerEmail(selectedEligibleBooking.getCustomerEmail());
			manualVO.setIdPs(selectedEligibleBooking.getIdPs());
			manualVO.setIdInv(selectedEligibleBooking.getIdInv());
			manualVO.setTokenUuid(UUID.randomUUID().toString());
			manualVO.setFeedbackStatus("C"); // Completed
			manualVO.setComments(this.manualGeneralComments);

			feedbackBO.saveCustomerFeedback(manualVO, manualQAAnswers, manualAttachments, manualDeletedAttachmentIds);

			// 3. Reset state and reload report data
			if (manualNewUploadedFilesMap != null) manualNewUploadedFilesMap.clear();
			if (manualDeletedAttachmentIds != null) manualDeletedAttachmentIds.clear();
			this.manualGeneralComments = null;
			if (this.manualAttachments != null) this.manualAttachments.clear();
			loadReportData();
			FacesContext.getCurrentInstance().addMessage(null,
				new FacesMessage(FacesMessage.SEVERITY_INFO, "Manual feedback submitted successfully.", ""));
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public void initEditFeedback(FeedbackRow row) {
		try {
			this.editingFeedbackRow = row;
			this.editCustComments = row.getComments();
			this.editCustDeletedAttachmentIds = new ArrayList<Long>();
			this.editCustNewUploadedFilesMap = new HashMap<String, byte[]>();
			this.editCustQAAnswers = new ArrayList<ManualQuestionAnswer>();

			List<Object[]> activeQA = feedbackBO.getActiveQuestionsAndAnswers();
			Map<Long, ManualQuestionAnswer> map = new LinkedHashMap<Long, ManualQuestionAnswer>();

			for (Object[] r : activeQA) {
				Long qId = r[0] != null ? ((Number) r[0]).longValue() : null;
				Integer seqNo = r[1] != null ? ((Number) r[1]).intValue() : 0;
				String sectionType = r[2] != null ? r[2].toString() : "";
				String qText = r[4] != null ? r[4].toString() : "";
				String ansType = r[5] != null ? r[5].toString() : "";
				
				Long ansId = r[6] != null ? ((Number) r[6]).longValue() : null;
				String ansLabel = r[7] != null ? r[7].toString() : "";
				Integer scoreVal = r[8] != null ? ((Number) r[8]).intValue() : 0;

				ManualQuestionAnswer mq = map.get(qId);
				if (mq == null) {
					mq = new ManualQuestionAnswer();
					mq.setQuestionId(qId);
					mq.setSeqNo(seqNo);
					mq.setQuestionText(StringUtils.isNotBlank(qText) ? qText : sectionType);
					mq.setAnswerType(ansType);
					mq.setOptions(new ArrayList<AnswerOption>());
					map.put(qId, mq);
					editCustQAAnswers.add(mq);
				}
				
				if (ansId != null) {
					String label = ansLabel;
					if (label.startsWith("?")) {
						label = label.substring(1);
					}
					mq.getOptions().add(new AnswerOption(ansId, label, scoreVal));
				}
			}

			if (row.getIdFeedback() != null) {
				List<FeedbackVO> existing = feedbackBO.getFeedbackDetails(row.getIdFeedback());
				for (FeedbackVO vo : existing) {
					Long qId = vo.getIdFeedbackQuestion();
					if (qId == null) continue;
					ManualQuestionAnswer mq = map.get(qId);
					if (mq != null) {
						if ("RATING".equalsIgnoreCase(mq.getAnswerType())) {
							mq.setSelectedAnswerId(vo.getIdFeedbackAnswer());
							mq.setRemarks(vo.getRemarks());
						} else if ("RADIO".equalsIgnoreCase(mq.getAnswerType())) {
							mq.setSelectedAnswerId(vo.getIdFeedbackAnswer());
						} else if ("CHECKBOX".equalsIgnoreCase(mq.getAnswerType())) {
							if (mq.getSelectedAnswerIds() == null) {
								mq.setSelectedAnswerIds(new ArrayList<Long>());
							}
							if (vo.getIdFeedbackAnswer() != null) {
								mq.getSelectedAnswerIds().add(vo.getIdFeedbackAnswer());
							}
						} else if ("TEXT".equalsIgnoreCase(mq.getAnswerType()) || "TEXTAREA".equalsIgnoreCase(mq.getAnswerType())) {
							mq.setAnswerText(vo.getAnswerText());
						}
					}
				}

				List<FeedbackVO> allAtts = feedbackBO.getAttachmentsByFeedbackId(row.getIdFeedback());
				this.editCustAttachments = new ArrayList<FeedbackVO>();
				if (allAtts != null) {
					for (FeedbackVO att : allAtts) {
						if ("cust".equals(att.getType())) {
							this.editCustAttachments.add(att);
						}
					}
				}
			} else {
				this.editCustAttachments = new ArrayList<FeedbackVO>();
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public void handleManualAttachmentUpload(FileUploadEvent event) {
		try {
			String originalName = event.getFile().getFileName();
			String fileNameLower = originalName.toLowerCase();
			
			if (fileNameLower.endsWith(".jpg") ||
				fileNameLower.endsWith(".jpeg") ||
				fileNameLower.endsWith(".png") ||
				fileNameLower.endsWith(".gif") ||
				fileNameLower.endsWith(".webp") ||
				fileNameLower.endsWith(".pdf")) {
				System.out.println("Valid manual attachment file: " + originalName);
			} else {
				FacesContext.getCurrentInstance().addMessage(null,
					new FacesMessage(FacesMessage.SEVERITY_ERROR, "Invalid file type. Only JPG, JPEG, PNG, GIF, WEBP, and PDF files are allowed.", ""));
				return;
			}
			
			String ext = "";
			int idx = originalName.lastIndexOf(".");
			if (idx >= 0) {
				ext = originalName.substring(idx);
			}
			String uuidFileName = UUID.randomUUID().toString() + ext;
			
			byte[] fileContents;
			try (InputStream in = event.getFile().getInputstream();
				 ByteArrayOutputStream bos = new ByteArrayOutputStream()) {
				byte[] buf = new byte[1024];
				int read;
				while ((read = in.read(buf)) != -1) {
					bos.write(buf, 0, read);
				}
				fileContents = bos.toByteArray();
			}
			
			if (this.manualNewUploadedFilesMap == null) {
				this.manualNewUploadedFilesMap = new HashMap<String, byte[]>();
			}
			this.manualNewUploadedFilesMap.put(uuidFileName, fileContents);
			
			FeedbackVO att = new FeedbackVO();
			att.setAttachmentUrl("api/files/feedback/");
			att.setFilename(uuidFileName);
			att.setType("cust");
			
			if (this.manualAttachments == null) {
				this.manualAttachments = new ArrayList<FeedbackVO>();
			}
			this.manualAttachments.add(att);
			
			FacesContext.getCurrentInstance().addMessage(null,
				new FacesMessage(FacesMessage.SEVERITY_INFO, "File " + originalName + " selected.", ""));
		} catch (Throwable t) {
			t.printStackTrace();
			FacesContext.getCurrentInstance().addMessage(null,
				new FacesMessage(FacesMessage.SEVERITY_ERROR, "Failed to select file: " + t.getMessage(), ""));
		}
	}

	public void removeManualAttachment(FeedbackVO att) {
		try {
			if (att.getIdAttachment() != null) {
				this.manualDeletedAttachmentIds.add(att.getIdAttachment());
			} else {
				if (this.manualNewUploadedFilesMap != null) {
					this.manualNewUploadedFilesMap.remove(att.getFilename());
				}
			}
			this.manualAttachments.remove(att);
			
			FacesContext.getCurrentInstance().addMessage(null,
				new FacesMessage(FacesMessage.SEVERITY_INFO, "Attachment removed.", ""));
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

