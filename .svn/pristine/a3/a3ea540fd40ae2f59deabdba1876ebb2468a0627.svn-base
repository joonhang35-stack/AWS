	public void handleSearchFeedbackSelect(SelectEvent event) {
		try {
			this.selectedSearchFeedbackRow = (FeedbackRow) event.getObject();
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public void selectSearchFeedback(FeedbackRow row) {
		this.selectedSearchFeedbackRow = row;
	}

	public void clearSearchFilter() {
		this.selectedSearchFeedbackRow = null;
	}

	public void triggerFeedbackEmails() { // this is for testing purpose
		try {
			List<FeedbackVO> feedbackList = feedbackBO.getInvoiceForFeedback();
			if (CollectionUtils.isNotEmpty(feedbackList)) {
				emailingBO.sendCustomerFeedbackEmail(feedbackList);
				FacesContext.getCurrentInstance().addMessage(null,
					new FacesMessage(FacesMessage.SEVERITY_INFO, "Success", "Triggered sending " + feedbackList.size() + " feedback emails successfully."));
			} else {
				FacesContext.getCurrentInstance().addMessage(null,
					new FacesMessage(FacesMessage.SEVERITY_WARN, "No Invoices Found", "No feedback invoices found for tours ending tomorrow."));
			}
		} catch (Throwable t) {
			t.printStackTrace();
			FacesContext.getCurrentInstance().addMessage(null,
				new FacesMessage(FacesMessage.SEVERITY_ERROR, "Error", "Failed to trigger feedback emails: " + t.getMessage()));
		}
	}

	public List<ReportColumn> getVisibleColumnList() {
		List<ReportColumn> visible = new ArrayList<ReportColumn>();
		if (columnList != null) {
			for (ReportColumn col : columnList) {
				if (col.isVisible()) {
					visible.add(col);
				}
			}
		}
		return visible;
	}

}
