			Map<String, Object> params = new HashMap<String, Object>();
			params.put("inactiveRecords", false);
			lazyDataModelTourDep = new LazyDMTourDep<TourDepartureVO>(params);
			lazyDataModelTourDep.setCompanyId(this.getSessionInfoBean().getCompanyVO().getId());
			
			if (employeeList == null) {
				employeeList = userBO.getEmployeeViewList(getSessionInfoBean().getCompanyVO().getId());
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

