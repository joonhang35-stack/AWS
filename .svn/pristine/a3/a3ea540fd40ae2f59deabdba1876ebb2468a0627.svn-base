	public boolean isFeedbackModuleEnabled() {
		return SystemProperty.isFeedbackModuleEnabled();
	}


	public String getTruncatedText(String text) {
		if (text == null || text.trim().isEmpty()) {
			return "";
		}
		if (text.length() > 30) {
			return text.substring(0, 27) + "...";
		}
		return text;
	}

	public boolean isTextLong(String text) {
		return text != null && text.length() > 30;
	}






	public void loadPaxDetails(FeedbackRow row) {
		try {
			this.paxDialogFeedbackRow = row;
			this.selectedPaxList = feedbackBO.getPaxListForFeedback(row.getTourBookingId(), row.getInvCode(), row.getPsNo());
			if (selectedPaxList != null) {
				for (FeedbackVO vo : selectedPaxList) {
					vo.setSelected(true); // Default to checked
				}
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public void sendPaxFeedbackEmail() {
		try {
			if (selectedPaxList == null || selectedPaxList.isEmpty()) {
				FacesContext.getCurrentInstance().addMessage(null,
					new FacesMessage(FacesMessage.SEVERITY_WARN, "No passengers available.", ""));
				return;
			}

			String updatedBy = "SYSTEM";
			try {
				if (BaseContext.getUserFullName() != null) {
					updatedBy = BaseContext.getUserFullName();
				} else if (BaseContext.getLoginId() != null) {
					updatedBy = BaseContext.getLoginId();
				}
			} catch (Exception e) {}

			List<FeedbackVO> listToEmail = new ArrayList<FeedbackVO>();
			for (FeedbackVO vo : selectedPaxList) {
				if (vo.isSelected()) {
					if (StringUtils.isBlank(vo.getCustomerEmail())) {
						FacesContext.getCurrentInstance().addMessage(null,
							new FacesMessage(FacesMessage.SEVERITY_ERROR, "Passenger " + vo.getCustomerName() + " has no email address.", ""));
						return;
					}

					String newUuid = UUID.randomUUID().toString();
					vo.setTokenUuid(newUuid);
					vo.setFeedbackStatus("P");
					
					Long existingFeedbackId = feedbackBO.getFeedbackId(vo.getTourBookingId(), vo.getCustomerId(), vo.getInvId());
					if (existingFeedbackId != null) {
						vo.setIdFeedback(existingFeedbackId);
						feedbackBO.updateFeedbackForResend(existingFeedbackId, newUuid, "P", vo.getCustomerEmail(), vo.getInvId(), vo.getPsNo(), updatedBy);
					} else {
						feedbackBO.insertFeedback(vo);
					}
					listToEmail.add(vo);
				}
			}

			if (!listToEmail.isEmpty()) {
				emailingBO.sendCustomerFeedbackEmail(listToEmail);
				FacesContext.getCurrentInstance().addMessage(null,
					new FacesMessage(FacesMessage.SEVERITY_INFO, "Feedback emails triggered successfully.", ""));
			} else {
				FacesContext.getCurrentInstance().addMessage(null,
					new FacesMessage(FacesMessage.SEVERITY_WARN, "Please select at least one passenger.", ""));
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	// Getters for Header Groups
	public List<HeaderGroup> getHeaderGroupList() { return headerGroupList; }
	public List<FeedbackVO> getSelectedFeedbackAttachments() { return selectedFeedbackAttachments; }

	public List<HeaderGroup> getVisibleHeaderGroups() {
		List<HeaderGroup> visibleGroups = new ArrayList<HeaderGroup>();
		if (headerGroupList != null) {
			for (HeaderGroup g : headerGroupList) {
				int visibleCount = 0;
				for (ReportColumn col : g.getColumns()) {
					if (col.isVisible()) {
						visibleCount++;
					}
				}
				if (visibleCount > 0) {
					HeaderGroup vg = new HeaderGroup(g.getHeaderText());
					vg.setColspan(visibleCount);
					vg.setRowspan(g.getRowspan());
					vg.setColumns(g.getColumns());
					vg.setSectionType(g.getSectionType());
					visibleGroups.add(vg);
				}
			}
		}
		return visibleGroups;
	}

	public List<ReportColumn> getSubHeaderColumns() {
		List<ReportColumn> subCols = new ArrayList<ReportColumn>();
		if (headerGroupList != null) {
			for (HeaderGroup g : headerGroupList) {
				if (g.getRowspan() == 1) { // has sub-headers
					for (ReportColumn col : g.getColumns()) {
						if (col.isVisible()) {
							subCols.add(col);
						}
					}
				}
			}
		}
		return subCols;
	}

	public void loadAttachments(FeedbackRow row) {
		try {
			this.selectedFeedbackRow = row;
			this.selectedFeedbackAttachments = feedbackBO.getAttachmentsByFeedbackId(row.getIdFeedback());
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	public HashMap<String, Object> reportHeaderCompany() {
		HashMap<String, Object> map = new HashMap<String, Object>();
		try {
			CompanyVO companyVO = corporateProfileBO.getCompanyDetails(getSessionInfoBean().getCompanyVO().getId());
			
			StringBuilder address = new StringBuilder();
			map.put("companyName", companyVO.getName());
			map.put("slogan", companyVO.getSlogan());
			
			if (!companyVO.getCompanyAddressVO().getAddress1().equals("")) address.append(companyVO.getCompanyAddressVO().getAddress1()).append(" ");
			if (!companyVO.getCompanyAddressVO().getAddress2().equals("")) address.append(companyVO.getCompanyAddressVO().getAddress2()).append(" ");
			if (!companyVO.getCompanyAddressVO().getAddress3().equals("")) address.append(companyVO.getCompanyAddressVO().getAddress3()).append(" ");
			if (!companyVO.getCompanyAddressVO().getCity().equals("")) address.append(companyVO.getCompanyAddressVO().getCity()).append(" ");
			if (!companyVO.getCompanyAddressVO().getState().equals("")) address.append(companyVO.getCompanyAddressVO().getState()).append(" ");
			if (!companyVO.getCompanyAddressVO().getPostcode().equals("")) address.append(companyVO.getCompanyAddressVO().getPostcode()).append(" ");
			String countryName = regionBO.getCountryById(companyVO.getCompanyAddressVO().getCountryid()).getCountry();
			if (!countryName.equals("")) address.append(countryName);
			map.put("address", address.toString());
	
			String contact = "";
			for (CompanyContactVO vo : companyVO.getCompanyContactList()) {
				contact += LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, vo.getTypecodecontact()) + ": " + vo.getNumber() + "  ";
			}
			if (!contact.equals("")) contact = "Tel: " + contact;
			map.put("contact", contact);
			
		} catch (Throwable t) {
			errorResult(t);
		}
		return map;
	}

	public void printFeedbackReport(String xlsOrPdf) {
		try {
			if (feedbackRows == null || feedbackRows.isEmpty()) {
				throw new BusinessException("ERR_NO_RESULT");
			}

			// 1. Get lists of visible columns and headers
			List<ReportColumn> columns = getVisibleColumnList();
			List<HeaderGroup> groups = getVisibleHeaderGroups();

			// 2. Load the JRXML template
			String reportPath = FacesContext.getCurrentInstance().getExternalContext().getRealPath("/reports/feedback_rpt_template.jrxml");
			JasperDesign jasperDesign = JRXmlLoader.load(reportPath);

			// 3. Compute dynamic widths
			int customerNameWidth = 140;
			int colWidth = 120;
			int commentsWidth = 150;
			int commentsHosWidth = 150;
			
			int totalWidth = customerNameWidth + (columns.size() * colWidth) + commentsWidth + commentsHosWidth;
			int pageWidth = totalWidth + 20; // 10 margin on each side

			jasperDesign.setPageWidth(pageWidth);
			jasperDesign.setColumnWidth(totalWidth);

			// 4. Add field definitions dynamically
			// customerName
			JRDesignField fCustName = new JRDesignField();
			fCustName.setName("customerName");
			fCustName.setValueClass(String.class);
			jasperDesign.addField(fCustName);

			// comments
			JRDesignField fComments = new JRDesignField();
			fComments.setName("comments");
			fComments.setValueClass(String.class);
			jasperDesign.addField(fComments);

			// commentsHos
			JRDesignField fCommentsHos = new JRDesignField();
			fCommentsHos.setName("commentsHos");
			fCommentsHos.setValueClass(String.class);
			jasperDesign.addField(fCommentsHos);

			// Dynamic columns
			for (ReportColumn col : columns) {
				JRDesignField fDynamic = new JRDesignField();
				fDynamic.setName(col.getKey());
				fDynamic.setValueClass(String.class);
				jasperDesign.addField(fDynamic);
			}

			// 5. Add headers to columnHeader band
			JRDesignBand columnHeaderBand = (JRDesignBand) jasperDesign.getColumnHeader();
			columnHeaderBand.setHeight(48);
			
			// Style reference
			JRStyle rowStyle = jasperDesign.getStylesMap().get("RowStyle");

			// Line box border styling helper
			Color borderColor = new Color(204, 204, 204); // #CCCCCC
			Color headerBg = new Color(239, 239, 239); // #EFEFEF

			// Row 1: Merged Group Headers
			int currentX = 0;

			// Customer Name header
			JRDesignStaticText headerCust = new JRDesignStaticText();
			headerCust.setX(currentX);
			headerCust.setY(0);
			headerCust.setWidth(customerNameWidth);
			headerCust.setHeight(48);
			headerCust.setText("Customer Name");
			headerCust.setMode(ModeEnum.OPAQUE);
			headerCust.setBackcolor(headerBg);
			headerCust.setHorizontalAlignment(HorizontalAlignEnum.CENTER);
			headerCust.setVerticalAlignment(VerticalAlignEnum.MIDDLE);
			headerCust.getLineBox().getPen().setLineWidth(0.5f);
			headerCust.getLineBox().getPen().setLineColor(borderColor);
			headerCust.setFontName("Arial Unicode MS");
			headerCust.setFontSize(8);
			headerCust.setBold(true);
			columnHeaderBand.addElement(headerCust);

			currentX += customerNameWidth;

			// Visible header groups
			for (HeaderGroup group : groups) {
				int width = group.getColspan() * colWidth;
				int height = group.getRowspan() == 2 ? 48 : 24;
				
				JRDesignStaticText headerGroup = new JRDesignStaticText();
				headerGroup.setX(currentX);
				headerGroup.setY(0);
				headerGroup.setWidth(width);
				headerGroup.setHeight(height);
				headerGroup.setText(group.getHeaderText());
				headerGroup.setMode(ModeEnum.OPAQUE);
				headerGroup.setBackcolor(headerBg);
				headerGroup.setHorizontalAlignment(HorizontalAlignEnum.CENTER);
				headerGroup.setVerticalAlignment(VerticalAlignEnum.MIDDLE);
				headerGroup.getLineBox().getPen().setLineWidth(0.5f);
				headerGroup.getLineBox().getPen().setLineColor(borderColor);
				headerGroup.setFontName("Arial Unicode MS");
				headerGroup.setFontSize(8);
				headerGroup.setBold(true);
				columnHeaderBand.addElement(headerGroup);

				currentX += width;
			}

			// Comments header
			JRDesignStaticText headerComm = new JRDesignStaticText();
			headerComm.setX(currentX);
			headerComm.setY(0);
			headerComm.setWidth(commentsWidth);
			headerComm.setHeight(48);
			headerComm.setText("Comments");
			headerComm.setMode(ModeEnum.OPAQUE);
			headerComm.setBackcolor(headerBg);
			headerComm.setHorizontalAlignment(HorizontalAlignEnum.CENTER);
			headerComm.setVerticalAlignment(VerticalAlignEnum.MIDDLE);
			headerComm.getLineBox().getPen().setLineWidth(0.5f);
			headerComm.getLineBox().getPen().setLineColor(borderColor);
			headerComm.setFontName("Arial Unicode MS");
			headerComm.setFontSize(8);
			headerComm.setBold(true);
			columnHeaderBand.addElement(headerComm);

			currentX += commentsWidth;

			// Comments HOS header
			JRDesignStaticText headerCommHos = new JRDesignStaticText();
			headerCommHos.setX(currentX);
			headerCommHos.setY(0);
			headerCommHos.setWidth(commentsHosWidth);
			headerCommHos.setHeight(48);
			headerCommHos.setText("Comments from HOS");
			headerCommHos.setMode(ModeEnum.OPAQUE);
			headerCommHos.setBackcolor(headerBg);
			headerCommHos.setHorizontalAlignment(HorizontalAlignEnum.CENTER);
			headerCommHos.setVerticalAlignment(VerticalAlignEnum.MIDDLE);
			headerCommHos.getLineBox().getPen().setLineWidth(0.5f);
			headerCommHos.getLineBox().getPen().setLineColor(borderColor);
			headerCommHos.setFontName("Arial Unicode MS");
			headerCommHos.setFontSize(8);
			headerCommHos.setBold(true);
			columnHeaderBand.addElement(headerCommHos);

			// Row 2: Sub-headers (only for groups with colspan > 1 / rowspan = 1)
			int subX = customerNameWidth;
			for (HeaderGroup group : groups) {
				int width = group.getColspan() * colWidth;
				if (group.getRowspan() == 1) {
					// Add sub-headers
					for (ReportColumn col : group.getColumns()) {
						if (col.isVisible()) {
							JRDesignStaticText subHeader = new JRDesignStaticText();
							subHeader.setX(subX);
							subHeader.setY(24);
							subHeader.setWidth(colWidth);
							subHeader.setHeight(24);
							subHeader.setText(col.getHeader());
							subHeader.setMode(ModeEnum.OPAQUE);
							subHeader.setBackcolor(headerBg);
							subHeader.setHorizontalAlignment(HorizontalAlignEnum.CENTER);
							subHeader.setVerticalAlignment(VerticalAlignEnum.MIDDLE);
							subHeader.getLineBox().getPen().setLineWidth(0.5f);
							subHeader.getLineBox().getPen().setLineColor(borderColor);
							subHeader.setFontName("Arial Unicode MS");
							subHeader.setFontSize(7);
							subHeader.setBold(true);
							columnHeaderBand.addElement(subHeader);
							subX += colWidth;
						}
					}
				} else {
					subX += width;
				}
			}

			// 6. Add elements to detail band
			JRDesignBand detailBand = (JRDesignBand) jasperDesign.getDetailSection().getBands()[0];

			int detailX = 0;

			// Customer Name field
			JRDesignTextField fldCust = new JRDesignTextField();
			fldCust.setX(detailX);
			fldCust.setY(0);
			fldCust.setWidth(customerNameWidth);
			fldCust.setHeight(20);
			fldCust.setExpression(createFieldExpression("customerName"));
			fldCust.setStretchWithOverflow(true);
			fldCust.setBlankWhenNull(true);
			fldCust.getLineBox().getPen().setLineWidth(0.5f);
			fldCust.getLineBox().getPen().setLineColor(borderColor);
			fldCust.getLineBox().setLeftPadding(3);
			fldCust.setVerticalAlignment(VerticalAlignEnum.MIDDLE);
			fldCust.setFontName("Arial Unicode MS");
			fldCust.setFontSize(8);
			if (rowStyle != null) fldCust.setStyle(rowStyle);
			detailBand.addElement(fldCust);

			detailX += customerNameWidth;

			// Dynamic columns fields
			for (ReportColumn col : columns) {
				JRDesignTextField fldDynamic = new JRDesignTextField();
				fldDynamic.setX(detailX);
				fldDynamic.setY(0);
				fldDynamic.setWidth(colWidth);
				fldDynamic.setHeight(20);
				fldDynamic.setExpression(createFieldExpression(col.getKey()));
				fldDynamic.setStretchWithOverflow(true);
				fldDynamic.setBlankWhenNull(true);
				fldDynamic.getLineBox().getPen().setLineWidth(0.5f);
				fldDynamic.getLineBox().getPen().setLineColor(borderColor);
				fldDynamic.setHorizontalAlignment(HorizontalAlignEnum.CENTER);
				fldDynamic.setVerticalAlignment(VerticalAlignEnum.MIDDLE);
				fldDynamic.setFontName("Arial Unicode MS");
				fldDynamic.setFontSize(8);
				if (rowStyle != null) fldDynamic.setStyle(rowStyle);
				detailBand.addElement(fldDynamic);

				detailX += colWidth;
			}

			// Comments field
			JRDesignTextField fldComm = new JRDesignTextField();
			fldComm.setX(detailX);
			fldComm.setY(0);
			fldComm.setWidth(commentsWidth);
			fldComm.setHeight(20);
			fldComm.setExpression(createFieldExpression("comments"));
			fldComm.setStretchWithOverflow(true);
			fldComm.setBlankWhenNull(true);
			fldComm.getLineBox().getPen().setLineWidth(0.5f);
			fldComm.getLineBox().getPen().setLineColor(borderColor);
			fldComm.getLineBox().setLeftPadding(3);
			fldComm.setVerticalAlignment(VerticalAlignEnum.MIDDLE);
			fldComm.setFontName("Arial Unicode MS");
			fldComm.setFontSize(8);
			if (rowStyle != null) fldComm.setStyle(rowStyle);
			detailBand.addElement(fldComm);

			detailX += commentsWidth;

			// Comments HOS field
			JRDesignTextField fldCommHos = new JRDesignTextField();
			fldCommHos.setX(detailX);
			fldCommHos.setY(0);
			fldCommHos.setWidth(commentsHosWidth);
			fldCommHos.setHeight(20);
			fldCommHos.setExpression(createFieldExpression("commentsHos"));
			fldCommHos.setStretchWithOverflow(true);
			fldCommHos.setBlankWhenNull(true);
			fldCommHos.getLineBox().getPen().setLineWidth(0.5f);
			fldCommHos.getLineBox().getPen().setLineColor(borderColor);
			fldCommHos.getLineBox().setLeftPadding(3);
			fldCommHos.setVerticalAlignment(VerticalAlignEnum.MIDDLE);
			fldCommHos.setFontName("Arial Unicode MS");
			fldCommHos.setFontSize(8);
			if (rowStyle != null) fldCommHos.setStyle(rowStyle);
			detailBand.addElement(fldCommHos);

			// 7. Compile the design
			JasperReport jasperReport = JasperCompileManager.compileReport(jasperDesign);

			// 8. Prepare dynamic data source maps with placeholder for null values
			Collection<Map<String, ?>> dataList = new ArrayList<Map<String, ?>>();
			boolean isPdf = "PDF".equals(xlsOrPdf);
			for (FeedbackRow row : feedbackRows) {
				Map<String, Object> dataMap = new HashMap<String, Object>();
				// Static fields – ensure non-null placeholders
				String custName = row.getCustomerName() != null ? row.getCustomerName() : "-";
				String comments = row.getComments() != null ? row.getComments() : "-";
				String commentsHos = row.getCommentsHos() != null ? row.getCommentsHos() : "-";
				
				if (isPdf) {
					custName = cleanTextForPdf(custName);
					comments = cleanTextForPdf(comments);
					commentsHos = cleanTextForPdf(commentsHos);
				}

				dataMap.put("customerName", org.apache.commons.lang.StringUtils.isNotBlank(custName) ? custName : "-");
				dataMap.put("comments", org.apache.commons.lang.StringUtils.isNotBlank(comments) ? comments : "-");
				dataMap.put("commentsHos", org.apache.commons.lang.StringUtils.isNotBlank(commentsHos) ? commentsHos : "-");
				dataMap.put("summaryRow", row.isSummaryRow());

				// Dynamic columns – use dash when answer is null
				for (ReportColumn col : columns) {
					Object val = row.getCellValues().get(col.getKey());
					if ("Y".equals(val)) {
						val = isPdf ? "Y" : "✓";
					} else if (isPdf && val != null) {
						val = cleanTextForPdf(val);
					}
					dataMap.put(col.getKey(), val != null ? val : "-");
				}
				dataList.add(dataMap);
			}

			// 9. Prepare parameters
			HashMap<String, Object> map = reportHeaderCompany();
			map.put("tourCode", this.tourCode != null ? this.tourCode : "-");
			map.put("tourLeader", this.tourLeader != null ? this.tourLeader : "-");
			map.put("tourManager", this.tourManager != null ? this.tourManager : "-");
			map.put("packageName", this.packageName != null ? this.packageName : "-");

			String reportName = "Feedback_Report_" + (this.tourCode != null ? this.tourCode : "tour");

			// 10. Fill and print
			JRMapCollectionDataSource dataSource = new JRMapCollectionDataSource(dataList);
			JasperPrint jasperPrint = JasperFillManager.fillReport(jasperReport, map, dataSource);

			if ("PDF".equals(xlsOrPdf)) {
				ReportUtils.printReport(jasperPrint, reportName);
			} else {
				jasperPrint.setProperty("net.sf.jasperreports.export.xls.detect.cell.type", "true");
				ReportUtils.printReportExcel(jasperPrint, reportName);
			}
		} catch (Throwable t) {
			t.printStackTrace();
			errorResult(t);
		}
	}

	private String cleanTextForPdf(Object val) {
		if (val == null) {
			return null;
		}
		String str = String.valueOf(val);
		// Replace emoji/surrogate characters and unassigned symbols
		str = str.replaceAll("[\\p{So}\\p{Cs}]", "");
		return str.trim();
	}

	private JRDesignExpression createFieldExpression(String fieldName) {
		JRDesignExpression expression = new JRDesignExpression();
		expression.setText("$F{" + fieldName + "}");
		return expression;
	}

	// Dynamic Header Group helper class
	public static class HeaderGroup implements Serializable {
		private static final long serialVersionUID = 1L;
		private String headerText;
		private int colspan = 1;
		private int rowspan = 1;
		private String sectionType;
		private List<ReportColumn> columns = new ArrayList<ReportColumn>();

		public HeaderGroup(String headerText) {
			this.headerText = headerText;
		}

		public String getHeaderText() { 
			return headerText; 
			}
		
		public void setHeaderText(String headerText) { 
			this.headerText = headerText; 
			}
		
		public int getColspan() { 
			return colspan; 
			}
		
		public void setColspan(int colspan) { 
			this.colspan = colspan; 
			}
		
		public int getRowspan() { 
			return rowspan; 
			}
		
		public void setRowspan(int rowspan) { 
			this.rowspan = rowspan;
			}
		
		public String getSectionType() { 
			return sectionType; 
			}
		
		public void setSectionType(String sectionType) { 
			this.sectionType = sectionType; 
			}
		
		public List<ReportColumn> getColumns() { 
			return columns; 
			}
		
		public void setColumns(List<ReportColumn> columns) { 
			this.columns = columns; 
			}
	}
	
	
	// Dynamic Columns helper class
	public static class ReportColumn implements Serializable {
		private static final long serialVersionUID = 1L;
		private Long questionId;
		private String header;
		private String answerType;
		private Long answerId;
		private String groupHeader;
		private boolean visible = true;

		public ReportColumn(Long questionId, String header, String answerType, Long answerId, String groupHeader) {
			this.questionId = questionId;
			this.header = header;
			this.answerType = answerType;
			this.answerId = answerId;
			this.groupHeader = groupHeader;
		}

		public String getKey() {
			if (answerId != null) {
				return questionId + "_" + answerId;
			}
			return String.valueOf(questionId);
		}

		public Long getQuestionId() {
			return questionId; 
		}
		
		public String getHeader() {
			return header; 
		}
		
		public String getAnswerType() { 
			return answerType; 
		}
		
		public Long getAnswerId() { 
			return answerId; 
		}
		
		public String getGroupHeader() { 
			return groupHeader; 
		}
		
		public boolean isVisible() { 
			return visible; 
		}
		
		public void setVisible(boolean visible) { 
			this.visible = visible; 
		}
	}
	
