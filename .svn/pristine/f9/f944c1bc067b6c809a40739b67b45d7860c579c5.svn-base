<!DOCTYPE composition PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:p="http://primefaces.org/ui"
	xmlns:pe="http://primefaces.org/ui/extensions"
	xmlns:zsg="http://www.bcs.com/zsg/jsf"
	xmlns:bterp="http://www.bcs.com/zsg/jsf/bterp">

	<p:growl id="msg" />
	
	<script type="text/javascript">
		function onValidation(xhr, status, args) {
			if (args.validationFailed) {
				varAddCustDialog.show();
			} else {
				varAddCustDialog.hide();
			}
		}
	</script>
	
	<p:panelGrid id="idCustomerDetail">
		<p:row>
			<p:column style="width:110px;">
				<h:outputLabel>Customer No</h:outputLabel>
			</p:column>
			<p:column style="width:200px;">
				<h:outputLabel value="#{salesBean.customerVO.code}" style="font-weight:bold;"/>
			</p:column>
			<p:column style="width:110px;">
				<h:outputLabel for="idCustLock"
					rendered="#{salesBean.invPmntAuthVO.salesManager or salesBean.invPmntAuthVO.operationsRole or salesBean.invPmntAuthVO.asstSalesManager}">Customer Lock</h:outputLabel>
			</p:column>
			<p:column style="width:200px;">
				<p:selectBooleanButton label="Customer Lock" id="idCustLock" value="#{salesBean.customerVO.isLock}"
					onLabel="Yes" offLabel="No" onIcon="ui-icon-check" offIcon="ui-icon-close"
					rendered="#{salesBean.invPmntAuthVO.salesManager or salesBean.invPmntAuthVO.operationsRole or salesBean.invPmntAuthVO.asstSalesManager}"/>
				<pe:tooltip for="idCustLock">
					<h:outputText value="Lock or unlock customer information."/>
				</pe:tooltip>
			</p:column>
		</p:row>
		<p:row>
			<p:column>
				<h:outputLabel for="idCustType">Customer Type <span
						class="required">*</span>
				</h:outputLabel>
			</p:column>
			<p:column>
				<h:selectOneMenu id="idCustType" label="Customer Type"
					value="#{salesBean.customerVO.pcTypeCd}" required="true"
					disabled="#{not salesBean.customerVO.addEdit}">
					<f:selectItem itemLabel="Individual" itemValue="P" />
					<f:selectItem itemLabel="Corporate" itemValue="C" />
					<p:ajax event="change" listener="#{salesBean.handleCustomerType}"
						update="idCustomerDetail,:idContactDialog" />
				</h:selectOneMenu>
			</p:column>
			<p:column rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
				<h:outputLabel for="idClassType">Class</h:outputLabel>
			</p:column>
			<p:column rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
				<p:selectCheckboxMenu id="idClassType"
					style="vertical-align:middle"
					value="#{salesBean.customerVO.classList}" label="Class"
					filter="true" filterMatchMode="contains"
					onHide="executeOnClassOnhide();">
					<f:selectItems value="#{bterp:lookupItemList('cust_class')}"
						var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
				</p:selectCheckboxMenu>
				<p:remoteCommand name="executeOnClassOnhide"
					actionListener="#{salesBean.handleClassChange}"
					update=":idAddCustForm:idClassName"
					process="@this, :idAddCustForm:idClassType" global="false" />
					
			</p:column>
			
			<p:column rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
				<h:outputLabel for="idCompanyTIN">TIN <span
						class="required">*</span>
				</h:outputLabel> 
			</p:column>
			<p:column rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
				<p:inputText id="idCompanyTIN" label="TIN" required="true"
					value="#{salesBean.customerVO.corporateVO.taxIdNo}" maxlength="20"
					disabled="#{not empty salesBean.customerVO.corporateVO.taxIdNo and not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}"
					validatorMessage="TIN shouldn't contain spaces.">
					<f:validateRegex pattern="^\S+$" />
					<p:ajax event="change" global="false"></p:ajax>
				</p:inputText>
			</p:column>
		</p:row>
		
		<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
			<p:column colspan="3">
				<h:outputLabel />
			</p:column>
			<p:column>
				<h:outputText id="idClassName" value="#{salesBean.customerVO.className}" style="font-size:8px;"></h:outputText>
			</p:column>
		</p:row>
		
		<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
			<p:column>
				<h:outputLabel for="idCompName">Company Name <span class="required">*</span>
				</h:outputLabel>
			</p:column>
			<p:column colspan="3">
				<p:inputText id="idCompName" label="Company Name"
					value="#{salesBean.customerVO.corporateName}" size="50" maxlength="255"
					required="true" disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
					<p:ajax event="change" global="false"></p:ajax>
				</p:inputText>
			</p:column>
		</p:row>

		<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
			<p:column>
				<h:outputLabel for="idRegNo">Registration No. (New) <span class="required">*</span></h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idRegNo" label="Registration No. (New)" required="true"
					value="#{salesBean.customerVO.corporateVO.regNo}" maxlength="20"
					disabled="#{not empty salesBean.customerVO.corporateVO.regNo and not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
					<p:ajax event="change" global="false"></p:ajax>
				</p:inputText>
				
				&nbsp;
				<p:commandLink id="idFillNA" actionListener="#{salesBean.corpRegNoFillNA(salesBean.customerVO.corporateVO)}" 
					style="color: #db3333; text-decoration: underline;" update="idRegNo idCompanyTIN" process="@this">
					NA
				</p:commandLink>
				<pe:tooltip for="idFillNA" value="Click to autofill 'NA' into the Registration No. field" />
			</p:column>
			<p:column>
				<h:outputLabel for="idRegNoOld">Registration No. (Old)</h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idRegNoOld" label="Registration No. (Old)"
					value="#{salesBean.customerVO.corporateVO.regNoOld}" maxlength="20"
					disabled="#{not empty salesBean.customerVO.corporateVO.regNoOld and not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}"/>
			</p:column>
		</p:row>

		<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
			<p:column>
				<h:outputLabel for="idGstRegNo">GST Registration No.</h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idGstRegNo" label="GST Registration No." value="#{salesBean.customerVO.corporateVO.gstRegNo}" maxlength="20"
					disabled="#{not empty salesBean.customerVO.corporateVO.gstRegNo and not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}"/>
			</p:column>
			<p:column>
				<h:outputLabel for="idSstRegNo">SST Registration No.</h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idSstRegNo" label="SST Registration No." value="#{salesBean.customerVO.corporateVO.sstRegNo}"
					disabled="#{not empty salesBean.customerVO.corporateVO.sstRegNo and not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}"/>
			</p:column>
		</p:row>
		
		<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
			<p:column>
				<h:outputLabel for="idSalutate">Salutation <span class="required">*</span>
				</h:outputLabel>
			</p:column>
			<p:column>
				<h:selectOneMenu id="idSalutate" label="Salutation" value="#{salesBean.customerVO.personVO.salutation}" required="true"
					disabled="#{not empty salesBean.customerVO.personVO.salutation and not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
					<f:selectItem itemLabel="Select One" itemValue="" />
					<f:selectItems value="#{bterp:lookupItemList('salutatn2')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
				</h:selectOneMenu>
			</p:column>
			<p:column>
				<h:outputLabel for="idTitle">Title</h:outputLabel>
			</p:column>
			<p:column>
				<h:selectOneMenu id="idTitle" label="Title" value="#{salesBean.customerVO.personVO.title}">
					<f:selectItem itemLabel="Select One" itemValue="" />
					<f:selectItems value="#{bterp:lookupItemList('salutatn')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
				</h:selectOneMenu>
			</p:column>
		</p:row>

		<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
			<p:column>
				<h:outputLabel for="idLastName">SurName <span class="required">*</span>
				</h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idLastName" label="SurName" value="#{salesBean.customerVO.personVO.lastName}" required="true"
					disabled="#{not empty salesBean.customerVO.personVO.lastName and not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}"
					validatorMessage="SurName cannot be empty or just spaces">
					<f:validateRegex pattern=".*\S.*" />
				</p:inputText>
			</p:column>
			<p:column>
				<h:outputLabel for="idGender">Gender</h:outputLabel>
			</p:column>
			<p:column>
				<h:selectOneMenu id="idGender" label="Gender"
					value="#{salesBean.customerVO.personVO.sex}">
					<f:selectItem itemLabel="Select One" itemValue="" />
					<f:selectItems value="#{bterp:lookupItemList('gender_type')}"
						var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}" />
				</h:selectOneMenu>
			</p:column>
		</p:row>

		<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
			<p:column>
				<h:outputLabel for="idGivenName">Given Name <span class="required">*</span></h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idGivenName" label="Given Name" value="#{salesBean.customerVO.personVO.givenName}" required="true"
					disabled="#{not empty salesBean.customerVO.personVO.givenName and not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}"
					validatorMessage="Given Name cannot be empty or just spaces">
					<f:validateRegex pattern=".*\S.*" />
				</p:inputText>
			</p:column>
			<p:column>
				<h:outputLabel for="idNickName">NickName</h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idNickName" label="NickName" value="#{salesBean.customerVO.personVO.nickName}" converter="trimConverter"/>
			</p:column>
		</p:row>
		
		<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
			<p:column>
				<h:outputLabel for="idNationality">Nationality <span class="required">*</span></h:outputLabel>
			</p:column>
			<p:column>
				<h:selectOneMenu id="idNationality" label="Nationality"
					value="#{salesBean.customerVO.personVO.countryId}" style="width:180px;" required="true">
					<p:ajax event="change" listener="#{salesBean.handleNationalitySelected}" update="idTaxIdNo :idAddCustForm:idCity :idAddCustForm:idState" />
					<f:selectItem itemLabel="Select One" itemValue="" />
					<f:selectItems value="#{salesBean.countryList}" var="vo"
						itemLabel="#{vo.country}" itemValue="#{vo.id}" />
				</h:selectOneMenu>
			</p:column>
			<p:column>
				<h:outputLabel for="idTaxIdNo">TIN</h:outputLabel>
			</p:column>
			<p:column colspan="3">
				<p:inputText id="idTaxIdNo" label="TIN"
					value="#{salesBean.customerVO.personVO.taxIdNo}" maxlength="20"
					disabled="#{not empty salesBean.customerVO.personVO.taxIdNo and not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}"
					validatorMessage="TIN shouldn't contain spaces.">
					<f:validateRegex pattern="^\S+$" />
				</p:inputText>
			</p:column>
		</p:row>
		
		<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
			<p:column>
				<h:outputLabel for="idNRIC">NRIC <span class="required">*</span></h:outputLabel>
			</p:column>
			<p:column>
				<p:inputMask id="idNRIC" label="NRIC" value="#{salesBean.nricIdVO.idNo}" mask="999999-99-9999"
					disabled="#{not empty salesBean.nricIdVO.idNo and not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
					<p:ajax event="change" update=":idAddCustForm:idDOB,:idAddCustForm:idAge" listener="#{salesBean.syncNRIC}"/>	
				</p:inputMask>
			</p:column>
			<p:column>
				<h:outputLabel for="idPassportNo">Passport No <span class="required">*</span></h:outputLabel>
			</p:column>
			<p:column colspan="3">
				<p:inputText id="idPassportNo" label="Passport No"
					value="#{salesBean.passportIdVO.idNo}" maxlength="20" onkeypress="return rtnAlphaNumeric(event);"
					disabled="#{not empty salesBean.passportIdVO.idNo and not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
					<p:ajax event="change" update=":idAddCustForm:idPssprtNo" listener="#{salesBean.syncPassportNo}"/>	
				</p:inputText>
			</p:column>
		</p:row>

		<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
			<p:column>
				<h:outputLabel for="idDOB">Date of Birth (DOB)</h:outputLabel>
			</p:column>
			<p:column>
				<p:calendar id="idDOB" label="Date of Birth"
					value="#{salesBean.customerVO.personVO.dob}" navigator="true" showButtonPanel="true"
					yearRange="c-100:c-0" pattern="dd-MMM-yyyy">
					<p:ajax event="dateSelect" listener="#{salesBean.calculateAge}"
						update="idAge" global="false" />
				</p:calendar>
			</p:column>
			<p:column>
				<h:outputLabel for="idAge">Age</h:outputLabel>
			</p:column>
			<p:column>
				<p:inputText id="idAge" label="Age"
					value="#{salesBean.customerVO.personVO.age}" size="3"
					readonly="true" />
			</p:column>
		</p:row>

		<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
			<p:column style="display:none">
				<h:outputLabel for="idUPoint">One Card Point</h:outputLabel>
			</p:column>
			<p:column style="display:none">
				<p:inputText id="idUPoint" label="One Card Point"
					value="#{salesBean.customerVO.personVO.uPoint}" size="5" />
			</p:column>
			<p:column style="display:none">
				<h:outputLabel for="idApplePoint">Apple Voucher Point</h:outputLabel>
			</p:column>
			<p:column style="display:none">
				<p:inputText id="idApplePoint" label="Apple Voucher Point"
					value="#{salesBean.customerVO.personVO.applePoint}" size="5" />
			</p:column>
		</p:row>

		<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
			<p:column>
				<h:outputLabel for="idSpokenLanguageList">Spoken Language</h:outputLabel>
			</p:column>
			<p:column>
				<p:selectCheckboxMenu id="idSpokenLanguageList"
					style="vertical-align:middle"
					value="#{salesBean.customerVO.langCdList}" label="Spoken Language"
					filter="true" filterMatchMode="contains"
					onHide="executeOnLanguageOnhide();">
					<f:selectItems value="#{bterp:lookupItemList('lang_dilc')}"
						var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
				</p:selectCheckboxMenu>
				<p:remoteCommand name="executeOnLanguageOnhide"
					actionListener="#{salesBean.handleLanguageChange}"
					update=":idAddCustForm:idLanguageName"
					process="@this, :idAddCustForm:idSpokenLanguageList"
					global="false" />
			</p:column>
			<p:column>
				<h:outputLabel for="idRace">Race</h:outputLabel>
			</p:column>
			<p:column>
				<h:selectOneMenu id="idRace" label="Race"
					value="#{salesBean.customerVO.personVO.race}">
					<f:selectItem itemLabel="Select One" itemValue="" />
					<f:selectItems value="#{bterp:lookupItemList('race_type')}"
						var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}" />
				</h:selectOneMenu>
			</p:column>
		</p:row>

		<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
			<p:column>
				<h:outputLabel />
			</p:column>
			<p:column>
				<h:outputText id="idLanguageName" value="#{salesBean.customerVO.languageName}" style="font-size:8px;"></h:outputText>
			</p:column>
			<p:column>
				<h:outputLabel />
			</p:column>
			<p:column style="width:100px"></p:column>
		</p:row>

		<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
			<p:column colspan="4">
				<p:panel id="idPanelPic" header="Person in Charge" toggleable="true">
					<p:panelGrid>
						<p:row>
							<p:column>
								<p:commandButton value="Add" actionListener="#{salesBean.addPic}" update=":idAddCustForm:idPanelPic" process="@this" global="false"/>
							</p:column>
						</p:row>
						<p:row>
							<p:column>
								<p:fieldset id="idPicPrimary" legend="Primary PIC">
									<p:panelGrid>
										<p:row>
											<p:column>
												<h:outputLabel for="idSalutatePIC">Salutation <span class="required">*</span>
												</h:outputLabel>
											</p:column>
											<p:column>
												<h:selectOneMenu id="idSalutatePIC" label="Salutation" value="#{salesBean.customerVO.personVO.salutation}" required="true">
													<p:ajax event="change" global="false"/>
													<f:selectItem itemLabel="Select One" itemValue="" />
													<f:selectItems value="#{bterp:lookupItemList('salutatn2')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
												</h:selectOneMenu>
											</p:column>
											<p:column>
												<h:outputLabel for="idTitlePIC">Title</h:outputLabel>
											</p:column>
											<p:column>
												<h:selectOneMenu id="idTitlePIC" label="Title" value="#{salesBean.customerVO.personVO.title}">
													<p:ajax event="change" global="false"/>
													<f:selectItem itemLabel="Select One" itemValue="" />
													<f:selectItems value="#{bterp:lookupItemList('salutatn')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
												</h:selectOneMenu>
											</p:column>
										</p:row>
										<p:row>
											<p:column>
												<h:outputLabel for="idLastNamePIC">SurName <span class="required">*</span>
												</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idLastNamePIC" label="SurName" value="#{salesBean.customerVO.personVO.lastName}" required="true" validatorMessage="SurName cannot be empty or just spaces">
													<p:ajax event="change" global="false"/>
													<f:validateRegex pattern=".*\S.*" />
												</p:inputText>
											</p:column>
											<p:column>
												<h:outputLabel for="idGenderPIC">Gender</h:outputLabel>
											</p:column>
											<p:column>
												<h:selectOneMenu id="idGenderPIC" label="Gender" value="#{salesBean.customerVO.personVO.sex}">
													<p:ajax event="change" global="false"/>
													<f:selectItem itemLabel="Select One" itemValue="" />
													<f:selectItems value="#{bterp:lookupItemList('gender_type')}"
														var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}" />
												</h:selectOneMenu>
											</p:column>
										</p:row>
										<p:row>
											<p:column>
												<h:outputLabel for="idGivenNamePIC">Given Name <span class="required">*</span>
												</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idGivenNamePIC" label="Given Name" value="#{salesBean.customerVO.personVO.givenName}" required="true" validatorMessage="Given Name cannot be empty or just spaces">
													<p:ajax event="change" global="false"/>
													<f:validateRegex pattern=".*\S.*" />
												</p:inputText>
											</p:column>
											<p:column>
												<h:outputLabel for="idNickNamePIC">NickName</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idNickNamePIC" label="NickName" value="#{salesBean.customerVO.personVO.nickName}">
													<p:ajax event="change" global="false"/>
												</p:inputText>
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:fieldset>
							</p:column>
						</p:row>
						<c:forEach var="picVO" items="#{salesBean.customerVO.corPicList}" varStatus="loop">
							<p:row>
								<p:column>
									<p:fieldset id="idPic#{loop.index}" legend="PIC #{loop.index + 1}">
										<p:panelGrid>
											<p:row>
												<p:column>
													<h:outputLabel for="idSalutatePIC#{loop.index}">Salutation <span class="required">*</span></h:outputLabel>
												</p:column>
												<p:column>
													<h:selectOneMenu id="idSalutatePIC#{loop.index}" label="Salutation" value="#{picVO.salutation}" required="true">
														<p:ajax event="change" global="false"/>
														<f:selectItem itemLabel="Select One" itemValue="" />
														<f:selectItems value="#{bterp:lookupItemList('salutatn2')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
													</h:selectOneMenu>
													&nbsp;
													<p:commandButton icon="ui-icon-close" value="Remove" styleClass="ui-state-error" actionListener="#{salesBean.deletePic(picVO)}" update=":idAddCustForm:idPanelPic" process="@this"/>
												</p:column>
												<p:column>
													<h:outputLabel for="idTitlePIC#{loop.index}">Title</h:outputLabel>
												</p:column>
												<p:column>
													<h:selectOneMenu id="idTitlePIC#{loop.index}" label="Title" value="#{picVO.title}">
														<p:ajax event="change" global="false"/>
														<f:selectItem itemLabel="Select One" itemValue="" />
														<f:selectItems value="#{bterp:lookupItemList('salutatn')}" var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
													</h:selectOneMenu>
												</p:column>
											</p:row>
											<p:row>
												<p:column>
													<h:outputLabel for="idLastNamePIC#{loop.index}">SurName <span class="required">*</span>
													</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idLastNamePIC#{loop.index}" label="SurName" value="#{picVO.lastName}" required="true">
														<p:ajax event="change" global="false"/>
													</p:inputText>
												</p:column>
												<p:column>
													<h:outputLabel for="idGenderPIC#{loop.index}">Gender</h:outputLabel>
												</p:column>
												<p:column>
													<h:selectOneMenu id="idGenderPIC#{loop.index}" label="Gender" value="#{picVO.sex}">
														<p:ajax event="change" global="false"/>
														<f:selectItem itemLabel="Select One" itemValue="" />
														<f:selectItems value="#{bterp:lookupItemList('gender_type')}"
															var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}" />
													</h:selectOneMenu>
												</p:column>
											</p:row>
											<p:row>
												<p:column>
													<h:outputLabel for="idGivenNamePIC#{loop.index}">Given Name <span class="required">*</span>
													</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idGivenNamePIC#{loop.index}" label="Given Name" value="#{picVO.givenName}" required="true">
														<p:ajax event="change" global="false"/>
													</p:inputText>
												</p:column>
												<p:column>
													<h:outputLabel for="idNickNamePIC#{loop.index}">NickName</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idNickNamePIC#{loop.index}" label="NickName" value="#{picVO.nickName}">
														<p:ajax event="change" global="false"/>
													</p:inputText>
												</p:column>
											</p:row>
											<p:row>
												<p:column>
													<h:outputLabel for="idOfficeNoPIC#{loop.index}">Office No</h:outputLabel>
												</p:column>
												<p:column colspan="3">
													<p:inputText id="idOfficeNoPIC#{loop.index}" label="Office No" value="#{picVO.officeNo}" maxlength="14" onkeypress="return rtnPhoneNo(event);">
														<p:ajax event="change" global="false"/>
														<p:watermark for="idOfficeNoPIC#{loop.index}" value="Number"/>
													</p:inputText>
													<h:outputLabel for="idOfficeExtPIC#{loop.index}">Ext </h:outputLabel>
													<p:inputText id="idOfficeExtPIC#{loop.index}" label="Office Extension" value="#{picVO.officeExt}" size="4" maxlength="4">
														<pe:keyFilter regEx="/[\d]/"/>
														<p:ajax event="change" global="false"/>
													</p:inputText>
												</p:column>
											</p:row>
											<p:row>
												<p:column>
													<h:outputLabel for="idEmailPIC#{loop.index}">Email Address</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idEmailPIC#{loop.index}" label="Email Address" value="#{picVO.email}" maxlength="50" validatorMessage="Invalid email format">
														<p:ajax event="change" global="false"/>
														<f:validateRegex pattern="#{config['email.format.pattern']}" />
													</p:inputText>
												</p:column>
												<p:column>
													<h:outputLabel for="idMobileNoPIC#{loop.index}">Mobile No</h:outputLabel>
												</p:column>
												<p:column>
													<p:inputText id="idMobileNoPIC#{loop.index}" label="Mobile No" value="#{picVO.mobileNo}" maxlength="14" onkeypress="return rtnPhoneNo(event);">
														<p:ajax event="change" global="false"/>
														<p:watermark for="idMobileNoPIC#{loop.index}" value="Number"/>
													</p:inputText>
												</p:column>
											</p:row>
										</p:panelGrid>
									</p:fieldset>
								</p:column>
							</p:row>
						</c:forEach>
					</p:panelGrid>
				</p:panel>
			</p:column>
		</p:row>

		<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
			<p:column colspan="4">
				<p:panel id="idPanelPerContact" header="Contact" toggleable="true">
					<p:panelGrid>
						<p:row>
							<p:column>
								<p:panel header="Mobile No">
									<p:panelGrid>
										<p:row>
											<p:column>
												<h:outputLabel for="idNumber">Number
											</h:outputLabel>
											</p:column>
											<p:column>
												<!-- <p:inputText id="idMobileAreaCode" label="Area Code"
												value="#{salesBean.personContactVO.perMobileAreaCode}"
												required="true" maxlength="5" size="5"
												onkeypress="return rtnPhoneNo(event);">
												<p:watermark for="idMobileAreaCode" value="Ext" />
												<f:validateLength maximum="5" />
											</p:inputText> -->
												<!-- <h:outputLabel> - </h:outputLabel> -->
												<p:inputText id="idMobileNumber" label="Mobile Number"
													value="#{salesBean.personContactVO.perMobileNumber}"
													maxlength="14" size="20"
													onkeypress="return rtnPhoneNo(event);">
													<p:watermark for="idMobileNumber" value="Number" />
													<f:validateLength maximum="14" minimum="8" />
												</p:inputText>
											</p:column>
										</p:row>
										<p:row>
											<p:column>
												<h:outputLabel for="idMobileAtt">Attention</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idMobileAtt" label="Attention"
													value="#{salesBean.personContactVO.perMobileAttention}"
													maxlength="100" />
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:panel>
							</p:column>
							<p:column>
								<p:panel header="Office No">
									<p:panelGrid>
										<p:row>
											<p:column>
												<h:outputLabel for="idNumber">Number
											</h:outputLabel>
											</p:column>
											<p:column>
												<!-- <p:inputText id="idOfficeAreaCode" label="Area Code"
												value="#{salesBean.personContactVO.perOfficeAreaCode}"
												required="true" maxlength="5" size="5"
												onkeypress="return rtnPhoneNo(event);">
												<p:watermark for="idOfficeAreaCode" value="Ext" />
												<f:validateLength maximum="5" />
											</p:inputText> -->
												<!-- <h:outputLabel> - </h:outputLabel> -->
												<p:inputText id="idOfficeNumber" label="Office Number"
													value="#{salesBean.personContactVO.perOfficeNumber}"
													maxlength="14" size="20"
													onkeypress="return rtnPhoneNo(event);">
													<p:watermark for="idOfficeNumber" value="Number" />
													<f:validateLength maximum="14" minimum="8"/>
												</p:inputText>
											</p:column>
										</p:row>
										<p:row>
											<p:column>
												<h:outputLabel for="idOfficeAtt">Attention</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idOfficeAtt" label="Attention"
													value="#{salesBean.personContactVO.perOfficeAttention}"
													maxlength="100" />
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:panel>
							</p:column>
						</p:row>
						<p:row>
							<p:column>
								<p:panel header="Home No">
									<p:panelGrid>
										<p:row>
											<p:column>
												<h:outputLabel for="idNumber">Number
											</h:outputLabel>
											</p:column>
											<p:column>
												<!-- <p:inputText id="idHomeAreaCode" label="Area Code"
												value="#{salesBean.personContactVO.perHomeAreaCode}"
												required="true" maxlength="5" size="5"
												onkeypress="return rtnPhoneNo(event);">
												<p:watermark for="idHomeAreaCode" value="Ext" />
												<f:validateLength maximum="5" />
											</p:inputText> -->
												<!-- <h:outputLabel> - </h:outputLabel> -->
												<p:inputText id="idHomeNumber" label="Home Number"
													value="#{salesBean.personContactVO.perHomeNumber}"
													maxlength="14" size="20"
													onkeypress="return rtnPhoneNo(event);">
													<p:watermark for="idHomeNumber" value="Number" />
													<f:validateLength maximum="14" minimum="8"/>
												</p:inputText>
											</p:column>
										</p:row>
										<p:row>
											<p:column>
												<h:outputLabel for="idHomeAtt">Attention</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idHomeAtt" label="Attention"
													value="#{salesBean.personContactVO.perHomeAttention}"
													maxlength="100" />
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:panel>
							</p:column>
							<p:column>
								<p:panel header="Fax No">
									<p:panelGrid>
										<p:row>
											<p:column>
												<h:outputLabel for="idNumber">Number
											</h:outputLabel>
											</p:column>
											<p:column>
												<!-- <p:inputText id="idFaxAreaCode" label="Area Code"
												value="#{salesBean.personContactVO.perFaxAreaCode}"
												required="true" maxlength="5" size="5"
												onkeypress="return rtnPhoneNo(event);">
												<p:watermark for="idFaxAreaCode" value="Ext" />
												<f:validateLength maximum="5" />
											</p:inputText> -->
												<!-- <h:outputLabel> - </h:outputLabel> -->
												<p:inputText id="idFaxNumber" label="Fax Number"
													value="#{salesBean.personContactVO.perFaxNumber}"
													maxlength="14" size="20"
													onkeypress="return rtnPhoneNo(event);">
													<p:watermark for="idFaxNumber" value="Number" />
													<f:validateLength maximum="14" minimum="8" />
												</p:inputText>
											</p:column>
										</p:row>
										<p:row>
											<p:column>
												<h:outputLabel for="idFaxAtt">Attention</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idFaxAtt" label="Attention"
													value="#{salesBean.personContactVO.perFaxAttention}"
													maxlength="100" />
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:panel>
							</p:column>
						</p:row>
						
						<p:row>
							<p:column colspan="2">
								<p:panel id="idPanelEmail" header="Email" toggleable="true">
									<p:panelGrid>
										<p:row>
											<p:column>
												<h:outputLabel for="idEmail">Primary Email </h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idEmail" label="Email"
													value="#{salesBean.customerVO.personVO.email}" readonly="true"
													style="background:#ccc;" size="40" />	
											</p:column>
										</p:row>
					
										<p:row>
											<p:column>
												<p:commandButton value="Email List"
													actionListener="#{salesBean.setEmailAdd(true)}"
													oncomplete="varCustEmailDialog.show()"
													update=":idCustEmailDialog" process="@this" />
											</p:column>
											<p:column colspan="3">
												<p:panel id="idEmailListPanel" style="border:none">
													<p:dataTable id="idEmailListTable"
														value="#{salesBean.customerVO.personVO.emailList}"
														var="emailVO"
														rendered="#{not empty salesBean.customerVO.personVO.emailList}">
														<p:column headerText="Edit"
															style="width:50px; text-align:center;">
															<p:commandButton icon="ui-icon-pencil"
																actionListener="#{salesBean.onEmailSelected(emailVO)}"
																oncomplete="varCustEmailDialog.show()" process="@this"
																update=":idCustEmailDialog"
																disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock and emailVO.isPrimary}"/>
														</p:column>
														<p:column headerText="Delete"
															style="width:50px; text-align:center;">
															<p:commandButton icon="ui-icon-close"
																actionListener="#{salesBean.deleteEmail(emailVO)}"
																update=":idAddCustForm:idEmailListPanel,:idAddCustForm:idEmailListTable,:idAddCustForm:idEmail"
																process="@this"
																disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock and emailVO.isPrimary}"/>
														</p:column>
														<p:column headerText="Email">
															<h:outputText value="#{emailVO.email}" />
														</p:column>
														<p:column headerText="Primary Email" style="text-align:center;">
															<h:outputText value="Y" rendered="#{emailVO.isPrimary}" />
															<h:outputText value="N" rendered="#{not emailVO.isPrimary}" />
														</p:column>
													</p:dataTable>
												</p:panel>
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:panel>
							</p:column>
						</p:row>
						
						<p:row>
							<p:column colspan="2">
								<p:panel id="idPanelEmergencyContact" header="Emergency Contact" toggleable="true">
									<p:panelGrid>
										<p:row>
											<p:column>
												<h:outputLabel for="idECSurName">SurName </h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idECSurName" label="Emergency Contact SurName"
													value="#{salesBean.customerVO.personVO.ecSurname}" maxlength="50" />
											</p:column>
											<p:column>
												<h:outputLabel for="idECGivenName">Given Name </h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idECGivenName" label="Emergency Contact Given Name"
													value="#{salesBean.customerVO.personVO.ecGivenName}" maxlength="50" />
											</p:column>
										</p:row>
										
										<p:row>
											<p:column>
												<h:outputLabel for="idNumber">Contact Number </h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idECContacts" label="Number"
													value="#{salesBean.customerVO.personVO.ecContacts}"
													maxlength="14" size="20"
													onkeypress="return rtnPhoneNo(event);">
													<p:watermark for="idECContacts" value="Number" />
													<f:validateLength maximum="14" />
												</p:inputText>
											</p:column>
											<p:column>
												<h:outputLabel for="idECRelationship">Relationship </h:outputLabel>
											</p:column>
											<p:column>
												<h:selectOneMenu id="idECRelationship" label="Emergency Contact Relationship"
													value="#{salesBean.customerVO.personVO.ecRelationship}">
													<f:selectItem itemLabel="Select One" itemValue="" />
													<f:selectItems value="#{bterp:lookupItemList('emergency_relationship')}"
														var="vo" itemLabel="#{vo.description}" itemValue="#{vo.code}" />
												</h:selectOneMenu>
											</p:column>
										</p:row>
				
										<p:row>
											<p:column>
												<h:outputLabel for="idECEmail">Email </h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idECEmail" label="Emergency Contact Email"
													value="#{salesBean.customerVO.personVO.ecEmail}" maxlength="200" size="40" />
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:panel>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:panel>
			</p:column>
		</p:row>

		<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
			<p:column colspan="4">
				<p:panel id="idPanelTravelDoc" header="Travel Document" toggleable="true">
					<p:panelGrid>
						<p:row>
							<p:column>
								<h:outputLabel for="idPssprtNo">Passport No</h:outputLabel>
							</p:column>
							<p:column>
								<p:inputText id="idPssprtNo" label="Passport No" value="#{salesBean.passportIdVO.idNo}" maxlength="20" onkeypress="return rtnAlphaNumeric(event);"/>
							</p:column>
							<p:column>
								<h:outputLabel for="idPssprtDtExp">Date of Expiry</h:outputLabel>
							</p:column>
							<p:column>
								<p:calendar id="idPssprtDtExp" label="Date of Expiry" value="#{salesBean.passportIdVO.identityDetailVO.dtExpired}" navigator="true" showButtonPanel="true" yearRange="c-10:c+10" pattern="dd-MMM-yyyy"/>
							</p:column>
						</p:row>
						<p:row>
							<p:column>
								<h:outputLabel for="idNPssprtNationality">Nationality</h:outputLabel>
							</p:column>
							<p:column>
								<h:selectOneMenu id="idNPssprtNationality" label="Nationality" value="#{salesBean.passportIdVO.identityDetailVO.idCountry}"
									style="width:180px;">  
									<f:selectItem itemLabel="Select One" itemValue="" />  
									<f:selectItems value="#{salesBean.countryList}" var="vo" itemLabel="#{vo.country}" itemValue="#{vo.id}" />  
					            </h:selectOneMenu>
							</p:column>
						</p:row>
						<p:row>
							<p:column>
								<h:outputLabel>Scanned Copy</h:outputLabel>
							</p:column>
					        <p:column colspan="3">
								<p:panelGrid id="idPassportScannedCopy" style="border:0">
									<p:row rendered="#{empty salesBean.passportIdVO.uploadedFile}">
										<p:column>
											<p:fileUpload id="idScannedCopy" fileUploadListener="#{salesBean.handleFileUploadPassport}" mode="advanced" auto="true" sizeLimit="#{bterp:globalConfigValue('GLOBAL', 'PATH_PDF_FILE_SIZE')}" allowTypes="/(\.|\/)(pdf|jpg|jpeg|png)$/" description="*.pdf;*.jpg;*.jpeg" update="msg, :idAddCustForm:idPassportScannedCopy" oncomplete="varStatusDialog.hide()"/>
										</p:column>
									</p:row>
									<p:row rendered="#{not empty salesBean.passportIdVO.uploadedFile}">
										<p:column style="width:15px;"><p:commandLink styleClass="ui-icon ui-icon-close" onclick="varDelScannedPassportDialog.show()"/></p:column>
										<p:column>
											<h:outputText value="#{salesBean.passportIdVO.identityDetailVO.scannedPath}" rendered="#{empty salesBean.passportIdVO.identityDetailVO.id}"/>
											<h:outputLink target="_blank" value="#{request.contextPath}#{salesBean.destinationPassportPath}/#{salesBean.passportIdVO.identityDetailVO.filePath}" rendered="#{not empty salesBean.passportIdVO.identityDetailVO.id}">
												<h:outputText value="#{salesBean.passportIdVO.identityDetailVO.scannedPath}"/>
											</h:outputLink>
										</p:column>
									</p:row>
								</p:panelGrid>
							</p:column>
						</p:row>
						<p:row>
							<p:column>
								<p:commandButton value="Add ID"
									actionListener="#{salesBean.setIdentityAdd(true)}"
									update=":idIDDialog" oncomplete="varIDDialog.show()"
									immediate="true" />
								<span class="required"> *</span>
							</p:column>
							<p:column colspan="3">
								<p:panel id="idIDListPanel" style="border:none">
									<p:dataTable id="idIDListTable"
										value="#{salesBean.customerVO.identityList}" var="identityVO"
										rowKey="#{identityVO.idNo}" selectionMode="single"
										rendered="#{not empty salesBean.customerVO.identityList}">
										
										<p:column headerText="Edit"
											style="width:50px; text-align:center;">
											<p:commandButton icon="ui-icon-pencil"
												actionListener="#{salesBean.onIdentitySelected(identityVO)}"
												oncomplete="varIDDialog.show()" process="@this"
												update=":idIDDialog" rendered="#{identityVO.id eq null or not (salesBean.passportIdVO.id eq identityVO.id or salesBean.nricIdVO.id eq identityVO.id)}"/>
										</p:column>
										<p:column headerText="Delete"
											style="width:50px; text-align:center;">
											<p:commandButton icon="ui-icon-close"
												actionListener="#{salesBean.deleteIdentity(identityVO)}"
												update=":idAddCustForm:idIDListPanel" process="@this"
												rendered="#{identityVO.id eq null or not (salesBean.passportIdVO.id eq identityVO.id or salesBean.nricIdVO.id eq identityVO.id)}"/>
										</p:column>
										<p:column headerText="ID Type">
											<h:outputText
												value="#{bterp:lookupItemDesc('id_type', identityVO.idType)}" />
										</p:column>
										<p:column headerText="ID No">
											<h:outputText value="#{identityVO.idNo}" />
										</p:column>
										<p:column headerText="Age" style="text-align:center;">
											<h:outputText value="#{salesBean.calculateAgeByIdNo(identityVO.idNo)}" rendered="#{identityVO.idType == 'nric'}"/>
										</p:column>
										<p:column headerText="Expired Date" style="text-align:center;">
											<h:outputText value="#{identityVO.identityDetailVO.dtExpired}" rendered="#{not empty identityVO.identityDetailVO.dtExpired}">
												<f:convertDateTime pattern="dd-MMM-yyyy" />
											</h:outputText>
										</p:column>
										<p:column headerText="Attactment" style="width:80px; text-align:center;">
											<h:outputLink id="idTTIDAttachment" target="_blank" value="#{request.contextPath}#{identityVO.idType == 'visa' ? salesBean.destinationVisaPath : salesBean.destinationPassportPath}/#{identityVO.identityDetailVO.filePath}"
												style="color: #db3333;text-decoration: underline;"
												rendered="#{not empty identityVO.identityDetailVO.scannedPath and not empty identityVO.identityDetailVO.filePath}">
												<h:outputText value="View"/>
											</h:outputLink>
											<pe:tooltip for="idTTIDAttachment" shared="true" showDelay="3000"  position="top right"
												rendered="#{not empty identityVO.identityDetailVO.scannedPath and not empty identityVO.identityDetailVO.filePath}">
												<h:outputText value="#{identityVO.identityDetailVO.scannedPath}" escape="true" style="white-space: pre-wrap"/>
											</pe:tooltip>
										</p:column>
									</p:dataTable>
								</p:panel>
							</p:column>
						</p:row>
						
						<p:row>
							<p:column>
								<p:commandButton value="Vaccination Cert"
									actionListener="#{salesBean.resetAttachmentForm}"
									update=":idAttachmentDialog" oncomplete="varAttachmentDialog.show()"
									immediate="true" disabled="#{salesBean.customerVO.id == null}"/>
							</p:column>
							<p:column colspan="3">
								<p:panel id="idAttachmentListPanel" style="border:none">
									<p:dataTable id="idAttachmentListTable"
										value="#{salesBean.customerVO.personAttachmentList}" var="attachmentVO"
										rowKey="#{attachmentVO.id}" selectionMode="single"
										rendered="#{not empty salesBean.customerVO.personAttachmentList}">
										
										<p:column headerText="Delete" style="width:50px; text-align:center;">
											<p:commandButton icon="ui-icon-close" actionListener="#{salesBean.setPersonAttachmentVO(attachmentVO)}" oncomplete="varDelAttachmentDialog.show()" process="@this"/>
										</p:column>
										<p:column headerText="Attachment Type">
											<p:outputLabel value="#{bterp:lookupItemDesc('cust_attachment_type', attachmentVO.typeCd)}"/>
										</p:column>
										
										<p:column headerText="File Path">
											<h:outputLink target="_blank" value="#{request.contextPath}#{salesBean.destinationAttachmentPath}/#{attachmentVO.filePath}" style="color: #db3333;text-decoration: underline;margin-right: 10px;">
												<h:outputText value="#{attachmentVO.scannedPath}"/>
											</h:outputLink>
										</p:column>
									</p:dataTable>
								</p:panel>
							</p:column>
						</p:row>
						
						<p:row>
							<p:column>
								<h:outputLabel for="idComplicationType">Complication</h:outputLabel>
							</p:column>
							<p:column>
								<p:selectCheckboxMenu id="idComplicationType"
									style="vertical-align:middle"
									value="#{salesBean.customerVO.compliList}" label="Complication"
									filter="true" filterMatchMode="contains"
									onHide="executeOnComplicationOnhide();">
									<f:selectItems value="#{bterp:lookupItemList('cust_cmpl')}"
										var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
								</p:selectCheckboxMenu>
								<p:remoteCommand name="executeOnComplicationOnhide"
									actionListener="#{salesBean.handleComplicationChange}"
									update=":idAddCustForm:idComplicationName"
									process="@this, :idAddCustForm:idComplicationType" global="false" />
							</p:column>
							<p:column>
								<h:outputLabel for="idMealList">Add Meals</h:outputLabel>
							</p:column>
							<p:column>
								<p:selectCheckboxMenu id="idMealList" style="vertical-align:middle"
									value="#{salesBean.customerVO.mealList}" label="Add Meals"
									filter="true" filterMatchMode="contains"
									onHide="executeOnMealOnhide();">
									<f:selectItems value="#{bterp:lookupItemList('meal_pref')}"
										var="vo" itemValue="#{vo.code}" itemLabel="#{vo.description}" />
								</p:selectCheckboxMenu>
								<p:remoteCommand name="executeOnMealOnhide"
									actionListener="#{salesBean.handleMealChange}"
									update=":idAddCustForm:idMealName"
									process="@this, :idAddCustForm:idMealList" global="false" />
							</p:column>
						</p:row>
						<p:row>
							<p:column></p:column>
							<p:column>
								<h:outputText id="idComplicationName"
									value="#{salesBean.customerVO.complicationName}" style="font-size:8px;"></h:outputText>
							</p:column>
							<p:column></p:column>
							<p:column>
								<h:outputText id="idMealName"
									value="#{salesBean.customerVO.mealName}" style="font-size:8px;"></h:outputText>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:panel>
			</p:column>
		</p:row>

		<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
			<p:column colspan="4">
				<p:panel id="idPanelCorContact" header="Contact" toggleable="true">
					<p:panelGrid>
						<p:row>
							<p:column>
								<p:panel header="Mobile No">
									<p:panelGrid>
										<p:row>
											<p:column>
												<h:outputLabel for="idNumber">Number
											</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorMobileNumber" label="Mobile Number"
													value="#{salesBean.corContactVO.corMobileNo}"
													maxlength="14" size="20"
													onkeypress="return rtnPhoneNo(event);">
													<p:watermark for="idCorMobileNumber" value="Number" />
													<f:validateLength maximum="14" minimum="8"/>
												</p:inputText>
											</p:column>
										</p:row>
										<p:row>
											<p:column>
												<h:outputLabel for="idCorMobileAtt">Attention</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorMobileAtt" label="Attention"
													value="#{salesBean.corContactVO.corMobileAttn}"
													maxlength="100" />
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:panel>
							</p:column>
							<p:column>
								<p:panel header="Office No">
									<p:panelGrid>
										<p:row>
											<p:column>
												<h:outputLabel for="idNumber">Number
											</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorOfficeNumber" label="Office Number"
													value="#{salesBean.corContactVO.corOfficeNo}"
													maxlength="14" size="20"
													onkeypress="return rtnPhoneNo(event);">
													<p:watermark for="idCorOfficeNumber" value="Number" />
													<f:validateLength maximum="14" minimum="8"/>
												</p:inputText>
											</p:column>
										</p:row>
										<p:row>
											<p:column>
												<h:outputLabel for="idCorOfficeAtt">Attention</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorOfficeAtt" label="Attention"
													value="#{salesBean.corContactVO.corOfficeAttn}"
													maxlength="100" />
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:panel>
							</p:column>
						</p:row>
						<p:row>
							<p:column>
								<p:panel header="Home No">
									<p:panelGrid>
										<p:row>
											<p:column>
												<h:outputLabel for="idNumber">Number
											</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorHomeNumber" label="Home Number"
													value="#{salesBean.corContactVO.corHomeNo}" maxlength="14"
													size="20" onkeypress="return rtnPhoneNo(event);">
													<p:watermark for="idCorHomeNumber" value="Number" />
													<f:validateLength maximum="14" minimum="8"/>
												</p:inputText>
											</p:column>
										</p:row>
										<p:row>
											<p:column>
												<h:outputLabel for="idCorHomeAtt">Attention</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorHomeAtt" label="Attention"
													value="#{salesBean.corContactVO.corHomeAttn}"
													maxlength="100" />
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:panel>
							</p:column>
							<p:column>
								<p:panel header="Fax No">
									<p:panelGrid>
										<p:row>
											<p:column>
												<h:outputLabel for="idNumber">Number
											</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorFaxNumber" label="Fax Number"
													value="#{salesBean.corContactVO.corFaxNo}" maxlength="14"
													size="20" onkeypress="return rtnPhoneNo(event);">
													<p:watermark for="idCorFaxNumber" value="Number" />
													<f:validateLength maximum="14" minimum="8"/>
												</p:inputText>
											</p:column>
										</p:row>
										<p:row>
											<p:column>
												<h:outputLabel for="idCorFaxAtt">Attention</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorFaxAtt" label="Attention"
													value="#{salesBean.corContactVO.corFaxAttn}"
													maxlength="100" />
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:panel>
							</p:column>
						</p:row>
						<p:row>
							<p:column colspan="2">
								<p:panel id="idPanelCorEmail" header="Email" toggleable="true">
									<p:panelGrid>
										<p:row>
											<p:column>
												<h:outputLabel for="idCorEmail">Primary Email </h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idCorEmail" label="Email"
													value="#{salesBean.customerVO.personVO.email}" readonly="true"
													style="background:#ccc;" size="40" />	
											</p:column>
										</p:row>
					
										<p:row>
											<p:column>
												<p:commandButton value="Email List"
													actionListener="#{salesBean.setEmailAdd(true)}"
													oncomplete="varCustEmailDialog.show()"
													update=":idCustEmailDialog" process="@this" />
											</p:column>
											<p:column colspan="3">
												<p:panel id="idCorEmailListPanel" style="border:none">
													<p:dataTable id="idCorEmailListTable"
														value="#{salesBean.customerVO.personVO.emailList}"
														var="emailVO"
														rendered="#{not empty salesBean.customerVO.personVO.emailList}">
														<p:column headerText="Edit"
															style="width:50px; text-align:center;">
															<p:commandButton icon="ui-icon-pencil"
																actionListener="#{salesBean.onEmailSelected(emailVO)}"
																oncomplete="varCustEmailDialog.show()" process="@this"
																update=":idCustEmailDialog"
																disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock and emailVO.isPrimary}"/>
														</p:column>
														<p:column headerText="Delete"
															style="width:50px; text-align:center;">
															<p:commandButton icon="ui-icon-close"
																actionListener="#{salesBean.deleteEmail(emailVO)}"
																update=":idAddCustForm:idCorEmailListPanel,:idAddCustForm:idCorEmailListTable,:idAddCustForm:idCorEmail"
																process="@this"
																disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock and emailVO.isPrimary}"/>
														</p:column>
														<p:column headerText="Email">
															<h:outputText value="#{emailVO.email}" />
														</p:column>
														<p:column headerText="Primary Email" style="text-align:center;">
															<h:outputText value="Y" rendered="#{emailVO.isPrimary}" />
															<h:outputText value="N" rendered="#{not emailVO.isPrimary}" />
														</p:column>
													</p:dataTable>
												</p:panel>
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:panel>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:panel>
			</p:column>
		</p:row>
		
		<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
			<p:column colspan="4">
				<p:panel id="idPanelPerAddress" header="Address" toggleable="true">
					<p:panelGrid>
						<p:row>
							<p:column>
								<p:panel id="idPanelBillAddress" header="Billing Address">
									<p:panelGrid>
										<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
											<p:column>
												<h:outputLabel for="idBillCompName">Company Name</h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idBillCompName" label="Company Name"
													value="#{salesBean.customerVO.billAddressVO.companyName}" size="50"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
										<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
											<p:column>
												<h:outputLabel for="idAdd1">Address Line 1 <span
														class="required">*</span>
												</h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idAdd1" label="Address Line 1"
													value="#{salesBean.customerVO.billAddressVO.addr1}" size="50"
													required="true"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
											<p:column>
												<h:outputLabel for="idAdd2">Address Line 2 </h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idAdd2" label="Address Line 2"
													value="#{salesBean.customerVO.billAddressVO.addr2}" size="50"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
											<p:column>
												<h:outputLabel for="idAdd3">Address Line 3 </h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idAdd3" label="Address Line 3"
													value="#{salesBean.customerVO.billAddressVO.addr3}" size="50"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
											<p:column>
												<h:outputLabel for="idCity">City <span
														class="required">*</span>
												</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCity" label="Billing Address - City" required="true"
													value="#{salesBean.customerVO.billAddressVO.city}" converter="trimConverter"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
											<p:column>
												<h:outputLabel for="idState">State <span
														class="required">*</span>
												</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idState" label="Billing Address - State" rendered="#{salesBean.customerVO.billAddressVO.countryId ne 129}"
													value="#{salesBean.customerVO.billAddressVO.state}"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
												<h:selectOneMenu id="idStateMalaysia" label="Billing Address - State" value="#{salesBean.customerVO.billAddressVO.state}" effect="fade" rendered="#{salesBean.customerVO.billAddressVO.countryId eq 129}"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}" required="true">
													<f:selectItem itemLabel="Select One" itemValue=""/>
													<f:selectItems value="#{salesBean.malaysiaStateList}" var="vo" itemLabel="#{vo.name}" itemValue="#{vo.name}"/>
												</h:selectOneMenu>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
											<p:column>
												<h:outputLabel for="idPostcode">Postcode <span
															class="required">*</span>
												</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idPostcode" label="Billing Address - Postcode"
													value="#{salesBean.customerVO.billAddressVO.postcode}" required="true"
													maxlength="#{salesBean.customerVO.billAddressVO.countryId == 129 ? 5 : 99}"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
												<pe:tooltip for="idPostcode" position="bottom left" rendered="#{salesBean.customerVO.billAddressVO.countryId == 129}">
													<h:outputText value="For Malaysian addresses, the postcode must not exceed 5 digits." escape="true"
														style="white-space: pre-wrap" />
												</pe:tooltip>
											</p:column>
											<p:column>
												<h:outputLabel for="idCountry">Country <span
														class="required">*</span>
												</h:outputLabel>
											</p:column>
											<p:column>
												<h:selectOneMenu id="idCountry" label="Country"
													value="#{salesBean.customerVO.billAddressVO.countryId}"
													required="true"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" listener="#{salesBean.handleBillAddressState}" update="idPanelBillAddress :idAddCustForm:idTaxIdNo" />
													<f:selectItem itemLabel="Select One" itemValue="" />
													<f:selectItems value="#{salesBean.countryList}" var="vo"
														itemLabel="#{vo.country}" itemValue="#{vo.id}" />
												</h:selectOneMenu>
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:panel>
							</p:column>
						</p:row>
						
						<p:row>
							<p:column>
								<p:panel id="idPanelMailAddress" header="Mailing Address" toggleable="true" collapsed="true">
									<p:ajax event="toggle" global="false"/>
									<p:panelGrid>
										<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
											<p:column>
												<h:outputLabel for="idMailCompName">Company Name</h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idMailCompName" label="Company Name"
													value="#{salesBean.customerVO.mailAddressVO.companyName}" size="50" >
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
										<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
											<p:column>
												<h:outputLabel for="idMailAdd1">Address Line 1</h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idMailAdd1" label="Address Line 1"
													value="#{salesBean.customerVO.mailAddressVO.addr1}" size="50">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
											<p:column>
												<h:outputLabel for="idMailAdd2">Address Line 2 </h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idMailAdd2" label="Address Line 2"
													value="#{salesBean.customerVO.mailAddressVO.addr2}" size="50" >
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
											<p:column>
												<h:outputLabel for="idMailAdd3">Address Line 3 </h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idMailAdd3" label="Address Line 3"
													value="#{salesBean.customerVO.mailAddressVO.addr3}" size="50" >
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
											<p:column>
												<h:outputLabel for="idMailCity">City </h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idMailCity" label="City"
													value="#{salesBean.customerVO.mailAddressVO.city}" >
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
											<p:column>
												<h:outputLabel for="idMailState">State </h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idMailState" label="State" rendered="#{salesBean.customerVO.mailAddressVO.countryId ne 129}"
													value="#{salesBean.customerVO.mailAddressVO.state}" >
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
												<h:selectOneMenu id="idMailStateMalaysia" label="State" value="#{salesBean.customerVO.mailAddressVO.state}" effect="fade" rendered="#{salesBean.customerVO.mailAddressVO.countryId eq 129}">
													<f:selectItem itemLabel="Select One" itemValue=""/>
													<f:selectItems value="#{salesBean.malaysiaStateList}" var="vo" itemLabel="#{vo.name}" itemValue="#{vo.name}"/>
												</h:selectOneMenu>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd != 'C'}">
											<p:column>
												<h:outputLabel for="idMailPostcode">Postcode </h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idMailPostcode" label="Postcode"
													value="#{salesBean.customerVO.mailAddressVO.postcode}" >
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
											<p:column>
												<h:outputLabel for="idMailCountry">Country</h:outputLabel>
											</p:column>
											<p:column>
												<h:selectOneMenu id="idMailCountry" label="Country"
													value="#{salesBean.customerVO.mailAddressVO.countryId}">
													<p:ajax event="change" listener="#{salesBean.handleMailAddressState}" update="idPanelMailAddress" />
													<f:selectItem itemLabel="Select One" itemValue="" />
													<f:selectItems value="#{salesBean.countryList}" var="vo"
														itemLabel="#{vo.country}" itemValue="#{vo.id}" />
												</h:selectOneMenu>
											</p:column>
										</p:row>
									</p:panelGrid>
									<f:facet name="actions">
							            <p:selectBooleanCheckbox id="idCopy" value="#{salesBean.deepCopy}" style="vertical-align:text-bottom;margin-left:367px">
											<p:ajax listener="#{salesBean.handleCopySelect}" update="idPanelMailAddress" process="@this, idPanelBillAddress" global="false"/>
										</p:selectBooleanCheckbox>
										<h:outputLabel>Same as billing address</h:outputLabel>
							        </f:facet>
								</p:panel>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:panel>
			</p:column>
		</p:row>
		
		<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
			<p:column colspan="4">
				<p:panel id="idPanelCorAddress" header="Address" toggleable="true">
					<p:panelGrid>
						<p:row>
							<p:column>
								<p:panel id="idPanelCorBillAddress" header="Billing Address">
									<p:panelGrid>
										<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
											<p:column>
												<h:outputLabel for="idCorpBillAdd1">Address Line 1 <span
														class="required">*</span>
												</h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idCorpBillAdd1" label="Address Line 1"
													value="#{salesBean.customerVO.corBillAddressVO.addr1}" size="50"
													required="true"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
											<p:column>
												<h:outputLabel for="idCorpBillAdd2">Address Line 2 </h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idCorpBillAdd2" label="Address Line 2"
													value="#{salesBean.customerVO.corBillAddressVO.addr2}" size="50"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
											<p:column>
												<h:outputLabel for="idCorpBillAdd3">Address Line 3 </h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idCorpBillAdd3" label="Address Line 3"
													value="#{salesBean.customerVO.corBillAddressVO.addr3}" size="50"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
											<p:column>
												<h:outputLabel for="idCorpBillCity">City <span
														class="required">*</span>
												</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorpBillCity" label="Billing Address - City" required="true"
													value="#{salesBean.customerVO.corBillAddressVO.city}"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
											<p:column>
												<h:outputLabel for="idCorpBillState">State <span
														class="required">*</span>
												</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorpBillState" label="Billing Address - State" rendered="#{salesBean.customerVO.corBillAddressVO.countryId ne 129}"
													value="#{salesBean.customerVO.corBillAddressVO.state}"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
												<h:selectOneMenu id="idCorpBillStateMalaysia" label="Billing Address - State" value="#{salesBean.customerVO.corBillAddressVO.state}" effect="fade" rendered="#{salesBean.customerVO.corBillAddressVO.countryId eq 129}"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}" required="true">
													<f:selectItem itemLabel="Select One" itemValue=""/>
													<f:selectItems value="#{salesBean.malaysiaStateList}" var="vo" itemLabel="#{vo.name}" itemValue="#{vo.name}"/>
												</h:selectOneMenu>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
											<p:column>
												<h:outputLabel for="idCorpBillPostcode">Postcode <span
														class="required">*</span>
												</h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorpBillPostcode" label="Billing Address - Postcode"
													value="#{salesBean.customerVO.corBillAddressVO.postcode}" required="true"
													maxlength="#{salesBean.customerVO.corBillAddressVO.countryId == 129 ? 5 : 99}"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
												<pe:tooltip for="idCorpBillPostcode" position="bottom left" rendered="#{salesBean.customerVO.corBillAddressVO.countryId == 129}">
													<h:outputText value="For Malaysian addresses, the postcode must not exceed 5 digits." escape="true"
														style="white-space: pre-wrap" />
												</pe:tooltip>
											</p:column>
											<p:column>
												<h:outputLabel for="idCorpBillCountry">Country <span
														class="required">*</span>
												</h:outputLabel>
											</p:column>
											<p:column>
												<h:selectOneMenu id="idCorpBillCountry" label="Country"
													value="#{salesBean.customerVO.corBillAddressVO.countryId}"
													required="true"
													disabled="#{not salesBean.customerVO.addEdit and salesBean.customerVO.isLock}">
													<p:ajax event="change" listener="#{salesBean.handleCorpBillAddressState}" 
														update="idPanelCorBillAddress idCorpBillCity :idAddCustForm:idRegNo :idAddCustForm:idCompanyTIN" />
													<f:selectItem itemLabel="Select One" itemValue="" />
													<f:selectItems value="#{salesBean.countryList}" var="vo"
														itemLabel="#{vo.country}" itemValue="#{vo.id}" />
												</h:selectOneMenu>
											</p:column>
										</p:row>
									</p:panelGrid>
								</p:panel>
							</p:column>
						</p:row>
						<p:row>
							<p:column>
								<p:panel id="idPanelCorMailAddress" header="Mailing Address" toggleable="true" collapsed="true">
									<p:ajax event="toggle" global="false"></p:ajax>
									<p:panelGrid>
										<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
											<p:column>
												<h:outputLabel for="idCorpMailAdd1">Address Line 1</h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idCorpMailAdd1" label="Address Line 1"
													value="#{salesBean.customerVO.corMailAddressVO.addr1}"
													size="50">
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
											<p:column>
												<h:outputLabel for="idCorpMailAdd2">Address Line 2 </h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idCorpMailAdd2" label="Address Line 2"
													value="#{salesBean.customerVO.corMailAddressVO.addr2}"
													size="50" >
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
											<p:column>
												<h:outputLabel for="idCorpMailAdd3">Address Line 3 </h:outputLabel>
											</p:column>
											<p:column colspan="3">
												<p:inputText id="idCorpMailAdd3" label="Address Line 3"
													value="#{salesBean.customerVO.corMailAddressVO.addr3}"
													size="50" >
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
											<p:column>
												<h:outputLabel for="idCorpMailCity">City </h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorpMailCity" label="City"
													value="#{salesBean.customerVO.corMailAddressVO.city}" >
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
											<p:column>
												<h:outputLabel for="idCorpMailState">State </h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorpMailState" label="State" rendered="#{salesBean.customerVO.corMailAddressVO.countryId ne 129}"
													value="#{salesBean.customerVO.corMailAddressVO.state}" >
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
												<h:selectOneMenu id="idCorpMailStateMalaysia" label="State" value="#{salesBean.customerVO.corMailAddressVO.state}" effect="fade" rendered="#{salesBean.customerVO.corMailAddressVO.countryId eq 129}">
													<f:selectItem itemLabel="Select One" itemValue=""/>
													<f:selectItems value="#{salesBean.malaysiaStateList}" var="vo" itemLabel="#{vo.name}" itemValue="#{vo.name}"/>
												</h:selectOneMenu>
											</p:column>
										</p:row>
				
										<p:row rendered="#{salesBean.customerVO.pcTypeCd == 'C'}">
											<p:column>
												<h:outputLabel for="idCorpMailPostcode">Postcode </h:outputLabel>
											</p:column>
											<p:column>
												<p:inputText id="idCorpMailPostcode" label="Postcode"
													value="#{salesBean.customerVO.corMailAddressVO.postcode}" >
													<p:ajax event="change" global="false"></p:ajax>
												</p:inputText>
											</p:column>
											<p:column>
												<h:outputLabel for="idCorpMailCountry">Country</h:outputLabel>
											</p:column>
											<p:column>
												<h:selectOneMenu id="idCorpMailCountry" label="Country"
													value="#{salesBean.customerVO.corMailAddressVO.countryId}">
													<p:ajax event="change" listener="#{salesBean.handleCorpMailAddressState}" update="idPanelCorMailAddress" />
													<f:selectItem itemLabel="Select One" itemValue="" />
													<f:selectItems value="#{salesBean.countryList}" var="vo"
														itemLabel="#{vo.country}" itemValue="#{vo.id}" />
												</h:selectOneMenu>
											</p:column>
										</p:row>
									</p:panelGrid>
									<f:facet name="actions">
								            <p:selectBooleanCheckbox value="#{salesBean.deepCopy}" style="vertical-align:text-bottom;margin-left:367px">
												<p:ajax listener="#{salesBean.handleCopySelect}" update="idPanelMailAddress, idPanelCorMailAddress" process="@this, idPanelBillAddress, idPanelCorBillAddress" global="false"/>
											</p:selectBooleanCheckbox>
											<h:outputLabel>Same as billing address</h:outputLabel>
								        </f:facet>
								</p:panel>
							</p:column>
						</p:row>
					</p:panelGrid>
				</p:panel>
			</p:column>
		</p:row>

		<p:row>
			<p:column>
				<h:outputLabel for="idRemarks">Notes</h:outputLabel>
			</p:column>
			<p:column colspan="3">
				<p:inputTextarea id="idRemarks" rows="10" cols="50"
					value="#{salesBean.remarksVO.remarksDetails}"></p:inputTextarea>
			</p:column>
		</p:row>
	</p:panelGrid>

	<h:panelGrid columns="3" style="width: 1px;">
		<p:commandButton value="#{msg['common.button.label.save']}"
			actionListener="#{salesBean.addCustomer}"
			update="@form,:idCustListForm:idCustListTable"
			rendered="#{salesBean.customerVO.addEdit}" />
		<p:commandButton value="#{msg['common.button.label.update']}"
			actionListener="#{salesBean.updateCustomer}"
			update="@form,:idCustListForm:idCustListTable"
			oncomplete="onValidation(xhr, status, args)"
			rendered="#{not salesBean.customerVO.addEdit}" />
		<p:commandButton value="Email Update Profile" style="width: 150px;"
			immediate="true"
			oncomplete="varConfirmSentCustomerProfileUpdateDialog.show()" />
		<p:commandButton value="#{msg['common.button.label.cancel']}"
			actionListener="#{salesBean.resetForm}"
			update="@form,:idCustListForm:idCustListTable" process="@this"
			oncomplete="varAddCustDialog.hide()">
			<pe:resetEditableValues for="idAddCustForm" />
		</p:commandButton>
	</h:panelGrid>

</ui:composition>