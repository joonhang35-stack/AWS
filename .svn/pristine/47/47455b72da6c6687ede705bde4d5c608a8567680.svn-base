	@Override
	public void insertInvoice(EInvoiceDocumentVO eInvoiceVO, InvoiceVO invoiceVO, String eInvoiceDocType) throws BusinessException {
		eInvoiceVO.setRefId(invoiceVO.getId());
		eInvoiceVO.setRefNo(invoiceVO.getCode());
		eInvoiceVO.seteInvoiceDocType(eInvoiceDocType);
		
		String sysCd = CommonConstant.SYS_NUM_CD_INVC;
		if (invoiceVO.getDocTypeCd().equals("C")) {
			sysCd = CommonConstant.SYS_NUM_CD_CRDT_NOTE;
		} else if (invoiceVO.getDocTypeCd().equals("P")) {
			sysCd = CommonConstant.SYS_NUM_CD_PAX_STMT;
		}
		
		eInvoiceVO.setSysDocType(sysCd);

		SystemNumberGenerationVO systemNumberGenerationVO = systemNumberGenerationDAO.getSystemNumberGeneration(sysCd, invoiceVO.getCompanyId());
		eInvoiceVO.setSysPrefix(systemNumberGenerationVO.getPrefixid());
		
		eInvoiceDAO.insert(eInvoiceVO);
	}
	
