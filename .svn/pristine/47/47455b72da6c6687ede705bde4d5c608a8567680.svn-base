	@Override
	public void insertDocumentDetails(InvoiceType invoiceType, EInvoiceDocumentVO eInvoiceDocumentVO) throws BusinessException {
		insertDocumentItems(invoiceType, eInvoiceDocumentVO.getId(), eInvoiceDocumentVO.getDocumentUuid());
		EInvoiceBuyerVO eInvoiceBuyerVO = insertEInvoiceBuyer(invoiceType.getAccountingCustomerParty().getParty(), eInvoiceDocumentVO.getId());
		EInvoiceSupplierVO eInvoiceSupplierVO = insertEInvoiceSupplier(invoiceType.getAccountingSupplierParty().getParty(), eInvoiceDocumentVO.getId());
	
		// for EInvoiceServiceImpl.process...
		eInvoiceDocumentVO.setIdEInvoiceBuyer(eInvoiceBuyerVO.getId());
		eInvoiceDocumentVO.setIdEInvoiceSupplier(eInvoiceSupplierVO.getId());
		
		// for EInvoiceUtils.process...
		eInvoiceDAO.updateEInvoiceParty(eInvoiceDocumentVO.getId(), null, null, eInvoiceBuyerVO.getId(), eInvoiceSupplierVO.getId());
		eInvoiceDAO.updateEInvoiceDocTypeCd(eInvoiceDocumentVO.getId(), invoiceType.getInvoiceTypeCodeValue());
	}
	
	/**
	 * insert E-Invoice line items
	 * @param invoiceType
	 * @param idEInvDoc
	 * @param docUuid
	 */
	private void insertDocumentItems(InvoiceType invoiceType, Long idEInvDoc, String docUuid) {
		for (InvoiceLineType lineType : invoiceType.getInvoiceLine()) {
			EInvoiceDocumentItemVO itemVO = new EInvoiceDocumentItemVO();
			itemVO.setIdEInvDoc(idEInvDoc);
			itemVO.setDocUuid(docUuid);
			itemVO.setClassCode(lineType.getItem().getCommodityClassificationAtIndex(0).getItemClassificationCodeValue());
			itemVO.setDesc(lineType.getItem().getDescriptionAtIndex(0).getValue());
			itemVO.setQuantity(lineType.getInvoicedQuantityValue().intValue());
			itemVO.setUnitPrice(lineType.getPrice().getPriceAmountValue().doubleValue());
			itemVO.setAmount(lineType.getItemPriceExtension().getAmountValue().doubleValue());
			
			itemVO.setStatusCode(CommonConstant.STATUS_CD_AVAILABLE);
						
			eInvoiceDAO.insert(itemVO);
		}
	}
	
	/**
	 * insert E-Invoice buyer details
	 * @param customerPartyType - invoiceType.getAccountingCustomerParty().getParty()
	 * @param idEInvDoc
	 * @return EInvoiceBuyerVO
	 */
	private EInvoiceBuyerVO insertEInvoiceBuyer(PartyType customerPartyType, Long idEInvDoc) {
		EInvoiceBuyerVO eInvoiceBuyerVO = new EInvoiceBuyerVO();
		eInvoiceBuyerVO.setIdEInvDoc(idEInvDoc);
		eInvoiceBuyerVO.setName(customerPartyType.getPartyLegalEntityAtIndex(0).getRegistrationNameValue());

		// TIN, SST & identity
		for (PartyIdentificationType pi : customerPartyType.getPartyIdentification()) {
			if (pi.getID().getSchemeID().equals("TIN")) {
				eInvoiceBuyerVO.setTin(pi.getIDValue());
			} else if (pi.getID().getSchemeID().equals("SST")) {
				eInvoiceBuyerVO.setSstRegNo(pi.getIDValue());
			} else {
				eInvoiceBuyerVO.setIdentityValue(pi.getIDValue());
				eInvoiceBuyerVO.setIdentityType(pi.getID().getSchemeID());
			}
		}
		
		// E-mail & Contact Number
		eInvoiceBuyerVO.setContactNo(customerPartyType.getContact().getTelephoneValue());
		eInvoiceBuyerVO.setEmail(customerPartyType.getContact().getElectronicMailValue());
		
		// Address
		AddressType addressType = customerPartyType.getPostalAddress();
		eInvoiceBuyerVO.setAddr1(addressType.getAddressLineAtIndex(0).getLineValue());
		if (addressType.getAddressLineCount() > 1)	eInvoiceBuyerVO.setAddr2(addressType.getAddressLineAtIndex(1).getLineValue());
		if (addressType.getAddressLineCount() > 2)	eInvoiceBuyerVO.setAddr3(addressType.getAddressLineAtIndex(2).getLineValue());
		
		eInvoiceBuyerVO.setPostcode(addressType.getPostalZoneValue());
		eInvoiceBuyerVO.setCity(addressType.getCityNameValue());
		eInvoiceBuyerVO.setState(addressType.getCountrySubentityCodeValue());
		eInvoiceBuyerVO.setCountry(addressType.getCountry().getIdentificationCodeValue());
		
		eInvoiceBuyerVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
		eInvoiceDAO.insert(eInvoiceBuyerVO);
		
		return eInvoiceBuyerVO;
	}
	
	/**
	 * insert E-Invoice supplier details
	 * @param supplierPartyType - invoiceType.getAccountingSupplierParty().getParty()
	 * @param idEInvDoc
	 * @return EInvoiceSupplierVO
	 */
	private EInvoiceSupplierVO insertEInvoiceSupplier(PartyType supplierPartyType, Long idEInvDoc) {
		EInvoiceSupplierVO eInvoiceSupplierVO = new EInvoiceSupplierVO();
		eInvoiceSupplierVO.setIdEInvDoc(idEInvDoc);
		eInvoiceSupplierVO.setName(supplierPartyType.getPartyLegalEntityAtIndex(0).getRegistrationNameValue());
		
		// TIN, SST & identity
		for (PartyIdentificationType pi : supplierPartyType.getPartyIdentification()) {
			if (pi.getID().getSchemeID().equals(EInvoiceConstant.E_INV_IDENTITY_TYPE_TIN)) {
				eInvoiceSupplierVO.setTin(pi.getIDValue());
			} else if (pi.getID().getSchemeID().equals(EInvoiceConstant.E_INV_IDENTITY_TYPE_SST)) {
				eInvoiceSupplierVO.setSstRegNo(pi.getIDValue());
			} else {
				eInvoiceSupplierVO.setIdentityValue(pi.getIDValue());
				eInvoiceSupplierVO.setIdentityType(pi.getID().getSchemeID());
			}
		}
		
		// E-mail & Contact Number
		eInvoiceSupplierVO.setContactNo(supplierPartyType.getContact().getTelephoneValue());
		eInvoiceSupplierVO.setEmail(supplierPartyType.getContact().getElectronicMailValue());
		
		// Address
		AddressType addressType = supplierPartyType.getPostalAddress();
		eInvoiceSupplierVO.setAddr1(addressType.getAddressLineAtIndex(0).getLineValue());
		if (addressType.getAddressLineCount() > 1)	eInvoiceSupplierVO.setAddr2(addressType.getAddressLineAtIndex(1).getLineValue());
		if (addressType.getAddressLineCount() > 2)	eInvoiceSupplierVO.setAddr3(addressType.getAddressLineAtIndex(2).getLineValue());
		
		eInvoiceSupplierVO.setPostcode(addressType.getPostalZoneValue());
		eInvoiceSupplierVO.setCity(addressType.getCityNameValue());
		eInvoiceSupplierVO.setState(addressType.getCountrySubentityCodeValue());
		eInvoiceSupplierVO.setCountry(addressType.getCountry().getIdentificationCodeValue());
		
		// MSIC Code & Business Desc
		eInvoiceSupplierVO.setMsicCode(supplierPartyType.getIndustryClassificationCodeValue());
		eInvoiceSupplierVO.setBusinessDesc(supplierPartyType.getIndustryClassificationCode().getName());
		
		eInvoiceSupplierVO.setStatusCode(CommonConstant.STATUS_CD_AVAILABLE);
		eInvoiceDAO.insert(eInvoiceSupplierVO);
		
		return eInvoiceSupplierVO;
	}
	
