	@Override 
	public void cancelEInvoiceDocument(String eInvoiceDocumentUuid) throws BusinessException {
		
		EInvoiceDocumentVO eInvoiceDocumentVO = getEInvoiceByUuid(eInvoiceDocumentUuid);
		
		if (eInvoiceDocumentVO != null) {
			
			// update doc_type e inv status
			updateEInvoiceStatus(eInvoiceDocumentUuid, EInvoiceConstant.E_INV_STATUS_CANCELLED, LookupItemUtils.getTableName(eInvoiceDocumentVO.getSysDocType()));

			// update eInvoiceDocumentVO
			eInvoiceDocumentVO.setStatusCode(EInvoiceConstant.E_INV_STATUS_CANCELLED);
			eInvoiceDAO.update(eInvoiceDocumentVO);
			
			// update consol inv
			if (eInvoiceDocumentVO.getIsConsolEInv()) {
				eInvoiceDAO.updateEInvoiceConsolidate(eInvoiceDocumentUuid, null, EInvoiceConstant.E_INV_STATUS_CANCELLED);
			}
		}
	}
	
	@Override 
	public void cancelEInvoiceRefundNote(String eInvoiceDocumentUuid) throws BusinessException {
		
		EInvoiceDocumentVO eInvoiceDocumentVO = getEInvoiceByUuid(eInvoiceDocumentUuid);
		
		if (eInvoiceDocumentVO != null) {
			// update doc_type e inv status
			invoiceDAO.updateRefundNoteEInvoiceStatus(eInvoiceDocumentUuid, EInvoiceConstant.E_INV_STATUS_CANCELLED);

			// update eInvoiceDocumentVO
			eInvoiceDocumentVO.setStatusCode(EInvoiceConstant.E_INV_STATUS_CANCELLED);
			eInvoiceDAO.update(eInvoiceDocumentVO);
		}
	}
	
