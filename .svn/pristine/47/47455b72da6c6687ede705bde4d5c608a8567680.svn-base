	/**
	 * @param tin - company TIN
	 * @param isOnBehalf
	 * @param companyVO - to get myInvoisClientId, myInvoisClientSecret1, myInvoisClientSecret2
	 * @return
	 * @throws IOException
	 * @throws JSONException
	 * @throws BusinessException
	 * @throws KeyManagementException 
	 * @throws NoSuchAlgorithmException 
	 */
	public String getAuthAccessToken(CompanyVO companyVO, Boolean isOnBehalf) throws IOException, JSONException, BusinessException, KeyManagementException, NoSuchAlgorithmException {
		
		System.out.println("CYY isOnBehalf: " + isOnBehalf);
		// check client id, client secret, tax no. is blank
		EInvoiceUtils.validateMyInvoisCredentials(companyVO);
		
		String url = EInvoiceProperties.getSystemApiUrl() + EInvoiceProperties.API_LOGIN;
		System.out.println("CYY url: " + url);
		
		// open connection
		HttpsURLConnection connection = EInvoiceUtils.openAuthAccessTokenHttpsURLConnection(new URL(url), "POST", isOnBehalf, companyVO);

        // get response code
        int status = connection.getResponseCode();
        System.out.println("CYY response code: " + status);
        
        if (status == HttpConstant.STATUS_CD_GATEWAY_TIMEOUT) {
        	throw new BusinessException(CommonErrConstant.ERR_GATEWAY_TIMEOUT);
        }
        
        // get response message from connection
        String response = EInvoiceUtils.getConnectionResponse(status, connection);
        System.out.println("CYY response: " + response);
        
        // convert to JSON format
        JSONObject jsonResponse = new JSONObject(response);
        System.out.println(jsonResponse.toString(4));
//        logger.info("[EInvoiceUtils - getAuthAccessToken][jsonResponse]: " + response);
        
        // check if access token exists, if no, throw err
        if (jsonResponse.isNull("access_token") || StringUtils.isBlank(jsonResponse.getString("access_token")) || jsonResponse.getString("access_token") == null) {
        	throw new BusinessException(CommonErrConstant.ERR_E_INVOICE_API_LOGIN_FAILED);
        } 
        
        // insert access token
        EInvoiceAccessTokenVO eInvoiceAccessTokenVO = EInvoiceUtils.generateEInvoiceAccessTokenVO(companyVO.getId(), jsonResponse);
        insertAccessToken(eInvoiceAccessTokenVO);
        
        return eInvoiceAccessTokenVO.getAccessToken();
	}
	
	public String getAccessToken(InvoiceVO invoiceVO, Boolean isOnBehalf, CompanyVO companyVO) throws BusinessException, IOException, JSONException, KeyManagementException, NoSuchAlgorithmException {
		
		if (invoiceVO.getCustDetailsVO() == null) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_DETAILS_MISSING);
		} else if (StringUtils.isBlank(invoiceVO.getCustDetailsVO().getTaxIdNo())) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_NO_TIN);
		} else if (CollectionUtils.isEmpty(invoiceVO.getCustDetailsVO().getIdentityList())) {
			throw new BusinessException(CommonErrConstant.ERR_CUST_IDENTITY_MISSING);
		}
		
		return getAuthAccessToken(companyVO, isOnBehalf);
	}
	
	public String getAccessToken(SupplierVO supplierVO, Boolean isOnBehalf, CompanyVO companyVO) throws BusinessException, IOException, JSONException, KeyManagementException, NoSuchAlgorithmException {
		
		if (StringUtils.isBlank(supplierVO.getTaxIdNo())) {
			throw new BusinessException(CommonErrConstant.ERR_COMPANY_NO_TIN);
		}
		
		return getAuthAccessToken(companyVO, isOnBehalf);
	}
	
	@Override
	public String getAccessToken(CompanyVO companyVO, Boolean isOnBehalf) throws BusinessException, IOException, JSONException, KeyManagementException, NoSuchAlgorithmException {
		EInvoiceAccessTokenVO eInvoiceAccessTokenVO = getValidAccessToken(companyVO.getId());
		
		if (eInvoiceAccessTokenVO != null && StringUtils.isNotEmpty(eInvoiceAccessTokenVO.getAccessToken())) {
			return eInvoiceAccessTokenVO.getAccessToken();
		} else {
			return getAuthAccessToken(companyVO, isOnBehalf);
		}
	}
	
	@Override
	public List<ApiDocumentQueryResponseVO> getRecentDocuments(Date getRecentDocumentsDate, CompanyVO companyVO) throws KeyManagementException, BusinessException, NoSuchAlgorithmException, IOException, JSONException, ParseException {
		List<ApiDocumentQueryResponseVO> responseList = new ArrayList<ApiDocumentQueryResponseVO>();

		String accessToken = getAccessToken(companyVO, false);
		ApiDocumentQueryResponseVO responseVO = EInvoiceUtils.getRecentDocuments(accessToken, getRecentDocumentsDate);
		responseList.add(responseVO);

		if (responseVO.getMetadata().getTotalCount() > EInvoiceConstant.MAX_PAGE_SIZE) {
			for (int pageNo = 2; pageNo <= responseVO.getMetadata().getTotalPages(); pageNo++) {
				ApiDocumentQueryResponseVO respVO = EInvoiceUtils.getRecentDocuments(accessToken, getRecentDocumentsDate, EInvoiceConstant.MAX_PAGE_SIZE, pageNo);
				responseList.add(respVO);
			}
		}
		
		updateRecentDocumentsToApiDailySnapshot(responseList, getRecentDocumentsDate, companyVO);
		insertEInvoiceApiDailySnapshotTransactions(responseList, getRecentDocumentsDate, companyVO.getId());
		
		return responseList;
	}
	
