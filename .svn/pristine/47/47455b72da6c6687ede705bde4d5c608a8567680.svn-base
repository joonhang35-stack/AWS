	@Override
	public void insertEInvoiceApiDailySnapshotTransactions(List<ApiDocumentQueryResponseVO> responseList, Date d, Long idCompany) {
		terminateApiDailySnapshotTransactions(idCompany, d);
		for (ApiDocumentQueryResponseVO responseVO : responseList) {
			for (EInvoiceApiDailySnapshotTransVO transVO : responseVO.getResult()) {
				transVO.setIdCompany(idCompany);
				transVO.setDtTrans(d);
				transVO.setExistsInLocalStatus(EInvoiceConstant.EXISTS_STATUS_PENDING);
				transVO.setProcessStatus(CommonConstant.EMAIL_PMNT_PENDING);
				transVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
				eInvoiceDAO.insert(transVO);
			}
		}
	}
	
	private void terminateApiDailySnapshotTransactions(Long idCompany, Date dtTrans) {
		List<EInvoiceApiDailySnapshotTransVO> transList = eInvoiceDAO.getApiDailySnapshotTransList(idCompany, dtTrans);
		
		for (EInvoiceApiDailySnapshotTransVO transVO : transList) {
			transVO.setStatusCode(BaseConstant.STATUS_DELETED);
			eInvoiceDAO.update(transVO);
		}
	}
	
