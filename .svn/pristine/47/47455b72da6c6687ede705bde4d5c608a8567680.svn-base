	@Override
	public EInvoiceDocumentVO getEInvoiceDetails(EInvoiceDocumentVO eInvoiceDocumentVO) throws BusinessException {
		eInvoiceDocumentVO.setItemList(getEInvoiceDocumentItemList(eInvoiceDocumentVO.getId()));
		eInvoiceDocumentVO.seteInvoiceBuyerVO(getEInvoiceBuyer(eInvoiceDocumentVO.getIdEInvoiceBuyer()));
		eInvoiceDocumentVO.seteInvoiceSupplierVO(getEInvoiceSupplier(eInvoiceDocumentVO.getIdEInvoiceSupplier()));
		
		if (eInvoiceDocumentVO.geteInvoiceBuyerVO() != null)	populateAddress(eInvoiceDocumentVO.geteInvoiceBuyerVO());
		if (eInvoiceDocumentVO.geteInvoiceSupplierVO() != null)	populateAddress(eInvoiceDocumentVO.geteInvoiceSupplierVO());
		
		setOriginalDocRef(eInvoiceDocumentVO);
		
		return eInvoiceDocumentVO;
	}
	
	@Override
	public EInvoiceBuyerVO populateAddress(EInvoiceBuyerVO buyerVO) throws BusinessException {
		if (buyerVO != null) {
			if (StringUtils.isNotBlank(buyerVO.getState())) {
				if (!buyerVO.getState().equals(EInvoiceConstant.STATE_CD_NA)) {
					buyerVO.setMalaysiaStateVO(
							malaysiaStateDAO.getStateByEInvoiceStateCode(buyerVO.getState()));
				}
			}

			if (StringUtils.isNotBlank(buyerVO.getCountry())) {
				buyerVO.setCountryVO(regionDAO.getCountryByThreeLetterCode(buyerVO.getCountry()));
			}
			
			String fullAddress = "";
			fullAddress += buyerVO.getAddr1() + ", ";
			if (StringUtils.isNotBlank(buyerVO.getAddr2())) fullAddress += buyerVO.getAddr2() + ", ";
			if (StringUtils.isNotBlank(buyerVO.getAddr3())) fullAddress += buyerVO.getAddr3() + ", ";
			if (StringUtils.isNotBlank(buyerVO.getPostcode())) fullAddress += buyerVO.getPostcode() + ", ";
			if (StringUtils.isNotBlank(buyerVO.getCity())) fullAddress += buyerVO.getCity() + ", ";
			if (buyerVO.getState().equals(EInvoiceConstant.STATE_CD_NA)) fullAddress += "Not Applicable, ";
			else	fullAddress += buyerVO.getMalaysiaStateVO().getName() + ", ";
			fullAddress += buyerVO.getCountryVO().getCountry();
			
			System.out.println("CYY fullAddress: " + fullAddress);
			buyerVO.setFullAddress(fullAddress);
		}
		
		return buyerVO;
	}
	
	private void setOriginalDocRef(EInvoiceDocumentVO eInvoiceDocumentVO) throws BusinessException {
		if (EInvoiceConstant.E_INV_TYPE_CREDIT_NOTE.equals(eInvoiceDocumentVO.geteInvoiceDocTypeCd())
				|| EInvoiceConstant.E_INV_TYPE_REFUND_NOTE.equals(eInvoiceDocumentVO.geteInvoiceDocTypeCd())) {
			InvoiceVO refInvoiceVO = invoiceDAO.getInvoiceById(eInvoiceDocumentVO.getIdRefDoc());
			if (refInvoiceVO != null) {
				SystemNumberGenerationVO sysNumGenVO = systemNumberGenerationDAO.getSystemNumberGeneration(CommonConstant.SYS_NUM_CD_INVC, eInvoiceDocumentVO.getIdCompany());
				refInvoiceVO.setPrefix(sysNumGenVO.getPrefixid());
			}
			eInvoiceDocumentVO.setRefInvoiceVO(refInvoiceVO);
		}
	}
	
	@Override
	public void updateRecentDocumentsToApiDailySnapshot(List<ApiDocumentQueryResponseVO> responseList, Date dtTrans, CompanyVO companyVO) throws KeyManagementException, BusinessException,
			NoSuchAlgorithmException, IOException, JSONException, ParseException {
		terminateApiDailySnapshot(dtTrans);
		insertApiDocumentQueryResponse(responseList, dtTrans, companyVO.getId());
	}
	
	/**
	 * Copies API document query data {@code ApiDocumentQueryResponseVO} into a daily snapshot object {@code EInvoiceApiDailySnapshotVO}.
	 * 
	 * @param fromVO
	 * @param toVO
	 * @param d
	 * @param idCompany
	 * @return
	 */
	private EInvoiceApiDailySnapshotVO copyApiResponseToSnapshot(ApiDocumentQueryResponseVO fromVO, EInvoiceApiDailySnapshotVO toVO, Date d, Long idCompany) {
		
		toVO.setIdCompany(idCompany);
		toVO.setDtTrans(d);
		toVO.setJsonResponse(fromVO.getJsonResponse());
		toVO.setTotalCount(fromVO.getMetadata().getTotalCount());
		toVO.setPageNo(fromVO.getPageNo());
		toVO.setPageSize(fromVO.getResult().size());
		toVO.setStatusCode(BaseConstant.STATUS_ACTIVE);
		
		return toVO;
	}
	
	@Override
	public void insertApiDocumentQueryResponse(List<ApiDocumentQueryResponseVO> responseList, Date d, Long idCompany) {
		for (ApiDocumentQueryResponseVO responseVO : responseList) {
			EInvoiceApiDailySnapshotVO snapshotVO = new EInvoiceApiDailySnapshotVO();
			copyApiResponseToSnapshot(responseVO, snapshotVO, d, idCompany);
			
			eInvoiceDAO.insert(snapshotVO);
		}
	}
	
	private void terminateApiDailySnapshot(Date dtTrans) {
		List<EInvoiceApiDailySnapshotVO> snapshotList = eInvoiceDAO.getApiDailySnapshotList(dtTrans);
		
		for (EInvoiceApiDailySnapshotVO snapshotVO : snapshotList) {
			snapshotVO.setStatusCode(BaseConstant.STATUS_DELETED);
			eInvoiceDAO.update(snapshotVO);
		}
	}
	
