	@Override
	public EInvoiceDocumentVO insertCreditNote(String docUuid, String submissionUid, String docStatus, InvoiceVO invoiceVO, Integer submissionDocCnt) throws BusinessException {
				
		EInvoiceDocumentVO eInvoiceDocumentVO = insertDocument(docUuid, submissionUid, docStatus, invoiceVO.getId(),
				invoiceVO.getCode(), CommonConstant.SYS_NUM_CD_CRDT_NOTE, EInvoiceConstant.E_INV_DOC_TYPE_CREDIT_NOTE,
				invoiceVO.getCompanyId(), submissionDocCnt, false);
		
		setRefDoc(eInvoiceDocumentVO, invoiceVO.getId());
		
		eInvoiceDocumentVO.setIdCust(invoiceVO.getCustomerId());
		eInvoiceDAO.update(eInvoiceDocumentVO);
		
		return eInvoiceDocumentVO;
	}
	
	@Override
	public EInvoiceDocumentVO insertRefundNote(String docUuid, String submissionUid, String docStatus, InvoiceVO invoiceVO, Integer submissionDocCnt) throws BusinessException {
				
