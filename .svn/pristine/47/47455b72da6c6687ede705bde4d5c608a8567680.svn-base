	/**
	 * <p>set Original e-Invoice Reference data</p>
	 * <code>idRefEInvDoc, idRefDoc, originalEInvRef</code>
	 * @param eInvoiceDocumentVO
	 * @param refId - id of CN
	 * @throws BusinessException
	 */
	private void setRefDoc(EInvoiceDocumentVO eInvoiceDocumentVO, Long refId) throws BusinessException {
		InvoiceVO creditNoteVO = invoiceDAO.getInvoiceById(refId);
		InvoiceVO cnInvoiceVO = invoiceDAO.getInvoiceByCode(creditNoteVO.getCnInvNo());
		eInvoiceDocumentVO.setIdRefDoc(cnInvoiceVO.getId());
		
		EInvoiceDocumentVO refEInvoiceDocumentVO = getEInvoiceByUuid(cnInvoiceVO.geteInvoiceDocumentUuid());
		if (refEInvoiceDocumentVO != null)	eInvoiceDocumentVO.setIdRefEInvDoc(refEInvoiceDocumentVO.getId());
		eInvoiceDocumentVO.setOriginalEInvRef(cnInvoiceVO.geteInvoiceDocumentUuid());
	}
	
	/**
	 * @param docUuid
	 * @param submissionUid
	 * @param docStatus
	 * @param consolidateInvoiceList
	 * @param eInvoiceDocType
