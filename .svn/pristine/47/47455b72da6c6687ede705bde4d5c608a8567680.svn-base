	@Override
	public void updEInvoiceDocumentVO(EInvoiceDocumentVO eInvoiceDocumentVO, EInvoiceDocument eInvoiceDocument) throws BusinessException, ParseException {
		
		// update e_invoice_document
		// copy details from eInvoiceDocument to eInvoiceDocumentVO
		if (eInvoiceDocument != null) EInvoiceUtils.copyDetails(eInvoiceDocumentVO, eInvoiceDocument);
		
		// update validation error
		if (eInvoiceDocumentVO.getStatusCode().equals(EInvoiceConstant.E_INV_STATUS_INVALID)) {
			if (eInvoiceDocument != null && eInvoiceDocument.getValidationResults() != null && CollectionUtils.isNotEmpty(eInvoiceDocument.getValidationResults().getValidationSteps())) {
				for (EInvoiceValidationStepResult step : eInvoiceDocument.getValidationResults().getValidationSteps()) {
					if (step.getStatus().equals(EInvoiceConstant.E_INV_STATUS_INVALID)) {
						for (EInvoiceStandardError err : step.getError().getInnerError()) {
							if (StringUtils.isBlank(eInvoiceDocumentVO.getDocStatusReason())) {
								eInvoiceDocumentVO.setDocStatusReason(err.getError());
							} else {
								eInvoiceDocumentVO.setDocStatusReason(eInvoiceDocumentVO.getDocStatusReason() + "\n" + err.getError());
							}
						}
					}
				}
			}
		}
		
		eInvoiceDAO.update(eInvoiceDocumentVO);
		
		// if is consol inv, update e_invoice_consolidate table
		if (eInvoiceDocumentVO.getIsConsolEInv()) {
			eInvoiceDAO.updateEInvoiceConsolidate(eInvoiceDocumentVO.getDocumentUuid(), eInvoiceDocumentVO.getLongId(), eInvoiceDocumentVO.getStatusCode());
		}
		
		// update e inv data in sys table
		if (!StringUtils.equals(eInvoiceDocumentVO.getSysDocType(), CommonConstant.SYS_NUM_CD_RFND_NOTE)) {
//		if (! eInvoiceDocumentVO.getSysDocType().equals(CommonConstant.SYS_NUM_CD_RFND_NOTE)) {
			if (StringUtils.equals(eInvoiceDocumentVO.getSysDocType(), CommonConstant.SYS_NUM_CD_E_INV)) {
				// e inv, nothing to update
			} else {
				String table = LookupItemUtils.getTableName(eInvoiceDocumentVO.getSysDocType()); // table name to update
				updateEInvoiceStatus(eInvoiceDocumentVO.getDocumentUuid(), eInvoiceDocumentVO.getStatusCode(), table);
			}
		} else {
			invoiceDAO.updateRefundNoteEInvoiceStatus(eInvoiceDocumentVO.getDocumentUuid(), eInvoiceDocumentVO.getStatusCode());
		}
	}
	
	@Override
	public void updateEInvoiceStatus(String eInvoiceDocumentUuid, String eInvoiceStatus, String table)
			throws BusinessException {
		eInvoiceDAO.updateEInvoiceStatus(eInvoiceDocumentUuid, eInvoiceStatus, table);
		// update invoice history
		if (StringUtils.equalsIgnoreCase(table, "invoice")) {
			if (StringUtils.equalsIgnoreCase(eInvoiceStatus, EInvoiceConstant.E_INV_STATUS_CANCELLED)) {
				invoiceDAO.insertInvoiceHistory(getEInvoiceByUuid(eInvoiceDocumentUuid).getRefId(), CommonConstant.ACTION_CD_UPD, "Cancel E-Invoice");
			} else {
				invoiceDAO.insertInvoiceHistory(getEInvoiceByUuid(eInvoiceDocumentUuid).getRefId(), CommonConstant.ACTION_CD_UPD, "[Update E-Invoice Status]");
			}
			
		}
	}
	
