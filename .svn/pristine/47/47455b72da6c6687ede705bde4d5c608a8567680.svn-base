	@Override
	public EInvoiceDocumentVO insertConsolidateInvoice(String docUuid, String submissionUid, String docStatus, List<InvoiceVO> consolidateInvoiceList, String eInvoiceDocType, String sysDocType, String refNo, Long idCompany) throws BusinessException {
		
		// to be removed if insertDocument stable
//		EInvoiceDocumentVO eInvoiceDocumentVO = new EInvoiceDocumentVO();
//    	eInvoiceDocumentVO.setSubmissionUid(submissionUid);
//    	eInvoiceDocumentVO.setDocumentUuid(docUuid);
//    	eInvoiceDocumentVO.setStatusCode(docStatus);
//    	eInvoiceDocumentVO.setIdCompany(idCompany);
//    	eInvoiceDocumentVO.setRefId(); // consol e inv, no ref id to set
//    	eInvoiceDocumentVO.setRefNo(refNo);
//    	eInvoiceDocumentVO.seteInvoiceDocType(eInvoiceDocType);
//		eInvoiceDocumentVO.setSysDocType(sysDocType);
//		eInvoiceDocumentVO.setIsConsolEInv(true);

//		SystemNumberGenerationVO systemNumberGenerationVO = systemNumberGenerationDAO.getSystemNumberGeneration(sysDocType, idCompany);
//		eInvoiceDocumentVO.setSysPrefix(systemNumberGenerationVO.getPrefixid());
		
//		eInvoiceDAO.insert(eInvoiceDocumentVO);
		EInvoiceDocumentVO eInvoiceDocumentVO = insertDocument(docUuid, submissionUid, docStatus, null, refNo, sysDocType, eInvoiceDocType, idCompany, 1, true);
		
		insertSubmission(submissionUid, idCompany, 1);
		// to be removed if insertSubmission stable
//		EInvoiceSubmissionVO eInvoiceSubmissionVO = new EInvoiceSubmissionVO();
//		eInvoiceSubmissionVO.setIdCompany(idCompany);
//		eInvoiceSubmissionVO.setSubmissionUid(submissionUid);
//		eInvoiceSubmissionVO.setDocCnt(1);
//		eInvoiceSubmissionVO.setStatusCode("in progress");
//		eInvoiceDAO.insert(eInvoiceSubmissionVO);
		
		for (InvoiceVO invoiceVO : consolidateInvoiceList) {
			// update to invoice table
			invoiceDAO.updateInvoiceEInvoiceData(invoiceVO.getId(), docUuid, submissionUid, docStatus);
			
			// insert record to e_invoice_consolidate table
			EInvoiceConsolidateVO eInvoiceConsolidateVO = new EInvoiceConsolidateVO();
			eInvoiceConsolidateVO.setRefId(invoiceVO.getId());
			eInvoiceConsolidateVO.setRefNo(invoiceVO.getCode());
			eInvoiceConsolidateVO.setDocumentUuid(docUuid);
			eInvoiceConsolidateVO.setSubmissionUid(submissionUid);
			eInvoiceConsolidateVO.seteInvoiceDocType(eInvoiceDocType);
			eInvoiceConsolidateVO.setSysDocType(sysDocType);
			eInvoiceConsolidateVO.setSysPrefix(eInvoiceDocumentVO.getSysPrefix());
			eInvoiceConsolidateVO.setStatusCode(docStatus);
			eInvoiceDAO.insert(eInvoiceConsolidateVO);
		}
		
		return eInvoiceDocumentVO;
	}
	
