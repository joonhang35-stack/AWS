				invoiceVO.getRnNo(), CommonConstant.SYS_NUM_CD_RFND_NOTE, EInvoiceConstant.E_INV_DOC_TYPE_REFUND_NOTE,
				invoiceVO.getCompanyId(), submissionDocCnt, false);
		
		setRefDoc(eInvoiceDocumentVO, invoiceVO.getId());
		
		eInvoiceDocumentVO.setIdCust(invoiceVO.getCustomerId());
		eInvoiceDAO.update(eInvoiceDocumentVO);
		
		return eInvoiceDocumentVO;
	}
	
	@Override
	public void insertSubmission(String submissionUid, Long idCompany, Integer submissionDocCnt) {
		EInvoiceSubmissionVO eInvoiceSubmissionVO = new EInvoiceSubmissionVO();
		eInvoiceSubmissionVO.setIdCompany(idCompany);
		eInvoiceSubmissionVO.setSubmissionUid(submissionUid);
		eInvoiceSubmissionVO.setDocCnt(submissionDocCnt);
		eInvoiceSubmissionVO.setStatusCode(EInvoiceConstant.E_INV_SUB_STATUS_IN_PROGRESS);
		eInvoiceDAO.insert(eInvoiceSubmissionVO);
	}
	
