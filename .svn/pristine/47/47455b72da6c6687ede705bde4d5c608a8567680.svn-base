	@Override
	public JSONObject submitCreditNoteType(EInvoiceDocumentVO vo) throws BusinessException, KeyManagementException, NoSuchAlgorithmException, IOException, JSONException {
		EInvoiceDocumentVO eInvoiceDocumentVO = getEInvoiceDetails(vo);
		InvoiceType creditNoteType = EInvoiceUtils.generateCreditNoteType(eInvoiceDocumentVO);
		
		CompanyVO companyVO = corporateProfileDAO.getCompanyDetails(vo.getIdCompany());
		String accessToken = getAccessToken(companyVO, false);            	
		
		JSONObject eInvoiceDocuments = EInvoiceUtils.generateEInvoiceDocuments(creditNoteType);
		JSONObject submitResponse = EInvoiceUtils.submitAPI(eInvoiceDocuments, accessToken);
		
		processCreditNoteInvoiceTypeSubmitResponse(submitResponse, vo, creditNoteType);
		
		return submitResponse;
	}
	
	/**
	 * <pre>
	 * Process submission response after submit to E-Invoice API
	 * Single submission
	 * https://sdk.myinvois.hasil.gov.my/einvoicingapi/02-submit-documents/
	 * </pre>
	 * 
	 * @param submitResponse
	 * @param invoiceVO
	 * @throws JSONException
	 * @throws BusinessException
	 */
	public void processCreditNoteInvoiceTypeSubmitResponse(JSONObject submitResponse, EInvoiceDocumentVO refDocVO, InvoiceType invoiceType) throws JSONException, BusinessException {
		
		EInvoiceUtils.checkResponseErr(submitResponse);
		
		refDocVO = getEInvoiceDetails(refDocVO);
		
		String submissionUid = submitResponse.getString("submissionUid");
		JSONArray acceptedDocuments = submitResponse.getJSONArray("acceptedDocuments");
		JSONArray rejectedDocuments = submitResponse.getJSONArray("rejectedDocuments");
		
		insertSubmission(submissionUid, refDocVO.getIdCompany(), acceptedDocuments.length());

		for (int j = 0; j < acceptedDocuments.length(); j++) {
			String documentUuid = acceptedDocuments.getJSONObject(j).getString("uuid");
//			String invoiceCodeNumber = acceptedDocuments.getJSONObject(j).getString("invoiceCodeNumber");
	        	
			EInvoiceDocumentVO eInvoiceDocumentVO = insertDocument(documentUuid, submissionUid,
					EInvoiceConstant.E_INV_STATUS_SUBMIT, null, invoiceType.getIDValue(), CommonConstant.SYS_NUM_CD_E_INV,
					null, refDocVO.getIdCompany(), 1, false);
			insertDocumentDetails(invoiceType, eInvoiceDocumentVO);
			
			eInvoiceDocumentVO.setRefId(eInvoiceDocumentVO.getId());
			eInvoiceDocumentVO.seteInvoiceDocTypeCd(EInvoiceUtils.resolveCreditNoteType(refDocVO.geteInvoiceDocTypeCd()));
			eInvoiceDocumentVO.seteInvoiceDocType(LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_E_INV_DOC_TYPE, eInvoiceDocumentVO.geteInvoiceDocTypeCd()));
			eInvoiceDocumentVO.setIdRefEInvDoc(refDocVO.getId());
			eInvoiceDocumentVO.setIdRefDoc(refDocVO.getId());
			eInvoiceDocumentVO.setOriginalEInvRef(refDocVO.getDocumentUuid());
			
//			TODO set e invoice id cust/id supl
//			eInvoiceDocumentVO.setIdCust();
			eInvoiceDAO.update(eInvoiceDocumentVO);
		}
		
    	if (rejectedDocuments.length() > 0) {
    		for (int k = 0; k < rejectedDocuments.length(); k++) {
    			JSONObject err = rejectedDocuments.getJSONObject(k).getJSONObject("error");
            	JSONArray details = err.getJSONArray("details");
            	
            	for (int j = 0; j < details.length(); j++) {
                    JSONObject innerErr = details.getJSONObject(j);
    				throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, new String[] {innerErr.getString("message")});
                }
    		}
    		
    		throw new BusinessException(CommonErrConstant.ERR_E_INVOICE_API_SUBMISSION_FAILED);
    	}
	}
	
	@Override
	public ApiGetSubmissionResponseVO getSubmission(String submissionUid, Long idCompany) throws BusinessException, KeyManagementException, NoSuchAlgorithmException, IOException, JSONException, ParseException {
		
		CompanyVO companyVO = corporateProfileDAO.getCompanyDetails(idCompany);
		String accessToken = getAccessToken(companyVO, false);            	
		
		ApiGetSubmissionResponseVO responseVO = EInvoiceUtils.getSubmission(accessToken, submissionUid, EInvoiceConstant.MAX_PAGE_SIZE, 1);
		
		EInvoiceSubmissionVO subVO = eInvoiceDAO.getEInvoiceSubmissionVO(submissionUid);
		
		if (responseVO.getResponseCode() == HttpConstant.STATUS_CD_NOT_FOUND) {
			handleGetSubmissionError(subVO, responseVO);
			return responseVO;
		}
		
		if (!StringUtils.equals(responseVO.getOverallStatus(), EInvoiceConstant.E_INV_SUB_STATUS_IN_PROGRESS)) {
			updateEInvSubmissionFromApiResp(subVO, responseVO, accessToken);
		}
		
		return responseVO;
	}
	
	/**
	 * Updates the local e-invoice submission and related document records
	 * based on response returned by e-Invoice GetSubmission API.
	 * <p>
	 * This method:
	 * <ul>
	 *   <li>Updates document details for submitted documents</li>
	 *   <li>Handles invalid documents if detected</li>
	 *   <li>Updates the overall submission status</li>
	 * </ul>
	 * 
	 * @param subVO					The local e-invoice submission record to update.
	 * @param responseVO			The response received from the MyInvois GetSubmission API.
	 * @param accessToken
	 * @throws BusinessException	
	 * @throws ParseException
	 */
	private void updateEInvSubmissionFromApiResp(EInvoiceSubmissionVO subVO, ApiGetSubmissionResponseVO responseVO, String accessToken) throws BusinessException, ParseException {
		// update e-invoice document
		for (ApiDocumentSummaryVO apiDocVO : responseVO.getDocumentSummary()) {
			EInvoiceDocumentVO documentVO = getEInvoiceByUuid(apiDocVO.getUuid());
			if (StringUtils.equals(documentVO.getStatusCode(), EInvoiceConstant.E_INV_STATUS_SUBMIT)) {
				EInvoiceUtils.copyDetails(documentVO, apiDocVO);
				updEInvoiceDocumentVO(documentVO, null);
				
				handleInvalidDoc(documentVO, accessToken);
			}
		}
		
		// update e-invoice submission
		subVO.setStatusCode(responseVO.getOverallStatus());
		eInvoiceDAO.update(subVO);
	}
	
	private void handleInvalidDoc(EInvoiceDocumentVO documentVO, String accessToken) {
		if (StringUtils.equalsIgnoreCase(documentVO.getStatusCode(), EInvoiceConstant.E_INV_STATUS_INVALID)) {
			try {
				EInvoiceDocumentVO eInvoiceDocumentVO = updDocumentDetails(documentVO.getDocumentUuid(), accessToken);
				if (!StringUtils.equalsIgnoreCase(EInvoiceProperties.TESTING, "true")) {
					eInvoiceSchedulerService.notifyInvalidEInvoice(eInvoiceDocumentVO);
				}
			} catch (Exception e) {
				e.printStackTrace();
			}
		}
	}
	
	private void handleGetSubmissionError(EInvoiceSubmissionVO subVO, ApiGetSubmissionResponseVO responseVO) {
		subVO.setStatusCode(EInvoiceConstant.E_INV_SUB_STATUS_ERROR);
		subVO.setRemarks(responseVO.getErrMsg());
		eInvoiceDAO.update(subVO);
	}
	
	@Override
	public List<EInvoiceSubmissionVO> getEInvoiceSubmissionByStatus(String statusCd, Long idCompany) {
		return getEInvoiceSubmissionByStatus(FunctionUtils.generateArrayFromStr(statusCd), idCompany);
	}
	
	@Override
	public List<EInvoiceSubmissionVO> getEInvoiceSubmissionByStatus(String[] statusList, Long idCompany) {
		return eInvoiceDAO.getEInvoiceSubmissionByStatus(statusList, idCompany);
	}
	
	/**
	 * update document and related table details when user refresh E-Invoice status
	 * 
	 * @param docUuid
	 * @param accessToken
	 * @return
	 * @throws KeyManagementException
	 * @throws NoSuchAlgorithmException
	 * @throws MalformedURLException
	 * @throws IOException
	 * @throws JSONException
	 * @throws BusinessException
	 * @throws ParseException
	 */
	@Override
	public EInvoiceDocumentVO updDocumentDetails(String docUuid, String accessToken) throws KeyManagementException, NoSuchAlgorithmException, MalformedURLException, IOException, JSONException, BusinessException, ParseException {

		/* read InvoiceType from document */
//		EInvoiceDocument eInvoiceDocument1 = getDocument(docUuid, accessToken);
//		JAXBContext jaxbContext = JAXBContext.newInstance(
//			    "oasis.names.specification.ubl.schema.xsd.invoice_21:" +
//			    "oasis.names.specification.ubl.schema.xsd.commonbasiccomponents_21:" +
//			    "oasis.names.specification.ubl.schema.xsd.commonaggregatecomponents_21"
//			);
//		
//		Unmarshaller unmarshaller = jaxbContext.createUnmarshaller();
//		StringReader reader = new StringReader(eInvoiceDocument1.getDocument());
//		JAXBElement<InvoiceType> je = (JAXBElement<InvoiceType>) unmarshaller.unmarshal(reader);
//		InvoiceType invoice = je.getValue();

		String url = UriComponentsBuilder
				.fromHttpUrl(EInvoiceProperties.getSystemApiUrl() + "api/v1.0/documents/" + docUuid + "/details")
				.build().toUriString();
		
		// open connection
		HttpsURLConnection connection = EInvoiceUtils.openHttpsURLConnection(new URL(url), "GET", accessToken);
		
		// get response code
		int respCode = connection.getResponseCode();
//		System.out.println("CYY respCode: " + respCode);
		
		// get response message from connection
        String response = EInvoiceUtils.getConnectionResponse(respCode, connection); 

        JSONObject jsonResponse = new JSONObject(response);
		
		System.out.println(jsonResponse.toString(4));
		
		if (respCode == org.springframework.http.HttpStatus.TOO_MANY_REQUESTS.value()) {
			String errMsg = "Rate limit is exceeded. Try again in 60 seconds.";
			if (jsonResponse.has("message")) {
				errMsg = jsonResponse.getString("message");
			}
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr(errMsg));
		}
		
		if (respCode == org.springframework.http.HttpStatus.NOT_FOUND.value()) {
			String errMsg = "404 NotFound";
			if (jsonResponse.has("error")) {
				ObjectMapper mapper = new ObjectMapper();
				JsonNode root = mapper.readTree(jsonResponse.toString());

				String message = root
				        .path("error")
				        .path("details")
				        .get(0)
				        .path("message")
				        .asText();

				System.out.println(message);

				if(StringUtils.isNotBlank(message)) {
					errMsg = message;
				}
//				errMsg = jsonResponse.getString("message");
			}
			throw new BusinessException(CommonErrConstant.ERR_E_INV_ERR_MSG, null, FunctionUtils.generateArrayFromStr(errMsg));
		}
		
		Gson gson = new Gson();
		EInvoiceDocument eInvoiceDocument = gson.fromJson(jsonResponse.toString(), EInvoiceDocument.class);
		
		eInvoiceDocument.printValidationResults();
//		System.out.println("new JSONObject(eInvoiceDocument).toString(4)");
//		System.out.println(new JSONObject(eInvoiceDocument).toString(4));
		
		EInvoiceDocumentVO eInvoiceDocumentVO = getEInvoiceByUuid(docUuid);
		updEInvoiceDocumentVO(eInvoiceDocumentVO, eInvoiceDocument);
		
//		searchDocuments(docUuid, accessToken);
		
		return eInvoiceDocumentVO;
	}
}
