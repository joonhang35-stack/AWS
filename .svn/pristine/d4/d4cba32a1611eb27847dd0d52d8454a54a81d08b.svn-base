	@SuppressWarnings({ "unchecked", "rawtypes" })
	private void sendInvChangesEmail(InvoiceVO invoiceVO, String prefixValue, List<String> emailList, List<String> invoiceChangesList, String otherTypeRemark, UserVO userVO) throws BusinessException {
		try {
			List<String> descList = new ArrayList<String>();
			List<LookupItemVO> lookUpItemList = lookUpDAO.getLookUpCodeList(CommonConstant.LOOKUP_CAT_CD_INV_CHANGES);
			String selectedChanges = "";
			String subjectLine = "";
			int count = 1;
			for(String code : invoiceChangesList) {
				for(LookupItemVO vo : lookUpItemList) {
					if(StringUtils.equals(code, vo.getCode())) {
						
						if (StringUtils.isBlank(selectedChanges)) {
							subjectLine = vo.getDescription();
							selectedChanges = vo.getDescription();
						} else {
							subjectLine = selectedChanges + ", " + vo.getDescription();
							selectedChanges = selectedChanges + ", " + vo.getDescription();
						}
						
						if (count == 3) {
							descList.add(selectedChanges);
							selectedChanges = "";
							count = 1;
						} else {
							count ++;
						}
						break;
					}
				}
			}
			if (StringUtils.isNotBlank(selectedChanges)) descList.add(selectedChanges);
			
			if (emailList != null) {	
			    // Get email template
				String[] description = descList.toArray(new String[descList.size()]);
				Map<String, Object> map = new HashMap<>();
				Map root = new HashMap();
				for(int i=0; i<description.length;i++) { // 65 = A-Z = 90
					map.put(Character.toString((char) (65+i)), description[i]);
				}
				
				root.put("info", map);
				root.put("bgColor", CommonConstant.EMAIL_BG_COLOR);
//				root.put("changesMade", selectedChanges);
				root.put("bookingID", invoiceVO.getBookingId() != null ? String.valueOf(invoiceVO.getBookingId()) : " - ");
				root.put("prefix", prefixValue);
				root.put("code", invoiceVO.getCode());
				root.put("tourCode", StringUtils.isNotBlank(invoiceVO.getTourCd()) ? invoiceVO.getTourCd() : " - ");
				
				if (invoiceVO.getTourDepId() != null) {
					TourDepartureVO tourDepVO = tourPkgDAO.getTourDepById(invoiceVO.getTourDepId());
					TourPackageVO tourPkgVO = tourPkgDAO.getTourPackageById(tourDepVO.getIdTourPkg());
					root.put("tourPkg", tourPkgVO.getNameEn() + " " + tourPkgVO.getNameOther());
					root.put("tourDepDt", sdf.format(invoiceVO.getDepartureDt()));
				} else {
					root.put("tourPkg", " - ");
					root.put("tourDepDt", " - ");
				}
				
				List<EmployeeVO> employeeList = userDAO.getEmployeeList(userVO);
				String department = "";
				
				for(EmployeeVO vo : employeeList) {
					if (StringUtils.isNotBlank(vo.getDepartment())) {
						department = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_DEPARTMENT, vo.getDepartment());
						break;
					}
				}
				
				root.put("requester", (StringUtils.isBlank(department) ? "-" : department) + " / " + userVO.getName());
				if(StringUtils.isNotEmpty(otherTypeRemark));
					root.put("others", otherTypeRemark);
				String content = emailTemplate.processEmailMappingFooterDoNotReply(ConstantEmailTemplate.INV_CHANGES, root);
				
				ProcessSentEmail processSentEmail = new ProcessSentEmail(
						invoiceVO.getTourCd() + " / " + root.get("prefix") + root.get("code") + " / " + subjectLine,
						content,
						userVO.getEmailAddress(),
						emailList);
				Thread thread = new Thread(processSentEmail);
				thread.start();
			}
		} catch ( Exception e) {
			throw new BusinessException(e);
		}
	}
	
