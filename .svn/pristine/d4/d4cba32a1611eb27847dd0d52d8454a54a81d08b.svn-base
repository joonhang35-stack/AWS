	/**
	 * Send Notification Email for Tour Departure That Not Operation -START-
	 */
	
	@Override
	public void sendTourDepNOEmailByIndividual(TourDepartureVO tourDepVO, List<String> emailEmployeeList, String remarks, UserVO userVO) throws BusinessException {
		sendTourDepNOEmail(tourDepVO, emailEmployeeList, remarks, userVO);
	}
	
	@Override
	public void sendTourDepNOEmailByDepartment(TourDepartureVO tourDepVO, List<String> departmentList, String remarks, Long companyId, UserVO userVO) throws BusinessException {
		try {
			if (CollectionUtils.isEmpty(departmentList))
				return;
			
			List<String> codeList = new ArrayList<String>();
			List<String> emailList = new ArrayList<String>();
			for(String code : departmentList) {
				codeList.add(code);
			}
			List<EmployeeViewVO> dprtList = tourPkgDAO.getDepartmentViewList(companyId, codeList);
			
			for(EmployeeViewVO vo : dprtList) {
				if(StringUtils.isNotBlank(vo.getUserVO().getEmailAddress())) {
					emailList.add(vo.getUserVO().getEmailAddress());
				}
			}
			
			sendTourDepNOEmail(tourDepVO, emailList, remarks, userVO);
		} catch ( Exception e) {
			throw new BusinessException(e);
		}
	}
	
	private void sendTourDepNOEmail(TourDepartureVO tourDepVO, List<String> emailList, String remarks, UserVO userVO) throws BusinessException {
		try {
			if (emailList != null) {
				TourPackageVO tourPackageVO = tourPkgDAO.getTourPackageById(tourDepVO.getIdTourPkg());
				
			    // Get email template
				Map<String, Object> map = new HashMap<>();
				map.put("tourCd", tourDepVO.getCode());
				map.put("nameEn", tourPackageVO.getNameEn());
				map.put("nameOther", tourPackageVO.getNameOther());
				map.put("departureDate", sdf.format(tourDepVO.getDtDep()));
				map.put("tourStatus", LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_TOUR_STATUS, tourDepVO.getTourStatusCd()));
				map.put("remarks", StringUtils.isBlank(remarks) ? "-" : remarks);
				
				List<EmployeeVO> employeeList = userDAO.getEmployeeList(userVO);
				String department = "";
				for(EmployeeVO vo : employeeList) {
					if (StringUtils.isNotBlank(vo.getDepartment())) {
						department = LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_DEPARTMENT, vo.getDepartment());
						break;
					}
				}
				map.put("sender", (StringUtils.isBlank(department) ? "-" : department) + " / " + userVO.getName());
				
				String content = emailTemplate.processEmailMappingFooterDoNotReply(ConstantEmailTemplate.TOUR_DEP_NOT_OPERATING, map);
				
				ProcessSentEmail processSentEmail = new ProcessSentEmail("AWS Tour No OP - " + tourDepVO.getCode(), content, userVO.getEmailAddress(), emailList);
				Thread thread = new Thread(processSentEmail);
				thread.start();
			}
		} catch ( Exception e) {
			throw new BusinessException(e);
		}
	}
	
	/**
	 * Send Notification Email for Tour Departure That Not Operation -END-
	 */
	
	
	/***
	 * Sent Invoice Payment Email
	 * @throws BusinessException 
	 */
	@Override
	public void sendEmailPaymentEmail(InvoiceEmailPaymentVO invoiceEmailPaymentVO, UserVO userVO) throws BusinessException {
		if (invoiceEmailPaymentVO == null)
			return;
		
		if (StringUtils.isBlank(invoiceEmailPaymentVO.getEmail())) 
			return;
		
		try {
			InvoiceVO invoiceVO = invoiceDAO.getInvoiceById(invoiceEmailPaymentVO.getIdInvoice());
			if (invoiceVO == null) return;
			
			invoiceDAO.getInvoiceDetails(invoiceVO);
			
			// Get email template
			Map<String, Object> map = new HashMap<>();
			
			map.put("docTypeCd", invoiceVO.getDocTypeCd());
			map.put("customerName", invoiceVO.getAttnTo());
			map.put("re", invoiceVO.getSubjLine());
			if (invoiceVO.getBookingId() != null)
				map.put("bookingNo", invoiceVO.getBookingId().toString());
			else if (invoiceVO.getIdParentInvTourBooking() != null) map.put("bookingNo", invoiceVO.getIdParentInvTourBooking().toString());
			map.put("prefix", invoiceEmailPaymentVO.getPrefix());
			map.put("code", invoiceEmailPaymentVO.getInvoiceNo());
			map.put("invoiceStatus", LookupUtils.getReferenceDataValue("INV_STATUS", invoiceVO.getStatusCd()));
			map.put("tourCode", invoiceVO.getTourCd());
			map.put("salesPerson", invoiceVO.getSalerName());
			map.put("amount", invoiceEmailPaymentVO.getPaymentAmt().setScale(2, BigDecimal.ROUND_HALF_UP).toString());
			map.put("adminCharges", invoiceEmailPaymentVO.getAdminCharges().setScale(2, BigDecimal.ROUND_HALF_UP).toString());
			map.put("totalPaymentAmt", invoiceEmailPaymentVO.getTotalPaymentAmt().setScale(2, BigDecimal.ROUND_HALF_UP).toString());
			
			String docTypeDesc = "Invoice";
			if (SalesConstant.DOC_TYPE_CD_PAX_STMT.equals(invoiceVO.getDocTypeCd())) {
				docTypeDesc = "Pax Statement";
			}
			map.put("docTypeDesc", docTypeDesc);
			map.put("lowercaseDocTypeDesc", docTypeDesc.toLowerCase());
			
		    StringBuilder url = new StringBuilder();
		    url.append(EmailProperties.MAIL_URL);
		    
		    SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd hh:mm a");
		    
		    url.append("/app/sales/emailPayment" + "?" 
    			+ AESEncryption.encrypt("id=" + invoiceEmailPaymentVO.getId()));
			
			map.put("url", url);
			map.put("footerContent", "Please do not reply to this email, it was sent from an unmonitored email address. Payment link will expire in (" + sdf.format(invoiceEmailPaymentVO.getDtExpiry()) +"), you would not be able to complete payment once the link is expired. If you have any enquiries, please contact us at enquiry@applevacations.my or call our office at 03-2705 8299");
			
			String content = emailTemplate.processEmailMappingFooterDoNotReply(ConstantEmailTemplate.INV_EMAIL_PMNT, map);
			
			List<String> ccEmailList = new ArrayList<String>();
			ccEmailList.add(userVO.getEmailAddress());
			ccEmailList.add("payment@applevacations.my");
			
			ProcessSentEmail processSentEmail = new ProcessSentEmail(CommonConstant.EMAIL_FULL_COMP_NAME, "Payment Request for " + docTypeDesc + " " + invoiceEmailPaymentVO.getPrefix() + " " + invoiceEmailPaymentVO.getInvoiceNo(), content, invoiceEmailPaymentVO.getEmail(), null, ccEmailList);
			Thread thread = new Thread(processSentEmail);
			thread.start();
		} catch ( Exception e) {
			throw new BusinessException(e);
		}
	}

	@Override
	public void sendEmailInvoiceEmail(InvoiceVO invoiceVO, UserVO userVO, List<String> emailList, File file, String termsAndConditionFile, String itineraryPath) throws Exception {
		if (invoiceVO == null)
			return;
		
		try {
			invoiceDAO.getInvoiceDetails(invoiceVO);
			
			// Get email template
			SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy");
			String departureDate = sdf.format(invoiceVO.getDepartureDt());
			String airlineName = "TBA";
			String airlineCode = "";
			TourDepartureVO tourDepVO = tourPkgDAO.getTourDepById(invoiceVO.getTourDepId());
			
			Map<String, Object> map = new HashMap<>();
			
			map.put("bgColor", CommonConstant.EMAIL_BG_COLOR);
			map.put("docTypeCd", invoiceVO.getDocTypeCd());
//			map.put("invoiceVO", invoiceVO);
			map.put("customerName", invoiceVO.getAttnTo());
			map.put("companyName", CommonConstant.EMAIL_FULL_COMP_NAME);
			map.put("re", invoiceVO.getSubjLine());
			if (invoiceVO.getBookingId() != null || invoiceVO.getIdParentInvTourBooking() != null) {
				
				// set booking number
				if (invoiceVO.getBookingId() != null)					map.put("bookingNo", invoiceVO.getBookingId().toString());
				else if (invoiceVO.getIdParentInvTourBooking() != null) map.put("bookingNo", invoiceVO.getIdParentInvTourBooking().toString());
			    
				map.put("invoiceNo", invoiceVO.getPrefix() + " " + invoiceVO.getCode());
			    if (tourDepVO.getIdAirline() != null) {
					AirlineVO airlineVO = airlineDAO.getAirline(tourDepVO.getIdAirline());
					airlineName = airlineVO.getDesc();
					airlineCode = "(" + airlineVO.getCode() + ")";
				}
			    map.put("airline", airlineName + " " + airlineCode);
			    map.put("departureDate", departureDate);
			}
			map.put("invoiceStatus", LookupUtils.getReferenceDataValue("INV_STATUS", invoiceVO.getStatusCd()));
			map.put("tourCode", invoiceVO.getTourCd());
			map.put("salesPerson", invoiceVO.getSalerName());
			
			String docTypeDesc = "Invoice";
			if (SalesConstant.DOC_TYPE_CD_PAX_STMT.equals(invoiceVO.getDocTypeCd())) {
				docTypeDesc = "Pax Statement";
			}
			map.put("docTypeDesc", docTypeDesc);
			map.put("lowercaseDocTypeDesc", docTypeDesc.toLowerCase());
			
		    StringBuilder url = new StringBuilder();
		    url.append(EmailProperties.MAIL_URL);
		    
//		    map.put("footerContent", "Please do not reply to this email, it was sent from an unmonitored email address. If you have any enquiries, please contact us at enquiry@applevacations.my or call our office at 03-2705 8299");
		    map.put("footerContent", "Please do not reply to this email, it was sent from an unmonitored email address. If you have any enquiries, please contact us at " + CommonConstant.EMAIL_ENQUIRY_EMAIL + " or call our office at " + CommonConstant.EMAIL_ENQUIRY_PHONE);
			
			String content = emailTemplate.processEmailMappingFooterDoNotReply(ConstantEmailTemplate.INV_EMAIL_INVC, map);
			
			List<String> ccEmailList = new ArrayList<String>();
			ccEmailList.add(userVO.getEmailAddress());
//			ccEmailList.add("payment@applevacations.my");
			
//			ProcessSentEmail processSentEmail = new ProcessSentEmail(CommonConstant.EMAIL_FULL_COMP_NAME, "Invoice for Booking ID" + invoiceVO.getBookingId(), content, email, null, ccEmailList, file);
//			ProcessSentEmail processSentEmail = new ProcessSentEmail(CommonConstant.EMAIL_FULL_COMP_NAME, "Invoice " + invoiceVO.getPrefix() + invoiceVO.getCode() + " from Apple Vacations", content, emailList, null, ccEmailList, file, termsAndConditionFile, itineraryPath);
			ProcessSentEmail processSentEmail = new ProcessSentEmail(CommonConstant.EMAIL_FULL_COMP_NAME, docTypeDesc + " " + invoiceVO.getPrefix() + invoiceVO.getCode() + " from " + CommonConstant.EMAIL_SHORT_COMP_NAME, content, emailList, null, ccEmailList, file, termsAndConditionFile, itineraryPath);
			Thread thread = new Thread(processSentEmail);
			thread.start();
		} catch ( Exception e) {
			//throw new BusinessException(e);
			throw e;
		}
	}

	@Override
	public void sendCustomerProfileUpdateEmail(CustomerProfileUpdateVO customerProfileUpdateVO, UserVO userVO) throws BusinessException {
		if (customerProfileUpdateVO == null)
			return;
		
		if (StringUtils.isBlank(customerProfileUpdateVO.getEmail())) 
			return;
		
		try {
			CustomerVO customerVO = customerDAO.getCustomerDetail(customerProfileUpdateVO.getIdCustomer());
			if (customerVO == null) return;
			
			// Get email template
//			Map<String, Object> map = new HashMap<>(); // Do not use this map cause URL sent out is different after encrypt (received and CC with diff url link)
			Map root = new HashMap();
			
//			map.put("customerName", customerVO.getPersonVO().getSalutation() + ". " + customerVO.getPersonVO().getLastName() + " " + customerVO.getPersonVO().getGivenName());
			
		    StringBuilder url = new StringBuilder();
		    if ( customerVO.getPcTypeCd().equals("C")) {
		    	url.append(EmailProperties.FRONTEND_URL_UPD_CUST_C);
		    } else {
		    	url.append(EmailProperties.FRONTEND_URL_UPD_CUST_P);
		    }
		    
		    url.append("?key=").append(URLEncoder.encode(AESEncryption.encrypt("custId=" + customerProfileUpdateVO.getIdCustomer() + "&uuid=" + customerProfileUpdateVO.getUuid())));
			
		    root.put("url", url);
		    root.put("footerContent", "Please do not reply to this email, as it was sent from an unmonitored email address. The update link will expire once submitted, and you will no longer be able to complete the profile update after it expires. If you have any questions, please contact us at enquiry@applevacations.my or call our office at 03-2705 8299. Thank you.");
			
			String content = emailTemplate.processEmailMappingFooterDoNotReply(ConstantEmailTemplate.CUST_PROFILE_UPDATE, root);
			
			List<String> ccEmailList = new ArrayList<String>();
			ccEmailList.add(userVO.getEmailAddress());
			
			ProcessSentEmail processSentEmail = new ProcessSentEmail(CommonConstant.EMAIL_FULL_COMP_NAME, "Data Collection for E-Invoice Implementation", content, customerProfileUpdateVO.getEmail(), null, ccEmailList);
			Thread thread = new Thread(processSentEmail);
			thread.start();
		} catch ( Exception e) {
			throw new BusinessException(e);
		}
	}
	
	@Override
	public void sendSupplierProfileUpdateEmail(SupplierProfileUpdateVO supplierProfileUpdateVO, UserVO userVO) throws BusinessException {
		if (supplierProfileUpdateVO == null)
			return;
		
		if (StringUtils.isBlank(supplierProfileUpdateVO.getEmail()))
			return;
		
		try {
			SupplierVO supplierVO = purchaseDAO.getSupplierById(supplierProfileUpdateVO.getIdSupplier());
