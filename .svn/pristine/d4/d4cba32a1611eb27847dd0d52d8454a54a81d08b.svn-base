	/**
	 * Sent forgot password email
	 * @throws Exception 
	 */
	@Override
	public void sendForgotPasswordEmail(PasswordResetVO vo, UserVO userVO) throws Exception {
		StringBuilder url = new StringBuilder();
	    url.append(EmailProperties.MAIL_URL);
	    url.append("/app/user/resetpassword" + "?" 
		+ AESEncryption.encrypt("auth=" + vo.getEncodedPassword()));
		
	    // Get email template
		Map<String, Object> map = new HashMap<>();
		map.put("userName", userVO.getName());
		map.put("userId", userVO.getLoginId());
		map.put("url", url.toString());
		String content = emailTemplate.processEmailMappingFooterDoNotReply(ConstantEmailTemplate.PASS_RESET_EMAIL, map);
		
		ProcessSentEmail processSentEmail = new ProcessSentEmail("PASSWORD RESET EMAIL", content, vo.getEmailAddress());
		Thread thread = new Thread(processSentEmail);
		thread.start();
	}
	
