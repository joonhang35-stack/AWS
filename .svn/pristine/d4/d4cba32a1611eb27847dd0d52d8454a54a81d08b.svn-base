			// Get email template
//			Map<String, Object> map = new HashMap<>();
			Map root = new HashMap();
			
		    StringBuilder url = new StringBuilder();
		    url.append(EmailProperties.FRONTEND_URL_UPD_SUPPL);
		    
		    url.append("?key=").append(URLEncoder.encode(AESEncryption.encrypt("supplId=" + supplierProfileUpdateVO.getIdSupplier() + "&uuid=" + supplierProfileUpdateVO.getUuid())));
			
		    root.put("url", url);
		    root.put("footerContent", "Please do not reply to this email, as it was sent from an unmonitored email address. The update link will expire once submitted, and you will no longer be able to complete the profile update after it expires. If you have any questions, please contact us at enquiry@applevacations.my or call our office at 03-2705 8299. Thank you.");
			
			String content = emailTemplate.processEmailMappingFooterDoNotReply(ConstantEmailTemplate.SUPPL_PROFILE_UPDATE, root);
			
			List<String> ccEmailList = new ArrayList<String>();
			ccEmailList.add(userVO.getEmailAddress());
			
			ProcessSentEmail processSentEmail = new ProcessSentEmail(CommonConstant.EMAIL_FULL_COMP_NAME, "Data Collection for E-Invoice Implementation", content, supplierProfileUpdateVO.getEmail(), null, ccEmailList);
			Thread thread = new Thread(processSentEmail);
			thread.start();
		} catch ( Exception e) {
			throw new BusinessException(e);
		}
	}
	
	@Override
	public void sendEInvNotifyEmail(InvoiceVO invoiceVO, String toEmailAddr, List<String> ccEmailList) throws Exception {
		if (invoiceVO == null)	return;
		
		try {
			Map<String, Object> map = new HashMap<>();
			
			map.put("prefixVal", LookupItemUtils.getInvPrefix(invoiceVO.getCompanyId())); 
			map.put("code", invoiceVO.getCode());
			
			if (invoiceVO.geteInvoiceDocument() != null) {
				map.put("eInvoiceStatus", invoiceVO.geteInvoiceDocument().getStatus());
				
				if (StringUtils.isNotBlank(invoiceVO.geteInvoiceDocument().getDocumentStatusReason())) {
					map.put("reason", invoiceVO.geteInvoiceDocument().getDocumentStatusReason());
				}
			}
			
			map.put("datetime", sdf2.format(new Date()));
			map.put("testing", EInvoiceProperties.isTesting());
			
			String content = emailTemplate.processEmailMappingFooterDoNotReply(ConstantEmailTemplate.E_INV_NOTIFY, map);
			
			System.out.println("CYY toEmailAddr: " + toEmailAddr);
			
			String subject = EInvoiceProperties.isTesting() ? "TESTING | E-Invoice Submission" : "E-Invoice Submission";
			
			ProcessSentEmail processSentEmail = new ProcessSentEmail(CommonConstant.EMAIL_FULL_COMP_NAME, subject, content, toEmailAddr, null, ccEmailList);
			Thread thread = new Thread(processSentEmail);
			thread.start();
		} catch (Exception e) {
			throw e;
		}
	}
	
	@Override
	public void sendEInvNotifyEmail(String code, String eInvoiceStatus, String statusReason, Long idCompany, String toEmailAddr, List<String> ccEmailList) throws Exception {
		try {
			Map<String, Object> map = new HashMap<>();
			
			map.put("prefixVal", LookupItemUtils.getInvPrefix(idCompany));
			map.put("code", code);
			map.put("eInvoiceStatus", eInvoiceStatus);
			map.put("reason", statusReason);
			map.put("datetime", sdf2.format(new Date()));
			map.put("testing", EInvoiceProperties.isTesting());
			map.put("bgColor", CommonConstant.EMAIL_BG_COLOR);
			
			String content = emailTemplate.processEmailMappingFooterDoNotReply(ConstantEmailTemplate.E_INV_NOTIFY, map);
			
			System.out.println("CYY toEmailAddr: " + toEmailAddr);
			
			String subject = EInvoiceProperties.isTesting() ? "TESTING | E-Invoice Submission" : "E-Invoice Submission";
			
			ProcessSentEmail processSentEmail = new ProcessSentEmail(CommonConstant.EMAIL_FULL_COMP_NAME, subject, content, toEmailAddr, null, ccEmailList);
			Thread thread = new Thread(processSentEmail);
			thread.start();
		} catch (Exception e) {
			throw e;
		}
	}
	
	@Override
	public void sendCustomerFeedbackEmailing(final List<FeedbackVO> feedbackList) throws BusinessException {
		String updatedByTmp = "SYSTEM";
		try {
			if (BaseContext.getUserFullName() != null) {
				updatedByTmp = BaseContext.getUserFullName();
			} else if (BaseContext.getLoginId() != null) {
				updatedByTmp = BaseContext.getLoginId();
			}
		} catch (Exception e) {
			// Ignore
		}
		final String updatedBy = updatedByTmp;

		new Thread(new Runnable() {
			@Override
			public void run() {
				try {
					System.out.println("FeedbackEmailJob triggered (emailing phase)");
					if (CollectionUtils.isEmpty(feedbackList)) {
						return;
					}

					for (FeedbackVO feedbackVO : feedbackList) {
						try {
							if (StringUtils.isBlank(feedbackVO.getCustomerEmail())) {
								System.out.println(feedbackVO.getInvId() + ": the customer email is empty");
								continue;
							}
							
							String encryptedKey = "";
							String newUuid = UUID.randomUUID().toString();

							try {
								String rawValue =
										"custId=" + feedbackVO.getCustomerId()
										+ "&tourDepId=" + feedbackVO.getIdTourDeparture()
										+ "&uuid=" + newUuid;

								encryptedKey = URLEncoder.encode(AESEncryption.encrypt(rawValue), "UTF-8");
								System.out.println("feedback url raw value: " + rawValue);
							} catch (Exception ex) {
								throw new BusinessException(ex);
							}

							String feedbackUrl = EmailProperties.FRONTEND_URL_FEEDBACK_CUSTOMER + "?key=" + encryptedKey;
							String subject = "We'd love your feedback — " + StringUtils.defaultIfBlank(feedbackVO.getTourCode(), "");

							Map root = new HashMap();
							root.put("customerName", StringUtils.defaultIfBlank(feedbackVO.getCustomerName(), "Valued Customer"));
							root.put("url", feedbackUrl);
							root.put("footerContent", "Please do not reply to this email, as it was sent from an unmonitored email address. If you have any questions, please contact us at enquiry@applevacations.my or call our office at 03-2705 8299. Thank you.");

							String content = emailTemplate.processEmailMappingFooterDoNotReply(ConstantEmailTemplate.CUSTOMER_FEEDBACK_EMAIL, root);

							//feedbackVO.setCustomerEmail(""); // debug purpose
							ProcessSentEmail processSentEmail = new ProcessSentEmail(CommonConstant.EMAIL_FULL_COMP_NAME, subject, content, feedbackVO.getCustomerEmail(), null, null);
							Thread thread = new Thread(processSentEmail);
							thread.start();
							
							feedbackDAO.updateFeedbackForEmailSent(feedbackVO.getTourBookingId(), newUuid, "E", updatedBy);
							Thread.sleep(1000);

						} catch (Exception e) {
							System.err.println(
									"Failed to send feedback email. "
									+ "TourDepId=" + feedbackVO.getIdTourDeparture()
									+ "FeedbackId=" + feedbackVO.getIdFeedback()
									+ ", Email=" + feedbackVO.getCustomerEmail()
									+ ", Error=" + e.getMessage());
						}
					}
				} catch (Exception e) {
					System.err.println("Error running feedback emailing thread: " + e.getMessage());
					e.printStackTrace();
				}
			}
		}).start();
	}


//				} catch (Exception e) {
//					System.err.println("Error running feedback emailing thread: " + e.getMessage());
//					e.printStackTrace();
//				}
//			}
//		}).start();
	
	
