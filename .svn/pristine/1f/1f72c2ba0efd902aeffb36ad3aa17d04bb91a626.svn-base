package com.bcs.zsg.common.helper;

import java.net.URL;
import java.text.SimpleDateFormat;
import java.util.Date;

import org.primefaces.json.JSONObject;

import java.io.OutputStream;
import java.net.HttpURLConnection;

public class CRMUtils {
	public static final String HTTP_GET = "GET";
    public static final String HTTP_POST = "POST";
    public static final String HTTP_PUT = "PUT";
    public static final String HTTP_DELETE = "DELETE";
    
	private static final String TENANT_ID = "AV";
    private static final String API_KEY = "CXDP_zfc0dEPZheQRcas8wj3APF6iy519AWCsHZZXpS0d0LA";
    public static String callAPI(String urlStr, String method, String requestBody) throws Exception {

    	URL url = new URL(urlStr);
        HttpURLConnection connection = HttpUtils.openHttpURLConnection(
                url,
                method,
                "",
                ""
        );
        
        connection.setRequestProperty("X-TENANT-ID", TENANT_ID);
        connection.setRequestProperty("X-API-KEY", API_KEY);
        
        if (requestBody != null && !requestBody.isEmpty()) {
            connection.setDoOutput(true);
            try (OutputStream os = connection.getOutputStream()) {
                byte[] input = requestBody.getBytes("utf-8");
                os.write(input, 0, input.length);
            }
        }
        
        int status = connection.getResponseCode();
        System.out.println("Status: "+status);
        if (status != HttpUtils.STATUS_CD_OK) {
            String error = HttpUtils.getConnectionResponse(connection);
            throw new RuntimeException("API Error: " + status + " - " + error);
        }
        return HttpUtils.getConnectionResponse(connection);
    }
    
    public static String getCustomerPoint(String customerId) throws Exception {
    	String urlStr = "http://crm-uat.applevacations.my:3030/aws-api-uat/api/webhooks/member/" + customerId;     
        return callAPI(urlStr, HTTP_GET, null);
    }
    
    public static String getPointExpirySummary(String customerId) throws Exception {
    	String urlStr = "http://crm-uat.applevacations.my:3030/aws-api-uat/api/webhooks/member/" + customerId + "/points-expiry-summary";     
        return callAPI(urlStr, HTTP_GET, null);
    }
    
    public static String getPointHistory(String customerId, Date fromDate, Date toDate) throws Exception {
    	String urlStr = "http://crm-uat.applevacations.my:3030/aws-api-uat/api/webhooks/member/" + customerId + "/points-history";
    	JSONObject json = new JSONObject();
    	SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
    	json.put("fromDate", sdf.format(fromDate));
    	json.put("toDate", sdf.format(toDate));

    	String requestBody = json.toString();
        return callAPI(urlStr, HTTP_POST, requestBody);
    }
    
    public static String getPointTransfer(String pointsFromId, String pointsToId, Integer points) throws Exception {
    	String urlStr = "http://crm-uat.applevacations.my:3030/aws-api-uat/api/webhooks/member/points-transfer";
    	JSONObject json = new JSONObject();
    	json.put("pointsFromId", pointsFromId);
    	json.put("pointsToId", pointsToId);
    	json.put("points", points);

    	String requestBody = json.toString();
        return callAPI(urlStr, HTTP_POST, requestBody);
    }
    
    public static String getPointAdjustment(String customerId, int points, String remarks, String referenceId, String adjustedBy, String status, Date pointsEffective, int expiryDays, boolean isExpiry) throws Exception {
    	String urlStr = "http://crm-uat.applevacations.my:3030/aws-api-uat/api/webhooks/member/points-adjustment";
    	JSONObject json = new JSONObject();
    	SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss.SSS");
    	json.put("customerId", customerId);
    	json.put("points", points);
    	json.put("remarks", remarks);
    	json.put("referenceId", referenceId);
    	json.put("adjustedBy", adjustedBy);
    	json.put("status", status);
    	json.put("pointsEffectiveDate", sdf.format(pointsEffective));
    	json.put("expiryDays", expiryDays);
    	json.put("isExpiryEndOfMonths", isExpiry);

    	String requestBody = json.toString();
        return callAPI(urlStr, HTTP_POST, requestBody);
    }
    
    
}
