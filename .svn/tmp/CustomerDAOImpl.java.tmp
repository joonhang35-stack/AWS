	 */
	@Override
	public void terminatePersonSubInfo(String table, Long personId) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		if ("customer_remarks".equals(table)) sb.append("UPDATE ").append(table).append(" SET status_cd = :statusCode WHERE id_cust = :personId");
		else sb.append("UPDATE ").append(table).append(" SET status_cd = :statusCode WHERE id_person = :personId");
		
		Query query = createSQLQuery(sb.toString());
		query.setString("statusCode", BaseConstant.STATUS_DELETED);
		query.setLong("personId", personId);
		query.executeUpdate();
	}

