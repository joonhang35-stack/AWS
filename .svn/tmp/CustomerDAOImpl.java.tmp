	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#getCustomerListSearch(java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<CustDetailsVO> getCustomerListSearch(Long companyId) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT distinct ").
			append("c.id AS 'custId',").
			append("case when c.pc_type_cd = 'C' then p2.id when c.pc_type_cd = 'P' then p.id  end as personId,").
			append("case when c.pc_type_cd = 'C' then (case when p2.salutation_cd != '"+ LookupItemConstant.SALUTATION_EMPTY_CD +"' then p2.salutation_cd else '' end) when c.pc_type_cd = 'P' then (case when p.salutation_cd != '"+ LookupItemConstant.SALUTATION_EMPTY_CD +"' then p.salutation_cd else '' end) end as salutation_cd,").
			append("case when c.pc_type_cd = 'C' then p2.first_name when c.pc_type_cd = 'P' then p.first_name end as first_name,").
			append("case when c.pc_type_cd = 'C' then p2.last_name when c.pc_type_cd = 'P' then p.last_name end as last_name,").
			append("case when c.pc_type_cd = 'C' then p2.email when c.pc_type_cd = 'P' then p.email end as email,").
			append("o.name AS 'corporate', c.id_pc, c.pc_type_cd, ").
			append("case when c.pc_type_cd = 'C' then pa2.addr_1 when c.pc_type_cd = 'P' then pa1.addr_1 end as address1,").
			append("case when c.pc_type_cd = 'C' then pa2.addr_2 when c.pc_type_cd = 'P' then pa1.addr_2 end as address2,").
			append("case when c.pc_type_cd = 'C' then pa2.addr_3 when c.pc_type_cd = 'P' then pa1.addr_3 end as address3,").
			append("case when c.pc_type_cd = 'C' then pa2.city when c.pc_type_cd = 'P' then pa1.city end as city,").
			append("case when c.pc_type_cd = 'C' then pa2.state when c.pc_type_cd = 'P' then pa1.state end as state,").
			append("case when c.pc_type_cd = 'C' then pa2.postcode when c.pc_type_cd = 'P' then pa1.postcode end as postcode, ").
			append("case when c.pc_type_cd = 'C' then pa2.id_country when c.pc_type_cd = 'P' then pa1.id_country end as country, ").
			append("c.code ").
			append("FROM customer c left join person p on (c.pc_type_cd = 'P' and c.id_pc = p.id) ").
			append("left join corporate o on (c.pc_type_cd = 'C' AND c.id_corporate = o.id ) ").
			append("left join person p2 on (c.pc_type_cd = 'C' and c.id_pc = p2.id) ").
			append("left join person_address pa1 on pa1.id_person = p.id ").
			append("left join corporate_address pa2 on pa2.id_corporate = o.id ").
			append(" WHERE id_company = '" + companyId + "' and status_cd = '" + CommonConstant.STATUS_CD_ACTIVE + "' ").
			append("ORDER BY last_name, first_name");
		
		Query query = createSQLQuery(sb.toString());
		List<Object> objList = query.list();
		List<CustDetailsVO> list = new ArrayList<CustDetailsVO>();
 
		CustDetailsVO vo;
		if (CollectionUtils.isNotEmpty(objList)) {
			for (Iterator<Object> it = objList.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				vo = new CustDetailsVO();
				vo.setAddressVO(new AddressVO());
				
				if (row[0] != null) vo.setCustId(((BigInteger) row[0]).longValue());
				if (row[1] != null) vo.setPersonId(((BigInteger) row[1]).longValue());
				vo.setSalutation((String) row[2]);
				vo.setFirstName((String) row[3]);
				vo.setLastName((String) row[4]);
				vo.setContPersonName(row[4] + " " + row[3]);
				if (row[5] != null) vo.setEmail((String) row[5]);
				if (row[6] != null) vo.setCompanyName((String) row[6]);
				if (row[7] != null) vo.setCorId(((BigInteger) row[7]).longValue());
				if (row[8] != null) vo.setCustType((String) row[8]);
				if (row[9] != null) vo.getAddressVO().setAddr1((String) row[9]);
				if (row[10] != null) vo.getAddressVO().setAddr2((String) row[10]);
				if (row[11] != null) vo.getAddressVO().setAddr3((String) row[11]);
				if (row[12] != null) vo.getAddressVO().setCity((String) row[12]);
				if (row[13] != null) vo.getAddressVO().setState((String) row[13]);
				if (row[14] != null) vo.getAddressVO().setPostcode((String) row[14]);
				if (row[15] != null) vo.getAddressVO().setCountryId(((BigInteger) row[15]).longValue());
				if (row[16] != null) vo.setCode((String) row[16]);
				list.add(vo);
			}
		}
		return list;
	}
	
	/* (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#getCustomerList(java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<CustomerVO> getCustomerList(Long companyId) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		sb.append("SELECT distinct ").
		append("c.id AS 'custId',").
		append("case when c.pc_type_cd = 'C' then p2.id when c.pc_type_cd = 'P' then p.id  end as personId,").
		append("case when c.pc_type_cd = 'C' then (case when p2.salutation_cd != '"+ LookupItemConstant.SALUTATION_EMPTY_CD +"' then p2.salutation_cd else '' end) when c.pc_type_cd = 'P' then (case when p.salutation_cd != '"+ LookupItemConstant.SALUTATION_EMPTY_CD +"' then p.salutation_cd else '' end) end as salutation_cd,").
		append("case when c.pc_type_cd = 'C' then p2.first_name when c.pc_type_cd = 'P' then p.first_name end as first_name,").
		append("case when c.pc_type_cd = 'C' then p2.last_name when c.pc_type_cd = 'P' then p.last_name end as last_name,").
		append("case when c.pc_type_cd = 'C' then p2.email when c.pc_type_cd = 'P' then p.email end as email,").
		append("o.name AS 'corporate', c.id_pc, c.pc_type_cd,").
		append("(SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM person_contact WHERE id_person = p.id) AS 'perContacts',").
		append("(SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM corporate_contact WHERE id_corporate = c.id_corporate) AS 'corContacts', ").
		append("(SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM person_identity WHERE id_person = p.id) AS 'identities',").
		append("c.corporate_name, c.code ").
		append(" FROM customer c left join person p on (c.pc_type_cd = 'P' and c.id_pc = p.id) ").
		append("left join corporate o on (c.pc_type_cd = 'C' AND c.id_corporate = o.id )").
		append("left join person p2 on (c.pc_type_cd = 'C' and c.id_pc = p2.id)").
		append(" WHERE id_company = '" + companyId + "' and status_cd = '" + CommonConstant.STATUS_CD_ACTIVE + "' ").
		append("ORDER BY last_name, first_name");
		
		Query query = createSQLQuery(sb.toString());
		List<Object> objList = query.list();
		List<CustomerVO> list = new ArrayList<CustomerVO>();
		
		if (CollectionUtils.isNotEmpty(objList)) {
			for (Iterator<Object> it = objList.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				CustomerVO vo = new CustomerVO();
				vo.setId(((BigInteger) row[0]).longValue()); 
				vo.setPersonId(((BigInteger) row[1]).longValue());
				vo.setSalutationCd((String) row[2]);
				vo.setFirstName((String) row[3]);
				vo.setLastName((String) row[4]);
				vo.setEmail((String) row[5]);
				vo.setCorporate((String) row[6]);
				vo.setPersCorpId(((BigInteger) row[7]).longValue());
				vo.setPcTypeCd((String) row[8]);
				vo.setPerContacts((String) row[9]);
				vo.setCorContacts((String) row[10]);
				vo.setIdentities((String) row[11]);
				vo.setCorporateName((String) row[12]);
				vo.setCode((String) row[13]);
				list.add(vo);
			}
		}
		return list;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#getCustomer(java.lang.Long)
	 */
	@Override
	public CustomerVO getCustomer(Long idCust) throws BusinessException {
		Criteria criteria = createCriteria(CustomerVO.class);
		criteria.add(Restrictions.eq("id", idCust));
		return (CustomerVO) criteria.uniqueResult();
	}
	
	/* (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#getCustomerDetail()
	 */
	@SuppressWarnings("unchecked")
	@Override
	public CustomerVO getCustomerDetail(Long idCust) throws BusinessException {
		//Query query = null;
		Long personId;
		
		Criteria criteria = createCriteria(CustomerVO.class);
		criteria.add(Restrictions.eq("id", idCust));
		CustomerVO vo = (CustomerVO) criteria.uniqueResult();
		
		vo.setBillAddressVO(new AddressVO());
		vo.setMailAddressVO(new AddressVO());
		vo.setCorBillAddressVO(new CorAddressVO());
		vo.setCorMailAddressVO(new CorAddressVO());
		vo.setIdentityList(new ArrayList<IdentityVO>());
		vo.setPersonLangList(new ArrayList<PersonLangVO>());
		vo.setPersonMealList(new ArrayList<PersonMealVO>());
		vo.setPersonContactList(new ArrayList<PersonContactVO>());
		vo.setCorContactList(new ArrayList<CorContactVO>());
		vo.setPersonClassList(new ArrayList<PersonClassVO>());
		vo.setPersonComplicationList(new ArrayList<PersonComplicationVO>());
		vo.setCustRemarksList(new ArrayList<CustomerRemarksVO>());
		vo.setAddressList(new ArrayList<AddressVO>());
		vo.setCorAddressList(new ArrayList<CorAddressVO>());
		vo.setCorPicList(new ArrayList<CorPersonInChargeVO>());
		
		if (vo.getPcTypeCd().equals("C")) {
			criteria = createCriteria(CorporateVO.class);
			criteria.add(Restrictions.eq("id", vo.getCorporateId()));
			CorporateVO corporateVO = (CorporateVO) criteria.uniqueResult();
			vo.setCorporateVO(corporateVO);
			
			criteria = createCriteria(PersonVO.class);
			criteria.add(Restrictions.eq("id", vo.getPersCorpId()));
			PersonVO personVO = (PersonVO) criteria.uniqueResult();
			if (personVO != null) { 
				personVO.setSalutation(StringUtils.equals(personVO.getSalutation(), LookupItemConstant.SALUTATION_EMPTY_CD) ? "" : personVO.getSalutation());
				vo.setPersonVO(personVO); 
			}
			
			personId = corporateVO.getPersonId();
			
			criteria = createCriteria(CorAddressVO.class);
			criteria.add(Restrictions.eq("corporateId", vo.getCorporateVO().getId()));
			List<CorAddressVO> corAddressList = criteria.list();
			if (CollectionUtils.isNotEmpty(corAddressList)) vo.setCorAddressList(corAddressList);
			
			criteria = createCriteria(CorContactVO.class);
			criteria.add(Restrictions.eq("corporateId", vo.getCorporateVO().getId()));
			criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
			List<CorContactVO> contactList = criteria.list();
			for(CorContactVO ccVO : contactList) {
				ccVO.setFullPhoneNo(FunctionUtils.phoneNumber(ccVO.getCountryCd(), ccVO.getContactNo()));
			}
			if (CollectionUtils.isNotEmpty(contactList)) vo.setCorContactList(contactList);
			
			criteria = createCriteria(CorPersonInChargeVO.class);
			criteria.add(Restrictions.eq("corporateId", vo.getCorporateVO().getId()));
			criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
			List<CorPersonInChargeVO> picList = criteria.list();
			if (CollectionUtils.isNotEmpty(picList)) vo.setCorPicList(picList);
			
		} else {
			criteria = createCriteria(CorporateVO.class);
			criteria.add(Restrictions.eq("id", vo.getCorporateId()));
			CorporateVO corporateVO = (CorporateVO) criteria.uniqueResult();
			if(corporateVO == null) {
				vo.setCorporateVO(new CorporateVO());
			}else
				vo.setCorporateVO(corporateVO);
			
			criteria = createCriteria(PersonVO.class);
			criteria.add(Restrictions.eq("id", vo.getPersCorpId()));
			PersonVO personVO = (PersonVO) criteria.uniqueResult();
			if (personVO != null) {
				personVO.setSalutation(StringUtils.equals(personVO.getSalutation(), LookupItemConstant.SALUTATION_EMPTY_CD) ? "" : personVO.getSalutation());
				vo.setPersonVO(personVO); 
			}
			
			personId = vo.getPersCorpId();
			
			criteria = createCriteria(AddressVO.class);
			criteria.add(Restrictions.eq("personId", vo.getPersonVO().getId()));
			List<AddressVO> addressList = criteria.list();
			if (CollectionUtils.isNotEmpty(addressList)) vo.setAddressList(addressList);
			
			criteria = createCriteria(PersonContactVO.class);
			criteria.add(Restrictions.eq("personId", vo.getPersonVO().getId()));
			criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
			List<PersonContactVO> contactList = criteria.list();
			if (CollectionUtils.isNotEmpty(contactList)) {
				vo.setPersonContactList(contactList);
				for(PersonContactVO pcVO: vo.getPersonContactList()) {
					pcVO.setFullPhoneNo(FunctionUtils.phoneNumber(pcVO.getCountryCd(), pcVO.getNumber()));
				}
			}
			
			criteria = createCriteria(PersonAttachmentVO.class);
			criteria.add(Restrictions.eq("personId", vo.getPersonVO().getId()));
			criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
			List<PersonAttachmentVO> attachmentList = criteria.list();
			if (CollectionUtils.isNotEmpty(attachmentList)) vo.setPersonAttachmentList(attachmentList);
		}
		
		criteria = createCriteria(IdentityVO.class);
		criteria.add(Restrictions.eq("personId", personId));
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
		List<IdentityVO> identityList = criteria.list();
        if (CollectionUtils.isNotEmpty(identityList)) {
        	vo.setIdentityList(identityList);
        	for (IdentityVO iVO : identityList) {
        		iVO.setIdentityDetailVO(new IdentityDetailVO());
        		Query subQuery = createQuery("FROM IdentityDetailVO WHERE id_person_identity = :id");
        		subQuery.setParameter("id", iVO.getId());
        		IdentityDetailVO identityDetailVO = (IdentityDetailVO) subQuery.uniqueResult();
        		if (identityDetailVO != null) iVO.setIdentityDetailVO(identityDetailVO);
        	}
        }
        
        criteria = createCriteria(PersonLangVO.class);
        criteria.add(Restrictions.eq("personId", vo.getPersonVO().getId()));
		List<PersonLangVO> langList = criteria.list();
		if (CollectionUtils.isNotEmpty(langList)) {
			vo.setPersonLangList(langList);
			vo.setLangCdList(new ArrayList<String>());
			for(PersonLangVO langVO : langList) {
				vo.getLangCdList().add(langVO.getLangCd());
			}
		}
        
		criteria = createCriteria(PersonMealVO.class);
		criteria.add(Restrictions.eq("personId", vo.getPersonVO().getId()));
		List<PersonMealVO> mealList = criteria.list();
		
		if (CollectionUtils.isNotEmpty(mealList)) {
			vo.setPersonMealList(mealList);
			vo.setMealList(new ArrayList<String>());
			for(PersonMealVO mealVO : mealList) {
				vo.getMealList().add(mealVO.getMealCd());
			}
		}
        
		criteria = createCriteria(PersonClassVO.class);
		criteria.add(Restrictions.eq("personId", vo.getPersonVO().getId()));
		List<PersonClassVO> classList = criteria.list();
		if (CollectionUtils.isNotEmpty(classList)) {
			vo.setPersonClassList(classList);
			vo.setClassList(new ArrayList<String>());
			for(PersonClassVO classVO : classList) {
				vo.getClassList().add(classVO.getClassCd());
			}
		}
		
		criteria = createCriteria(PersonComplicationVO.class);
		criteria.add(Restrictions.eq("personId", vo.getPersonVO().getId()));
		List<PersonComplicationVO> complicationList = criteria.list();
		if (CollectionUtils.isNotEmpty(complicationList)) {
			vo.setPersonComplicationList(complicationList);
			vo.setCompliList(new ArrayList<String>());
			for(PersonComplicationVO compliVO : complicationList) {
				vo.getCompliList().add(compliVO.getComplicationCd());
			}
		}
		
		criteria = createCriteria(CustomerRemarksVO.class);
		criteria.add(Restrictions.eq("custId", vo.getId()));
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
		List<CustomerRemarksVO> remarkList = criteria.list();
		if (CollectionUtils.isNotEmpty(remarkList)) vo.setCustRemarksList(remarkList);
		
		criteria = createCriteria(PersonEmailVO.class);
		criteria.add(Restrictions.eq("statusCode", BaseConstant.STATUS_ACTIVE));
		criteria.add(Restrictions.eq("idPerson", vo.getPersonVO().getId()));
		List<PersonEmailVO> emailList = criteria.list();
		if (CollectionUtils.isNotEmpty(emailList)) vo.getPersonVO().setEmailList(emailList);
		
		return vo;
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#getCustomerSimpleDetail(java.lang.Long)
	 */
	@Override
	public CustomerVO getCustomerSimpleDetail(Long idCust) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT ").
			append("custId, personId, (case when salutation_cd != '"+ LookupItemConstant.SALUTATION_EMPTY_CD +"' then salutation_cd else '' end), firstname, lastname, email, corporate, id_pc, pc_type_cd, ").
			append("(SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM person_contact WHERE id_person = A.personId AND status_cd = 'A') AS 'perContacts', ").
			append("(SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM corporate_contact WHERE id_corporate = A.id_corporate AND status_cd = 'A') AS 'corContacts', ").
			append("(SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM person_identity WHERE id_person = A.personId AND status_cd = 'A') AS 'identities', ").
			append("corName, code, nickName, ").
			
	        append("(SELECT GROUP_CONCAT(CONCAT(type_cd, '|', country_cd) SEPARATOR ',') FROM person_contact WHERE id_person = A.personId AND status_cd = 'A' AND country_cd IS NOT NULL AND country_cd != '') AS 'perCountryCode', ").
	        append("(SELECT GROUP_CONCAT(CONCAT(type_cd, '|', country_cd) SEPARATOR ',') FROM corporate_contact WHERE id_corporate = A.id_corporate AND status_cd = 'A' AND country_cd IS NOT NULL AND country_cd != '') AS 'corCountryCode', ").
	        
	        append(FunctionUtils.fullPhoneNoSQL()).
	        append("FROM person_contact WHERE id_person = A.personId AND status_cd = 'A' AND number IS NOT NULL AND number != '') AS 'perFullPhoneNo', ").
	        append(FunctionUtils.fullPhoneNoSQL()).
	        append("FROM corporate_contact WHERE id_corporate = A.id_corporate AND status_cd = 'A' AND number IS NOT NULL AND number != '') AS 'corFullPhoneNo' ").		
			append("FROM (").
			append("SELECT ").
			append("c.id_corporate, c.status_cd, c.id AS 'custId', p.id  as personId, (case when p.salutation_cd != '"+ LookupItemConstant.SALUTATION_EMPTY_CD +"' then p.salutation_cd else '' end) as salutation_cd, ").
			append("IFNULL(p.first_name, '') as firstname, IFNULL(p.last_name, '') as lastname, p.nick_name as nickName, ").
			append("p.email as email, o.name AS 'corporate', c.id_pc, c.pc_type_cd, c.corporate_name AS 'corName', c.code AS 'code' ").
			append("FROM customer c ").
			append("left join person p on c.id_pc = p.id ").
			append("left join corporate o on c.id_corporate = o.id ").
			append("WHERE c.id = ").append(idCust).append(") A");
		
		Query query = createSQLQuery(sb.toString());
		Object[] row = (Object[]) query.uniqueResult();
		
		CustomerVO vo = new CustomerVO();
		vo.setId(((Number) row[0]).longValue()); 
		vo.setPersonId(((Number) row[1]).longValue());
		vo.setSalutationCd((String) row[2]);
		vo.setFirstName((String) row[3]);
		vo.setLastName((String) row[4]);
		vo.setCustName(vo.getLastName() + " " + vo.getFirstName());
		vo.setEmail((String) row[5]);
		vo.setCorporate((String) row[6]);
		vo.setPersCorpId(((BigInteger) row[7]).longValue());
		vo.setPcTypeCd((String) row[8]);
		vo.setPerContacts((String) row[9]);
		vo.setCorContacts((String) row[10]);
		if (vo.getPerContacts() == null && vo.getCorContacts() != null) vo.setPerContacts(vo.getCorContacts());
		else if (vo.getPerContacts() != null && vo.getCorContacts() != null) vo.setPerContacts(vo.getPerContacts() + "," + vo.getCorContacts());
		vo.setIdentities((String) row[11]);
		vo.setCorporateName((String) row[12]);
		vo.setCode((String) row[13]);
		vo.setNickName((String) row[14]);
		
	    // 15 perCountryCode, 16 corCountryCode
	    String perCountryCode = (String) row[15];
	    String corCountryCode = (String) row[16];
	    vo.setCountryCode(corCountryCode != null ? corCountryCode : perCountryCode);

	    // 17 perFullPhoneNo, 18 corFullPhoneNo
	    String perFullPhoneNo = (String) row[17];
	    String corFullPhoneNo = (String) row[18];
	    vo.setFullPhoneNo(corFullPhoneNo != null ? corFullPhoneNo : perFullPhoneNo);

		return vo;
	}

	/* (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#deleteCustomer(com.bcs.zsg.sales.vo.CustomerVO)
	 */
	@Override
	public void deleteCustomer(CustomerVO customerVO) throws BusinessException {
		Query query = createQuery("UPDATE CustomerVO SET status = :status WHERE id = :id");
		query.setString("status", CommonConstant.STATUS_CD_INACTIVE);
		query.setLong("id", customerVO.getId());
		query.executeUpdate();
	}
	
	@Override
	public void updateCustomerStatus(CustomerVO customerVO) throws BusinessException {
		Query query = createQuery("UPDATE CustomerVO SET status = :status WHERE id = :id");
		query.setString("status", customerVO.getStatusCode());
		query.setLong("id", customerVO.getId());
		query.executeUpdate();
	}

	/* (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#getCountryList()
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<CountryVO> getCountryList() {
		Criteria criteria = createCriteria(CountryVO.class);
		return criteria.list();
	}

	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#getCustomerInfo(java.lang.Long)
	 */
	@Override
	public CustomerVO getCustomerInfo(Long idCust) throws BusinessException {
		Criteria criteria = createCriteria(CustomerVO.class);
		criteria.add(Restrictions.eq("id", idCust));
		CustomerVO vo = (CustomerVO) criteria.uniqueResult();
		
		Query query = null;
		if (vo.getPcTypeCd().equals("C")) {
			query = createQuery("FROM CorporateVO WHERE id = :id");
			query.setParameter("id", vo.getPersCorpId());
			CorporateVO corporateVO = (CorporateVO) query.uniqueResult();
			vo.setCorporateVO(corporateVO);
			
			query = createQuery("FROM PersonVO WHERE id = :id");
			query.setParameter("id", corporateVO.getPersonId());
			PersonVO personVO = (PersonVO) query.uniqueResult();
			if (personVO != null) vo.setPersonVO(personVO);
			
		} else {
			query = createQuery("FROM PersonVO WHERE id = :id");
			query.setParameter("id", vo.getPersCorpId());
			PersonVO personVO = (PersonVO) query.uniqueResult();
			if (personVO != null) vo.setPersonVO(personVO);
		}
		return vo;
	}
	
	/* (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#isIdentityExisted(com.bcs.zsg.purchase.vo.IdentityVO, java.lang.Long)
	 */
	@Override
	public boolean isIdentityExisted(IdentityVO identityVO, Long companyId) throws BusinessException {
		// Filter by inactive and company id
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT count(*)" +
			" FROM customer c, person p, person_identity pi" +
			" WHERE c.id_pc=P.id AND p.id=pi.id_person AND c.pc_type_cd = 'P' and" +
			" pi.type_cd = :idType AND pi.number = :idNo AND pi.number != '' AND c.id_company = :idCompany AND c.status_cd <> :statusCd AND pi.status_cd = :piStatusCd");
		if (identityVO.getId() != null) sb.append(" and pi.id <> :idIdentity");
		
		Query query = createSQLQuery(sb.toString());
		if (identityVO.getId() != null) query.setLong("idIdentity", identityVO.getId());
		query.setString("idType", identityVO.getIdType());
		query.setString("idNo", identityVO.getIdNo());
		query.setLong("idCompany", companyId);
		query.setString("statusCd", CommonConstant.STATUS_CD_INACTIVE);
		query.setString("piStatusCd", BaseConstant.STATUS_ACTIVE);
		if (((BigInteger) query.uniqueResult()).intValue() > 0) return true;
		
		return false;
	}
	
	public boolean isEmailExisted(String email, Long companyId, Long personId, String pcTypeCd) throws BusinessException {
	    StringBuilder sb = new StringBuilder();
	    
	    sb.append("SELECT count(*)")
	      .append(" FROM customer c")
	      .append(" JOIN person_email pe ON c.id_pc = pe.id_person")
	      .append(" WHERE pe.email = :email")
	      .append(" AND c.id_company = :idCompany")
	      .append(" AND c.status_cd <> :statusCd")
	      .append(" AND pe.status_cd <> :statusCdEmail")
	      .append(" AND c.pc_type_cd = :pcTypeCd");

	    // NEW: If personId is provided, exclude that specific record
	    if (personId != null) {
	        sb.append(" AND pe.id_person <> :personId");
	    }

	    Query query = createSQLQuery(sb.toString());
	    
	    query.setString("email", email);
	    query.setLong("idCompany", companyId);
	    query.setString("statusCd", CommonConstant.STATUS_CD_INACTIVE);
	    query.setString("statusCdEmail", CommonConstant.STATUS_CD_DELETE);
	    query.setString("pcTypeCd", pcTypeCd);
	    
	    // NEW: Set the personId parameter
	    if (personId != null) {
	        query.setLong("personId", personId);
	    }
	    
	    return ((BigInteger) query.uniqueResult()).intValue() > 0;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#isCustAvailableToDel(com.bcs.zsg.sales.vo.CustomerVO)
	 */
	@Override
	public boolean isCustNotAbleToDel(CustomerVO customerVO) throws BusinessException {
		Query query = createSQLQuery("SELECT COUNT(id) FROM invoice WHERE id_company = :idCompany AND id_customer = :idCust AND status_cd NOT IN (:statusCC, :statusVD)");
		query.setLong("idCompany", customerVO.getCompanyId());
		query.setLong("idCust", customerVO.getId());
		query.setString("statusCC", CommonConstant.STATUS_CD_CANCELLED);
		query.setString("statusVD", CommonConstant.STATUS_CD_VOID);
		if (((BigInteger) query.uniqueResult()).intValue() > 0) return true;
		
		query = createSQLQuery("SELECT COUNT(id) FROM tour_booking WHERE id_company = :idCompany AND id_cust = :idCust AND status_cd NOT IN (:statusCC, :statusVD)");
		query.setLong("idCompany", customerVO.getCompanyId());
		query.setLong("idCust", customerVO.getId());
		query.setString("statusCC", CommonConstant.STATUS_CD_CANCELLED);
		query.setString("statusVD", CommonConstant.STATUS_CD_VOID);
		if (((BigInteger) query.uniqueResult()).intValue() > 0) return true;
		
		query = createSQLQuery("SELECT COUNT(p.id) FROM invoice_pax p, invoice i WHERE i.id_company = :idCompany AND p.id_cust = :idCust AND p.id_inv = i.id AND p.status_cd = 'A' AND i.status_cd NOT IN (:statusCC, :statusVD)");
		query.setLong("idCompany", customerVO.getCompanyId());
		query.setLong("idCust", customerVO.getId());
		query.setString("statusCC", CommonConstant.STATUS_CD_CANCELLED);
		query.setString("statusVD", CommonConstant.STATUS_CD_VOID);
		if (((BigInteger) query.uniqueResult()).intValue() > 0) return true;
		
		return false;
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#getCustomerListSize(java.lang.Long, java.util.Map)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public int getCustomerListSize(Map<String, Object> params) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT count(c.id) ").
			append("FROM customer c ").
			append("left join person p on c.id_pc = p.id ").
			append("left join corporate o on c.pc_type_cd = 'C' AND c.id_corporate = o.id ").
			append("WHERE id_company = '").append(params.get("idCompany")).append("' ");
		if (params.get("removeInactive") != null && ((boolean) params.get("removeInactive")) == true) sb.append("AND c.status_cd = 'AC' ");
		if (params.get("statusCode") != null) sb.append("and status_cd = '").append(params.get("statusCode")).append("' ");
		if (params.get("custType") != null && StringUtils.isNotEmpty(params.get("custType").toString())) sb.append("and c.pc_type_cd = '").append(params.get("custType")).append("' ");

		Map<String, String> filters = (Map<String, String>) params.get("filters");
		if (!filters.isEmpty()) {
			sb.append("AND (");
			for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) {
				Entry<String, String> entry = it.next();
				if ("code".equals(entry.getKey())) sb.append("c.code LIKE '%").append(entry.getValue()).append("%'");
				else if ("corporateName".equals(entry.getKey())) {
					sb.append("c.corporate_name LIKE '%").append(entry.getValue()).append("%'");
				}
				else if ("identities".equals(entry.getKey())) sb.append("(SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM person_identity WHERE id_person = p.id AND status_cd = 'A') LIKE '%").append(entry.getValue()).append("%'");
				else if ("emailList".equals(entry.getKey())) sb.append("(SELECT GROUP_CONCAT(email separator ',') FROM person_email WHERE id_person = p.id AND status_cd = 'A') LIKE '%").append(entry.getValue()).append("%'");
				else if ("email".equals(entry.getKey())) sb.append("p.email LIKE '%").append(entry.getValue()).append("%'");
				else if ("custName".equals(entry.getKey())) {
					sb.append("CONCAT(IFNULL(p.last_name, ''), ' ', IFNULL(p.first_name, '')) LIKE '%").append(entry.getValue()).append("%'");
				}
				else if ("nickName".equals(entry.getKey())) sb.append("p.nick_name LIKE '%").append(entry.getValue()).append("%'");
				else if ("perContacts".equals(entry.getKey())) sb.append("((SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM person_contact WHERE id_person = p.id) LIKE '%").append(entry.getValue()).
																	append("%' OR (SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM corporate_contact WHERE id_corporate = c.id_corporate) LIKE '%").append(entry.getValue()).append("%')");
				else if ("fullPhoneNo".equals(entry.getKey())) sb
			    .append("((" + FunctionUtils.fullPhoneNoSQL() + "FROM person_contact ")
			    .append("WHERE id_person = p.id AND status_cd = 'A' AND number IS NOT NULL AND number != '') ")
			    .append("LIKE '%").append(entry.getValue()).append("%'")
			    .append(" OR (" + FunctionUtils.fullPhoneNoSQL() + "FROM corporate_contact ")
			    .append("WHERE id_corporate = c.id_corporate AND status_cd = 'A' AND number IS NOT NULL AND number != '') ")
			    .append("LIKE '%").append(entry.getValue()).append("%')))");
				else if ("gstRegNo".equals(entry.getKey())) sb.append("o.gst_reg_no LIKE '%").append(entry.getValue()).append("%'");
				else if ("classes".equals(entry.getKey())) {
					sb.append("(SELECT GROUP_CONCAT(li.description separator ', ') ").
						append("FROM person_class pc LEFT JOIN lookup_item li ON pc.class_cd = li.code AND li.lookup_cat_cd = 'cust_class' ").
						append("WHERE id_person = p.id ").
					append(") LIKE '%").append(entry.getValue()).append("%'");
				}
				else if ("pcTypeDesc".equals(entry.getKey())) sb.append("(case when c.pc_type_cd = 'C' then 'Corporate' else 'Individual' end) LIKE '%").append(entry.getValue()).append("%'");
				if (filters.size() > 1 && it.hasNext()) sb.append(" and ");
			}
			sb.append(") ");
		}
		
		Query query = createSQLQuery(sb.toString());
		return ((BigInteger) query.uniqueResult()).intValue();
	}
	
	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#getCustomerList(java.lang.Long, int, int, java.lang.String, org.primefaces.model.SortOrder, java.util.Map)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<CustomerVO> getCustomerList(Map<String, Object> params) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		sb.append("SELECT ").
			append("custId, personId, (case when salutation_cd != '"+ LookupItemConstant.SALUTATION_EMPTY_CD +"' then salutation_cd else '' end), firstname, lastname, email, corporate, id_pc, pc_type_cd, pc_type_desc, ").
			append("(SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM person_contact WHERE id_person = A.personId AND status_cd = 'A') AS 'perContacts', ").
			append("(SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM corporate_contact WHERE id_corporate = A.id_corporate AND status_cd = 'A') AS 'corContacts', ").
			append("(SELECT CASE WHEN A.pc_type_cd != 'C' THEN (SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM person_identity WHERE id_person = A.personId AND status_cd = 'A') ELSE NULL END) AS 'identities', ").
			append("corName, code, nickName, ").
			append("gstRegNo, status_cd, is_lock, remarks, ").
			append("(SELECT GROUP_CONCAT(CONCAT(email, CASE WHEN is_primary = 1 THEN ' [P]' ELSE '' END) separator ',') FROM person_email WHERE id_person = A.personId AND status_cd = 'A') AS 'emailList' ").
			append(", (SELECT update_status FROM customer_profile_update cpu WHERE cpu.id_customer = A.custId AND cpu.status_cd = 'A' ORDER BY cpu.id DESC LIMIT 1) AS 'email_upd_status' ").
			append(", (SELECT GROUP_CONCAT( ").
				append("CASE WHEN cpu2.update_status = 'P' THEN ").
					append("CONCAT('Status Pending Created By ', cpu2.created_by, ' On ', DATE_FORMAT(cpu2.dt_created, '%Y-%m-%d %h:%i:%s %p')) ").
				append("WHEN cpu2.update_status = 'S' THEN ").
					append("CONCAT('Status Success Updated By ', cpu2.updated_by, ' On ', DATE_FORMAT(cpu2.dt_update, '%Y-%m-%d %h:%i:%s %p')) ").
				append("ELSE null END ").
			append("ORDER BY cpu2.id DESC SEPARATOR '\n') FROM customer_profile_update cpu2 WHERE cpu2.id_customer = A.custId AND cpu2.status_cd = 'A' GROUP BY cpu2.id_customer) AS 'email_upd_remarks' ").
			append(", (SELECT CONCAT('From [', old_classes,'] to [', new_classes, '] By ', h.upd_by, ' On ', DATE_FORMAT(h.dt_upd,'%d-%b-%Y %H:%i:%s')) AS class_upd_info FROM (SELECT id_person, id_ref, GROUP_CONCAT(class_cd ORDER BY class_cd SEPARATOR ', ') AS new_classes ").
			append(" FROM person_class_history WHERE id_person = A.personId GROUP BY id_person, id_ref ORDER BY id_ref DESC LIMIT 1) curr LEFT JOIN (SELECT id_person, id_ref, GROUP_CONCAT(class_cd ORDER BY class_cd SEPARATOR ', ') AS old_classes ").
			append(" FROM person_class_history WHERE id_person = A.personId GROUP BY id_person, id_ref ORDER BY id_ref DESC LIMIT 1 OFFSET 1) prev ON prev.id_person = curr.id_person JOIN customer_history h ON h.id = curr.id_ref) ").
			append(", (SELECT CONCAT('Inactive By ', c.upd_by, ' On ', DATE_FORMAT(c.dt_upd,'%d-%b-%Y %H:%i:%s')) AS status_upd_info FROM customer c WHERE c.id = A.custId AND c.status_cd = '"+CommonConstant.STATUS_CD_INACTIVE+"') ").
			append(", ( ").
		    append("SELECT ").
		    append("  GROUP_CONCAT( ").
		    append("    CONCAT(type_cd, '|', country_cd) SEPARATOR ',' ").
		    append("  ) ").
		    append("FROM ").
		    append("  person_contact ").
		    append("WHERE ").
		    append("  id_person = A.personId ").
		    append("  AND status_cd = 'A' ").
		    append("  AND country_cd IS NOT NULL ").
		    append("  AND country_cd != '' ").
		    append(") AS 'perCountryCode', ").
		    append("( ").
		    append("SELECT ").
		    append("  GROUP_CONCAT( ").
		    append("    CONCAT(type_cd, '|', country_cd) SEPARATOR ',' ").
		    append("  ) ").
		    append("FROM ").
		    append("  corporate_contact ").
		    append("WHERE ").
		    append("  id_corporate = A.id_corporate ").
		    append("  AND status_cd = 'A' ").
		    append("  AND country_cd IS NOT NULL ").
		    append("  AND country_cd != '' ").
		    append(") AS 'corCountryCode', ").
		    append(FunctionUtils.fullPhoneNoSQL()).
		    append(" FROM person_contact ").
		    append(" WHERE id_person = A.personId AND status_cd = 'A' ").
		    append(" AND number IS NOT NULL AND number != '') AS 'perFullPhoneNo', ").
		    append(FunctionUtils.fullPhoneNoSQL()).
		    append(" FROM corporate_contact ").
		    append(" WHERE id_corporate = A.id_corporate AND status_cd = 'A' ").
		    append(" AND number IS NOT NULL AND number != '') AS 'corFullPhoneNo' ");

			if (params.get("classes") != null && ((boolean) params.get("classes")) == true) {
				sb.append(", (SELECT GROUP_CONCAT(li.description separator ', ') ").
					append("FROM person_class pc LEFT JOIN lookup_item li ON pc.class_cd = li.code AND li.lookup_cat_cd = 'cust_class' ").
					append("WHERE id_person = A.personId ").
				append(") AS 'classes' "); 
			}
			sb.append("FROM (SELECT ").
			append("c.id_corporate, c.status_cd, c.id AS 'custId', p.id  as personId, (case when p.salutation_cd != '"+ LookupItemConstant.SALUTATION_EMPTY_CD +"' then p.salutation_cd else '' end) as salutation_cd, IFNULL(p.first_name, '') as firstname, IFNULL(p.last_name, '') as lastname, ").
			append("p.nick_name as nickName, p.email as email, o.name AS 'corporate', c.id_pc, c.pc_type_cd, (case when c.pc_type_cd = 'C' then 'Corporate' else 'Individual' end) as pc_type_desc, ").
			append("c.corporate_name AS 'corName', c.code AS 'code', o.gst_reg_no AS gstRegNo, c.is_lock, cr.remarks ").
			append("FROM customer c ").
			append("left join person p on c.id_pc = p.id ").
			append("left join corporate o on c.pc_type_cd = 'C' AND c.id_corporate = o.id ").
			append("left join customer_remarks cr on cr.id_cust = c.id ").
			append("WHERE id_company = '").append(params.get("idCompany")).append("' ");
			if (params.get("removeInactive") != null && ((boolean) params.get("removeInactive")) == true) {
				sb.append("AND c.status_cd = 'AC' ");
			}
			if (params.get("nonCorporate") != null && ((boolean) params.get("nonCorporate")) == true) {
				sb.append("AND c.pc_type_cd != 'C' ");
			}
		
		if (params.get("statusCode") != null) sb.append("and status_cd = '").append(params.get("statusCode")).append("' ");
		if (params.get("custType") != null && StringUtils.isNotEmpty(params.get("custType").toString())) sb.append("and c.pc_type_cd = '").append(params.get("custType")).append("' ");
		
		Map<String, String> filters = (Map<String, String>) params.get("filters");
		String filteredName = null;
		String filteredCor = null;
		if (!filters.isEmpty()) {
			sb.append("AND (");
			for (Iterator<Entry<String, String>> it = filters.entrySet().iterator() ; it.hasNext() ;) {
				Entry<String, String> entry = it.next();
				if ("code".equals(entry.getKey())) sb.append("c.code LIKE '%").append(entry.getValue()).append("%'");
				else if ("corporateName".equals(entry.getKey())) {
					filteredCor = entry.getValue();
					sb.append("c.corporate_name LIKE '%").append(entry.getValue()).append("%'");
				}
				else if ("identities".equals(entry.getKey())) sb.append("(SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM person_identity WHERE id_person = p.id AND status_cd = 'A') LIKE '%").append(entry.getValue()).append("%'");
				else if ("emailList".equals(entry.getKey())) sb.append("(SELECT GROUP_CONCAT(email separator ',') FROM person_email WHERE id_person = p.id AND status_cd = 'A') LIKE '%").append(entry.getValue()).append("%'");
				else if ("email".equals(entry.getKey())) sb.append("p.email LIKE '%").append(entry.getValue()).append("%'");
				else if ("custName".equals(entry.getKey())) {
					filteredName = entry.getValue();
					sb.append("CONCAT(IFNULL(p.last_name, ''), ' ', IFNULL(p.first_name, '')) LIKE '%").append(entry.getValue()).append("%'");
				}
				else if ("nickName".equals(entry.getKey())) sb.append("p.nick_name LIKE '%").append(entry.getValue()).append("%'");
				else if ("perContacts".equals(entry.getKey())) sb.append("((SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM person_contact WHERE id_person = p.id) LIKE '%").append(entry.getValue()).
																	append("%' OR (SELECT GROUP_CONCAT(CONCAT(type_cd, '|', number) separator ',') FROM corporate_contact WHERE id_corporate = c.id_corporate) LIKE '%").append(entry.getValue()).append("%')");
				else if ("fullPhoneNo".equals(entry.getKey())) sb
			    .append("((" + FunctionUtils.fullPhoneNoSQL() + "FROM person_contact ")
			    .append("WHERE id_person = p.id AND status_cd = 'A' AND number IS NOT NULL AND number != '') ")
			    .append("LIKE '%").append(entry.getValue()).append("%'")
			    .append(" OR (" + FunctionUtils.fullPhoneNoSQL() + "FROM corporate_contact ")
			    .append("WHERE id_corporate = c.id_corporate AND status_cd = 'A' AND number IS NOT NULL AND number != '') ")
			    .append("LIKE '%").append(entry.getValue()).append("%')))");
				
				else if ("gstRegNo".equals(entry.getKey())) sb.append("o.gst_reg_no LIKE '%").append(entry.getValue()).append("%'");
				else if ("classes".equals(entry.getKey())) {
					sb.append("(SELECT GROUP_CONCAT(li.description separator ', ') ").
						append("FROM person_class pc LEFT JOIN lookup_item li ON pc.class_cd = li.code AND li.lookup_cat_cd = 'cust_class' ").
						append("WHERE id_person = p.id ").
					append(") LIKE '%").append(entry.getValue()).append("%'");
				}
				else if ("pcTypeDesc".equals(entry.getKey())) sb.append("(case when c.pc_type_cd = 'C' then 'Corporate' else 'Individual' end) LIKE '%").append(entry.getValue()).append("%'");
				if (filters.size() > 1 && it.hasNext()) sb.append(" and ");
			}
			sb.append(") ");
		}
		sb.append(") A order by ");
		
		String sortField = (String) params.get("sortField");
		if (sortField == null) {
//			if (filteredName == null) sb.append("lastname, firstname");
			if (filteredName == null) sb.append("custId desc");
			else sb.append("case when concat(lastname, ' ', firstname) like '").append(filteredName).append("%' then concat(lastname, ' ', firstname) else concat('{0} ', concat(lastname, ' ', firstname)) end");
			
		} else {
			if ("code".equals(sortField)) sb.append("cast(code as decimal)");
			else if ("corporateName".equals(sortField)) {
				if (filteredCor == null) sb.append("corName");
				else sb.append("case when corName like '").append(filteredName).append("%' then corName else concat('{0} ', corName) end");
			}
			else if ("identities".equals(sortField)) sb.append("identities");
			else if ("emailList".equals(sortField)) sb.append("emailList");
			else if ("email".equals(sortField)) sb.append("email");
			else if ("custName".equals(sortField)) {
				if (filteredName == null) sb.append("concat(lastname, ' ', firstname)");
				else sb.append("case when concat(lastname, ' ', firstname) like '").append(filteredName).append("%' then concat(lastname, ' ', firstname) else concat('{0} ', concat(lastname, ' ', firstname)) end");
			}
			else if ("nickName".equals(sortField)) sb.append("nickName");
			else if ("perContacts".equals(sortField)) sb.append("concat(case when perContacts is null then '' else perContacts end, ' ', case when corContacts is null then '' else perContacts end)");
			else if ("fullPhoneNo".equals(sortField)) sb.append("IFNULL(perFullPhoneNo, corFullPhoneNo)");
			else if ("gstRegNo".equals(sortField)) sb.append("gstRegNo");
			else if ("classes".equals(sortField)) sb.append("classes");
			else if ("pcTypeDesc".equals(sortField)) sb.append("pc_type_desc");
			if (CommonConstant.SORT_ASC.equals(((SortOrder) params.get("sortOrder")).toString())) sb.append(" asc");
			else sb.append(" desc");
		}
		
		Query query = createSQLQuery(sb.toString());
		query.setFirstResult((Integer) params.get("first"));
		query.setMaxResults((Integer) params.get("pageSize"));
		List<Object> objList = query.list();
		List<CustomerVO> list = new ArrayList<CustomerVO>();
		
		if (CollectionUtils.isNotEmpty(objList)) {
			for (Iterator<Object> it = objList.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				CustomerVO vo = new CustomerVO();
				vo.setId(((BigInteger) row[0]).longValue());
				if (row[1] != null) vo.setPersonId(((BigInteger) row[1]).longValue());
				vo.setSalutationCd((String) row[2]);
				vo.setFirstName((String) row[3]);
				vo.setLastName((String) row[4]);
