	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#isCustomerExisted(com.bcs.zsg.sales.vo.CustDetailsVO, java.lang.Long, java.lang.Boolean)
	 */
	@Override
	public int isCustomerExisted(CustDetailsVO custDetailsVO, Long idCompany, Boolean filterAsIndividual) throws BusinessException {
		int existedLevel = 0;
		
		if (CollectionUtils.isNotEmpty(custDetailsVO.getIdentityList())) {
			// check identity
			for (IdentityVO vo : custDetailsVO.getIdentityList()) {
				if (isIdentityExisted(vo, idCompany)) {
					existedLevel = 2;
					break;
				}
			}
			//if (idExisted) return existedLevel;
		
		} else if (null != custDetailsVO.getNricIdVO() && StringUtils.isNotBlank(custDetailsVO.getNricIdVO().getIdNo())) {
			// check identity - NRIC
			IdentityVO idVO = custDetailsVO.getNricIdVO();
			if (isIdentityExisted(idVO, idCompany)) {
				existedLevel = 2;
			}
		} else if (null != custDetailsVO.getPassportIdVO()&& StringUtils.isNotBlank(custDetailsVO.getPassportIdVO().getIdNo())) {
			// check identity - Passport No
			IdentityVO idVO = custDetailsVO.getPassportIdVO();
			if (isIdentityExisted(idVO, idCompany)) {
				existedLevel = 2;
			}
			
		}  else {
			String sql = "SELECT p.id from customer c, person p WHERE p.last_name = :lastName AND p.first_name = :firstName AND p.id = c.id_pc AND c.status_cd = :statusCode AND c.id_company = :idCompany";
			
//			System.out.println("CYY custDetailsVO.getPersonId(): " + custDetailsVO.getPersonId());
//			System.out.println("CYY custDetailsVO.getCustId(): " + custDetailsVO.getCustId());
			
			// skip self record when check from invoice pax
			if (custDetailsVO.getPersonId() != null) {
				sql += " and p.id != " + custDetailsVO.getPersonId() + " ";
			}
			
			if (filterAsIndividual != null && filterAsIndividual == true) {
				sql += " and c.pc_type_cd = 'P'";
			}
			
//			System.out.println(sql);
			
			// check customer name
			Query query = createSQLQuery(sql);
			query.setString("lastName", custDetailsVO.getLastName().trim());
			query.setString("firstName", custDetailsVO.getFirstName().trim());
			query.setString("statusCode", CommonConstant.STATUS_CD_ACTIVE);
			query.setLong("idCompany", idCompany);
			query.setMaxResults(1);
			if (null != query.uniqueResult()) existedLevel = 1;
		}
		return existedLevel;
	}
	
	public boolean isEmailExisted(CustDetailsVO custDetailsVO, Long idCompany) throws BusinessException {
		if (custDetailsVO.getEmailList() != null && !custDetailsVO.getEmailList().isEmpty()) {

		    for (PersonEmailVO emailVO : custDetailsVO.getEmailList()) {
		        if (isEmailExisted(emailVO.getEmail(), idCompany, emailVO.getIdPerson(), custDetailsVO.getCustType())) {
		            
		            return true;
		        }
		    }
		}
	    return false;
	}
