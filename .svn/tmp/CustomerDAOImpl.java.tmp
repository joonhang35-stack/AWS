	/*
	 * (non-Javadoc)
	 * @see com.bcs.zsg.sales.dao.CustomerDAO#getTourHistList(com.bcs.zsg.sales.vo.CustomerVO, java.lang.Long)
	 */
	@SuppressWarnings("unchecked")
	@Override
	public List<CustTourHistVO> getTourHistList(CustomerVO vo, Long companyId, Map<String, Object> params) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		
		sb.append("SELECT i.id,i.id_tour_dep,i.code,i.attn_to,td.code as tourCode, i.dt_departure as typeDep,u.user_name as user,").
			append("GROUP_CONCAT(concat_ws(' ',(case when p.salutation_cd != '"+ LookupItemConstant.SALUTATION_EMPTY_CD +"' then p.salutation_cd else '' end),p.last_name,p.first_name) separator ',') as passengerList ,").
			append("tp.type_cd as typeCode, i.doc_type_cd, i.doc_type_status, i.ps_no ").
			append("from invoice i ").
			append("left join invoice_pax ip on ip.id_inv=i.id ").
			append("left join customer c on c.id=ip.id_cust ").
			append("left join person p on p.id=c.id_pc ").
			append("left join tour_dep td on td.id=i.id_tour_dep ").
			append("left join tour_pkg tp on tp.id=td.id_tour_pkg ").
			append("left join employee e on e.id=i.id_saler ").
			append("left join sec_user u on u.uuid=e.u_sec_user ").
//			append("where i.id_customer='"+vo.getId()+"' and i.doc_type_cd='i' and i.id_company="+companyId+ " ");
			append("where i.id_customer='"+vo.getId()+"' and i.doc_type_cd IN ('I','P') and i.id_company="+companyId+ " ");
			if (params.get("notViewableCatCode") != null) sb.append("and i.cat_cd not in :notViewableCatCode ");
			sb.append("group by i.id ").
			append("union ").
			append("(SELECT ").
			append("i.id,i.id_tour_dep,i.code,i.attn_to,td.code as tourCode,td.dt_dep as typeDep,u.user_name as user,").
			append("GROUP_CONCAT(concat_ws(' ',(case when p.salutation_cd != '"+ LookupItemConstant.SALUTATION_EMPTY_CD +"' then p.salutation_cd else '' end),p.last_name,p.first_name) separator ',') as passengerList ,").
			append("tp.type_cd as typeCode, i.doc_type_cd, i.doc_type_status, i.ps_no ").
			append("from invoice i ").
			append("left join invoice_pax ip on ip.id_inv=i.id ").
			append("left join customer c on c.id=ip.id_cust ").
			append("left join person p on p.id=c.id_pc ").
			append("left join tour_dep td on td.id=i.id_tour_dep ").
			append("left join tour_pkg tp on tp.id=td.id_tour_pkg ").
			append("left join employee e on e.id=i.id_saler ").
			append("left join sec_user u on u.uuid=e.u_sec_user ").
			append("where i.id in (select id_inv from invoice_pax where id_cust='"+vo.getId()+"' and status_cd='A') and i.id_customer!='"+vo.getId()+"' and i.doc_type_cd IN ('I','P') and i.id_company="+companyId+" ");
//			append("where i.id in (select id_inv from invoice_pax where id_cust='"+vo.getId()+"' and status_cd='A') and i.id_customer!='"+vo.getId()+"' and i.doc_type_cd='i' and i.id_company="+companyId+" ");
			if (params.get("notViewableCatCode") != null) sb.append("and i.cat_cd not in :notViewableCatCode ");
			sb.append("group by i.id )");
		
		Query query = createSQLQuery(sb.toString());	
		if (params.get("notViewableCatCode") != null) query.setParameterList("notViewableCatCode", (List<String>) params.get("notViewableCatCode"));
		List<Object> objList = query.list();
		List<CustTourHistVO> list = new ArrayList<CustTourHistVO>();
		
		if (CollectionUtils.isNotEmpty(objList)) {
			for (Iterator<Object> it = objList.iterator() ; it.hasNext() ;) {
				Object[] row = (Object[]) it.next();
				CustTourHistVO custTourVO = new CustTourHistVO();
				custTourVO.setIdInv(((BigInteger) row[0]).longValue());
				custTourVO.setIdTourDep(((BigInteger) row[1]).longValue());
				custTourVO.setCode((String) row[2]); 
				custTourVO.setAttnTo((String) row[3]);
				custTourVO.setTourCode((String) row[4]);
				custTourVO.setDtDep(((Date) row[5]));
				custTourVO.setSalesPerson((String) row[6]);
				custTourVO.setPassengers((String) row[7]);
				custTourVO.setTourPkgtypeCd((String) row[8]);
				
				custTourVO.setInvVO(new InvoiceVO());
				custTourVO.getInvVO().setDocTypeCd((String) row[9]);
				custTourVO.getInvVO().setDocTypeStatus((String) row[10]);
				custTourVO.getInvVO().setPsNo((String) row[11]);
				
				list.add(custTourVO);
			}
		}
		return list;
	}
	
