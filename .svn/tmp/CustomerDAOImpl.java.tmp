	@Override
	public PersonVO getPersonById(Long personId) throws BusinessException {
		Criteria criteria = createCriteria(PersonVO.class);
		criteria.add(Restrictions.eq("id", personId));
		return (PersonVO) criteria.uniqueResult();
	}

	@Override
	public List<CustomerVO> getCustomerList(Long idCompany, SearchParamVO searchParamVO) throws BusinessException {
		StringBuilder sb = new StringBuilder();
		List<CustomerVO> list = new ArrayList<CustomerVO>();
		
		try {
			sb.append("SELECT ").
				append("c.id AS 'custId', ").
				append("p.salutation_cd AS salutation_cd, ").
				append("Ifnull(p.first_name, '') AS firstname, ").
				append("Ifnull(p.last_name, '') AS lastname, ").
				append("cty.name AS nationality, ").
				append("p.email AS email, ").
				append("p.sex_cd,").
	            append("c.pc_type_cd, ").
	            append("o.name AS 'corname', ").
	            append("o.reg_no, ").
	            append("o.gst_reg_no, ").
	            append("c.code AS 'customerno', ").
	            append("p.dt_birth, ").
	            append("p.nick_name, ").
	            append("IFNULL(DATE_FORMAT(FROM_DAYS(DATEDIFF(now(),p.dt_birth)), '%Y')+0, '') AS age, ").
	            append("Concat_ws(', ', (SELECT GROUP_CONCAT(li.description separator ', ') ").
	            	append("FROM   person_lang pl LEFT JOIN lookup_item li ON pl.lang_cd = li.code AND li.lookup_cat_cd = 'lang_dilc' ").
	            	append("WHERE  pl.id_person = p.id) ").
	            append(") AS 'Language', ").
	            append("Concat_ws(', ', (SELECT GROUP_CONCAT(li.description separator ', ') ").
	            	append("FROM   person_class pc LEFT JOIN lookup_item li ON pc.class_cd = li.code AND li.lookup_cat_cd = 'cust_class' ").
	            	append("WHERE  pc.id_person = p.id) ").
	            append(") AS 'Class', ").
	            append("Concat_ws(', ', (SELECT GROUP_CONCAT(li.description separator ', ') ").
	            	append("FROM   person_meal pm LEFT JOIN lookup_item li ON pm.meal_cd = li.code AND li.lookup_cat_cd = 'meal_pref' ").
	            	append("WHERE  pm.id_person = p.id) ").
	            append(") AS 'Meal',").
	            append("Concat_ws(', ', (SELECT GROUP_CONCAT(li.description separator ', ') ").
	            	append("FROM   person_complication pc LEFT JOIN lookup_item li ON pc.complication_cd = li.code AND li.lookup_cat_cd = 'cust_cmpl' ").
	            	append("WHERE  pc.id_person = p.id) ").
	            append(") AS 'Complication', ").
	            append("(SELECT CONCAT_WS(' ', ").
	            	append("if(company_name = '', null, company_name), if(addr_1 = '', null, addr_1), if(addr_2 = '', null, addr_2), if(addr_3 = '', null, addr_3), ").
	            	append("if(city = '', null, city), if(state = '', null, state), if(postcode = '', null, postcode), ").
	            	append("if(c.name = '', null, c.name)) FROM person_address pa left join country c on c.id = pa.id_country WHERE c.pc_type_cd = 'P' and id_person = p.id AND pa.type_cd = 'bill') AS 'perAddress', ").
	            append("(SELECT CONCAT_WS(' ', ").
	            	append("if(company_name = '', null, company_name), if(addr_1 = '', null, addr_1), if(addr_2 = '', null, addr_2), if(addr_3 = '', null, addr_3), ").
	            	append("if(city = '', null, city), if(state = '', null, state), if(postcode = '', null, postcode), ").
	            	append("if(c.name = '', null, c.name)) FROM person_address pa left join country c on c.id = pa.id_country WHERE c.pc_type_cd = 'P' and id_person = p.id AND pa.type_cd = 'mail') AS 'perAddress2', ").
	            append("(SELECT CONCAT_WS(' ', ").
					append("if(addr_1 = '', null, addr_1), if(addr_2 = '', null, addr_2), if(addr_3 = '', null, addr_3), ").
					append("if(city = '', null, city), if(state = '', null, state), if(postcode = '', null, postcode), ").
					append("if(c.name = '', null, c.name)) FROM corporate_address pa left join country c on c.id = pa.id_country WHERE c.pc_type_cd = 'C' and id_corporate = o.id AND pa.type_cd = 'bill') AS 'corAddress', ").
				append("(SELECT CONCAT_WS(' ', ").
				append("if(addr_1 = '', null, addr_1), if(addr_2 = '', null, addr_2), if(addr_3 = '', null, addr_3), ").
				append("if(city = '', null, city), if(state = '', null, state), if(postcode = '', null, postcode), ").
				append("if(c.name = '', null, c.name)) FROM corporate_address pa left join country c on c.id = pa.id_country WHERE c.pc_type_cd = 'C' and id_corporate = o.id AND pa.type_cd = 'mail') AS 'corAddress2', ").
				append("(SELECT GROUP_CONCAT(CONCAT(type_cd, ': ', number) separator ', ') FROM person_contact WHERE id_person = p.id AND status_cd = 'A') AS 'perContacts', ").
				append("(SELECT GROUP_CONCAT(CONCAT(type_cd, ': ', number) separator ', ') FROM corporate_contact WHERE id_corporate = o.id AND status_cd = 'A') AS 'corContacts', ").
				append("(SELECT GROUP_CONCAT(cr.remarks separator '\n') FROM customer_remarks cr WHERE c.id = cr.id_cust AND cr.status_cd = 'A') as remarks, ").
				append("if(c.pc_type_cd = 'C', o.tax_id_no, p.tax_id_no) AS 'tax_id_no' ").
			append("FROM customer c ").
				append("LEFT JOIN person p ON c.id_pc = p.id ").
				append("LEFT JOIN corporate o on (c.pc_type_cd = 'C' AND c.id_corporate = o.id) ").
				append("LEFT JOIN country cty on cty.id = p.id_country ").
			append("WHERE c.id_company = :idCompany ").
			append("AND c.status_cd = :statusCd ");
			
			if (searchParamVO.getObj7() != null && StringUtils.isNotEmpty(searchParamVO.getObj7().toString())) {
				sb.append("AND c.id in (").append(searchParamVO.getObj7().toString()).append(") ");
			}
			if (searchParamVO.getObj2() != null && StringUtils.isNotEmpty(searchParamVO.getObj2().toString())) {
				sb.append("AND c.pc_type_cd = '").append(searchParamVO.getObj2().toString()).append("' ");
			}
			SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
			if (searchParamVO.getFromDate() != null) sb.append("AND DATE(c.dt_created) >= DATE('" + sdf.format((Date)searchParamVO.getFromDate()) + "') ");
			if (searchParamVO.getToDate() != null) sb.append("AND DATE(c.dt_created) <= DATE('" + sdf.format((Date)searchParamVO.getToDate()) + "') ");
			sb.append("ORDER BY cast(c.code AS decimal) ASC ");
			
//			System.out.println("##############sql: " + sb.toString());
			Query query = createSQLQuery(sb.toString());
			query.setParameter("idCompany", idCompany);
			query.setParameter("statusCd", CommonConstant.STATUS_CD_ACTIVE);
			List<Object> objList = query.list();
			
			if (CollectionUtils.isNotEmpty(objList)) {
				for (Iterator<Object> it = objList.iterator() ; it.hasNext() ;) {
					Object[] row = (Object[]) it.next();
					CustomerVO vo = new CustomerVO();
					vo.setId(((BigInteger) row[0]).longValue()); 
					vo.setSalutationCd((String) row[1]);
					vo.setFirstName((String) row[2]);
					vo.setLastName((String) row[3]);
					vo.setCustName(vo.getSalutationCd().toUpperCase() + " " + vo.getLastName() + " " + vo.getFirstName());
					vo.setNationality((String) row[4]);
					vo.setEmail((String) row[5]);
					vo.setSexCd((String) row[6]);
					vo.setPcTypeCd((String) row[7]);
					vo.setCorporate((String) row[8]);
					vo.setRegNo((String) row[9]);
					vo.setGstRegNo((String) row[10]);
					vo.setCode((String) row[11]);
					vo.setDtDOB((Date) row[12]);
					vo.setNickName((String) row[13]);
					vo.setAge((String) row[14]);
					vo.setLanguageName((String) row[15]);
					vo.setClassName((String) row[16]);
					vo.setMealName((String) row[17]);
					vo.setComplicationName((String) row[18]);
					if (searchParamVO.getObj2() != null && StringUtils.isNotEmpty(searchParamVO.getObj2().toString()) &&
						"P".equals(searchParamVO.getObj2().toString())) {
						vo.setPerAddress((String) row[19]);
						vo.setPerAddress2((String) row[20]);
						vo.setPerContacts((String) row[23]);
						if (vo.getPerContacts() != null) {
							vo.setPerContacts(vo.getPerContacts().replace("mobile", LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "mobile"))
									.replace("office",  LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "office"))
									.replace("home",  LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "home"))
									.replace("fax",  LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "fax")));
						}
					} else {
						vo.setPerAddress((String) row[21]);
						vo.setPerAddress2((String) row[22]);
						vo.setPerContacts((String) row[24]);
						if (vo.getPerContacts() != null) {
							vo.setPerContacts(vo.getPerContacts().replace("mobile", LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "mobile"))
									.replace("office",  LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "office"))
									.replace("home",  LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "home"))
									.replace("fax",  LookupItemUtils.getLookupItemDesc(CommonConstant.LOOKUP_CAT_CD_CNTC_TYPE, "fax")));
						}
					}
					vo.setRemarks((String) row[25]);
					vo.setTaxIdNo((String) row[26]);
					list.add(vo);
				}
			}
		} catch (Exception e) {
			throw e;
		}
		
		return list;
	}
	
	@Override
	public void unlockCustomer(Long idCust, boolean isLock) throws BusinessException {
		
		StringBuilder sb = new StringBuilder();
		sb.append("UPDATE CustomerVO SET isLock = :isLock WHERE id = :idCust");
		
		Query query = createQuery(sb.toString());
		query.setBoolean("isLock", isLock);
		query.setLong("idCust", idCust);
		query.executeUpdate();
	}

	@Override
	public CountryVO getCountryById(Long countryId) throws BusinessException {
		Criteria criteria = createCriteria(CountryVO.class);
		criteria.add(Restrictions.eq("id", countryId));
		return (CountryVO) criteria.uniqueResult();
	}
	
	@Override
	public void insertCustomerHistory(Long idCust, String actionCd, String reason) throws BusinessException {
		Query query = createSQLQuery("CALL prc_customer(:p_id, :p_action, :p_reason, @r_status_code)");
		query.setParameter("p_id", idCust);
		query.setParameter("p_action", actionCd);
		query.setParameter("p_reason", reason);
		query.executeUpdate();
		
		// Get the output parameter
		BigInteger returnStatusCode = (BigInteger) createSQLQuery("SELECT @r_status_code").uniqueResult();
        System.out.println("###################return status: " + returnStatusCode);
	}
	
	@Override
	public void updateCrmId(Long customerId, String crmId) throws BusinessException {
	    Session session = getSessionFactory().openSession();
	    try {
	    	CustomerVO customerVO =
	    	        (CustomerVO) getSessionFactory()
	    	            .getCurrentSession()
	    	            .get(CustomerVO.class, customerId);
	    	customerVO.setCrmId(crmId);
	    } catch (Exception e) {
	        if (session.getTransaction() != null) {
	            session.getTransaction().rollback();
	        }
	        throw e;
	    } finally {
	        session.close();
	    }
	}
}
