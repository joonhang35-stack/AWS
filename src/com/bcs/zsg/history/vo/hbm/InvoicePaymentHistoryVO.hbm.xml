<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.history.vo">

    <class table="INVOICE_PMNT_HISTORY" name="InvoicePaymentHistoryVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="idHist" type="long" column="id_hist"/>
        <property name="idRef" type="long" column="id_ref"/>
        <property name="invId" type="long" column="ID_INV"/>
        <property name="issuerId" type="long" column="ID_ISSUER"/>
        <property name="bankId" type="long" column="ID_BANK"/>
        <property name="pmntDt" type="timestamp" column="DT_PMNT"/>
        <property name="code" type="string" column="CODE"/>
        <property name="pmntTypeCd" type="string" column="PMNT_TYPE_CD"/>
        <property name="refNo" type="string" column="REF_NO"/>
        <property name="recievedFr" type="string" column="RECEIVED_FROM"/>
        <property name="amount" type="double" column="AMOUNT"/>
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>