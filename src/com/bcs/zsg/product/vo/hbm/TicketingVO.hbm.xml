<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="ticketing" name="TicketingVO" polymorphism="explicit">
        <id name="Id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="idAirline" type="long" column="id_airline"/>
        <property name="destination" type="string" column="destination"/>
        <property name="desc" type="string" column="description"/>
        <property name="priceFrom" type="double" column="price_from"/>
        <property name="priceTo" type="double" column="price_to"/>
		<property name="dtBookStart" type="timestamp" column="dt_book_start"/>
		<property name="dtBookEnd" type="timestamp" column="dt_book_end"/>
		<property name="dtTrvlStart" type="timestamp" column="dt_travel_start"/>
		<property name="dtTrvlEnd" type="timestamp" column="dt_travel_end"/>
		<property name="isPromo" type="boolean" column="is_promo"/>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="remarks" type="string" column="remarks"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>