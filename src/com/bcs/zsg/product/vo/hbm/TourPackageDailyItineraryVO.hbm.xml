<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="tour_pkg_daily_itinerary" name="TourPackageDailyItineraryVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idTourPkg" type="long" column="id_tour_pkg"/>
        <property name="code" type="string" column="code"/>
        <property name="title" type="string" column="title"/>
        <property name="titleZh" type="string" column="title_zh"/>
        <property name="highlight" type="string" column="highlight"/>
        <property name="highlightZh" type="string" column="highlight_zh"/>
        <property name="seq" type="integer" column="seq"/>
        <property name="imageUrl" type="string" column="image_url"/>
        <property name="genRemarks" type="string" column="gen_remarks"/>
        <property name="genRemarksZh" type="string" column="gen_remarks_zh"/>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_update"/>
		<property name="updatedBy" type="string" column="updated_by"/>
    </class>
</hibernate-mapping>