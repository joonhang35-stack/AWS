<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="ROOMING_LIST_LAND_OPERATOR" name="RoomingListLandOperatorVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"></generator>
        </id>
        <property name="idTourDep" type="long" column="ID_TOUR_DEP"/>
        <property name="salutation" type="string" column="SALUTATION_CD"/>
        <property name="lastName" type="string" column="LAST_NAME"/>
        <property name="givenName" type="string" column="GIVEN_NAME"/>
        
        <!-- BaseVO attributes -->
        <property name="remarks" type="text" column="REMARKS"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPDATE"/>
		<property name="updatedBy" type="string" column="UPDATED_BY"/>
    </class>

</hibernate-mapping>