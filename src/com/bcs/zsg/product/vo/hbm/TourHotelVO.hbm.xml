<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="tour_hotel" name="TourHotelVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idTourDep" type="long" column="id_tour_dep"/>
        <!--property name="idHotel" type="long" column="id_hotel"/-->
        <property name="nightNum" type="integer" column="night_num"/>
        <property name="fromDate" type="timestamp" column="dt_from"/>
        <property name="toDate" type="timestamp" column="dt_to"/>
        
        <many-to-one name="hotelVO" class="com.bcs.zsg.product.vo.HotelVO" column="id_hotel" lazy="false"/>
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>