<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="sales_comm_config_detail" name="SalesCommConfigDetailVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idSalesCommConf" type="long" column="id_sales_comm_conf"/>
        <property name="fareRangetype" type="string" column="fare_range_type"/>
        <property name="frAmt" type="double" column="fr_amt"/>
        <property name="toAmt" type="double" column="to_amt"/>
        <property name="spComm" type="double" column="sp_comm"/>
        <property name="refSpComm" type="double" column="ref_sp_comm"/>
        <property name="ssComm" type="double" column="ss_comm"/>
        <property name="hodComm" type="double" column="hod_comm"/>
        <property name="opComm" type="double" column="op_comm"/>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>