<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.product.vo">

    <class table="airline_schedule_item" name="AirlineScheduleItemVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idAirlineSchedule" type="long" column="id_airline_schedule"/>
        <property name="typeCd" type="string" column="type_cd"/>
        <property name="fromAirportCd" type="string" column="from_airport_cd"/>
        <property name="toAirportCd" type="string" column="to_airport_cd"/>
        <property name="flightCd" type="string" column="flight_cd"/>
        <property name="etd" type="string" column="etd"/>
        <property name="eta" type="string" column="eta"/>
        <property name="departureDate" type="timestamp" column="dt_dep"/>
        <property name="arrivalDate" type="timestamp" column="dt_arr"/>
        <property name="isNextDay" type="boolean" column="is_next_day"/>
        <property name="remarks" type="string" column="remarks"/>
        <!-- property name="tktValidity" type="integer" column="tkt_validity"/ -->
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>