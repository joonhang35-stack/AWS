<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.acct.vo">

    <class table="E_INVOICE_API_DAILY_SNAPSHOT_TRANS" name="EInvoiceApiDailySnapshotTransVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        
        <property name="idCompany" type="long" column="id_company"/>
        <property name="dtTrans" type="timestamp" column="dt_trans"/>
        <property name="existsInLocalStatus" type="string" column="exists_in_local_status"/>
        <property name="processStatus" type="string" column="process_status"/>
        
        <!-- E-Invoice Get Recent Documents API attributes -->
        <property name="buyerName" column="buyer_name" type="string"/>
        <property name="buyerTIN" column="buyer_tin" type="string"/>
        <property name="cancelDateTime" column="cancel_dt" type="timestamp"/>
        <property name="createdByUserId" column="created_by_user_id" type="string"/>
        <property name="dateTimeIssued" column="dt_issued" type="timestamp"/>
        <property name="dateTimeReceived" column="dt_received" type="timestamp"/>
        <property name="dateTimeValidated" column="dt_validated" type="timestamp"/>
        <property name="documentCurrency" column="currency" type="string"/>
        <property name="documentStatusReason" column="status_reason" type="string"/>
        <property name="intermediaryName" column="intermediary_name" type="string"/>
        <property name="intermediaryROB" column="intermediary_rob" type="string"/>
        <property name="intermediaryTIN" column="intermediary_tin" type="string"/>
        <property name="internalId" column="internal_id" type="string"/>
        <property name="issuerID" column="issuer_id" type="string"/>
        <property name="issuerIDType" column="issuer_id_type" type="string"/>
        <property name="issuerTIN" column="issuer_tin" type="string"/>
        <property name="longId" column="long_id" type="string"/>
        <property name="netAmount" column="net_amount" type="double"/>
        <property name="receiverID" column="receiver_id" type="string"/>
        <property name="receiverIDType" column="receiver_id_type" type="string"/>
        <property name="receiverName" column="receiver_name" type="string"/>
        <property name="receiverTIN" column="receiver_tin" type="string"/>
        <property name="rejectRequestDateTime" column="reject_request_dt" type="timestamp"/>
        <property name="status" column="status" type="string"/>
        <property name="submissionChannel" column="submission_channel" type="string"/>
        <property name="submissionUid" column="submission_uid" type="string"/>
        <property name="submitterROB" column="submitter_rob" type="string"/>
        <property name="supplierName" column="supplier_name" type="string"/>
        <property name="supplierTIN" column="supplier_tin" type="string"/>
        <property name="total" column="total" type="double"/>
        <property name="totalDiscount" column="total_discount" type="double"/>
        <property name="totalSales" column="total_sales" type="double"/>
        <property name="typeName" column="type_name" type="string"/>
        <property name="typeVersionName" column="type_version_name" type="string"/>
        <property name="uuid" column="uuid" type="string"/>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>