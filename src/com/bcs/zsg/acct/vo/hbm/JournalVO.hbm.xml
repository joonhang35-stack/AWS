<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.acct.vo">

    <class table="journal" name="JournalVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="companyId" type="long" column="id_company"/>
        <property name="idTourDep" type="long" column="id_tour_dep"/>
        <property name="idBill" type="long" column="id_bill"/>
        <property name="idDpt" type="string" column="id_dpt"/>
        <property name="idInv" type="long" column="id_inv"/>
        <property name="idPs" type="long" column="id_ps"/>
        <property name="typeCd" type="string" column="type_cd"/>
        <property name="reason" type="string" column="reason"/>
        <property name="sysNo" type="string" column="sys_no"/>
        <property name="reference" type="string" column="reference"/>
        <property name="totalAmt" type="double" column="total_amt"/>
        <property name="journalDt" type="timestamp" column="dt_journal"/>
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>