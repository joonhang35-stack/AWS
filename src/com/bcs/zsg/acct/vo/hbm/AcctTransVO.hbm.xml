<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.acct.vo">

    <class table="account_trans" name="AcctTransVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="companyId" type="long" column="id_company"/>
        <property name="acctId" type="long" column="id_acct"/>
        <property name="refId" type="long" column="id_ref"/>
        <property name="sysCode" type="string" column="sys_cd"/>
        <property name="sysPrefix" type="string" column="sys_prefix"/>
        <property name="sysNo" type="string" column="sys_no"/>
        <property name="refNo" type="string" column="ref_no"/>
        <property name="source" type="string" column="source"/>
        <property name="destination" type="string" column="destination"/>
        <property name="code" type="string" column="code"/>
        <property name="desc" type="string" column="description"/>
        <property name="type" type="string" column="type_cd"/>
        <property name="eInvoiceClassCode" type="string" column="e_invoice_class_code"/>
        <property name="debit" type="double" column="debit"/>
        <property name="credit" type="double" column="credit"/>
        <property name="transDt" type="timestamp" column="dt_trans"/>
        <property name="taxCode" type="string" column="tax_code"/>
        <property name="taxRate" type="float" column="tax_rate"/>
        <property name="taxAmount" type="double" column="tax_amount"/>
        
        <!-- BaseVO attributes -->
        <property name="remarks" type="string"/>
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>