<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.acct.vo">

    <class table="account" name="AcctViewVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idCompany" type="long" column="id_company"/>
        <property name="code" type="string" column="code"/>
        <property name="subCode" type="string" column="sub_code"/>
        <property name="desc" type="string" column="description"/>
        <property name="subDesc" type="string" column="sub_description"/>
        <property name="taxCode" type="string" column="tax_code"/>
        <property name="typeCode" type="string" column="type_cd"/>
        <property name="isPreSales" type="boolean" column="is_pre_sales"/>
        
        <many-to-one name="parentAcctVO" class="com.bcs.zsg.acct.vo.AcctVO" column="id_parent_acct" lazy="false"/>
        <many-to-one name="acctCatVO" class="com.bcs.zsg.acct.vo.AcctCatVO" column="id_acct_cat" lazy="false"/>
        <many-to-one name="acctSubCatVO" class="com.bcs.zsg.acct.vo.AcctSubCatVO" column="id_acct_sub_cat" lazy="false"/>
        <set name="acctBalSet" table="account_bal" inverse="true" lazy="false" fetch="select">
        	<key><column name="id_acct"/></key>
        	<one-to-many class="com.bcs.zsg.acct.vo.AcctBalVO" />
        </set>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="remarks" type="string" column="remarks"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>