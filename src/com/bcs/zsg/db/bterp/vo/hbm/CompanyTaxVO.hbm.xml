<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.db.bterp.vo">
	<class table="company_tax" name="CompanyTaxVO" polymorphism="explicit">
		<id name="id" type="long" column="id">
            <generator class="identity"/>
        </id>
        <property name="companyId" type="long" column="id_company"/>
        <property name="type" type="string" column="type"/>
		<property name="taxNumber" type="string" column="tax_number"/>
		<property name="validFrom" type="timestamp" column="valid_from"/>
		<property name="validTo" type="timestamp" column="valid_to"/>
		<property name="gstFilling" type="timestamp" column="gst_filling"/>
		<property name="refundCarryForward" type="string" column="refund_carry_forward"/>
		<property name="period" type="string" column="period"/>
		<property name="currency" type="string" column="currency"/>
		
		<!-- BaseVO attributes -->
		
          <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_update"/>
		<property name="updatedBy" type="string" column="updated_by"/>
		
	</class>
</hibernate-mapping>