<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.sales.vo">

    <class table="INVOICE_PAX" name="InvoicePaxVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="invId" type="long" column="ID_INV"/>
        <property name="custId" type="long" column="ID_CUST"/>
        <property name="uPoint" type="integer" column="upoint"/>
        <property name="applePoint" type="integer" column="apple_voucher_point"/>
        <property name="roomTypeCd" type="string" column="ROOM_TYPE_CD"/>
        <property name="roomPairingNo" type="integer" column="ROOM_PAIRING_NO"/>
        <property name="itemCode" type="string" column="item_code"/>
        <property name="travelInsType" type="string" column="travel_ins_type"/>
        <property name="travelInsPolicy" type="string" column="travel_ins_policy"/>
        <property name="ticketNo" type="string" column="TICKET_NO"/>
        <property name="spclReq" type="string" column="SPECIAL_REQUEST"/>
        <property name="langCd" type="string" column="LANG_CD"/>
        <property name="actRoomTypeCd" type="string" column="ACT_ROOM_TYPE_CD"/>
        <property name="actRoomPairingNo" type="integer" column="ACT_ROOM_PAIRING_NO"/>
        <property name="actRoomIndicator" type="string" column="act_room_indicator"/>
        <property name="actRoomRemarks" type="string" column="act_room_remarks"/>
        <property name="actRoomRemarksFlg" type="boolean" column="act_room_remarks_f"/>
        <property name="statusCode" type="string" column="status_cd"/>
        <property name="seq" type="integer" column="seq"/>
        
    </class>

</hibernate-mapping>