<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.crm.sec.vo">

    <class table="CRM_MEMBERSHIP" name="CRMMembershipVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="idCompany" type="long" column="id_company"/>
        <property name="idCustomer" type="long" column="id_customer"/>
        <property name="keycloakId" type="string" column="keycloak_id"/>
        <property name="keycloakUsername" type="string" column="keycloak_username"/>
        <property name="email" type="string" column="email"/>
        <property name="contactCountryCode" type="string" column="contact_country_code"/>
        <property name="contact" type="string" column="contact"/>
        <property name="memberStatusCd" type="string" column="member_status_cd"/>

        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>