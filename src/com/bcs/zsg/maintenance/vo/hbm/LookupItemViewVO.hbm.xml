<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.maintenance.vo">
	<class table="lookup_item" name="LookupItemViewVO" polymorphism="explicit">
		<id name="id" type="long" column="id">
            <generator class="identity"/>
        </id>
        
        <!--many-to-one name="lookupCategoryVO" class="com.bcs.zsg.maintenance.vo.LookupCategoryVO" column="lookup_cat_cd" lazy="false"/-->
		<property name="code" type="string" column="code"/>
		<property name="description" type="string" column="description"/>
		<!--  <many-to-one name="lookupCategoryVO" class="com.bcs.zsg.maintenance.vo.LookupCategoryVO" property-ref="code" column="lookup_cat_cd" lazy="false"/>-->
		<many-to-one name="lookupCategoryVO" property-ref="code" column="lookup_cat_cd"/>
		<property name="isEditable" type="boolean" column="is_editable"/>
		<property name="seqNo" type="integer" column="seq_no"/>
		
		<!-- BaseVO attributes -->
		<!--  <property name="id" type="long" column="id"/>-->
		<property name="remarks" type="string" column="remarks"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
		
	</class>
</hibernate-mapping>