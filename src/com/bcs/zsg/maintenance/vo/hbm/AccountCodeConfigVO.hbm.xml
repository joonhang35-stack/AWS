<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.maintenance.vo">
	<class table="tour_dep_account_code_config" name="AccountCodeConfigVO" polymorphism="explicit">
		<id name="id" type="long" column="id">
            <generator class="identity"/>
        </id>
        
        <property name="code" type="string" column="code"/>
		<property name="description" type="string" column="description"/>
		<property name="idAcct" type="long" column="id_acct"/>
		<property name="grouping" type="integer" column="`grouping`"/>
		<property name="isEditable" type="boolean" column="is_editable"/>
		<property name="isLock" type="boolean" column="is_lock"/>
		<property name="typeCode" type="string" column="type_cd"/>
		
		<!-- BaseVO attributes -->
		<property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_update"/>
		<property name="updatedBy" type="string" column="updated_by"/>
		
	</class>
</hibernate-mapping>