<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.maintenance.vo">
	<class table="listing_table_view" name="ListingTableViewVO" polymorphism="explicit">
		<id name="id" type="long" column="id">
            <generator class="native"/>
        </id>
        
        <property name="idUser" type="long" column="id_user"/>
		<property name="listingType" type="string" column="listing_type"/>
		
		<!-- BaseVO attributes -->
		<property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_update"/>
		<property name="updatedBy" type="string" column="updated_by"/>
	</class>
</hibernate-mapping>