<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.bank.vo">

    <class table="inv_pmnt_cashbook_link" name="InvPmntCBLinkVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idCompany" type="long" column="id_company"/>
        <property name="idInvoice" type="long" column="id_invoice"/>
        <property name="invoiceNo" type="string" column="invoice_no"/>
        <property name="idInvPmnt" type="long" column="id_inv_pmnt"/>
        <property name="idCashBook" type="long" column="id_cash_book"/>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="status_cd"/>
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
    </class>
</hibernate-mapping>