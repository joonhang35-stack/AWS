<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.bank.vo">

    <class table="bank_recon" name="BankReconVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="native"/>
        </id>
        <property name="idBank" type="long" column="id_bank"/>
        <property name="dtStart" type="timestamp" column="dt_start"/>
        <property name="dtEnd" type="timestamp" column="dt_end"/>
        <property name="month" type="string" column="month"/>
        <property name="year" type="string" column="year"/>
        <property name="statementCr" type="double" column="statement_cr"/>
        <property name="statementDr" type="double" column="statement_dr"/>
        <property name="statementBal" type="double" column="statement_bal"/>
        <property name="cashBookCr" type="double" column="cashbook_cr"/>
        <property name="cashBookDr" type="double" column="cashbook_dr"/>
        <property name="cashBookBal" type="double" column="cashbook_bal"/>
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="dt_created" update="false"/>
		<property name="createdBy" type="string" column="created_by"/>
		<property name="updatedDate" type="timestamp" column="dt_upd"/>
		<property name="updatedBy" type="string" column="upd_by"/>
		<property name="version" type="long" column="version"/>
    </class>
</hibernate-mapping>