<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.purchase.vo">

    <class table="EX_ORDER_AIRLINE" name="AirLineDetailsVO" polymorphism="explicit">
        <id name="Id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="exOrderId" type="long" column="ID_EO"/>
        <property name="point" type="string" column="POINT"/>
        <property name="flightNo" type="string" column="FLIGHT_NO"/>
        <property name="airLineDt" type="timestamp" column="DT_FLIGHT"/>
        <property name="time" type="string" column="TIME"/>
        <property name="airClass" type="string" column="CLASS"/>
        <property name="status" type="string" column="STATUS"/>
        <property name="airLinePnr" type="string" column="PNR"/>
        <property name="seq" type="integer" column="seq"/>
        
        <!-- BaseVO attributes -->
        <property name="statusCode" type="string" column="STATUS_CD"/>
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>