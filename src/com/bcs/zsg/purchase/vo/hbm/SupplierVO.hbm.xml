<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.bcs.zsg.purchase.vo">

    <class table="SUPPLIER" name="SupplierVO" polymorphism="explicit">
        <id name="id" type="long" column="ID">
        	<generator class="identity"></generator>
        </id>
        <property name="personId" type="long" column="ID_PERSON"/>
        <property name="companyId" type="long" column="ID_COMPANY"/>
        <property name="accountId" type="long" column="ID_ACCT"/>
        <property name="sysNo" type="string" column="SYS_NO"/>
        <property name="code" type="string" column="CODE"/>
        <property name="status" type="string" column="STATUS_CD"/>
        <property name="supplierType" type="string" column="TYPE_CD"/>
        <property name="supplierCat" type="string" column="CAT_CD"/>
        <property name="paymentTerm" type="string" column="PMNT_TYPE_CD"/>
        <property name="accRef" type="string" column="ACCT_REF"/>
        <property name="bankName" type="string" column="BANK_NAME"/>
        <property name="accountNo" type="string" column="BANK_NO"/>
        <property name="beneficiaryName" type="string" column="BENEFICIARY_NAME"/>
        <property name="tourismTaxRegNo" type="string" column="TOURISM_TAX_REG_NO"/>
        <property name="taxIdNo" type="string" column="TAX_ID_NO"/>
        <property name="regNo" type="string" column="REG_NO"/>
        <property name="regNoOld" type="string" column="REG_NO_OLD"/>
        <property name="gstRegNo" type="string" column="GST_REG_NO"/>
        <property name="sstRegNo" type="string" column="SST_REG_NO"/>
        <property name="msicCode" type="string" column="MSIC_CODE"/>
        <property name="groupCd" type="string" column="GROUP_CD"/>
        <property name="creditLimit" type="double" column="CREDIT_LIMIT"/>
        <property name="contactNo" type="string" column="CONTACT_NO"/>
        <property name="email" type="string" column="EMAIL"/>
        <property name="passportNo" type="string" column="PASSPORT_NO"/>
        
        <!-- BaseVO attributes -->
		<property name="createdDate" type="timestamp" column="DT_CREATED" update="false"/>
		<property name="createdBy" type="string" column="CREATED_BY"/>
		<property name="updatedDate" type="timestamp" column="DT_UPD"/>
		<property name="updatedBy" type="string" column="UPD_BY"/>
    </class>

</hibernate-mapping>